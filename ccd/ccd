#!/usr/bin/env bash
# ccd — durable, multi-account, self-healing Claude Code session manager for server-box.
# One tmux session per (wrapper, project): `<wrapper> --remote-control <id> --resume|--session-id <uuid>`.
set -uo pipefail

REG="$HOME/.cc-sessions"
WRAPPER_DIR="$HOME/.local/bin"
# Derived from HOME with no env override, exactly as REG and WRAPPER_DIR are:
# HOME is the single isolation boundary the test harness sets, and cmd_ws_rm
# runs `git worktree remove` / `git branch -d` under these two roots. A stray
# Environment= or exported PROJECTS_ROOT would point a unit test at real repos.
PROJECTS_ROOT="$HOME/projects"     # $HOME/projects -> /data/projects (symlink) in production
WORKTREES_ROOT="$HOME/worktrees"
VALID_WRAPPERS=(claude claude2 claude-corp)   # canonical Anthropic accounts (home-able)
# `gpt` is a 4th lane (ccgpt = Claude Code on the ChatGPT-sub Codex backend), OPT-IN only
# since 2026-07-26: a session reaches it solely by having gpt as its HOME (`ccd prefer <id>
# gpt`), never as general overflow — its 272k window and unofficial-client risk are not
# things a project should inherit by accident. Instantly killable via the switch file below.
# It has no Anthropic-style 5h/7d telemetry, so it reads as free until a 429 writes an
# exclusion into cc-limits (see _auto_swap_check).
GPT_DISABLE_FILE="$HOME/.cc-sessions/gpt-disabled"   # touch to remove gpt from rotation instantly
AUTOCOMPACT_DISABLE_FILE="$HOME/.cc-sessions/autocompact-disabled"  # touch to disable proactive /compact fleet-wide
CLAUDE_AI_BASE="https://claude.ai/code"   # by-name discovery: pick the session whose name == the id
mkdir -p "$REG"

# ── account-swap tuning (see cmd_swap/_auto_swap_check) ─────────────────
LIMITS_DIR="$HOME/.cc-limits"   # per-account {"five":N,"seven":N,"ts":epoch} written by statusline-command.sh
SWAP_THRESHOLD=90               # own 5h % that arms a pre-emptive swap
SWAP_HEADROOM=30                # target must be at least this many points lower
SWAP_COOLDOWN=900               # min seconds between swaps of one session
SWAP_FRESH=1800                 # telemetry younger than this qualifies for pre-emptive swaps
SWAP_QUIET=600                  # preempt only sessions quiet this long (any surface); rescue ignores
SWAP_CEILING=98                 # own 5h/7d % at/above which every turn is paid overage: cut the
                                # quiet wait short so we swap at the NEXT turn boundary, not 10min later
SWAP_CEIL_QUIET=30              # seconds of idle required before a non-blocked relocation (return-home / ceiling)
SPAWN_EFFORT="ultracode"        # /effort sent to every freshly spawned session ("" disables).
                                # ultracode is session-only by design (no settings.json key),
                                # so injecting it at spawn is the only way to default it.
# Proactive auto-/compact: when an IDLE session's context passes COMPACT_THRESHOLD, send /compact
# so it stays lean (the SessionStart(compact) hook restores git/plan/handoff context, so this is
# non-destructive on both the Anthropic and gpt lanes). Only at a clean turn boundary; kill-switch
# via AUTOCOMPACT_DISABLE_FILE.
COMPACT_THRESHOLD=50            # own context % at/above which an idle session auto-compacts
COMPACT_COOLDOWN=1800           # min seconds between auto-compacts of one session (also skipped right after a swap)
COMPACT_QUIET=60                # seconds a session must be idle before an auto-compact fires (let the dust settle)
# Make `systemctl --user` reachable even from a non-interactive SSH context (no login session
# sets these). Lingering keeps /run/user/$UID alive across logins/reboots.
: "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"; export XDG_RUNTIME_DIR
: "${DBUS_SESSION_BUS_ADDRESS:=unix:path=${XDG_RUNTIME_DIR}/bus}"; export DBUS_SESSION_BUS_ADDRESS

die() { echo "ccd: $*" >&2; exit 1; }

_gpt_enabled() { [[ ! -f "$GPT_DISABLE_FILE" && -x "$WRAPPER_DIR/gpt" ]]; }   # kill-switch + wrapper present
_gpt_status() {   # human-readable state of the gpt overflow lane (for `ccd ls`)
  [[ -x "$WRAPPER_DIR/gpt" ]] || { echo "not installed"; return; }
  [[ -f "$GPT_DISABLE_FILE" ]] && { echo "DISABLED (kill-switch; rm $GPT_DISABLE_FILE to re-enable)"; return; }
  if ! _avail gpt; then
    # TWO different files can land here, and only one of them is a 429:
    #   • the compact exclusion ccd itself writes on a 429 ({"five":100,"seven":0,
    #     "ts":<when the 429 happened>} — see _auto_swap_check). Here `ts` IS the
    #     exclusion time and the 5h cooldown story is true.
    #   • the steady-state usage sample ccgpt-usage rewrites every 20 min (5 keys,
    #     python json.dump). There `ts` is the POLL time, "five" is usually null
    #     (Codex Pro is weekly-only) and the blocker is the weekly cap, whose real
    #     end time is in sevenResetAt — days out, not "~300m of 5h cooldown".
    # Telling them apart by the *presence* of the resetAt KEYS, not their values:
    # ccgpt-usage always emits both (often as null), ccd's printf never emits either.
    local f="$LIMITS_DIR/gpt.json" ts rem
    if _limit_has_key "$f" fiveResetAt || _limit_has_key "$f" sevenResetAt; then
      local five seven pct label reset msg
      five=$(_limit_field gpt five); seven=$(_limit_field gpt seven)
      : "${five:=0}"; : "${seven:=0}"
      if (( seven >= five )); then pct="$seven"; label=weekly; reset=$(_limit_json_num "$f" sevenResetAt)
      else                        pct="$five";  label=5h;     reset=$(_limit_json_num "$f" fiveResetAt); fi
      msg="Codex ${label} cap reached (${pct}%"
      [[ -n "$reset" ]] && msg="$msg, resets $(_fmt_eta "$reset")"
      echo "$msg)"
      return
    fi
    # via _limit_json_num, not a bare grep: gpt.json is the one file written by
    # python json.dump, so its colons carry a space and a compact pattern reads
    # nothing — printing "excluded" with no countdown (see _limit_json_num).
    ts=$(_limit_json_num "$f" ts 2>/dev/null)
    if [[ -n "$ts" ]]; then
      rem=$(( (18000 - ($(date +%s) - ts)) / 60 )); (( rem < 0 )) && rem=0   # never count down past the window
      echo "429-excluded (~${rem}m of 5h cooldown left)"
    else
      echo "excluded"
    fi
    return
  fi
  echo "enabled, available"
}
_is_valid_wrapper() { local w="$1" v; for v in "${VALID_WRAPPERS[@]}" gpt; do [[ "$w" == "$v" ]] && return 0; done; return 1; }
_id()    { echo "$1-$2"; }                                  # wrapper project -> id
_tmux()  { echo "cc-$1"; }                                  # id -> tmux name
_alive() { tmux has-session -t "$(_tmux "$1")" 2>/dev/null; }
_reg_set() { printf '%s' "$3" > "$REG/$1.$2"; }             # id field value
_reg_get() { cat "$REG/$1.$2" 2>/dev/null; }                # id field
_reg_purge() {   # id -> rm -f every "$REG/$id.<field>" registry file for id
  # final-review-destructive finding F3. The THREE call sites that used to spell
  # this `rm -f "$REG/$id".*` directly were an unanchored glob: `$id.*`
  # matches `$id.uuid` (this session's own field, one dot, no more) but ALSO
  # `$id.x-y.uuid` — ANOTHER session's field, whose own id happens to be
  # `$id.x-y`. Measured: `$REG/demo-quiet-basin.uuid`,
  # `$REG/demo-quiet-basin.x-y.uuid` and `$REG/demo-quiet-basin.x-y.workdir`
  # side by side, `rm -f "$REG/demo-quiet-basin".*` — zero survivors. Ids are
  # `<project>-<slug>` and slugs are dot-free (`_ws_slug_valid`), so the dot
  # has to come from a PROJECT DIRECTORY name (`demo-quiet-basin.x` beside
  # `demo`) — contrived, but dots in project directory names are legal and
  # ordinary, and the consequence is not local: the victim loses its `.uuid`,
  # `_ws_gc_row` then classifies it `orphan`, and `ws-gc --prune`'s orphan
  # arm runs `git worktree remove` and `git branch -d` on it.
  #
  # Fixed by filtering on the SUFFIX rather than matching every known field
  # name — a field name never contains a dot (measured: `archived`,
  # `archivedreason`, `archivemanifest`, `base`, `branch`, `home`,
  # `lastcompact`, `lastswap`, `pool`, `prnumber`, `project`, `reaping`,
  # `setup`, `started`, `uuid`, `workdir`, `workspace`, `wrapper` — every
  # `_reg_set`/`_reg_get` field this file has today), so `$id.<field>` has
  # exactly one dot after the id and `$id.x-y.uuid` has two. This is
  # future-proof against a field this file adds tomorrow, which a hardcoded
  # allowlist would not be — the two are the same shape either way.
  # AND THE ORDER IS PART OF THE CONTRACT — final-round verification P4. This
  # loop unlinks one file at a time in GLOB order, i.e. alphabetically, so
  # `archived` went first and `reaping` (r) several files later. A SIGKILL or an
  # OOM between them — the failure model the reap lock exists for, and this
  # project's speciality — left `$REG/<id>.reaping=clips` standing beside a
  # MISSING `$REG/<id>.archived`. Pre-fix that state was resumable: the next
  # `ws-reap` took the resume fork, re-ran (h) and re-ran this purge. Since the
  # F5 archived re-read went into `_ws_reap_tail` it is not: the tail refuses
  # `not-archived` for ever, and `ws-archive` cannot be re-run on a half-purged
  # registry.
  #
  # The invariant that closes it is one line long — `reaping` must never outlive
  # `archived` — so the two STATE markers are removed last and in that order,
  # after every ordinary field. Every intermediate is then either still
  # resumable (both markers present; the tail's clips arm needs only `$id`) or
  # already past resuming. The residue of the very last window is a single empty
  # `$id.archived` file with nothing else beside it: invisible to `ws-gc`'s
  # dead-reg arm (which keys on `.workspace` and `.uuid`) and to `ws-reap`
  # (which keys on `.uuid`), so it leaks — a zero-byte file, disclosed here,
  # against a permanent wedge on the destructive path.
  #
  # THE COST OF THAT ORDERING IS PAID AT `_ws_slug_free`, verification round 3
  # P1. Removing the two markers last makes them OUTLIVE `.uuid` by
  # construction, and `_ws_slug_free` used to ask only `[[ ! -f $id.uuid ]]`.
  # So the residue above is not merely leaked, it is INHERITED: the slug reads
  # free, `cmd_ws_add` re-uses it (it purges nothing first), and the brand-new
  # workspace is born wearing a stranger's `.archived`/`.reaping`. Measured on
  # that state: `ws-archive` answers `already archived` at exit 0 having
  # stopped no session and written no manifest (ccd:1222 below), `_ws_reap_eval`
  # Phase A and `_ws_reap_tail` both PASS the archived gate on a workspace that
  # was never archived, and with `.reaping` present `_ws_reap_locked` takes the
  # resume fork — where the token is not checked and Phase C, the merged-PR
  # proof, is deliberately not re-run. `_ws_slug_free` is therefore an
  # ANY-FIELD check now; see the note there.
  local id="$1" f suffix
  for f in "$REG/$id".*; do
    # `[[ -e "$f" ]]` for the unmatched-glob case: this file does not set
    # `nullglob`, so a glob with no matches stays the literal string
    # `$REG/$id.*`, and `-e` on that is false — the loop body never runs.
    [[ -e "$f" ]] || continue
    suffix="${f#"$REG/$id."}"
    [[ "$suffix" == *.* ]] && continue
    [[ "$suffix" == archived || "$suffix" == reaping ]] && continue
    rm -f "$f"
  done
  rm -f "$REG/$id.reaping"
  # CONDITIONAL, so the invariant is a mechanism rather than a hope: an `rm`
  # that did not take the breadcrumb must not be followed by one that takes the
  # marker, because `reaping` standing beside a missing `archived` is precisely
  # the wedge this ordering exists to prevent. It is also what makes the order
  # observable to a test — nothing else about two adjacent unlinks is.
  [[ -e "$REG/$id.reaping" ]] || rm -f "$REG/$id.archived"
}
_ws_seed_home() {   # id wrapper — set home once; never clobber a deliberate choice
  [[ -f "$REG/$1.home" ]] || _reg_set "$1" home "$2"
}

# The systemd calls live in their own functions (rather than inline in cmd_ws_add)
# so the test harness can stub them — sourcing ccd and calling cmd_ws_add under
# vitest would otherwise enable a REAL claude-session@<id> unit on the host.
_ws_supervise()   { systemctl --user enable  --now "claude-session@$1" 2>/dev/null \
                      || echo "warn: could not enable unit claude-session@$1" >&2; }
_ws_unsupervise() { systemctl --user disable --now "claude-session@$1" 2>/dev/null || true; }

# ── PR / archive lifecycle helpers ─────────────────────────────────
# `local x=$(cmd)` returns local's status, never cmd's — so anything whose exit
# code is read below declares first and assigns second, deliberately.

_json_str() {   # value -> a JSON string literal (quote/backslash/control safe)
  # THE ENCODING POLICY IS PINNED HERE, because the value may be RAW BYTES and a
  # filename is not text. `_ws_collect_ignored` reads paths with `-z`
  # (deliberately — see there), so `ignored[].path`, `sensitive[]` and the
  # `sensitive-ignored` detail carry whatever the filesystem holds, and a Linux
  # path is any byte string without NUL or `/`.
  #
  # The previous form read stdin through python's LOCALE codec. On this box
  # (`LANG=en_US.UTF-8`) that is utf-8 STRICT, so one 0xff byte raised
  # UnicodeDecodeError, stdout was EMPTY, `$(…)` swallowed the status and
  # `cmd_ws_audit` printed `"ignored":[{"path":,"bytes":600,…}]` — a document
  # JSON.parse rejects, at exit 0, over a workspace whose verdict was
  # `sensitive-ignored` and whose `sensitive` array had silently degraded to
  # `[]`. Under `LC_ALL=C` the same input was fine (python falls back to
  # surrogateescape), so it was locale-dependent as well as wrong.
  #
  # So the bytes are read as BYTES — `sys.stdin.buffer`, which no locale can
  # reach — and decoded utf-8 with errors='replace'. LOSSY, deliberately, and it
  # cannot weaken a guard: every decision over these bytes has already been taken
  # in bash on the RAW bytes (`_ws_sensitive_match`'s `case` globs, `du`'s size,
  # `_ws_ignored_digest`'s hash) before anything is serialised. What is left is
  # the HUMAN's copy, and U+FFFD renders as a visible "this is not text" where a
  # `\udcff` surrogate escape — the round-tripping alternative — is valid JSON
  # that most consumers mangle or refuse to re-encode. `json.dumps` defaults to
  # ensure_ascii, so stdout is pure ASCII whatever the writer's locale; `LC_ALL`
  # is pinned anyway rather than inherited, so nothing here depends on the box.
  #
  # NON-ZERO now means one thing only: python3 could not be RUN. Callers must
  # check it — a bare `$(_json_str …)` inside a printf argument list swallows the
  # status by construction, which is how the hole above got printed — and both
  # callers that build a whole record (`_ws_manifest`, `cmd_ws_audit`) probe once
  # up front and refuse rather than checking nineteen substitutions.
  #
  # MUTATION SURVIVOR, disclosed and measured: `LC_ALL=C.UTF-8` can be deleted
  # with the suite green, and always will be on a box whose LANG is already a
  # UTF-8 one — `sys.stdin.buffer` bypasses the stdin codec and `ensure_ascii`
  # makes stdout pure ASCII, so between them the call is already locale-proof and
  # no fixture on THIS box can tell the two apart. It is written because the
  # defect it guards against is precisely a difference between boxes: the old
  # form was correct under `LC_ALL=C` and broken under `en_US.UTF-8`, so "it
  # works here" was exactly the evidence that was worthless. Pinning it means a
  # future rewrite that goes back to a text-mode read fails on every box rather
  # than on someone else's.
  printf '%s' "${1-}" | LC_ALL=C.UTF-8 python3 -c 'import json,sys
sys.stdout.write(json.dumps(sys.stdin.buffer.read().decode("utf-8", "replace")))'
}

_ws_status() {   # id -> busy|idle on stdout; NON-ZERO when it cannot be read.
  # Fails closed twice over, and both halves are load-bearing.
  #
  # UNREADABLE -> non-zero. A socket hiccup or an unreadable status file must
  # not read as "not working" and let an archive kill a live turn.
  #
  # UNRECOGNISED -> busy. `idle` is an ALLOWLIST; every other value is busy.
  # Claude Code writes at least `idle`, `busy` (a model turn is in flight) and
  # `shell` (a Bash tool command is running) — server/src/livestate.ts:14-30 is
  # this repo's own record of that vocabulary, and of what matching `busy` and
  # calling the rest idle cost when the server side did it. Here the price is
  # steeper than a wrong badge: `ws-reap` gates `git worktree remove` on this
  # answer, so `shell` reading idle deletes the tree out from under a running
  # `npm test`. A status we do not recognise is far likelier to be new work than
  # new rest, and an allowlist is the only polarity that survives the wrapper
  # growing a fourth word. Same polarity as _auto_swap_check's gate
  # (ccd:1261), which is likewise `[[ "$st" == "idle" ]]` and stops on anything
  # else.
  local id="$1" wrapper cfg pid sf st
  wrapper=$(_reg_get "$id" wrapper); [[ -n "$wrapper" ]] || return 1
  cfg=$(_cfg_dir "$wrapper");        [[ -n "$cfg" ]]     || return 1
  _alive "$id" || { echo idle; return 0; }      # no pane at all: nothing is running
  pid=$(tmux list-panes -t "$(_tmux "$id")" -F '#{pane_pid}' 2>/dev/null | head -1)
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  sf="$cfg/sessions/$pid.json"
  st=$(grep -oE '"status":"[a-z_-]+"' "$sf" 2>/dev/null | head -1 | cut -d'"' -f4)
  [[ -n "$st" ]] || return 1
  [[ "$st" == idle ]] || { echo busy; return 0; }
  echo idle
}

_transcript_path() {   # id -> the Claude Code transcript for its CURRENT uuid
  # <cfg>/projects/<workdir with / . _ all mapped to ->/<uuid>.jsonl — the same
  # munge server/src/munge.ts applies. Recorded so a reap never has to be
  # reconstructed from an escaped path after the registry is gone.
  local id="$1" wrapper cfg workdir uuid munged
  wrapper=$(_reg_get "$id" wrapper); workdir=$(_reg_get "$id" workdir); uuid=$(_reg_get "$id" uuid)
  cfg=$(_cfg_dir "$wrapper")
  [[ -n "$cfg" && -n "$workdir" && -n "$uuid" ]] || return 1
  munged=$(printf '%s' "$workdir" | tr './_' '---')
  printf '%s/projects/%s/%s.jsonl\n' "$cfg" "$munged" "$uuid"
}

_ws_stash_count() {   # main branch -> stash entries belonging to that branch
  # -F on both patterns: a branch name carrying a '.' would otherwise be a
  # wildcard and over-count, which here means refusing a legitimate reap.
  #
  # BOTH forms are needed and `grep -F` is case-sensitive: git writes
  # `On <branch>: <message>` for `git stash push -m` and
  # `WIP on <branch>: <sha> <subject>` for a bare `git stash`, and the bare form
  # is the common one. (Measured, and re-measured by the round-1 verifier after
  # the integration review adjudicated the two as equivalent — they are not.)
  local main="$1" branch="$2" n sha gs base
  n=$(git -C "$main" stash list 2>/dev/null | grep -cF -e "On $branch:" -e "WIP on $branch:" || true)

  # ── the OFF-BRANCH arm — final-round integration docket 6 ────────
  # `refs/stash` is SHARED across every worktree of a repository (measured on
  # git 2.43: a stash pushed from a linked worktree is listed by `git -C $main
  # stash list`), which is what makes the whole branch-scoped count possible.
  # But a stash pushed from a worktree on a DETACHED HEAD does not carry a
  # branch name at all — git writes the literal `(no branch)` — so the two
  # patterns above match nothing and the count came back an honest-looking 0.
  # A workspace holding unsaved work then read CLEAN: §7's `stashes-present`
  # guard, the one with no override, could not fire, and the reap went on to
  # CAS-delete the branch those stashes were taken from. The work itself
  # survives while `refs/stash` does — what is lost is the association, and the
  # sheet said there was nothing to associate.
  #
  # ATTRIBUTED BY THE BASE COMMIT, not by the message, because the message has
  # no name in it to match. A stash commit's FIRST PARENT is the commit HEAD was
  # on when it was taken, so an off-branch stash belongs to this branch exactly
  # when that commit is reachable from it.
  #
  # AND IT DOES REINTRODUCE THE FLEET-WIDE COST FOR ONE SHAPE OF INPUT —
  # round-3 verification P3, which flagged that this arm and the "what the guard
  # must NOT do" paragraph in `_ws_reap_eval` (search: `refs/stash exists`)
  # could not both be read as written. The earlier text here cited that
  # paragraph as though this arm avoided the cost, and then admitted three lines
  # later that it does not. One statement, in both places, instead:
  #
  #   • What `_ws_reap_eval` rejects, with a measurement, is attribution by
  #     EXISTENCE — "refs/stash resolves ⇒ refuse". That fires on a NAMED stash
  #     on another branch (main's own parked work, the ordinary case), which the
  #     operator has a standing reason to keep, so the wedge has no end date.
  #   • What this arm does is attribution by BASE COMMIT, and it fires only on
  #     an ANONYMOUS entry: one that names no branch, that nothing else in this
  #     design can associate with anything, and that nobody has a reason to keep
  #     indefinitely.
  #
  # Different rules — and they SHARE the property the verifier objected to,
  # which is not talked away. An off-branch stash taken at a commit on SHARED
  # history (typically: detached in a workspace before that workspace committed
  # anything) is reachable from every branch in the repository, so it counts
  # against all of them and every workspace of that project answers
  # `stashes-present` until it is dealt with. Measured on a two-branch fixture:
  # one `(no branch)` stash at the root commit, and both `ws/x` and `master`
  # count 1. Pinned by a test, so it is a chosen behaviour and not a discovery.
  #
  # Accepted, because in this file the cost of a no-override guard is measured
  # in whether the operator can get OUT of it — the same standard
  # `stash-unreadable` is held to, and the same conclusion: the remedy is local
  # and exact, and it TRAVELS IN THE REFUSAL DETAIL rather than in this comment,
  # because the operator the message reaches is the only one who can act.
  #
  # The alternative narrowing considered and REJECTED: also require the base
  # commit not to be an ancestor of the merge-base with `origin/HEAD`. It
  # removes the fleet-wide case — and most of docket 6 with it. A reap only runs
  # behind a MERGED PR, so after a true merge every commit of the branch is
  # already an ancestor of `origin/HEAD` and this arm would count nothing at
  # all; it would survive only for squash merges. A guard whose coverage depends
  # on which merge button a reviewer pressed is an argument about PR shape, not
  # a fact about stashes.
  #
  # An unreadable entry counts too: `rev-parse` failing is not evidence of
  # absence.
  #
  # `--format='%H%x09%gs'` and a TWO-field read: the stash commit first, then
  # the reflog subject, which is free-form and goes LAST so that a message
  # containing a tab lands in `$gs` entire rather than shifting the sha.
  # `stash list` is `git log -g refs/stash`, so it takes log's formats.
  while IFS=$'\t' read -r sha gs; do
    case "$gs" in
      'On (no branch):'*|'WIP on (no branch):'*) ;;
      *) continue ;;
    esac
    base=$(git -C "$main" rev-parse --verify --quiet "$sha^1" 2>/dev/null) \
      || { n=$(( n + 1 )); continue; }
    git -C "$main" merge-base --is-ancestor "$base" "refs/heads/$branch" 2>/dev/null \
      && n=$(( n + 1 ))
  done < <(git -C "$main" stash list --format='%H%x09%gs' 2>/dev/null)
  printf '%s\n' "$n"
}

_ws_ignored_digest() {   # workdir -> sha256 of the ignored-entry set
  # NON-ZERO when the set could not be read at all.
  #
  # --ignored=matching, NEVER `ls-files --others --ignored`: the latter
  # enumerates per file (measured 210,070 entries / 24.6 MB in custom-tools,
  # against an 8 MB agent EXEC_MAX_BUFFER), while this collapses each ignored
  # directory to one entry.
  #
  # A failed read must not be indistinguishable from an empty one, and by
  # construction the digests are: a nonexistent directory, a corrupt repo and an
  # index.lock contention all hash sha256("") = e3b0c442…b855, exactly like a
  # workspace with nothing ignored. Harmless while the digest is only recorded;
  # a forgery the moment ws-reap compares a stored digest against a live one to
  # prove gitignored content is unchanged, because a failure on EITHER side then
  # manufactures the match that authorises the delete. So the difference is
  # carried by the exit code.
  #
  # It has to come from PIPESTATUS[0] — git's own status — and not from the
  # pipeline: `grep '^!! '` exits 1 on a legitimately empty ignored set, so the
  # pipeline already returned non-zero for the HEALTHY case (measured: rc=1 for a
  # clean workspace, rc=1 for /no/such/dir). Two statements, because
  # `local d=$(...)` would return local's status.
  #
  # AND STDERR IS THE SECOND RUNG — final-round integration review, item 5 /
  # new finding 3. `PIPESTATUS[0]` alone is not enough: `git status` over a
  # PARTIALLY unreadable tree exits ZERO and writes the diagnostic to stderr
  # only (measured on git 2.43: rc 0, empty stdout, `warning: could not open
  # directory 'tracked/'`), so the digest hashed a SHORT set and answered
  # success. `_ws_collect_ignored` has required an empty stderr since Task 6 for
  # exactly this reason; this function keeps its own copy of that rung because
  # the ARCHIVE manifest still calls it, and a manifest that records a complete
  # digest over an incomplete set is the same forgery one layer down. An
  # incomplete read is not a smaller answer, it is no answer.
  local d errf err
  errf=$(mktemp) || return 1
  d=$(git -C "$1" status --porcelain --ignored=matching 2>"$errf" \
        | grep '^!! ' | sort | sha256sum | cut -d' ' -f1; exit "${PIPESTATUS[0]}") \
    || { rm -f "$errf"; return 1; }
  err=$(cat "$errf" 2>/dev/null); rm -f "$errf"
  [[ -z "$err" ]] || return 1
  [[ "$d" =~ ^[0-9a-f]{64}$ ]] || return 1
  printf '%s\n' "$d"
}

PR_GH_TIMEOUT=12          # gh pr list has no --timeout of its own; a blocking
                          # DNS hang is 30 s, so this is the only bound there is
PR_JSON_FIELDS=number,state,headRefName,headRefOid,baseRefName,isCrossRepository,mergedAt,mergeCommit,url,title,isDraft,statusCheckRollup

_gh_repo_slug() {   # main-checkout path -> OWNER/NAME, or non-zero
  # Three guards, and the mutation sweep says the last one subsumes the first
  # two: with no origin `git config --get` exits 1 AND prints nothing, so both
  # `|| return 1` and `[[ -n "$url" ]]` can be deleted with the suite still
  # green — the regex rejects "" on its own. They stay because the fall-through
  # only holds while the regex is anchored at both ends, and this function's
  # answer is spent as `--repo` on a WRITE-scoped token: each guard states the
  # case it is about rather than relying on a later line to catch it.
  local url
  url=$(git -C "$1" config --get remote.origin.url 2>/dev/null) || return 1
  [[ -n "$url" ]] || return 1
  url="${url%.git}"; url="${url#git@github.com:}"
  url="${url#ssh://git@github.com/}"; url="${url#https://github.com/}"
  [[ "$url" =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]] || return 1
  printf '%s\n' "$url"
}

_gh_pr_list() {   # repo [head-branch] -> rows JSON on stdout; on failure prints
                  # the answer object instead and returns non-zero. NEVER
                  # partially prints.
  # The head filter is a NAMED second parameter and the flag is built here — it
  # is never a forwarded "$@". pflag is last-wins, so a passthrough on the one
  # gh call two verbs share would let a caller override --repo or --state.
  # pr-open needs the filter because it asks a question about ONE branch; both
  # readers get the same fields, the same 100-PR window and the same failure
  # classification, which is the point of there being one reader.
  local repo="$1" head="${2:-}" errf out rc err
  local -a filter=()
  [[ -n "$head" ]] && filter=(--head "$head")
  errf=$(mktemp)
  out=$(timeout "$PR_GH_TIMEOUT" gh pr list --repo "$repo" "${filter[@]}" --state all --limit 100 \
          --json "$PR_JSON_FIELDS" 2>"$errf"); rc=$?
  err=$(cat "$errf" 2>/dev/null); rm -f "$errf"
  if (( rc == 124 )); then printf '{"phase":"unknown","reason":"timeout"}\n'; return 1; fi
  if (( rc != 0 )); then
    # `gh auth status` is NOT probed first: it is another network call on the
    # unhappy path. The stderr we already have is the cheaper signal.
    case "$err" in
      *"gh auth login"*|*"not logged in"*|*"HTTP 401"*) printf '{"phase":"unknown","reason":"unauthenticated"}\n' ;;
      *"rate limit"*|*"HTTP 403"*)                      printf '{"phase":"unknown","reason":"rate-limit"}\n' ;;
      *"dial tcp"*|*"no such host"*|*"proxyconnect"*)   printf '{"phase":"unknown","reason":"offline"}\n' ;;
      *)                                                printf '{"phase":"unknown","reason":"error"}\n' ;;
    esac
    return 1
  fi
  printf '%s\n' "$out"
}

_gh_rows_ok() {   # answer -> 0 if it is a JSON list, non-zero for anything else
  # rc 0 is not the same as an answer. `gh` writes its own diagnostics to
  # STDOUT and still exits 0 ("gh: could not determine base repository"), so a
  # caller that only asks `-n` prints that sentence as its own result: measured,
  # `cmd_pr_open` returned it at exit 0, and the route (Task 13) answers
  # {ok:true} on rc 0 without parsing stdout — the phone is told a PR opened.
  # `_pr_py`'s `rows_in` already refuses the same body on the pr-state side
  # (an rc-0 unparseable read once cleared a persisted `merged:#42`); this is
  # that check for the caller that never reaches python.
  # The answer arrives on STDIN, never in an argv — spec §7, it is
  # GitHub-sourced. The program is argv, which is the safe half.
  printf '%s' "$1" | python3 -c 'import json, sys
try:
    sys.exit(0 if isinstance(json.load(sys.stdin), list) else 1)
except Exception:
    sys.exit(1)'
}

_pr_py() {   # mode [args…]; stdin = the gh rows JSON. The ONE embedded helper.
  # Embedded rather than a sibling file on purpose: ~/.local/bin/ccd is a COPY,
  # so a second file is a second deployment step and a new failure mode in
  # which `ccd caps` advertises a verb whose helper is missing.
  #
  # The program arrives on fd 3, NOT on stdin: `python3 - <<'PY'` reads the
  # program FROM stdin, so the heredoc and the piped rows are the same channel
  # and python consumes the whole of it as source — `sys.stdin.read()` then
  # returns '' at EOF, `rows_in()` answers [], and every PR in the fixture
  # vanishes into `phase:"none"` at exit 0. Measured both forms side by side:
  # `python3 - "$@" <<PY` gives stdin='', `python3 /dev/fd/3 "$@" 3<<PY` gives
  # the rows, with sys.argv identical. The rows cannot move to argv instead —
  # spec §7 is that no GitHub-sourced string is ever placed in an argv.
  python3 /dev/fd/3 "$@" 3<<'PY'
import json, os, re, subprocess, sys, time

mode = sys.argv[1]
# `headRefOid` and `mergeCommit.oid` are GitHub-SOURCED, and `is_ours` puts the
# first of them in a git argv. Spec §7: no GitHub-sourced string is ever placed
# in a prompt, an argv, or a shell — so this is the boundary, not a formality.
# Both ends are anchored and the floor is 7, and both are pinned: a row saying
# `headRefOid: "main"` otherwise resolves as a REVISION and binds (main really
# is an ancestor of our tip), and `{1,40}` would let a three-character hex ref
# like `abc` do the same. `is_merged` reads `mergeCommit.oid` through it as a
# SHAPE check only — a merge commit is never an identity, two PRs can share one.
OID = re.compile(r'^[0-9a-f]{7,40}$')

def rows_in():
    """The rows, or None for A BODY WE COULD NOT READ — which is NOT `[]`.

    `[]` is an affirmative answer: this repository has no pull request for you,
    which is `phase:"none"`, which is the one answer meaning "ready to open a
    PR" — and which CLEARS the persisted number. Collapsing an unintelligible
    body into it therefore turns "I could not understand GitHub" into "GitHub
    says the merge you had is gone". `gh` exiting 0 is not the same as `gh`
    having answered: an empty stdout, a JSON object, a proxy's HTML error page
    and a truncated array all arrive here at rc 0. Empty counts as unreadable
    too — `gh pr list --json` prints `[]` for a repo with no PRs, never
    nothing, and an empty stdin is exactly what deviation 8's program-on-stdin
    defect produced."""
    raw = sys.stdin.read().strip()
    if not raw:
        return None
    try:
        v = json.loads(raw)
    except Exception:
        return None
    return v if isinstance(v, list) else None

def git(main, *args):
    return subprocess.run(['git', '-C', main, *args], capture_output=True, text=True)

def is_ours(main, tip, oid):
    """Proof 0 — the PR's head commit exists locally AND, where we have a tip to
    reach from, is reachable from it. This is what a recycled slug and a
    stranger's fork both fail.

    The cat-file rung survives mutation and is kept deliberately: `merge-base
    --is-ancestor` on an object this repository does not have exits 128 and so
    already answers False. Kept because 128 is git's *"I could not do this"*
    and 1 is its *"no"*, and this function must not start reading a fatal as an
    answer if the ancestry call is ever changed. (`OID`'s `{7,40}` survives too:
    `{1,40}` accepts the same strings any real headRefOid is — it bounds a
    GitHub-sourced string rather than deciding anything, and the cat-file rung
    is what actually rejects a value.)

    `tip is None` is the registry's branch not resolving in $main — a hand
    rename or a hand delete, which deviation 7 measured and calls ORDINARY.
    There is then no anchor to reach FROM, and answering False demotes a bound
    MERGED row to `no-commits` and clears the persisted number: a LOCAL fact
    erasing GitHub's answer about a PR. So the ancestry rung is SKIPPED rather
    than failed, and what remains is still three of four conjuncts plus "this
    repository can still see that commit". The recycled slug — the case the
    ancestry rung exists for — cannot be in this state: ws-add creates the
    branch, so a recycled name always resolves and always gets the full proof.
    The wire says which rung answered: `tip` is null beside `ours`."""
    if not isinstance(oid, str) or not OID.match(oid):
        return False
    if git(main, 'cat-file', '-e', oid + '^{commit}').returncode != 0:
        return False
    if tip is None:
        return True
    return git(main, 'merge-base', '--is-ancestor', '--', oid, tip).returncode == 0

def annotate(rows, main, tip, branch, base_short):
    out = []
    for r in rows:
        if not isinstance(r, dict):
            continue
        r['ours'] = is_ours(main, tip, r.get('headRefOid'))
        out.append(r)
    return out

def bound(r, branch, base_short):
    """The workspace<->PR binding. Branch name alone is not it."""
    return (r.get('isCrossRepository') is False
            and r.get('baseRefName') == base_short
            and r.get('headRefName') == branch
            and r.get('ours') is True)

def is_merged(r, branch, base_short):
    # The trailing `bound(...)` conjunct survives mutation: every caller today
    # passes a row `pick` already filtered by `bound`. It stays so the predicate
    # is true of ANY row rather than only of a pre-filtered one — Task 5's
    # `pick` mode calls it too, and "merged" is the answer that fires the
    # archive trigger, which is not a fact to infer from the caller's habits.
    oid = (r.get('mergeCommit') or {}).get('oid')
    return (r.get('state') == 'MERGED'
            and isinstance(r.get('mergedAt'), str)
            and isinstance(oid, str) and OID.match(oid) is not None
            and bound(r, branch, base_short))

def pick(rows, branch, base_short):
    """Highest number AFTER the binding check, never before."""
    cands = [r for r in rows if bound(r, branch, base_short)]
    cands.sort(key=lambda r: r.get('number') if isinstance(r.get('number'), int) else 0)
    return cands[-1] if cands else None

if mode == 'state':
    (id_, project, main, repo, branch, base, base_short, tip, ahead, dirty, template, reg) = sys.argv[2:14]
    # An argv can only carry a string, so "" is how the shell says UNMEASURED
    # for all three. None here and JSON null on the wire, never 0 and never "":
    # a number is a measurement, and none of these was measured. Deviation 7's
    # `tip: null` rule for the archive manifest, applied to the same fact.
    tip = tip or None
    ahead = int(ahead) if ahead != '' else None
    dirty = int(dirty) if dirty != '' else None
    raw_rows = rows_in()
    if raw_rows is None:
        # THE ID-LESS SHAPE, on purpose: the body is one gh call's answer for the
        # whole repository, so it is unreadable for every session of it at once —
        # which is what the id-less object means and what the sweep's per-project
        # backoff keys off. Nothing is persisted: the last good phase, number and
        # checkedAt all stay, which is what makes "last checked 6m ago" the honest
        # reading rather than a fresh-looking lie.
        sys.stdout.write(json.dumps({'phase': 'unknown', 'reason': 'error'}) + '\n')
        sys.exit(0)
    rows = annotate(raw_rows, main, tip, branch, base_short)
    chosen = pick(rows, branch, base_short)
    # `reason` accompanies `phase` and stays None for every phase but one, so
    # that prstate.ts's phaseFor can be pinned equal to this on BOTH fields.
    reason = None
    if chosen is None:
        # `ahead is None` is UNMEASURED, and `None == 0` is False in python, so an
        # unresolvable ref falls through to `none` — "no PR bound to this
        # workspace", which is what was actually observed — instead of
        # `no-commits`, which asserts that the branch is level with base.
        phase, number = ('no-commits' if ahead == 0 else 'none'), None
    elif is_merged(chosen, branch, base_short):
        phase, number = 'merged', chosen.get('number')
    elif chosen.get('state') == 'MERGED':
        # gh says MERGED but a conjunct failed. Never claim merged on a partial
        # match: the archive trigger and the cleanup offer both hang off it.
        # `merge-unproven`, NOT `error`: the gh read succeeded, and calling this
        # `error` puts "GitHub could not be read" on a phone about a read that
        # worked. phaseFor answers the same token for the same row.
        phase, number, reason = 'unknown', chosen.get('number'), 'merge-unproven'
    elif chosen.get('state') == 'CLOSED':
        phase, number = 'closed', chosen.get('number')
    elif chosen.get('isDraft') is True:
        phase, number = 'draft', chosen.get('number')
    else:
        phase, number = 'open', chosen.get('number')

    commits = []
    if tip and base:
        # `--` AFTER the revisions, per Global Constraints. SURVIVES mutation by
        # construction, exactly as the `rev-list` one does: `$base` comes from
        # the registry and always yields a `..`-bearing operand, so git can only
        # read it as a range and no fixture can distinguish the two forms. The
        # rule exists because git's own disambiguation is positional, and
        # `git diff --quiet -- A B` silently treats both shas as PATHSPECS
        # (verified: exit 0, where the same call with `--` last exits 1).
        r = git(main, 'log', '--format=%H%x1f%s%x1f%b%x1e', base + '..refs/heads/' + branch, '--')
        if r.returncode == 0:
            for rec in r.stdout.split('\x1e'):
                rec = rec.strip('\n')
                if not rec:
                    continue
                parts = (rec.split('\x1f') + ['', '', ''])[:3]
                commits.append({'sha': parts[0], 'subject': parts[1], 'body': parts[2].strip()})

    checked_at = int(time.time() * 1000)
    def put(field, value):
        with open(os.path.join(reg, id_ + '.' + field), 'w') as f:
            f.write(str(value))

    def clear(field):
        try:
            os.remove(os.path.join(reg, id_ + '.' + field))
        except FileNotFoundError:
            pass

    # NARROW FIRST, WIDEN LAST — final-round integration New Finding 9. These
    # are two files and there is no way to write two files atomically, so the
    # question is not "can a kill land between them" (it can) but "which pairs
    # can a kill leave on disk". The shipped order was `put('prphase')` first
    # and the number nineteen lines later, whose intermediate state is
    # {new phase, OLD number} — and for the commonest transition of all, a
    # merged PR going away, that is precisely {'none', 42}: the one pair
    # docket 1 proved otherwise unconstructible, the one `fleet.ts` renders as
    # `#42` under copy that says "no pull request yet", and the one
    # `ws-archive` files as `merged:#42` for a PR that no longer binds here.
    #
    # Three steps in this order instead, so every intermediate is a pair that
    # was ACTUALLY answered together, or a phase with no number at all:
    #     clear number  ->  {old phase, absent}
    #     put phase     ->  {new phase, absent}
    #     put number    ->  {new phase, new number}
    # `{X, absent}` is not a new state to teach anyone: it is what a workspace
    # that never had a PR looks like, what a `merged` row with no `number`
    # field looks like, and `_reg_get`'s readers already treat a missing or
    # non-numeric `prnumber` as null (ccd:1273, ccd:2650). The window is a
    # DEGRADED reading, never a false one, and the old window's was false.
    #
    # The unconditional `clear` also costs one unlink on the path where the
    # number is unchanged, which is the price of not having to reason about
    # which transitions are safe.
    clear('prnumber')
    put('prphase', phase)
    # phase and number are ONE answer, so a writer that persists half of it
    # lies. A PR that is deleted, force-pushed out of reachability, or whose
    # slug ws-reap has recycled leaves {phase:'none', number:42} on disk if the
    # number is merely left alone: fleet.ts hands that pair straight to the
    # wire, so the cap renders `#42` under a phase whose own copy is "no pull
    # request yet", and ws-archive reads the same field and files
    # `archivedreason merged:#42` for a PR that no longer binds to this
    # workspace. REMOVED rather than blanked, so the field is absent exactly as
    # it is for a workspace that never had a PR.
    #
    # NO FAILED READ REACHES THIS LINE, and it takes two guards to say that, not
    # one. `_gh_pr_list` returns before `_pr_py` is called for every read that
    # failed by EXIT CODE. An rc-0 read whose body is not a list of rows does
    # reach `_pr_py` — and `rows_in` answering None returns above, before any
    # `put`/`clear` runs. The comment here used to claim the first guard alone
    # made this unreachable; it did not, and a `gh` that exited 0 with an empty
    # or unparseable stdout cleared a persisted `merged:#42`.
    if number is not None:
        put('prnumber', number)
    put('prcheckedat', checked_at)

    sys.stdout.write(json.dumps({
        'id': id_, 'project': project, 'repo': repo, 'branch': branch, 'base': base,
        'baseShort': base_short, 'tip': tip, 'ahead': ahead, 'dirty': dirty,
        'commits': commits, 'template': template or None, 'rows': rows,
        'phase': phase, 'number': number, 'checkedAt': checked_at, 'reason': reason,
    }) + '\n')

elif mode == 'pick':
    (main, branch, base_short, tip) = sys.argv[2:6]
    rows = annotate(rows_in(), main, tip, branch, base_short)
    # A row that matches the branch and base but whose head is NOT reachable
    # from our tip gets its own token: "no PR at all" and "a PR that is not
    # ours" are different sentences, and only one of them is about a stranger.
    near = [r for r in rows
            if r.get('headRefName') == branch and r.get('baseRefName') == base_short
            and r.get('isCrossRepository') is False]
    chosen = pick(rows, branch, base_short)
    if chosen is None:
        sys.stdout.write('!pr-head-not-ours\n' if near else '')
    elif not is_merged(chosen, branch, base_short):
        sys.stdout.write('!not-merged\n')
    else:
        sys.stdout.write('\t'.join([
            str(chosen.get('number') or ''), str(chosen.get('url') or ''),
            str((chosen.get('mergeCommit') or {}).get('oid') or ''),
            str(chosen.get('headRefOid') or ''),
        ]) + '\n')
PY
}

# ── workspace slugs ────────────────────────────────────────────────
# No dots: tmux -t parses `session:window.pane`. No slashes: systemd
# instance names escape them. Lowercase only, so a slug is never ambiguous
# on a case-insensitive filesystem.
WS_ADJ=(quiet swift amber still brisk clear plain warm bright calm keen soft)
WS_NOUN=(mesa river ridge harbor meadow canyon summit hollow prairie basin cove delta)

_ws_slug_valid() { [[ "$1" =~ ^[a-z0-9][a-z0-9-]{1,30}$ ]]; }

# A slug is free only when the registry holds NOTHING for `<project>-<slug>` —
# verification round 3 P1. The old form was `[[ ! -f "$REG/$1-$2.uuid" ]]`, i.e.
# one field standing in for eighteen, and `_reg_purge` (see the long note there)
# now removes `.archived` and `.reaping` AFTER `.uuid` on purpose. A SIGKILL or
# an OOM in that window — this project's speciality — leaves state markers with
# no `.uuid`, which the old test read as a clean slug and handed to the next
# `ws-add`; `cmd_ws_add` purges nothing for the id it creates, so the markers
# became the new workspace's. The property this establishes is not "the markers
# in particular are seen" but that a PARTIALLY-PURGED ID CANNOT BE REUSED AS IF
# IT WERE CLEAN, wherever the interruption landed and whichever function was
# interrupted — `cmd_ws_add`'s own `_reg_set` run has the same windows, and a
# field added tomorrow is covered without anyone remembering to come back here.
#
# The `*.*` skip is `_reg_purge`'s, for `_reg_purge`'s reason and measured the
# same way: a field name never contains a dot, so `$id.<field>` has exactly one
# dot after the id, while `$REG/demo-quiet-mesa.x-y.uuid` — the id
# `demo-quiet-mesa.x-y`, project `demo-quiet-mesa.x`, slug `y`, legal because
# project DIRECTORY names may hold dots — has two. Without the skip that
# stranger would wedge slug `quiet-mesa` in project `demo` permanently.
#
# The direction of the residual leak changes with this and does not go away: a
# purge interrupted in its last window now costs a SLUG (144 per project,
# recycled by ws-reap) rather than costing the next workspace its archive and
# reap gates. Refusing to build is the safe direction, it is visible — `ws-add`
# names the files below — and `rm` on the named files reclaims it.
_ws_slug_free() {   # project slug -> 0 when no registry file exists for the id
  local id="$1-$2" f suffix
  for f in "$REG/$id".*; do
    # Unmatched-glob case, exactly as in `_reg_purge`: no `nullglob` here, so a
    # glob with no matches stays its own literal text and `-e` is false.
    [[ -e "$f" ]] || continue
    suffix="${f#"$REG/$id."}"
    [[ "$suffix" == *.* ]] && continue
    return 1
  done
  return 0
}

_ws_slug_residue() {   # project slug -> the field names the registry still holds
  local id="$1-$2" f suffix out=""
  for f in "$REG/$id".*; do
    [[ -e "$f" ]] || continue
    suffix="${f#"$REG/$id."}"
    [[ "$suffix" == *.* ]] && continue
    out+="${out:+, }$suffix"
  done
  printf '%s' "$out"
}

_ws_slug_new() {   # project -> echo a free, valid slug (or fail)
  local project="$1" slug i
  if [[ -n "${CCD_WS_SLUG:-}" ]]; then             # tests and manual naming
    _ws_slug_valid "$CCD_WS_SLUG" || return 1
    _ws_slug_free "$project" "$CCD_WS_SLUG" || return 1
    echo "$CCD_WS_SLUG"; return 0
  fi
  for ((i = 0; i < 60; i++)); do
    slug="${WS_ADJ[RANDOM % ${#WS_ADJ[@]}]}-${WS_NOUN[RANDOM % ${#WS_NOUN[@]}]}"
    _ws_slug_free "$project" "$slug" && { echo "$slug"; return 0; }
  done
  return 1
}

_ws_least_loaded() {   # -> the home-able account with the most headroom
  local best="" bs=1000 w sc
  for w in "${VALID_WRAPPERS[@]}"; do
    sc=$(_limit_score "$w"); [[ -z "$sc" ]] && sc=0
    (( sc < bs )) && { bs=$sc; best="$w"; }
  done
  echo "$best"
}

# CCD_DISK_FLOOR_GB is the one environment override ccd honours, because unlike
# PROJECTS_ROOT/WORKTREES_ROOT it can only make ccd REFUSE to act — it can never
# aim a destructive command at a different tree.
CCD_DISK_FLOOR_GB="${CCD_DISK_FLOOR_GB:-10}"

_ws_disk_free_gb() {   # dir -> whole GiB available on the filesystem holding it
  local d="$1"
  # WORKTREES_ROOT is created lazily, so walk up to the nearest parent that
  # exists; df on a missing path just fails.
  while [[ ! -d "$d" && "$d" != / && -n "$d" ]]; do d=$(dirname "$d"); done
  # -P guarantees one filesystem per line, so a long device name cannot wrap the
  # row and shift field 4. -k pins the block size to 1K, which -P alone does not
  # (GNU df -P reports 512-byte blocks under POSIXLY_CORRECT).
  # NOT `df --output=avail`: GNU df rejects -P and --output together.
  local kb; kb=$(df -Pk "$d" 2>/dev/null | awk 'NR==2 {print $4}')
  [[ "$kb" =~ ^[0-9]+$ ]] || return 1
  echo $(( kb / 1024 / 1024 ))
}

cmd_ws_add() {   # project [slug] — new worktree + session for an existing project
  local project="${1:?usage: ccd ws-add <project> [slug]}" slug="${2:-}"
  [[ "$project" =~ ^[A-Za-z0-9._-]+$ ]] || die "invalid project '$project'"
  local main="$PROJECTS_ROOT/$project"
  [[ -d "$main/.git" ]] || die "not a git repo: $main"

  # Before anything is created: no worktree, no branch, no registry entry, no
  # session. A refusal here must leave the box exactly as it found it.
  local free
  free=$(_ws_disk_free_gb "$WORKTREES_ROOT") \
    || die "could not read free space for $WORKTREES_ROOT"
  (( free >= CCD_DISK_FLOOR_GB )) \
    || die "only ${free}G free on $WORKTREES_ROOT, floor is ${CCD_DISK_FLOOR_GB}G — reclaim space first: ccd ws-gc (archived workspaces are listed there and removed only on confirmation; pinned commits: ccd ws-attic --session <id>)"

  # The refusal NAMES WHAT IT FOUND. `_ws_slug_free` is an any-field check
  # (round-3 P1), so it also refuses a slug whose only trace is the residue of
  # an interrupted purge — and "slug in use" on its own would send the operator
  # looking for a workspace that is not there. The field list is the reclaim
  # instruction: those are the files, in $REG, and nothing else holds the slug.
  [[ -n "$slug" ]] && { _ws_slug_valid "$slug" || die "invalid slug '$slug'"; \
                        _ws_slug_free "$project" "$slug" \
                          || die "slug in use: $slug — $REG/$project-$slug.{$(_ws_slug_residue "$project" "$slug")}"; }
  [[ -z "$slug" ]] && { slug=$(CCD_WS_SLUG="${CCD_WS_SLUG:-}" _ws_slug_new "$project") \
                        || die "could not find a free slug for $project"; }

  git -C "$main" fetch origin --quiet 2>/dev/null || echo "warn: fetch failed; basing on the last known origin" >&2
  local base
  base=$(git -C "$main" symbolic-ref --quiet refs/remotes/origin/HEAD) \
    || die "no origin/HEAD — run: git -C '$main' remote set-head origin -a"
  base="${base#refs/remotes/}"

  local wt="$WORKTREES_ROOT/$project/$slug"
  [[ "$wt" != *\'* ]] || die "path must not contain a single quote: $wt"
  mkdir -p "$WORKTREES_ROOT/$project"
  # ws/ namespaces the branch: it sorts with its siblings, matches the type/slug
  # shape every repo here already uses, and says at a glance that the branch is
  # machine-created. The directory and the session id keep the BARE slug — a
  # slash in either would break tmux -t (session:window.pane) and systemd
  # instance names. --no-track is load-bearing: $base is a remote-tracking ref,
  # so git's branch.autoSetupMerge default would otherwise make origin/main this
  # branch's upstream, and `git pull` in the workspace would merge main into it.
  local branch="ws/$slug"
  git -C "$main" worktree add -b "$branch" --no-track "$wt" "$base" --quiet \
    || die "git worktree add failed for $wt"

  # Shared across every worktree of this repo, local only, never committed.
  # Asked of git rather than resolved with `cd`, for the reason spelled out at
  # _ws_common_dir below: --git-common-dir answers with a bare `.git` here (this
  # IS the repo's own checkout), and a captured `cd` can prepend its own print to
  # the answer. Measured what that costs, since $common is a path this WRITES
  # through: the answer arrives two lines long, so `mkdir -p "$common/info"`
  # creates a junk directory whose name ends in a newline, the `.ccrc/` line is
  # appended inside that, and $main's real info/exclude never gets it — leaving
  # .ccrc/ un-ignored in every worktree of the repo.
  local common; common=$(git -C "$main" rev-parse --path-format=absolute --git-common-dir)
  mkdir -p "$common/info"
  grep -qxF '.ccrc/' "$common/info/exclude" 2>/dev/null || echo '.ccrc/' >> "$common/info/exclude"

  local id="$project-$slug"
  local uuid; uuid=$(cat /proc/sys/kernel/random/uuid)
  local hw; hw=$(_ws_least_loaded)
  _reg_set "$id" wrapper "$hw";   _reg_set "$id" project "$project"
  _reg_set "$id" workdir "$wt";   _reg_set "$id" uuid "$uuid"
  _reg_set "$id" workspace "$slug"; _reg_set "$id" base "$base"
  _reg_set "$id" branch "$branch"
  _ws_seed_home "$id" "$hw"

  # A failed setup hook leaves a usable-but-unscaffolded workspace. Say so;
  # never remove work on the strength of a hook's exit code.
  if [[ -x "$main/.ccrc/workspace.sh" ]]; then
    if MAIN="$main" WT="$wt" "$main/.ccrc/workspace.sh"; then
      _reg_set "$id" setup ok
    else
      _reg_set "$id" setup failed
      echo "warn: .ccrc/workspace.sh failed for $id — workspace kept, not scaffolded" >&2
    fi
  fi

  _spawn "$id" new; _reg_set "$id" started 1
  _ws_supervise "$id"
  echo "workspace $id on $hw — $wt (branch $branch, from $base)"
}

# Every path git prints is fully resolved ($HOME/worktrees -> /data/worktrees ->
# /mnt/...), while the registry keeps the path ccd wrote. Resolving needs the
# path to EXIST, and the whole point of the caller below is the case where it
# does not — so resolve the longest existing prefix and re-attach the rest.
_ws_realpath() {   # path -> same path, existing prefix resolved
  local p="$1" head="$1" tail="" real
  while [[ ! -d "$head" && "$head" != / && "$head" != . && -n "$head" ]]; do
    tail="/$(basename -- "$head")$tail"; head=$(dirname -- "$head")   # -- : a path may start with -
  done
  # `>/dev/null` on the cd, not merely `2>`: `pwd -P` is the answer, so anything
  # cd itself prints would be captured as part of it. bash's own cd prints on a
  # CDPATH hit (not reachable here — $head is only ever an absolute path walked
  # upwards), but a `cd` exported as a shell function prints whatever it likes,
  # and that is reachable: bash imports it into this script through the
  # environment. Redirecting cd alone leaves `pwd -P` free to answer.
  real=$(cd -- "$head" >/dev/null 2>&1 && pwd -P) || { echo "$p"; return 0; }
  # `pwd -P` prints "/" for the root and never a trailing slash anywhere else,
  # so stripping is only ever right when there is a tail to re-attach: for the
  # root with no tail, "${real%/}" strips the only character there is.
  if [[ -n "$tail" ]]; then echo "${real%/}$tail"; else echo "$real"; fi
}

# Which repository a directory belongs to, as one absolute, symlink-collapsed
# path — the only question that distinguishes "$main's worktree" from "some
# other repo that was put at that path".
#   exit: non-zero and NO output when the path is in no repository at all —
#         callers must treat the empty string as "no answer", never as a match.
# `--path-format=absolute` (git >= 2.31; this fleet is on 2.43) is doing the work.
# Plain `--git-common-dir` is not comparable as printed — a bare `.git` from a
# repo's own checkout, `../.git` from a subdirectory of one, absolute only from a
# linked worktree — and resolving it here meant a `cd` inside a command
# substitution, whose stdout ccd does not get to control: bash's own cd prints the
# directory it landed on when a relative operand hits CDPATH, and a `cd` exported
# as a shell function prints whatever it likes. Either print is captured as part
# of the answer (`2>/dev/null` catches neither), and the caller then compares
# multi-line garbage — two wrong answers that happen to match wave a squatter
# through, two that do not refuse a healthy workspace. Asking git leaves no `cd`
# to shadow. Measured on git 2.43.0 against the cd-based resolution it replaces:
# byte-identical for a repo's own checkout, a subdirectory of one, a linked
# worktree, a worktree of a worktree, --separate-git-dir, a `.git` that is itself
# a symlink, a bare repo, and a main and its worktree reached through two
# different symlinks (both sides still compare equal); and failing with no output
# for a directory in no repository at all.
_ws_common_dir() {   # dir -> /abs/.../.git
  local dir="$1" gcd
  gcd=$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
  [[ -n "$gcd" ]] || return 1
  printf '%s\n' "$gcd"
}

# THE branch source of truth: git's own record of which branch the worktree at
# $2 has checked out, read from the repo at $1. Not `rev-parse HEAD` inside the
# worktree — that answers from whatever repository owns that directory, which
# after a hand-deletion and a stray `git init` need not be $1 at all, and the
# name it returns is then deleted in $1. This lookup cannot leave $1, survives
# the directory being gone (the record stays, marked `prunable`), and follows a
# branch rename whether ccd or the user did it.
#   stdout: branch name, empty for a detached HEAD
#   exit:   0 = git has a registration for that path, 1 = it has none
# `git worktree list` failing (repo gone, corrupt, not a repo) yields no records
# and therefore exit 1 — "no evidence", which is the reading that deletes
# nothing.
_ws_wt_branch() {   # main path
  local main="$1" path="$2" real cur="" line
  real=$(_ws_realpath "$path")
  while IFS= read -r line; do
    case "$line" in
      "worktree "*) cur="${line#worktree }" ;;
      "branch "*)   [[ "$cur" == "$real" || "$cur" == "$path" ]] && { echo "${line#branch refs/heads/}"; return 0; } ;;
      detached)     [[ "$cur" == "$real" || "$cur" == "$path" ]] && { echo ""; return 0; } ;;
    esac
  done < <(git -C "$main" worktree list --porcelain 2>/dev/null)
  return 1
}

cmd_ws_rm() {   # id — tear a workspace down. Refuses anything it might destroy.
  local id="${1:?usage: ccd ws-rm <id>}"
  [[ -f "$REG/$id.uuid" ]] || die "no such session: $id"
  local ws project workdir
  ws=$(_reg_get "$id" workspace); project=$(_reg_get "$id" project); workdir=$(_reg_get "$id" workdir)
  # The absence of a workspace field is what distinguishes a main checkout.
  [[ -n "$ws" ]] || die "$id is not a workspace — refusing to remove a main checkout"
  [[ -n "$project" && -n "$workdir" ]] || die "incomplete registry for '$id'"
  local main="$PROJECTS_ROOT/$project"

  # Gather the evidence BEFORE anything is torn down, and gather it from git.
  # `registered` is what decides whether there is anything for `worktree remove`
  # to clear, so it is read from $? on its own line: with no `set -e`, a
  # `local branch=$(...)` would return local's status, not the function's.
  local branch registered
  branch=$(_ws_wt_branch "$main" "$workdir"); registered=$?

  if [[ -d "$workdir" ]]; then
    # REFUSE FIRST, tear down second. A directory that exists but is not a
    # worktree of $main is not ours to remove and its HEAD is not ours to
    # delete: move or delete it by hand and re-run, and the missing-directory
    # path below will finish the job.
    #
    # `registered` cannot decide this on its own: it comes from git's RECORD,
    # and the record outlives the directory. Delete the directory by hand and
    # put anything else back at that path — a `git init`, another repo's
    # worktree — and the record still names it, so `registered` is 0 while the
    # directory belongs to someone else. Trusting it alone killed the session
    # and disabled the unit, and only THEN did `worktree remove` refuse. So ask
    # the directory too, and require both to say $main.
    local wd_common main_common
    wd_common=$(_ws_common_dir "$workdir"); main_common=$(_ws_common_dir "$main")
    (( registered == 0 )) && [[ -n "$main_common" && "$wd_common" == "$main_common" ]] \
      || die "$workdir is not a worktree of $main — nothing was touched; move or delete the directory by hand, then re-run (with it gone, ccd clears the leftover record itself; \`git worktree prune\` will not, while the directory is there)"
    # --porcelain counts untracked files, which is what `git worktree remove`
    # itself objects to. Doing this after the kill would leave the uncommitted
    # work intact but the session dead and out of supervision — and the refusal
    # would be lying about it. A status we could not read is not a clean one
    # (same rule as _ws_gc_dirty).
    #
    # AND THE EXIT CODE IS ONLY HALF OF "COULD NOT READ" — final-round
    # verification P2. The integration-5 class was closed at `_ws_reap_eval`
    # (ccd:2340) and `_ws_archive_manifest` (ccd:1238) and left open HERE, in
    # the one destructive verb a human types by hand, three lines under the
    # comment that already states the rule. Measured on git 2.43: `chmod 000` on
    # a TRACKED directory holding a modified file gives rc 0, EMPTY stdout and
    # `warning: could not open directory 'tracked/'` on stderr — so `$dirty` was
    # empty, the guard passed, `_ws_unsupervise` and `tmux kill-session` ran,
    # and only `git worktree remove` finally refused ("Directory not empty"),
    # printing a message about unlocking a tree while the uncommitted work it
    # never saw was still in it. Exactly the outcome this block's own comment
    # exists to prevent. The uncommitted file survived only because a directory
    # git cannot read is also one git cannot rmdir; that is luck, not a design.
    #
    # ANY diagnostic refuses, with the polarity `_ws_reap_eval` states out loud
    # for the same read: a benign `warning:` a future git decides to print makes
    # this workspace un-removable until the warning is fixed. That is the right
    # direction for a verb whose whole contract is "refuses anything it might
    # destroy", and the alternative — a wording allowlist — is walked straight
    # through by a translated warning. Two statements and a scratch file rather
    # than a pipeline, because `local x=$(cmd)` returns local's status.
    local dirty derrf derr drc
    derrf=$(mktemp) || die "could not make a scratch file to read $workdir — nothing was touched"
    dirty=$(git -C "$workdir" status --porcelain 2>"$derrf"); drc=$?
    derr=$(cat "$derrf" 2>/dev/null); rm -f "$derrf"
    { (( drc == 0 )) && [[ -z "$derr" ]]; } \
      || die "could not read $workdir${derr:+ ($derr)} — nothing was touched"
    [[ -z "$dirty" ]] || die "worktree not removed (uncommitted changes?) — nothing was touched: $workdir"
    local nested
    nested=$(_ws_nested_checkouts "$workdir") \
      || die "could not scan $workdir for nested checkouts${_WS_NESTED_WHY:+ ($_WS_NESTED_WHY)} — nothing was touched"
    [[ -z "$nested" ]] \
      || die "worktree not removed — nested checkouts live under it, and ccd deletes no repository it did not create: ${nested//$'\n'/, } — nothing was touched"
  fi

  _ws_unsupervise "$id"
  tmux kill-session -t "$(_tmux "$id")" 2>/dev/null || true

  if (( registered == 0 )); then
    # Not gated on the directory existing: `git worktree remove` clears the
    # registration either way, and while that registration stands git refuses to
    # delete the branch it names ("cannot delete branch used by worktree at").
    # Still no --force: the tree can have changed since the check above, and a
    # locked worktree refuses either way. By here the session IS stopped, so say
    # that rather than repeat "nothing touched".
    # The recovery has to work in the state it is printed in. `worktree prune`
    # only drops records whose directory is MISSING, so it is named for exactly
    # that case and not offered as a general remedy — the "directory is there
    # but is not ours" case refuses above, before anything is torn down.
    git -C "$main" worktree remove "$workdir" \
      || die "worktree record not cleared for $workdir — the session was stopped; git refused: unlock it (git -C $main worktree unlock $workdir) or clean the tree, then re-run — and if the directory is already gone, git -C $main worktree prune clears the record"
  fi

  local reg_branch; reg_branch=$(_reg_get "$id" branch)
  if [[ -n "$branch" ]]; then
    # git had a record, so the registry is a witness, never the decider: a
    # divergence means the branch was renamed outside ccd, and the name to
    # delete is the one git actually had checked out there.
    [[ -n "$reg_branch" && "$reg_branch" != "$branch" ]] \
      && echo "note: registry recorded '$reg_branch', git's worktree record says '$branch' — deleting '$branch'; '$reg_branch' left alone" >&2
    # No -D: an unmerged branch must survive — and must SAY so, or it is
    # orphaned in silence.
    git -C "$main" branch -d "$branch" 2>/dev/null \
      || echo "kept branch $branch (unmerged, or still in use) — delete it with: git -C $main branch -D $branch" >&2
  elif (( registered == 0 )); then
    echo "note: $workdir was on a detached HEAD — no branch to delete" >&2
    # "No branch to delete" is only half the truth when the registry named one:
    # the teardown above just took away its worktree and its registration, and
    # the line below takes away its registry entry, leaving it with no ws-gc row
    # either — invisible, which is the state this whole path exists to prevent.
    # Same rung-3 rule as the no-record case: git never corroborated that name
    # for this path (the record it did hold was detached), so name it and hand
    # over the command rather than delete it unverified.
    if [[ -n "$reg_branch" ]] && git -C "$main" show-ref --verify --quiet "refs/heads/$reg_branch" 2>/dev/null; then
      echo "warn: registry says branch '$reg_branch', which still exists and now has no worktree — not deleting it unverified. If it is finished: git -C $main branch -d $reg_branch" >&2
    fi
  elif [[ -n "$reg_branch" ]] && git -C "$main" show-ref --verify --quiet "refs/heads/$reg_branch" 2>/dev/null; then
    # No git record at all (someone pruned it by hand). The registry name is
    # uncorroborated — the only thing that ever tied it to this path is now
    # gone — and deleting the wrong branch costs incomparably more than leaving
    # the right one behind. Name it and hand over the command.
    echo "warn: no worktree record for $workdir; registry says branch '$reg_branch', which still exists — not deleting it unverified. If it is finished: git -C $main branch -d $reg_branch" >&2
  fi

  _reg_purge "$id"                                                          # finding F3
  echo "removed workspace $id"
}

# ── renaming a workspace branch ────────────────────────────────────
# The subset of `git check-ref-format` that matters, checked explicitly rather
# than trusted to git's exit code: an invalid name must be refused BEFORE any
# git command is run with it as an argument.
_ws_branch_valid() {
  local b="$1"
  [[ -n "$b" ]]                              || return 1
  [[ "$b" =~ ^[A-Za-z0-9._/-]+$ ]]           || return 1   # no space, colon, glob, ~, ^, @{
  [[ "$b" != -* ]]                           || return 1   # git would read it as an option
  [[ "$b" != /* && "$b" != */ ]]             || return 1
  [[ "$b" != *..* ]]                         || return 1
  [[ "$b" != *.lock && "$b" != *.lock/* ]]   || return 1   # any component, not just the last
  return 0
}

cmd_ws_rename() {   # id new-branch — rename a workspace branch before it is pushed
  local id="${1:?usage: ccd ws-rename <id> <new-branch>}"
  local new="${2:?usage: ccd ws-rename <id> <new-branch>}"
  [[ -f "$REG/$id.uuid" ]] || die "no such session: $id"

  local ws project workdir
  ws=$(_reg_get "$id" workspace); project=$(_reg_get "$id" project); workdir=$(_reg_get "$id" workdir)
  # The absence of a workspace field is what distinguishes a main checkout.
  [[ -n "$ws" ]] || die "$id is not a workspace — refusing to rename a main checkout's branch"
  [[ -n "$project" && -n "$workdir" ]] || die "incomplete registry for '$id'"
  # KEPT deliberately, now that the branch no longer has to be read out of the
  # directory. The record does survive a hand-deletion, so this rename WOULD
  # work — but ws-rename exists for a workspace still being worked in, and a
  # vanished directory is a broken one. Renaming would print a success line and
  # say nothing about the breakage, hiding exactly what ws-gc exists to surface;
  # refusing names it, and ws-rm already handles a gone directory deliberately.
  [[ -d "$workdir" ]] || die "worktree is gone: $workdir"
  _ws_branch_valid "$new" || die "invalid branch name: $new"

  local main="$PROJECTS_ROOT/$project"
  # THE branch source of truth, same as cmd_ws_rm: git's own record for that
  # path, read from $main. Never `rev-parse` inside $workdir — that answers from
  # whatever repository owns the DIRECTORY, and a hand-deletion plus a stray
  # `git init` made that a stranger, whose branch was then read AND renamed.
  # Two statements: with no `set -e`, `local old=$(...)` returns local's status.
  local old registered
  old=$(_ws_wt_branch "$main" "$workdir"); registered=$?
  # Three rungs, because "no record at all" and "recorded detached" are different
  # states with different remedies, and only one of them is about a broken record.
  #   3: no registration at all (a botched hand cleanup that deleted
  #      $main/.git/worktrees/<name>). Nothing corroborates the registry's name
  #      any more, so there is no name to rename — same rule as ws-rm's
  #      uncorroborated case, and the registry field is named, never used.
  #      `git worktree repair` is NOT offered: measured on git 2.43.0 it exits 1
  #      here ("unable to locate repository") — it cannot rebuild a record that
  #      was deleted. Re-adding the worktree can, once the orphaned checkout is
  #      out of the way (measured: rc 0, and no prune needed — no record stands).
  local reg_branch; reg_branch=$(_reg_get "$id" branch)
  (( registered == 0 )) \
    || die "no worktree record for $workdir in $main — nothing renamed; with no registration no branch name is corroborated (the registry says '${reg_branch:-?}', which nothing now ties to that path): move the leftover directory aside, then git -C $main worktree add $workdir ${reg_branch:-<branch>}"
  #   2: registered, and the registration says `detached`. The remedy is to check
  #      a branch out, not to repair anything.
  [[ -n "$old" ]] || die "$id is on a detached HEAD — nothing to rename"
  #   1: registered, with a branch — $old is git's own name for it.
  # ...but a registration outlives its directory, so it can be STALE: delete the
  # directory by hand, put anything else at that path, and git still names it —
  # `registered` is still 0 and $old is still ccrc's branch, so nothing above
  # notices that the workspace this rename is *about* has been taken over. Ask
  # the directory too and require both to say $main, exactly as cmd_ws_rm does.
  # (The stranger is never written to either way, now that both the read and the
  # rename are scoped to $main; what this guard refuses is renaming on behalf of
  # a workspace that no longer exists.) Recovery measured on git 2.43.0: the
  # stale record makes `worktree add` refuse until `prune` clears it, and prune
  # only drops records whose directory is missing — hence both, in that order.
  local wd_common main_common
  wd_common=$(_ws_common_dir "$workdir"); main_common=$(_ws_common_dir "$main")
  [[ -n "$main_common" && "$wd_common" == "$main_common" ]] \
    || die "$workdir is not a worktree of $main — nothing renamed; move or delete the directory by hand, then git -C $main worktree prune && git -C $main worktree add $workdir $old"
  [[ "$old" != "$new" ]] || die "already named $new"

  # Renaming after a push leaves the old name on the remote and creates a second
  # branch there on the next push. An upstream is the evidence that happened.
  # Asked in $main and about $old by name: branch config is shared across a
  # repo's worktrees, so this is the same answer $workdir would give — from the
  # repo that actually owns the branch. Measured on git 2.43.0: rc 0 printing
  # `origin/<old>` with an upstream, rc 128 without one.
  if git -C "$main" rev-parse --abbrev-ref "$old@{u}" >/dev/null 2>&1; then
    die "$old has an upstream — it is already on the remote; rename before pushing, not after"
  fi

  git -C "$main" show-ref --verify --quiet "refs/heads/$new" \
    && die "branch already exists locally: $new"

  # --exit-code: 0 = the head exists, 2 = it does not, anything else = we could
  # not ask. Unreachable is not the same as taken.
  local rc; git -C "$main" ls-remote --exit-code --heads origin "$new" >/dev/null 2>&1; rc=$?
  case "$rc" in
    0) die "branch already exists on origin: $new" ;;
    2) : ;;
    *) echo "warn: could not reach origin to check for '$new' — renaming anyway" >&2 ;;
  esac

  # Scoped to the repo that owns the branch, and named on both sides so it can
  # never resolve against whatever HEAD $workdir happens to have. Measured on git
  # 2.43.0: this works on a branch checked out in a linked worktree and retargets
  # that worktree's HEAD and its registration with it (before `branch
  # refs/heads/feat/a`, after `branch refs/heads/feat/b`, rc 0) — which is what
  # lets ws-rm read the new name back out of the record afterwards.
  git -C "$main" branch -m "$old" "$new" || die "rename failed: $old -> $new"
  _reg_set "$id" branch "$new"
  echo "renamed $id: $old -> $new"
}

cmd_caps() {   # one verb name per line — what THIS copy of ccd implements.
  # ~/.local/bin/ccd is a COPY, not a symlink to the repo, so a verb can pass
  # the agent's whitelist and still not exist on the box. The agent reads this
  # at start and reports it in its ready frame; the server refuses to emit a
  # verb the agent did not advertise. NOT whitelisted — the agent runs it
  # directly, and it is a pure read.
  #
  # It takes no argv, and says so rather than ignoring it. This whole verb exists
  # so a caller can find out what this copy of ccd supports; answering `ccd caps
  # --json` with the plain list — which is what silently discarding argv did —
  # hands that caller a shape it did not ask for and no way to tell. Every other
  # verb here asserts its argv exactly; this one is the one whose whole job is
  # honesty about capability.
  [[ $# -eq 0 ]] || die "usage: ccd caps"
  cat <<'EOF'
attach
caps
clip
enable
ensure
list
menu
pick
pr-open
pr-state
prefer
start
stop
supervise
swap
swap-self
ws-add
ws-archive
ws-attic
ws-audit
ws-gc
ws-reap
ws-rename
ws-restore
ws-rm
ls
EOF
}

cmd_ws_archive() {   # ccd ws-archive --session <id> — fold a merged workspace
  # out of the live fleet. DESTROYS NOTHING: no worktree remove, no branch -d,
  # no rm of the registry. Its one cost is the tmux pane (scrollback and any
  # in-flight turn), which is why it demands an affirmative idle.
  [[ $# -eq 2 && $1 == --session ]] || die "usage: ccd ws-archive --session <id>"
  local id=$2
  [[ $id =~ ^[A-Za-z0-9._-]+$ ]] || die "bad session id"
  [[ -f "$REG/$id.uuid" ]]       || die "no such session: $id"
  [[ -n "$(_reg_get "$id" workspace)" ]] \
    || die "not a workspace — refusing to archive a main checkout"
  # `return`, not `exit`: ccd is sourceable (the BASH_SOURCE guard below), so an
  # `exit` here would terminate an in-process batch caller at its first
  # already-archived workspace and skip the rest with a success code.
  [[ -f "$REG/$id.archived" ]] && { echo "already archived $id"; return 0; }

  local workdir; workdir=$(_reg_get "$id" workdir)
  [[ -n "$workdir" ]] || die "incomplete registry for '$id'"
  # The same refusal ws-restore makes, for a stronger reason: with the directory
  # gone every tree field in the manifest reads PRISTINE — dirty 0 because the
  # status read failed, worktreeBytes 0 from _ws_gc_bytes's '-' fallback,
  # ignoredDigest = sha256("") — and the output still said "nothing deleted".
  [[ -d "$workdir" ]] \
    || die "worktree is gone: $workdir — cannot describe it for the archive record; see: ccd ws-attic --session $id"

  local st
  st=$(_ws_status "$id") || die "status-unknown"
  [[ "$st" != busy ]] || die "session-busy"

  # Build the manifest BEFORE anything is torn down, and refuse if it cannot be
  # told truthfully. Its exit status used to be discarded and every field inside
  # it 2>/dev/null-swallowed, with no [[ -s ]], no parse and no guard before the
  # `archived` marker went down — so a workspace whose worktree had moved away
  # archived at exit 0 with a manifest asserting a clean, empty tree, and a box
  # without python3 persisted syntactically invalid JSON as the archive record.
  # This is what Task 5's audit ladder and ws-reap compare against: a manifest
  # that lies pristine is a manifest that authorises a deletion. The helper says
  # on stderr which rung refused.
  local manifest
  manifest=$(_ws_archive_manifest "$id") \
    || die "cannot describe $id truthfully — nothing was touched"
  [[ -n "$manifest" ]] || die "empty archive manifest for $id — nothing was touched"
  # Parsed, not merely non-empty: the fields are individually guarded above, and
  # this is what keeps a future unquoted or non-numeric field from becoming a
  # record that only LOOKS like JSON.
  printf '%s' "$manifest" | python3 -c 'import json,sys; json.loads(sys.stdin.read())' 2>/dev/null \
    || die "archive manifest for $id is not valid JSON — nothing was touched"

  # Into the REGISTRY, never into the worktree — the worktree is the thing that
  # may later be deleted, and a manifest inside it would die with it.
  printf '%s\n' "$manifest" > "$REG/$id.archivemanifest"

  _ws_unsupervise "$id"                                   # clears Restart=always
  tmux kill-session -t "$(_tmux "$id")" 2>/dev/null || true

  local pr; pr=$(_reg_get "$id" prnumber)
  _reg_set "$id" archived "$(date +%s)"
  if [[ "$pr" =~ ^[0-9]+$ ]]; then _reg_set "$id" archivedreason "merged:#$pr"
  else                             _reg_set "$id" archivedreason "merged"; fi

  local note=""; [[ "$pr" =~ ^[0-9]+$ ]] && note=" (merged in #$pr)"
  echo "archived $id$note — worktree kept at $workdir, nothing deleted"
}

_ws_archive_manifest() {   # id -> one JSON object on stdout
  # NON-ZERO, with the reason on stderr, when the workspace cannot be described
  # truthfully. Every field used to be swallowed individually, which made the
  # unreadable cases indistinguishable from a clean, empty, unstashed tree.
  #
  # The line between the two halves of that sentence is the whole design, and it
  # is NOT "anything unexpected refuses":
  #   REFUSED — a question git cannot answer at all: no worktree record for this
  #     path, a directory belonging to another repository, an unreadable tree or
  #     ignored set, no python3 to quote with. There is nothing truthful to write.
  #   RECORDED — a fact about the world that happens not to be the expected one:
  #     the worktree is on another branch, or on a detached HEAD, or the branch
  #     the registry names no longer resolves. Those are describable, so they are
  #     described, and the DESTRUCTIVE verb refuses on them at the instant of
  #     deletion (Task 5/6: `registry-branch-drift`, `detached-head`,
  #     `branch-missing`) where a refusal costs nothing but a deferred cleanup.
  # Archive is lossless and runs unattended — Task 14 fires it every 120 s and
  # discards the exit code — so a refusal it cannot converge out of strands the
  # workspace in the live fleet forever with nothing on screen to say why. Same
  # argument Task 2's Context already makes for a dirty tree ("refusing would
  # strand merged-but-dirty workspaces in the live fleet permanently"), and the
  # same division `cmd_ws_rm` draws for this very divergence: the registry is a
  # witness, never the decider (ccd:465-471).
  local id="$1" project workdir branch base main tip dirty ignored stashes bytes pr transcript
  project=$(_reg_get "$id" project); workdir=$(_reg_get "$id" workdir)
  branch=$(_reg_get "$id" branch);   base=$(_reg_get "$id" base)
  [[ -n "$project" && -n "$workdir" && -n "$branch" ]] \
    || { echo "manifest: incomplete registry for '$id'" >&2; return 1; }
  main="$PROJECTS_ROOT/$project"

  # Every string field is quoted by python3, so without it NONE of them are and
  # the record is not JSON. Probed once, up front, rather than six times inside
  # the printf. ccd's other python3 call site (ccd:1447) warns and continues,
  # which is right for a best-effort transcript sanitize and wrong for a record
  # that authorises deletions.
  _json_str probe >/dev/null 2>&1 \
    || { echo "manifest: python3 unavailable — cannot quote JSON safely" >&2; return 1; }

  # ccrc asks $main; $workdir is only ever a path git is asked ABOUT. The tree
  # reads below are the one class that must be `-C "$workdir"` — they are
  # questions about that directory's contents — so they run only after git's own
  # record AND the directory itself have both said $main, which is the pair
  # cmd_ws_rm requires before it touches anything (ccd:432-435). `registered` is
  # read from $? on its own line: `local x=$(...)` returns local's status.
  local wthead registered wd_common main_common rc
  wthead=$(_ws_wt_branch "$main" "$workdir"); registered=$?
  (( registered == 0 )) \
    || { echo "manifest: $main has no worktree record for $workdir" >&2; return 1; }
  # DRIFT IS A FIELD, NOT A REFUSAL. `_ws_wt_branch` follows a rename whether ccd
  # or the user did it (ccd:377-383), so `$wthead` is git's own answer for this
  # path and `$branch` is the registry's claim: recorded side by side as `branch`
  # and `worktreeHead`, which is the pair Task 5 fingerprints (`worktreeHead=`)
  # and puts on the wire as `headMatchesRegistry`. "" is git's answer for a
  # recorded detached HEAD, and the same "" Task 5 compares against `$branch`.
  # Three ordinary states used to refuse here, permanently and identically on
  # retry: a `git branch -m` inside the worktree, a `git checkout other-branch`
  # to compare something, a `git bisect`. None of them makes the workspace
  # undescribable, and refusing left the sweep logging the same line every two
  # minutes forever.
  #
  # The record alone cannot decide the DIRECTORY: it outlives the directory, so a
  # hand-deletion plus a stray `git init` at the same path with the same branch
  # name still reads healthy and still answers $branch (measured on git 2.43).
  # That one stays a refusal — every tree field below would describe a stranger's
  # tree and file it under this workspace.
  wd_common=$(_ws_common_dir "$workdir"); main_common=$(_ws_common_dir "$main")
  [[ -n "$main_common" && "$wd_common" == "$main_common" ]] \
    || { echo "manifest: $workdir is not a worktree of $main" >&2; return 1; }

  # `--quiet` turns git's own two answers into two exit codes, which is what lets
  # "that ref does not exist" be a field and "I cannot read that repository" stay
  # a refusal. Measured on git 2.43: rc 1 for an absent ref in a readable repo,
  # rc 128 for a repo git cannot read at all (and without --quiet, 128 for both).
  # `tip` is recorded as JSON null when absent, never as "" or a substitute oid: a
  # renamed branch leaves the registry's name resolving to nothing, and ws-reap
  # refuses that as `branch-missing`. The tip stays the tip of the branch this
  # record NAMES — filing the renamed branch's tip under `branch` would be the
  # forgery this rung exists to prevent.
  tip=$(git -C "$main" rev-parse --verify --quiet "refs/heads/$branch" 2>/dev/null); rc=$?
  case "$rc" in
    0) : ;;
    1) tip="" ;;
    *) echo "manifest: could not ask $main for refs/heads/$branch" >&2; return 1 ;;
  esac
  # Measured against whatever is checked out, which is what `worktreeHead` above
  # makes legible: on a drifted worktree this counts that branch's uncommitted
  # work, and it is still the honest answer to "what is uncommitted here" — but
  # only once the read below is CHECKED, which is what the next paragraph is
  # about, and which the previous version of this comment claimed without.
  #
  # AND STDERR IS CAPTURED — final-round integration review, item 5 / new
  # finding 3. `git status --porcelain` over a PARTIALLY unreadable tree exits
  # ZERO with EMPTY stdout and the diagnostic on stderr alone. Measured on git
  # 2.43, `chmod 000` on a TRACKED directory holding a modified file:
  #     rc 0, stdout empty, stderr "tracked/deep/code.txt: Permission denied"
  #                                "warning: could not open directory 'tracked/'"
  # so `2>/dev/null` plus an exit-code test recorded `"dirty":0` for a tree with
  # uncommitted work in it. `_ws_reap_eval` (ccd:2205+) and `_ws_collect_ignored`
  # were hardened against exactly this and this read was not; two reads, one
  # rule, and this is the third site.
  #
  # THIS IS A REFUSAL, not a recorded field, and that is the ladder this
  # function's own header draws rather than an exception to it: "a question git
  # cannot answer at all … an unreadable tree or ignored set" is the REFUSED
  # arm, and a tree that cannot be walked is exactly that. The RECORDED arm is
  # for facts that are simply not the expected one — a drifted branch, a
  # detached HEAD — and a partial read is not a fact about the workspace, it is
  # the absence of one. The archive path deliberately records rather than
  # refuses (ccd:1800's comment says so), which is precisely why the honesty of
  # the numbers it does record is the only protection there is.
  local derrf derr drc
  derrf=$(mktemp) \
    || { echo "manifest: could not make a scratch file to read the tree at $workdir" >&2; return 1; }
  dirty=$(git -C "$workdir" status --porcelain 2>"$derrf"); drc=$?
  derr=$(cat "$derrf" 2>/dev/null); rm -f "$derrf"
  { (( drc == 0 )) && [[ -z "$derr" ]]; } \
    || { echo "manifest: could not read the tree at $workdir${derr:+ ($derr)}" >&2; return 1; }
  dirty=$(printf '%s' "$dirty" | grep -c . || true)
  # Same rule again, one line down: `_ws_ignored_digest` used to check only
  # `PIPESTATUS[0]`, which is also 0 in the case above, so the recorded
  # `ignoredDigest` silently covered an incomplete set. The guard now lives
  # inside that function, where its own callers inherit it.
  ignored=$(_ws_ignored_digest "$workdir") \
    || { echo "manifest: could not read the ignored set at $workdir" >&2; return 1; }
  # $main answered rev-parse a moment ago — rc 0 or a clean "no such ref", both
  # of which are answers — so its stash list is readable; the count is the only
  # field whose repository has already been proven healthy.
  #
  # Scoped to the `branch` field, NOT to `worktreeHead`: it is the count of
  # entries BELONGING to that branch — those whose subject names it, plus those
  # taken from it on a detached HEAD, which name no branch at all and are
  # attributed by base commit (integration docket 6, see `_ws_stash_count`) —
  # and pairing it with any other name
  # would make the record two things at once. So on a drifted worktree this can
  # read 0 while `worktreeHead`'s branch holds stashes — which is safe in the one
  # direction that matters, because `ws-reap` refuses drift (`registry-branch-drift`,
  # `detached-head`, `branch-missing`) before it ever consults a stash count, and
  # recomputes the count itself when it does. `worktreeHead` beside it is what
  # tells a reader which question the number answered.
  stashes=$(_ws_stash_count "$main" "$branch")
  # Pre-merge fix round, finding 5: `null`, not `0` — the seventh instance of
  # the measurement-forgery class in this plan (deviation 10, "a number is a
  # measurement"). The whole-directory-gone case already refuses earlier (the
  # `[[ -d "$workdir" ]]` guard above `_ws_archive_manifest`, and the
  # `git -C "$workdir" status` read a few lines up, both before this point);
  # this is the narrower window — `du` failing on a workdir that DOES exist
  # and IS otherwise readable. `registry.ts`'s `manifestBytes` already treats
  # anything but a finite JSON number as unmeasured (Task 19), so writing the
  # honest value here is the whole fix: a fabricated 0 would have argued
  # against a cleanup that could free real disk.
  bytes=$(_ws_gc_bytes "$workdir"); [[ "$bytes" =~ ^[0-9]+$ ]] || bytes=null
  pr=$(_reg_get "$id" prnumber); [[ "$pr" =~ ^[0-9]+$ ]] || pr=null
  transcript=$(_transcript_path "$id") || transcript=""
  printf '{"id":%s,"branch":%s,"worktreeHead":%s,"base":%s,"tip":%s,"dirty":%s,"ignoredDigest":%s,"stashes":%s,"worktreeBytes":%s,"pr":%s,"transcript":%s}\n' \
    "$(_json_str "$id")" "$(_json_str "$branch")" "$(_json_str "$wthead")" "$(_json_str "$base")" \
    "$( [[ -n "$tip" ]] && _json_str "$tip" || echo null)" \
    "$dirty" "$(_json_str "$ignored")" "$stashes" "$bytes" "$pr" "$(_json_str "$transcript")"
}

cmd_ws_restore() {   # ccd ws-restore --session <id> — undo an archive entirely
  # No confirmation: it only creates. The one thing it must not do is leave the
  # session unsupervised — `ccd ensure` does NOT re-supervise (ccd:1427-1434), so
  # boot persistence would be silently lost.
  [[ $# -eq 2 && $1 == --session ]] || die "usage: ccd ws-restore --session <id>"
  local id=$2
  [[ $id =~ ^[A-Za-z0-9._-]+$ ]] || die "bad session id"
  [[ -f "$REG/$id.uuid" ]]       || die "no such session: $id"

  # SERIALISED WITH `ws-reap`, ON WS-REAP'S OWN LOCK — final-round destructive
  # review, finding F5. These two verbs are the only pair in the design that
  # write the same fact from opposite directions: `ws-reap` requires
  # `$REG/$id.archived` and this removes it. Unserialised, the two orders both
  # end badly, and BOTH were measured:
  #   - restore inside `_ws_reap_eval`'s Phase C (the <=12 s `gh pr list` plus
  #     the <=60 s `git fetch`) is a lost update seconds to a minute wide: the
  #     reap's token still matches, because it was computed in that same run and
  #     `archived` is not one of the fingerprint's fourteen inputs, so the tail
  #     destroys the workspace the human just brought back.
  #   - restore between the tail's (e) and its (i) is worse in the other
  #     direction: the reap has already unsupervised the session and killed the
  #     pane, this re-`_spawn`s it and re-`_ws_supervise`s it, and then (f)/(i)
  #     remove the worktree and purge the registry under a supervised unit and a
  #     live pane — a session with `Restart=always` pointed at a directory that
  #     no longer exists and no registry row to resurrect it from.
  # `_ws_reap_tail` also re-reads the marker (see there), which is what covers
  # the RESUME path — a breadcrumb outlives a restore by hours and no lock can
  # span that. The lock is what closes the concurrent shapes.
  #
  # THE SAME LOCK, not a second mechanism: two locks for one invariant is two
  # things to get out of step, and this one is already the kernel's — released
  # on every form of death including SIGKILL, never unlinked, its whole argument
  # written out at `cmd_ws_reap`. `-n`, so a restore declines rather than
  # blocking a route behind a reap that may be sixty seconds inside a fetch;
  # `in-progress` is the shape `ws-reap` itself answers for the mirror case.
  #
  # AFTER the `uuid` check and BEFORE the `archived` one. Before, so no lock
  # file is created for an id with no registry at all; after, so `archived` and
  # `workdir` — the two facts a concurrent reap can change — are read UNDER the
  # lock rather than in front of it.
  command -v flock >/dev/null 2>&1 \
    || die "flock (util-linux) is unavailable — refusing to restore unserialised against ws-reap"
  local lock="$REG/.reap-$id.lock" lfd
  exec {lfd}>>"$lock" || die "cannot open the reap lock at $lock"
  flock -n "$lfd" || {
    exec {lfd}>&-
    die "another ccd process is reaping $id and still holds the lock — refusing to restore mid-cleanup"
  }

  [[ -f "$REG/$id.archived" ]]   || die "not archived: $id"
  local workdir; workdir=$(_reg_get "$id" workdir)
  [[ -d "$workdir" ]] || die "worktree is gone: $workdir — see: ccd ws-attic --session $id"
  rm -f "$REG/$id.archived" "$REG/$id.archivedreason" "$REG/$id.archivemanifest"
  _spawn "$id" resume
  _reg_set "$id" started 1
  _ws_supervise "$id"
  # GIVEN BACK BEFORE THE VERB ANSWERS, for the reason `cmd_ws_reap` states at
  # its own close: `flock` treats two `open()`s of one path in one process as
  # two strangers, and ccd is SOURCED — by `ccd` itself and by its tests — so a
  # descriptor left open here would refuse the next `ws-reap` in the same shell
  # with `in-progress` for ever. The `die`s above need no close of their own:
  # `die` exits, and the kernel closes what exits.
  exec {lfd}>&-
  echo "restored $id — $workdir"
}

_attic_project() {   # id -> the project owning its attic refs
  # Registry first, tombstone second: after a reap the registry is gone, and
  # the attic is exactly what the user still needs to reach.
  local id="$1" p
  p=$(_reg_get "$id" project); [[ -n "$p" ]] && { printf '%s\n' "$p"; return 0; }
  p=$(sed -n 's/.*"project"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$REG/.reaped/$id.json" 2>/dev/null | head -1)
  [[ -n "$p" ]] && { printf '%s\n' "$p"; return 0; }
  return 1
}

cmd_ws_attic() {   # ccd ws-attic --session <id>   |   ccd ws-attic --drop <id>
  # --drop is terminal-only: only ['ws-attic','--session'] is whitelisted, so
  # the PWA cannot reach it. Attic refs are never garbage-collected on a timer.
  [[ $# -eq 2 ]] || die "usage: ccd ws-attic --session <id> | ccd ws-attic --drop <id>"
  local mode=$1 id=$2
  [[ $id =~ ^[A-Za-z0-9._-]+$ ]] || die "bad session id"
  local project; project=$(_attic_project "$id") || die "no such session: $id"
  local main="$PROJECTS_ROOT/$project"
  case "$mode" in
    --session)
      git -C "$main" for-each-ref --format='%(refname) %(objectname)' "refs/ccrc/attic/$id/" 2>/dev/null
      ;;
    --drop)
      local n=0 ref
      while IFS= read -r ref; do
        [[ -n "$ref" ]] || continue
        git -C "$main" update-ref -d "$ref" && n=$(( n + 1 ))
      done < <(git -C "$main" for-each-ref --format='%(refname)' "refs/ccrc/attic/$id/" 2>/dev/null)
      echo "dropped $n attic ref$( (( n == 1 )) || echo s ) for $id"
      ;;
    *) die "usage: ccd ws-attic --session <id> | ccd ws-attic --drop <id>" ;;
  esac
}

_pr_state_one() {   # id main repo rows -> one JSON line
  local id="$1" main="$2" repo="$3" rows="$4"
  local project branch base baseShort tip ahead workdir dirty tmpl
  project=$(_reg_get "$id" project); branch=$(_reg_get "$id" branch)
  base=$(_reg_get "$id" base);       workdir=$(_reg_get "$id" workdir)
  # CARRIES THE ID. A per-session failure and a whole-repo failure are
  # different events: the server backs a PROJECT off on the id-less shape,
  # which three sites emit — `_gh_repo_slug`, `_gh_pr_list`, and `_pr_py`
  # mode `state` for an unparseable rc-0 body — and each of those really is
  # one gh answer for the whole repo, so every session of it is equally
  # unreadable. An id-less object HERE, by contrast, would let one
  # registry-incomplete workspace mark its seven siblings `unknown` and
  # silence the whole project's lane. §6's "Partial sweep" row promises
  # per-session honesty; this is where that is kept.
  [[ -n "$branch" ]] || { printf '{"id":%s,"phase":"unknown","reason":"error"}\n' "$(_json_str "$id")"; return 0; }
  [[ -n "$base" ]] || base="origin/HEAD"
  baseShort="${base#origin/}"
  # `--quiet` turns git's own two answers into two exit codes, and the same
  # three-way case `_ws_archive_manifest` walks (ccd:990-995) is walked here for
  # the same reason. Measured on git 2.43: rc 1 for an absent ref in a readable
  # repository, rc 128 when the repository cannot be read at all — and WITHOUT
  # `--quiet`, 128 for both, which collapses "the branch was renamed" into "I
  # cannot see this repository". `tip=""` here means the FIRST of those and is
  # emitted as JSON null; the second is not a fact about a PR at all, so it is
  # this session's failure object and persists nothing.
  #
  # The `tip=""` arm is an EQUIVALENT mutant, disclosed rather than pinned: the
  # command substitution already assigned "" when rev-parse printed nothing, so
  # deleting the assignment changes no value. It is written out because the arm
  # is where a reader learns that rc 1 is a FIELD and not a failure, and an empty
  # arm is indistinguishable from an unhandled one.
  local rc
  tip=$(git -C "$main" rev-parse --verify --quiet "refs/heads/$branch" 2>/dev/null); rc=$?
  case "$rc" in
    0) : ;;
    1) tip="" ;;
    *) printf '{"id":%s,"phase":"unknown","reason":"error"}\n' "$(_json_str "$id")"; return 0 ;;
  esac
  # "" is UNMEASURED, not zero. `ahead=0` is the claim "this branch is level with
  # base", which is what `no-commits` is built from, and a ref that does not
  # resolve has not been measured against anything. _pr_py reads "" as null.
  ahead=""
  if [[ -n "$tip" ]] && git -C "$main" rev-parse --verify --quiet "$base" >/dev/null 2>&1; then
    # `--` after the revisions per Global Constraints, and it SURVIVES mutation
    # by construction: `$base` comes from the registry and always yields a
    # `..`-bearing operand, which git can only read as a range, so no fixture can
    # distinguish the two forms. Followed anyway — git's disambiguation is
    # positional, and the rule is cheaper than re-deciding it per call site.
    ahead=$(git -C "$main" rev-list --count "$base..refs/heads/$branch" -- 2>/dev/null)
    # The GUARD and its FALLBACK VALUE both survive mutation, and for the same
    # reason: both revisions were verified a line ago, so rev-list has no way to
    # fail here today and nothing can observe which value the guard would have
    # written. Kept because `int(ahead)` in _pr_py raises on a non-numeric string
    # and this session's whole line then disappears from the sweep's output; `""`
    # rather than `0` because an unwritten count is UNMEASURED, which is what the
    # rest of this function now says, and `0` would say "level with base".
    [[ "$ahead" =~ ^[0-9]+$ ]] || ahead=""
  fi
  # THE ONE READ IN THIS VERB THAT IS ABOUT A DIRECTORY. ccrc asks $main;
  # $workdir is otherwise only ever a path git is asked ABOUT — but "what is
  # uncommitted here" is a question about that directory's contents, so it is
  # `-C "$workdir"` and therefore has to be ENTITLED first: git's own record AND
  # the directory itself must both say $main, the pair `cmd_ws_rm` requires
  # before it touches anything and `_ws_archive_manifest` walks for the identical
  # read. Neither rung alone is enough — the record outlives the directory, so a
  # hand-deletion plus a stray `git init` still answers $branch while its tree
  # belongs to a stranger. Measured: without the common-dir rung the squatter's
  # two untracked files were counted and reported as this workspace's.
  #
  # UNENTITLED OR UNREADABLE IS `null`, NOT A REFUSAL AND NEVER 0. `dirty` is an
  # advisory — the PR state is entirely knowable when gh answered and the
  # worktree did not — and this verb answers for every workspace of a project
  # from one gh call, so refusing here would cost the siblings their state too.
  # `ws-archive` refuses on these same facts because it writes a record that
  # authorises deletions; this one only reports. What is NOT allowed is `0`: the
  # shipped one-liner piped into `grep -c` and threw git's status away, so a
  # deleted worktree answered `"dirty": 0` — an affirmative "nothing is
  # uncommitted here" about a directory that is not there. That is deviation 6's
  # silent-empty-stream defect, one task later in the same file. `registered` and
  # the status are read from `$?` on their own lines: `local x=$(cmd)` returns
  # local's status, not the command's.
  #
  # Two of the three rungs survive mutation and are kept rather than pinned,
  # because each is redundant only GIVEN the others and the rule names all three:
  #   - `registered != 0` — a path whose common dir equals `$main`'s is inside
  #     `$main`'s repository, and `git status` from anywhere in a worktree
  #     reports that worktree, so the count is the same with or without this
  #     rung today. It is the rung the plan's rule names FIRST, and it is the one
  #     that stops answering if `_ws_common_dir` is ever loosened.
  #   - `-z "$main_common"` — an unreadable `$main` makes both sides empty and
  #     therefore equal, which is the fail-OPEN this guard exists to stop; it is
  #     unreachable only because the tip read above already returned on rc 128.
  # The `wd_common != main_common` rung is the one that catches the squatter, and
  # it is pinned.
  local wthead registered wd_common main_common porcelain prc
  dirty=""
  wthead=$(_ws_wt_branch "$main" "$workdir"); registered=$?
  wd_common=$(_ws_common_dir "$workdir"); main_common=$(_ws_common_dir "$main")
  if (( registered != 0 )) || [[ -z "$main_common" || "$wd_common" != "$main_common" ]]; then
    echo "pr-state: $workdir is not a corroborated worktree of $main — dirty unknown for $id" >&2
  else
    # THE STDERR RUNG, final-round verification P2. `dirty` already has an
    # honest UNMEASURED value — `""`, which becomes JSON `null` — and this was
    # the branch that failed to use it: a partially unreadable tree exits ZERO
    # with the diagnostic on stderr (measured, git 2.43), so `grep -c .` counted
    # the empty stdout and the wire carried `"dirty":0`, an affirmative "nothing
    # is uncommitted here" about files nobody looked at. Same shape, same round,
    # same fix as `cmd_ws_rm` and `_ws_gc_dirty`; here it lands on `null` rather
    # than on a refusal, because this function REPORTS and those two DESTROY.
    local perrf perr
    perrf=$(mktemp) || perrf=""
    if [[ -z "$perrf" ]]; then
      echo "pr-state: could not make a scratch file to read $workdir — dirty unknown for $id" >&2
    else
      porcelain=$(git -C "$workdir" status --porcelain 2>"$perrf"); prc=$?
      perr=$(cat "$perrf" 2>/dev/null); rm -f "$perrf"
      if (( prc == 0 )) && [[ -z "$perr" ]]; then dirty=$(printf '%s' "$porcelain" | grep -c . || true)
      else echo "pr-state: could not read the tree at $workdir — dirty unknown for $id" >&2; fi
    fi
  fi
  tmpl=""
  [[ -f "$main/.github/pull_request_template.md" ]] && tmpl=$(cat "$main/.github/pull_request_template.md")
  printf '%s' "$rows" | _pr_py state "$id" "$project" "$main" "$repo" "$branch" "$base" \
    "$baseShort" "$tip" "$ahead" "$dirty" "$tmpl" "$REG"
}

cmd_pr_state() {   # ccd pr-state --session <id> | ccd pr-state --project <project>
  # ONE gh call per repo, whichever form. Read-only apart from the three
  # registry fields it persists so a ccrc restart degrades to honest stale.
  [[ $# -eq 2 ]] || die "usage: ccd pr-state --session <id> | ccd pr-state --project <project>"
  local mode=$1 arg=$2
  case "$mode" in
    --session) [[ $arg =~ ^[A-Za-z0-9._-]+$ ]] || die "bad session id" ;;
    --project) [[ $arg =~ ^[A-Za-z0-9._-]+$ ]] || die "bad project" ;;
    *)         die "usage: ccd pr-state --session <id> | ccd pr-state --project <project>" ;;
  esac

  local -a ids=()
  if [[ $mode == --session ]]; then
    [[ -f "$REG/$arg.uuid" ]] || die "no such session: $arg"
    [[ -n "$(_reg_get "$arg" workspace)" ]] || die "not a workspace: $arg"
    ids=("$arg")
  else
    local f id
    for f in "$REG"/*.workspace; do
      # An empty registry leaves the glob unexpanded. Survives mutation because
      # the `.uuid` test below then looks for a file literally named `*.uuid`
      # and fails too — an accident of two guards, not one guard doing two jobs.
      [[ -e "$f" ]] || continue
      id=$(basename "$f" .workspace)
      # The same regex `--session` applies to its argv, applied to what the
      # directory listing handed back — every `$REG/$id.*` path below is built
      # from it. The plan's rule is "before any path is built from an id", with
      # no exception for ids ccd wrote itself; a filename cannot hold a `/` so
      # nothing traversable is reachable and every read here is read-only, which
      # makes this the rule rather than a hole being closed.
      [[ "$id" =~ ^[A-Za-z0-9._-]+$ ]] || continue
      [[ -f "$REG/$id.uuid" ]] || continue
      [[ "$(_reg_get "$id" project)" == "$arg" ]] || continue
      ids+=("$id")
    done
  fi
  (( ${#ids[@]} )) || return 0

  local project main repo rows
  project=$(_reg_get "${ids[0]}" project)
  # A registry VALUE, and `$main` is built from it. `--session` validated the id
  # it was handed and nothing validated this. `die`, not an answer object,
  # because a project name ccd cannot build a path from is a registry-IDENTITY
  # error — the class this verb already dies on (`no such session`, `not a
  # workspace`) — and it costs the repo's one gh call per sweep to proceed.
  [[ "$project" =~ ^[A-Za-z0-9._-]+$ ]] || die "bad project in registry for ${ids[0]}"
  main="$PROJECTS_ROOT/$project"
  repo=$(_gh_repo_slug "$main") || { printf '{"phase":"unknown","reason":"no-remote"}\n'; return 0; }
  # The answer object _gh_pr_list printed IS the output on failure: one repo
  # failing marks that repo's sessions unknown and touches no other project.
  rows=$(_gh_pr_list "$repo") || { printf '%s\n' "$rows"; return 0; }

  local id
  for id in "${ids[@]}"; do _pr_state_one "$id" "$main" "$repo" "$rows"; done
}

cmd_pr_open() {   # ccd pr-open --session <id> --title <t> --body-b64 <b64> --draft <true|false>
  # The ONE additive write in this whole design. Fixed arity, no getopt loop,
  # no "$@" passthrough (pflag is last-wins, so a passthrough would let a
  # caller override -R/--head/--base), and no flag anywhere takes a path.
  [[ $# -eq 8 && $1 == --session && $3 == --title && $5 == --body-b64 && $7 == --draft ]] \
    || die "usage: ccd pr-open --session <id> --title <title> --body-b64 <base64> --draft <true|false>"
  local id=$2 title=$4 b64=$6 draft=$8
  [[ $id =~ ^[A-Za-z0-9._-]+$ ]]     || die "bad session id"
  [[ -n $title ]]                    || die "empty title"
  (( ${#title} <= 256 ))             || die "title too long"
  [[ $title != *[[:cntrl:]]* ]]      || die "title has control characters"
  [[ $draft == true || $draft == false ]] || die "bad --draft"

  local body bytes
  body=$(printf '%s' "$b64" | base64 -d 2>/dev/null) || die "bad --body-b64"
  [[ -n $body ]] || die "empty body"   # an empty --body SUPPRESSES the repo template
  bytes=$(printf '%s' "$body" | wc -c)
  (( bytes <= 65536 )) || die "body too large"
  printf '%s' "$body" | iconv -f UTF-8 -t UTF-8 >/dev/null 2>&1 || die "body is not valid UTF-8"

  [[ -f "$REG/$id.uuid" ]] || die "no such session: $id"
  # Workspace-only, ALWAYS. Without this the verb would push --set-upstream
  # origin main on its first step for nine of nine live sessions.
  [[ -n "$(_reg_get "$id" workspace)" ]] \
    || die "not a workspace — refusing to open a PR from a main checkout"

  local project workdir branch base baseShort main repo
  project=$(_reg_get "$id" project); workdir=$(_reg_get "$id" workdir)
  branch=$(_reg_get "$id" branch);   base=$(_reg_get "$id" base)
  [[ -n "$project" && -n "$workdir" && -n "$branch" && -n "$base" ]] \
    || die "incomplete registry for '$id'"
  baseShort="${base#origin/}"
  [[ "$branch" != "$baseShort" ]] || die "head equals base"
  main="$PROJECTS_ROOT/$project"

  # The registry NAMES the branch; git's own worktree record is what entitles us
  # to push it. Read from $main and nowhere else (`_ws_wt_branch`, ccd:303-314),
  # the same three rungs cmd_ws_rm walks (ccd:380, :390, :402) and
  # _ws_reap_eval re-proves, in refusal form. TWO statements, deliberately:
  # `local wthead=$(...)` returns LOCAL's status, so `registered` would be 0 for
  # every path and rung 3 would be dead code.
  local wthead registered
  wthead=$(_ws_wt_branch "$main" "$workdir"); registered=$?
  (( registered == 0 )) \
    || die "$main has no worktree record for $workdir — refusing to push a branch nothing corroborates"
  [[ -n "$wthead" ]] \
    || die "$main records $workdir on a detached HEAD — there is no branch to open a PR from"
  [[ "$wthead" == "$branch" ]] \
    || die "the registry says $branch, git's worktree record for $workdir says $wthead — refusing to push either"

  # This is why the verb lives in ccd at all: the agent's exec op passes no
  # cwd, its cwd is $HOME which is not a repo, and the server cannot read
  # ~/worktrees/* (checkPath, whitelist.ts:83-90).
  repo=$(_gh_repo_slug "$main") || die "no origin remote for $project"

  # Idempotence, before anything is pushed or created, and it FAILS CLOSED.
  # `_gh_pr_list` (ccd:218) is the read Task 3 already hardened: it captures
  # gh's exit status and classifies its stderr. What stood here open-coded the
  # same call with `2>/dev/null` and captured STDOUT ALONE — and rc 124, an
  # expired token, a rate limit and an offline box all produce empty stdout,
  # which is indistinguishable from "no PR". Measured, with gh exiting 124 on
  # the probe: rc 0, the branch on the origin, one `pr create` issued. A bounded
  # write may not proceed on an unproven "no PR exists"; the concrete loss is a
  # DUPLICATE PR whenever the existing one is cross-repository, because our own
  # create then succeeds.
  #
  # `--head` matches across fork owners, so a stranger's PR on the same branch
  # name reads as "exists" and we decline to create — the fail-SAFE direction.
  # What the UI believes is decided by pr-state's binding, not by this line.
  local existing opened rc reason
  existing=$(_gh_pr_list "$repo" "$branch"); rc=$?
  if (( rc != 0 )); then
    # `_gh_pr_list` prints its answer OBJECT on failure; the classified reason
    # is the part of it this verb has to say out loud. "gh failed" would send
    # the reader to check `gh auth` for a box that is merely offline.
    reason="${existing##*\"reason\":\"}"; reason="${reason%%\"*}"
    die "could not check for an existing PR on $branch ($reason) — nothing was pushed"
  fi
  _gh_rows_ok "$existing" \
    || die "gh answered something that is not a list of PRs — nothing was pushed"
  if [[ "$existing" != "[]" ]]; then printf '%s\n' "$existing"; return 0; fi

  # Run in $main, NEVER in $workdir — the one network write in this design, so
  # the repository it is asked of matters more here than anywhere else. $main
  # owns refs/heads/$branch (a linked worktree's commits are in the shared object
  # store, so this sends exactly the workspace's work — verified) and $main is
  # the repository whose remote.origin.url produced $repo above, so the slug in
  # `gh pr create` and the ref on the wire name ONE repository. Resolved in
  # $workdir they name two: a stranger repo at that path answers
  # refs/heads/$branch with ITS commit, and measured on git 2.43 with an `origin`
  # pointing at ours it lands on OUR ref, after which the create call opens a PR
  # over a stranger's work. Nothing above reads $workdir either — it is a KEY
  # into git's records here, not a repository this verb talks to.
  # Fully qualified both sides, NEVER --force, branch from the registry and
  # corroborated by git, never from the request. The SOURCE half is what a test
  # can tell apart: with a same-named tag in $main — release tooling makes them
  # from branch names — a bare `ws/x` is "src refspec matches more than one" and
  # the one bounded write fails outright. The destination half is EQUIVALENT and
  # stays anyway: measured with `refs/tags/ws/x` present on both sides, a
  # qualified src alone lands on `refs/heads/ws/x` exactly as the pair does, so
  # no fixture can distinguish them — it is written out because the ref this
  # sends to is the one thing a reader of this line most needs stated.
  # Failure aborts before any gh call.
  # --set-upstream writes branch.<b>.remote/merge into the COMMON config,
  # so the workspace sees the upstream ws-reap later requires (verified: byte-
  # identical keys and values to the same push run inside the worktree).
  # STDOUT is dropped because this verb's stdout is its ANSWER: `--set-upstream`
  # prints "branch 'x' set up to track 'origin/x'." there, so the create path
  # used to answer that sentence followed by the rows, which is not JSON. The
  # ref update summary and every failure go to stderr, where the route wants
  # them.
  git -C "$main" push --set-upstream origin "refs/heads/$branch:refs/heads/$branch" >/dev/null \
    || die "push failed for $branch — nothing was opened"

  # `--head "$branch"` and `--head "$wthead"` are EQUIVALENT here and no fixture
  # can tell them apart: the drift rung above dies unless the two strings are
  # equal, so by this line they are the same string. `$branch` is written
  # because the registry's name is what this verb is FOR — `$wthead` would read
  # as "whatever git last saw", which is the reading the corroboration exists to
  # rule out. `>/dev/null` on the call is not equivalent: real `gh pr create`
  # prints the new PR's URL on stdout, and this verb's stdout is its answer.
  local -a args=(pr create --repo "$repo" --head "$branch" --base "$baseShort"
                 --title "$title" --body "$body")
  [[ "$draft" == true ]] && args+=(--draft)
  # The push is NOT rolled back if this fails: the ref on the origin is the
  # workspace's own work, lossless and what a retry needs to find there, and an
  # automatic `push --delete` would be a destructive rollback of a state nobody
  # lost anything to. So the refusal NAMES what it left behind, the way the
  # push's own refusal says "nothing was opened" about a state where truly
  # nothing was — the route surfaces exactly this stderr in its 502.
  timeout "$PR_GH_TIMEOUT" gh "${args[@]}" >/dev/null \
    || die "gh pr create failed — $branch is on origin with its upstream set, but no PR was opened"

  # The answer, read back through the SAME reader as the probe: same fields,
  # same 100-PR window, same classification. Two hand-written `--json` lists
  # made two success shapes out of one contract — `isDraft` was present on the
  # created answer and absent on the idempotent one — and a caller could tell
  # which path it had taken from a field that is supposed to describe the PR.
  # A failure here is NOT a failed open: the PR exists, and saying so is the
  # difference between "retry" and "look before you retry".
  opened=$(_gh_pr_list "$repo" "$branch"); rc=$?
  if (( rc != 0 )); then
    reason="${opened##*\"reason\":\"}"; reason="${reason%%\"*}"
    die "the PR was opened, but reading it back failed ($reason)"
  fi
  _gh_rows_ok "$opened" \
    || die "the PR was opened, but gh answered something that is not a list of PRs"
  printf '%s\n' "$opened"
}

# ── reap guards ────────────────────────────────────────────────────
# Evaluated by ws-audit to PRODUCE a verdict, and again by ws-reap to RE-PROVE
# it at the instant of deletion. One implementation, two evaluations at two
# times: the audit's verdict is never trusted, it is recomputed.

# THE secret-shaped name list, and now it has TWO consumers, so it is a list
# rather than a `case` — `_ws_sensitive_match` walks it for one name, and
# `_WS_SENSITIVE_FIND` is the same list as a `find` predicate for the scan
# INSIDE a collapsed ignored directory. Two hand-maintained copies of a §7
# guard's definition is exactly the drift this design cannot afford, so the
# predicate is DERIVED here, once, at source time.
#
# Small, non-rotting and permanent. `.ccrc/` deliberately does NOT match: it is
# listed and destroyed like any other ignored directory, because ccd itself put
# it in info/exclude and exempting it would be a blind spot ccd manufactured.
#
# `.env*` AND `*.env`, because dotenv has two spellings and only the first was
# here for a round: `production.env`, `prod.env` and `My Project.env` all read
# as ordinary rubbish queued for deletion in the one guard §7 forbids
# overriding, while four places claimed the case was closed by the `-z` read. It
# was not; `-z` fixed the QUOTING of `deploy key.pem` and `prod db.sqlite`,
# whose suffixes were already listed, and `My Project.env` had no arm to match
# quoted or unquoted. `env.sample` and `environment` are the negatives that keep
# this a suffix and not a substring.
_WS_SENSITIVE_GLOBS=( '.env*' '*.env' '*.pem' '*.key' '*.p12' 'id_[dre]*' '*.kdbx'
                      'credentials*' '*.sqlite*' '*.db' '*.dump' '*.sql' 'secrets*' )
_WS_SENSITIVE_FIND=()
for _wsg in "${_WS_SENSITIVE_GLOBS[@]}"; do
  (( ${#_WS_SENSITIVE_FIND[@]} )) && _WS_SENSITIVE_FIND+=( -o )
  _WS_SENSITIVE_FIND+=( -name "$_wsg" )
done
unset _wsg

_ws_sensitive_match() {   # path -> 0 when it is secret-shaped
  # `[[ $b == $g ]]` with the pattern UNQUOTED is glob matching, i.e. the same
  # operation each `case` arm used to be — including `id_[dre]*`'s bracket
  # expression. `pins the two matchers to one list` walks a table of positives
  # and negatives through this function AND through the find predicate and
  # requires the same answer from both.
  local b="${1%/}" g; b="${b##*/}"
  for g in "${_WS_SENSITIVE_GLOBS[@]}"; do
    [[ "$b" == $g ]] && return 0
  done
  return 1
}

# F3 REFINEMENT (pre-merge fix round; the human partner ruled directly:
# apply it). The inside-of-ignored scan enumerates every entry under a
# collapsed directory, and three of the globs above — `credentials*`,
# `secrets*`, `*.pem` — reach one directory into a dependency or build tree
# and catch its ORDINARY contents there: a TypeScript declaration file, a
# generated JS bundle and its sourcemap, a template. Measured over 15 real
# projects: 338 inside-hits, 7 of 15 projects refused on the FIRST tap, and
# essentially all of it was exactly this shape — `credentials.d.ts`,
# `cacert.pem`, 33 x `.env.example`, `secretsmanager.generated.js`,
# `secrets-manager.js.map`. A secret-shaped name that ALSO ends in a source,
# compiled or template extension is NOISE, not a secret. Measured effect:
# 32 hits, 4 of 15 projects — and the survivors still include the real
# `.env`, `.env.local`,
# `infrastructure/dist/config/{production,staging,dev}.env` and
# `dev-data/app.db`, exactly the content this guard exists for.
#
# EXCLUDED IS NOT INVISIBLE — the other half of the ruling. Every name this
# drops is still COUNTED (`REAP_SENSITIVE_FILTERED`, `sensitiveFiltered` on
# the wire), so a wrong filter is something anyone can notice from the
# audit's own output rather than a silent hole. This is a §7 no-override
# guard, so the list is narrow and enumerated rather than inferred from a
# pattern: on any doubt a name stays sensitive.
_WS_SENSITIVE_NOISE_EXT=( ts tsx js jsx mjs cjs map py pyc pyi go rs java rb php cs c h cpp swift kt
                          example sample template dist )

_ws_sensitive_noise() {   # path -> 0 when a secret-shaped name is vendored/template NOISE
  local b="${1%/}" ext; b="${b##*/}"
  for ext in "${_WS_SENSITIVE_NOISE_EXT[@]}"; do
    [[ "$b" == *".$ext" ]] && return 0
  done
  return 1
}

# ── D1: the nested-checkout guard ──────────────────────────────────────────
# A registered child, a plain `git init`, a clone, a linked-worktree pointer
# file: every one of them is a `.git` entry at depth ≥ 2. `git worktree list`
# structurally cannot see the independent ones (measured), so this is a
# FILESYSTEM walk. rc 0 = the walk completed (stdout may be empty); rc 1 = it
# did not, with the reason in _WS_NESTED_WHY — same polarity as every Phase B
# read: unreadable refuses, it never guesses.
_WS_NESTED_WHY=''
_ws_nested_checkouts() {   # dir -> resolved checkout roots, one per line
  local dir outf errf err rc f p
  _WS_NESTED_WHY=''
  # Resolve the OPERAND before it ever reaches `find`. `find`'s default `-P`
  # refuses to descend a symlink given as the exact top-level path (measured:
  # `find "$symlinkToDir" -mindepth 1` walks nothing at all — no error, rc 0,
  # empty stdout), so an unresolved symlink here would make the walk answer
  # "no nested checkouts" on a tree it never looked at. That is the one shape
  # of wrong this guard cannot afford: rc 0 with an empty answer reads as
  # certainty, and every caller proceeds straight to `git worktree remove` on
  # the strength of it. Resolving first also means every entry `find` walks,
  # and everything the loop below prints, already hangs off the real root.
  # `>/dev/null` on the cd, not merely `2>` — same reasoning as `_ws_realpath`
  # above: a `cd` exported as a shell function (BASH_FUNC_cd%%, the shape
  # zoxide/direnv/a .bashrc `cd` wrapper take) prints whatever it likes on
  # STDOUT, straight into this capture, and that is reachable from `cmd_ws_rm`
  # in a real shell. `2>/dev/null` alone left `$dir` carrying the hook's own
  # line ahead of `pwd -P`'s, which sent a corrupt path into `find` below and
  # refused a perfectly healthy workspace.
  dir=$(cd "$1" >/dev/null 2>&1 && pwd -P) \
    || { _WS_NESTED_WHY="could not resolve $1"; return 1; }
  outf=$(mktemp) || { _WS_NESTED_WHY='could not make a scratch file'; return 1; }
  errf=$(mktemp) || { rm -f "$outf"; _WS_NESTED_WHY='could not make a scratch file'; return 1; }
  timeout "$REAP_SCAN_SECONDS" find "$dir" -mindepth 2 -name .git -print0 >"$outf" 2>"$errf"; rc=$?
  err=$(cat "$errf" 2>/dev/null); rm -f "$errf"
  if (( rc == 124 )); then
    rm -f "$outf"
    _WS_NESTED_WHY="the nested-checkout walk did not finish within ${REAP_SCAN_SECONDS}s"
    return 1
  fi
  (( rc == 0 )) || { rm -f "$outf"; _WS_NESTED_WHY='could not walk the tree'; return 1; }
  [[ -z "$err" ]] || { rm -f "$outf"; _WS_NESTED_WHY="could not read all of the tree ($err)"; return 1; }
  while IFS= read -r -d '' f; do
    # `>/dev/null 2>&1`, not `2>/dev/null` alone — same reasoning as the operand
    # resolution above, and the same defect class: a `cd` exported as a shell
    # function prints whatever it likes on STDOUT, straight into this capture,
    # corrupting the entry this loop reports for a real nested checkout.
    p=$(cd "$(dirname "$f")" >/dev/null 2>&1 && pwd -P) || p="${f%/.git}"
    printf '%s\n' "$p"
  done <"$outf" | LC_ALL=C sort
  rm -f "$outf"
}

# Registered children = entries of `git worktree list --porcelain` whose
# RESOLVED path sits strictly inside the parent's resolved dir. Registration is
# FLAT at every depth (measured); nesting is a filesystem accident, so the tree
# is reconstructed here by path prefix — resolved on BOTH sides, or the fleet's
# symlinked roots make every containment test pass vacuously.
_ws_children() {   # main parentdir -> "resolvedpath\tbranch\theadoid" per child
  local main="$1" parent wt="" head="" br="" out=""
  parent=$(cd "$2" >/dev/null 2>&1 && pwd -P) || return 1
  local porc; porc=$(git -C "$main" worktree list --porcelain 2>/dev/null) || return 1
  while IFS= read -r line; do
    case "$line" in
      "worktree "*) wt="${line#worktree }" ;;
      "HEAD "*)     head="${line#HEAD }" ;;
      "branch "*)   br="${line#branch refs/heads/}" ;;
      "")
        if [[ -n "$wt" ]]; then
          local rp; rp=$(cd "$wt" >/dev/null 2>&1 && pwd -P) || rp="$wt"
          [[ "$rp" == "$parent"/* ]] && out+="$rp"$'\t'"$br"$'\t'"$head"$'\n'
        fi
        wt=""; head=""; br="" ;;
    esac
  done <<< "$porc"$'\n'
  printf '%s' "$out" | LC_ALL=C sort
}

# The plumbing probe D2's descent asks of every registered child before it asks
# `git status`: is this checkout mid-operation. Reimplemented from git's own
# on-disk facts rather than Conductor's script, so the answer is ours to reason
# about — a rebase, a merge, a cherry-pick or a revert each leave a marker file
# or directory under the child's OWN gitdir (`--git-path` resolves the linked
# worktree's private `rebase-merge`/`rebase-apply`/`MERGE_HEAD`/etc., not the
# common one `$main` shares with every other worktree), and a conflicted merge
# with no marker of its own still leaves unmerged stages in the index, which
# `ls-files -u` sees. `rc 1` on ANY git read here means "could not tell", not
# "idle" — the caller must refuse `tree-unreadable` rather than wave a child
# through it never actually looked at.
_ws_child_op() {   # childdir -> op name on stdout ('' = idle), rc 1 = unprobeable
  local d="$1" g p op=""
  for p in rebase-merge:rebase rebase-apply:rebase MERGE_HEAD:merge \
           CHERRY_PICK_HEAD:cherry-pick REVERT_HEAD:revert; do
    g=$(git -C "$d" rev-parse --git-path "${p%%:*}" 2>/dev/null) || return 1
    [[ -e "$d/$g" || -e "$g" ]] && { op="${p##*:}"; break; }
  done
  if [[ -z "$op" ]]; then
    local conf; conf=$(git -C "$d" ls-files -u 2>/dev/null | head -1) || return 1
    [[ -n "$conf" ]] && op="conflicted-merge"
  fi
  printf '%s' "$op"
}

# D4 — `cmd_ws_audit`'s OWN child enumeration, deliberately independent of
# `_ws_reap_eval`'s D2 descent above. That descent stops at the FIRST child
# that fails a rung and refuses right there — exactly right for a verdict,
# which needs only one reason. `children[]` is read by a human deciding
# whether to TRUST that refusal, so it cannot inherit the short-circuit: this
# function re-walks `_ws_nested_checkouts` and `_ws_children` itself and
# reports every child's own measured state, whether or not the eval's loop
# ever reached it — the sheet that shows WHY the eval will refuse, not merely
# THAT it did.
#
#   stdout: JSON array of {path,branch,headOid,dirty,busy,stray}
#   exit:   0 = the array is complete; 1 = NOTHING on stdout — the walk, the
#           `worktree list` read, or a per-child probe failed outright. The
#           caller falls back to `null`, never to a partial array: an
#           enumeration a human trusts is either whole or absent.
#
# A registered child that fails the ownership pair `_ws_reap_eval`'s D2 child
# descent proves (`_ws_common_dir` + `--show-toplevel`, copied verbatim from
# that same ownership rung rather than re-derived, so the two can never
# quietly diverge) is reported `"stray":true` rather than aborting the whole
# call: `$main`'s registration for that path is stale — a foreign clone
# dropped there, or the child's own `.git` deleted out from under it — so
# from the human reading this sheet it IS a stray, something at that path
# `$main` cannot vouch for. The one thing this producer must never do over
# ONE bad entry is go silent about every other one.
_ws_child_manifest() {   # main workdir -> JSON array on stdout; non-zero and NOTHING when it could not complete
  local main="$1" workdir="$2" mainreal
  mainreal=$(_ws_common_dir "$main") || return 1

  local nested children
  nested=$(_ws_nested_checkouts "$workdir") || return 1
  children=$(_ws_children "$main" "$workdir") || return 1

  # The identical in-bash set difference `_ws_reap_eval`'s D2 stray
  # computation uses, for the identical reason stated there: `comm` needs
  # both sides pre-sorted in the SAME collation it compares under, and its
  # own exit status is the only thing a caller can see — a `sort` or
  # `printf` failing inside either `<(...)` is invisible to it. An
  # associative array has no subprocess to fail and no locale to disagree
  # with.
  local -A childset=(); local cline cpath
  while IFS= read -r cline; do
    [[ -n "$cline" ]] || continue
    cpath="${cline%%$'\t'*}"
    childset["$cpath"]=1
  done <<< "$children"$'\n'
  local strays=""
  while IFS= read -r cline; do
    [[ -n "$cline" ]] || continue
    [[ -v childset["$cline"] ]] || strays+="$cline"$'\n'
  done <<< "$nested"$'\n'
  strays="${strays%$'\n'}"

  # Registered children first. `crest`/`cbr`/`chead` split the SAME way
  # `_ws_reap_eval`'s child loop splits them — parameter expansion, never
  # `IFS=$'\t' read` — because bash treats tab as IFS WHITESPACE even when it
  # is the only character in IFS — a detached child's empty branch column
  # (`path<TAB><TAB>headoid`) would collapse and shift `chead` into `cbr`.
  local out="[" first=1 crest cbr chead ccommon ctop cop errf err rc dirt cdirty entry
  while IFS= read -r cline; do
    [[ -n "$cline" ]] || continue
    cpath="${cline%%$'\t'*}"
    crest="${cline#*$'\t'}"
    cbr="${crest%%$'\t'*}"
    chead="${crest#*$'\t'}"
    ccommon=$(_ws_common_dir "$cpath") || ccommon=""
    ctop=$(git -C "$cpath" rev-parse --path-format=absolute --show-toplevel 2>/dev/null) || ctop=""
    if [[ -n "$ccommon" && "$ccommon" == "$mainreal" && -n "$ctop" && "$ctop" == "$cpath" ]]; then
      # `_ws_child_op` failing means "could not tell", never "idle" — the
      # same polarity `_ws_reap_eval`'s D2 rung reads it with — and a `git
      # status` that fails outright or writes a diagnostic on stderr
      # while exiting 0 is the identical partial-read shape Phase B's own
      # `dirty-tree` rung refuses on. Either one here means this ONE child's
      # state could not be measured, and that takes the WHOLE array down
      # with it rather than silently reporting the rest as though nothing
      # were missing.
      cop=$(_ws_child_op "$cpath") || return 1
      errf=$(mktemp) || return 1
      dirt=$(git -C "$cpath" status --porcelain 2>"$errf"); rc=$?
      err=$(cat "$errf" 2>/dev/null); rm -f "$errf"
      { (( rc == 0 )) && [[ -z "$err" ]]; } || return 1
      # Measured even when non-zero — unlike the eval's `child-dirty` rung,
      # THIS producer reports rather than refuses; a non-zero count is data,
      # not a reason to stop.
      cdirty=$(printf '%s' "$dirt" | grep -c . || true)
      entry="{\"path\":$(_json_str "$cpath"),\"branch\":$( [[ -n "$cbr" ]] && _json_str "$cbr" || echo null),\"headOid\":$( [[ -n "$chead" ]] && _json_str "$chead" || echo null),\"dirty\":$cdirty,\"busy\":$( [[ -n "$cop" ]] && _json_str "$cop" || echo null),\"stray\":false}"
    else
      entry="{\"path\":$(_json_str "$cpath"),\"branch\":null,\"headOid\":null,\"dirty\":null,\"busy\":null,\"stray\":true}"
    fi
    (( first )) || out+=","; first=0
    out+="$entry"
  done <<< "$children"$'\n'

  # Filesystem strays — unregistered checkouts `$main` has no record of at
  # all, the set difference computed above.
  while IFS= read -r cline; do
    [[ -n "$cline" ]] || continue
    entry="{\"path\":$(_json_str "$cline"),\"branch\":null,\"headOid\":null,\"dirty\":null,\"busy\":null,\"stray\":true}"
    (( first )) || out+=","; first=0
    out+="$entry"
  done <<< "$strays"$'\n'

  out+="]"
  printf '%s' "$out"
}

REAP_SCAN_SECONDS=30      # the whole-workspace bound on the inside-of-ignored scan

_ws_sensitive_inside() {   # absdir relpath deadline -> 0 with hits in _WS_INSIDE_HITS, 1 = the scan did not complete
  # THE §0 GUARD, ONE DIRECTORY DOWN. `--ignored=matching` collapses a wholly
  # ignored directory to a SINGLE entry, so `build/.env` holding a live key was
  # handed to `_ws_sensitive_match` as `build/`, matched nothing, and was
  # deleted under a sheet reading "not in git · 1 entry, 39 B — build/".
  # Measured end to end before this existed: verdict `reapable`, a token issued,
  # `sensitive: []`, and `build/.env` gone afterwards. Moving one secret one
  # directory deeper defeated the only guard §7 refuses to give an override.
  #
  # `find`, NOT `git ls-files --others --ignored --exclude-standard`, and the
  # difference is not a preference — measured on git 2.43 with a nested
  # repository inside an ignored `build/`:
  #     git ls-files …  ->  build/nested/          (one entry, and that is all)
  #     find …          ->  build/nested/.env      (the file)
  # git collapses a nested repository exactly the way `--ignored=matching`
  # collapses an ignored directory, so it reproduces this very blindness one
  # level deeper — over content `rm -rf` destroys all the same. The question
  # here is "what will be deleted", which is a filesystem question.
  #
  # ALL TYPES, not `-type f`: `_ws_sensitive_match` matches DIRECTORY names too
  # (git hands it `secrets/` as a top-level entry and the `%/` strip is there
  # for exactly that), so restricting the scan to regular files would answer a
  # different question inside than outside.
  #
  # BOUNDED, and the bound is a DEADLINE for the whole workspace rather than a
  # per-entry timeout, so a workspace with 226 ignored entries cannot cost 226
  # timeouts. Measured on this box against the tree `--ignored=matching` was
  # chosen for (custom-tools: 226 collapsed entries, 355,392 entries beneath
  # them): 3.4 s with one `find` per entry, 1.2 s as a single walk. The
  # performance reason for `--ignored=matching` still holds for the DISPLAY —
  # nothing here is printed, counted or sized, only matched — and sensitivity
  # cannot be sampled. Expiry is a read that did not complete, which is a
  # refusal, and the remedy travels in the message.
  #
  # ANY DIAGNOSTIC IS ALSO A READ THAT DID NOT COMPLETE, the same rule and the
  # same polarity as the `git status` beside it: a `chmod 000` subdirectory
  # makes find print `Permission denied` and carry on, and the entries it could
  # not reach are then simply absent — which is the state that says "no secrets
  # here" about files nobody enumerated.
  # `${1%/}` — git names a collapsed directory `build/`, with the trailing
  # slash, and a doubled separator makes `${f#"$abs"/}` match nothing, so every
  # hit came back as `build/` + the ABSOLUTE path. Measured.
  # TWO MUTATION SURVIVORS, disclosed and measured, and they are the same
  # reason: nothing can spend the budget in a fixture. `left=$(( deadline -
  # SECONDS ))` can be replaced by a constant, and `(( left > 0 ))` by `(( 1 ))`,
  # with the whole suite green (44 files / 712 tests, exit 0, each measured on
  # its own) — because reaching either needs a scan that really takes 30 s, and
  # the largest ignored tree on this box takes 3.4 s. What IS pinned is the
  # `rc == 124` arm (`refuses, with the remedy, when the scan runs out of its
  # budget`, which fails `timeout` for `find` alone), so the EXPIRY behaviour
  # has a fixture and only the clock that produces it does not. They stay
  # because a per-entry timeout is the thing they exist to prevent: without the
  # subtraction each entry gets a fresh 30 s and 226 entries cost 226 of them.
  local abs="${1%/}" rel="${2%/}" ent="$2" deadline="$3" outf errf err rc left f
  _WS_INSIDE_HITS=()
  left=$(( deadline - SECONDS ))
  (( left > 0 )) || {
    REAP_IGNREASON="the scan of the ignored directories did not finish within ${REAP_SCAN_SECONDS}s (stopped at $ent): remove or move the largest ignored directory and reap again"
    return 1
  }
  # TWO MORE MUTATION SURVIVORS, disclosed and measured, and they are the same
  # pair `_ws_collect_ignored` discloses for the same reason: an empty temp-file
  # name is itself a failing redirect, so `>""` never runs the scan and the
  # `(( rc == 0 ))` rung below refuses anyway. Both stay because each states the
  # case it is about, and because the fall-through only holds while that later
  # line keeps its `rm`. The four `rm -f "$outf"` here ARE pinned individually,
  # by `removes the inside-scan's scratch files too`, which walks all four exits
  # — with any one deleted a fixture for a DIFFERENT failure still cleans up.
  outf=$(mktemp) || return 1
  errf=$(mktemp) || { rm -f "$outf"; return 1; }
  timeout "$left" find "$abs" -mindepth 1 \( "${_WS_SENSITIVE_FIND[@]}" \) -print0 \
    >"$outf" 2>"$errf"; rc=$?
  err=$(cat "$errf" 2>/dev/null); rm -f "$errf"
  if (( rc == 124 )); then
    rm -f "$outf"
    REAP_IGNREASON="the scan of the ignored directories did not finish within ${REAP_SCAN_SECONDS}s (stopped at $ent): remove or move the largest ignored directory and reap again"
    return 1
  fi
  (( rc == 0 )) || { rm -f "$outf"; REAP_IGNREASON="could not walk the ignored directory $ent"; return 1; }
  [[ -z "$err" ]] || { rm -f "$outf"; REAP_IGNREASON="could not read all of the ignored directory $ent ($err)"; return 1; }
  # `${f#"$abs"/}` with the prefix QUOTED: an unquoted one is a GLOB, and an
  # ignored directory is free to be called `build[1]`.
  while IFS= read -r -d '' f; do
    [[ -n "$f" ]] || continue
    _WS_INSIDE_HITS+=( "$rel/${f#"$abs"/}" )
  done <"$outf"
  rm -f "$outf"
}

_ws_collect_ignored() {   # workdir — fills REAP_IGNORED (`sensitive\tbytes\tpath`) / REAP_SENSITIVE / REAP_IGNDIGEST
  # NON-ZERO when the ignored set could not be READ, and both of its reads are
  # checked. Neither failure can be allowed to look like "there is nothing
  # ignored here", because that is the answer that authorises the delete:
  #
  #   - The DIGEST half forges the token. A failure and an empty set hash
  #     identically (Task 2, deviation 6), so a discarded status puts "" into
  #     REAP_IGNDIGEST on the audit side AND on the reap side, the fingerprints
  #     match, and D2's consent check passes. Measured with only
  #     `status --ignored=matching` failing: both sides produce
  #     `igndigest='' … token=17af9144…`, an exact match, from a read that never
  #     happened. The digest is now built from the RECORDS this function
  #     produces rather than from a second `git status` (see the tail), so this
  #     read is the only one that can fail and its status is checked here.
  #   - The ENUMERATION half is worse, because it needs no token at all: an empty
  #     REAP_SENSITIVE means `sensitive-ignored` cannot fire, and the resume path
  #     (Task 6 Step 4) reads that array directly. Same measurement:
  #     `sensitive=()` for a worktree holding a gitignored `secrets/creds.env`.
  #
  # The read is therefore ONE `git status` whose status is checked, and the loop
  # filters `!! ` itself rather than piping through grep — a pipeline's exit code
  # would be grep's, and grep exits 1 on a legitimately empty ignored set. It is
  # also the ONLY `git status` here now: `_ws_ignored_digest` survives for the
  # ARCHIVE manifest, which records what it cannot describe rather than refusing.
  #
  # AND THE EXIT CODE IS NOT THE WHOLE ANSWER. A PARTIALLY unreadable tree makes
  # git warn and exit 0: measured on git 2.43, `chmod 000` on a subdirectory
  # gives rc 0, no line for anything inside it, and `warning: could not open
  # directory 'sub/'` on stderr — which `2>/dev/null` throws away. The entries
  # git could not reach are then simply absent, so a gitignored `secrets/` under
  # that directory leaves REAP_SENSITIVE empty and `sensitive-ignored`, a guard
  # §7 forbids overriding, cannot fire over files nobody ever enumerated. So
  # stderr is captured and ANY diagnostic is a read that did not complete.
  # Deliberately not a match on git's wording: git translates its warnings and
  # ccd pins no locale, so a text test would pass silently on a box with LANG
  # set — the failure mode this exists to remove.
  #
  # AND THE READ IS `-z`, WHICH IS A CORRECTNESS REQUIREMENT, NOT A STYLE.
  # Without it git C-QUOTES any path holding a space, a non-ASCII byte, a quote,
  # a backslash or a control character: measured on git 2.43, `!! .env` bare
  # beside `!! "deploy key.pem"` and `!! "s\303\251crets/"`. `_ws_sensitive_match`
  # is then handed a string whose first and last characters are `"`, so every
  # SUFFIX pattern dies on the trailing quote and every PREFIX pattern on the
  # leading one — measured end to end, a gitignored private key named
  # `deploy key.pem` produced verdict=reapable, sensitive:false and a TOKEN,
  # against the one guard §7 says has no override (`prod db.sqlite`,
  # `ssh key.pem`, same shape). This comment used to name `My Project.env` in
  # that list and was WRONG to: its suffix had no arm in `_ws_sensitive_match`
  # at all, so it was un-matched quoted and un-matched unquoted, and no amount of
  # `-z` was going to close it. That one is closed where it lives, by the `*.env`
  # arm. The quoted string is also what the size
  # read was given, and it names nothing on disk, so `ignoredBytes`
  # under-reported precisely the entries that matter — and the human, whose
  # reading of a filename this whole design rests on, was shown
  # `"s\303\251crets/"`.
  #
  # MUTATION SURVIVOR, disclosed: `-c core.quotePath=false` is a stated NO-OP
  # here and cannot be pinned. Measured on git 2.43 in both directions: with
  # `-z` the output is verbatim whether that config is false, true or unset, and
  # WITHOUT `-z` the config unquotes the non-ASCII byte and still quotes the
  # space — so it fixes nothing on its own and changes nothing beside `-z`. It
  # is passed so the line says what it is for; `-z` is what does the work, and
  # `reads the path git C-QUOTES` is what kills its removal.
  #
  # `-z` needs a FILE rather than `$(…)`: command substitution drops NUL bytes,
  # so the separator would vanish and every entry run together.
  #
  # What `-z` gives it also takes back, and the record shape is the answer: git
  # is no longer escaping a TAB or a NEWLINE inside a path either, so
  # `path\tbytes\tsensitive` read left to right shifts its fields on
  # `a<TAB>b.log` and `cmd_ws_audit` prints `"bytes":b.log`, which is not JSON.
  # Hence `sensitive\tbytes\tpath`: the two fixed-shape fields first — one of
  # `0|1`, one of `[0-9]+`, neither able to contain a tab — and the free-form
  # one last, so the path keeps whatever bytes it has.
  #
  # `du -sb` rather than `_ws_gc_bytes`, which answers `-` for anything that is
  # not a DIRECTORY (its own contract, and right for the workspace totals it was
  # written for): every ignored FILE was therefore recorded as 0 bytes, so a
  # 400 MB `dump.sql` was listed as free. `$wd` is absolute, so no `--` guard is
  # needed against a leading dash — but `head -n1` IS needed, because du echoes
  # the path back beside the size and a path with a newline in it makes that two
  # lines (measured: `cut -f1` alone returned `1\nd.log`, which fails the
  # numeric test and silently became 0).
  #
  # AND A `du` THAT DID NOT FINISH REFUSES THE WHOLE COLLECTION — round-3 item 3,
  # routed here by the ui-tsx verifier, and the TWELFTH instance of the
  # measurement-forgery class on this branch (after `_ws_gc_bytes`, c140dbd, and
  # this round's own `_ws_gc_dirty`). The rung used to be
  # `[[ "$b" =~ ^[0-9]+$ ]] || b=0`, which forged in BOTH of du's failure modes:
  #   - `du` stubbed to fail / the entry gone: `b` empty, recorded as 0;
  #   - `du -sb` on a PARTIALLY readable directory: measured, GNU coreutils 9.4,
  #     `chmod 000` on one subdirectory gives rc=1, stderr
  #     `du: cannot read directory '…/sub': Permission denied` and stdout
  #     `5000  top` for a tree that really holds 14000 bytes. The old test was
  #     `^[0-9]+$`, so the PARTIAL TOTAL passed as a measurement — worse than
  #     the 0, because 0 looks like a bug and 5000 looks like an answer.
  # Both land in `ignoredBytes`, which `ReapSheet.tsx` prints as a stated total
  # immediately above the Remove button.
  #
  # The fix is not a `null` in the record: `ignoredBytes` is `number` on the
  # wire (shared/api.ts:155) and `humanBytes(null)` renders `0 B`, so a null
  # would relocate the forgery into the PWA rather than close it. It is the
  # refusal this function already owns — the same `return 1` + `REAP_IGNREASON`
  # the git-status rungs and the inside-walk rungs use, which every caller
  # already handles: `_ws_reap_eval` refuses `tree-unreadable` (ccd:2580),
  # `_ws_reap_tail` refuses rather than finishing "on a guess" (ccd:3487), and
  # `_ws_gc_reclaimable` declines "refusing to remove a tree it cannot describe"
  # (ccd:4107). A size ccd could not take is a tree ccd cannot describe, and the
  # only thing this function's answer is used for is authorising a deletion.
  # `pipefail` is set at the top of this file, so the pipeline's status IS du's.
  #
  # THREE MORE MUTATION SURVIVORS, disclosed with the reason each is one, and
  # two of them are the same reason — an empty temp-file name is itself a
  # failing redirect, so the read never runs and the NEXT guard refuses:
  #   - `outf=$(mktemp) || return 1` — removable with the suite green: `>""` is
  #     an invalid redirect, git never runs, and `(( rc == 0 ))` refuses.
  #   - the `|| { rm -f "$outf"; return 1; }` on the `errf` line — removable for
  #     the same reason PLUS one more: `2>""` fails the read, so control reaches
  #     `(( rc == 0 )) || { rm -f "$outf"; …` one line later, which unlinks the
  #     same file. Measured, not assumed: a test was written for it and the
  #     mutant was re-swept and still SURVIVED. The OTHER THREE `rm -f "$outf"`
  #     — the exit-code one, the stderr one and the one after the loop — are
  #     each pinned individually by `removes its scratch file on EVERY path that
  #     refuses`, which walks all four exits, because with any single one
  #     deleted a fixture for a DIFFERENT failure still cleans up and one case
  #     pins nothing.
  #     Both stay for the reason `_gh_repo_slug`'s first two guards stay: each
  #     states the case it is about rather than relying on a later line, and the
  #     fall-through only holds while that later line keeps its `rm`.
  #   - `[[ -n "$p" ]] || continue` — git never emits a bare `!! `, so `p` cannot
  #     be empty after the prefix strip and no fixture can make it so. Kept
  #     because the loop's other two lines both dereference `$p` into a
  #     filesystem path, and an empty one would size `$wd/` — the whole
  #     workspace — as an "ignored entry".
  local wd="$1" entry p b sens deadline outf errf err rc ih drc
  REAP_IGNORED=(); REAP_SENSITIVE=(); REAP_IGNDIGEST=""; REAP_IGNREASON=""
  REAP_SENSITIVE_FILTERED=0
  # `REAP_IGNSCANNED` is the PROOF THIS RAN, cleared here and set on the single
  # success path at the end — final-round tests review F3. Every other variable
  # this function fills has a value that is indistinguishable from a real
  # measurement when the function never ran at all: an empty `REAP_IGNORED`
  # reads as "nothing ignored", a `REAP_SENSITIVE_FILTERED` of 0 reads as
  # "nothing filtered", and `cmd_ws_audit` printed both onto the
  # delete-confirmation sheet for workspaces refused in Phase A, i.e. never
  # scanned. A flag rather than `[[ -n "$REAP_IGNDIGEST" ]]`, which is true on
  # exactly the same condition today: the digest's job is the consent
  # fingerprint, and a second job it happens to satisfy is how these two drift.
  REAP_IGNSCANNED=0
  deadline=$(( SECONDS + REAP_SCAN_SECONDS ))
  outf=$(mktemp) || return 1
  errf=$(mktemp) || { rm -f "$outf"; return 1; }
  git -C "$wd" -c core.quotePath=false status --porcelain --ignored=matching -z \
    >"$outf" 2>"$errf"; rc=$?
  err=$(cat "$errf" 2>/dev/null); rm -f "$errf"
  (( rc == 0 )) || { rm -f "$outf"; return 1; }
  [[ -z "$err" ]] || { rm -f "$outf"; return 1; }
  while IFS= read -r -d '' entry; do
    case "$entry" in '!! '*) ;; *) continue ;; esac
    p="${entry#!! }"
    [[ -n "$p" ]] || continue
    b=$(du -sb "$wd/$p" 2>/dev/null | head -n1 | cut -f1); drc=$?
    { (( drc == 0 )) && [[ "$b" =~ ^[0-9]+$ ]]; } || {
      rm -f "$outf"
      REAP_IGNREASON="could not size the ignored entry $p"
      return 1
    }
    sens=0
    if _ws_sensitive_match "$p"; then
      # NOISE is counted, not silenced: `_ws_sensitive_noise` is the F3
      # refinement (see its own comment) and every name it drops still moves
      # `REAP_SENSITIVE_FILTERED`, so "excluded" never means "invisible".
      if _ws_sensitive_noise "$p"; then
        REAP_SENSITIVE_FILTERED=$(( REAP_SENSITIVE_FILTERED + 1 ))
      else
        sens=1; REAP_SENSITIVE+=("$p")
      fi
    fi
    # AND THE ENTRY IS OPENED WHEN IT IS A DIRECTORY. A hit anywhere inside
    # makes the ENTRY sensitive — the entry is what the sheet lists and what
    # `rm -rf` destroys — while REAP_SENSITIVE records the PATH THAT WAS FOUND,
    # because "move `build/.env` somewhere else" is a remedy and "build/ is
    # sensitive" is not. The sensitivity of the entry and the paths reported are
    # therefore two different facts and both are kept.
    if [[ -d "$wd/$p" ]]; then
      _ws_sensitive_inside "$wd/$p" "$p" "$deadline" || { rm -f "$outf"; return 1; }
      # Same per-hit noise filter as the top-level match just above, applied
      # to each path the inside-scan found individually — one collapsed
      # directory can hold both a generated `.js.map` (noise) and a real
      # `.env` (not), and the entry must read sensitive on the second alone.
      for ih in "${_WS_INSIDE_HITS[@]}"; do
        if _ws_sensitive_noise "$ih"; then
          REAP_SENSITIVE_FILTERED=$(( REAP_SENSITIVE_FILTERED + 1 ))
        else
          sens=1; REAP_SENSITIVE+=("$ih")
        fi
      done
    fi
    REAP_IGNORED+=("$sens"$'\t'"$b"$'\t'"$p")
  done <"$outf"
  rm -f "$outf"
  # THE DIGEST IS OVER THE RECORDS, not over the paths — which is a change of
  # WHAT the token promises, and it was made because the old promise was empty.
  # `_ws_ignored_digest` hashes `status --ignored=matching`'s lines, i.e. the
  # SET OF PATHS, so measured: growing an ignored `build/out.o` from 9 bytes to
  # 400,000 left the token IDENTICAL and the reap deleted 400,215 bytes where
  # the sheet said 9; adding a whole file inside an already-listed ignored
  # directory did the same; so did dropping a nested git repository with its own
  # commits into one (27,141 bytes, reaped silently). The records already carry
  # `sensitive\tbytes\tpath`, so hashing THEM makes the size and the
  # inside-the-directory sensitivity above both move the token, and the consent
  # check refuses `state-changed` for each.
  #
  # `sort -z`, because a digest is over a SET and git's enumeration order is not
  # promised; NUL-separated, because a path may hold a TAB or a NEWLINE and the
  # records are built to survive that. The empty case hashes the empty input
  # rather than one blank line, so "nothing ignored" and "one entry called
  # nothing" cannot collide.
  #
  # A FAILED HASH IS STILL NOT AN EMPTY ONE (deviation 6): the shape check is
  # what keeps `sha256sum` failing from putting "" into the field on BOTH sides,
  # where the fingerprints then match and D2's consent check passes over a
  # measurement nobody made.
  #   MUTATION SURVIVOR, disclosed: the `printf ''` that feeds an EMPTY set can
  #   be written `printf '\n'` with the suite green, and always will be. The
  #   comment above reasons about "nothing ignored" colliding with "one entry
  #   called nothing", but that second state is unconstructible — the collector's
  #   `[[ -n "$p" ]] || continue` refuses an empty path and every record carries
  #   `sensitive\tbytes\t` before it. Unpinnable by construction, like the
  #   sensitive-digest `sort` two blocks down. (Gate finding N3.) `_ws_ignored_digest` keeps its own copy of that
  # rung because the ARCHIVE manifest still calls it, and archive records what
  # reap refuses over.
  # MUTATION SURVIVOR, disclosed: the `sort -z` can be deleted with the whole
  # suite green, because git enumerates the ignored set in a stable order for a
  # given tree and both sides of the consent check call this same function, so
  # no fixture can make the two orders differ. It stays because a digest is over
  # a SET, and git's order is not promised — the day it changes for a reason
  # (a config, a version, a filesystem readdir order) the token would move under
  # a workspace nobody touched, which is `state-changed` for no reason at all.
  # The same argument the sensitive digest's `sort` carries at ccd's Phase D1.
  if (( ${#REAP_IGNORED[@]} )); then
    REAP_IGNDIGEST=$(printf '%s\0' "${REAP_IGNORED[@]}" | sort -z | sha256sum | cut -d' ' -f1)
  else
    REAP_IGNDIGEST=$(printf '' | sha256sum | cut -d' ' -f1)
  fi
  [[ "$REAP_IGNDIGEST" =~ ^[0-9a-f]{64}$ ]] || { REAP_IGNDIGEST=""; return 1; }
  # The ONLY assignment, on the ONLY path that returns 0. Everything above
  # returns 1 with the flag still 0, which is what makes "these figures are a
  # measurement" a fact this function states rather than one the caller infers.
  REAP_IGNSCANNED=1
}

_ws_merge_proof() {   # main M tip -> 0, with the passing rung in _WS_PROOF
  local main="$1" M="$2" tip="$3" Pm mb a b cout
  _WS_PROOF=""
  # ancestor — a true merge commit contains our tip.
  git -C "$main" merge-base --is-ancestor -- "$tip" "$M" 2>/dev/null && { _WS_PROOF=ancestor; return 0; }
  # tree — a squash whose base did not move. `--` AFTER the revisions is a
  # CORRECTNESS requirement: `diff --quiet -- A B` makes the shas pathspecs and
  # exits 0 for any pair (verified).
  git -C "$main" diff --quiet "$M" "$tip" -- 2>/dev/null && { _WS_PROOF=tree; return 0; }
  # patch-id — a squash whose base DID move, i.e. the majority case on a busy
  # repo. Whole-branch diff, NOT git cherry: cherry compares per-commit
  # patch-ids and reports + for every commit of a multi-commit squash.
  #
  # TWO MUTATION SURVIVORS, disclosed: `[[ -n "$Pm" ]]` and `[[ -n "$mb" ]]` are
  # each removable with the suite green, and they are removable because the
  # `-n "$a"` below is the backstop that IS pinned. `Pm` is empty only for a
  # merge commit with no parent (a root commit as `M`), and `mb` only for
  # histories with no common ancestor; in both cases the `git diff` that follows
  # gets an empty revision operand, fails, and leaves `a` empty — which
  # `never proves patch-id from two EMPTY patch-ids` refuses. They stay because
  # each names the case it is about, and because a diff against `""` is a git
  # invocation nobody should be relying on the shape of.
  Pm=$(git -C "$main" rev-parse --verify "${M}^1" 2>/dev/null) || Pm=""
  if [[ -n "$Pm" ]]; then
    mb=$(git -C "$main" merge-base -- "$tip" "$Pm" 2>/dev/null) || mb=""
    if [[ -n "$mb" ]]; then
      a=$(git -C "$main" diff --binary "$mb" "$tip" -- 2>/dev/null | git -C "$main" patch-id --stable | cut -d' ' -f1)
      b=$(git -C "$main" diff --binary "$Pm" "$M"   -- 2>/dev/null | git -C "$main" patch-id --stable | cut -d' ' -f1)
      [[ -n "$a" && "$a" == "$b" ]] && { _WS_PROOF=patch-id; return 0; }
    fi
  fi
  # cherry — the rebase-merge rung. Requires cherry to SUCCEED: swallowing its
  # exit code and testing an empty string would pass every broken invocation.
  if cout=$(git -C "$main" cherry "$M" "$tip" 2>/dev/null); then
    grep -q '^+' <<< "$cout" || { _WS_PROOF=cherry; return 0; }
  fi
  return 1
}

_ws_fingerprint() {   # id branch tip headOid mergeOid proof dirty igndigest sensdigest stashes wthead baseOid clipsDigest childrenDigest
  # FOURTEEN facts, and the thirteenth is the clips. `~/.cc-clips/<id>` is
  # `rm -rf`'d at (h) — 3.8 MB full-resolution screenshots per the spec — and
  # until this argument existed the fingerprint could not see it at all:
  # measured, pasting two clips between the sheet rendering and the tap left the
  # token IDENTICAL (`0e38d4d1…7ccd` before and after) and the reap deleted
  # them. A change to WHAT GETS DELETED that no human consented to in any form
  # is the one thing D2 exists to refuse, so the manifest is now both on the
  # wire (`cmd_ws_audit`'s `clips`) and in the token.
  #
  # The fourteenth is `childrenDigest` (D3): a registered child spawned after
  # the sheet rendered is a set the human never saw, and until the descent
  # loop's `REAP_CHILDLINES` was fingerprinted the token did not move when one
  # was added, even though the parent's own facts were all unchanged —
  # exactly the TOCTOU `_ws_reap_eval`'s reason for the clips digest describes,
  # one line up, for a different set.
  printf '%s\n' "id=$1" "branch=$2" "tip=$3" "headRefOid=$4" "mergeCommit=$5" "proof=$6" \
    "dirtyCount=$7" "ignoredDigest=$8" "sensitiveDigest=$9" "stashCount=${10}" \
    "worktreeHead=${11}" "baseOid=${12}" "clipsDigest=${13}" "childrenDigest=${14}" \
    | sha256sum | cut -d' ' -f1
}

_ws_reap_reset() {
  REAP_VERDICT=""; REAP_DETAIL=""; REAP_PROOF=""; REAP_TOKEN=""
  REAP_TIP=""; REAP_HEADOID=""; REAP_MERGE=""; REAP_BASEOID=""; REAP_WTHEAD=""
  # `REAP_STASHES` and `REAP_FETCHED` are "" and not 0 — final-round tests
  # review F3's class, swept over every default in this function that
  # `cmd_ws_audit` puts on the wire. A reset default that is a VALID-LOOKING
  # MEASUREMENT is the forgery: `stashes:0` renders "stashes: none" and
  # `fetchedAt:0` renders "merged … 20669 days ago", both about a workspace
  # whose stash list and whose PR were never read, because Phase A refused
  # first. The audit's printf turns a non-numeric value into JSON `null`, the
  # same shape `REAP_PRNUM` and `REAP_PROOF` have carried since deviation 10.
  # `REAP_DIRTY` stays 0: it is a guard input (`(( REAP_DIRTY == 0 ))`), never
