    local -A _ws_childset=(); local _wcline _wcpath
    while IFS= read -r _wcline; do
      [[ -n "$_wcline" ]] || continue
      _wcpath="${_wcline%%$'\t'*}"
      _ws_childset["$_wcpath"]=1
    done <<< "$children"$'\n'
    strays=""
    while IFS= read -r _wcline; do
      [[ -n "$_wcline" ]] || continue
      [[ -v _ws_childset["$_wcline"] ]] || strays+="$_wcline"$'\n'
    done <<< "$nested"$'\n'
    strays="${strays%$'\n'}"
    [[ -z "$strays" ]] \
      || { _reap_refuse nested-checkouts-present "$(printf '%s\n' "$strays" | grep -c .) unregistered checkout(s): ${strays//$'\n'/, }"; return 1; }
    # The per-child ladder itself, outermost-cheapest first and in the same
    # relative order Phase B above uses for the parent: an in-progress
    # operation (a rebase/merge/cherry-pick/revert marker, or a conflicted
    # merge with none — `_ws_child_op`, ccd:2104-2126) BEFORE the detached-HEAD
    # check, which in turn runs before a `git status`.
    #
    # That op-before-detached order is not cosmetic. Measured on git 2.43: a
    # worktree stopped mid-rebase on a conflict is ITSELF on a detached HEAD —
    # `git rebase` replays each commit with the worktree checked out at the
    # commit being replayed, and a conflict leaves it there, branch ref
    # unmoved. Checking `cbr` first would read every mid-rebase child as
    # merely `child-busy "detached HEAD at …"`, which is TRUE but not the
    # question this rung exists to answer, and the fixture that pins the
    # DETAIL text ("… refuses child-busy with the op in the detail") would
    # read "detached HEAD" instead of "rebase". Probing for the operation
    # first gives the more specific diagnosis; only a child that is detached
    # AND idle — no marker, no unmerged stage — falls through to the plain
    # detached-HEAD refusal below.
    #
    # After that: dirty; then unpushed, proved against the PARENT project's
    # `origin/HEAD` exactly as ccd proves the parent's own branch, because a
    # child's commits are only as safe as the remote the parent itself
    # trusts; then whether the child's branch is ALSO checked out somewhere
    # else, which is not this child's business to answer about itself and so
    # runs last.
    REAP_CHILDLINES=""
    local childline cpath cbr chead crest
    # `IFS= read -r childline` plus manual `%%`/`#` splitting, NOT
    # `IFS=$'\t' read -r cpath cbr chead`. Measured: tab is unconditionally
    # "IFS whitespace" in bash — true even when it is the ONLY character in
    # IFS — so consecutive delimiters collapse and leading/trailing ones are
    # stripped exactly as they are for the default space-separated case.
    # `_ws_children` prints a detached child as `path<TAB><TAB>headoid` (an
    # EMPTY branch field between two tabs), and `IFS=$'\t' read -r cpath cbr
    # chead` against that line silently shifts every field left — `cbr`
    # receives the head oid and `chead` comes back empty — so the very next
    # rung (`[[ -n "$cbr" ]]`) reads a detached child as a branch NAMED after
    # its own commit sha and never refuses `child-busy` at all. Parameter
    # expansion has no such whitespace carve-out: a run of consecutive tabs
    # produces the empty fields between them, which is what an empty branch
    # column actually means.
    while IFS= read -r childline; do
      [[ -n "$childline" ]] || continue
      cpath="${childline%%$'\t'*}"
      crest="${childline#*$'\t'}"
      cbr="${crest%%$'\t'*}"
      chead="${crest#*$'\t'}"
      # OWNERSHIP, reproven live — the FIRST rung inside this loop, before
      # anything else touches `$cpath`, exactly the position Phase B's own
      # foreign-worktree rung holds for `$workdir` (ccd:2661-2664). `_ws_children`
      # enumerated this path once, from a `worktree list` snapshot; a lot can
      # happen to the filesystem between that read and this line.
      #
      # TWO checks, AND-combined, because fix round 1 measured that neither
      # alone proves ownership. `_ws_common_dir "$cpath" == $mainreal` catches
      # a foreign clone dropped at a registered child's path — its own
      # unrelated `.git` resolves to a different common dir — but NOT the
      # sibling failure the same review measured: delete `$cpath/.git`
      # outright and git's upward discovery walks past the empty spot, finds
      # `$workdir`'s OWN `.git` two directories up (a child always lives
      # nested inside its parent's working tree), and answers with
      # $workdir's common dir — which IS $mainreal, because $workdir is
      # itself main's worktree. Measured on git 2.43: `_ws_common_dir`
      # cannot tell "$cpath is a healthy linked worktree" from "$cpath's own
      # `.git` is gone and every read of it is secretly reading $workdir
      # instead" — both answer $mainreal. `--show-toplevel` is what
      # distinguishes them: for an intact child it answers `$cpath` itself;
      # for the `.git`-less case it answers `$workdir`, because upward
      # discovery roots the repository at whichever ancestor's `.git` it
      # actually found. Neither probe alone proves ownership — a foreign
      # clone's own toplevel IS itself, and a `.git`-less child's common-dir
      # IS $mainreal — so both run.
      local ccommon; ccommon=$(_ws_common_dir "$cpath") || ccommon=""
      local ctop; ctop=$(git -C "$cpath" rev-parse --path-format=absolute --show-toplevel 2>/dev/null) || ctop=""
      [[ -n "$ccommon" && "$ccommon" == "$mainreal" && -n "$ctop" && "$ctop" == "$cpath" ]] \
        || { _reap_refuse nested-checkouts-present "the checkout at $cpath is not $main's worktree any more"; return 1; }
      local cop; cop=$(_ws_child_op "$cpath") \
        || { _reap_refuse tree-unreadable "could not probe $cpath for an in-progress operation"; return 1; }
      [[ -z "$cop" ]] || { _reap_refuse child-busy "$cop in progress at $cpath"; return 1; }
      [[ -n "$cbr" ]] || { _reap_refuse child-busy "detached HEAD at $cpath"; return 1; }
      errf=$(mktemp) || { _reap_refuse tree-unreadable "could not read the child at $cpath"; return 1; }
      dirt=$(git -C "$cpath" status --porcelain 2>"$errf"); rc=$?
      err=$(cat "$errf" 2>/dev/null); rm -f "$errf"
      { (( rc == 0 )) && [[ -z "$err" ]]; } \
        || { _reap_refuse tree-unreadable "could not read the child at $cpath"; return 1; }
      local cdirty; cdirty=$(printf '%s' "$dirt" | grep -c . || true)
      (( cdirty == 0 )) || { _reap_refuse child-dirty "$cdirty uncommitted file(s) in $cpath"; return 1; }
      local cbase; cbase=$(git -C "$main" symbolic-ref --quiet refs/remotes/origin/HEAD) \
        || { _reap_refuse child-unpushed "no origin/HEAD to prove $cpath against"; return 1; }
      local cahead; cahead=$(git -C "$cpath" rev-list --count "$cbase..HEAD" 2>/dev/null) \
        || { _reap_refuse child-unpushed "could not compare $cpath against $cbase"; return 1; }
      (( cahead == 0 )) || { _reap_refuse child-unpushed "$cahead commit(s) in $cpath unreachable from $cbase"; return 1; }
      local holders; holders=$(git -C "$main" worktree list --porcelain 2>/dev/null | grep -c "^branch refs/heads/$cbr\$" || true)
      (( holders == 1 )) || { _reap_refuse child-branch-elsewhere "branch $cbr is checked out in $holders worktrees"; return 1; }
      REAP_CHILDLINES+="$cpath"$'\t'"$cbr"$'\t'"$chead"$'\t'"$cdirty"$'\n'
    done <<< "$children"$'\n'
  fi

  # THE STASH READ THAT CANNOT FAIL SILENTLY — corroborated here rather than
  # widened in `_ws_stash_count`, whose `2>/dev/null … || true` is Task 2's
  # deliberate contract and which Task 4 consumes.
  #
  # Every failure of that helper is a 0, and a 0 is what authorises the delete.
  # Neither of the two techniques already in this file can see it: measured on
  # git 2.43, with `.git/logs/refs/stash` unreadable OR deleted while
  # `refs/stash` still resolves, `git stash list` returns rc 0, EMPTY stdout and
  # EMPTY stderr — so the exit code says fine and Phase B's stderr rule has
  # nothing to test. The failure is deterministic, so ws-reap recomputes the
  # same 0 and the `--expect` consent check matches. That is deviation 6's
  # digest forgery in the `stashCount` field: a deletion authorised over stashes
  # nobody counted.
  #
  # What CAN see it is the ref, and the invariant is ONE-WAY — not the
  # biconditional this comment used to claim. Measured across push/pop/drop/clear
  # on git 2.43, one half IS a law git keeps: at least one entry ⇒ `refs/stash`
  # resolves, because git creates the ref on the first push and deletes it when
  # the last entry goes. The CONVERSE is not, and the converse is what this guard
  # rests on: `git reflog expire --all --expire=now --expire-unreachable=now` — a
  # documented maintenance command that does not mention refs/stash — empties the
  # stash reflog and LEAVES THE REF, so it resolves (rc 0) beside a `git stash
  # list` that returns rc 0 and zero entries. Measured on git 2.43.
  # (`git gc --prune=now` does not reach it, nor does gc with
  # `gc.reflogExpire=now` — git protects refs/stash from gc by default, measured
  # too. The trigger is narrow. It is not impossible.)
  #
  # So the guard has a FALSE-POSITIVE STATE and it is DISCLOSED rather than
  # engineered away: from here the two are indistinguishable, and the only safe
  # reading of "I cannot tell" is to refuse. What that costs is said out loud —
  # a repository in that state answers `stash-unreadable` PERMANENTLY, for every
  # workspace in it, with no override, and since this runs before the `exists`
  # branch it blocks the `reap-interrupted` resume path too. Which is why the
  # REMEDY travels in the refusal detail rather than in this comment: the
  # operator the message reaches is the only one who can act, and neither
  # 'git stash clear' nor 'git update-ref -d refs/stash' is something they will
  # guess. Both measured against the reflog-expire fixture, in the test that
  # names it.
  #
  # What the guard must NOT do is read "refs/stash exists" as "this branch has
  # stashes". A stash on another branch is a legitimate, reapable state (also
  # measured: a stash pushed from $main's own checkout leaves this branch's
  # count at an honest 0), and refusing it would make every workspace in a repo
  # whose main holds one stash permanently un-reapable, with no override. So the
  # corroboration is on the WHOLE list and the branch-scoped count stays
  # `_ws_stash_count`'s.
  #
  # THAT SCOPING IS WHAT DOCKET 6 EXPLOITED, and the fix is in the count rather
  # than here: a stash taken from a DETACHED worktree says `(no branch)` and so
  # named nothing for the scoped grep to match, which is a 0 that authorised the
  # delete. `_ws_stash_count` now attributes those by base commit.
  #
  # AND THAT ARM DOES REACH FLEET-WIDE FOR ONE SHAPE OF INPUT — round-3
  # verification P3, reconciled in one place (see `_ws_stash_count`, "AND IT
  # DOES REINTRODUCE THE FLEET-WIDE COST") and cross-referenced here so this
  # paragraph is not read as covering it. The rule rejected above is attribution
  # by EXISTENCE, which fires on a NAMED stash the operator has a standing
  # reason to keep. The arm attributes by BASE COMMIT and fires only on an
  # ANONYMOUS entry; when that entry's base sits on shared history it is
  # reachable from every branch, so it does block every workspace of the project
  # until it is dealt with. That is accepted on the same test this file applies
  # to `stash-unreadable` — can the operator get out of it — which is why the
  # remedy is in the `stashes-present` detail below and not only in a comment.
  if git -C "$main" rev-parse --verify --quiet refs/stash >/dev/null 2>&1; then
    stashall=$(git -C "$main" stash list 2>/dev/null | grep -c .)
    (( stashall > 0 )) \
      || { _reap_refuse stash-unreadable "refs/stash resolves in $main but the stash list read back empty — either its reflog cannot be read, or maintenance ('git reflog expire --all') emptied it and left the ref: if this repository truly holds no stashes, 'git stash clear' (or 'git update-ref -d refs/stash') clears the stale ref"; return 1; }
  fi
  REAP_STASHES=$(_ws_stash_count "$main" "$branch")
  (( REAP_STASHES == 0 )) \
    || { _reap_refuse stashes-present "$REAP_STASHES stash entr$( (( REAP_STASHES == 1 )) && echo y || echo ies) belonging to $branch (a stash taken from it on a detached HEAD names no branch and is attributed by its base commit, so an anonymous entry based on shared history counts against every workspace of $project): 'git -C $main stash list' names them, and 'git stash branch <name> stash@{N}' keeps one, 'git -C $main stash drop stash@{N}' discards one"; return 1; }
  up=$(git -C "$main" rev-parse --verify --quiet "$branch@{upstream}" 2>/dev/null) \
    || { _reap_refuse no-upstream "$branch was never pushed"; return 1; }
  # The DIRECTION is unchanged and the SENTENCE is not — round-3 P2's class,
  # last instance, found by the final-round destructive review (F5b). A failed
  # `rev-list` yields "", which is `!= 0`, so this refuses, which is right; but
  # it then printed " commit(s) are not on the remote" — a count, with the
  # number missing, about a comparison that never ran. `_ws_gc_merged` and
  # `_ws_gc_dirty` both already say the rule for the file: report unprovable as
  # unprovable.
  ahead=$(git -C "$main" rev-list --count "$up..refs/heads/$branch" 2>/dev/null)
  [[ "$ahead" == 0 ]] \
    || { _reap_refuse unpushed-commits "$( [[ "$ahead" =~ ^[0-9]+$ ]] \
           && echo "$ahead commit(s) are not on the remote" \
           || echo "could not count the commits between $up and refs/heads/$branch — refusing on a comparison that did not run")"; return 1; }

  # ── Phase C: the work is genuinely in main ─────────────────────
  REAP_TIP=$(git -C "$main" rev-parse --verify "refs/heads/$branch" 2>/dev/null) \
    || { _reap_refuse branch-missing "refs/heads/$branch does not resolve"; return 1; }
  repo=$(_gh_repo_slug "$main") || { _reap_refuse no-remote "no origin remote for $project"; return 1; }
  rows=$(_gh_pr_list "$repo")   || { _reap_refuse gh-unreadable "$rows"; return 1; }
  row=$(printf '%s' "$rows" | _pr_py pick "$main" "$branch" "$baseShort" "$REAP_TIP")
  case "$row" in
    '')                   _reap_refuse no-bound-pr "no merged PR binds to $branch"; return 1 ;;
    '!pr-head-not-ours')  _reap_refuse pr-head-not-ours "the PR head commit is not reachable from $branch"; return 1 ;;
    '!'*)                 _reap_refuse "${row#!}" "the bound PR is not merged"; return 1 ;;
  esac
  IFS=$'\t' read -r REAP_PRNUM REAP_PRURL REAP_MERGE REAP_HEADOID <<< "$row"
  # §7's argv boundary, restated on THIS side of the split — because the split
  # is what can move a value out of the field that was anchored and into one
  # that was not. `_pr_py pick` checks `mergeCommit.oid` and `headRefOid`
  # against `OID` (ccd:292) inside python, but `url` and `number` are
  # GitHub-sourced and unanchored, and all four come back joined with tabs. So a
  # PR whose `url` holds a TAB shifts every later field: measured with
  # `url: "https://x/\tinjected"`, the string `injected` became REAP_MERGE and
  # reached `git cat-file -e "injected^{commit}"`, `git merge-base --is-ancestor
  # -- "$tip" "injected"` and `git diff --stat "injected" …`. It failed closed
  # there, but by luck rather than by construction, and one anchored test is
  # what turns the one into the other. Same regex as python's, deliberately:
  # a floor of 7 because a 3-character hex string like `abc` can be a real ref,
  # and both ends anchored because `headRefOid: "main"` otherwise resolves as a
  # REVISION and binds.
  #
  # ALL SIX PIECES ARE PINNED — the two anchors on each oid, the floor and the
  # ceiling — and the route that reaches them is a fixture that shadows
  # `_pr_py pick` and hands this line one crafted row at a time. That is not a
  # contrivance; it is the case the line is FOR. While the two ends are one
  # producer, python's `OID` screens both oids before they are joined and the
  # tab-shift above always leaves a literal TAB in the tail field, so the
  # character class alone answers everything and NOTHING beneath it is
  # observable. Measured, and the reason this comment is a correction: the
  # previous one claimed "the character class and the anchors are what is
  # pinned" and disclosed the floor as the sole survivor. Re-swept, EIGHT
  # mutants of this one line survived — dropping either conjunct, dropping
  # either `^`, dropping either `$`, `{1,40}`, and `{7,}`. With `^` gone,
  # `origin/deadbeef1` matches on its nine-hex tail and reaches
  # `git cat-file -e "origin/deadbeef1^{commit}"`, `merge-base --is-ancestor`
  # and `diff --stat`: the exact "resolves as a REVISION and binds" case the
  # two lines above say the anchors exist to stop. bash's `=~` searches unless
  # anchored, which is why each anchor needs its own fixture rather than
  # inheriting one from its neighbour.
  [[ "$REAP_MERGE" =~ ^[0-9a-f]{7,40}$ && "$REAP_HEADOID" =~ ^[0-9a-f]{7,40}$ ]] \
    || { _reap_refuse pr-fields-malformed "gh named mergeCommit='$REAP_MERGE' headRefOid='$REAP_HEADOID'"; return 1; }

  # Mergedness is NEVER proven against an unfetched ref. Six repos on this box
  # have never been fetched; one is 24 days stale.
  timeout 60 git -C "$main" fetch --quiet origin \
    || { _reap_refuse fetch-failed "could not fetch origin — nothing is claimed about your commits"; return 1; }
  REAP_FETCHED=$(date +%s)
  git -C "$main" cat-file -e "${REAP_MERGE}^{commit}" 2>/dev/null \
    || { _reap_refuse merge-commit-missing "$REAP_MERGE is not in the object store after a fetch"; return 1; }
  # A REFUSAL, not a default. This was the last fingerprint input that answered
  # a failed read with `""`: measured, with only this read failing the verdict
  # stayed `reapable` and a token was issued over a field nobody measured — and
  # because the failure is deterministic, ws-reap recomputes the same `""` and
  # the `--expect` consent check matches. Same class as the ignored digest
  # (deviation 6) and the stash count above. `$base` is the registry's, so this
  # fires for a workspace whose base ref was deleted or renamed under it, which
  # is a state to reconcile rather than one to delete over.
  REAP_BASEOID=$(git -C "$main" rev-parse --verify "$base" 2>/dev/null) \
    || { _reap_refuse base-missing "$base does not resolve in $main"; return 1; }
  if _ws_merge_proof "$main" "$REAP_MERGE" "$REAP_TIP"; then
    REAP_PROOF="$_WS_PROOF"
  else
    _reap_refuse tree-differs "$(git -C "$main" diff --stat "$REAP_MERGE" "$REAP_TIP" -- | head -5; git -C "$main" log --oneline "$REAP_MERGE".."$REAP_TIP" | head -5)"
    return 1
  fi

  # ── Phase D1: the session ──────────────────────────────────────
  st=$(_ws_status "$id") || { _reap_refuse status-unknown "cannot read the wrapper status file"; return 1; }
  [[ "$st" != busy ]] || { _reap_refuse session-busy "the session is working — a model turn, a Bash tool command, or a status this ccd does not recognise"; return 1; }

  # MUTATION SURVIVOR, disclosed and unpinnable BY CONSTRUCTION: the `sort` can
  # be deleted with the suite green, because every state that reaches this line
  # has an EMPTY sensitive set — a non-empty one refuses `sensitive-ignored`
  # above, with no override — so the digest is the constant sha256 of one blank
  # line. It stays because the field is a set digest and a set has no order,
  # and because the ordering `_ws_collect_ignored` produces is git's, which is
  # not promised. The only way to pin it would be a state this design forbids.
  REAP_SENSDIGEST=$(printf '%s\n' "${REAP_SENSITIVE[@]-}" | sort | sha256sum | cut -d' ' -f1)
  # The clips manifest is `_ws_clip_manifest`'s, the same producer the TOMBSTONE
  # records at (a), so the record of what was deleted and the consent to delete
  # it cannot describe different files. Hashed rather than carried, because the
  # fingerprint is a line-per-fact document and a manifest holds newlines.
  #
  # TWO STATEMENTS AND A REFUSAL — the sixteenth forgery (see
  # `_ws_clip_manifest`). This was one line, `… | sha256sum | cut`, which
  # reports the PIPE's status and therefore could not have noticed the
  # producer failing even if it had looked. An unenumerable clips directory
  # hashed as `[]`, deterministically, on both sides: the audit issued a token
  # over it and ws-reap recomputed the same digest, so `--expect` matched and
  # step (h) destroyed a directory nothing had listed. A digest is a claim that
  # the thing digested was read; when it was not, there is no fingerprint to
  # take and the answer is a refusal, exactly as `base-missing` and the ignored
  # digest (deviation 6) are refusals rather than empty strings.
  #
  # `printf '%s\n'`, not `printf '%s'`: `$(…)` strips the trailing newline
  # `_ws_clip_manifest`'s `echo` produced, and the digest of `[]` has to stay
  # the digest of `[]\n` — the value every existing token fixture computes as
  # `printf '[]\n' | sha256sum`. The refusal is the only thing that changes.
  clipsjson=$(_ws_clip_manifest "$id") \
    || { _reap_refuse clips-unreadable "could not list $HOME/.cc-clips/$id — the pasted images this cleanup would delete cannot be enumerated"; return 1; }
  REAP_CLIPDIGEST=$(printf '%s\n' "$clipsjson" | sha256sum | cut -d' ' -f1)
  # `printf '%s'`, not `printf '%s\n'`: unlike the clips manifest above,
  # `REAP_CHILDLINES` is not `$(…)`-captured (it is built in place by the
  # descent loop), so there is no subshell trailing-newline strip to
  # compensate for — an empty child set is the literal empty string, and its
  # digest is `sha256sum` of nothing, exactly what a fixture with no
  # registered children computes by hand.
  REAP_CHILDDIGEST=$(printf '%s' "$REAP_CHILDLINES" | sha256sum | cut -d' ' -f1)
  REAP_TOKEN=$(_ws_fingerprint "$id" "$branch" "$REAP_TIP" "$REAP_HEADOID" "$REAP_MERGE" "$REAP_PROOF" \
                 "$REAP_DIRTY" "$REAP_IGNDIGEST" "$REAP_SENSDIGEST" "$REAP_STASHES" "$REAP_WTHEAD" \
                 "$REAP_BASEOID" "$REAP_CLIPDIGEST" "$REAP_CHILDDIGEST")
  REAP_VERDICT=reapable
  return 0
}

cmd_ws_audit() {   # ccd ws-audit --session <id> — read-only; the token's source
  [[ $# -eq 2 && $1 == --session ]] || die "usage: ccd ws-audit --session <id>"
  local id=$2
  [[ $id =~ ^[A-Za-z0-9._-]+$ ]] || die "bad session id"

  # `_json_str`'s status, checked ONCE and up front — the same probe, for the
  # same reason, as `_ws_manifest` (ccd:1109). Nineteen `_json_str` substitutions
  # below sit inside printf ARGUMENT LISTS, where a failure is a swallowed status
  # and an empty argument, i.e. `"path":,` — a document that authorises deletions
  # and does not parse, at exit 0. Bytes can no longer fail the encode (see
  # `_json_str`), so what is left is python3 not being runnable at all, and the
  # only honest answer to that is to print NOTHING and exit non-zero. Before
  # `_ws_reap_eval`, so a refusal costs no gh call and no fetch.
  _json_str probe >/dev/null 2>&1 \
    || die "python3 unavailable — cannot quote the audit record safely"

  _ws_reap_eval "$id" || true      # a refusal is an ANSWER, not an error
  local project workdir branch base repo transcript reaping
  project=$(_reg_get "$id" project); workdir=$(_reg_get "$id" workdir)
  branch=$(_reg_get "$id" branch);   base=$(_reg_get "$id" base)
  repo=$(_gh_repo_slug "$PROJECTS_ROOT/$project" 2>/dev/null) || repo=""
  transcript=$(_transcript_path "$id") || transcript=""
  reaping=$(_reg_get "$id" reaping)

  # Sensitive-first, then bytes descending. Counts and total bytes are NEVER
  # truncated — the whole judgement this design rests on is the human reading
  # a filename, and a truncated list makes it structurally unavailable.
  #
  # NUL-terminated end to end, and the record is `sensitive\tbytes\tpath`
  # (`_ws_collect_ignored`): the read that fills it is `-z`, so a path may
  # legitimately contain a TAB or a NEWLINE. `printf '%s\n' | sort` splits such
  # a path across two records and an `IFS=$'\t' read -r p b s` on a
  # path-first record shifts every field — measured, `a<TAB>b.log` printed
  # `"bytes":b.log`, which is not JSON. So: `sort -z`, `read -d ''`, and the
  # two fixed-shape fields peeled off the FRONT with `${…%%}`/`${…#}` rather
  # than by word-splitting, which would collapse a run of tabs.
  #
  # AND THE WHOLE BLOCK IS SKIPPED WHEN NOTHING WAS SCANNED — final-round tests
  # review F3, the fourteenth instance of the measurement-forgery class and the
  # first one to reach the delete-confirmation surface itself. These four
  # fields used to be initialised to `[`/`0`/`0`/`[` and printed
  # UNCONDITIONALLY, on every verdict, so a Phase-A refusal
  # (`registry-branch-drift`, `foreign-worktree`, `no-worktree-record`,
  # `detached-head`, `incomplete-registry` — every one of which leaves the
  # worktree ON DISK, possibly full of work) emitted
  # `"ignored":[],"ignoredCount":0,"ignoredBytes":0,"sensitive":[]` and
  # `ReapSheet` rendered "not in git: 0 entries, 0 B" about a tree
  # `_ws_collect_ignored` had never been asked to look at. `worktreeBytes` on
  # the same document already said `null` (deviation 120); its four siblings
  # did not. `null` is the answer, for the reason the whole class is closed
  # that way: 0 is the claim "there is nothing here", and nobody looked.
  local ign_json=null total=null count=null sens_json=null sfilt=null first=1 rec rest p b s
  if (( REAP_IGNSCANNED )); then
   ign_json="["; total=0; count=0; sfilt="${REAP_SENSITIVE_FILTERED:-0}"
   if (( ${#REAP_IGNORED[@]} )); then
    while IFS= read -r -d '' rec; do
      s="${rec%%$'\t'*}"; rest="${rec#*$'\t'}"
      b="${rest%%$'\t'*}"; p="${rest#*$'\t'}"
      # MUTATION SURVIVOR, disclosed: `[[ -n "$p" ]] || continue` is removable
      # with the suite green, and always will be — REAP_IGNORED's records are
      # built by _ws_collect_ignored, whose own `[[ -n "$p" ]]` (disclosed
      # there) already refuses an empty path, and `read -d ''` cannot produce
      # an empty record from `printf '%s\0'` over a non-empty array. Same
      # reasoning as the `$dl` sibling below; kept as defence in depth against
      # a future producer. (Gate finding N8.)
      [[ -n "$p" ]] || continue
      (( first )) || ign_json+=","; first=0
      ign_json+="{\"path\":$(_json_str "$p"),\"bytes\":$b,\"sensitive\":$( ((s)) && echo true || echo false)}"
      total=$(( total + b )); count=$(( count + 1 ))
    done < <(printf '%s\0' "${REAP_IGNORED[@]}" | sort -z -t$'\t' -k1,1nr -k2,2nr)
   fi
   ign_json+="]"

   # Inside the same `REAP_IGNSCANNED` block, and that is the point rather than
   # tidiness: `sensitive` and `sensitiveFiltered` are two answers from the one
   # scan, so a document that reports the scan's ignored set as unmeasured and
   # its secret-shaped names as "none" would be self-contradictory in the
   # direction that reassures.
   local sfirst=1 sp
   sens_json="["
   for sp in "${REAP_SENSITIVE[@]-}"; do
     [[ -n "$sp" ]] || continue
     (( sfirst )) || sens_json+=","; sfirst=0
     sens_json+="$(_json_str "$sp")"
   done
   sens_json+="]"
  fi

  # `-z` HERE TOO, for the reason the ignored list has it: this array is read by
  # the same human, in the same document, before the same irreversible action,
  # and without `-z` git C-QUOTES the same five classes of byte — measured, a
  # dirty `déjà vu.txt` rendered `"?? \"d\\303\\251j\\303\\240 vu.txt\""` beside
  # an `ignored` array already carrying raw paths. No guard reads this array
  # (`dirty-tree` refuses on `REAP_DIRTY`, a count from `_ws_reap_eval`'s own
  # read), so nothing here decides anything; the whole judgement this design
  # rests on is a human reading a filename, and `\303\251` is not one.
  #
  # A pipe rather than a temp file: process substitution is a PIPE, so the NULs
  # survive it — it is `$(…)` that drops them, which is why the collector needs
  # a file and this does not. And `-c core.quotePath=false` is deliberately NOT
  # repeated here: `_ws_collect_ignored` records it as a measured NO-OP beside
  # `-z`, and a second copy would be a second line no fixture can pin.
  #
  # A RENAME OR COPY IS TWO RECORDS, `XY <to>NUL<from>NUL`, where the non-`-z`
  # form printed one `R  <from> -> <to>` line — so the second is consumed here
  # and rejoined into that line. Unpaired it would join the list as an entry
  # with no status letters: a bare filename, in exactly the list a human is
  # asked to read. The letter is in the X column: measured on git 2.43, a
  # worktree-only rename is not detected at all (` D` plus `??`) and only an
  # INDEX rename produces the two-path form. `C` is not dead weight beside `R`:
  # it needs `status.renames=copies` AND a modified source (git's copy detection
  # only looks at sources that changed in the same diff, and status has no
  # `--find-copies-harder`), and both halves are in a fixture.
  #
  # MUTATION SURVIVOR, disclosed and measured: `[[ -n "$dl" ]] || continue` is
  # removable with the suite green. Under `-z` git's output ends in a NUL and
  # never contains two in a row, so `read -d ''` cannot produce an empty record
  # — it hits EOF and ends the loop instead. Kept for the reason the identical
  # line in `_ws_collect_ignored` is kept: the next statement indexes `$dl`
  # positionally, and an empty record would put `""` into the one list this
  # design asks a human to read filenames out of.
  #
  # AND `null` FOR A READ THAT DID NOT HAPPEN OR DID NOT FINISH — final-round
  # tests review F3, the same rung as the ignored block above. This was
  # `dirty_json="["` … `2>/dev/null`, so BOTH "there is no directory to read"
  # and "git failed, or half-read the tree" produced `[]`, and `ReapSheet`
  # renders `[]` as **uncommitted: none** — the single most reassuring row on a
  # delete-confirmation sheet, stated about a tree nobody looked at.
  #
  # The rc AND the stderr, for the reason `_ws_gc_dirty` and Phase B both give
  # in full: a PARTIALLY unreadable tree exits ZERO with empty stdout and the
  # diagnostic on stderr (measured, git 2.43), so the exit code alone answers
  # "clean" for a tree holding uncommitted work behind a chmod-000 directory.
  # A temp file rather than the process substitution this used to have,
  # because a pipeline's status is not the read's — the same two-statement
  # shape Phase B states the rule for. The NULs survive a file exactly as they
  # survive a pipe.
  local dirty_json=null dfirst=1 dl dsrc dout derrf derr drc
  if [[ -d "$workdir" ]]; then
    dout=$(mktemp) || dout=""
    derrf=$(mktemp) || derrf=""
    if [[ -n "$dout" && -n "$derrf" ]]; then
      git -C "$workdir" status --porcelain -z >"$dout" 2>"$derrf"; drc=$?
      derr=$(cat "$derrf" 2>/dev/null)
      if (( drc == 0 )) && [[ -z "$derr" ]]; then
        dirty_json="["
        while IFS= read -r -d '' dl; do
          [[ -n "$dl" ]] || continue
          case "$dl" in
            [RC]*) IFS= read -r -d '' dsrc && dl="${dl:0:3}$dsrc -> ${dl:3}" ;;
          esac
          (( dfirst )) || dirty_json+=","; dfirst=0
          dirty_json+="$(_json_str "$dl")"
        done < "$dout"
        dirty_json+="]"
      fi
    fi
    [[ -n "$dout" ]]  && rm -f "$dout"
    [[ -n "$derrf" ]] && rm -f "$derrf"
  fi

  # `ahead` starts at `null` and BOTH ways of not measuring it keep it there —
  # final-round destructive review F2, the last surviving `|| x=0` in this
  # file. The initialiser and the fallback were each a fabricated 0, and both
  # are reachable: the `if` does not run at all when `$base` does not resolve
  # or `$branch` is empty, and `rev-list` can fail inside it.
  #
  # ccd already litigated this exact value 1,340 lines earlier. `_pr_state_one`
  # (ccd:1650) writes `ahead=""` under the comment: `"" is UNMEASURED, not
  # zero. ahead=0 is the claim "this branch is level with base" … a ref that
  # does not resolve has not been measured against anything.` The file
  # disagreed with itself; it no longer does.
  local exists=false headmatch=false ahead=null bytes=0
  [[ -d "$workdir" ]] && exists=true
  [[ -n "$REAP_WTHEAD" && "$REAP_WTHEAD" == "$branch" ]] && headmatch=true
  if [[ -n "$branch" ]] && git -C "$PROJECTS_ROOT/$project" rev-parse --verify --quiet "$base" >/dev/null 2>&1; then
    ahead=$(git -C "$PROJECTS_ROOT/$project" rev-list --count "$base..refs/heads/$branch" 2>/dev/null)
    [[ "$ahead" =~ ^[0-9]+$ ]] || ahead=null
  fi
  # Pre-merge fix round, finding F: `null`, never a fabricated `0` — the same
  # rule `_ws_archive_manifest` (ccd:1190) already carries, applied here where
  # `_ws_gc_bytes`'s own fix (ccd:3201) actually closes the gap. This is the
  # figure `ReapSheet.tsx`'s primary Remove button prints beside "Remove
  # <slug> ·" — the one confirm the whole design exists to protect — so a
  # `du` that could not fully measure the tree must say so rather than hand
  # the sheet a plausible-looking lie. `WsAudit.worktreeBytes` is `number |
  # null` on the wire for exactly this reason (shared/api.ts).
  bytes=$(_ws_gc_bytes "$workdir"); [[ "$bytes" =~ ^[0-9]+$ ]] || bytes=null

  # The clips manifest, read HERE so its status is visible — the sixteenth
  # forgery (`_ws_clip_manifest`). `null` is "this directory exists and could
  # not be enumerated", the same word and the same rule as `dirty`,
  # `ignored`, `stashes` and `worktreeBytes` on this document: `[]` is the
  # claim that there is nothing here, and nobody looked. `WsAudit.clips` is
  # `… [] | null` on the wire so no consumer can be forced back into
  # fabricating the empty array to compile, and `ReapSheet` renders the null
  # as "could not be read" rather than as **none**.
  local clips_json
  clips_json=$(_ws_clip_manifest "$id") || clips_json=null

  # `children[]` — D4, `_ws_child_manifest`. `null` shares its rule with
  # `dirty`/`ignored`/`clips` above: the workdir is gone, or `_ws_reap_eval`
  # refused before Phase A finished proving identity, or the enumeration
  # itself failed outright. `$REAP_WTHEAD` is the SAME signal
  # `headMatchesRegistry` below already reads for "Phase A passed" — it is
  # assigned at the end of `_ws_reap_eval`'s Phase A, only once the eval has
  # walked registry-branch-drift, detached-head, no-worktree-record AND
  # foreign-worktree without refusing, and stays `""` (its `_ws_reap_reset`
  # default) on every refusal at or before those rungs, workdir-missing
  # included. Gated on nothing deeper than that: a Phase-B refusal further
  # down the ladder (dirty-tree, sensitive-ignored, nested-checkouts-present,
  # any per-child rung) must still see a populated `children[]` — that is
  # the whole point of D4, the sheet that shows a human WHY the eval is
  # about to refuse.
  local children_json=null main="$PROJECTS_ROOT/$project"
  if [[ -n "$REAP_WTHEAD" && -d "$workdir" ]]; then
    children_json=$(_ws_child_manifest "$main" "$workdir") || children_json=null
  fi

  printf '{"id":%s,"branch":%s,"base":%s,"workdir":%s,"project":%s,"repo":%s,' \
    "$(_json_str "$id")" "$(_json_str "$branch")" "$(_json_str "$base")" \
    "$(_json_str "$workdir")" "$(_json_str "$project")" "$(_json_str "$repo")"
  printf '"exists":%s,"headMatchesRegistry":%s,"reaping":%s,' \
    "$exists" "$headmatch" "$( [[ -n "$reaping" ]] && _json_str "$reaping" || echo null)"
  # Six fields, one source of truth for whether each is a measurement: `null`
  # from the builders above whenever the read did not happen. See the two
  # blocks for the reason; the printf is deliberately dumb so no third rule can
  # appear here.
  printf '"dirty":%s,"ignored":%s,"ignoredCount":%s,"ignoredBytes":%s,"sensitive":%s,"sensitiveFiltered":%s,' \
    "$dirty_json" "$ign_json" "$count" "$total" "$sens_json" "$sfilt"
  # `clips` on the wire, because the sheet cannot ask a human to consent to a
  # deletion it does not list. `_ws_clip_manifest` is the same producer the
  # tombstone and the fingerprint use, and it is read on every verdict — a
  # refusal is the answer a human reads too.
  #
  # `$clips_json` rather than a `$(…)` in this argument list, and that is the
  # whole of the sixteenth forgery's fix on the wire: a command substitution
  # inside a printf ARGUMENT LIST swallows the producer's status, so the field
  # was `[]` for a directory nobody could open and `ReapSheet` rendered
  # **clips: none** — the most reassuring row on the sheet, above a reachable
  # Remove button. It is computed above, where the status is visible, and it is
  # `null` (never `[]`) when the enumeration did not happen.
  # `stashes` is `null` until `_ws_reap_eval` has actually read the stash list
  # (its reset default is now "" rather than 0, see `_ws_reap_reset`): on a
  # Phase-A refusal the read never happens, and `ReapSheet` renders a 0 there
  # as **stashes: none** — a promise that nothing stashed is at stake, made
  # about a list nobody opened.
  printf '"clips":%s,"stashes":%s,"worktreeBytes":%s,"commitsAheadOfBase":%s,' \
    "$clips_json" \
    "$( [[ "$REAP_STASHES" =~ ^[0-9]+$ ]] && echo "$REAP_STASHES" || echo null)" \
    "$bytes" "$ahead"
  printf '"pr":{"number":%s,"url":%s,"mergeCommit":%s,"headRefOid":%s},' \
    "$( [[ "$REAP_PRNUM" =~ ^[0-9]+$ ]] && echo "$REAP_PRNUM" || echo null)" \
    "$(_json_str "$REAP_PRURL")" "$(_json_str "$REAP_MERGE")" "$(_json_str "$REAP_HEADOID")"
  # `fetchedAt` is `null` until Phase C actually fetched — same rung. Its reset
  # default of 0 is a real epoch second, and `ReapSheet` printed it through
  # `days()`: "merged in #? (proof: none), 20669 days ago", a date for a fetch
  # that never ran, on the same line as two fields (`pr.number`, `merge.proof`)
  # that have said `null` for the same state since deviation 10.
  printf '"merge":{"proof":%s,"fetchedAt":%s},"transcript":%s,' \
    "$( [[ -n "$REAP_PROOF" ]] && _json_str "$REAP_PROOF" || echo null)" \
    "$( [[ "$REAP_FETCHED" =~ ^[0-9]+$ ]] && echo "$REAP_FETCHED" || echo null)" \
    "$(_json_str "$transcript")"
  printf '"children":%s,' "$children_json"
  # Three verdicts, not two, and the third one is why: `reapable` MEANS a token.
  #
  # `token` is present ONLY when the verdict is reapable AND the tree was
  # actually read. The second half is not a belt-and-braces restatement of the
  # first: with the worktree gone and a `reaping` breadcrumb explaining why,
  # `_ws_reap_eval` skips the whole of Phase B on purpose — that is the RESUME
  # of a killed reap, and refusing it would strand the workspace half-deleted
  # forever — so it reaches `reapable` with `REAP_DIRTY=0`, `REAP_IGNDIGEST=""`,
  # `REAP_SENSITIVE=()` and `REAP_WTHEAD=""` straight out of `_ws_reap_reset`.
  # Those are the reset defaults, not measurements, and `dirty-tree` and
  # `sensitive-ignored` — the two guards §7 forbids overriding — were never
  # evaluated at all. A fingerprint over them is deviation 6's digest forgery
  # with more fields: ws-reap recomputes the same unmeasured values and the
  # consent check matches, so the token would certify a tree nobody ever looked
  # at. The audit therefore reports the state (`exists:false`, `reaping`) and
  # hands out nothing to confirm against; resuming a killed reap is ws-reap's
  # own path, not a token-carrying delete.
  #
  # AND IT MUST NOT SAY `reapable` WHILE DOING SO. Withholding the token from a
  # verdict that still read `reapable` produced a wire shape the sheet
  # mis-renders: `wsaudit.ts` gives `reapable` an EMPTY sentence, `ReapSheet`
  # renders the primary Remove button on `verdict === 'reapable'`, and that
  # button's `confirm()` early-returns when `token === undefined` — a button
  # that silently does nothing, under no explanation at all. Two different
  # states must not share a verdict: this one is `reap-interrupted`, the
  # worktree is already gone, ccrc's own breadcrumb says ccrc removed it, and
  # what is left is a RESUME (`ws-reap --resume`, Task 6), which is not a
  # token-carrying delete and never asks for a confirmation the human cannot
  # give. `_ws_reap_eval` is deliberately untouched: its `reapable` is what the
  # resume path itself depends on.
  #
  # AND A THIRD STATE THAT MUST NOT SHARE ONE EITHER, for the identical reason
  # — the sixteenth forgery. `_ws_reap_eval` refuses `clips-unreadable` when
  # its own read fails, so this branch covers the WINDOW between that read and
  # this one: the directory can be made unreadable in the microseconds
  # between, and then the token above would certify a manifest while the
  # document beside it says the manifest could not be taken. One state, one
  # verdict: no token, and the same token name the eval uses, so the sheet
  # reads the same sentence whichever read caught it.
  if [[ "$REAP_VERDICT" == reapable && "$clips_json" == null ]]; then
    printf '"verdict":"clips-unreadable","detail":%s}\n' \
      "$(_json_str "could not list $HOME/.cc-clips/$id — the pasted images this cleanup would delete cannot be enumerated")"
  elif [[ "$REAP_VERDICT" == reapable && "$exists" == true ]]; then
    printf '"verdict":"reapable","detail":"","token":%s}\n' "$(_json_str "$REAP_TOKEN")"
  elif [[ "$REAP_VERDICT" == reapable ]]; then
    printf '"verdict":"reap-interrupted","detail":%s}\n' \
      "$(_json_str "a previous removal stopped after the ${reaping:-worktree} step and left no worktree to inspect")"
  else
    printf '"verdict":%s,"detail":%s}\n' "$(_json_str "$REAP_VERDICT")" "$(_json_str "$REAP_DETAIL")"
  fi
}

_ws_attic_pin() {   # main id workdir tip -> echoes how many refs were created
  # Every distinct sha in the worktree's HEAD reflog, deduped and capped, plus
  # the tip. ~50 bytes each, no new objects, and the commits become REFERENCED
  # rather than dangling — so gc.pruneExpire can never reach them.
  #
  # TWO MUTATION SURVIVORS, disclosed and each measured (the `head -200` that
  # used to be a third is now half of the pinned ORDER below):
  #   - `git cat-file -e "${sha}^{commit}" || continue` is removable with the
  #     suite green: `update-ref` refuses a value it cannot resolve, so a
  #     nonexistent object creates no ref and increments nothing either way.
  #     It stays for the `^{commit}` PEEL rather than for the existence test —
  #     `update-ref` will happily point a ref outside refs/heads at a blob or a
  #     tree, and the attic is a record of COMMITS. No reflog can produce one,
  #     which is why no fixture can pin it.
  #   - `[[ -d "$workdir" ]] &&` is removable for the same reason: this helper
  #     is called only from the tail's `[[ -z "$resumed" ]]` arm, where Phase A
  #     has already proved the directory is $main's worktree. With it gone the
  #     read errors into /dev/null and the tip still comes through. It stays so
  #     the helper is safe to call from anywhere, which is how the resume path
  #     would want to call it if it ever did.
  #
  # THE CAP IS ON THE REFLOG, AND THE TIP IS APPENDED AFTER IT. It used to be
  # applied to `{ reflog; tip } | sort -u`, i.e. to the UNION, which made the tip
  # just another line in hex-sort order — measured end to end on a workspace
  # with 231 commits: 237 distinct reflog shas, the tip at rank 201 of them,
  # `tip pinned in attic? 0`, 200 refs written and not one of them the branch's
  # own commit. That commit is the ONE a squash merge leaves outside main, so it
  # is precisely the commit the attic exists for; after `origin/<branch>` is
  # auto-deleted on merge and the next `fetch --prune` runs, it is dangling with
  # the two-week fuse §5.5(a) exists to remove. Spec §5.5(a) reads "deduped,
  # capped at 200, PLUS `tip`", and now so does this: `sort -u | head -200` over
  # the reflog, then the tip, then a second `sort -u` — which dedupes rather
  # than caps, so a tip already among the 200 is not pinned twice and does not
  # inflate the count the sheet prints. At most 201 refs.
  #
  # What IS pinned, by `pins the tip when the reflog cannot be read, and makes
  # no ref from a non-sha`: the shape check (without it `refs/heads/main` is a
  # string `update-ref` resolves, and the attic grows a ref made out of a NAME)
  # and the unconditional tip append; by `pins the tip even past the 200-ref
  # cap`: the ORDER of the cap and the append; and by `pins the amended-away
  # commit` the first `sort -u`, because `%H` prints one line per reflog ENTRY
  # and the count that reaches the sheet has to be the number of refs that
  # exist. The cap's own MAGNITUDE — 200 rather than 20 — remains unpinned:
  # bounding it costs a fixture with 200 resolvable commits in it, and the
  # fixture above pins where the cap is applied without paying for how big it is.
  local main="$1" id="$2" workdir="$3" tip="$4" sha n=0
  while read -r sha; do
    [[ "$sha" =~ ^[0-9a-f]{40}$ ]] || continue
    git -C "$main" cat-file -e "${sha}^{commit}" 2>/dev/null || continue
    git -C "$main" update-ref "refs/ccrc/attic/$id/$sha" "$sha" 2>/dev/null && n=$(( n + 1 ))
  done < <( { [[ -d "$workdir" ]] && git -C "$workdir" reflog show --all --format=%H 2>/dev/null | sort -u | head -200; \
              printf '%s\n' "$tip"; } | sort -u )
  echo "$n"
}

_ws_clip_manifest() {   # id -> JSON array of {name,bytes}, and nothing else;
                        # NOTHING at all, and non-zero, when the directory
                        # exists and could not be enumerated
  # Pre-merge fix round, finding A — the EIGHTH instance of the
  # measurement-forgery class (deviation 10), and the one where two sides
  # AGREE on a value NEITHER measured: the wire manifest, the fingerprint
  # (`clipsDigest`, `_ws_reap_eval`) and the tombstone (`_ws_tombstone`) all
  # come from this ONE producer, so all three inherited its blind spot.
  #
  # The old enumeration was `for f in "$dir"/*` filtered by `[[ -f "$f" ]]` —
  # depth-1, non-dot, REGULAR FILES ONLY. Step (h) (`_ws_reap_tail`, ccd:3203)
  # is `rm -rf "$cdir"` on the WHOLE DIRECTORY. Measured: with `clip-a.png`
  # (10 B) present, an audit issued a token; adding `.hidden-secret.png`
  # (4 KB) and `archive/{prod.env,big.bin}` (1 MB) left the manifest AND the
  # token byte-identical; the STALE token from before those files existed
  # still validated a reap; the whole directory — dotfile, subdirectory and
  # all — was destroyed; the tombstone still names only `clip-a.png`. Fixed
  # by enumerating with `find -mindepth 1 -maxdepth 1`, which unlike a bare
  # glob does not skip dotfiles, and by sizing a DIRECTORY entry with `du -sb`
  # (recursive) rather than `stat`, whose size is the inode's, not its
  # contents' — so the enumeration now matches exactly what (h) destroys.
  # `sort -z` keeps the manifest deterministic across two calls over an
  # unchanged directory, the property the digest and the CAS both depend on
  # — `find`'s own enumeration order is a filesystem implementation detail,
  # not a promise, even though it happens to be stable on THIS box for an
  # unmodified small directory (measured: the token is identical across two
  # back-to-back audits with or without this line, which is why it is a
  # disclosed survivor rather than a pinned one — the fixture that would
  # distinguish them needs a filesystem, or a directory history, this suite
  # cannot arrange). Kept anyway, the same judgement the attic's 200-ref cap
  # gets for the identical reason (CONSTRAINTS.md): a property this design
  # depends on must not rest on an implementation detail merely because
  # today's filesystem happens to make it hold.
  #
  # `[[ -d "$dir" ]] || { echo "[]"; … }` used to be a disclosed mutation
  # survivor: `find` on a nonexistent path printed nothing on stdout and a
  # diagnostic on stderr (discarded), so the loop read no records either way,
  # and the guard stood only to make the empty answer a DECISION rather than an
  # accident of `find`'s own exit code — "which this function does not
  # otherwise check", as this comment said in as many words until the
  # sixteenth forgery below made it check. It is a survivor no longer: with the
  # enumeration status honoured, deleting this line turns a MISSING clips
  # directory (no clips were ever pasted — a real, common, empty state) into
  # the refusal an UNREADABLE one gets, and `refuses to enumerate a clips
  # directory it cannot read, and still answers [] for one that is simply
  # absent` fails on the second half.
  #
  # ── THE THIRTEENTH FORGERY (cross-lane seam round) ────────────────────────
  # Both size rungs below used to answer a FAILED READ with `0`, and the older
  # comment above defended it: the entry's NAME lands either way, and the name
  # is what the digest and the token are built from. That argument is sound
  # about the name and says nothing about the number — and the number is not
  # private to this function. `cmd_ws_audit` puts this manifest on the wire
  # (ccd:2944) and `ReapSheet.tsx:303` SUMS `clips[].bytes` into a stated total
  # printed on the same sheet, above the same Remove button, as the worktree
  # figure `_ws_gc_bytes` already refuses to fabricate. So the fabricated 0 was
  # never merely a display understatement; it was a measurement claim made to a
  # human about to authorise a `rm -rf`.
  #
  # Re-measured here, GNU coreutils 9.4, before the fix: `du -sb` over a tree
  # holding 14000 bytes with one `chmod 000` subdirectory exits **1**, writes
  # `du: cannot read directory …: Permission denied` to stderr, and STILL
  # PRINTS `5000`. A numeric-looking answer is therefore not evidence of a
  # completed measurement, and `[[ "$b" =~ ^[0-9]+$ ]]` on its own accepted it.
  # Both rungs now check the exit status FIRST (`pipefail` is set file-wide, so
  # the pipeline's status is du's) and keep the numeric test as the second
  # conjunct for a `du` that succeeds and prints something else.
  #
  # WHY `null` PER ENTRY AND NOT THIS FUNCTION'S OWN REFUSAL, which is what
  # `_ws_collect_ignored` (ccd:2263) got for the same class one round earlier:
  #   - This function has no refusal channel to use. Its two other consumers
  #     are the fingerprint (`clipsDigest`, ccd:2796) and `_ws_tombstone` /
  #     `_ws_tombstone_reclip` — and the tombstone is the record that OUTLIVES
  #     the workspace. A refusal there is either ignored or turns one
  #     unreadable clip into a half-finished reap with the worktree already
  #     gone. `_ws_collect_ignored` could refuse because every one of ITS
  #     callers had somewhere to put the refusal before anything was destroyed.
  #   - A manifest has MANY entries and they are independent. One unreadable
  #     clip is a reason not to state that clip's size; it is not a reason to
  #     refuse to describe the other nine, or to withhold the whole sheet.
  #   - The name still lands, which is the half of the old comment that was
  #     right: the consent boundary and the digest keep working unchanged.
  # `null` is a fact ("nobody measured this"), not a value, and it is
  # deterministic for a given readability state, so `clipsDigest` still
  # discriminates and still refuses `state-changed` on a real change.
  # `shared/api.ts:209` types `clips[].bytes` as `number | null` so that a
  # consumer CANNOT go back to fabricating one to satisfy the compiler, and
  # `ReapSheet.tsx`'s `clipsSizeText` states what was measured and discloses
  # the rest ("1 MB + 1 unmeasured") rather than folding null into the sum.
  #
  # The `null` is also what keeps the old comment's other worry answered: `b`
  # is now always either digits or the four characters `null`, so the record is
  # valid JSON on every path — `"bytes":` with nothing after it, the document
  # that does not parse, is unreachable from either rung.
  #
  # ── THE SIXTEENTH FORGERY (final-round confirmation-surface review) ───────
  # The thirteenth fix above closed the SIZE of an entry and left the LIST
  # itself. A clips directory that EXISTS and cannot be ENUMERATED answered
  # `[]` at exit 0 — a claim of emptiness nobody established — and `[]` is not
  # a degraded answer on this surface, it is the most reassuring one:
  # `ReapSheet.tsx` renders it as **clips: none**.
  #
  # REPRODUCED before the fix, `chmod 000` on `~/.cc-clips/<id>` under an
  # isolated $HOME holding a 4 KB paste and a 1 MB subdirectory:
  # `find` exits 1 printing nothing, this function echoed `[]` at rc 0, and
  # `cmd_ws_audit` answered `"clips":[],…"verdict":"reapable"` WITH A TOKEN.
  # The fingerprint is no defence and could not be: `clipsDigest` is this same
  # `[]`, so ws-reap recomputes the identical digest, `--expect` matches, and
  # step (h) `rm -rf`s a directory whose contents were never listed to the
  # human — two sides agreeing on a value neither measured, which is the
  # eighth forgery's shape (above) reached through a different door.
  #
  # `find`'S EXIT STATUS CANNOT BE THE WHOLE TEST, and this is the measurement
  # that decides the shape of the guard. GNU findutils 4.9.0, same box:
  #   - mode 000 (no `r`): `opendir` fails. rc 1, stdout EMPTY. Nothing was
  #     enumerated — the case above.
  #   - mode 400 (`r`, no `x`): `readdir` succeeds and every per-entry `stat`
  #     fails. rc **1**, and stdout carries the COMPLETE list of names
  #     (measured: `plain.png` and `sub` both printed, with a single
  #     `Permission denied` for `sub` on stderr).
  # Identical status, opposite facts. So the guard is `rc != 0 AND no records`,
  # not `rc != 0`: the mode-400 shape is a complete list of names whose sizes
  # are unmeasured, which is exactly what the per-entry `null` rungs below are
  # for and what `a clip whose size stat cannot take is null, not 0 bytes`
  # already pins. Refusing it would delete a pinned honest answer to close a
  # different hole.
  #
  # A SCRATCH FILE, not the old process substitution, because a pipeline's
  # status is not visible through `< <(…)` at all — the same two-statement rule
  # Phase B and `cmd_ws_audit`'s dirty read both state, and NULs survive a file
  # exactly as they survive a pipe. `pipefail` is set file-wide, so `lrc` is
  # `find`'s (or `sort`'s).
  #
  # AND THE REFUSAL PRINTS NOTHING. `[]` plus a non-zero status was the obvious
  # shape and is the wrong one: it leaves the forgery fully formed on stdout
  # for any consumer that does not check the status — which is precisely how
  # this instance existed, since two of the three consumers could not check a
  # status they were never given (`… | sha256sum` reports the pipe's, and a
  # `$(…)` inside a printf ARGUMENT LIST swallows it). Empty stdout is
  # `cmd_ws_audit`'s own rule for its `_json_str` probe, stated there: when the
  # honest answer cannot be produced, "print NOTHING and exit non-zero". A
  # status-blind consumer then writes `"clips":` and fails to parse — loudly
  # wrong instead of quietly reassuring — and all three consumers here DO check
  # it: the audit refuses `clips-unreadable` and withholds the token, the
  # fingerprint refuses the same rather than hash an emptiness nobody read, and
  # the tombstone records `null` (see `_ws_reap_tail`), because a record that
  # outlives the workspace must not say "none" about a directory nobody opened.
  #
  # RESIDUAL, disclosed rather than papered over: a `readdir` that dies PART
  # WAY through a large directory (EIO, a network filesystem) exits non-zero
  # with a TRUNCATED list, which this guard accepts as the mode-400 shape and
  # publishes as complete. Separating those two needs a second, independent
  # enumeration to disagree with — two reads of the same directory microseconds
  # apart, which is a race of its own — and no fixture on this box can produce
  # a partial `readdir` to pin either behaviour. What is closed here is the
  # whole-directory case, which is reproducible with a `chmod`.
  # TWO `local` STATEMENTS, not one. `local id="$1" dir="$HOME/.cc-clips/$id"`
  # expands EVERY word before performing ANY assignment, so under `set -u` the
  # `$id` in the second word is unbound and the function dies
  # `id: unbound variable` — unless the CALLER happens to have a `local id`,
  # which by dynamic scoping is exactly what all three call sites have today.
  # So the bug was invisible and the function was untestable in isolation at
  # the same time, for the same reason. Disclosed by the ccd lane as residual
  # #3 and left as latent; closed here because the unmeasured-clip fixtures
  # below call this function directly, and a producer that can only be
  # exercised through a 30-second destructive end-to-end reap is a producer
  # whose failure rungs do not get pinned.
  local id="$1"
  local dir="$HOME/.cc-clips/$id" f name b brc out="[" first=1 lf lrc
  [[ -d "$dir" ]] || { echo "[]"; return 0; }
  lf=$(mktemp) || return 1
  find "$dir" -mindepth 1 -maxdepth 1 -print0 2>/dev/null | sort -z >"$lf"; lrc=$?
  # `-s` IS THE SECOND CONJUNCT, and it is a measurement of this read rather
  # than a guess about why it failed: a non-empty file means `readdir` handed
  # back at least one name, which no unenumerable directory can do, and an
  # EMPTY one at rc 0 is a directory that is genuinely empty.
  { (( lrc == 0 )) || [[ -s "$lf" ]]; } || { rm -f "$lf"; return 1; }
  while IFS= read -r -d '' f; do
    name="$(basename "$f")"
    if [[ -d "$f" ]]; then
      # A directory's own size is the directory ENTRY's — `du -sb`, the same
      # recursive read `_ws_gc_bytes` uses, is what makes this figure the
      # bytes `rm -rf` actually reaches rather than one inode.
      #
      # `rc` then numeric, in that order and for that reason: the partial
      # total measured above is numeric AND wrong, so the numeric test cannot
      # be the outer guard. No stderr conjunct, unlike `_ws_gc_bytes` — that
      # needs a scratch file, and this is a LOOP, so it would take a `mktemp`
      # per clip and add a failure mode (mktemp failing mid-manifest) for a
      # conjunct `_ws_gc_bytes`'s own disclosure says never fires first. Same
      # rc+numeric shape `_ws_collect_ignored` took for the same class.
      b=$(du -sb "$f" 2>/dev/null | cut -f1); brc=$?
      { (( brc == 0 )) && [[ "$b" =~ ^[0-9]+$ ]]; } || b=null
      name="$name/"
    else
      # Reachable only if the entry disappears between the `find` and the
      # `stat`, or its directory becomes unreadable in the same window — no
      # fixture can arrange either, which is why this rung was `|| echo 0` for
      # so long. A race is still a failed read: it answers `null` like its
      # sibling rather than claiming an empty file was deleted.
      b=$(stat -c %s "$f" 2>/dev/null); brc=$?
      { (( brc == 0 )) && [[ "$b" =~ ^[0-9]+$ ]]; } || b=null
    fi
    (( first )) || out+=","; first=0
    out+="{\"name\":$(_json_str "$name"),\"bytes\":$b}"
  done < "$lf"
  rm -f "$lf"
  echo "$out]"
}

_reap_paths_json() {   # -> REAP_SENSITIVE as a JSON array of strings
  # Shared by BOTH refusal sites in cmd_ws_reap (the evaluated one and the
  # resume one), so the two cannot describe the same finding differently — and
  # both sites are now pinned, one per fixture, because a shared helper with one
  # caller under test is a shared helper by intention only.
  #
  # MUTATION SURVIVOR, disclosed: `[[ -n "$p" ]] || continue` is removable with
  # the suite green, exactly as its two siblings in `_ws_collect_ignored` and
  # `cmd_ws_audit` are. REAP_SENSITIVE is filled by the collector, which already
  # refuses an empty path, so no fixture can put one here. Kept as defence in
  # depth against a future producer, which is the same reason given there.
  local out="[" first=1 p
  for p in "${REAP_SENSITIVE[@]-}"; do
    [[ -n "$p" ]] || continue
    (( first )) || out+=","; first=0
    out+="$(_json_str "$p")"
  done
  printf '%s]\n' "$out"
}

_ws_tombstone() {   # id clipsjson -> writes .reaped/<id>.json, echoes its path
  local id="$1" clips="$2" dir="$REG/.reaped" f="$REG/.reaped/$1.json"
  mkdir -p "$dir"
  # `sensitive\tbytes\tpath`, NUL-terminated, read exactly as cmd_ws_audit reads
  # it (Task 5, deviation 18): the collector's `git status … -z` leaves a TAB or
  # a NEWLINE in a path intact, so the two fixed-shape fields come off the FRONT
  # and the path is everything after the second tab. A `read -r p b s` on a
  # path-first record shifts every field, and this record is what the TOMBSTONE
  # says was destroyed — the one document that outlives the workspace. The field
  # ORDER is pinned by `records in the tombstone the ignored manifest it
  # destroyed, field for field`, whose ignored entry is named `a<TAB>b.log`;
  # before that fixture existed every other one here had an EMPTY ignored set,
  # so this whole loop was unreached and the order was an argument rather than a
  # measurement.
  #
  # SEVEN MUTATION SURVIVORS in this function, disclosed together because six of
  # them are one reason — the tombstone is written on the EVALUATED path only,
  # after Phase A proved the registry complete and Phase C proved the PR, so the
  # states these lines are about cannot occur where they run:
  #   - `if (( ${#REAP_IGNORED[@]} ))` — on bash 4.4+ an empty array under
  #     `set -u` expands to nothing and the loop reads one empty record and
  #     skips it. The guard is what stops the empty case depending on that.
  #   - `[[ -n "$p" ]] || continue` and `[[ -n "$aref" ]] || continue` — neither
  #     producer can emit an empty record (gate finding N8's class, and the same
  #     answer: the next statement dereferences the value into a document a
  #     human reads filenames out of).
  #   - `[[ -d "$(_reg_get "$id" workdir)" ]] &&` on the reflog — the workdir
  #     exists whenever (b) runs; it stays so an empty `reflog` is a decision.
  #   - `| head -200` on the reflog — a cap, unpinnable for the reason
  #     `_ws_attic_pin`'s MAGNITUDE is (where the cap is APPLIED is pinned there
  #     now, by `pins the tip even past the 200-ref cap`; how big it is still
  #     costs a fixture with 200 resolvable commits in it, and this dump is not
  #     read by any guard at all).
  #   - the `REAP_PRNUM` numeric test — Phase C proved a bound merged PR before
  #     this line can run, so it is always numeric HERE. The sibling in
  #     `_ws_reap_tail`'s printf is genuinely reachable (the resume path prints
  #     an empty one) and is pinned there; this one is the same shape kept for
  #     the same reason, `"pr":` being invalid JSON.
  # The seventh is `|| transcript=""`, which cannot change anything at all: a
  # bare `VAR=$(cmd)` already assigns "" when cmd fails. It is written because
  # `cmd_ws_audit` (ccd:2161) writes it, and these two records name the same
  # transcript — they are kept identical so they cannot drift.
  local ign_json="[" first=1 rec rest p b s
  if (( ${#REAP_IGNORED[@]} )); then
    while IFS= read -r -d '' rec; do
      s="${rec%%$'\t'*}"; rest="${rec#*$'\t'}"
      b="${rest%%$'\t'*}"; p="${rest#*$'\t'}"
      [[ -n "$p" ]] || continue
      (( first )) || ign_json+=","; first=0
      ign_json+="{\"path\":$(_json_str "$p"),\"bytes\":$b,\"sensitive\":$( ((s)) && echo true || echo false)}"
    done < <(printf '%s\0' "${REAP_IGNORED[@]}")
  fi
  ign_json+="]"
  # THE ATTIC REF NAMES, not the count of them — spec §5.5(b) lists "the attic
  # ref names" among what this document contains, and (j) is where the count
  # goes, on the verb's stdout. They are different facts and both are needed:
  # `ccd ws-attic --drop <id>` releases the refs, and after that this document
  # is the only record of which commits were pinned — which is the whole point
  # of a tombstone, since by then the branch, the reflog and the registry are
  # all gone. Read back from git rather than passed in, so the list has ONE
  # producer and cannot disagree with itself; `_ws_attic_pin` has already
  # created them by the time (b) runs, and its own answer is "how many I
  # created", which is not the same question.
  local main="$PROJECTS_ROOT/$(_reg_get "$id" project)" attic_json="[" afirst=1 aref
  while IFS= read -r aref; do
    [[ -n "$aref" ]] || continue
    (( afirst )) || attic_json+=","; afirst=0
    attic_json+="$(_json_str "$aref")"
  done < <(git -C "$main" for-each-ref --format='%(refname)' "refs/ccrc/attic/$id/" 2>/dev/null)
  attic_json+="]"
  # THE CONSENTED CHILD SET, RECORDED — Task 8. One string per
  # `REAP_CHILDLINES` line (`path<TAB>branch<TAB>head<TAB>dirty`, the exact
  # text the descent in `_ws_reap_eval` built and the fingerprint's
  # fourteenth input hashed), `_json_str`-encoded so the tab survives the
  # round trip. `[]` when the workspace had no registered children — a
  # MEASUREMENT, taken at eval, never `null`: this document is what a
  # resume reads back as "what was consented", and an unmeasured children
  # set is not the same fact as a measured empty one (the same distinction
  # `clips` draws elsewhere in this function). `_ws_tombstone` runs only on
  # the FRESH path (`_ws_reap_tail`'s `if [[ -z "$resumed" ]]` arm), in the
  # same process `_ws_reap_eval` just populated `REAP_CHILDLINES` in, so
  # there is no capture boundary to lose the trailing entries across.
  local children_json="[" cfirst=1 cchild
  while IFS= read -r cchild; do
    [[ -n "$cchild" ]] || continue
    (( cfirst )) || children_json+=","; cfirst=0
    children_json+="$(_json_str "$cchild")"
  done <<< "$REAP_CHILDLINES"$'\n'
  children_json+="]"
  local reflog="" transcript
  [[ -d "$(_reg_get "$id" workdir)" ]] && reflog=$(git -C "$(_reg_get "$id" workdir)" reflog show --all --format='%H %gs' 2>/dev/null | head -200)
  transcript=$(_transcript_path "$id") || transcript=""
  {
    printf '{"id":%s,"project":%s,"workdir":%s,"branch":%s,"base":%s,"tip":%s,' \
      "$(_json_str "$id")" "$(_json_str "$(_reg_get "$id" project)")" \
      "$(_json_str "$(_reg_get "$id" workdir)")" "$(_json_str "$(_reg_get "$id" branch)")" \
      "$(_json_str "$(_reg_get "$id" base)")" "$(_json_str "$REAP_TIP")"
    printf '"uuid":%s,"wrapper":%s,"mergeCommit":%s,"proof":%s,"pr":%s,"prUrl":%s,' \
      "$(_json_str "$(_reg_get "$id" uuid)")" "$(_json_str "$(_reg_get "$id" wrapper)")" \
      "$(_json_str "$REAP_MERGE")" "$(_json_str "$REAP_PROOF")" \
      "$( [[ "$REAP_PRNUM" =~ ^[0-9]+$ ]] && echo "$REAP_PRNUM" || echo null)" "$(_json_str "$REAP_PRURL")"
    printf '"ignored":%s,"clips":%s,"transcript":%s,"attic":%s,"reflog":%s,"children":%s,"reapedAt":%s}\n' \
      "$ign_json" "$clips" "$(_json_str "$transcript")" "$attic_json" "$(_json_str "$reflog")" \
      "$children_json" "$(date +%s)"
  } > "$f"
  echo "$f"
}

_ws_tombstone_reclip() {   # id clipsjson -> rewrites an EXISTING tombstone's
                            # `clips` field in place; non-zero if it could not.
  # Pre-merge fix round, finding E, same underlying gap as finding A: the
  # resume path re-proves Phase B and Phase D1 in full but never re-reads
  # `_ws_clip_manifest` — `tomb` on the resume branch is just the EXISTING
  # file's path (ccd:3149) — so a clip pasted between the original consent
  # and the resume is `rm -rf`'d at (h) and appears in NO record at all.
  # Measured: a 3 MB clip pasted after the tombstone was written was
  # destroyed on resume, and the tombstone still named only the first one.
  # The tokenless resume is disclosed and defensible (the tombstone IS the
  # consent record, ccd:2916-2933); the undisclosed half this closes is that
  # the record has to cover what THIS run destroys, not what the original
  # run saw.
  #
  # Only the `clips` field moves. `ignored`/`attic`/`reflog`/`pr`/`proof` etc.
  # keep whatever the ORIGINAL evaluated run measured — re-deriving them here
  # would need Phase C re-run (deliberately not, ccd:2929-2931) and Phase B's
  # full ignored-set walk (the resume only re-proves dirty/sensitive-ignored
  # as REFUSALS, ccd:3057-3068 — it never rebuilds `ignored[]` as a document).
  # `clips` is the one field this resume both re-measures AND is about to
  # destroy, so it is the one field this rewrites.
  #
  # Read-modify-write through python end to end, not a bash-side field
  # substitution: the existing document's every OTHER field has to survive
  # untouched, including ones this shell was never handed (`ignored`, `pr`,
  # `attic`, `reflog`). `separators=(",", ":")` matches `_json_str`'s own
  # compact style (no spaces) — without it a round-trip through python's
  # default `json.dump` changes every byte in the file even when `clips`
  # itself did not change, which would silently break
  # `_ws_reap_tail`'s own promise (ccd:3055-3061, the ORIGINAL wording this
  # finding narrows rather than removes) that an unrelated resume leaves the
  # journal alone.
  #
  # Failure is REFUSED, not swallowed — measured with a real permission
  # error (`chmod 444` on the tombstone file itself, which is what actually
  # blocks python's `open(…, "w")`; a directory-only chmod does not, since
  # overwriting an EXISTING file needs write on the FILE, not on the
  # directory that holds it). The caller turns a non-zero return here into
  # `tombstone-unwritable` before (h) runs — never destroy clips a document
  # could not be made to name truthfully.
  #
  # MUTATION SURVIVOR, disclosed: `[[ -s "$f" ]] || return 1` is removable
  # with the suite green. By the time either call site reaches this
  # function the tombstone is either the one `_ws_tombstone` just wrote at
  # (b) in THIS process, or the resume path's own `tombtip` read (ccd's
  # `_ws_reap_locked`) already proved a non-empty tombstone exists moments
  # earlier — no fixture can arrange this function running with the file
  # genuinely absent. Kept as the same "refuse rather than guess" instinct
  # every other guard in this file states for itself, not because a test
  # can currently force the branch.
  local id="$1" clips="$2" f="$REG/.reaped/$1.json"
  [[ -s "$f" ]] || return 1
  printf '%s' "$clips" | python3 -c '
import json, sys
path = sys.argv[1]
clips = json.loads(sys.stdin.read())
with open(path, "r", encoding="utf-8") as fh:
    doc = json.load(fh)
doc["clips"] = clips
with open(path, "w", encoding="utf-8") as fh:
    json.dump(doc, fh, separators=(",", ":"))
' "$f" 2>/dev/null
}

_ws_tomb_children() {   # tombstone-json-file -> one raw
                          # "path<TAB>branch<TAB>head<TAB>dirty" line per
                          # CONSENTED child on stdout, rc 0; empty output at
                          # rc 0 when the field is absent (an old tombstone,
                          # written before Task 8, reads as consented-empty)
                          # or the array itself is empty (a workspace with no
                          # registered children); NON-ZERO — a refusal at
                          # EVERY call site, never a silently-accepted
                          # consented-empty — when the document could not be
                          # opened or parsed at all.
  #
  # PYTHON, not a bash-regex decoder (fix round 1, finding 2 — the decoder
  # this replaced could not close two gaps at once). `_json_str`
  # (`json.dumps`, `ensure_ascii=True`) escapes any non-ASCII byte in a path
  # or branch name as `\uXXXX`; three bash string substitutions have no way
  # to decode that back to the original byte and would leave it literal.
  # Worse, the substitution ORDER was wrong for a path that itself contains
  # a literal backslash-t: `/a\test` encodes as `\\test` (an escaped
  # backslash, then plain text) and unescaping `\t` BEFORE `\\` reads those
  # two characters as the FIELD DELIMITER, injecting a tab nobody consented
  # to — a decode bug that could desynchronise the very field split the
  # caller relies on. `cmd_ws_reap` already makes python3 a hard
  # precondition of every reap path (the `_json_str probe` gate at its own
  # entry, before either the fresh or the resume fork), so this adds no new
  # dependency — only a decoder that is actually closed, mirroring
  # `_ws_tombstone_reclip`'s own idiom: `[[ -s "$f" ]] || return 1` first
  # (a genuinely missing tombstone is impossible by the time either caller
  # reaches this function, since both run only after the SAME file's `tip`
  # was already read successfully — kept anyway for the same "refuse rather
  # than guess" instinct that function states for itself), then hand the
  # read-and-print entirely to python and return ITS status, never masking
  # a failure into empty-but-successful output.
  #
  # `LC_ALL=C.UTF-8` on the invocation, for the reason `_json_str`'s own
  # comment gives in full for the ENCODE side: this function's whole job is
  # printing RAW BYTES to stdout for a bash reader, and Python's text-mode
  # stdout encoding is locale-dependent unless pinned — the read side is
  # already locale-proof (`ensure_ascii=True` makes the FILE pure ASCII, so
  # `open(..., encoding="utf-8")` cannot vary by box), but nothing pins the
  # WRITE side without this.
  local f="$1"
  [[ -s "$f" ]] || return 1
  LC_ALL=C.UTF-8 python3 -c '
import json, sys
path = sys.argv[1]
with open(path, "r", encoding="utf-8") as fh:
    doc = json.load(fh)
children = doc.get("children", [])
if children is None:
    children = []
for line in children:
    sys.stdout.write(line)
    sys.stdout.write("\n")
' "$f" 2>/dev/null
}

cmd_ws_reap() {   # ccd ws-reap --expect <token> --session <id>
  # The ONLY destructive verb. Every guard is re-evaluated HERE, on the box, at
  # the instant of deletion — the audit's verdict is not trusted, it is
  # recomputed. A refusal prints on stdout and exits 0: it is an answer.
  [[ $# -eq 4 && $1 == --expect && $3 == --session ]] \
    || die "usage: ccd ws-reap --expect <token> --session <id>"
  local token=$2 id=$4
  [[ $token =~ ^[0-9a-f]{64}$ ]]    || die "bad token"
  [[ $id =~ ^[A-Za-z0-9._-]+$ ]]    || die "bad session id"

  # `_json_str`'s status, checked ONCE and up front — the same probe, for the
  # same reason, as `cmd_ws_audit` (ccd:2153) and `_ws_manifest` (ccd:1109).
  # This is the THIRD caller that builds a whole record, and the record it
  # builds is the TOMBSTONE: the one document that outlives the workspace, and
  # the only thing left naming the transcript once step (i) has removed the
  # registry. Every `_json_str` here sits inside a printf ARGUMENT LIST, where a
  # failure is a swallowed status and an empty argument — `"path":,` — so
  # without this the resume path, which is the one route to the destructive tail
  # that never calls `_pr_py` and so is not already refused by python3 being
  # missing, would delete and then report it in a document that does not parse.
  # Before the lock, so a refusal leaves no lock behind for the next attempt to
  # trip over, and before `_ws_reap_eval`, so it costs no gh call and no fetch.
  _json_str probe >/dev/null 2>&1 \
    || die "python3 unavailable — cannot quote the reap record safely"

  # BEFORE either path, because ccd runs under `set -u` and `_ws_reap_tail`
  # reads REAP_PRNUM and REAP_PROOF unconditionally. On the resume path
  # `_ws_reap_eval` is never called, so without this they are UNBOUND, and the
  # final printf loses those two arguments: it emits {"pr":,"proof":} —
  # syntactically invalid JSON, which the caller reports as a parse error rather
  # than as the successful resume it actually was. (Reproduced in bash: two
  # `unbound variable` lines on stderr and a truncated object on stdout, exit 0.)
  # `_ws_reap_eval` calls this again on the normal path; it is idempotent.
  _ws_reap_reset

  # THE LOCK IS THE KERNEL'S, NOT A TRAP'S — and on this box that is the whole
  # argument. `mkdir` plus `trap … EXIT` was the shipped form, and a trap does
  # not run on SIGKILL: an OOM kill (this project's own speciality), a
  # `systemctl` hard stop, a power loss or a reboot each leave the directory
  # behind, every later `ws-reap` for that session answers `in-progress`, and
  # the RESUME PATH — the entire recovery mechanism — sits one refusal behind
  # it with no verb in ccd able to clear it. Measured, same fixture, only the
  # signal changed: SIGTERM left the lock free and the next run resumed;
  # SIGKILL left it HELD and every later run answered
  # `{"refused":"in-progress"}`, for ever. Step (i)'s `_reg_purge "$id"` does
  # not match this name — it purges `$REG/$id.<field>`, and the lock is
  # `$REG/.reap-$id.lock`, a different prefix entirely — and nothing else in
  # the file does either.
  #
  # `flock` attaches an advisory lock to an OPEN FILE DESCRIPTION, and the
  # kernel drops it when the last copy of that description closes — which every
  # form of death does, including the ones no handler can see. Nothing has to
  # run for the lock to come back. Verified on this box (util-linux 2.39.3,
  # `flock from util-linux 2.39.3`): a second acquirer is refused while the
  # holder lives, and a `kill -9` of the holder frees it for the next acquirer.
  #
  # THE DESCRIPTION IS INHERITED BY CHILDREN, and that is the RIGHT semantics
  # here rather than a leak. Measured: a child of the holder keeps the lock
  # after the holder is SIGKILLed, and it is released when the child exits. The
  # case the old comment worried about — "an orphaned `git worktree remove`
  # grandchild keeps running" after the shell died — is exactly the case in
  # which a second reap must NOT start, and under a trap it was exactly the
  # case in which one could. Nothing in the destructive sequence daemonises
  # (`git worktree remove`, `systemctl --user disable --now`,
  # `tmux kill-session`, `rm -rf` are all short-lived clients), so the interval
  # is bounded by the work itself.
  #
  # THE LOCK FILE IS NEVER UNLINKED. Unlinking it while holding it is how two
  # processes each end up holding "the lock" on two different inodes: the
  # second `open()` after the unlink creates a NEW file, whose lock nobody
  # contends. What is left behind is a 0-byte hidden file per session that has
  # ever been offered to `ws-reap` — inert (the registry is read through
  # `$REG/*.workspace` and `$REG/$id.<field>`, and a dotfile matches neither),
  # and the price of a lock whose identity is an inode rather than a promise.
  # The BREADCRUMB remains the recovery record; this only serialises runs.
  local lock="$REG/.reap-$id.lock" lfd rc=0
  # NOT a degraded mode. Without `flock` the serialisation is absent, not
  # weaker, so the destructive verb does not run — the same shape as the
  # `_json_str` probe above, and the same `die`. Pinned by `refuses to run the
  # destructive verb unserialised when flock is missing`, which shims `command`
  # rather than emptying PATH, because every stub in that file spells its own
  # passthrough `command git`.
  command -v flock >/dev/null 2>&1 \
    || die "flock (util-linux) is unavailable — refusing to run the destructive verb unserialised"
  exec {lfd}>>"$lock" \
    || die "cannot open the reap lock at $lock"
  flock -n "$lfd" || {
    # Close OUR descriptor and touch nothing else: the winner's lock lives on
    # its own description and no path operation here can reach it. (Under the
    # mkdir form the loser's own trap could `rmdir` the winner's lock, which is
    # why that trap had to be armed after the mkdir rather than before it.)
    #
    # MUTATION SURVIVOR, disclosed and measured: this close is removable with
    # the whole suite green, because a refused caller is a caller that is about
    # to exit and the kernel closes it then. It is not the same line as the one
    # after `_ws_reap_locked`, which IS pinned (`gives the lock back when the
    # FUNCTION returns`): that one is on the path where the shell goes on to do
    # other things. This one stays so that "every path gives the descriptor
    # back" is a property of the function rather than of its callers.
    exec {lfd}>&-
    printf '{"refused":"in-progress","detail":%s,"paths":[]}\n' \
      "$(_json_str "another ccd process is already reaping $id and still holds the lock")"
    return 0
  }
  # EVERY return path gives the descriptor back, which is why the body is its
  # own function. `flock` treats two `open()`s of one path in one process as
  # two strangers, so a descriptor left open by one call refuses the NEXT call
  # in the same shell — and ccd is sourced (by `ccd` itself and by its tests),
  # so "the process exits eventually" is not the same statement as "the lock
  # went back".
  _ws_reap_locked "$token" "$id"; rc=$?
  exec {lfd}>&-
  return "$rc"
}

_ws_reap_locked() {   # token id — everything the reap lock serialises
  local token="$1" id="$2"
  local resumed; resumed=$(_reg_get "$id" reaping)
  if [[ -n "$resumed" ]]; then
    # Resume: the tombstone written at (b) is what distinguishes "the user
    # deleted the worktree" from "we did".
    #
    # `--expect` IS NOT CHECKED ON THIS PATH, and that is a decision rather than
    # an oversight, so it is written down here where the path forks. Everywhere
    # else the plan and the spec call the token THE consent boundary — "any
    # drift refuses `state-changed`" — and the argv still requires a shape-valid
    # 64-hex string, so `ws-reap` cannot be spelled without one. What it is not
    # is compared: there is nothing to compare it to. The token is
    # `_ws_reap_eval`'s, built from fourteen facts Phase B and Phase C measured,
    # and on a resume the worktree is usually already gone — Phase B has no tree
    # to read and Phase C would need a gh call an outage could withhold for
    # ever, which is the wedge §5.6 exists to end. `cmd_ws_audit` says the same
    # thing from the other side by refusing to ISSUE a token for
    # `reap-interrupted`: a token nobody can obtain cannot be the boundary.
    #
    # What stands in its place is stricter in the ways that still have facts
    # behind them: the TOMBSTONE is the consent record — it exists only because
    # a token-carrying reap was authorised, and its `tip` is re-validated
    # against the live ref per phase below — and Phase B and Phase D1, the two
    # whose facts can still change in the gap, are re-proven in full. What is
    # accepted is that a SECOND human, holding any 64-hex string, can finish a
    # cleanup a first human authorised. Measured: after a kill at (c),
    # `ws-reap --expect ffff…ff` completed the reap.
    local tombtip; tombtip=$(sed -n 's/.*"tip"[[:space:]]*:[[:space:]]*"\([0-9a-f]*\)".*/\1/p' "$REG/.reaped/$id.json" 2>/dev/null | head -1)
    local branch; branch=$(_reg_get "$id" branch)
    # THE TIP IS REQUIRED ON EVERY PHASE. It is the CAS old-value at (g) and the
    # only proof this journal belongs to this branch, since Phase C is
    # deliberately not re-run here. Empty is the ABSENCE of that proof, never a
    # value: with the branch also gone the two empties compare equal, so the
    # emptiness test cannot be folded into the comparison below.
    if [[ -z "$tombtip" ]]; then
      printf '{"refused":"branch-moved","detail":%s,"paths":[]}\n' \
        "$(_json_str "no tombstone tip for $id — refusing to finish a cleanup whose journal cannot be read")"
      return 0
    fi
    # AND THE COMPARISON IS PER PHASE, because §5.6's "re-validate … THEN
    # continue from the recorded phase" is a contradiction once the phase is
    # `clips`: (g) has ALREADY CAS-deleted the branch by then, so `live` is
    # empty by construction and an unconditional comparison reads "moved" for
    # the one state in which gone is correct — permanently. Measured before it
    # was per phase: a kill at (h) answered `branch-moved` on every later
    # attempt, the clips directory leaked, the registry row survived with no
    # worktree and no branch, and the detail said "nothing was deleted after
    # the worktree" while everything up to and including the branch had been.
    #
    # `clips` is the ONLY phase that skips it, and the default arm re-validates:
    # a breadcrumb holding anything ccd did not write is not a phase this can
    # reason about, so it gets the stricter reading, not the looser one. What
    # protects (g) in the skipped case is (g)'s own compare-and-swap — a branch
    # recreated at another sha after the delete fails that CAS and refuses
    # there.
    case "$resumed" in
      clips) : ;;
      *)
        local live; live=$(git -C "$PROJECTS_ROOT/$(_reg_get "$id" project)" rev-parse --verify "refs/heads/$branch" 2>/dev/null)
        if [[ "$live" != "$tombtip" ]]; then
          printf '{"refused":"branch-moved","detail":%s,"paths":[]}\n' \
            "$(_json_str "the branch moved while cleaning up — nothing was deleted after the worktree")"
          return 0
        fi ;;
    esac

    # ── Phase B, AGAIN, on the resume path ────────────────────────────
    # §5.3 is unconditional: "every guard below is evaluated inside ws-reap, on
    # the box, at the instant of deletion". §5.6 authorises resuming a tail; it
    # does not authorise skipping the guards on the way through it. And the
    # breadcrumb is written at (c), BEFORE `git worktree remove` at (f), so
    # `reaping=worktree` WITH the worktree still on disk is the routine outcome
    # of one SIGTERM inside that window — not an exotic case. Without this
    # block the next reap deletes that worktree unaudited, and a .env written
    # between the two runs is gone with it.
    #
    # Phase C is deliberately NOT re-run: mergedness was proven before the
    # breadcrumb existed and the tombstone records the proof, and re-requiring
    # a gh read would let an outage strand a half-reaped workspace forever.
    # What is re-proven here is Phase B and Phase D1 — the guards whose facts
    # can still have changed in the gap, and the only two the resume can cost
    # anything by skipping.
    local workdir; workdir=$(_reg_get "$id" workdir)
    if [[ -d "$workdir" ]]; then
      # Both reads checked, for the reason spelled out at `_ws_reap_eval`'s Phase
      # B — and here it matters more, because this path has no token to fall back
      # on: nothing downstream compares a fingerprint, so an unreadable tree that
      # counted 0 dirty files and an unreadable ignored set that produced an empty
      # REAP_SENSITIVE would take `git worktree remove` straight through both
      # guards. `local x=$(cmd)` returns local's status, so the read is its own
      # statement.
      # AND STDERR IS CAPTURED, exactly as `_ws_reap_eval`'s Phase B captures
      # it (ccd:2109-2116) and for the same measured reason: a PARTIALLY
      # unreadable tree exits 0 with EMPTY stdout and `warning: could not open
      # directory 'sub/'` on stderr, so the count is 0, `dirty-tree` passes, and
      # the cleanup finishes over work it never saw. Two reads, one rule.
      #
      # TWO MUTATION SURVIVORS, disclosed and each measured whole-suite (44
      # files / 712 tests, exit 0): dropping the `&& [[ -z "$rerr" ]]` conjunct,
      # and restoring `2>/dev/null` so there is no `$rerr` to test. Both leave
      # the suite green, because `_ws_collect_ignored` two statements
      # below reads the same tree under the same rule and refuses
      # `tree-unreadable` first — measured with `chmod 000` on an untracked
      # directory holding uncommitted work: the resume DOES refuse and the work
      # DOES survive, but the refusal comes from the ignored read. This is
      # defence in depth, and it is written out because the ordering it relies
      # on is not a property anyone would preserve on purpose: reorder those two
      # statements, or relax the ignored read, and a partially unreadable tree
      # walks into `git worktree remove`.
      local rdirty rerrf rerr rrc
      rerrf=$(mktemp) || {
        printf '{"refused":"tree-unreadable","detail":%s,"paths":[]}\n' \
          "$(_json_str "could not read the tree at $workdir — refusing to finish the cleanup on a guess")"
        return 0
      }
      rdirty=$(git -C "$workdir" status --porcelain 2>"$rerrf"); rrc=$?
      rerr=$(cat "$rerrf" 2>/dev/null); rm -f "$rerrf"
      { (( rrc == 0 )) && [[ -z "$rerr" ]]; } || {
        printf '{"refused":"tree-unreadable","detail":%s,"paths":[]}\n' \
          "$(_json_str "could not read the tree at $workdir — refusing to finish the cleanup on a guess")"
        return 0
      }
      rdirty=$(printf '%s' "$rdirty" | grep -c . || true)
      if (( rdirty != 0 )); then
        printf '{"refused":"dirty-tree","detail":%s,"paths":[]}\n' \
          "$(_json_str "$rdirty uncommitted or untracked file(s) appeared while the cleanup was interrupted")"
        return 0
      fi
      # MUTATION SURVIVOR, disclosed: the `${REAP_IGNREASON:+ …}` here is
      # removable with the whole suite green — the EVALUATED site's identical
      # interpolation is pinned (by the scan-budget and unreadable-directory
      # fixtures, which both refuse before any breadcrumb exists), and no
      # fixture reaches a failing scan on the RESUME path, which needs a
      # breadcrumb AND a surviving worktree AND an unreadable ignored directory
      # at once. It stays because the two sites describe the same failure and
      # the remedy is the whole reason the reason exists.
      _ws_collect_ignored "$workdir" || {
        printf '{"refused":"tree-unreadable","detail":%s,"paths":[]}\n' \
          "$(_json_str "could not read the ignored set at $workdir${REAP_IGNREASON:+ — $REAP_IGNREASON} — refusing to finish the cleanup on a guess")"
        return 0
      }
      if (( ${#REAP_SENSITIVE[@]} != 0 )); then
        printf '{"refused":"sensitive-ignored","detail":%s,"paths":%s}\n' \
          "$(_json_str "${REAP_SENSITIVE[*]}")" "$(_reap_paths_json)"
        return 0
      fi

      # THE CHILD SET, RE-DERIVED — Task 8's own re-proof, same LADDER
      # POSITION as `_ws_reap_eval`'s descent (last in Phase B: a
      # nested-checkout scan is a whole-tree `find`, the priciest read here,
      # so it runs only once the cheaper dirty-tree and ignored-scan guards
      # above have already passed) and for the identical reason nothing
      # above it can substitute: a registered child (and a stray beside one)
      # is gitignored out of the PARENT's own `git status --porcelain` by
      # fixture convention and by the descent's own comment, so neither the
      # `rdirty` read nor the ignored-scan two rungs up can see one appear,
      # vanish, or turn dirty in the gap a resume crosses.
      #
      # `rcmain` is read fresh rather than carried from the caller: nothing
      # upstream of the resume fork computed it, and `_ws_children` needs
      # it resolved (ccd:2084-2102) exactly as `_ws_reap_eval`'s own descent
      # does at its own copy of this read.
      local rcmain; rcmain="$PROJECTS_ROOT/$(_reg_get "$id" project)"
      local rcnested rcchildren rcstrays
      if ! rcnested=$(_ws_nested_checkouts "$workdir"); then
        printf '{"refused":"tree-unreadable","detail":%s,"paths":[]}\n' \
          "$(_json_str "could not scan for nested checkouts under $workdir${_WS_NESTED_WHY:+ — $_WS_NESTED_WHY} — refusing to finish the cleanup on a guess")"
        return 0
      fi
      rcchildren=$(_ws_children "$rcmain" "$workdir") || {
        printf '{"refused":"tree-unreadable","detail":%s,"paths":[]}\n' \
          "$(_json_str "could not enumerate registered worktrees under $workdir — refusing to finish the cleanup on a guess")"
        return 0
      }
      # The SAME in-bash set difference `_ws_reap_eval`'s descent uses
      # (search: "An IN-BASH set difference, not `comm`") and for the
      # identical reason: a locale-sorted `comm` over two process
      # substitutions can desync on a non-ASCII path and manufacture a
      # false stray, or swallow a real one, with no visible failure either
      # way — the one rung this file allows no fail-open on.
      local -A _rc_childset=(); local _rcline _rcpath
      while IFS= read -r _rcline; do
        [[ -n "$_rcline" ]] || continue
        _rcpath="${_rcline%%$'\t'*}"
        _rc_childset["$_rcpath"]=1
      done <<< "$rcchildren"$'\n'
      rcstrays=""
      while IFS= read -r _rcline; do
        [[ -n "$_rcline" ]] || continue
        [[ -v _rc_childset["$_rcline"] ]] || rcstrays+="$_rcline"$'\n'
      done <<< "$rcnested"$'\n'
      rcstrays="${rcstrays%$'\n'}"

      # The CONSENTED set the tombstone recorded — `_ws_tomb_children` reads
      # `[]` and an absent field alike as "nothing", which is exactly right
      # here: an OLD tombstone (written before Task 8) never promised
      # anything about children, so every live one below reads as new. Its
      # FAILURE is a different fact from either — the document could not be
      # read at all — and fix round 1's finding 2 is exactly that a garbage
      # decode must never silently pass as "nothing was consented" (which
      # would UNDER-refuse a phase-`worktree` resume, where empty-live is
      # the PASS condition) so a parse failure is checked here and refused
      # on its own, before it can be mistaken for a measurement.
      local rcconsented; rcconsented=$(_ws_tomb_children "$REG/.reaped/$id.json") || {
        printf '{"refused":"tree-unreadable","detail":%s,"paths":[]}\n' \
          "$(_json_str "could not read the consented child set from the tombstone for $id — refusing to finish the cleanup on a guess")"
        return 0
      }
      local rcchanged=""
      if [[ "$resumed" == children ]]; then
        # Every live child must still BE the line that was consented,
        # matched on `path<TAB>branch<TAB>head` — never on the record's own
        # trailing `dirty` column, which is always the literal 0
        # `_ws_reap_eval` measured before it ever appended a line to
        # `REAP_CHILDLINES` (a STORED 0 proves nothing about NOW). So dirt
        # is re-read here, live, exactly as Phase B re-reads it for the
        # PARENT a few lines up.
        local -A _rc_consentset=(); local _rcconline _rcprefix
        while IFS= read -r _rcconline; do
          [[ -n "$_rcconline" ]] || continue
          _rcprefix="${_rcconline%$'\t'*}"
          _rc_consentset["$_rcprefix"]=1
        done <<< "$rcconsented"$'\n'
        while IFS= read -r _rcline; do
          [[ -n "$_rcline" ]] || continue
          if [[ -v _rc_consentset["$_rcline"] ]]; then
            local _rccpath="${_rcline%%$'\t'*}"
            # REGISTERED BUT ABSENT = SKIP, NOT tree-unreadable — fix round
            # 1, caveat 4. `_ws_children` lists a child straight out of
            # `git worktree list --porcelain`, which keeps reporting a
            # PRUNABLE record (directory gone, admin metadata still there)
            # long after the directory itself is gone — the exact state a
            # hand-deleted child, or a teardown loop killed between its own
            # `worktree remove` succeeding and the next step, leaves behind,
            # and the teardown loop's own skip-already-gone rung treats it
            # as normal, not as damage. `git -C "$_rccpath" status` on a
            # path that does not exist cannot succeed — it was refusing
            # `tree-unreadable` here, permanently, over a state ccd itself
            # produces routinely. There is nothing to read for dirt when
            # there is nothing on disk, so this reads as clean and moves on;
            # the CONSENT match above already proved this is the same child
            # that was promised, which is the fact this branch exists to
            # check.
            if [[ -d "$_rccpath" ]]; then
              local _rcerrf _rcerr _rcrc _rcdirt
              _rcerrf=$(mktemp) || {
                printf '{"refused":"tree-unreadable","detail":%s,"paths":[]}\n' \
                  "$(_json_str "could not read the child at $_rccpath — refusing to finish the cleanup on a guess")"
                return 0
              }
              _rcdirt=$(git -C "$_rccpath" status --porcelain 2>"$_rcerrf"); _rcrc=$?
              _rcerr=$(cat "$_rcerrf" 2>/dev/null); rm -f "$_rcerrf"
              { (( _rcrc == 0 )) && [[ -z "$_rcerr" ]]; } || {
                printf '{"refused":"tree-unreadable","detail":%s,"paths":[]}\n' \
                  "$(_json_str "could not read the child at $_rccpath — refusing to finish the cleanup on a guess")"
                return 0
              }
              [[ -z "$_rcdirt" ]] || rcchanged+="$_rccpath is dirty now; "
            fi
          else
            rcchanged+="$_rcline is not among the consented children; "
          fi
        done <<< "$rcchildren"$'\n'
        [[ -z "$rcstrays" ]] || rcchanged+="new stray checkout(s): ${rcstrays//$'\n'/, }; "
      else
        # worktree|branch|clips — and any breadcrumb this dispatch has never
        # written, which `_ws_reap_tail`'s own vocabulary check refuses
        # regardless: by any of these phases every consented child was
        # supposed to be torn down already, so the live set here must be
        # EMPTY, full stop.
        [[ -z "$rcchildren" ]] || rcchanged+="${rcchildren//$'\n'/, } still registered; "
        [[ -z "$rcstrays" ]] || rcchanged+="new stray checkout(s): ${rcstrays//$'\n'/, }; "
      fi
      if [[ -n "$rcchanged" ]]; then
        printf '{"refused":"state-changed","detail":%s,"paths":[]}\n' \
          "$(_json_str "the child checkouts changed while the cleanup was interrupted — ${rcchanged%; }")"
        return 0
      fi

      # Phase D1 too, and for the same reason: the breadcrumb is written at (c),
      # BEFORE _ws_unsupervise at (d), so a SIGTERM in that window leaves
      # `reaping=worktree` with the session STILL RUNNING. Without this the
      # resume yanks the worktree out from under a live turn OR a running Bash
      # tool command — `idle` is an allowlist in _ws_status, so `shell` refuses
      # here (deviation 6). The tree is clean and pushed, so no bytes are lost,
      # but §5.3 is unconditional and session-busy is one of its guards.
      local rst; rst=$(_ws_status "$id") || {
        printf '{"refused":"status-unknown","detail":%s,"paths":[]}\n' \
          "$(_json_str "cannot read the wrapper status file — refusing to finish the cleanup on a guess")"
        return 0
      }
      if [[ "$rst" == busy ]]; then
        printf '{"refused":"session-busy","detail":%s,"paths":[]}\n' \
          "$(_json_str "the session is working — a model turn or a Bash tool command — and the cleanup was interrupted before it was stopped")"
        return 0
      fi
    fi

    REAP_TIP="$tombtip"
    _ws_reap_tail "$id" "$resumed"
    return 0
  fi

  if ! _ws_reap_eval "$id"; then
    local paths="[]"
    [[ "$REAP_VERDICT" == sensitive-ignored ]] && paths=$(_reap_paths_json)
    printf '{"refused":%s,"detail":%s,"paths":%s}\n' \
      "$(_json_str "$REAP_VERDICT")" "$(_json_str "$REAP_DETAIL")" "$paths"
    return 0
  fi

  # D2 — the consent IS the fingerprint, and it is checked HERE, in ccd. A
  # server-side check fails open into deletion; this one cannot.
  if [[ "$token" != "$REAP_TOKEN" ]]; then
    printf '{"refused":"state-changed","detail":%s,"paths":[]}\n' \
      "$(_json_str "expected $REAP_TOKEN, was given $token — this workspace changed since the list you were shown")"
    return 0
  fi

  _ws_reap_tail "$id" ""
}

_ws_reap_tail() {   # id resumed-phase — the journalled destructive sequence
  local id="$1" resumed="$2" project workdir branch main attic clips tomb bytes
  project=$(_reg_get "$id" project); workdir=$(_reg_get "$id" workdir); branch=$(_reg_get "$id" branch)
  main="$PROJECTS_ROOT/$project"
  # THE RECEIPT IS A MEASUREMENT TOO — final-round tests review F2. This was
  # `|| bytes=0`, the last of the three identical `_ws_gc_bytes "$workdir"`
  # lines to still fabricate (ccd:1503 archive manifest and ccd:3006 audit were
  # closed in earlier rounds), and it is the one printed AFTER the irreversible
  # delete: `{"reaped":…,"bytes":0}` states "this deletion reclaimed nothing"
  # on a `du` that never completed. On the RESUME path it is 0 EVERY time — the
  # worktree was already removed at (f) of the interrupted run, `_ws_gc_bytes`
  # answers `-` for a path that is not a readable directory, and the run that
  # in fact reclaimed gigabytes reports zero.
  #
  # `ReapResult.bytes` is `number | null | undefined` on the wire and nothing in
  # the PWA reads it today; that is the reason this was harmless, not a reason
  # to leave it. A receipt is the record a human reaches for when they want to
  # know what a delete cost, and it may not answer with a number nobody took.
  bytes=$(_ws_gc_bytes "$workdir"); [[ "$bytes" =~ ^[0-9]+$ ]] || bytes=null

  # A breadcrumb holding anything ccd did not write is not a phase this can
  # reason about, so it gets the stricter reading, not the looser one — the
  # same rule `_ws_reap_locked`'s tip re-validation already states for the same
  # uncertainty. The LOOSE reading used to live below, as
  # `[[ "$resumed" == "" || "$resumed" == worktree ]]`: an unrecognised value is
  # neither `""` nor `worktree`, so it fell to the ELSE of that single test —
  # `git worktree remove` silently skipped — and the run then fell straight
  # through to (g)'s branch delete, (h)'s clips delete and (i)'s registry
  # delete, and reported `{"reaped":...}`. Measured: a breadcrumb of
  # `reaping=sometime-else` with the worktree still on disk finished with
  # `wt-exists true`, the branch gone, and the registry gone — an orphaned
  # worktree, still registered with git, standing next to a deleted branch,
  # on a run that claimed success. Checked BEFORE any of (f)/(g)/(h)/(i).
  #
  # `children` joins the vocabulary here (Task 8): it is the phase written
  # BEFORE any registered child falls, exactly as `worktree` is written
  # before the PARENT falls, and it is closed the same way — a value this
  # dispatch has never written is still refused, never guessed at.
  case "$resumed" in
    ""|children|worktree|branch|clips) : ;;
    *)
      printf '{"refused":"reaping-phase-unknown","detail":%s,"paths":[]}\n' \
        "$(_json_str "breadcrumb phase '$resumed' for $id is not one ccd ever writes — refusing to guess which steps already ran")"
      return 0 ;;
  esac

  # THE ARCHIVED MARKER IS RE-READ HERE, immediately before the first step that
  # writes anything — final-round destructive review, finding F5. `archived` is
  # the ONE precondition of this whole verb that another ccd verb can withdraw:
  # `cmd_ws_restore` (ccd:1234) removes `$REG/$id.archived`, re-`_spawn`s the
  # session and re-`_ws_supervise`s it, turning the workspace back into an
  # ordinary live one. Nothing re-read the marker after `_ws_reap_eval`'s Phase
  # A (ccd:2055), and it is not one of `_ws_fingerprint`'s fourteen inputs, so
  # the token cannot notice either.
  #
  # TWO REACHABLE SHAPES, both measured, and the sequential one is the one with
  # the teeth:
  #   - THE RESUME PATH, no race at all. A reap SIGKILLed at (c) leaves a
  #     breadcrumb the human can only clear by restoring; restore then brings
  #     the workspace back to life, and the breadcrumb OUTLIVES it. The next
  #     `ws-reap` takes `_ws_reap_locked`'s resume fork, which skips
  #     `_ws_reap_eval` entirely and therefore never asks the `not-archived`
  #     question at all. Measured before this line existed:
  #     `{"reaped":"demo-quiet-basin",…,"resumed":"worktree"}` — worktree
  #     removed, branch CAS-deleted, registry purged, on a LIVE restored
  #     workspace, hours after the tap that authorised it.
  #   - THE EVALUATED PATH, a real race. Phase A checks the marker, Phase C
  #     then spends up to 12 s in `gh pr list` and up to 60 s in `git fetch`; a
  #     restore inside that window is a lost update seconds to a minute wide,
  #     and D2 waves the token through because the token was computed in this
  #     same run. `cmd_ws_restore` now takes THIS verb's own lock, which closes
  #     the race at its source; this stays because a re-read costs one `stat`
  #     and covers the resume shape too, which no lock can.
  #
  # `not-archived` rather than a new token: the state IS not-archived, it is the
  # word `_ws_reap_eval` already uses for it (ccd:2056), and `wsaudit.ts`'s
  # SENTENCES already carries the sentence. Placed ahead of (a)/(b)/(c) so a
  # refusal writes NOTHING — no attic pin, no tombstone, no breadcrumb.
  #
  # THE DETAIL NAMES THE STATE, NOT A CULPRIT — final-round verification P4.
  # It used to assert "ws-restore brought it back while this cleanup was
  # pending", which is one cause of a missing marker and was, until `_reg_purge`
  # was reordered in the same round, not the only one: a kill inside the purge
  # unlinked `archived` before `reaping` and produced this refusal with a
  # diagnosis naming a verb that had never run. The observable fact is that the
  # marker is gone; who removed it is an inference, and an inference is not what
  # belongs in the one line an operator acts on.
  [[ -f "$REG/$id.archived" ]] || {
    printf '{"refused":"not-archived","detail":%s,"paths":[]}\n' \
      "$(_json_str "$id is no longer archived — the archive marker is gone (ws-restore removes it), so this cleanup will not continue; archive it again to finish")"
    return 0
  }

  # `|| clips=null` ON BOTH ARMS — the sixteenth forgery's third consumer, and
  # the one that gets a RECORD rather than a refusal (`_ws_clip_manifest` sets
  # out why in full). The tombstone outlives the workspace: `[]` in it is the
  # permanent, unfalsifiable statement "this cleanup destroyed no pasted
  # images", written about a directory ccd could not open, and it is the only
  # document left once the branch, the reflog and the registry are gone. `null`
  # is the fact — nobody enumerated it — and `WsTombstone.clips` is typed
  # `… [] | null` to keep it representable.
  #
  # NOT a refusal, unlike the other two consumers, and the difference is the
  # same one `_ws_collect_ignored`'s own comment draws: this arm runs on the
  # RESUME, where the worktree may already be gone and a refusal converts one
  # unreadable directory into a workspace stranded half-deleted forever. The
  # record can still be made truthful, so it is made truthful and the cleanup
  # finishes. (The evaluated arm cannot reach it except through the same
  # microsecond window `cmd_ws_audit`'s verdict covers — Phase D2 recomputed
  # the digest moments earlier and would have refused `clips-unreadable` — and
  # it is written the same way there so the two arms cannot drift into
  # describing one directory two ways.)
  if [[ -z "$resumed" ]]; then
    attic=$(_ws_attic_pin "$main" "$id" "$workdir" "$REAP_TIP")            # (a)
    clips=$(_ws_clip_manifest "$id") || clips=null
    tomb=$(_ws_tombstone "$id" "$clips")                                   # (b)
    _reg_set "$id" reaping children                                        # (c)
  else
    # (d) AND (e) ARE NOT RE-RUN ON A RESUME, which is safe only because of
    # what stands in front of this path — moved down beside the block that
    # actually runs them (below the children phase now, not above it), but
    # the reason is unchanged: `_ws_reap_eval` refuses `not-archived` unless
    # `$REG/$id.archived` exists, and `cmd_ws_archive` (ccd:1063-1064) is what
    # writes it — after `_ws_unsupervise` and after `tmux kill-session`. So by
    # the time any breadcrumb can exist the unit is disabled and the pane is
    # gone, and re-running either would be a second call to an idempotent
    # no-op. Measured: a resumed reap completes with `unsup=0`. What it does NOT
    # cover is something re-supervising the session between the archive and the
    # reap; the resume's own Phase D1 re-proof refuses `session-busy` if that
    # something is actually working, which is the part that could cost bytes.
    tomb="$REG/.reaped/$id.json"
    attic=$(git -C "$main" for-each-ref --format='%(refname)' "refs/ccrc/attic/$id/" 2>/dev/null | grep -c . || true)
    # Pre-merge fix round, finding E: re-measure clips NOW, on the resume,
    # not whatever `_ws_clip_manifest` answered at the ORIGINAL (b) — this
    # run's (h), a few lines below, `rm -rf`s whatever is on disk at THIS
    # instant, and a clip pasted in the gap must not be destroyed with no
    # record of it anywhere. Before (h), same as everywhere else in this
    # function guards run immediately before the step they guard.
    clips=$(_ws_clip_manifest "$id") || clips=null
    _ws_tombstone_reclip "$id" "$clips" || {
      printf '{"refused":"tombstone-unwritable","detail":%s,"paths":[]}\n' \
        "$(_json_str "could not update the tombstone's clips record for $id — refusing to finish the cleanup without an accurate record")"
      return 0
    }
  fi

  # (c2) THE CHILDREN PHASE — Task 8. Runs on the FRESH path, right after the
  # breadcrumb above first names it, and on a RESUME whose breadcrumb is
  # STILL `children` — finishing the SAME consented set a killed run left
  # partly torn down, never starting a new one. The two origins for
  # `childlines` are deliberate: fresh reads `REAP_CHILDLINES`, THIS SAME
  # PROCESS's own descent (`_ws_reap_eval` populated it moments earlier, in
  # the very call that is still running); resume reads the tombstone's
  # `children` array instead, because the resume path never calls
  # `_ws_reap_eval` at all and `REAP_CHILDLINES` stays the empty string
  # `_ws_reap_reset` gave it. `_ws_reap_locked`'s own re-derivation, just
  # before this function was ever called, has already proved that recorded
  # set still matches what is live — this loop trusts that and acts.
  if [[ "$resumed" == "" || "$resumed" == children ]]; then
    local childlines
    if [[ -z "$resumed" ]]; then
      childlines="$REAP_CHILDLINES"
    else
      childlines=$(_ws_tomb_children "$tomb") || {
        printf '{"refused":"tree-unreadable","detail":%s,"paths":[]}\n' \
          "$(_json_str "could not read the consented child set from the tombstone for $id — refusing to finish the cleanup on a guess")"
        return 0
      }
    fi
    # INNERMOST FIRST — `awk`'s injected length key, sorted numerically
    # descending, `cut` drops the key back off. Order is not a nicety here:
    # measured in a scratch fixture, `git worktree remove` on a worktree
    # that still physically contains ANOTHER registered worktree does NOT
    # refuse. With the nested path gitignored — exactly as it must be for
    # the PARENT (and, one level down, for a CHILD with a grandchild of its
    # own) to stay clean at all — git treats the nested checkout as ordinary
    # ignored content and deletes the whole subtree outright, silently, past
    # even a `git worktree lock` on the nested one (a lock is checked only
    # when THAT path is itself the target, never when an ancestor directory
    # happens to contain it). So this order is not git enforcing anything
    # for us; it is the only order in which each child's OWN
    # `worktree remove` is what actually removes it.
    # FIX ROUND 1, FINDING 1a: the pipeline's own status, checked — it was
    # not, despite `set -o pipefail` (ccd:4) already making it MEAN
    # something. `awk`/`sort`/`cut` failing here is unmeasured but not
    # unimaginable (a scratch-space exhaustion mid-sort, say), and a failed
    # sort silently reads as an EMPTY `sorted`, which is indistinguishable
    # from "no consented children" — the loop below would then walk past
    # every one of them, unremoved, straight to the post-loop check. `LC_ALL=C`
    # on the sort itself — house rule consistency with every other
    # LC_ALL=C sort in this file (`_ws_nested_checkouts`, `_ws_children`):
    # an ambient locale must not change which child a numeric tie resolves
    # to first.
    local sorted
    sorted=$(printf '%s' "$childlines" | awk '{print length($1) "\t" $0}' | LC_ALL=C sort -rn | cut -f2-) || {
      printf '{"refused":"tree-unreadable","detail":%s,"paths":[]}\n' \
        "$(_json_str "could not order the consented child set for $id — refusing to finish the cleanup on a guess")"
      return 0
    }
    local mainreal; mainreal=$(_ws_common_dir "$main") || mainreal=""
    # RESOLVED, not the raw registry string — `ccpath` (both origins: fresh
    # `REAP_CHILDLINES` and the tombstone that recorded it) is always a
    # `pwd -P` result (`_ws_children`'s own containment test resolves its
    # `$workdir` argument the identical way before comparing), and
    # `$workdir` itself is not guaranteed to already be one: this file's own
    # header notes `$HOME/projects -> /data/projects` is a SYMLINK in
    # production. Comparing a resolved path against an unresolved one is
    # the exact class of bug a symlinked ancestor manufactures elsewhere in
    # this file (search: "symlinked ancestor cannot make a registered child
    # misread"), and the fallback to the raw value on a failed resolve
    # keeps this a containment CHECK, never a silent pass.
    local workdirreal; workdirreal=$(cd "$workdir" >/dev/null 2>&1 && pwd -P) || workdirreal="$workdir"
    local cline crest crest2 ccpath ccbr cchead
    while IFS= read -r cline; do
      [[ -n "$cline" ]] || continue
      # Parameter expansion, NOT `IFS=$'\t' read`, for the identical measured
      # reason `_ws_reap_eval`'s own descent states in full (search: "IFS=
      # read -r childline"): tab is IFS whitespace even when it is the only
      # character in IFS, so a detached child's empty branch column would
      # silently shift every later field left under the IFS form. The
      # trailing `dirty` column is still not read — Phase B/D2 already
      # proved it 0 at consent time — but `cchead` now is, for the
      # mergeability probe below.
      ccpath="${cline%%$'\t'*}"
      crest="${cline#*$'\t'}"
      ccbr="${crest%%$'\t'*}"
      crest2="${crest#*$'\t'}"
      cchead="${crest2%%$'\t'*}"

      # CONTAINMENT, RE-DERIVED — fix round 1, caveat 8. On a resume,
      # `ccpath` is read off the TOMBSTONE, a file on disk, not measured
      # live off `$workdir` the way the fresh path's `REAP_CHILDLINES` was
      # — so this is the same "re-derive, never trust" instinct every other
      # rung on this ladder states for itself, applied to the one value
      # here that a resume takes from a RECORD rather than a live read.
      [[ "$ccpath" == "$workdirreal"/* ]] || {
        printf '{"refused":"worktree-remove-failed","detail":%s,"paths":[]}\n' \
          "$(_json_str "$ccpath is not under $workdir — refusing to act on a consented child line outside the workspace")"
        return 0
      }

      # THE EXACT PREDICATE `branch -d` APPLIES, PROVEN BEFORE ANYTHING IS
      # REMOVED — fix round 1, finding 3. Consent measured this child as 0
      # commits ahead of `origin/HEAD` (`_ws_reap_eval`'s own descent,
      # `cahead` against `$cbase=origin/HEAD`), but `branch -d` does not
      # check against `origin/HEAD` at all: these children carry no
      # upstream (`git worktree add -b` configures none), so `branch -d`'s
      # own "fully merged" rule falls back to `$main`'s CURRENT LOCAL HEAD.
      # Phase C's mandatory fetch — run once per reap, to prove the
      # PARENT's own merge — advances the remote-tracking `origin/HEAD`
      # without touching `$main`'s local branch at all, so a child proven
      # merged into an origin that has since moved ahead of `$main`'s local
      # checkout can fail this SAME check `branch -d` is about to make.
      # `merge-base --is-ancestor` is the plumbing `branch -d` itself
      # answers this with; probing it BEFORE `worktree remove` turns a
      # would-be half-torn-down child (worktree gone, branch alive, every
      # later resume repeating the same failed `branch -d`) into a
      # refusal that touches nothing at all. Skipped when the branch is
      # already gone — nothing left to probe reachability OF.
      local cbrexists=0
      if git -C "$main" rev-parse --verify --quiet "refs/heads/$ccbr" >/dev/null 2>&1; then
        cbrexists=1
        if ! git -C "$main" merge-base --is-ancestor "$cchead" HEAD 2>/dev/null; then
          printf '{"refused":"worktree-remove-failed","detail":%s,"paths":[]}\n' \
            "$(_json_str "$ccpath ($ccbr, $cchead) is not reachable from $main's current HEAD — origin has moved ahead of $main locally; pull $main (git -C $main pull) and retry")"
          return 0
        fi
      fi

      # STILL REGISTERED? — the skip-already-gone rung. A consented child
      # THIS SAME breadcrumb already finished (worktree AND branch both
      # gone) on a killed prior attempt is absent from `worktree list`
      # entirely; re-running `worktree remove` on it fails outright
      # (measured: rc 128, "fatal: '<path>' is not a working tree" — unlike
      # a MANUALLY deleted directory that is still registered, which
      # `worktree remove` cleans up gracefully, rc 0, same as `prune`
      # would). Registration, not directory existence, is the right
      # question: a directory that is merely gone but still registered
      # still needs this call to retire the record.
      if git -C "$main" worktree list --porcelain 2>/dev/null | grep -qxF "worktree $ccpath"; then
        if [[ -d "$ccpath" ]]; then
          # OWNERSHIP, reproven live, one more time — the same pair
          # `_ws_reap_eval`'s own descent uses (search: "TWO checks,
          # AND-combined") for the identical TOCTOU: a foreign clone dropped
          # at this exact path, or this child's own `.git` deleted so
          # upward discovery quietly resolves it to `$workdir` instead, both
          # read as healthy to a common-dir-only check. Skipped when the
          # directory itself is already gone — there is nothing left to
          # read ownership FROM, and the registration check above is
          # already the fact this rung would otherwise re-derive.
          local ccommon cctop
          ccommon=$(_ws_common_dir "$ccpath") || ccommon=""
          cctop=$(git -C "$ccpath" rev-parse --path-format=absolute --show-toplevel 2>/dev/null) || cctop=""
          if [[ -z "$ccommon" || "$ccommon" != "$mainreal" || -z "$cctop" || "$cctop" != "$ccpath" ]]; then
            printf '{"refused":"state-changed","detail":%s,"paths":[]}\n' \
              "$(_json_str "the checkout at $ccpath is not $main's worktree any more — this workspace changed since it was consented")"
            return 0
          fi
        fi
        local cwtout cwtrc
        cwtout=$(git -C "$main" worktree remove "$ccpath" 2>&1); cwtrc=$?
        if (( cwtrc != 0 )); then
          printf '{"refused":"worktree-remove-failed","detail":%s,"paths":[]}\n' \
            "$(_json_str "$ccpath: $(printf '%s' "$cwtout" | head -3)")"
          return 0
        fi
      fi

      # PLAIN -d, never -D and never --force — the same global rule (g)
      # below states for the PARENT's own branch. `cbrexists`, not another
      # `rev-parse --verify` here: the mergeability probe above already
      # asked and answered this exact question moments ago, in the same
      # iteration, and a branch THIS SAME breadcrumb already deleted on a
      # killed prior attempt is legitimately absent — which is not this
      # child having changed, it is this child already being DONE.
      if (( cbrexists )); then
        local cbrout cbrrc
        cbrout=$(git -C "$main" branch -d "$ccbr" 2>&1); cbrrc=$?
        if (( cbrrc != 0 )); then
          printf '{"refused":"worktree-remove-failed","detail":%s,"paths":[]}\n' \
            "$(_json_str "$ccbr: $(printf '%s' "$cbrout" | head -3)")"
          return 0
        fi
      fi
    done <<< "$sorted"$'\n'

    # FIX ROUND 1, FINDING 1b: THE BREADCRUMB ADVANCES ONLY ON A PROVEN
    # EMPTY SET, never unconditionally. Three reads inside the loop above
    # can fail SILENTLY into "nothing to do" rather than a refusal — the
    # sort pipeline is now checked (1a, above), but `worktree list
    # 2>/dev/null` failing reads as "not registered" (the correct polarity
    # for a genuine prunable record, and indistinguishable from a transient
    # git failure from inside the loop), and this function's own resume
    # arm cannot itself tell an incomplete `_ws_tomb_children` read (now
    # refused explicitly, above) from a complete one describing a smaller
    # set than reality. Any of those would let a child that was NOT
    # actually torn down slip past this loop unremoved — and
    # `_ws_reap_locked`'s own re-derivation treats an EMPTY live set as the
    # PASS condition for every phase after `children`, so a breadcrumb
    # advanced on a guess here would wedge that later resume forever, the
    # exact recoverability defect this whole fix round exists to close. So
    # the advance re-derives and checks, one more time, live, exactly what
    # it is about to promise.
    local postchildren
    postchildren=$(_ws_children "$main" "$workdir") || {
      printf '{"refused":"tree-unreadable","detail":%s,"paths":[]}\n' \
        "$(_json_str "could not verify the children were fully torn down under $workdir — refusing to finish the cleanup on a guess")"
      return 0
    }
    if [[ -n "$postchildren" ]]; then
      printf '{"refused":"worktree-remove-failed","detail":%s,"paths":[]}\n' \
        "$(_json_str "child checkout(s) still registered under $workdir after the teardown loop: ${postchildren//$'\n'/, } — refusing to advance past the children phase")"
      return 0
    fi
    _reg_set "$id" reaping worktree
  fi

  # (d) AND (e), FRESH ONLY — see the comment beside the resume arm above for
  # why a resume never re-runs either. Relocated here, after the children
  # phase rather than before it, so a child stopped mid-teardown by a locked
  # or dirty checkout below is stopped BEFORE the session's own unit is
  # disabled and its pane killed — the ORIGINAL ordering's own guarantee
  # (nothing destroyed ahead of (d)/(e)) now covers the children phase too,
  # not only the parent's.
  if [[ -z "$resumed" ]]; then
    _ws_unsupervise "$id"                                                  # (d)
    tmux kill-session -t "$(_tmux "$id")" 2>/dev/null || true              # (e)
  fi

  # THE STEP-(f) DISJUNCTION, RULE: this step runs whenever the run has
  # EITHER just finished the children phase in THIS invocation (fresh, or a
  # resume that started at `children` and fell through the block above) OR
  # is a resume that starts here directly (`worktree`) — i.e., whenever
  # `reaping` is about to read (or already reads) `worktree` at the instant
  # this line is reached. `branch` and `clips` never re-enter here: by
  # either of those phases the parent's own worktree is already gone, and
  # re-attempting `git worktree remove` on a directory that no longer exists
  # is exactly the `-d "$workdir"` guard below that skips it — the
  # disjunction stays narrow instead of relying on that guard alone so an
  # unrecognised phase (already refused above, in the vocabulary check) can
  # never reach this far by accident.
  if [[ "$resumed" == "" || "$resumed" == children || "$resumed" == worktree ]]; then
    if [[ -d "$workdir" ]]; then
      # No --force. On failure STOP: the session is already stopped and
      # ws-restore recovers it, whereas losing the registry would not be
      # recoverable.
      #
      # THE TAIL BACKSTOP — the audit's `_ws_reap_eval` rung above proves no
      # nested checkout existed at CONSENT time, and this is the box-side
      # instant of deletion §5.3 requires re-proving guards at: `_ws_unsupervise`
      # (d) and `tmux kill-session` (e) already ran, above, before this line is
      # reached, and either is an arbitrary external command in a live
      # deployment (a supervisor hook, a tmux hook) — nothing in this file's
      # contract says one cannot `git init` a checkout under $workdir on its way
      # out. Fail-shut on an unscannable tree, the same polarity as every other
      # guard on this ladder: an answer this cannot prove clean is not "go
      # ahead", it is `(unscannable: …)`, which is non-empty and refuses below.
      #
      # UNNARROWED by Task 8's own children phase, on purpose, and this is
      # the place to say why rather than leave the reader to wonder: by the
      # time this line runs, the children phase above has already torn down
      # every CONSENTED child — that is the whole point of running it FIRST,
      # ahead of (d)/(e) and ahead of this backstop. Any nested `.git` this
      # scan can still find is therefore never a healthy registered child;
      # it is either a stray that appeared after consent (the same class D1
      # has always refused) or a child whose own removal FAILED, in which
      # case the run already returned a `worktree-remove-failed` refusal
      # from inside that loop and never reached this line at all. Both
      # outcomes are refusals, so the blanket rule — refuse on ANY nested
      # `.git`, no exception for a registered one — needed no change at all.
      # What changed is placement: teardown now runs BEFORE this backstop
      # rather than never running.
      local nested
      if ! nested=$(_ws_nested_checkouts "$workdir"); then nested="(unscannable: ${_WS_NESTED_WHY})"; fi
      if [[ -n "$nested" ]]; then
        printf '{"refused":"nested-checkouts-present","detail":%s,"paths":[]}\n' \
          "$(_json_str "nested checkouts under $workdir: ${nested//$'\n'/, } — remove or finish them, then re-run ws-reap")"
        return 0
      fi

      # ONE invocation, with its stderr captured. Re-running the command just
      # to read its message can SUCCEED the second time — a lock released, a
      # file closed — and then this prints a refusal while the worktree is
      # actually gone and the breadcrumb still says `worktree`, which is a lie
      # in the one direction that matters.
      local wtout wtrc
      wtout=$(git -C "$main" worktree remove "$workdir" 2>&1); wtrc=$?
      if (( wtrc != 0 )); then
        printf '{"refused":"worktree-remove-failed","detail":%s,"paths":[]}\n' \
          "$(_json_str "$(printf '%s' "$wtout" | head -3)")"
        return 0
      fi
    fi
    _reg_set "$id" reaping branch
  fi

  # (g) Compare-and-swap, never `branch -d` (it refuses a squash merge and
  # succeeds when the branch merely equals its upstream) and never `-D`.
  #
  # The old-value operand is the whole mechanism, and it has TWO degenerate
  # values worth knowing about even though nothing here can reach either.
  # Measured on git 2.43: `update-ref -d <ref> 000…0` (40 zeros) and
  # `update-ref -d <ref> ""` BOTH delete unconditionally and exit 0, because git
  # reads each as "no old value given" rather than as a value to match — while
  # any other wrong sha exits 1 with `is at X but expected Y` and leaves the ref
  # alone. `$REAP_TIP` can be neither on either path: the evaluated one reads it
  # from `rev-parse --verify`, and the resume one takes it from the tombstone
  # only after `[[ -z "$tombtip" ]]` and an equality against a `rev-parse
  # --verify` of the live ref, which never answers zeros (an unresolvable ref
  # answers EMPTY, and empty != 000…0 refuses `branch-moved` above). Written
  # down because that is an argument about two other call sites, not about this
  # line, and the day either of them stops resolving the tip this degrades from
  # a compare-and-swap into an unconditional delete without failing anything.
  # The empty case is not hypothetical: deleting `REAP_TIP="$tombtip"` on the
  # resume path produced exactly it, and the suite stayed green until
  # `resumes against the tombstone tip, so the CAS is still a CAS` existed.
  #
  # THE `show-ref` GATE IS PINNED IN BOTH DIRECTIONS, which took two fixtures
  # and is worth saying because one of them nearly was not written. `if false`
  # is killed by every test that reaps a live branch. `if true` — the SKIP
  # direction — survived the whole suite until `resumes from a clips
  # breadcrumb`: on that path the branch is already gone, so without the gate
  # `update-ref -d` runs against a ref that does not resolve, git exits 1, and
  # the run refuses `branch-moved` and leaves the registry row behind, which is
  # the F2 wedge manufactured on a path that would otherwise finish.
  if git -C "$main" show-ref --verify --quiet "refs/heads/$branch"; then
    git -C "$main" update-ref -d "refs/heads/$branch" "$REAP_TIP" 2>/dev/null || {
      printf '{"refused":"branch-moved","detail":%s,"paths":[]}\n' \
        "$(_json_str "the branch moved while cleaning up — nothing was deleted after the worktree")"
      return 0
    }
  fi
  _reg_set "$id" reaping clips

  # (h) Re-validate the id and assert the resolved path is a DIRECT CHILD of
  # ~/.cc-clips before any rm -rf.
  if [[ "$id" =~ ^[A-Za-z0-9._-]+$ ]]; then
    # `>/dev/null` on every cd, and `--` before every operand: the house rule
    # ccrc/ws-rm-fix established at _ws_realpath and _ws_common_dir. Only `pwd -P`
    # may answer. Without the redirect a `cd` exported as a shell function
    # prepends its own print to $cdir (two cds, two lines) and to $croot (one cd,
    # one line), so the equality below fails and the clips directory silently
    # survives every reap. Without `--`, the regex above admits a leading hyphen,
    # so an id like `-P` would be read as cd's own option. Both failures are
    # fail-CLOSED — no rm runs — which is the right direction and still wrong.
    #
    # TWO MUTATION SURVIVORS, disclosed, and they are the two guards standing in
    # front of the only `rm -rf` in this file — so it is worth saying exactly why
    # neither can be reached rather than leaving that to be assumed. `cmd_ws_reap`
    # validated `$id` against this same regex at entry, so re-testing it here can
    # never change the answer; and for any id that PASSES the regex the child
    # assertion holds by arithmetic. The interesting case is `..`, which the
    # regex admits (`.` and `-` are both in the class) and which resolves to
    # $HOME, one level ABOVE the root — and the equality is what refuses it. It
    # is unreachable only because `_ws_reap_eval` refuses `..` far earlier, for
    # want of a `$REG/...uuid`. Both stay: a re-validation immediately before an
    # `rm -rf` is not redundancy, it is the last thing that runs before it.
    local cdir; cdir=$(cd -- "$HOME/.cc-clips" >/dev/null 2>&1 && cd -- "./$id" >/dev/null 2>&1 && pwd -P) || cdir=""
    local croot; croot=$(cd -- "$HOME/.cc-clips" >/dev/null 2>&1 && pwd -P) || croot=""
    [[ -n "$cdir" && -n "$croot" && "$cdir" == "$croot/$id" ]] && rm -rf "$cdir"
  fi

  _reg_purge "$id"                                                         # (i) LAST, finding F3
  # MUTATION SURVIVOR, disclosed: `${attic:-0}` is removable with the suite
  # green, because both arms above assign `attic` and neither can leave it
  # unset. It is `set -u` insurance on the ONE printf that reports a completed
  # deletion — an unbound variable here kills the process after the work is
  # done and before anything says so, which is the failure mode this whole
  # function is arranged to avoid.
  printf '{"reaped":%s,"branch":%s,"pr":%s,"proof":%s,"tombstone":%s,"attic":%s,"bytes":%s,"resumed":%s}\n' \
    "$(_json_str "$id")" "$(_json_str "$branch")" \
    "$( [[ "$REAP_PRNUM" =~ ^[0-9]+$ ]] && echo "$REAP_PRNUM" || echo null)" \
    "$(_json_str "$REAP_PROOF")" "$(_json_str "$tomb")" "${attic:-0}" "$bytes" \
    "$( [[ -n "$resumed" ]] && _json_str "$resumed" || echo null)"
}

# ── reclamation ────────────────────────────────────────────────────
# ws-gc REPORTS by default and acts only under --prune. 29G of abandoned agent
# worktrees accumulated on this box over six weeks because no command existed
# that would have said so; the visibility is the point.

_ws_gc_bytes() {   # path -> size in bytes, or '-' when it could not be FULLY measured
  # Pre-merge fix round, finding F — the NINTH instance of the
  # measurement-forgery class (deviation 10: "a number is a measurement").
  # `du` on a tree with an unreadable subdirectory does not fail the way the
  # old regex-only check assumed: it prints the PARTIAL total it could sum on
  # stdout, a "cannot read directory" line on stderr, and exits non-zero — so a
  # 100 kB readable + 900 kB unreadable tree answered "102400", a real number
  # ten times smaller than the truth, and `[[ "$b" =~ ^[0-9]+$ ]]` passed. A
  # fully unreadable root is no safer: `du` still prints "0" rather than
  # nothing. Measured both shapes with a real `chmod 000` subdirectory, no
  # stub — `du() { return 1; }` (the technique this file used before this fix)
  # does not resemble either one.
  #
  # `b=$(du -sb "$1" 2>"$errf" | cut -f1); rc=$?` is two statements, not
  # `local b=$(…)`, for the reason CONSTRAINTS.md states file-wide: `local`'s
  # own status would overwrite the pipeline's. `set -o pipefail` (ccd:4) is
  # what then makes `rc` mean `du`'s exit code rather than `cut`'s: `cut`
  # always succeeds on whatever `du` handed it, so without pipefail this read
  # would need `${PIPESTATUS[0]}`, captured before anything else touches it.
  #
  # THREE MUTATION SURVIVORS, disclosed together because they are one
  # reason: on THIS box, with real GNU `du`, every failure this function can
  # observe sets a non-zero exit code AND writes to stderr AND leaves `$b`
  # non-numeric (empty, on the `mktemp`-armoured path) at once, so any ONE of
  # the three conjuncts already refuses alone and the suite stays green with
  # either of the other two deleted. Kept as defence in depth, the same
  # judgement `_ws_reap_locked`'s resume-path tree check makes for the
  # identical shape (ccd:2964-2976, "Two reads, one rule"): a future
  # coreutils that keeps `du`'s exit 0 on a partial read, or that starts
  # emitting a non-numeric total, is exactly the case this line exists for,
  # and it is untestable without a `du` that does not exist yet.
  #   - `(( rc == 0 )) &&` — measured: deleting it still refuses on `$err`
  #     being non-empty for every fixture in this suite.
  #   - `[[ -z "$err" ]] &&` — measured: deleting it still refuses on `rc`
  #     being non-zero for every fixture in this suite.
  #   - `[[ "$b" =~ ^[0-9]+$ ]]` — measured: every real `du` failure this
  #     function can construct already trips one of the other two first.
  # A FOURTH, of the same shape as `_ws_collect_ignored`'s `outf=$(mktemp) ||
  # return 1` (ccd:1825): `mktemp` failing needs a full filesystem or a
  # missing `/tmp`, neither of which any fixture here can arrange, so
  # `errf=$(mktemp) || …` is unpinnable for the same reason and stays for the
  # same one — a value this function cannot get right must refuse rather than
  # guess, and "cannot even allocate the scratch file" is exactly that case.
  [[ -d "$1" ]] || { echo '-'; return 0; }
  local errf b rc err
  errf=$(mktemp) || { echo '-'; return 0; }
  b=$(du -sb "$1" 2>"$errf" | cut -f1); rc=$?
  err=$(cat "$errf" 2>/dev/null); rm -f "$errf"
  if (( rc == 0 )) && [[ -z "$err" ]] && [[ "$b" =~ ^[0-9]+$ ]]; then echo "$b"; else echo '-'; fi
}

_ws_gc_age() {     # path -> whole days since its mtime, or '-'
  [[ -d "$1" ]] || { echo '-'; return 0; }
  local m; m=$(stat -c %Y "$1" 2>/dev/null) || { echo '-'; return 0; }
  [[ "$m" =~ ^[0-9]+$ ]] || { echo '-'; return 0; }
  echo $(( ( $(date +%s) - m ) / 86400 ))
}

_ws_gc_human() {   # bytes -> human, or '-' unchanged
  [[ "$1" =~ ^[0-9]+$ ]] || { echo '-'; return 0; }
  numfmt --to=iec "$1" 2>/dev/null || echo "$1"
}

# ── the pruning report's one writer ────────────────────────────────
# Every row of `ws-gc --prune`'s report goes through here, and nothing else may
# write one. Two jobs, and they are the two halves of final-round verification
# P1 (see `_ws_gc_reclaimable`):
#
#   1. ONE ROW PER CALL. `_ws_line_safe` replaces every C0 control character —
#      NEWLINE first among them, but also CR and TAB, which move a cursor about
#      a column-aligned report just as effectively — with `?`, the substitution
#      `ls` has made conventional for a byte a terminal must not be handed. The
#      strings this report prints include gitignored FILENAMES, which are
#      chosen by whatever wrote them and are read NUL-separated everywhere else
#      in this file for exactly that reason.
#   2. THE TALLY IS A COUNT OF ACTIONS. `GC_RECLAIMED`/`GC_DECLINED` are
#      incremented HERE, where the action is announced, so the footer is
#      arithmetic over events and not `grep -c` over rendered text.
#
# WHICH HALF IS PINNED, measured rather than assumed. Mutant A (`_ws_line_safe`
# made a passthrough) is KILLED by `a gitignored filename holding a NEWLINE
# cannot forge a row or move the tally`: three `  reclaimed ` rows where two
# were written — and the footer still read 2, which is the counters doing their
# job with the sanitiser gone. Mutant B (the counters kept but the footer put
# back on `grep -c` over the captured text) SURVIVES, and is DISCLOSED here
# rather than chased with a fixture, because with (1) in force no input can
# distinguish the two. The proof is an enumeration of what the pruning section
# can print: every row is `_gc_row`'s `printf '  %-10s %s\n'` over a LABEL that
# is a literal in this file and a payload with no control bytes in it, so the
# label alone decides the prefix and one call is one line; the only other
# writers are this function's own `echo`s of fixed strings and the stdout of
# `git worktree prune` / `git worktree remove` / `_reg_purge`, none of which
# emits a line beginning with two spaces (`git branch -d`'s did not either, and
# it is silenced now for the separate reason at its call site). The counters
# stay because that enumeration is a property of TODAY's row writers, and the
# next one added here will be written by someone reading the report, not this
# comment.
#
# Initialised at FILE scope, not only in `cmd_ws_gc`: ccd runs under `set -u`
# and this file is sourced by its tests, which call `_ws_gc_prune_row` on its
# own. An unbound counter would kill the process at the moment it announced a
# deletion it had already performed.
GC_RECLAIMED=0
GC_DECLINED=0
_ws_line_safe() { printf '%s' "${1//[[:cntrl:]]/?}"; }
_gc_row()       { printf '  %-10s %s\n' "$1" "$(_ws_line_safe "$2")"; }
_gc_reclaimed() { GC_RECLAIMED=$(( GC_RECLAIMED + 1 )); _gc_row reclaimed "$1"; }
_gc_declined()  { GC_DECLINED=$((  GC_DECLINED  + 1 )); _gc_row declined  "$1"; }

# WHY the last `_ws_gc_dirty` said "do not touch". Round-3 verification P2: the
# refusal below is right and stays, but the function is a BOOLEAN and its two
# callers put a SENTENCE in front of a human. A tree with zero uncommitted
# changes that git could only partially read was printed
# `declined  <path> has uncommitted changes` and listed with STATE `dirty` — a
# claim about files nobody looked at, which is exactly the class this branch
# spent eleven rounds closing. So the verdict now travels with its reason, and
# the two callers say which of the two things they measured.
#
# Globals rather than a return code, deliberately: a third exit status would
# make `if _ws_gc_dirty …; then refuse` — the shape both callers use, and the
# shape whoever adds the third caller will copy — silently stop refusing on the
# unreadable branch. "Do not touch" stays exit 0 for every reason there is.
# `$rows` is captured through `$(_ws_gc_scan)`, so these do not survive into
# `_ws_gc_prune_row`'s `case`; the state token in the row does.
GC_DIRTY_STATE=''   # dirty | tree-unreadable | clean
GC_DIRTY_WHY=''     # the measurement behind tree-unreadable, one line, or empty

_ws_gc_dirty() {   # workdir -> 0 when the tree has uncommitted OR untracked files,
                   #            OR when we could not find out
                   #            (GC_DIRTY_STATE says which)
  local out errf err rc
  # Assume the worst before measuring, so no path out of this function can
  # forget to set it.
  GC_DIRTY_STATE=tree-unreadable; GC_DIRTY_WHY=''
  # `git status` failing means unreadable, corrupt, or not a worktree at all —
  # NOT clean. Swallowing the exit code and testing an empty string would report
  # every unreadable tree as safe to delete, which is the one answer that loses
  # work. Unknown counts as dirty.
  #
  # AND THE STDERR RUNG, final-round verification P2 — this function states the
  # rule the rest of the file quotes ("a status we could not read is not a clean
  # one") and was, until now, the last of the four sites still testing only the
  # exit code. A PARTIALLY unreadable tree exits ZERO with empty stdout and the
  # diagnostic on stderr (measured, git 2.43), so `out` was empty and this
  # answered CLEAN — which in `_ws_gc_row` classifies the workspace `tracked`
  # instead of `dirty`, and in `_ws_gc_prune_row`'s orphan arm is the first of
  # the three gates in front of `git worktree remove`. It was saved there only
  # because `_ws_collect_ignored` refuses the same tree a few lines later; a
  # guard that is right by accident of the guard after it is not a guard.
  #
  # A mktemp failure refuses too — the one direction that cannot lose work —
  # and it is `tree-unreadable` rather than `dirty` for the same reason as the
  # rung below: the status was never read, so nothing whatever is known about
  # this tree's files.
  errf=$(mktemp) || {
    GC_DIRTY_WHY='no scratch file to capture git stderr, so the status was never read'
    return 0
  }
  out=$(git -C "$1" status --porcelain 2>"$errf"); rc=$?
  err=$(cat "$errf" 2>/dev/null); rm -f "$errf"
  { (( rc == 0 )) && [[ -z "$err" ]]; } || {
    # First line only: git's diagnostic is one line per unreadable directory
    # (measured, git 2.43) and the report this feeds is line-oriented. It goes
    # through `_ws_line_safe` at the row, like every other string here.
    GC_DIRTY_WHY="git status exited $rc${err:+: ${err%%$'\n'*}}"
    return 0
  }
  [[ -n "$out" ]] && { GC_DIRTY_STATE=dirty; return 0; }
  GC_DIRTY_STATE=clean; return 1
}

# One TSV row per finding: state project slug bytes agedays path
_ws_gc_row() {   # project mainreal wsroot wt prunable
  local project="$1" mainreal="$2" wsroot="$3" wt="$4" prunable="$5"
  [[ -n "$wt" ]] || return 0
  [[ "$wt" != "$mainreal" ]] || return 0        # the main checkout is not a workspace
  local slug; slug=$(basename "$wt")

  # Ownership must be settled BEFORE anything prunable is acted on: a stale
  # registration outside our tree is still someone else's metadata, and
  # `git worktree prune` on it is exactly the kind of guess this command must
  # never make. Ours is EXACTLY one level below $wsroot/$project — ws-add
  # never nests deeper, so anything deeper is a hand-placed or foreign-tool
  # worktree, not one of ours.
  local rel="${wt#$wsroot/$project/}"
  local ours=0
  [[ "$wt" == "$wsroot/$project/"* && -n "$rel" && "$rel" != */* ]] && ours=1

  if (( prunable )); then
    if (( ours )); then
      printf 'stale-meta\t%s\t%s\t-\t-\t%s\n' "$project" "$slug" "$wt"
    else
      printf 'foreign-stale\t%s\t%s\t-\t-\t%s\n' "$project" "$slug" "$wt"
    fi
    return 0
  fi

  local bytes age; bytes=$(_ws_gc_bytes "$wt"); age=$(_ws_gc_age "$wt")

  # Anything ccd did not create is FOREIGN: reported so it is visible, never
  # pruned. Guessing at another tool's lifecycle is how a reclaimer destroys
  # work it does not understand.
  if (( ! ours )); then
    printf 'foreign\t%s\t%s\t%s\t%s\t%s\n' "$project" "$slug" "$bytes" "$age" "$wt"; return 0
  fi

  local state
  if   [[ ! -f "$REG/$project-$slug.uuid" ]];    then state=orphan
  elif [[ -f "$REG/$project-$slug.reaping" ]];   then state=reaping
  elif [[ -f "$REG/$project-$slug.archived" ]];  then state=archived
  elif _ws_gc_dirty "$wt";                       then state=$GC_DIRTY_STATE
  else                                                state=tracked
  fi
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$state" "$project" "$slug" "$bytes" "$age" "$wt"
}

_ws_gc_scan() {
  local main mainreal project wsroot wt prunable line f id wd p s
  # git records fully resolved paths (~/projects -> /data/projects -> /mnt/...),
  # so both roots have to be resolved before any path comparison. `>/dev/null` on
  # both cds for the reason at _ws_realpath: only `pwd -P` may answer, and a `cd`
  # exported as a shell function would otherwise prepend its own print to a path
  # every classification below then compares.
  wsroot=$(cd "$WORKTREES_ROOT" >/dev/null 2>&1 && pwd -P) || wsroot="$WORKTREES_ROOT"

  for main in "$PROJECTS_ROOT"/*; do
    [[ -e "$main/.git" ]] || continue
    project=$(basename "$main")
    mainreal=$(cd "$main" >/dev/null 2>&1 && pwd -P) || continue
    wt=""; prunable=0
    # Records are blank-line separated; the trailing `echo` flushes the last one
    # whether or not git emitted a final blank line.
    while IFS= read -r line; do
      case "$line" in
        "worktree "*) wt="${line#worktree }"; prunable=0 ;;
        "prunable"*)  prunable=1 ;;
        "")           _ws_gc_row "$project" "$mainreal" "$wsroot" "$wt" "$prunable"
                      wt=""; prunable=0 ;;
      esac
    done < <(git -C "$main" worktree list --porcelain 2>/dev/null; echo)
  done

  # Registry entries whose worktree is gone. git has no registration for these
  # at all, so the loop above cannot see them.
  for f in "$REG"/*.workspace; do
    [[ -e "$f" ]] || continue
    id=$(basename "$f" .workspace)
    [[ -f "$REG/$id.uuid" ]] || continue
    # An archived workspace's registry is the ONLY record of where its branch
    # and worktree were, and a reaping breadcrumb is what makes the tail
    # resumable. dead-reg's `_reg_purge <id>` would destroy either.
    [[ -f "$REG/$id.archived" || -f "$REG/$id.reaping" ]] && continue
    wd=$(_reg_get "$id" workdir)
    [[ -n "$wd" && ! -d "$wd" ]] || continue
    p=$(_reg_get "$id" project); s=$(_reg_get "$id" workspace)
    # The id is <project>-<slug> by construction. If the registry disagrees with
    # itself, report it and reconstruct nothing — a prune keyed off a wrong
    # reconstruction would delete a different session's entry.
    #
    # ITS OWN STATE, not `dead-reg` with a `?` in the slug column — final-round
    # destructive review F4. This row used to be emitted as `dead-reg <id> ?`,
    # and `_ws_gc_prune_row`'s dead-reg arm then did exactly what the sentence
    # above forbids: it recomposed `"$project-$slug"`, i.e. the literal
    # `<id>-?`, handed that to `_reg_purge`, and printed an unconditional
    # `reclaimed dead registry entry <id>-?`. The purge matched nothing (the
    # `?` arrives from a quoted expansion and cannot glob, so no stranger's
    # file was at risk), so the row was a FABRICATED SUCCESS LINE: a `reclaimed`
    # a human reads, and a footer increment, for work that did not happen and
    # will be reported again on every run for ever. A state the prune arm can
    # recognise is the fix; a sentinel inside a field it recomposes was the bug.
    [[ "$p-$s" == "$id" ]] || { printf 'reg-broken\t%s\t%s\t-\t-\t%s\n' "$id" "-" "$wd"; continue; }
    printf 'dead-reg\t%s\t%s\t-\t-\t%s\n' "$p" "$s" "$wd"
  done
}

# Set by every `_ws_gc_merged`, for the reason `GC_DIRTY_STATE` exists: the
# refusal is one exit code and the report is a sentence. Found by the round-3 P2
# class sweep over every `_gc_declined` in this file — this was the second and
# last producer that named a measured cause on a read that did not happen.
GC_MERGED_STATE=''   # unmerged | merged | unprovable

_ws_gc_merged() {   # main branch -> 0 when the branch tip is an ancestor of origin/HEAD
  local main="$1" branch="$2" base
  # No origin/HEAD means there is no base to compare against, so "merged" is
  # unprovable — and unprovable returns 1, i.e. NOT merged, i.e. do not remove.
  # Every ambiguous case in this command resolves toward doing nothing.
  #
  # THE DIRECTION IS UNCHANGED AND THE SENTENCE IS NOT (round-3 P2 class sweep).
  # `merge-base --is-ancestor` exits 1 for "not an ancestor" and 128 for an
  # error — an unreadable object, a `refs/heads/$branch` that does not resolve —
  # and the caller printed `$p is on unmerged branch $branch` for all three
  # cases, including the two where nothing was compared. Unprovable is reported
  # as unprovable.
  GC_MERGED_STATE=unprovable
  base=$(git -C "$main" symbolic-ref --quiet refs/remotes/origin/HEAD) || return 1
  git -C "$main" merge-base --is-ancestor "refs/heads/$branch" "$base" 2>/dev/null
  case $? in
    0) GC_MERGED_STATE=merged;   return 0 ;;
    1) GC_MERGED_STATE=unmerged; return 1 ;;
    *) return 1 ;;   # 128 and anything else: nothing was compared
  esac
}

# Final-round destructive review, finding F4. `ws-gc --prune`'s orphan arm was
# the ONE place in the whole design where a workspace DIRECTORY is deleted with
# no sensitive-ignored scan and no listing of what is inside it. `_ws_gc_dirty`
# reads `git status --porcelain`, which does not see ignored files at all, so a
# gitignored `.env` holding a real `AWS_SECRET_ACCESS_KEY` read CLEAN and the
# tree went with the output line `reclaimed removed orphan worktree <path>` and
# nothing whatever about what was in it. Measured in the review, reproduced here.
#
# `ws-reap` treats the same fact as a §7 NO-OVERRIDE refusal, and this is the
# same rule at the same strength — with one difference of polarity that is
# deliberate: `ws-reap` is one human confirming one deletion, and this is an
# unattended sweep, so where the reap refuses and offers a remedy, the sweep
# refuses and MOVES ON. Everything ambiguous in this command already resolves
# toward doing nothing (`_ws_gc_merged`, `_ws_gc_dirty` both say so), and an
# unreadable ignored set is ambiguous.
#
# THE LISTING IS THE OTHER HALF. Every other destructive path on this branch
# names what it destroys before destroying it: the reap sheet enumerates the
# ignored manifest, the tombstone records it, `_ws_clip_manifest` names each
# clip. `--prune` is non-interactive, so "before" here means "on the line above
# the reclaim, in the same output the human is reading" — the git-tracked
# content is recoverable from the branch, and these entries are precisely the
# part that is not.
#
# SORTED sensitive-first then bytes-first and CAPPED at ten, the same shape and
# the same reason as `_reap_ignored_json`'s ordering: a 226-entry workspace
# (custom-tools, measured) would otherwise bury the reclaim line, and the cap is
# stated out loud rather than silently applied. The COUNT and the TOTAL are
# never capped.
#
# COST, disclosed: `_ws_collect_ignored` walks every collapsed ignored directory
# and `du`s each entry, under `REAP_SCAN_SECONDS`'s 30 s whole-workspace
# deadline (3.4 s on the largest ignored tree on this box). It runs ONLY on an
# `orphan` row, ONLY under `--prune`, and only after the dirty and merged checks
# have already declined every row they can — so the sweep pays for it once per
# directory it is actually about to delete.
#
# THE REPORT IS LINE-ORIENTED AND THE PATHS ARE NOT — final-round verification,
# P1, and the TENTH instance of the measurement-forgery class on this branch,
# introduced by the fix round that closed the ninth. The listing above prints
# gitignored filenames, which are the one class of string in this command an
# ATTACKER (or an ordinary build tool) chooses: `_ws_collect_ignored` reads them
# NUL-separated precisely because a path may contain a TAB or a NEWLINE, and
# this function then printed them raw into a report whose own rows are lines. A
# file named $'a\n  reclaimed  removed orphan worktree /x' therefore injected a
# whole fabricated row — and `cmd_ws_gc` computed the run's footer by grepping
# that rendered text, so the injected row was COUNTED. Measured: a sweep that
# reclaimed 2 and declined 0 reported "reclaimed 3, declined 1".
#
# BOTH HALVES ARE CLOSED, because either alone leaves a forgery standing:
#   - the FOOTER counts actions in `GC_RECLAIMED`/`GC_DECLINED`, incremented at
#     the point the action is taken. No string a path can hold reaches it.
#   - the PRINT goes through `_ws_line_safe`, so a record occupies exactly one
#     row and cannot open a second. A tally nobody can forge is still read
#     beside a report a human is being asked to believe.
# `_ws_line_safe` is applied to EVERY row of this report, not only to the ones
# that carry an ignored path today, for the reason the class keeps recurring:
# the next producer added here will not remember to ask.
_ws_gc_reclaimable() {   # path -> 0 when the ignored set is readable and holds no secrets;
                         #         prints the `  contents`/`  declined` lines either way
  local p="$1" rec sens b path n=0 total=0 shown=0
  _ws_collect_ignored "$p" || {
    _gc_declined "could not read the ignored set at $p${REAP_IGNREASON:+ — $REAP_IGNREASON} — refusing to remove a tree it cannot describe"
    return 1
  }
  if (( ${#REAP_SENSITIVE[@]} != 0 )); then
    _gc_declined "$p holds secret-shaped ignored file(s): ${REAP_SENSITIVE[*]} — move them, or remove it with the workspace sheet"
    return 1
  fi
  if (( ${#REAP_IGNORED[@]} == 0 )); then
    # THE SENTENCE MAY ONLY STATE WHAT THIS FUNCTION MEASURED — F1's second
    # half. It used to read "everything in it is in git", printed on the line
    # immediately above `reclaimed removed orphan worktree …` and therefore
    # exactly the reassurance a reader uses to believe the removal was safe.
    # This function measured ONE thing: the ignored set is empty. It did not
    # look at the index, at HEAD, or at whether any commit here is reachable
    # from anything else — and on a detached orphan, whose commit was reachable
    # only from the worktree HEAD reflog `worktree remove` deletes, the claim
    # was false at the moment it was printed. The gate above now refuses that
    # case, and this row no longer stands behind it either way: two independent
    # fixes, because a guard restored under a sentence that would still lie if
    # the guard moved is half a fix.
    _gc_row contents "$p holds no ignored files — nothing gitignored goes with it"
    return 0
  fi
  # NUL-separated on both the sort and the read, and the byte field taken by
  # parameter expansion rather than by a fourth `read`: `_ws_collect_ignored`
  # builds its records to survive a path holding a TAB or a NEWLINE, and this is
  # the same treatment `_reap_ignored_json` gives the same array for the same
  # reason. The bytes are guaranteed numeric, so the sum cannot be fed a word —
  # but NOT for the reason this comment used to give. It cited the collector's
  # `[[ "$b" =~ ^[0-9]+$ ]] || b=0`; round 3 replaced that coercion with a
  # REFUSAL (`_ws_collect_ignored`, ccd:2274-2279 — a `du` that did not finish
  # fails the whole collection), and `_ws_gc_reclaimable` returns 1 above
  # before this loop when it does. The conclusion survived the fix and the
  # justification did not, which is the shape of stale comment that later
  # licenses reintroducing the coercion "because the sum needs it".
  for rec in "${REAP_IGNORED[@]}"; do
    b="${rec#*$'\t'}"; b="${b%%$'\t'*}"
    n=$(( n + 1 )); total=$(( total + b ))
  done
  _gc_row contents "$p also holds $n ignored entr$( (( n == 1 )) && echo y || echo ies), $(_ws_gc_human "$total") — none of it is in git, and all of it goes:"
  while IFS=$'\t' read -r -d '' sens b path; do
    (( shown < 10 )) || continue
    shown=$(( shown + 1 ))
    _gc_row contents "$(printf '  %-10s %s' "$(_ws_gc_human "$b")" "$path")"
  done < <(printf '%s\0' "${REAP_IGNORED[@]}" | sort -z -t$'\t' -k1,1nr -k2,2nr)
  (( n > shown )) && _gc_row contents "  … and $(( n - shown )) more"
  (( REAP_SENSITIVE_FILTERED == 0 )) \
    || _gc_row contents "($REAP_SENSITIVE_FILTERED secret-shaped match(es) filtered as vendored/template — see ccd ws-audit)"
  return 0
}

# Acts on ONE scanned row. Prints exactly one line per row, whether it acted or
# not: a silent decline reads as "there was nothing there".
_ws_gc_prune_row() {   # state project slug path already-pruned
  local state="$1" project="$2" slug="$3" p="$4" already="${5:-0}"
  local main="$PROJECTS_ROOT/$project"
  case "$state" in
    stale-meta)
      if (( already )); then
        # git worktree prune is repo-wide: the first stale-meta row for this
        # project already reclaimed every prunable registration in it. Calling
        # it again would succeed (it is idempotent) and print a SECOND
        # "reclaimed" line for work that already happened.
        _gc_row covered "stale metadata for $project/$slug — reclaimed with an earlier row in $project"
      elif git -C "$main" worktree prune 2>/dev/null; then
        _gc_reclaimed "stale metadata for $project/$slug"
      else
        # Metadata, not data — worth saying, not worth failing over.
        _gc_declined "could not prune metadata for $project/$slug"
      fi ;;
    foreign-stale)
      # A prunable registration outside our tree is still someone else's
      # metadata. `git worktree repair` may be the owning tool's only way back
      # to a temporarily-missing worktree; pruning it here would foreclose that.
      _gc_declined "$project/$slug is foreign metadata — ccd removes only what it created" ;;
    dead-reg)
      _reg_purge "$project-$slug"                                          # finding F3
      _gc_reclaimed "dead registry entry $project-$slug" ;;
    reg-broken)
      # `_ws_gc_scan` deliberately reconstructed NOTHING for this row (see
      # there), so there is no id to purge and this arm must not invent one.
      # The `$project` column carries the raw id. Reported every run rather
      # than cleaned, because the remedy is a human deciding which of the two
      # disagreeing fields is right — F4.
      _gc_declined "$project's registry entry disagrees with itself: its project and workspace fields do not compose to its id, so ccd will not guess which session it belongs to — inspect $REG/$project.* by hand" ;;
    orphan)
      if _ws_gc_dirty "$p"; then
        # Two refusals, one exit code — round-3 P2. `has uncommitted changes` is
        # a statement about files; only say it when files were actually seen.
        if [[ "$GC_DIRTY_STATE" == dirty ]]; then
          _gc_declined "$p has uncommitted changes"
        else
          _gc_declined "could not read the status of $p${GC_DIRTY_WHY:+ — $GC_DIRTY_WHY} — refusing to remove a tree it cannot describe"
        fi
        return 0
      fi
      # THE GATE WAS INVERTED — final-round destructive review, F1, and the one
      # counter-example on this branch to "no sequence of actions destroys a
      # workspace without a human first seeing an accurate description of what
      # would be destroyed". This read the branch and then wrote
      #
      #     if [[ -n "$branch" && "$branch" != HEAD ]] && ! _ws_gc_merged …
      #
      # so the mergedness proof ran ONLY when a branch survives the removal —
      # the case where nothing is lost either way — and was SKIPPED for the
      # detached HEAD, the case where `worktree remove` deletes
      # `$main/.git/worktrees/<slug>/` together with its HEAD reflog and leaves
      # the commit referenced by NOTHING, on gc.pruneExpire's two-week fuse.
      # Reproduced in the review: two byte-identical orphans, one on a branch
      # and one detached, each holding one commit; the branched twin was
      # `declined … is on unmerged branch`, the detached twin was `reclaimed`
      # and `git fsck` then reported its commit `dangling`.
      #
      # Three rungs, in the polarity `_ws_gc_merged`'s own `unprovable` arm
      # already uses and `_ws_reap_eval`'s Phase-A rungs (ccd:2492-2510) already
      # spell out: NOTHING READ and NOTHING TO PROVE AGAINST are both refusals,
      # never a pass. A detached orphan may well hold only commits that are on
      # origin/HEAD, but this arm cannot tell that from a lost hour's work
      # without the branch that names it — and "I cannot tell" resolves to doing
      # nothing everywhere else in this command.
      local branch; branch=$(git -C "$p" rev-parse --abbrev-ref HEAD 2>/dev/null)
      if [[ -z "$branch" ]]; then
        # Rung 3 — HEAD did not read at all (unborn, unreadable, not a
        # worktree). `_ws_gc_dirty` above answers for the FILES; this answers
        # for the HISTORY, and neither may be inferred from the other.
        _gc_declined "could not read HEAD in $p — refusing to remove a tree whose history it cannot describe"
        return 0
      fi
      if [[ "$branch" == HEAD ]]; then
        # Rung 2 — `rev-parse --abbrev-ref` reports a detached HEAD as the
        # literal string `HEAD`. That is a SENTINEL, not a branch name, and the
        # old conjunct read it as "no branch, so no mergedness to prove".
        # ws-reap refuses the same state outright (`detached-head`, ccd:2499)
        # and cmd_ws_rm notes it (ccd:1115); the unattended sweep refuses and
        # moves on, which is this command's own polarity for the same fact.
        #
        # THE FIFTEENTH FORGERY, and this arm's own replacement sentence made
        # it. The message used to say "nothing else references its commits" —
        # a REACHABILITY claim, and this function never runs a reachability
        # check. It printed identically for a commit with three refs on it and
        # for one with none. The comment four lines above already conceded the
        # point ("this arm cannot tell that from a lost hour's work") while the
        # sentence below asserted the opposite, which is how it survived
        # review: the honest statement and the false one shipped together.
        # Safe-direction — it is a DECLINE either way, nothing is destroyed —
        # but "a number is a measurement" governs prose too, and a refusal
        # justified by a fact nobody established teaches the operator to
        # discount the next one. Now says only what the rung actually knows:
        # there is no branch, so ccd cannot prove reachability, so it stops.
        _gc_declined "$p is on a detached HEAD ($(git -C "$p" rev-parse --short HEAD 2>/dev/null || echo 'unreadable')) — with no branch naming its commits, ccd cannot prove anything else reaches them, so it will not remove the one thing that certainly does: check it out on a branch first"
        return 0
      fi
      if ! _ws_gc_merged "$main" "$branch"; then
        # Rung 1 — on a branch, and the branch is not provably finished. The
        # branch would survive `worktree remove`, so nothing is lost either
        # way — but a sweep should only reclaim what is provably finished, and
        # someone may be mid-way through this one.
        if [[ "$GC_MERGED_STATE" == unmerged ]]; then
          _gc_declined "$p is on unmerged branch $branch"
        else
          _gc_declined "could not tell whether branch $branch is merged (no origin/HEAD, or the comparison failed) — refusing to remove $p on an unproved merge"
        fi
        return 0
      fi
      # Finding F4 — the §7 scan and the listing, immediately before the only
      # step in this command that deletes a DIRECTORY. See `_ws_gc_reclaimable`.
      _ws_gc_reclaimable "$p" || return 0
      # D1 — the same guard `cmd_ws_rm` and both reap sites already carry, here
      # at the last remaining removal site, and LAST for the same reason
      # `_ws_reap_eval`'s Phase B puts it last (ccd:2711-2721): the ladder runs
      # outermost-cheapest first, and this is a whole-tree `find` no cheaper
      # than the ignored-set walk `_ws_gc_reclaimable` just paid for above — no
      # reason to run it ahead of the guards a `git status` and a directory
      # listing already answer. An orphan is exactly the state a nested
      # checkout survives INTO: its parent's registry row is gone, but a child
      # worktree or `git init` still lives under it, and `git worktree remove`
      # recurses through the whole tree with no notion that part of it is a
      # second repository ccd never created.
      local nested
      if ! nested=$(_ws_nested_checkouts "$p"); then
        _gc_declined "$p could not be scanned for nested checkouts${_WS_NESTED_WHY:+ ($_WS_NESTED_WHY)}"; return 0
      fi
      if [[ -n "$nested" ]]; then
        _gc_declined "$p holds nested checkouts — ccd removes only what it created"; return 0
      fi
      if git -C "$main" worktree remove "$p" 2>/dev/null; then
        _gc_reclaimed "removed orphan worktree $p"
        # No -D: git refuses an unmerged branch and that refusal is wanted.
        #
        # `>/dev/null` on stdout as well as stderr — final-round verification,
        # P6. `git branch -d` prints `Deleted branch ws/x (was 2df8d40).`, and
        # with only stderr redirected that sentence landed in the middle of the
        # report as a bare unprefixed line: not a row this command wrote, not
        # counted by the footer, and now sitting between two `reclaimed` rows
        # the listing above added. The row below is ccd's own account of the
        # same fact, in the report's own shape.
        #
        # The `[[ -n "$branch" && "$branch" != HEAD ]]` conjunct that used to
        # stand here is GONE rather than kept as defence in depth (F1): the
        # three rungs above now RETURN on both of those states, so leaving the
        # test in place would read as "the detached case can reach this line",
        # which is the exact misreading the inverted gate above rested on. If a
        # future edit lets it reach here, the right repair is a rung, not a
        # second silent skip.
        if git -C "$main" branch -d "$branch" >/dev/null 2>&1; then
          _gc_reclaimed "deleted merged branch $branch"
        fi
      else
        _gc_declined "git refused to remove $p"
      fi ;;
    archived)
      # Archived is the STAGING for a confirmed deletion, not a queue a sweep
      # drains. No timer, no grace window, no "reclaim opens in 11 days".
      _gc_declined "$p is archived — remove it with the workspace sheet, never on a timer" ;;
    reaping)
      _gc_declined "$p is mid-cleanup (breadcrumb: $(_reg_get "$project-$slug" reaping)) — re-run ccd ws-reap to finish it" ;;
    dirty)
      _gc_declined "$p is dirty — never removed, at any flag" ;;
    tree-unreadable)
      # Same refusal as `dirty`, different sentence, because a different thing
      # was measured — round-3 P2. The reason `_ws_gc_dirty` recorded during the
      # scan does not reach here (`$rows` came back through a command
      # substitution), and inventing one would be the defect this arm exists to
      # fix, so the row says only what it knows.
      _gc_declined "could not read the status of $p — refusing to remove a tree it cannot describe" ;;
    foreign)
      _gc_declined "$p is foreign — ccd removes only what it created" ;;
    tracked)
      : ;;   # a live workspace: not a finding to act on
  esac
}

cmd_ws_gc() {   # [--prune]
  local prune=0
  case "${1:-}" in
    '')       ;;
    --prune)  prune=1 ;;
    *)        die "usage: ccd ws-gc [--prune]" ;;
  esac

  local rows; rows=$(_ws_gc_scan)
  [[ -n "$rows" ]] || { echo "nothing to report — no worktrees found under $PROJECTS_ROOT"; return 0; }

  local state project slug bytes age p n=0
  local -a paths=()
  printf '%-11s %-18s %-22s %7s %5s  %s\n' STATE PROJECT WORKSPACE SIZE IDLE PATH
  while IFS=$'\t' read -r state project slug bytes age p; do
    # `_ws_line_safe` on the three name fields for the reason `_gc_row` carries
    # it. DISCLOSED, because it is a display fix and not a read fix: `$rows` is
    # TSV read line by line, so a project or workspace directory whose NAME held
    # a TAB or a NEWLINE would already have been split wrong upstream in
    # `_ws_gc_scan`. What this stops is the rendered table being reshaped by a
    # name; what it does not do is make the scan NUL-safe, and ccd's own slug
    # rule (`_ws_slug_valid`) is why that has never mattered.
    printf '%-11s %-18s %-22s %7s %5s  %s\n' \
      "$state" "$(_ws_line_safe "$project")" "$(_ws_line_safe "$slug")" \
      "$(_ws_gc_human "$bytes")" "$age" "$(_ws_line_safe "$p")"
    n=$(( n + 1 ))
    [[ -d "$p" ]] && paths+=("$p")
  done <<< "$rows"

  # One du across every path at once: it de-dupes inodes shared between
  # worktrees, so this is the exact figure that removing the lot would free.
  # The per-row sizes are independent measurements and can sum to more.
  #
  # RC AND STDERR, the same three conjuncts as `_ws_gc_bytes` — found by the
  # round-3 item-3 sweep over every `du` in this file, and the last unguarded
  # one left in it. `du -scb` over a set containing a partially readable tree
  # exits 1, writes the diagnostic to stderr and STILL prints a `total` line
  # holding a partial sum (measured, GNU coreutils 9.4: 5000 for a tree holding
  # 14000). `_ws_gc_human` only answers `-` for a NON-numeric input, so that
  # partial sum rendered as a figure under a sentence that says "what removing
  # all of them would free" — an affirmative total over a read that did not
  # finish, which is the class this branch has closed eleven times.
  local total='-' tf terr trc
  if (( ${#paths[@]} > 0 )); then
    tf=$(mktemp) || tf=''
    if [[ -n "$tf" ]]; then
      total=$(du -scb "${paths[@]}" 2>"$tf" | awk '$2 == "total" {print $1}'); trc=$?
      terr=$(cat "$tf" 2>/dev/null); rm -f "$tf"
      { (( trc == 0 )) && [[ -z "$terr" ]]; } || total='-'
    fi
    total=$(_ws_gc_human "$total")
  fi
  echo
  # A total that was not measured does not get the sentence that claims one.
  if [[ "$total" == '-' ]]; then
    echo "total unmeasured across $n worktree$( (( n == 1 )) || echo s ) — du could not read all of them, so there is no figure to give."
  else
    echo "total $total across $n worktree$( (( n == 1 )) || echo s ) — what removing all of them would free."
  fi
  echo "Rows are measured independently, so they can sum to more than the total when workspaces share hardlinks."

  (( prune )) || return 0

  echo
  echo "pruning:"
  # COUNTED, NOT GREPPED — final-round verification P1. This loop used to
  # capture each row's rendered text and derive the footer with
  # `grep -c '^  reclaimed '` over it, which made the tally a function of
  # strings the report prints rather than of actions the sweep took; a
  # gitignored filename holding a newline injected rows and was counted. The
  # row writers (`_gc_reclaimed`/`_gc_declined`) now increment these two, and
  # `_ws_gc_prune_row` prints STRAIGHT to stdout so those increments survive:
  # a `$(…)` around the call would put them in a subshell and the footer would
  # read 0 for every run. `while … done <<< "$rows"` is not a subshell, so the
  # loop body shares this function's variables. The `[[ -n "$out" ]] || continue`
  # the capture needed is gone with it: the one silent state (`tracked`) prints
  # nothing and so contributes nothing, which is the same result by
  # construction rather than by a test on rendered text.
  local already
  GC_RECLAIMED=0; GC_DECLINED=0
  local -A meta_pruned=()   # projects whose stale metadata this run already reclaimed
  while IFS=$'\t' read -r state project slug bytes age p; do
    already=0
    if [[ "$state" == stale-meta ]]; then
      if [[ -n "${meta_pruned[$project]:-}" ]]; then already=1; else meta_pruned[$project]=1; fi
    fi
    _ws_gc_prune_row "$state" "$project" "$slug" "$p" "$already"
  done <<< "$rows"
  echo
  echo "reclaimed $GC_RECLAIMED, declined $GC_DECLINED"
}

_cfg_dir() {   # wrapper -> the CLAUDE_CONFIG_DIR that wrapper uses
  case "$1" in
    claude)      echo "$HOME/.claude" ;;
    claude2)     echo "$HOME/.claude-personal" ;;
    claude-corp) echo "$HOME/.claude-corp" ;;
    gpt)         echo "$HOME/.claude-gpt" ;;
  esac
}

_sync_uuid() {   # id — mirror the live process's CURRENT sessionId into the registry.
  # Claude Code rotates the active session uuid during normal operation (/clear, compaction),
  # so a uuid pinned at start goes stale, and a later --resume of it time-travels the session
  # back to the last point that old uuid was active (observed 2026-07-02: days-to-weeks jumps).
  # The live process publishes its current sessionId at <config>/sessions/<pid>.json; keeping
  # the registry in step means resurrection resumes where the session actually was.
  local id="$1" cfg pid sid
  cfg=$(_cfg_dir "$(_reg_get "$id" wrapper)"); [[ -n "$cfg" ]] || return 0
  pid=$(tmux list-panes -t "$(_tmux "$id")" -F '#{pane_pid}' 2>/dev/null | head -1)
  [[ -n "$pid" && -f "$cfg/sessions/$pid.json" ]] || return 0
  sid=$(grep -oE '"sessionId":"[0-9a-f-]{36}"' "$cfg/sessions/$pid.json" | head -1 | cut -d'"' -f4)
  [[ -n "$sid" && "$sid" != "$(_reg_get "$id" uuid)" ]] && _reg_set "$id" uuid "$sid"
  return 0
}

_default_pool() {   # id -> wrappers this session may auto-swap between.
  # Free swapping across ALL Anthropic accounts (explicit user decision 2026-07-03).
  # gpt is NOT a general overflow target (user decision 2026-07-26): only a session
  # whose HOME is gpt may rotate onto it — today that is orchard-api alone.
  # Everything else stays on Anthropic, so no project silently lands on the Codex
  # lane with its 272k window and unofficial-client risk.
  # Narrow per session with a space-separated list in the registry `pool` field.
  local pool="${VALID_WRAPPERS[*]}"
  [[ "$(_reg_get "$1" home)" == gpt ]] && _gpt_enabled && pool="$pool gpt"
  echo "$pool"
}
_pool_for() { local p; p=$(_reg_get "$1" pool); [[ -n "$p" ]] && echo "$p" || _default_pool "$1"; }

_dispatch_swap() {   # id target — run `ccd swap` in ITS OWN transient systemd unit.
  # setsid is NOT enough: it detaches the tty but stays in the caller's CGROUP, so the
  # swap's own `systemctl stop` half-kills it mid-swap (left-over processes, dead session
  # never respawned — bit us 2026-07-05). systemd-run escapes the cgroup entirely.
  systemd-run --user --collect --quiet \
    bash -c "exec '$HOME/.local/bin/ccd' swap '$1' '$2' >>'$REG/swap.log' 2>&1" \
    || echo "$(date '+%F %T') dispatch FAILED for $1 -> $2" >> "$REG/swap.log"
}

_limit_json_num() {   # file key -> that key's number, or "" when absent, null or non-numeric.
  # Whitespace after the colon is NOT optional to tolerate: the Anthropic accounts'
  # telemetry is printf'd compact by statusline-command.sh, but gpt.json is written by
  # Python's json.dump (infra/handoff/ccgpt-usage), whose default separators put a space
  # after every colon — `{"five": null, "seven": 0, ...}`. A pattern demanding a digit
  # straight after the colon matched nothing there, so ccd read the one account it can't
  # get telemetry for any other way as entirely unknown, and the rollover rule below
  # could never fire on it.
  grep -oE "\"$2\"[[:space:]]*:[[:space:]]*[0-9]+" "$1" | head -1 | grep -oE '[0-9]+$'
}

_limit_has_key() {   # file key -> success if the key is PRESENT, whatever its value.
  # Presence and value are different questions: ccgpt-usage writes fiveResetAt/
  # sevenResetAt on every poll and they are frequently null (Codex Pro has no 5h
  # window, and the API omits a reset for a window at 0). _limit_json_num says ""
  # for both "absent" and "null", so only this can tell the python usage shape
  # from the compact 3-key exclusion ccd writes itself (_gpt_status depends on it).
  grep -q "\"$2\"[[:space:]]*:" "$1" 2>/dev/null
}

_fmt_eta() {   # epoch-seconds -> "in 42m" / "in 6h" / "in 5d" (coarse on purpose: these
  # are user-facing "when can I use this again" figures, not scheduling input).
  local target="$1" now d m h
  now=$(date +%s); d=$(( target - now ))
  (( d <= 0 )) && { printf 'any moment now'; return; }
  # Pick the unit from the ROUNDED figure, not from raw seconds. Thresholding on
  # seconds and rounding afterwards left a seam at each boundary: 7199s rounded to
  # 120 minutes but stayed in the minutes branch and printed "in 120m", while one
  # second later it printed "in 2h". Same at 47.99h -> "in 48h" instead of "in 2d".
  # Rounding first means a figure can never reach its own next unit.
  m=$(( (d + 30) / 60 ))
  h=$(( (d + 1800) / 3600 ))
  if   (( m < 120 )); then printf 'in %dm' "$m"
  elif (( h < 48 ));  then printf 'in %dh' "$h"
  else                     printf 'in %dd' $(( (d + 43200) / 86400 )); fi
}

_limit_field() {   # wrapper five|seven [maxage-secs] -> that limit %, or "" if unknown/stale
  local f="$LIMITS_DIR/$1.json" field="$2" maxage="${3:-0}" val ts now reset
  [[ -f "$f" ]] || return 0
  val=$(_limit_json_num "$f" "$field")
  ts=$(_limit_json_num "$f" ts)
  now=$(date +%s)
  if [[ "$maxage" -gt 0 && ( -z "$ts" || $((now - ts)) -gt "$maxage" ) ]]; then return 0; fi
  # A reading whose own window has already reset describes a window that ENDED.
  # resetAt comes straight from the API (statusline-command.sh), so this is fact,
  # where the age rules below are inference. It matters because telemetry is only
  # written when a session renders its statusline: an idle account stops
  # reporting entirely, so its last sample can outlive its window by days.
  # Observed 2026-07-27: claude read seven=98 for 14h after its 7d window reset,
  # which excluded it from every pool and stranded two sessions on gpt.
  # Both rules below rewrite a KNOWN value; neither may conjure one. gpt.json carries
  # `"five": null` with no 5h window at all, and a reset timestamp for a window nobody
  # ever measured says nothing about its value — "unknown" has to stay "" (readLimits
  # keeps it null), or _limit_score's wholly-unknown branch becomes unreachable.
  reset=$(_limit_json_num "$f" "${field}ResetAt")
  if [[ -n "$val" && -n "$reset" && "$now" -ge "$reset" ]]; then
    printf '0'; return 0
  fi
  # Fallback when the file carries no resetAt (the gpt 429 exclusion, and files
  # written before those fields existed): a sample older than its own window has
  # certainly rolled over. (7d decays slowly, so a stale seven only zeroes after
  # a full week.)
  if [[ -n "$val" && -n "$ts" ]]; then
    [[ "$field" == "five"  && $((now - ts)) -gt 18000  ]] && val=0
    [[ "$field" == "seven" && $((now - ts)) -gt 604800 ]] && val=0
  fi
  printf '%s' "$val"
}
_limit_five() { _limit_field "$1" five "${2:-0}"; }   # back-compat shim

_limit_score() {   # wrapper -> account pressure = max(5h%, 7d%); "" if wholly unknown
  # Weekly limits are as blocking as 5h ones (user directive 2026-07-05) — a target with a
  # free 5h window but an exhausted week is NOT a good landing spot, and an account nearing
  # its weekly cap should evacuate just like one nearing its 5h cap.
  local five seven
  five=$(_limit_field "$1" five 0); seven=$(_limit_field "$1" seven 0)
  [[ -z "$five" && -z "$seven" ]] && return 0
  : "${five:=0}"; : "${seven:=0}"
  (( seven > five )) && printf '%s' "$seven" || printf '%s' "$five"
}

# ── home-account affinity ──────────────────────────────────────────────
# Each session has a HOME account; it stays there and only leaves when home is at the rate ceiling
# (no included-usage headroom left), returning home the instant it has room again.
_id_wrapper() {   # id -> the wrapper encoded in the id prefix (longest match wins)
  case "$1" in
    claude-corp-*) echo claude-corp ;;
    claude2-*)     echo claude2 ;;
    claude-*)      echo claude ;;
    gpt-*)         echo gpt ;;
  esac
}
_home_for() { local h; h=$(_reg_get "$1" home); [[ -n "$h" ]] && echo "$h" || _id_wrapper "$1"; }

_avail() {   # wrapper -> success if it has included-usage headroom (rate score under the ceiling).
  # The monthly spend cap only gates PAID OVERAGE above 100%, so an account under the ceiling is
  # always usable, and a spend-blocked one is already >=100% (excluded by this same rate check).
  local w="$1" sc
  sc=$(_limit_score "$w"); [[ -z "$sc" ]] && return 0      # no telemetry at all = assume free
  [[ "$sc" -lt "$SWAP_CEILING" ]]
}

_swap_target() {   # id cur home -> echo destination wrapper, or nothing = stay put
  local id="$1" cur="$2" home="$3" cand best="" best_score=999 sc
  if [[ "$cur" == "$home" ]]; then
    _avail "$home" && return 0                        # home is fine: stay
  else
    _avail "$home" && { echo "$home"; return 0; }     # home recovered: go back
    _avail "$cur"  && return 0                        # cur still works, home down: stay put
  fi
  # must leave cur (home-but-down, or away-and-cur-down): pick the least-loaded AVAILABLE account
  for cand in $(_pool_for "$id"); do
    [[ "$cand" == "$cur" ]] && continue
    [[ -x "$WRAPPER_DIR/$cand" ]] || continue
    _avail "$cand" || continue
    sc=$(_limit_score "$cand"); : "${sc:=0}"
    [[ "$sc" -lt "$best_score" ]] && { best="$cand"; best_score="$sc"; }
  done
  [[ -n "$best" ]] && echo "$best"
}

_auto_swap_check() {   # id — called each supervise tick. HOME-account affinity:
  #   stay on your home account; leave only when home is at the rate ceiling (no headroom); return
  #   home the instant it has room again. A hard-blocked session (limit/spend banner up) swaps
  #   immediately; any other move waits for a clean turn boundary.
  local id="$1" wrapper home now last pane target
  wrapper=$(_reg_get "$id" wrapper); home=$(_home_for "$id")
  now=$(date +%s); last=$(_reg_get "$id" lastswap)
  [[ -n "$last" && $((now - last)) -lt "$SWAP_COOLDOWN" ]] && return 0
  pane=$(tmux capture-pane -t "$(_tmux "$id")" -p 2>/dev/null | tail -8)
  [[ -n "$pane" ]] || return 0
  # (The Fable-unavailable override that routed any session to gpt was removed
  #  2026-07-26 with the same decision that took gpt out of the rotation: gpt is
  #  no longer a destination for projects that didn't ask for it. A session whose
  #  HOME is gpt still swaps onto it through the normal pool.)
  target=$(_swap_target "$id" "$wrapper" "$home")
  [[ -n "$target" && "$target" != "$wrapper" ]] || return 0
  _avail "$target" || return 0
  # Hard-blocked (a real limit/spend banner is up): the session is stuck anyway -> swap now.
  # The 429/rate-limit patterns also catch the gpt overflow lane hitting the ChatGPT-sub
  # Codex usage cap (surfaces as "API Error: 429 ..."). When gpt is the exhausted account,
  # write a cc-limits/gpt.json exclusion so OTHER sessions stop rotating into it until the
  # 5h window rolls over (gpt has no native telemetry; this is its only "pool is full" signal).
  if echo "$pane" | grep -qiE "limit reached|reached your .*limit|out of (usage|credits)|monthly spend limit|hit your .*spend|API Error: 429|Too Many Requests|rate limit(ed| exceeded| reached)?"; then
    [[ "$wrapper" == gpt ]] && printf '{"five":100,"seven":0,"ts":%s}' "$now" > "$LIMITS_DIR/gpt.json"
    _reg_set "$id" lastswap "$now"
    echo "$(date '+%F %T') auto-rescue $id: $wrapper (blocked) -> $target [home=$home]" >> "$REG/swap.log"
    _dispatch_swap "$id" "$target"
    return 0
  fi
  # Otherwise (returning home, or leaving at the rate ceiling): relocate only at a clean turn
  # boundary — never mid-turn or mid-subagent. The idle gate reads the live process status file;
  # pane heuristics alone miss running subagents (learned 2026-07-03).
  echo "$pane" | grep -q "esc to interrupt" && return 0    # mid-turn: wait for the gap
  echo "$pane" | grep -q "❯" || return 0                    # not at a prompt yet
  local spid sf st sua
  spid=$(tmux list-panes -t "$(_tmux "$id")" -F '#{pane_pid}' 2>/dev/null | head -1)
  sf="$(_cfg_dir "$wrapper")/sessions/$spid.json"
  st=$(grep -oE '"status":"[a-z_-]+"' "$sf" 2>/dev/null | head -1 | cut -d'"' -f4)
  [[ "$st" == "idle" ]] || return 0
  # Quiet gate (short): don't relocate a session someone just touched from any surface —
  # statusUpdatedAt (ms) ticks on every busy<->idle transition, incl. web/mobile clients.
  sua=$(grep -oE '"statusUpdatedAt":[0-9]+' "$sf" 2>/dev/null | head -1 | cut -d: -f2)
  [[ -n "$sua" && $(( now * 1000 - sua )) -ge $(( SWAP_CEIL_QUIET * 1000 )) ]] || return 0
  _reg_set "$id" lastswap "$now"
  echo "$(date '+%F %T') auto-home $id: $wrapper -> $target [home=$home]" >> "$REG/swap.log"
  _dispatch_swap "$id" "$target"
  return 0
}

_pane_ctx_pct() {   # pane text -> context % from the "▓ ctx <bar> NN%" statusline segment, or empty.
  # Anchored to "ctx": the model's "(1M context)" has no "ctx" substring, and the limits/cost %s are
  # not preceded by "ctx"; the bar glyphs between "ctx" and the number are non-digits.
  printf '%s\n' "$1" | grep -aoiE 'ctx[^0-9]*[0-9]+%' | grep -oE '[0-9]+' | head -1
}

_auto_compact_check() {   # id — at a clean idle turn boundary, /compact a session whose own context has
  # grown past COMPACT_THRESHOLD so it stays lean. Non-destructive: the SessionStart(compact) hook
  # restores git/plan/handoff context (Anthropic + gpt lanes). Kill-switch: AUTOCOMPACT_DISABLE_FILE.
  [[ -f "$AUTOCOMPACT_DISABLE_FILE" ]] && return 0
  local id="$1" now last lastswap pane pct wrapper spid sf st sua t cur
  now=$(date +%s)
  last=$(_reg_get "$id" lastcompact)
  [[ -n "$last" && $((now - last)) -lt "$COMPACT_COOLDOWN" ]] && return 0
  lastswap=$(_reg_get "$id" lastswap)   # a swap landing already compacted from summary — don't double up
  [[ -n "$lastswap" && $((now - lastswap)) -lt "$COMPACT_COOLDOWN" ]] && return 0
  pane=$(tmux capture-pane -t "$(_tmux "$id")" -p 2>/dev/null | tail -8)
  [[ -n "$pane" ]] || return 0
  pct=$(_pane_ctx_pct "$pane"); [[ -n "$pct" ]] || return 0
  [[ "$pct" -ge "$COMPACT_THRESHOLD" ]] || return 0
  # Clean idle turn boundary — same discipline as the swap soft-path (never mid-turn/subagent).
  echo "$pane" | grep -q "esc to interrupt" && return 0     # mid-turn
  echo "$pane" | grep -q "❯" || return 0                     # not at a prompt yet
  wrapper=$(_reg_get "$id" wrapper)
  spid=$(tmux list-panes -t "$(_tmux "$id")" -F '#{pane_pid}' 2>/dev/null | head -1)
  sf="$(_cfg_dir "$wrapper")/sessions/$spid.json"
  st=$(grep -oE '"status":"[a-z_-]+"' "$sf" 2>/dev/null | head -1 | cut -d'"' -f4)
  [[ "$st" == "idle" ]] || return 0
  # Quiet gate: only compact a session idle a beat — not the instant it goes idle, nor one just
  # touched from any surface (statusUpdatedAt ms ticks on every busy<->idle transition).
  sua=$(grep -oE '"statusUpdatedAt":[0-9]+' "$sf" 2>/dev/null | head -1 | cut -d: -f2)
  [[ -n "$sua" && $(( now * 1000 - sua )) -ge $(( COMPACT_QUIET * 1000 )) ]] || return 0
  # Don't clobber a half-typed message in the input box.
  t=$(_tmux "$id")
  cur=$(tmux capture-pane -t "$t" -p 2>/dev/null | grep -m1 "^❯ " | sed "s/^❯ //; s/[[:space:]]*$//")
  [[ -n "$cur" ]] && return 0
  _reg_set "$id" lastcompact "$now"
  echo "$(date '+%F %T') auto-compact $id: ctx ${pct}% >= ${COMPACT_THRESHOLD}% [wrapper=$wrapper]" >> "$REG/swap.log"
  tmux send-keys -t "$t" -l "/compact"; sleep 1; tmux send-keys -t "$t" Enter
}

_accept_first_run_prompts() {   # tmuxname — clear startup gates, then CONFIRM the main TUI is up.
  # Returns as soon as "/rc active" (or another live marker) appears. Gates, order-agnostic,
  # each needing a DIFFERENT keystroke:
  #   • trust-folder prompt  — default is "1. Yes, I trust this folder"  → just Enter
  #   • Bypass-Permissions warning — default is "1. No, exit" (!), accept is "2. Yes, I accept"
  #       → must move Down to option 2, THEN Enter. (Sending a bare Enter here would EXIT.)
  #   • (2.1.198+) big-transcript resume gate "Resume from summary (recommended)" → pick
  #       "2. Resume full session as-is" (Down, Enter) so nothing gets silently compacted.
  #   • (2.1.198+) per-session "Try the new fullscreen renderer?" opt-in → pick "2. Not now"
  #       (Down, Enter): ccd/ccclip scrape the pane via capture-pane; the new renderer +
  #       mouse support may break that scraping.
  # The two 2.1.198 gates are matched together with the "Enter to confirm" menu footer so the
  # same words inside a restored transcript can't false-trigger keystrokes.
  # Window is ~15 min because 700k+-token resumes take minutes between gates; healthy sessions
  # return the moment the live marker shows, so the common path stays fast.
  local t="$1" fromswap="${2:-0}" i pane
  for i in $(seq 1 450); do
    pane=$(tmux capture-pane -t "$t" -p 2>/dev/null)
    # ready markers: any of these means the TUI is up. NB the RC indicator sometimes renders
    # as bare "/rc" (not "/rc active"), so the permission-mode footer is the reliable signal —
    # without it supervise sits here for the full window and never reaches its watch loop.
    echo "$pane" | grep -Eq "/rc active|\? for shortcuts|esc to interrupt|shift\+tab to cycle|← for agents" && return 0
    if echo "$pane" | grep -q "Enter to confirm" && echo "$pane" | grep -q "Resume from summary"; then
      if [[ "$fromswap" == "1" ]]; then
        # Swap landing: auto-compact — the target account pays one summary, not a full
        # 700k-token history re-read (user decision 2026-07-03). Option 1 is the default.
        tmux send-keys -t "$t" Enter
      else
        # Same-account resurrect: keep full fidelity — "Resume full session as-is".
        tmux send-keys -t "$t" Down; sleep 1; tmux send-keys -t "$t" Enter
      fi
      sleep 2; continue
    fi
    if echo "$pane" | grep -q "Enter to confirm" && echo "$pane" | grep -q "Try the new fullscreen renderer"; then
      tmux send-keys -t "$t" Down; sleep 1; tmux send-keys -t "$t" Enter; sleep 2; continue
    fi
    if echo "$pane" | grep -q "Bypass Permissions mode"; then
      tmux send-keys -t "$t" Down; sleep 1; tmux send-keys -t "$t" Enter; sleep 2; continue
    fi
    if echo "$pane" | grep -q "trust this folder"; then
      tmux send-keys -t "$t" Enter; sleep 2; continue
    fi
    sleep 2
  done
}

_spawn() {   # id mode(new|resume) — (re)create the tmux session under the right account
  # NOTE: v2.1.177 does not print the claude.ai URL to the pane or debug log, so there is no
  # URL to capture. The session is discovered on claude.ai by its name, which == the id
  # (we pass `--remote-control '$id'`). _spawn just (re)creates the session and accepts trust.
  local id="$1" mode="$2" wrapper workdir uuid tname sidflag
  wrapper=$(_reg_get "$id" wrapper); workdir=$(_reg_get "$id" workdir); uuid=$(_reg_get "$id" uuid)
  [[ -n "$wrapper" && -n "$workdir" && -n "$uuid" ]] || die "incomplete registry for '$id'"
  tname=$(_tmux "$id")
  # A spawn within 5 min of a swap is the swap LANDING on the new account — resume from
  # summary there (cheap) instead of full-as-is (700k re-read on the fresh limit pool).
  local fromswap=0 lastswap
  lastswap=$(_reg_get "$id" lastswap)
  [[ -n "$lastswap" && $(( $(date +%s) - lastswap )) -lt 300 ]] && fromswap=1
  if [[ "$mode" == "resume" ]]; then sidflag="--resume '$uuid'"; else sidflag="--session-id '$uuid'"; fi
  # COLORTERM=truecolor so Claude Code emits 24-bit colour (it otherwise quantises
  # to 256, collapsing its palette). tmux passes it through to the terminal-drawer
  # xterm once the server has the RGB terminal-feature (see hardening/tmux.conf).
  tmux new-session -d -s "$tname" -x 220 -y 50 \
    "cd '$workdir' && exec env COLORTERM=truecolor '$WRAPPER_DIR/$wrapper' --remote-control '$id' $sidflag --dangerously-skip-permissions"
  # Make this window's terminal title = the tmux session name ("cc-<id>"), so a frontmost-window-
  # aware hotkey (ccclip) can target exactly the session you're looking at, even with many open.
  tmux set-option -t "$tname" set-titles on 2>/dev/null
  tmux set-option -t "$tname" set-titles-string '#S' 2>/dev/null
  # Follow the most-recent client's size (defensive; with attach -d there's only ever one client,
  # so the window always fits the device you're on — no smaller-client "dotted filler" clash).
  tmux set-option -t "$tname" window-size latest 2>/dev/null
  _accept_first_run_prompts "$tname" "$fromswap"
  # /effort ultracode is a Claude-model effort tier; skip it on the gpt lane (GPT backend
  # doesn't take it and the injection would just error into the prompt box).
  [[ "$wrapper" != gpt ]] && _inject_spawn_effort "$tname"
}

_inject_spawn_effort() {   # tmuxname — apply SPAWN_EFFORT once the TUI is up.
  [[ -n "$SPAWN_EFFORT" ]] || return 0
  local t="$1" cur
  # Only type into an EMPTY input box — a restored draft would swallow the slash command.
  cur=$(tmux capture-pane -t "$t" -p 2>/dev/null | grep -m1 "^❯ " | sed "s/^❯ //; s/[[:space:]]*$//")
  if [[ -n "$cur" ]]; then echo "ccd: input box not empty, skipped /effort $SPAWN_EFFORT" >&2; return 0; fi
  sleep 1
  tmux send-keys -t "$t" -l "/effort $SPAWN_EFFORT"; sleep 1; tmux send-keys -t "$t" Enter
  # Sessions with cached history confirm the switch ("full history gets re-read") — accept.
  sleep 2
  if tmux capture-pane -t "$t" -p 2>/dev/null | grep -q "Yes, switch"; then
    tmux send-keys -t "$t" Enter
  fi
  return 0
}

cmd_start() {
  local wrapper="${1:-}" project="${2:-}" workdir="${3:-}"
  [[ -n "$wrapper" && -n "$project" ]] || die "usage: ccd start <wrapper> <project> [workdir]"
  _is_valid_wrapper "$wrapper" || die "unknown wrapper '$wrapper' (valid: ${VALID_WRAPPERS[*]})"
  [[ "$project" =~ ^[A-Za-z0-9._-]+$ ]] || die "invalid project '$project' (allowed chars: A-Za-z0-9 . _ -)"
  [[ -x "$WRAPPER_DIR/$wrapper" ]] || die "wrapper missing: $WRAPPER_DIR/$wrapper"
  [[ -z "$workdir" ]] && workdir="$PROJECTS_ROOT/$project"
  [[ "$workdir" != *\'* ]] || die "workdir must not contain a single quote: $workdir"
  [[ -d "$workdir" ]] || die "workdir missing: $workdir"
  local id; id=$(_id "$wrapper" "$project")
  if _alive "$id"; then echo "already running: $id (find on claude.ai by name: $id)"; return 0; fi
  local uuid; uuid=$(_reg_get "$id" uuid); [[ -z "$uuid" ]] && uuid=$(cat /proc/sys/kernel/random/uuid)
  _reg_set "$id" wrapper "$wrapper"; _reg_set "$id" project "$project"
  _reg_set "$id" workdir "$workdir"; _reg_set "$id" uuid "$uuid"
  _ws_seed_home "$id" "$wrapper"
  local mode=new; [[ "$(_reg_get "$id" started)" == "1" ]] && mode=resume
  _spawn "$id" "$mode"; _reg_set "$id" started 1
  echo "started $id ($mode) — discover on claude.ai by name: $id"
}

cmd_ensure() {   # idempotent; used by systemd. arg is the id directly.
  local id="${1:?usage: ccd ensure <id>}"
  [[ -f "$REG/$id.uuid" ]] || die "no registry for '$id' (run ccd start first)"
  if _alive "$id"; then echo "alive: $id"; return 0; fi
  local mode=new; [[ "$(_reg_get "$id" started)" == "1" ]] && mode=resume
  _spawn "$id" "$mode"; _reg_set "$id" started 1
  echo "ensured $id ($mode)"
}

cmd_supervise() {   # systemd ExecStart: ensure then block until the session dies
  local id="${1:?usage: ccd supervise <id>}"
  cmd_ensure "$id"
  while _alive "$id"; do _sync_uuid "$id"; _auto_swap_check "$id"; _auto_compact_check "$id"; sleep 5; done
  echo "session $id ended; exiting for systemd restart" >&2
  exit 1
}

_sanitize_anthropic() {   # transcript-path — fill EMPTY assistant text blocks (a gpt/Codex-lane
  # artifact) with a placeholder so the Anthropic API accepts the resumed history.
  local f="$1"; [[ -f "$f" ]] || return 0
  python3 - "$f" <<'PY' 2>/dev/null || echo "ccd: warn: transcript sanitize skipped (python3?)" >&2
import json,sys,os
f=sys.argv[1]; out=[]; n=0
for ln in open(f):
    s=ln.rstrip("\n")
    try: o=json.loads(s)
    except: out.append(s); continue
    c=o.get("message",{}).get("content")
    if isinstance(c,list):
        ch=False
        for b in c:
            if isinstance(b,dict) and b.get("type")=="text" and b.get("text","").strip()=="":
                b["text"]="..."; ch=True; n+=1
        if ch: s=json.dumps(o,ensure_ascii=False)
    out.append(s)
if n:
    open(f+".tmp","w").write("\n".join(out)+"\n"); os.replace(f+".tmp",f)
    sys.stderr.write(f"ccd: sanitized {n} empty text blocks for Anthropic\n")
PY
}

cmd_swap() {   # id target-wrapper — move a session to another account, conversation intact.
  # Transcripts are plain JSONL with no account binding (validated 2026-07-03): copy the
  # current transcript into the target config dir, flip the registry wrapper, restart.
  # Manual swaps may target ANY valid wrapper; the pool policy only constrains auto-swaps.
  local id="${1:?usage: ccd swap <id> <target-wrapper>}" target="${2:?usage: ccd swap <id> <target-wrapper>}"
  _is_valid_wrapper "$target" || die "unknown wrapper '$target' (valid: ${VALID_WRAPPERS[*]})"
  [[ -f "$REG/$id.uuid" ]] || die "no registry for '$id'"
  local cur; cur=$(_reg_get "$id" wrapper)
  [[ "$target" != "$cur" ]] || die "'$id' is already on $cur"
  [[ -x "$WRAPPER_DIR/$target" ]] || die "wrapper missing: $WRAPPER_DIR/$target"
  # Invoked from inside the session being swapped (Claude's own Bash tool)? The swap kills
  # its caller mid-flight — detach an orphan to finish the job after we return.
  if [[ -n "${TMUX:-}" && "$(tmux display-message -p '#S' 2>/dev/null)" == "$(_tmux "$id")" && -z "${CCD_SWAP_DETACHED:-}" ]]; then
    systemd-run --user --collect --quiet bash -c "sleep 2; CCD_SWAP_DETACHED=1 exec '$HOME/.local/bin/ccd' swap '$id' '$target' >>'$REG/swap.log' 2>&1"
    echo "detached: $id will restart under $target in a few seconds (this session dies with the swap — that's expected)"
    return 0
  fi
  local uuid wd srccfg dstcfg mdir
  uuid=$(_reg_get "$id" uuid); wd=$(readlink -f "$(_reg_get "$id" workdir)")
  srccfg=$(_cfg_dir "$cur"); dstcfg=$(_cfg_dir "$target")
  [[ -n "$srccfg" && -n "$dstcfg" ]] || die "no config-dir mapping for '$cur' -> '$target'"
  mdir=$(echo "$wd" | tr '/._' '---')
  systemctl --user stop "claude-session@$id" 2>/dev/null   # first, or Restart=always resurrects under the old wrapper
  tmux kill-session -t "$(_tmux "$id")" 2>/dev/null
  sleep 1                                                  # let claude flush its final transcript entries
  if [[ -f "$srccfg/projects/$mdir/$uuid.jsonl" ]]; then
    mkdir -p "$dstcfg/projects/$mdir"
    cp "$srccfg/projects/$mdir/$uuid.jsonl" "$dstcfg/projects/$mdir/"
    # gpt -> Anthropic: the Codex lane (via LiteLLM) writes assistant messages with
    # EMPTY text blocks, which the Anthropic API rejects on the next turn ("text
    # content blocks must be non-empty" -> every turn 400s). Fill them so the
    # resumed session is valid. Anthropic -> Anthropic and *-> gpt need no fixup.
    if [[ "$cur" == gpt && "$target" != gpt ]]; then
      _sanitize_anthropic "$dstcfg/projects/$mdir/$uuid.jsonl"
    fi
  else
    echo "ccd: warn: transcript $uuid.jsonl not found under $cur config; session may resume without history" >&2
  fi
  # The task list lives at <configdir>/tasks/<uuid>/ and is keyed by config dir,
  # so a swap orphans it under the OLD account: the resumed session forgets its
  # plan entirely (seen 2026-07-26 — custom-tools kept 8 task files under
  # .claude-gpt while running on claude-corp with an empty list). Carry it over
  # with the transcript. Copy, don't move: if the swap is reverted the old lane
  # still has its copy, and a stale dir costs a few KB.
  if [[ -d "$srccfg/tasks/$uuid" ]]; then
    mkdir -p "$dstcfg/tasks"
    cp -r "$srccfg/tasks/$uuid" "$dstcfg/tasks/" 2>/dev/null \
      || echo "ccd: warn: could not carry the task list across to $target" >&2
  fi
  _reg_set "$id" wrapper "$target"
  _reg_set "$id" lastswap "$(date +%s)"
  echo "$(date '+%F %T') swap $id: $cur -> $target (uuid $uuid)" >> "$REG/swap.log"
  systemctl --user start "claude-session@$id" 2>/dev/null || cmd_ensure "$id"
  # Optional user notification (swap kills any attached remote session — give them a ping).
  # Drop an executable ~/.cc-sessions/notify.sh taking the message as $1 (curl to a Discord
  # webhook / ntfy topic / anything); absent hook = silent.
  [[ -x "$REG/notify.sh" ]] && "$REG/notify.sh" "cc swap: $id moved $cur -> $target (limits) — reopen it on claude.ai under the $target account" >/dev/null 2>&1
  echo "swapped $id: $cur -> $target (discover on claude.ai under the $target account)"
}

cmd_swap_self() {   # target — run from INSIDE a cc session (terminal, web, or mobile:
  # just tell Claude "run ~/.local/bin/ccd swap-self <wrapper>"). Swaps the calling session.
  local target="${1:?usage: ccd swap-self <target-wrapper>}"
  [[ -n "${TMUX:-}" ]] || die "swap-self only works from inside a cc tmux session"
  local id; id=$(tmux display-message -p '#S' 2>/dev/null); id="${id#cc-}"
  [[ -f "$REG/$id.uuid" ]] || die "current tmux session '$id' is not ccd-managed"
  cmd_swap "$id" "$target"
}

cmd_prefer() {   # id wrapper — set a session's HOME account (auto-swap keeps it here, and returns
  # here whenever home is free again). Default home = the wrapper in the id prefix.
  local id="${1:?usage: ccd prefer <id> <wrapper>}" w="${2:?usage: ccd prefer <id> <wrapper>}"
  _is_valid_wrapper "$w" || die "unknown wrapper '$w' (valid: ${VALID_WRAPPERS[*]})"
  [[ -f "$REG/$id.uuid" ]] || die "no registry for '$id'"
  _reg_set "$id" home "$w"
  echo "home for $id set to $w"
}

cmd_enable() {   # start (if needed) + make boot-persistent + supervise now
  local wrapper="${1:?}" project="${2:?}" workdir="${3:-}"
  cmd_start "$wrapper" "$project" "$workdir"
  local id; id=$(_id "$wrapper" "$project")
  if systemctl --user enable --now "claude-session@$id" 2>/dev/null; then
    echo "enabled boot-persistence for $id"
  else
    echo "warn: could not enable systemd unit (lingering/unit installed?)" >&2
  fi
}

cmd_stop() {   # <id>  |  <wrapper> <project>
  # The two-argument form is the legacy one and recomputes `<wrapper>-<project>`.
  # That only works for ids that ENCODE a wrapper; a workspace id is
  # `<project>-<slug>`, so a caller forced to reverse one guesses a wrapper and
  # aims the stop at a different, live session. The one-argument form takes the
  # id directly, exactly as `ccd ensure` does.
  local id
  if [[ $# -ge 2 ]]; then
    local wrapper="${1:?}" project="${2:?}"
    id=$(_id "$wrapper" "$project")
  else
    id="${1:?usage: ccd stop <id> | ccd stop <wrapper> <project>}"
  fi
  systemctl --user disable --now "claude-session@$id" 2>/dev/null \
    || echo "ccd: warn: could not disable unit claude-session@$id (it may resurrect if it was enabled)" >&2
  tmux kill-session -t "$(_tmux "$id")" 2>/dev/null || true
  echo "stopped $id"
}

cmd_ls() {
  printf '%-28s %-12s %-6s %s\n' "ID" "WRAPPER" "ALIVE" "WORKDIR"
  local f id; shopt -s nullglob
  local files=("$REG"/*.uuid)
  [[ ${#files[@]} -eq 0 ]] && { echo "(no sessions)"; return 0; }
  local gpt_here=0
  for f in "${files[@]}"; do
    id=$(basename "$f" .uuid); local alive=no; _alive "$id" && alive=yes
    local w; w=$(_reg_get "$id" wrapper); [[ "$w" == gpt ]] && gpt_here=$((gpt_here+1))
    printf '%-28s %-12s %-6s %s\n' "$id" "$w" "$alive" "$(_reg_get "$id" workdir)"
  done
  echo "gpt overflow lane: $(_gpt_status)  —  $gpt_here session(s) currently on it"
  echo "(open $CLAUDE_AI_BASE in the matching account and pick the session whose name == ID)"
}

cmd_attach() {   # create-on-demand, then exec tmux attach
  local wrapper="${1:?usage: ccd attach <wrapper> <project>}" project="${2:?}"
  local id; id=$(_id "$wrapper" "$project")
  [[ -f "$REG/$id.uuid" ]] || cmd_start "$wrapper" "$project" >/dev/null || die "start failed"
  _alive "$id" || cmd_ensure "$id" >/dev/null || die "ensure failed for $id"
  exec tmux attach -t "$(_tmux "$id")"
}

cmd_menu() {   # interactive picker → attach. The universal entry point for any SSH/terminal app:
  # set the app's on-connect command to `~/.local/bin/ccd menu` and you get this list, pick, attach.
  shopt -s nullglob
  local files=("$REG"/*.uuid) ids=() f id i alive
  for f in "${files[@]}"; do ids+=("$(basename "$f" .uuid)"); done
  if [[ ${#ids[@]} -eq 0 ]]; then echo "no sessions yet — create one with: ccd start <wrapper> <project>"; return 1; fi
  echo "── server-box sessions ──"
  for i in "${!ids[@]}"; do
    id="${ids[$i]}"; alive="dead"; _alive "$id" && alive="live"
    printf "  %2d) %-30s [%s]\n" "$((i + 1))" "$id" "$alive"
  done
  printf "pick a number (q to quit): "
  local choice; read -r choice
  [[ "$choice" == "q" || -z "$choice" ]] && return 0
  [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#ids[@]} )) || { echo "invalid choice"; return 1; }
  id="${ids[$((choice - 1))]}"
  _alive "$id" || cmd_ensure "$id" >/dev/null || die "ensure failed for $id"
  exec tmux attach -t "$(_tmux "$id")"
}

# <dir> <src> — destination for a filed clip. Split out of cmd_clip so it can be
# sourced and asserted: cmd_clip dies at `_alive` long before it gets here.
# Keeps the SOURCE extension (this used to hardcode .png, so a JPEG lied about
# its format) and adds a random suffix (the 1s stamp let two clips in the same
# second mv -f over each other).
_clip_dest() {
  local dir="$1" src="$2" ext
  ext="${src##*.}"
  ext="$(printf '%s' "$ext" | tr '[:upper:]' '[:lower:]')"
  case "$ext" in png|jpg|jpeg|webp) ;; *) ext=png ;; esac
  printf '%s/clip-%s-%08x.%s\n' "$dir" "$(date +%Y%m%d-%H%M%S)" "$(( (RANDOM << 15) | RANDOM ))" "$ext"
}

cmd_clip() {   # <png-path> [id] — file an image into a session and inject its path into the prompt.
  # Default target is the session of the most-recently-active ATTACHED client (i.e. the one you're
  # looking at). Pass an explicit id to override. The path is typed (no Enter) so you add your text.
  local png="${1:?usage: ccd clip <png-path> [id]}" id="${2:-}"
  [[ -f "$png" ]] || die "no such image: $png"
  if [[ -z "$id" ]]; then
    id=$(tmux list-clients -F '#{client_activity} #{client_session}' 2>/dev/null \
           | sort -rn | awk 'NR==1{print $2}' | sed 's/^cc-//')
    [[ -n "$id" ]] || die "no attached cc session (attach with 'cc <wrapper> <project>', or pass an id)"
  fi
  _alive "$id" || die "session not alive: $id"
  local dir="$HOME/.cc-clips/$id"; mkdir -p "$dir"
  local dest; dest="$(_clip_dest "$dir" "$png")"
  mv -f "$png" "$dest"
  tmux send-keys -t "$(_tmux "$id")" -l "$dest "
  echo "clip -> $dest (injected into $id)"
}

# Guard so the script can be `source`d by tests without running a command.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
case "${1:-}" in
  start)     shift; cmd_start "$@" ;;
  ensure)    shift; cmd_ensure "$@" ;;
  supervise) shift; cmd_supervise "$@" ;;
  enable)    shift; cmd_enable "$@" ;;
  stop)      shift; cmd_stop "$@" ;;
  swap)      shift; cmd_swap "$@" ;;
  swap-self) shift; cmd_swap_self "$@" ;;
  prefer)    shift; cmd_prefer "$@" ;;
  ls|list)   cmd_ls ;;
  menu|pick) cmd_menu ;;
  attach)    shift; cmd_attach "$@" ;;
  clip)      shift; cmd_clip "$@" ;;
  ws-add)    shift; cmd_ws_add "$@" ;;
  ws-rm)     shift; cmd_ws_rm "$@" ;;
  ws-rename) shift; cmd_ws_rename "$@" ;;
  ws-gc)     shift; cmd_ws_gc "$@" ;;
  caps)       shift; cmd_caps "$@" ;;
  ws-archive) shift; cmd_ws_archive "$@" ;;
  ws-restore) shift; cmd_ws_restore "$@" ;;
  ws-attic)   shift; cmd_ws_attic "$@" ;;
  ws-audit)   shift; cmd_ws_audit "$@" ;;
  ws-reap)   shift; cmd_ws_reap "$@" ;;
  pr-open)   shift; cmd_pr_open "$@" ;;
  pr-state)  shift; cmd_pr_state "$@" ;;
  *) echo "usage: ccd {start|ensure|supervise|enable|stop|swap|swap-self|prefer|ls|menu|attach|clip|caps|ws-add|ws-rm|ws-rename|ws-gc|ws-archive|ws-restore|ws-attic|ws-audit|ws-reap|pr-open|pr-state} <args>" >&2; exit 1 ;;
esac
fi
