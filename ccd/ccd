    # assignment, hand-edited — leaves the `declare -p` gate below succeeding
    # against the stale inherited value, and this function answers from the very
    # snapshot it exists to correct. `ccrc`'s copy of this idiom needs no unset
    # because that process never sources the projection into its own shell; it
    # is specifically HERE that the variable is pre-set.
    unset -v CCRC_ACCOUNTS
    # Source-time stdout is not the id channel: a projection that prints is a
    # projection whose output would otherwise be read back as an account name.
    { . "$CCRC_ACCOUNTS_SH" >/dev/null 2>&1; } || exit 1
    declare -p CCRC_ACCOUNTS 2>/dev/null | grep -q '^declare -a ' || exit 1
    for v in ${CCRC_ACCOUNTS[@]+"${CCRC_ACCOUNTS[@]}"}; do printf '%s\n' "$v"; done
  )" || return 2
  while IFS= read -r v; do [[ "$v" == "$w" ]] && return 0; done <<<"$listed"
  return 1
}

# FAIL CLOSED on an unreadable projection, and that is a deliberate asymmetry
# with the startup path: ccd already refuses to run at all without a sourceable
# `accounts.sh`, so the only process that can reach this branch is one that was
# started while the file was good. Writing an account name on the strength of a
# roster nobody can read is the one answer that cannot be right.
#
# `$2` IS THE CALLER'S CLAUSE — what this verb was about to do, and what it is
# leaving behind. The five call sites reach here holding very different things:
# `cmd_swap`'s pre-flight has touched nothing, while `cmd_ws_add` already has a
# worktree and a branch on disk.
_account_still_rostered() {   # <wrapper> <what-still-stands>
  local w="$1" stands="$2" rc=0
  _wrapper_rostered_now "$w" || rc=$?
  case "$rc" in
    0) return 0 ;;
    1) die "account '$w' is no longer in the roster — it was there when this ccd started, so a 'ccrc account remove' landed while this command was running. Read the roster with 'ccrc account roster', pick an account that is still in it, then retry. $stands" ;;
    *) die "could not re-read $CCRC_ACCOUNTS_SH, so this command cannot prove account '$w' still exists — regenerate it: ccrc install. $stands" ;;
  esac
}
# The placement half of the same question, and the general form of every rule
# below that used to say `gpt`: an account that is not home-able is one a
# session is never PLACED on and never seeded with as HOME. It may still be
# rotated onto as overflow — that is `_default_pool`'s question, not this one.
_is_home_able() { local w="$1" v; for v in "${CCRC_HOME_ABLE[@]}"; do [[ "$w" == "$v" ]] && return 0; done; return 1; }

# WHERE WORK MAY GO is not WHAT THE LANE SPEAKS. `_is_home_able` answers the
# first; until a Codex lane became placeable, it accidentally answered the
# second too, because every home-able account was an Anthropic one. Four callers
# below want the SECOND question — Remote Control, the spawn-time effort
# injection, the cross-backend transcript sanitiser, and the 429 exclusion
# writer — and each states a BACKEND reason in its own comment while testing
# placement. Give them the question they mean.
#
# FALLS BACK TO `_is_home_able` when the array is absent, which is exactly the
# behaviour every one of those four had before this existed: a box whose
# `accounts.sh` predates this field keeps working unchanged until the next
# `ccrc wrappers` regenerates it.
_is_anthropic_backend() {
  local w="$1" v
  # `declare -p`, not `${CCRC_ANTHROPIC_BACKEND+x}`: for an ARRAY the latter tests
  # ELEMENT 0, so a declared-but-empty array would read as absent and take the
  # fallback. A roster that declares no Anthropic account at all must answer "no"
  # for every lane — the fallback is for an accounts.sh that predates the field,
  # which is a different thing from a roster that has nothing to put in it.
  declare -p CCRC_ANTHROPIC_BACKEND >/dev/null 2>&1 || { _is_home_able "$w"; return $?; }
  for v in "${CCRC_ANTHROPIC_BACKEND[@]}"; do [[ "$w" == "$v" ]] && return 0; done
  return 1
}
# THE OTHER NAMED BACKEND. Not the complement of `_is_anthropic_backend`: the
# roster's `telemetry` field has three values, and a lane whose telemetry is
# `none` is neither Anthropic nor Codex. Asking "is it Codex" as "is it not
# Anthropic" would hand Codex's usage prose — weekly caps, ccgpt-usage's JSON,
# a 5h cooldown countdown — to the first lane added on any third backend, which
# is the exact mistake `_codex_lane_status`'s header warns about.
#
# THE FALLBACK IS `gpt`, NOT `_is_home_able`. Same deploy window as above (a new
# ccd over an accounts.sh that predates the field), but the honest answer is
# different: before CCRC_CODEX_BACKEND existed there was exactly one Codex lane
# and every caller here spelled it `gpt`, so reproducing that is what "behave as
# this box behaved yesterday" means. Reusing the Anthropic fallback would claim
# every home-able account speaks Codex.
_is_codex_backend() {
  local w="$1" v
  declare -p CCRC_CODEX_BACKEND >/dev/null 2>&1 || { [[ "$w" == gpt ]]; return $?; }
  for v in "${CCRC_CODEX_BACKEND[@]}"; do [[ "$w" == "$v" ]] && return 0; done
  return 1
}
# The same membership, enumerated rather than tested, for the one caller that
# needs to walk the lanes instead of asking about one. `printf '%s\n'` with an
# EMPTY array prints a blank line rather than nothing, which would feed the
# reader a lane whose name is the empty string — hence the count guard.
_codex_lanes() {
  declare -p CCRC_CODEX_BACKEND >/dev/null 2>&1 || { echo gpt; return 0; }
  (( ${#CCRC_CODEX_BACKEND[@]} )) || return 0
  printf '%s\n' "${CCRC_CODEX_BACKEND[@]}"
}
# THE ACCOUNT SIDE of the pool rule. `_ccrc_pool` is generated into
# `~/.ccrc/accounts.sh` (shared/generate.mjs) with one `case` arm per TAGGED
# account, so its contract is "empty stdout, rc 0, for an untagged or unknown
# id" — `_ccrc_cfg_dir`'s rule, and the caller decides what silence means.
#
# THE `declare -F` GUARD IS WHY A NEW ccd RUNS OVER AN OLD accounts.sh. During
# the minutes between the roster lane and the ccd lane of an agent deploy, and
# on any box whose roster was never regenerated, the function does not exist.
# Under `set -uo pipefail` with no `-e`, `declare -F` on an undefined function
# short-circuits cleanly, no array is touched, and every account reads as
# untagged — today's behaviour, with no `command not found` on stderr and no
# rc 127 leaking into a `$(…)` capture.
_acct_pool() { declare -F _ccrc_pool >/dev/null 2>&1 && _ccrc_pool "$1"; return 0; }
# Item 5 (I3, wave-1 fix round A) — whether THIS box has a control plane BY
# CONFIGURATION, measured the ONLY honest way: is `ccd-pool-sync.timer`'s
# unit file actually installed. NEVER `$REG/pool-epoch`'s own absence — that
# is the condition `_acct_pool_state` (below) must still tell apart from
# THIS one, because they call for opposite answers. `ccrc:10131-10132`
# (`_inst_units`) derives the timer's install from `[ "$INST_ROLE" = fleet ]`
# alone (T4-R1's own ruling: copying a sibling unit's `!= server` gate would
# leave the single-box DEFAULT role arming a timer whose binary can never
# succeed there — `ccd-pool-sync:52` refuses outright without
# `$HOME/.ccrc/agent.env`, which only `--role fleet`'s install ever writes).
# `INST_ROLE` itself is an installer-local variable inside a DIFFERENT
# script (`ccrc`), unreadable from here, so this re-measures the INSTALLED
# ARTIFACT that decision left on disk instead — the identical filesystem
# fact `ccrc-doctor-checks`' `_check_services` reads to build its own
# `installed` census (`CCRC_UNIT_DIR`/`_dr_unit_file`, doctor item 4's own
# fix, same round). The darwin arm reuses `_svc_plist`/`_svc_label` (above)
# rather than restating their translation; the linux arm matches
# `_check_services`' own path because there is no `_svc_*` helper for a
# plain systemd unit FILE's location (only for its ACTIVE state).
_pool_sync_installed() {
  if [ "${CCD_OS:-linux}" = darwin ]; then
    [ -f "$(_svc_plist ccd-pool-sync.timer)" ]
  else
    [ -f "$HOME/.config/systemd/user/ccd-pool-sync.timer" ]
  fi
}
# THE ACCOUNT SIDE'S STATE, and the reason it is not `_acct_pool`'s shape.
#
# `_acct_pool` answers a NAME or empty, and empty means untagged — which was
# honest while the only carrier was the roster, a file that is either present
# or the box has no accounts at all. The projection is different: it can be
# ABSENT (this node has never synced), STALE (the control plane has been
# unreachable longer than the lease) or MALFORMED, and all three mean NOBODY
# DECIDES. Folding any of them into "untagged" would silently lift every
# account constraint on the box, which is the fail-OPEN direction and the one
# outcome the whole design exists to prevent (spec §5.4).
#
# FIVE WORDS, NOT FOUR. `stale` does not fold into `unreadable`: both mean
# nobody decides, but one's remedy is file permissions and the other's is the
# control-plane link, and the die message a human reads has to say which.
# An adapter may not narrow a distinction it received.
#
# A THIRD REMEDY NOW SHARES `unreadable`'s WORD, SINCE T1-R4 (fix round 3):
# an empty or absent id also answers `unreadable`, and its fix is neither
# file permissions nor the control-plane link — it is "fix the caller, the
# subject is unnameable." Nothing here is fail-open (every caller still
# routes `unreadable` to refuse, the same as the other two causes), but an
# operator reading `unreadable` off a die message and reaching for `chmod`
# will find a perfectly readable file when the real fault was upstream.
#
# NO PROCESS-LOCAL MEMOISATION, ON PURPOSE (fix round 1, T1-R1 — this reader
# cached through a load flag and an associative array for one review round;
# both are gone). The reviewer measured why: `_pool_ok`'s ONLY caller shape
# for the account side is `ap=$(_acct_pool "$1")` (`_pool_ok`, below) — a
# COMMAND SUBSTITUTION, which forks a SUBSHELL. A cache built inside that
# subshell dies with it; the parent's own "loaded" flag never moves off 0,
# so every call would still pay the full read AND carry dead state nobody
# ever reads back. Priming the cache with a direct, non-subshell call first
# would be worse, not better: `_pool_ok` is reachable from
# `_auto_swap_check`, itself polled every tick from inside `cmd_supervise` —
# a loop that supervises one session for DAYS — so a `now` and a `lease`
# frozen at the first call would never notice the lease expiring or a
# resynced projection landing. Reading and parsing the file on every call is
# the correct cost, not a compromise; I3 below is what keeps that cost
# bounded.
_acct_pool_state() {   # account-id -> "named <n>" | untagged | unreadable | malformed | stale ; always rc 0
  # THIS FUNCTION'S OWN REASON FOR THE SHADOW (fix round 1, M1) — the earlier
  # comment here credited it with a trailing strip this function never had,
  # and with keeping `_pool_name_valid`'s locale honest, which that function
  # already does for itself (`local LC_ALL=C` at :1588, independent of
  # whatever the caller set — a false comment is worse than none). What IS
  # locale-sensitive here: the bounded read below uses `-n 65536` as a BYTE
  # cap, the same reason `_project_pool_state` gives for its own `-n 64`
  # (D-2520) — under a multi-byte locale `-n` counts CHARACTERS, not bytes,
  # and the cap's whole job (I3) is bounding what one `cmd_supervise` tick
  # reads off disk regardless of what is in it.
  local LC_ALL=C
  # FIRST PREDICATE, deliberately — mirrors `_project_pool_state`'s own
  # first line (:1675) in POSITION and fixes fix round 1's I5 (without this,
  # indexing an unset `$1` printed `bad array subscript` to stderr and fell
  # through regardless — and in a `$( )` capture that stderr leaks straight
  # into the supervisor's own output) — but NOT in VERDICT (T1-R4, fix round
  # 3). The sibling answers `untagged` here because a registry row with no
  # `.project` field genuinely, positively carries no project — that is what
  # the absence MEANS. An account this function cannot even NAME is a
  # different thing entirely: UNMEASURABLE, not untagged. Measured against
  # an EXPIRED document on disk: an absent id answered `untagged` while a
  # real id on the very same document answered `stale` — the clearest
  # violation there is of "no input yields a positive word without a
  # document that says so." `unreadable` is the fail-SHUT direction (routes
  # to undecidable -> refuse in every caller) and reuses the existing
  # five-word vocabulary rather than inventing a sixth word for what is
  # really a caller bug, not a fact about the document.
  [[ -n "${1-}" ]] || { echo unreadable; return 0; }
  local id="$1" f="$REG/pool-epoch" line k v p epoch='' issued='' lease='' now body=''
  local found='' numRe='^(0|[1-9][0-9]*)$'
  # SEEN, NOT EMPTY (fix round 3) — three separate booleans, one per numeric
  # field, replacing the old "the variable is still empty" proxy for "not
  # seen yet". That proxy had a hole: a line spelled `lease` alone, or
  # `lease ` (key, separator, nothing) — a MALFORMED row, not a legal
  # zero — sets `$lease` to the empty string, which reads IDENTICALLY to
  # "never saw a lease line" to `[[ -z "$lease" ]]`. A second, real `lease
  # <n>` line then passed the (broken) dup check and silently overwrote it:
  # two defects in one hole — a duplicate that should refuse now silently
  # wins, AND a malformed empty row that should refuse is silently
  # discarded, the C1/C4 class one more field over. Measured: `lease
  # \nlease 9999999999\n…` answered `named pool-a`. Bounded: it cannot
  # resurrect an expired document, because a non-empty REAL value still
  # trips its own dup guard the same way.
  local epochSeen='' issuedSeen='' leaseSeen='' endSeen=''
  local -A seen=()
  # ABSENCE PROVEN AT EVERY LEVEL IT IS CLAIMED, exactly as
  # `_project_pool_state` does it one directory down.
  [[ -d "$REG" && -x "$REG" ]] || { echo unreadable; return 0; }
  # Item 5 (I3, wave-1 fix round A) — ABSENCE OF THE FILE ITSELF, split from
  # every other reason this function answers `unreadable`, is the ONE
  # branch a non-fleet box's missing control plane changes: `--role both`/
  # `--role server` (the single-box default) never gets `ccd-pool-sync.timer`
  # installed at all (`ccrc:10131-10132`, T4-R1), so THIS node's absence is
  # not "has not synced yet" — it is "was never asked to", the fail-shut
  # answer `main` never gave before this feature existed. Falls back to the
  # DECLARED tag (`_acct_pool`), exactly as `main` did, ONLY for that box; a
  # FLEET box (`_pool_sync_installed`) still fails shut on the identical
  # absence, because THERE it means "has never synced" — the fact
  # `_acct_pool_state`'s own five-word vocabulary exists to distinguish from
  # every declared-tag guess. The `-r`/malformed/permission checks just below
  # are UNCHANGED and still fail shut regardless of role: an unreadable or
  # torn document is never "this box was never asked", on either box.
  if [[ ! -e "$f" && ! -L "$f" ]] && ! _pool_sync_installed; then
    local declared; declared="$(_acct_pool "$id")"
    if [[ -n "$declared" ]]; then echo "named $declared"; else echo untagged; fi
    return 0
  fi
  [[ -e "$f" || -L "$f" ]]     || { echo unreadable; return 0; }
  [[ -f "$f" && -r "$f" ]]     || { echo unreadable; return 0; }
  # BOUNDED, NUL-AWARE, NO SUBSHELL — the same move `_project_pool_state`
  # makes (:1736-1793), adapted for a MULTI-LINE document instead of one
  # token: `read -d ''` treats NUL as the field terminator, so a NUL found
  # before EOF (fix round 1's I2 — `acct acct-a pool\0-a` fabricates the
  # token `pool-a`, which appears NOWHERE in the file, because bash drops
  # the NUL when the string is later used — this read is what actually SEES
  # it) and the `-n` cap being reached before EOF (I3 — this file is one
  # symlink away from an unbounded one, exactly like `pools/<project>`, and
  # the wave-1 measurement clocked an unbounded read at 17.9s/33MB RSS for
  # ONE call on the supervisor's 5-second tick) report the SAME exit status:
  # 0, "stopped short of EOF" — both illegal, both answered `malformed`,
  # neither ever `untagged`. 65536 (64 KiB) is chosen the same way the
  # sibling chose 64: a legal row is `acct <=32-char id> <=32-char pool>\n`,
  # under 70 bytes, so 64 KiB holds 900+ accounts — an order of magnitude
  # past any fleet this file is sized for — while still refusing a
  # multi-megabyte runaway file outright. M6 — THE CAP IS STRICT, not
  # inclusive: `-n 65536` means a document of EXACTLY 65536 bytes also
  # "stops short of EOF" (measured) and is refused along with everything
  # larger, so the true accepted range is bytes 0..65535, under 64 KiB, not
  # up to and including it.
  if { IFS= read -r -d '' -n 65536 body; } 2>/dev/null < "$f"; then
    echo malformed; return 0
  fi
  # I6, DISCLOSED — same choice the sibling makes at :1794-1797, for the
  # same reason: `read -d ''` returns 1 (the "proceed" branch above) both
  # for a clean EOF with no NUL and for a read that FAILED before reaching
  # EOF or the cap, and bash's `read` builtin exposes no way to tell those
  # apart. Closing it would need a mechanism this builtin does not have; a
  # failure here reads as "a small, clean document" and is parsed as one.
  # Unlike the OLD shape (`done < "$f" ... || unreadable`), this is not
  # merely UNCHECKED — `$?` from the read above IS the check — it is the
  # one ambiguity that checking it cannot resolve, named rather than hidden.
  # NARROWED, THOUGH NOT CLOSED, BY THE TERMINATOR CHECK BELOW: a genuine
  # I/O failure mid-read leaves `$body` holding whatever prefix survived,
  # and that prefix is now refused UNLESS it happens to end in a complete
  # `...\nend` — a coincidence, not a case this reader can rule out, but one
  # a real I/O error landing exactly on a field boundary is vanishingly
  # unlikely to produce.
  #
  # M5 / T1-R3 — THE PARK THIS FUNCTION USED TO HAVE, NOW A GUARD, NOT A
  # DISCLOSURE. Round 1's I6 named ONE outcome a truncated read could
  # produce (`untagged`, the queried id simply absent from whatever prefix
  # survived) and missed the WORSE one round 2 measured: `acct acct-a
  # pool-alp` with no trailing newline — a row torn mid-write — answered
  # the POSITIVE `named pool-alp`, a pool the file never finished spelling,
  # with PLACEMENT proceeding onto it. That is the sibling's OWN second,
  # worse park (:1803-1812, "the answer is the POSITIVE `named <prefix>`
  # … PLACEMENT PROCEEDS"), which is exactly why ITS discipline is "TWO
  # ARMS, TWO PARKS — do not conflate them" — this function had conflated
  # them into one named word.
  #
  # T1-R3 closes both STRUCTURALLY instead of naming a second park: the
  # wire format now ends every document with a literal `end` line (Task
  # 3's emitter writes it the same round this reader starts requiring it),
  # and ANY document whose last line is not exactly `end` is refused before
  # a single field is parsed. A line-oriented reader has no other way to
  # tell a torn final row from a complete one. Zero `acct` lines is still
  # legal, so the minimum well-formed document is four lines: epoch,
  # issued, lease, end. STRUCTURAL, not per-field: checked once against the
  # RAW bounded body, so a torn document — whether the tear lands mid-`acct`
  # row (round 2's worse park) or mid `epoch`/`issued`/`lease` (round 1's
  # named one) — is refused the same way, before the per-line parser below
  # ever runs. The terminator counts toward the 64 KiB budget: it was
  # already inside the bounded read above, not appended after it.
  #
  # ONE trailing newline is tolerated (the writer's own convention, matching
  # every other line in this format) but not required — a `$body` ending in
  # `...end` with no final `\n` is accepted for the same reason the
  # per-line loop below already tolerates a final line with none. A SECOND
  # trailing newline (content after the terminator, even if blank) is
  # refused: the last LINE must be `end`, and an empty final line is not it.
  local tail="$body"
  [[ "$tail" == *$'\n' ]] && tail="${tail%$'\n'}"
  [[ "${tail##*$'\n'}" == end ]] || { echo malformed; return 0; }
  while IFS= read -r line || [[ -n "$line" ]]; do
    # C1 — an indented line is a line this reader cannot KEY AT ALL, not a
    # blank one, and must not fall into the blank-line no-op. `k` is
    # computed FIRST (harmless even for a genuinely blank line — it just
    # comes out empty) so the skip decision below can be made on `$line`
    # itself, the RAW input, rather than on the derived `$k`: those two are
    # NOT the same test. ` acct acct-a pool-a` (one leading space) is not an
    # empty line, but `k=${line%% *}` on it still yields the empty string —
    # the pattern " *" matches the WHOLE line as its own longest suffix —
    # and the old code tested `$k` for this decision, so it read that empty
    # key as the blank-line marker and silently dropped the row, leaving
    # `acct-a` `untagged`: the fail-OPEN direction the whole design exists
    # to prevent. Testing `$line` instead means a non-blank line that still
    # keys empty falls through to the `case` below unskipped, where the
    # `*)` wildcard — there is no `''` arm — refuses it as `malformed`,
    # exactly like any other key this reader does not recognise.
    k=${line%% *}
    [[ -z "$line" ]] && continue
    v=${line#* }
    case "$k" in
      epoch)  # M7 — a SECOND `epoch` line is the same self-contradiction
              # M3 catches for `acct` rows: nothing says which value is
              # true. The dedicated `epochSeen` flag (not `-z "$epoch"`,
              # fix round 3 — see the comment on the flags above) is set
              # unconditionally, regardless of what `$v` turns out to be.
              [[ -z "$epochSeen" ]] || { echo malformed; return 0; }
              epochSeen=1
              epoch=$v ;;
      # R3's wire format carries an `issued` line (the projection's own
      # issuedAt) between `epoch` and `lease`; this reader has no use for it
      # in any decision, but fix round 1's M2 asks the same question of it
      # that `epoch` already answers — validated numeric below, not merely
      # accepted — so a torn or hand-edited `issued` field poisons the
      # document exactly like a torn `epoch` does, rather than passing
      # silently because nothing downstream happened to read it.
      issued) [[ -z "$issuedSeen" ]] || { echo malformed; return 0; }
              issuedSeen=1
              issued=$v ;;
      lease)  [[ -z "$leaseSeen" ]] || { echo malformed; return 0; }
              leaseSeen=1
              lease=$v ;;
      acct)   # I4 — a row missing its pool field (`acct acct-a`, or a bare
              # `acct` with nothing after it at all) leaves `v` as a SINGLE
              # token: `${v#* }` with no space to strip returns the string
              # unchanged, so the old code handed `_pool_name_valid` the
              # ACCOUNT ID itself (or the literal word `acct`) as if it
              # were the pool name — both happen to be legal-looking tokens,
              # so a truncated row fabricated a tag. Require a SECOND field
              # to exist before ever splitting on it.
              [[ "$v" == *' '* ]] || { echo malformed; return 0; }
              p=${v#* }; v=${v%% *}
              # C2 / C4 — the id field was validated against NO grammar at
              # all: `acct␣␣pool-a` (two spaces) leaves `v` EMPTY after the
              # split above (`${v%% *}` on a value that is itself all
              # leading whitespace strips the whole thing), and
              # `seen[$v]=1`/`${seen[$v]+x}` with an empty subscript is
              # `bad array subscript` — a hard bash error that unwinds the
              # WHOLE FUNCTION, breaking the "always rc 0" contract outright
              # (measured: empty stdout, rc 1). An off-grammar but non-empty
              # id (a tab, `ACCT-A`, a quoted or globby id) had NO check at
              # all and silently discarded the row, reading the account
              # `untagged` — C1's exact defect, one field to the right, and
              # a direct contradiction of the very next comment below, which
              # already treats the POOL half of this same row as
              # poison-the-document. `^[A-Za-z0-9._-]{1,64}$` — MUST agree
              # with Task 3's `ccd-pool-sync` writer, which validates an
              # account id against this identical pattern before it ever
              # renders a line (`re.match(r"^[A-Za-z0-9._-]{1,64}$", k)`) —
              # a disagreement between the two would mean one side emits
              # rows the other refuses. `{1,64}` requires AT LEAST one
              # character, so this one check closes C2 (empty id) as a
              # special case of C4 (off-grammar id) rather than needing a
              # second, separate emptiness check — verified: `[[ "" =~
              # ^[A-Za-z0-9._-]{1,64}$ ]]` is false.
              [[ "$v" =~ ^[A-Za-z0-9._-]{1,64}$ ]] || { echo malformed; return 0; }
              # A name off the grammar poisons the WHOLE document: a reader
              # that skipped the bad row would serve the rest under a tag it
              # could not validate.
              _pool_name_valid "$p" || { echo malformed; return 0; }
              # M3 — a SECOND `acct` row for an id already seen makes the
              # document self-contradictory (nothing says which row is
              # true, so honouring either — first-win or last-win — would
              # fabricate an agreement the file never actually stated) and
              # poisons the whole document exactly like an unparseable row
              # does, even when the two rows happen to agree: the CONTRACT
              # this file is built to ("one row per account") is what
              # broke, not merely this one account's answer.
              [[ -z "${seen[$v]+x}" ]] || { echo malformed; return 0; }
              seen[$v]=1
              [[ "$v" == "$id" ]] && found=$p ;;
      end)    # T1-R3 — the terminator, position AND cardinality both
              # pinned (security-scanner addendum). The up-front structural
              # check above already proved the RAW body's last line is
              # exactly `end`, which rules out a torn final row, but NOT a
              # SECOND `end` earlier in the document — `epoch…/end/acct
              # acct-a pool-a/end` is two documents concatenated (or a torn
              # write landing inside a previous one), and the structural
              # check alone cannot see it: it only ever looks at the last
              # line. `endSeen` is that count: a bare, otherwise-legal
              # `end`-KEYED line is refused the second time it appears,
              # wherever it is.
              #
              # NO SEPARATE `[[ "$v" == end ]]` CHECK — deliberately, not an
              # oversight: it was added for `end 1` / `end ` (the
              # terminator takes no argument) and proved fully redundant by
              # exhaustive case split, the same shape as fix round 1's C1
              # (`-n "$k"` dropped once `*)` already covered it). A line
              # keying as `end` is EITHER the document's true last line —
              # already caught above if its value is not exactly `end` —
              # OR it is not, in which case a GENUINE bare `end` must still
              # exist as the true last line for the structural check to
              # have passed at all, and THAT is the line `endSeen` refuses
              # as the second `end`-keyed line. There is no placement of an
              # `end`-with-a-value row this reaches without one of those two
              # guards already deciding it.
              [[ -z "$endSeen" ]] || { echo malformed; return 0; }
              endSeen=1 ;;
      *)      echo malformed; return 0 ;;
    esac
  done <<< "$body"
  # No epoch (or, since M2, issued/lease) line is not an empty document — it
  # is a document this reader does not recognise, and recognising it
  # partially is how a stale format gets served as fact.
  #
  # C3 — `^[0-9]+$` PERMITS A LEADING ZERO, and `(( ))` treats a leading-zero
  # operand as OCTAL: a document saying `lease 0000000009` (expired in 1970)
  # threw `value too great for base` on the digit `9` and then, because that
  # arithmetic error does not abort this function the way an array-subscript
  # error does, fell straight through past the stale gate to `named <n>` —
  # serving an expired tag as current. Fixed IN THE GRAMMAR, not only the
  # arithmetic: `%d` is what the (future) writer emits, and `%d` can never
  # produce a leading zero, so `^(0|[1-9][0-9]*)$` — zero, or a non-zero
  # digit followed by any digits — IS the true grammar for all three numeric
  # fields, spelled ONCE and reused, rather than duplicated three times only
  # to drift. `10#` at the one place a value reaches `(( ))` is defence IN
  # DEPTH, not the primary fix: it forces base-10 even if some future caller
  # of `lease` bypassed this validation.
  [[ "$epoch"  =~ $numRe ]] || { echo malformed; return 0; }
  [[ "$issued" =~ $numRe ]] || { echo malformed; return 0; }
  [[ "$lease"  =~ $numRe ]] || { echo malformed; return 0; }
  # CLOCK SKEW, NAMED (item 10): `$lease` is an ABSOLUTE unix-seconds
  # timestamp the SERVER box issued (`server.ts`'s `nowS + POOL_LEASE_MS`),
  # compared here against THIS (fleet) box's own `date +%s` — nothing
  # resynchronises the two clocks in between. Skew between the two boxes
  # therefore shifts the whole staleness dial directly: a fleet box running
  # fast calls the projection stale early, one running slow keeps serving it
  # past the server's own idea of the lease. Not this function's to fix —
  # NTP-typical skew is noise against the default 15-minute lease — but
  # nothing said so before this comment.
  now=$(date +%s)
  (( now > 10#$lease )) && { echo stale; return 0; }
  # An account the document does not name is UNTAGGED, not unknown: the
  # document is complete by construction (the control plane always emits every
  # edge it holds), so silence about an account is a positive statement that
  # it carries no pool. This is the one fold that is honest here.
  [[ -n "$found" ]] || { echo untagged; return 0; }
  echo "named $found"
}
