# ── THE PERMANENT STABLE LOCK, ccd's side (D-2605, spec §3.4) ────────────
# The SAME `$REG/.<id>.compactions.lock` inode the hook takes, reached through
# the same protocol, because the thing being excluded is a compaction-artifact
# publisher and the hook is the other one. ccd carries its OWN literal of the
# bound rather than sourcing the hook's: the two files ship as separate
# `install_atomic` targets, so a shared spelling would have a window where one
# side carries it and the other does not. They are TWINNED and pinned
# value-equal over the bash corpus.
COMPACT_LOCK_WAIT=5

# The `link`-off-canonical, open-the-alias, unlink-the-alias protocol, spelled
# once. Canonical is NEVER opened at its own pathname — `exec {fd}<>"$lock"` is
# create-capable, and two racers each creating a different inode at one
# pathname would each be told by `flock` that they hold "the" lock.
#
# rc 2 is MECHANISM ABSENCE, established by `command -v flock` BEFORE any
# acquire is attempted; rc 1 is an ordinary refusal or a timeout. Measured,
# both a contended `flock -w` and a missing binary spell their failure `1`, so
# the distinction can live only in WHICH probe answered. The two conditions
# have DIFFERENT callers' rulings (§3.4, "Platform outcome"), which is why they
# may not be folded together here.
_compact_lock_same() {   # <fd> <canonical> -> 0 iff one regular inode. `-ef` (dev+ino) decides through /proc; through /dev/fd — Darwin, MEASURED on macOS 25.6 arm64: stat(/dev/fd/N) answers the fdesc DEVICE (1245178674) with the file's inode, stat(lock) 16777230 — dev differs, so the inode alone decides there (`ls -i` is POSIX, so no platform arm is needed).
  local fd="$1" lock="$2" p="" a="" b=""   # `a`/`b` declared here (F20, review 71): both were assigned bare below, leaking into the caller's scope
  if [ -e "/proc/self/fd/$fd" ]; then p="/proc/self/fd/$fd"
  elif [ -e "/dev/fd/$fd" ]; then p="/dev/fd/$fd"
  else return 1; fi
  [[ -f "$p" ]] || return 1
  [[ -f "$lock" && ! -L "$lock" ]] || return 1
  [[ "$p" -ef "$lock" ]] || { [[ "$p" != /proc/* ]] && a=$(ls -i -- "$p" 2>/dev/null) && b=$(ls -i -- "$lock" 2>/dev/null) && [[ -n "${a%% *}" && "${a%% *}" == "${b%% *}" ]]; } || return 1
  return 0
}

# THE CCD-SIDE TWIN of `_hook_lock_vanished` (`ccd/session-hook.sh`), which
# carries the full argument and the measurements. In short: §4 requires a later
# canonical disappearance to REFUSE rather than mint a second inode at the same
# pathname under a live holder, and the two conditions are only distinguishable
# by finding the holder. (a) an acquisition in flight still has its exact-family
# alias on disk; (b) a holder past its acquire has unlinked the alias and keeps
# only a descriptor — MEASURED, `$REG` then lists the canonical file and nothing
# else, while `/proc/<pid>/fd/<n>` reads back that alias pathname with
# ` (deleted)` after it. Gated on an ABSENT canonical, so the `/proc` walk never
# runs on an ordinary acquire.
_compact_lock_vanished() {   # <id> -> 0 iff an ABSENT canonical is a LATER disappearance
  local id="$1" f
  for f in "$REG/.$id.compactions.lock-open."*; do
    { [ -e "$f" ] || [ -L "$f" ]; } && return 0
  done
  # GATED ON A LIVE ROW, then on one `find` rather than a fork per descriptor —
  # the hook-side twin carries the measurements (8 s against 0.16 s on this
  # box). `<id>.generation` absent proves no hook on this row ever held this
  # lock, which is the same argument `_reg_purge`'s own fail-open rests on.
  [ -e "$REG/$id.generation" ] || [ -L "$REG/$id.generation" ] || return 1
  [ -d /proc ] || return 1   # AND WHERE THERE IS NO `/proc`, §4'S RULE IS NOT ENFORCED HERE EITHER — the hook-side twin's own gate carries the full argument and the residue's reasoning. In short: this is the only probe that can see a holder past its acquire, so on a box without `/proc` (Darwin) a later canonical disappearance under a live holder reads as a first-ever mint, the acquire mints a second inode at the one pathname, and `_reg_purge`, `cmd_ws_add`, `cmd_start` and `_spawn_start` all proceed where §4 says they must refuse. Recorded platform residue, not a defect to be papered over: the refusal-side cases are Linux-only and say so.
  command -v find >/dev/null 2>&1 || return 1
  [[ -n "$(find /proc -mindepth 3 -maxdepth 3 -path '/proc/[0-9]*/fd/*' \
             -lname "$REG/.$id.compactions.lock-open.*" -print -quit 2>/dev/null)" ]] || return 1
  return 0
}

