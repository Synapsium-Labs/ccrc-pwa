READER_MIN_COLS=120
STALE_RESUME_GRACE=30            # D-2443 — seconds after a fresh $REG/<id>.stalepress stamp during which _session_hard_blocked's transcript arm stands down, so the same-tick rescue (_auto_swap_check, _tick_strand_undecidable) cannot swap out the continuation the stale-press Enter just submitted before Claude Code has appended the resumed turn's row
TRANSCRIPT_ARM_INTERVAL=30       # D-2444 — seconds a session's positive or negative transcript verdict is reused; the final review measured an uncached arm at ~36 ms, ~14x the pane classifier and mostly in _transcript_path, so this bounds the full scan to once per interval while each positive still rechecks the draft
# Proactive auto-/compact: when an IDLE session's context passes ITS threshold, send /compact
# so it stays lean (the SessionStart(compact) hook restores git/plan/handoff context, so this is
# non-destructive on both the Anthropic and gpt lanes). Only at a clean turn boundary; kill-switch
# via AUTOCOMPACT_DISABLE_FILE.
COMPACT_THRESHOLD=50            # own context % at/above which an idle session auto-compacts, for a
                                # session whose routing record hands `_route_get` no `compact` value —
                                # the field absent, or present and refused by `_route_valid`
                                # (routing spec §5.1; slice 6, Task 5) — the DEFAULT, not the only one
COMPACT_COOLDOWN=1800           # min seconds between auto-compacts of one session (also bounds the post-swap window)
COMPACT_QUIET=60                # seconds a session must be idle before an auto-compact fires (let the dust settle)
COMPACT_TURN_TAIL_LINES=200     # D-3104 — physical transcript lines `_transcript_last_turn_ts` reads for the
                                # no-turn guard. Its OWN window, not `REDRIVE_TAIL_LINES`: a
                                # `/compact` writes FOUR rows of its own (the `isCompactSummary`
                                # row plus the three local-command rows) and the redrive
                                # detector's 60 lines are sized for a stall two turns deep, not
                                # for "reach back PAST a compaction to the last real turn" on a
                                # transcript whose tail is thick with attachment and system rows.
                                # Too small and the scan answers "no real turn in the window",
                                # which this guard FAILS OPEN on — the pre-D-3103 behaviour, never
                                # a false refusal.
COMPACT_LANDING_WALL=80         # D-2014 — the ctx % at/above which the post-swap suppression stops
                                # earning its veto.
                                #
                                # WHAT 80%+ IS NOT: proof that no landing compaction happened. An
                                # earlier draft of this comment said exactly that, and the plan that
                                # issued D-2014 falsifies it — its own incident table measures a
                                # session climbing 45% -> 91.5% in NINE minutes, far inside this
                                # gate's COMPACT_COOLDOWN window, so a session compacted on landing
                                # to ~12% (measured 2026-09-08: 200,130 -> 25,164 tokens) can be
                                # sitting at 80%+ here with the landing compaction having happened
                                # exactly as the old premise assumed. Both worlds reach this line.
                                #
                                # WHAT IT IS: the reading that makes the veto not worth taking in
                                # EITHER world. At 80%+ this session is near its wall NOW, and a
                                # redundant compaction costs ~500s on the gpt lane against a wedge
                                # measured at 80.7 minutes. On 2026-09-08 nine sessions landed on the
                                # gpt lane at 12:12:59 and `calm-river` sat at 98% for thirty minutes
                                # with no landing compaction in its transcript at all — that is the
                                # case this exists for, and the gate does not need to know which case
                                # it is in to decide correctly.
                                #
                                # BELOW this the conservative half survives untouched: a
                                # freshly-landed session at a modest context is still left alone,
                                # because the double-compaction the gate exists to prevent is the
                                # likelier reading there and nothing is at risk while it is wrong.
                                # NOT a second threshold on the compact decision — every gate below
                                # COMPACT_THRESHOLD is unchanged; this only decides whether the
                                # post-swap SUPPRESSION still applies.
COMPACT_NOTE_FLOOR=1800         # D-2013 — min seconds between swap.log lines about ONE session's
                                # compact REFUSALS. THE NUMBER IS A JUDGEMENT; THE LOAD IT BOUNDS IS
                                # THE MEASUREMENT. Measured: the supervisor ticks every 5s across ~20
                                # sessions, so an unfloored note is 12 lines a minute per session and
                                # ~240 across the fleet, into `$REG/swap.log` — a ~4,700-line file
                                # humans read. 1800 is then chosen to match COMPACT_COOLDOWN, so a
                                # refusal is said about as often as a compaction could be; no
                                # experiment ranked it against 300 or 3600, and none is claimed.
                                # See `_compact_note`, which separates the marker from this floor's
                                # anchor the way `_strand_mark`/`_strand_clear` already do — without
                                # that split a reason that FLAPS defeats the floor entirely (measured:
                                # 10 alternating ticks wrote 10 lines, not 1).
                                #
                                # WHO READS `$REG/<id>.compactskip`: a human, off the registry, after
                                # the fact. NOTHING in this tree reads it — not `server/src`,
                                # `agent/src`, `shared` or `pwa/src` (measured 2026-09-08) — and it is
                                # on no wire. It is a post-mortem breadcrumb standing beside
                                # swap.log's floored line, nothing more. If it is ever promoted to a
                                # wire field it needs a reader and the additive-only contract first.
# ── The routing record (routing spec 2026-09-14 §5.1) ───────────────────────
# Seven ordinary registry fields per session, written by `cmd_route` and by ccd
# itself (`degraded`, `inert`), read ONLY through `_route_get` below. The fields
# are a byte channel into an argv and a pane — any session on the box can write
# them (one UNIX user; attribution, not authentication) — so every value is
# validated BY SHAPE at the read, against these closed vocabularies, and the
# failure direction is stated: an unrecognised value behaves as ABSENT and
# leaves a `swap.log` note naming the field and the byte COUNT, never the bytes.
# `subagent` has no list here on purpose: it is validated against
# `CCRC_SUBAGENT_CLASSES`, the roster projection of `shared/models.mjs`'s
# `SUBAGENT_CLASSES`, so this file never holds a third spelling of that list.
# `inert` is a comma list of FIELD NAMES a lane could not apply (`effort`,
# `workflow`, `subagent` — `ROUTE_INERTABLE` below), never a value. So the word
# `subagent` means two different things in this block and both are right: as a
# ROUTE_FIELD it names a class and is checked against `CCRC_SUBAGENT_CLASSES`;
# inside an `inert` list it is the FIELD's name, stamped by a lane that composed
# no `CLAUDE_CODE_SUBAGENT_MODEL` whatever class the field held.
ROUTE_FIELDS=(class effort subagent workflow compact degraded inert)
ROUTE_CLASSES="fable opus sonnet haiku default"
ROUTE_EFFORTS="auto low medium high xhigh max ultracode"
# THE SLIDER'S STOPS, IN THE ORDER THE SLIDER PUTS THEM (D-2808, measured on a
# live pane — not a re-listing of `ROUTE_EFFORTS` for its own sake). The ORDER is
# the measured fact and it is what `_route_type_effort` counts `Right` presses
# against, so this list may not be derived from `ROUTE_EFFORTS` by stripping
# words: that vocabulary is a SET whose order carries no claim, and two of its
# words are not stops at all — `auto` is the absent-equivalent (nothing is
# typed) and `ultracode` has no slider row (its plain form is session-only by
# construction, D-2810). A level that is not a stop is `no-slider-stop`, its own
# refusal word, never a guessed key.
ROUTE_EFFORT_STOPS="low medium high xhigh max"
ROUTE_WORKFLOWS="on off"
ROUTE_INERTABLE="effort workflow subagent"
ROUTE_NOTE_FLOOR=1800           # seconds between route-reject / route-refuse / route-skip notes for one
                                # id+field. EQUAL TO `COMPACT_NOTE_FLOOR` BY CHOICE, NOT BY DERIVATION:
                                # both bound the same load — the 5s supervisor tick across ~20 sessions
                                # writing into the one `$REG/swap.log` a human reads — and each is free
                                # to move without the other. Neither reads the other's constant.
ROUTE_ACK_WAIT=5                # seconds `_route_ack_wait` polls the pane (one `sleep 1` per poll) for
                                # Claude Code's own acknowledgement of a session-only `/effort` or
                                # `/model`. The keystrokes land in under a second on a live pane; this
                                # is the budget for a TUI mid-repaint, not for a session to become idle
                                # — that question was already answered by `_idle_for_keystroke`.
ROUTE_RETRY_BACKOFF=600         # seconds between two attempts to apply the SAME pending field to the
                                # same session (controller ruling S4-R7). The applier types into a LIVE
                                # pane, so an attempt that is never acknowledged — `/effort ultracode`
                                # on a lane launched `{"enableWorkflows":false}`, a class the picker
                                # does not list — is not free the way a skipped log line is: at the 5s
                                # tick it would re-type twelve times a minute for ever. `_route_note`'s
                                # floor bounds the swap.log LINE and nothing else.
ROUTE_RETRY_MAX=3               # attempts at one pending field before the applier gives up and says so
                                # (`apply-gave-up`). Three because the conditions this bounds are
                                # PERMANENT ones — a refused slash command, an absent picker row — and
                                # the transient ones (mid-turn, drafting, a session sitting out a limit)
                                # are refused by the idle predicate and never counted as attempts at all.
                                # The counter is cleared by any `cmd_route` write, by the settle's own
                                # `routeapplied` stamp, and by the pending set becoming empty.
ROUTE_COMPACT_QUIET=30          # seconds after the compactor typed `/compact` into a pane during which
                                # the applier types NOTHING into that pane (final review finding 5).
                                # The supervise tick runs `_auto_compact_check` and `_route_apply_check`
                                # on one line and the compactor signals nothing when it has typed, so
                                # the applier re-asked an idle predicate whose whole answer is a pane
                                # capture and a `sessions/<pid>.json` read — both of which LAG the
                                # keystroke just sent — and typed `/model` on top of a compaction: the
                                # slash command taken as a message, or a half-typed picker draft that
                                # blocks the next tick. The interlock is `lastcompact`, written by
                                # `_auto_compact_check` itself immediately BEFORE its send-keys, so it
                                # holds across PROCESSES as a shell variable could not — `ccd route
                                # --apply` is the operator's own process, not the supervisor's. Far
                                # inside `COMPACT_COOLDOWN`, so no session waits more than one
                                # compaction's settling for a routing change.
# Make `systemctl --user` reachable even from a non-interactive SSH context (no login session
# sets these). Lingering keeps /run/user/$UID alive across logins/reboots.
#
# LINUX ONLY, and the guard is not tidiness. launchd needs neither variable, so
# on macOS these two lines invent a `/run/user/<uid>` path that does not exist —
# and, worse, they FORK `id` to build it on every single ccd invocation. On
# Linux the variable is normally already set, so `${VAR:=default}` never
# evaluates its default and the fork never happens; on macOS it is never set,
# so it happens every time. Measured: with a deliberately stripped PATH that is
# an `id: command not found` on stderr from a file whose contract is to leak
# nothing there (`ccd-lifecycle-emit.test.ts`, `ccd-lifecycle-gen.test.ts`).
if [ "$CCD_OS" != darwin ]; then
  : "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"; export XDG_RUNTIME_DIR
  : "${DBUS_SESSION_BUS_ADDRESS:=unix:path=${XDG_RUNTIME_DIR}/bus}"; export DBUS_SESSION_BUS_ADDRESS
fi

die() { echo "ccd: $*" >&2; exit 1; }

# ── the account roster ──────────────────────────────────────────────────
# Generated from ~/.ccrc/accounts.json by deploy/deploy.sh and by every
# `ccrc install` run. Derived from HOME with NO env override, exactly as REG,
# WRAPPER_DIR, PROJECTS_ROOT and WORKTREES_ROOT are: HOME is the single
# isolation boundary the test harness sets, and an override here would let a
# stray Environment= run a live box against somebody else's account list.
#
# Sourced HERE — after `die` (this file's only error exit) and before the first
# function that reads the roster — rather than beside REG at the top: a `|| die`
# above that definition would call a function that does not exist yet and print
# `die: command not found` in place of the remedy.
#
# ABSENT IS FATAL, deliberately the OPPOSITE of `ccd version`'s answer for a
# missing ~/.ccrc/build.json (which prints "unstamped" at exit 0 and dies only
# on garbage). A missing build stamp costs a label. A missing roster would mean
# silently running a roster that is not the box's: sessions placed on wrappers
# that are not installed, `_cfg_dir` answering with a config dir that holds no
# transcript — the shape of failure that once cost one account six sessions of
# chat. `set -uo pipefail` (line 5, under the shebang and the provenance
# marker) carries no `-e`, so none of the checks below
# aborts on its own; the `die`s are what make it loud, and each is
# load-bearing: the pre-`source` pair catches absent-or-unreadable before
# `source` says anything, and the last one catches a file broken badly enough
# that `source` returns non-zero — which without it would surface hundreds of
# lines later as an unbound-variable error naming CCRC_ACCOUNTS.
#
# MISSING and UNREADABLE are DELIBERATELY DISTINCT, the same discipline
# `loadRoster` (server/src/config.ts) applies to `accounts.json` and for the
# identical reason: a `chmod 000` accounts.sh plainly EXISTS, and telling its
# operator "no account roster — generate it" sends them to a generator that
# will happily rewrite a file whose bytes were never the problem, on a box
# where every ccd invocation is already dying. The remedy for one is `ccrc
# install`; the remedy for the other is chmod/chown, and nothing else.
# (`-e` is false for a DANGLING symlink, so that case reports as missing —
# which is what it is: the roster the link names is not there.)
CCRC_ACCOUNTS_SH="$HOME/.ccrc/accounts.sh"
[[ -e "$CCRC_ACCOUNTS_SH" ]] \
  || die "no account roster at $CCRC_ACCOUNTS_SH — generate it from ~/.ccrc/accounts.json (deploy/deploy.sh, or \`ccrc install\`)"
# D-2377: `-e` and `-r` are not enough on their own — neither is false for a
# FIFO or a character device, and `source` below opens BY NAME: `open(2)`
# blocks FOREVER on a FIFO with no writer. This is not one verb's exposure —
# it is the MODULE TOP LEVEL, so every `ccd` process on the box reaches it:
# every `ccd supervise` unit at startup and at every systemd restart, every
# `ccd` the agent shells out under the exec whitelist (hence every PWA tap),
# every terminal invocation. The two `die` sentences either side of this one
# are the proof this ladder's author meant to refuse rather than hang; it was
# simply missing the arm for a file that is present, readable, and not a
# file — `_project_pool_state`'s pattern (NAMED BY FUNCTION, NOT LINE: "a
# character device gets the one answer that is safe for all of them"),
# copied here as its own arm rather than folded into `-r`, so the two
# existing sentences keep their exact wording. `_wrapper_rostered_now` and
# `cmd_ws_add`'s own home-able snapshot each re-`source` this same path
# inside a subshell helper (`{ . "$CCRC_ACCOUNTS_SH" ...; } || exit 1/9`) and
# inherit this same exposure with no `-f` rung of their own — noted here
# rather than given a second ladder, because this one hangs first on a
# pre-existing FIFO.
#
# THAT ARGUMENT DOES NOT CLOSE THE CLASS, and is not written to (final-round
# item 8): "hangs first" only holds for a caller reached FROM this same
# process, after this module top level has already run. `ccd/ccrc` and
# `ccd/ccrc-doctor-checks` each carry their OWN unguarded `source`/`.` of the
# identical path, in their OWN process, with no ladder of theirs run first —
# each HANGS on a FIFO independently (measured, rc 124), and that includes
# `_check_routing`, which this wave edited. Pre-existing in both, and NOT
# fixed here — disclosed so this paragraph is not read as having closed it.
[[ -f "$CCRC_ACCOUNTS_SH" ]] \
  || die "account roster $CCRC_ACCOUNTS_SH exists but is not a regular file — something else (a FIFO, a device node, a UNIX socket, or a directory) is sitting at that path; remove it, then regenerate: ccrc install. Regenerating it will not help until the path is clear."
[[ -r "$CCRC_ACCOUNTS_SH" ]] \
  || die "account roster $CCRC_ACCOUNTS_SH exists but is not readable by $(id -un) — fix its permissions (it must be readable by the user ccd runs as; the deploy installs it 644). Regenerating it will not help."
# The first `source` this file has ever carried, so there is no in-file
# convention to copy. source=/dev/null is shellcheck's own idiom for a path it
# cannot follow: this one is generated at deploy time and has no in-repo
# counterpart to check against (shared/generate.mjs emits it).
# shellcheck source=/dev/null
source "$CCRC_ACCOUNTS_SH" \
  || die "account roster unreadable: $CCRC_ACCOUNTS_SH — regenerate it from ~/.ccrc/accounts.json"

# ── DOES THIS BOX DRIVE ITS SESSIONS OVER THE RC SOCKET? ──────────────────
# The ONE spelling of the flag path in ccd. `_spawn_start` is its only reader
# here, and THE WRITERS NOW EXIST — both of them seed-once, neither ever
# overwrites, and each has its own reason for the value it picks:
#   `ccrc install` (`_inst_rc`)  — seeds `off`. A fresh single-box install has
#     made no claim on claude.ai and must not start publishing sessions there
#     because an installer defaulted it.
#   `deploy/deploy.sh`, agent lane — seeds `on`, in the agent branch, ORDERED
#     BEFORE the ccd install below it. That box has run every session with
#     `--remote-control` since before this flag existed, so the file describes
#     it rather than deciding something new about it.
# Their spelling of this path is their own — `ccd/ccrc` cannot source this file
# and neither can `deploy.sh` — and `server/test/single-definition.test.ts`
# holds all four literals (with `ccrc-doctor-checks`') equal.
#
# THE ORDERING IS THE LIVE FACT TO KEEP: the flag must be seeded BEFORE this
# ccd lands on a box. Absent reads OFF, so the gap between a new ccd and an
# unseeded box is a window in which a respawn strips `--remote-control` from a
# live session. The standing AGENT-FIRST rule (a change under `ccd/` goes to
# the fleet host before the server) is what would open that window, which is
# why deploy seeds within the same run and before its own installs;
# `agent/test/deploy-verify.test.ts` pins that order, and D-99 in the stage-2e
# plan records what it is protecting.
CCRC_RC_FILE="$HOME/.ccrc/remote-control"
_rc_enabled() {   # first line 'on' => sessions spawn with --remote-control.
  # A FILE, not an env var (HOME is ccd's only isolation boundary — see
  # SPAWN_GATE_TRIES) and not ccrc.env (never read by ccd: it carries tokens,
  # and the fleet host does not have one). Absent or anything-but-'on' is OFF:
  # a garbled file must not half-enable a mode. The file is OPERATOR-OWNED —
  # seeded once by whichever lane installed the box and never rewritten after —
  # so an edit here survives every later install and deploy. `ccrc doctor`'s
  # `rc` check reports what this function would decide — on EVERY box including
  # this one, the fleet host, which has no `ccrc.env` for a check to hang off —
  # including the cases where the strictness above surprises somebody (a
  # newline-less `on` reads as OFF and doctor says `unparseable`, not `off`).
  local first=""
  [[ -f "$CCRC_RC_FILE" ]] || return 1
  # `2>/dev/null` BEFORE the input redirect, and the order is the whole point:
  # bash applies redirections left to right, so with the suppression written
  # last the `<` is attempted while stderr is still the caller's, and a
  # chmod-000 flag file prints a raw `Permission denied` — with ccd's own line
  # number, unattributed — onto `_spawn_start`'s stderr on EVERY spawn. That
  # function's header takes stray output seriously ("a stray line here would
  # land in whatever `ws-add`/`start` was printing"), and this is the fleet's
  # supervisor. The return value was always right; the suppression was not
  # suppressing. `ccd-rc-flag.test.ts` pins the silence, not just the verdict.
  IFS= read -r first 2>/dev/null < "$CCRC_RC_FILE" || return 1
  [[ "${first//[[:space:]]/}" == "on" ]]
}

_lane_enabled() { [[ ! -f "$REG/$1-disabled" ]]; }   # operator kill-switch: touch/rm $REG/<w>-disabled
# The account-health probe's durable verdict, in the same `"<epoch> <reason>"`
# format `swapblocked` uses. WRITTEN BY `ccd-account-health` (a sibling
# executable, never this file — ccd makes no outbound network call, and adding
# one would be a new dependency class); CLEARED by that probe on a 403, by a
# successful spawn (`_spawn_settle`), and by an operator `rm`.
#
# DOTLESS AND PER-ACCOUNT, which is what keeps it out of every registry glob —
# and since D-2605 that takes TWO clauses rather than one. `_reg_purge`,
# `_ws_slug_free` and `_ws_slug_residue` all glob `"$REG/$id".*` and skip any
# suffix containing a dot; `_ws_slug_free` and `_ws_slug_residue` ALSO take a
# second pass over the dot-LEADING `.<id>.` private compaction families, so for
# those two the dot-skip is no longer the whole reason. `$REG/claude-authdead`
# is invisible to all three because it is DOTLESS (nothing follows an id to
# match `"$REG/$id".*`) AND because it matches no `.<id>.`-prefixed private
# family — not because of the dot-skip alone.
#
# NOT `-disabled`. That name is OPERATOR intent, has no writer in this tree, and
# both its conjuncts in `_account_ok` are things a human did. This one is a
# MEASUREMENT, which can be wrong — so it never joins `_account_ok`, and its two
# consumers rank-last (`_swap_target`) and skip-scoring (`_ws_least_loaded`)
# instead. A rescue must always have a destination.
#
# THE DIGITS GATE, exactly as `_auto_swap_check` validates `swapblocked`'s epoch
# (ccd/ccd:12229-12230): the field is bytes off disk. Here it also decides the answer — an
# empty or half-written marker is NOT a verdict, and reading one as "dead" would
# let a truncated write bar an account nothing ever measured.
# `-f` BEFORE THE OPEN, the same rung `_reg_read` and `_reg_get` carry and for
# the same reason — and this path is reached by NEITHER of them (#69 review
# round 3, R2). They build `$REG/<id>.<field>`; this one builds the DOTLESS
# `$REG/<account>-authdead`, so round 2's `_reg_get` guard cannot cover it and
# the hang class it was written to close stayed open on the same 5-second tick.
# `cat` opens whatever is here with no regard for TYPE, and both call sites are
# inside ACCOUNT loops (`_swap_target`, `_ws_least_loaded`): one bad file wedges
# the tick of EVERY row that reaches the loop, not just the row on that account.
# MEASURED on the shipped body: a FIFO with no writer and a symlink to
# `/dev/zero` each returned rc 124 under `timeout 5`; with the guard, every
# input below answers in under 0.05 s.
#
# THE `-f` RUNG NARROWS NOTHING — AND SAYING WHICH RUNG IS THE POINT, because this
# stopped: absent, empty, garbage, a leading space, `chmod 000`, a directory, a
# dangling symlink, a loop and `/dev/null` answer rc 1 before and after; a regular
# marker and a hardlink answer rc 0; only the two answering NOTHING change, and no
# writer here makes one (`_ah_mark` is mktemp -> printf -> `mv -f`). THE `! -L`
# RUNG NARROWS EXACTLY ONE MORE, re-measured: a SYMLINK to a marker, rc 0 -> rc 1.
#
# THE FOLD IS ALREADY HERE AND ITS DIRECTION IS THE FILE'S OWN RULING. An
# unreadable marker answering "not condemned" folds "no marker" with "cannot
# tell", exactly as a `chmod 000` marker already did; the digits gate above
# argues that direction. Both consumers spend this on PREFERENCE only — rank 101
# in `_swap_target`, a second-tier fallback in `_ws_least_loaded` — so the fold
# costs at most one rescue landing on a lane that may not authenticate, and "a
# rescue must always have a destination". The opposite fold is the unsafe one.
#
# AND THE DIVERGENCE IT CLAIMED TO END WAS NEVER THE REAL ONE. This paragraph
# used to say the second body of this contract, in `ccd/ccd-telemetry-keepalive`,
# "already opens with `[ -f "$f" ] || return 1`" and that this copy "was the one
# left behind". Measured: that sibling opens with the SAME following test and
# carries the SAME defect, so `-f` was never the thing this copy was missing.
# Both bodies are fixed together, because the contract's own header says the two
# hold the marker's FORMAT equal rather than the function's text — and a class
# closed in one body of a two-body contract is closed nowhere.
_authdead() {   # wrapper -> success iff a well-formed auth-dead marker stands for it
  local f="$REG/$1-authdead" t
  # `! -L` AND NOT `-f` ALONE (D-2989, re-censused by PAIRING). `-f` FOLLOWS the
  # chain, so a symlink at `$REG/<wrapper>-authdead` pointing at ANY file whose
  # first word is digits passes this test and the `cat` below returns THAT
  # file's bytes — a fabricated AUTH-DEAD verdict from outside `$REG`, which
  # `cmd_*`'s placement skip and the rescue arm both key on. The marker is not
  # a `<id>.<field>` path, which is exactly why the first census — named by the
  # FIELD-path grammar — could not contain it.
  [[ -f "$f" && ! -L "$f" ]] || return 1
  t=$(cat "$f" 2>/dev/null); t="${t%% *}"
  [[ "$t" =~ ^[0-9]+$ ]]
}
# THE GRAMMAR IS ASCII, AND `LC_ALL=C` IS WHAT MAKES IT SO (D-2522). `[a-z]`
# in bash's `=~` is a COLLATION range, not a codepoint range: under
# `en_US.UTF-8` it ACCEPTS U+00E9, U+00E5, U+00FC and U+00F1 — measured, not
# reasoned — while the TypeScript `POOL_NAME_RE` this is pinned BYTE-EQUAL to
# (`shared/roster.ts`, D-2480, enforced by `pool-name-parity.test.ts`) is
# codepoint-based and rejects all four. The pin held the STRING while the two
# engines disagreed about what it MEANS, which is the one thing a text pin
# cannot see.
# BOTH CALL SITES NEED IT AND THE WRITER IS THE ONE THAT BITES: `cmd_project_pool`
# validates through here before writing the tag, so without this shadow
# `ccd project-pool <p> pool-<U+00E9>` is ACCEPTED and WRITTEN, and the server
# then reads that same file `malformed` — a tag the supported verb creates and
