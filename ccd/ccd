#!/usr/bin/env bash
# ccd — durable, multi-account, self-healing Claude Code session manager for server-box.
# One tmux session per (wrapper, project): `<wrapper> --remote-control <id> --resume|--session-id <uuid>`.
set -uo pipefail

REG="$HOME/.cc-sessions"
WRAPPER_DIR="$HOME/.local/bin"
# Derived from HOME with no env override, exactly as REG and WRAPPER_DIR are:
# HOME is the single isolation boundary the test harness sets, and cmd_ws_rm
# runs `git worktree remove` / `git branch -d` under these two roots. A stray
# Environment= or exported PROJECTS_ROOT would point a unit test at real repos.
PROJECTS_ROOT="$HOME/projects"     # $HOME/projects -> /data/projects (symlink) in production
WORKTREES_ROOT="$HOME/worktrees"
VALID_WRAPPERS=(claude claude2 claude-corp)   # canonical Anthropic accounts (home-able)
# `gpt` is a 4th lane (ccgpt = Claude Code on the ChatGPT-sub Codex backend), OPT-IN only
# since 2026-07-26: a session reaches it solely by having gpt as its HOME (`ccd prefer <id>
# gpt`), never as general overflow — its 272k window and unofficial-client risk are not
# things a project should inherit by accident. Instantly killable via the switch file below.
# It has no Anthropic-style 5h/7d telemetry, so it reads as free until a 429 writes an
# exclusion into cc-limits (see _auto_swap_check).
GPT_DISABLE_FILE="$HOME/.cc-sessions/gpt-disabled"   # touch to remove gpt from rotation instantly
AUTOCOMPACT_DISABLE_FILE="$HOME/.cc-sessions/autocompact-disabled"  # touch to disable proactive /compact fleet-wide
CLAUDE_AI_BASE="https://claude.ai/code"   # by-name discovery: pick the session whose name == the id
mkdir -p "$REG"

# ── account-swap tuning (see cmd_swap/_auto_swap_check) ─────────────────
LIMITS_DIR="$HOME/.cc-limits"   # per-account {"five":N,"seven":N,"ts":epoch} written by statusline-command.sh
SWAP_THRESHOLD=90               # own 5h % that arms a pre-emptive swap
SWAP_HEADROOM=30                # target must be at least this many points lower
SWAP_COOLDOWN=900               # min seconds between swaps of one session
SWAP_FRESH=1800                 # telemetry younger than this qualifies for pre-emptive swaps
SWAP_QUIET=600                  # preempt only sessions quiet this long (any surface); rescue ignores
SWAP_CEILING=98                 # own 5h/7d % at/above which every turn is paid overage: cut the
                                # quiet wait short so we swap at the NEXT turn boundary, not 10min later
SWAP_CEIL_QUIET=30              # seconds of idle required before a non-blocked relocation (return-home / ceiling)
SPAWN_EFFORT="ultracode"        # /effort sent to every freshly spawned session ("" disables).
                                # ultracode is session-only by design (no settings.json key),
                                # so injecting it at spawn is the only way to default it.
# Proactive auto-/compact: when an IDLE session's context passes COMPACT_THRESHOLD, send /compact
# so it stays lean (the SessionStart(compact) hook restores git/plan/handoff context, so this is
# non-destructive on both the Anthropic and gpt lanes). Only at a clean turn boundary; kill-switch
# via AUTOCOMPACT_DISABLE_FILE.
COMPACT_THRESHOLD=50            # own context % at/above which an idle session auto-compacts
COMPACT_COOLDOWN=1800           # min seconds between auto-compacts of one session (also skipped right after a swap)
COMPACT_QUIET=60                # seconds a session must be idle before an auto-compact fires (let the dust settle)
# Make `systemctl --user` reachable even from a non-interactive SSH context (no login session
# sets these). Lingering keeps /run/user/$UID alive across logins/reboots.
: "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"; export XDG_RUNTIME_DIR
: "${DBUS_SESSION_BUS_ADDRESS:=unix:path=${XDG_RUNTIME_DIR}/bus}"; export DBUS_SESSION_BUS_ADDRESS

die() { echo "ccd: $*" >&2; exit 1; }

_gpt_enabled() { [[ ! -f "$GPT_DISABLE_FILE" && -x "$WRAPPER_DIR/gpt" ]]; }   # kill-switch + wrapper present
_gpt_status() {   # human-readable state of the gpt overflow lane (for `ccd ls`)
  [[ -x "$WRAPPER_DIR/gpt" ]] || { echo "not installed"; return; }
  [[ -f "$GPT_DISABLE_FILE" ]] && { echo "DISABLED (kill-switch; rm $GPT_DISABLE_FILE to re-enable)"; return; }
  if ! _avail gpt; then
    # TWO different files can land here, and only one of them is a 429:
    #   • the compact exclusion ccd itself writes on a 429 ({"five":100,"seven":0,
    #     "ts":<when the 429 happened>} — see _auto_swap_check). Here `ts` IS the
    #     exclusion time and the 5h cooldown story is true.
    #   • the steady-state usage sample ccgpt-usage rewrites every 20 min (5 keys,
    #     python json.dump). There `ts` is the POLL time, "five" is usually null
    #     (Codex Pro is weekly-only) and the blocker is the weekly cap, whose real
    #     end time is in sevenResetAt — days out, not "~300m of 5h cooldown".
    # Telling them apart by the *presence* of the resetAt KEYS, not their values:
    # ccgpt-usage always emits both (often as null), ccd's printf never emits either.
    local f="$LIMITS_DIR/gpt.json" ts rem
    if _limit_has_key "$f" fiveResetAt || _limit_has_key "$f" sevenResetAt; then
      local five seven pct label reset msg
      five=$(_limit_field gpt five); seven=$(_limit_field gpt seven)
      : "${five:=0}"; : "${seven:=0}"
      if (( seven >= five )); then pct="$seven"; label=weekly; reset=$(_limit_json_num "$f" sevenResetAt)
      else                        pct="$five";  label=5h;     reset=$(_limit_json_num "$f" fiveResetAt); fi
      msg="Codex ${label} cap reached (${pct}%"
      [[ -n "$reset" ]] && msg="$msg, resets $(_fmt_eta "$reset")"
      echo "$msg)"
      return
    fi
    # via _limit_json_num, not a bare grep: gpt.json is the one file written by
    # python json.dump, so its colons carry a space and a compact pattern reads
    # nothing — printing "excluded" with no countdown (see _limit_json_num).
    ts=$(_limit_json_num "$f" ts 2>/dev/null)
    if [[ -n "$ts" ]]; then
      rem=$(( (18000 - ($(date +%s) - ts)) / 60 )); (( rem < 0 )) && rem=0   # never count down past the window
      echo "429-excluded (~${rem}m of 5h cooldown left)"
    else
      echo "excluded"
    fi
    return
  fi
  echo "enabled, available"
}
_is_valid_wrapper() { local w="$1" v; for v in "${VALID_WRAPPERS[@]}" gpt; do [[ "$w" == "$v" ]] && return 0; done; return 1; }
_id()    { echo "$1-$2"; }                                  # wrapper project -> id
_tmux()  { echo "cc-$1"; }                                  # id -> tmux name
_alive() { tmux has-session -t "$(_tmux "$1")" 2>/dev/null; }
_reg_set() { printf '%s' "$3" > "$REG/$1.$2"; }             # id field value
_reg_get() { cat "$REG/$1.$2" 2>/dev/null; }                # id field
_ws_seed_home() {   # id wrapper — set home once; never clobber a deliberate choice
  [[ -f "$REG/$1.home" ]] || _reg_set "$1" home "$2"
}

# The systemd calls live in their own functions (rather than inline in cmd_ws_add)
# so the test harness can stub them — sourcing ccd and calling cmd_ws_add under
# vitest would otherwise enable a REAL claude-session@<id> unit on the host.
_ws_supervise()   { systemctl --user enable  --now "claude-session@$1" 2>/dev/null \
                      || echo "warn: could not enable unit claude-session@$1" >&2; }
_ws_unsupervise() { systemctl --user disable --now "claude-session@$1" 2>/dev/null || true; }

# ── workspace slugs ────────────────────────────────────────────────
# No dots: tmux -t parses `session:window.pane`. No slashes: systemd
# instance names escape them. Lowercase only, so a slug is never ambiguous
# on a case-insensitive filesystem.
WS_ADJ=(quiet swift amber still brisk clear plain warm bright calm keen soft)
WS_NOUN=(mesa river ridge harbor meadow canyon summit hollow prairie basin cove delta)

_ws_slug_valid() { [[ "$1" =~ ^[a-z0-9][a-z0-9-]{1,30}$ ]]; }

_ws_slug_free() { [[ ! -f "$REG/$1-$2.uuid" ]]; }   # project slug

_ws_slug_new() {   # project -> echo a free, valid slug (or fail)
  local project="$1" slug i
  if [[ -n "${CCD_WS_SLUG:-}" ]]; then             # tests and manual naming
    _ws_slug_valid "$CCD_WS_SLUG" || return 1
    _ws_slug_free "$project" "$CCD_WS_SLUG" || return 1
    echo "$CCD_WS_SLUG"; return 0
  fi
  for ((i = 0; i < 60; i++)); do
    slug="${WS_ADJ[RANDOM % ${#WS_ADJ[@]}]}-${WS_NOUN[RANDOM % ${#WS_NOUN[@]}]}"
    _ws_slug_free "$project" "$slug" && { echo "$slug"; return 0; }
  done
  return 1
}

_ws_least_loaded() {   # -> the home-able account with the most headroom
  local best="" bs=1000 w sc
  for w in "${VALID_WRAPPERS[@]}"; do
    sc=$(_limit_score "$w"); [[ -z "$sc" ]] && sc=0
    (( sc < bs )) && { bs=$sc; best="$w"; }
  done
  echo "$best"
}

# CCD_DISK_FLOOR_GB is the one environment override ccd honours, because unlike
# PROJECTS_ROOT/WORKTREES_ROOT it can only make ccd REFUSE to act — it can never
# aim a destructive command at a different tree.
CCD_DISK_FLOOR_GB="${CCD_DISK_FLOOR_GB:-10}"

_ws_disk_free_gb() {   # dir -> whole GiB available on the filesystem holding it
  local d="$1"
  # WORKTREES_ROOT is created lazily, so walk up to the nearest parent that
  # exists; df on a missing path just fails.
  while [[ ! -d "$d" && "$d" != / && -n "$d" ]]; do d=$(dirname "$d"); done
  # -P guarantees one filesystem per line, so a long device name cannot wrap the
  # row and shift field 4. -k pins the block size to 1K, which -P alone does not
  # (GNU df -P reports 512-byte blocks under POSIXLY_CORRECT).
  # NOT `df --output=avail`: GNU df rejects -P and --output together.
  local kb; kb=$(df -Pk "$d" 2>/dev/null | awk 'NR==2 {print $4}')
  [[ "$kb" =~ ^[0-9]+$ ]] || return 1
  echo $(( kb / 1024 / 1024 ))
}

cmd_ws_add() {   # project [slug] — new worktree + session for an existing project
  local project="${1:?usage: ccd ws-add <project> [slug]}" slug="${2:-}"
  [[ "$project" =~ ^[A-Za-z0-9._-]+$ ]] || die "invalid project '$project'"
  local main="$PROJECTS_ROOT/$project"
  [[ -d "$main/.git" ]] || die "not a git repo: $main"

  # Before anything is created: no worktree, no branch, no registry entry, no
  # session. A refusal here must leave the box exactly as it found it.
  local free
  free=$(_ws_disk_free_gb "$WORKTREES_ROOT") \
    || die "could not read free space for $WORKTREES_ROOT"
  (( free >= CCD_DISK_FLOOR_GB )) \
    || die "only ${free}G free on $WORKTREES_ROOT, floor is ${CCD_DISK_FLOOR_GB}G — reclaim space first: ccd ws-gc"

  [[ -n "$slug" ]] && { _ws_slug_valid "$slug" || die "invalid slug '$slug'"; \
                        _ws_slug_free "$project" "$slug" || die "slug in use: $slug"; }
  [[ -z "$slug" ]] && { slug=$(CCD_WS_SLUG="${CCD_WS_SLUG:-}" _ws_slug_new "$project") \
                        || die "could not find a free slug for $project"; }

  git -C "$main" fetch origin --quiet 2>/dev/null || echo "warn: fetch failed; basing on the last known origin" >&2
  local base
  base=$(git -C "$main" symbolic-ref --quiet refs/remotes/origin/HEAD) \
    || die "no origin/HEAD — run: git -C '$main' remote set-head origin -a"
  base="${base#refs/remotes/}"

  local wt="$WORKTREES_ROOT/$project/$slug"
  [[ "$wt" != *\'* ]] || die "path must not contain a single quote: $wt"
  mkdir -p "$WORKTREES_ROOT/$project"
  # ws/ namespaces the branch: it sorts with its siblings, matches the type/slug
  # shape every repo here already uses, and says at a glance that the branch is
  # machine-created. The directory and the session id keep the BARE slug — a
  # slash in either would break tmux -t (session:window.pane) and systemd
  # instance names. --no-track is load-bearing: $base is a remote-tracking ref,
  # so git's branch.autoSetupMerge default would otherwise make origin/main this
  # branch's upstream, and `git pull` in the workspace would merge main into it.
  local branch="ws/$slug"
  git -C "$main" worktree add -b "$branch" --no-track "$wt" "$base" --quiet \
    || die "git worktree add failed for $wt"

  # Shared across every worktree of this repo, local only, never committed.
  local common; common=$(cd "$main" && cd "$(git rev-parse --git-common-dir)" && pwd -P)
  mkdir -p "$common/info"
  grep -qxF '.ccrc/' "$common/info/exclude" 2>/dev/null || echo '.ccrc/' >> "$common/info/exclude"

  local id="$project-$slug"
  local uuid; uuid=$(cat /proc/sys/kernel/random/uuid)
  local hw; hw=$(_ws_least_loaded)
  _reg_set "$id" wrapper "$hw";   _reg_set "$id" project "$project"
  _reg_set "$id" workdir "$wt";   _reg_set "$id" uuid "$uuid"
  _reg_set "$id" workspace "$slug"; _reg_set "$id" base "$base"
  _reg_set "$id" branch "$branch"
  _ws_seed_home "$id" "$hw"

  # A failed setup hook leaves a usable-but-unscaffolded workspace. Say so;
  # never remove work on the strength of a hook's exit code.
  if [[ -x "$main/.ccrc/workspace.sh" ]]; then
    if MAIN="$main" WT="$wt" "$main/.ccrc/workspace.sh"; then
      _reg_set "$id" setup ok
    else
      _reg_set "$id" setup failed
      echo "warn: .ccrc/workspace.sh failed for $id — workspace kept, not scaffolded" >&2
    fi
  fi

  _spawn "$id" new; _reg_set "$id" started 1
  _ws_supervise "$id"
  echo "workspace $id on $hw — $wt (branch $branch, from $base)"
}

# Every path git prints is fully resolved ($HOME/worktrees -> /data/worktrees ->
# /mnt/...), while the registry keeps the path ccd wrote. Resolving needs the
# path to EXIST, and the whole point of the caller below is the case where it
# does not — so resolve the longest existing prefix and re-attach the rest.
_ws_realpath() {   # path -> same path, existing prefix resolved
  local p="$1" head="$1" tail="" real
  while [[ ! -d "$head" && "$head" != / && "$head" != . && -n "$head" ]]; do
    tail="/$(basename "$head")$tail"; head=$(dirname "$head")
  done
  real=$(cd "$head" 2>/dev/null && pwd -P) || { echo "$p"; return 0; }
  echo "${real%/}$tail"
}

# THE branch source of truth: git's own record of which branch the worktree at
# $2 has checked out, read from the repo at $1. Not `rev-parse HEAD` inside the
# worktree — that answers from whatever repository owns that directory, which
# after a hand-deletion and a stray `git init` need not be $1 at all, and the
# name it returns is then deleted in $1. This lookup cannot leave $1, survives
# the directory being gone (the record stays, marked `prunable`), and follows a
# branch rename whether ccd or the user did it.
#   stdout: branch name, empty for a detached HEAD
#   exit:   0 = git has a registration for that path, 1 = it has none
# `git worktree list` failing (repo gone, corrupt, not a repo) yields no records
# and therefore exit 1 — "no evidence", which is the reading that deletes
# nothing.
_ws_wt_branch() {   # main path
  local main="$1" path="$2" real cur="" line
  real=$(_ws_realpath "$path")
  while IFS= read -r line; do
    case "$line" in
      "worktree "*) cur="${line#worktree }" ;;
      "branch "*)   [[ "$cur" == "$real" || "$cur" == "$path" ]] && { echo "${line#branch refs/heads/}"; return 0; } ;;
      detached)     [[ "$cur" == "$real" || "$cur" == "$path" ]] && { echo ""; return 0; } ;;
    esac
  done < <(git -C "$main" worktree list --porcelain 2>/dev/null)
  return 1
}

cmd_ws_rm() {   # id — tear a workspace down. Refuses anything it might destroy.
  local id="${1:?usage: ccd ws-rm <id>}"
  [[ -f "$REG/$id.uuid" ]] || die "no such session: $id"
  local ws project workdir
  ws=$(_reg_get "$id" workspace); project=$(_reg_get "$id" project); workdir=$(_reg_get "$id" workdir)
  # The absence of a workspace field is what distinguishes a main checkout.
  [[ -n "$ws" ]] || die "$id is not a workspace — refusing to remove a main checkout"
  [[ -n "$project" && -n "$workdir" ]] || die "incomplete registry for '$id'"
  local main="$PROJECTS_ROOT/$project"

  # Gather the evidence BEFORE anything is torn down, and gather it from git.
  # `registered` is what decides whether there is anything for `worktree remove`
  # to clear, so it is read from $? on its own line: with no `set -e`, a
  # `local branch=$(...)` would return local's status, not the function's.
  local branch registered
  branch=$(_ws_wt_branch "$main" "$workdir"); registered=$?

  if [[ -d "$workdir" ]]; then
    # REFUSE FIRST, tear down second. A directory that exists but is not a
    # worktree of $main is not ours to remove and its HEAD is not ours to
    # delete: move or delete it by hand and re-run, and the missing-directory
    # path below will finish the job.
    (( registered == 0 )) \
      || die "$workdir is not a worktree of $main — nothing was touched; move or delete it by hand, then re-run"
    # --porcelain counts untracked files, which is what `git worktree remove`
    # itself objects to. Doing this after the kill would leave the uncommitted
    # work intact but the session dead and out of supervision — and the refusal
    # would be lying about it. A status we could not read is not a clean one
    # (same rule as _ws_gc_dirty).
    local dirty
    dirty=$(git -C "$workdir" status --porcelain 2>/dev/null) \
      || die "could not read $workdir — nothing was touched"
    [[ -z "$dirty" ]] || die "worktree not removed (uncommitted changes?) — nothing was touched: $workdir"
  fi

  _ws_unsupervise "$id"
  tmux kill-session -t "$(_tmux "$id")" 2>/dev/null || true

  if (( registered == 0 )); then
    # Not gated on the directory existing: `git worktree remove` clears the
    # registration either way, and while that registration stands git refuses to
    # delete the branch it names ("cannot delete branch used by worktree at").
    # Still no --force: the tree can have changed since the check above, and a
    # locked worktree refuses either way. By here the session IS stopped, so say
    # that rather than repeat "nothing touched".
    git -C "$main" worktree remove "$workdir" \
      || die "worktree record not cleared for $workdir — the session was stopped; clean the tree (or run: git -C $main worktree prune) and re-run"
  fi

  local reg_branch; reg_branch=$(_reg_get "$id" branch)
  if [[ -n "$branch" ]]; then
    # git had a record, so the registry is a witness, never the decider: a
    # divergence means the branch was renamed outside ccd, and the name to
    # delete is the one git actually had checked out there.
    [[ -n "$reg_branch" && "$reg_branch" != "$branch" ]] \
      && echo "note: registry recorded '$reg_branch', git's worktree record says '$branch' — deleting '$branch'; '$reg_branch' left alone" >&2
    # No -D: an unmerged branch must survive — and must SAY so, or it is
    # orphaned in silence.
    git -C "$main" branch -d "$branch" 2>/dev/null \
      || echo "kept branch $branch (unmerged, or still in use) — delete it with: git -C $main branch -D $branch" >&2
  elif (( registered == 0 )); then
    echo "note: $workdir was on a detached HEAD — no branch to delete" >&2
  elif [[ -n "$reg_branch" ]] && git -C "$main" show-ref --verify --quiet "refs/heads/$reg_branch" 2>/dev/null; then
    # No git record at all (someone pruned it by hand). The registry name is
    # uncorroborated — the only thing that ever tied it to this path is now
    # gone — and deleting the wrong branch costs incomparably more than leaving
    # the right one behind. Name it and hand over the command.
    echo "warn: no worktree record for $workdir; registry says branch '$reg_branch', which still exists — not deleting it unverified. If it is finished: git -C $main branch -d $reg_branch" >&2
  fi

  rm -f "$REG/$id".*
  echo "removed workspace $id"
}

# ── renaming a workspace branch ────────────────────────────────────
# The subset of `git check-ref-format` that matters, checked explicitly rather
# than trusted to git's exit code: an invalid name must be refused BEFORE any
# git command is run with it as an argument.
_ws_branch_valid() {
  local b="$1"
  [[ -n "$b" ]]                              || return 1
  [[ "$b" =~ ^[A-Za-z0-9._/-]+$ ]]           || return 1   # no space, colon, glob, ~, ^, @{
  [[ "$b" != -* ]]                           || return 1   # git would read it as an option
  [[ "$b" != /* && "$b" != */ ]]             || return 1
  [[ "$b" != *..* ]]                         || return 1
  [[ "$b" != *.lock && "$b" != *.lock/* ]]   || return 1   # any component, not just the last
  return 0
}

cmd_ws_rename() {   # id new-branch — rename a workspace branch before it is pushed
  local id="${1:?usage: ccd ws-rename <id> <new-branch>}"
  local new="${2:?usage: ccd ws-rename <id> <new-branch>}"
  [[ -f "$REG/$id.uuid" ]] || die "no such session: $id"

  local ws project workdir
  ws=$(_reg_get "$id" workspace); project=$(_reg_get "$id" project); workdir=$(_reg_get "$id" workdir)
  # The absence of a workspace field is what distinguishes a main checkout.
  [[ -n "$ws" ]] || die "$id is not a workspace — refusing to rename a main checkout's branch"
  [[ -n "$project" && -n "$workdir" ]] || die "incomplete registry for '$id'"
  [[ -d "$workdir" ]] || die "worktree is gone: $workdir"
  _ws_branch_valid "$new" || die "invalid branch name: $new"

  local main="$PROJECTS_ROOT/$project"
  local old; old=$(git -C "$workdir" rev-parse --abbrev-ref HEAD 2>/dev/null)
  [[ -n "$old" && "$old" != HEAD ]] || die "$id is on a detached HEAD — nothing to rename"
  [[ "$old" != "$new" ]] || die "already named $new"

  # Renaming after a push leaves the old name on the remote and creates a second
  # branch there on the next push. An upstream is the evidence that happened.
  if git -C "$workdir" rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then
    die "$old has an upstream — it is already on the remote; rename before pushing, not after"
  fi

  git -C "$main" show-ref --verify --quiet "refs/heads/$new" \
    && die "branch already exists locally: $new"

  # --exit-code: 0 = the head exists, 2 = it does not, anything else = we could
  # not ask. Unreachable is not the same as taken.
  local rc; git -C "$main" ls-remote --exit-code --heads origin "$new" >/dev/null 2>&1; rc=$?
  case "$rc" in
    0) die "branch already exists on origin: $new" ;;
    2) : ;;
    *) echo "warn: could not reach origin to check for '$new' — renaming anyway" >&2 ;;
  esac

  git -C "$workdir" branch -m "$new" || die "rename failed: $old -> $new"
  _reg_set "$id" branch "$new"
  echo "renamed $id: $old -> $new"
}

# ── reclamation ────────────────────────────────────────────────────
# ws-gc REPORTS by default and acts only under --prune. 29G of abandoned agent
# worktrees accumulated on this box over six weeks because no command existed
# that would have said so; the visibility is the point.

_ws_gc_bytes() {   # path -> size in bytes, or '-'
  [[ -d "$1" ]] || { echo '-'; return 0; }
  local b; b=$(du -sb "$1" 2>/dev/null | cut -f1)
  [[ "$b" =~ ^[0-9]+$ ]] && echo "$b" || echo '-'
}

_ws_gc_age() {     # path -> whole days since its mtime, or '-'
  [[ -d "$1" ]] || { echo '-'; return 0; }
  local m; m=$(stat -c %Y "$1" 2>/dev/null) || { echo '-'; return 0; }
  [[ "$m" =~ ^[0-9]+$ ]] || { echo '-'; return 0; }
  echo $(( ( $(date +%s) - m ) / 86400 ))
}

_ws_gc_human() {   # bytes -> human, or '-' unchanged
  [[ "$1" =~ ^[0-9]+$ ]] || { echo '-'; return 0; }
  numfmt --to=iec "$1" 2>/dev/null || echo "$1"
}

_ws_gc_dirty() {   # workdir -> 0 when the tree has uncommitted OR untracked files,
                   #            OR when we could not find out
  local out
  # `git status` failing means unreadable, corrupt, or not a worktree at all —
  # NOT clean. Swallowing the exit code and testing an empty string would report
  # every unreadable tree as safe to delete, which is the one answer that loses
  # work. Unknown counts as dirty.
  out=$(git -C "$1" status --porcelain 2>/dev/null) || return 0
  [[ -n "$out" ]]
}

# One TSV row per finding: state project slug bytes agedays path
_ws_gc_row() {   # project mainreal wsroot wt prunable
  local project="$1" mainreal="$2" wsroot="$3" wt="$4" prunable="$5"
  [[ -n "$wt" ]] || return 0
  [[ "$wt" != "$mainreal" ]] || return 0        # the main checkout is not a workspace
  local slug; slug=$(basename "$wt")

  # Ownership must be settled BEFORE anything prunable is acted on: a stale
  # registration outside our tree is still someone else's metadata, and
  # `git worktree prune` on it is exactly the kind of guess this command must
  # never make. Ours is EXACTLY one level below $wsroot/$project — ws-add
  # never nests deeper, so anything deeper is a hand-placed or foreign-tool
  # worktree, not one of ours.
  local rel="${wt#$wsroot/$project/}"
  local ours=0
  [[ "$wt" == "$wsroot/$project/"* && -n "$rel" && "$rel" != */* ]] && ours=1

  if (( prunable )); then
    if (( ours )); then
      printf 'stale-meta\t%s\t%s\t-\t-\t%s\n' "$project" "$slug" "$wt"
    else
      printf 'foreign-stale\t%s\t%s\t-\t-\t%s\n' "$project" "$slug" "$wt"
    fi
    return 0
  fi

  local bytes age; bytes=$(_ws_gc_bytes "$wt"); age=$(_ws_gc_age "$wt")

  # Anything ccd did not create is FOREIGN: reported so it is visible, never
  # pruned. Guessing at another tool's lifecycle is how a reclaimer destroys
  # work it does not understand.
  if (( ! ours )); then
    printf 'foreign\t%s\t%s\t%s\t%s\t%s\n' "$project" "$slug" "$bytes" "$age" "$wt"; return 0
  fi

  local state
  if   [[ ! -f "$REG/$project-$slug.uuid" ]]; then state=orphan
  elif _ws_gc_dirty "$wt";                    then state=dirty
  else                                             state=tracked
  fi
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$state" "$project" "$slug" "$bytes" "$age" "$wt"
}

_ws_gc_scan() {
  local main mainreal project wsroot wt prunable line f id wd p s
  # git records fully resolved paths (~/projects -> /data/projects -> /mnt/...),
  # so both roots have to be resolved before any path comparison.
  wsroot=$(cd "$WORKTREES_ROOT" 2>/dev/null && pwd -P) || wsroot="$WORKTREES_ROOT"

  for main in "$PROJECTS_ROOT"/*; do
    [[ -e "$main/.git" ]] || continue
    project=$(basename "$main")
    mainreal=$(cd "$main" 2>/dev/null && pwd -P) || continue
    wt=""; prunable=0
    # Records are blank-line separated; the trailing `echo` flushes the last one
    # whether or not git emitted a final blank line.
    while IFS= read -r line; do
      case "$line" in
        "worktree "*) wt="${line#worktree }"; prunable=0 ;;
        "prunable"*)  prunable=1 ;;
        "")           _ws_gc_row "$project" "$mainreal" "$wsroot" "$wt" "$prunable"
                      wt=""; prunable=0 ;;
      esac
    done < <(git -C "$main" worktree list --porcelain 2>/dev/null; echo)
  done

  # Registry entries whose worktree is gone. git has no registration for these
  # at all, so the loop above cannot see them.
  for f in "$REG"/*.workspace; do
    [[ -e "$f" ]] || continue
    id=$(basename "$f" .workspace)
    [[ -f "$REG/$id.uuid" ]] || continue
    wd=$(_reg_get "$id" workdir)
    [[ -n "$wd" && ! -d "$wd" ]] || continue
    p=$(_reg_get "$id" project); s=$(_reg_get "$id" workspace)
    # The id is <project>-<slug> by construction. If the registry disagrees with
    # itself, report it and reconstruct nothing — a prune keyed off a wrong
    # reconstruction would delete a different session's entry.
    [[ "$p-$s" == "$id" ]] || { printf 'dead-reg\t%s\t%s\t-\t-\t%s\n' "$id" "?" "$wd"; continue; }
    printf 'dead-reg\t%s\t%s\t-\t-\t%s\n' "$p" "$s" "$wd"
  done
}

_ws_gc_merged() {   # main branch -> 0 when the branch tip is an ancestor of origin/HEAD
  local main="$1" branch="$2" base
  # No origin/HEAD means there is no base to compare against, so "merged" is
  # unprovable — and unprovable returns 1, i.e. NOT merged, i.e. do not remove.
  # Every ambiguous case in this command resolves toward doing nothing.
  base=$(git -C "$main" symbolic-ref --quiet refs/remotes/origin/HEAD) || return 1
  git -C "$main" merge-base --is-ancestor "refs/heads/$branch" "$base" 2>/dev/null
}

# Acts on ONE scanned row. Prints exactly one line per row, whether it acted or
# not: a silent decline reads as "there was nothing there".
_ws_gc_prune_row() {   # state project slug path already-pruned
  local state="$1" project="$2" slug="$3" p="$4" already="${5:-0}"
  local main="$PROJECTS_ROOT/$project"
  case "$state" in
    stale-meta)
      if (( already )); then
        # git worktree prune is repo-wide: the first stale-meta row for this
        # project already reclaimed every prunable registration in it. Calling
        # it again would succeed (it is idempotent) and print a SECOND
        # "reclaimed" line for work that already happened.
        echo "  covered    stale metadata for $project/$slug — reclaimed with an earlier row in $project"
      elif git -C "$main" worktree prune 2>/dev/null; then
        echo "  reclaimed  stale metadata for $project/$slug"
      else
        # Metadata, not data — worth saying, not worth failing over.
        echo "  declined   could not prune metadata for $project/$slug"
      fi ;;
    foreign-stale)
      # A prunable registration outside our tree is still someone else's
      # metadata. `git worktree repair` may be the owning tool's only way back
      # to a temporarily-missing worktree; pruning it here would foreclose that.
      echo "  declined   $project/$slug is foreign metadata — ccd removes only what it created" ;;
    dead-reg)
      rm -f "$REG/$project-$slug".*
      echo "  reclaimed  dead registry entry $project-$slug" ;;
    orphan)
      if _ws_gc_dirty "$p"; then
        echo "  declined   $p has uncommitted changes"; return 0
      fi
      local branch; branch=$(git -C "$p" rev-parse --abbrev-ref HEAD 2>/dev/null)
      if [[ -n "$branch" && "$branch" != HEAD ]] && ! _ws_gc_merged "$main" "$branch"; then
        # The branch would survive `worktree remove`, so nothing is lost either
        # way — but a sweep should only reclaim what is provably finished, and
        # someone may be mid-way through this one.
        echo "  declined   $p is on unmerged branch $branch"; return 0
      fi
      if git -C "$main" worktree remove "$p" 2>/dev/null; then
        echo "  reclaimed  removed orphan worktree $p"
        # No -D: git refuses an unmerged branch and that refusal is wanted.
        if [[ -n "$branch" && "$branch" != HEAD ]] && git -C "$main" branch -d "$branch" 2>/dev/null; then
          echo "  reclaimed  deleted merged branch $branch"
        fi
      else
        echo "  declined   git refused to remove $p"
      fi ;;
    dirty)
      echo "  declined   $p is dirty — never removed, at any flag" ;;
    foreign)
      echo "  declined   $p is foreign — ccd removes only what it created" ;;
    tracked)
      : ;;   # a live workspace: not a finding to act on
  esac
}

cmd_ws_gc() {   # [--prune]
  local prune=0
  case "${1:-}" in
    '')       ;;
    --prune)  prune=1 ;;
    *)        die "usage: ccd ws-gc [--prune]" ;;
  esac

  local rows; rows=$(_ws_gc_scan)
  [[ -n "$rows" ]] || { echo "nothing to report — no worktrees found under $PROJECTS_ROOT"; return 0; }

  local state project slug bytes age p n=0
  local -a paths=()
  printf '%-11s %-18s %-22s %7s %5s  %s\n' STATE PROJECT WORKSPACE SIZE IDLE PATH
  while IFS=$'\t' read -r state project slug bytes age p; do
    printf '%-11s %-18s %-22s %7s %5s  %s\n' \
      "$state" "$project" "$slug" "$(_ws_gc_human "$bytes")" "$age" "$p"
    n=$(( n + 1 ))
    [[ -d "$p" ]] && paths+=("$p")
  done <<< "$rows"

  # One du across every path at once: it de-dupes inodes shared between
  # worktrees, so this is the exact figure that removing the lot would free.
  # The per-row sizes are independent measurements and can sum to more.
  local total='-'
  if (( ${#paths[@]} > 0 )); then
    total=$(du -scb "${paths[@]}" 2>/dev/null | awk '$2 == "total" {print $1}')
    total=$(_ws_gc_human "$total")
  fi
  echo
  echo "total $total across $n worktree$( (( n == 1 )) || echo s ) — what removing all of them would free."
  echo "Rows are measured independently, so they can sum to more than the total when workspaces share hardlinks."

  (( prune )) || return 0

  echo
  echo "pruning:"
  local reclaimed=0 declined=0 out already
  local -A meta_pruned=()   # projects whose stale metadata this run already reclaimed
  while IFS=$'\t' read -r state project slug bytes age p; do
    already=0
    if [[ "$state" == stale-meta ]]; then
      if [[ -n "${meta_pruned[$project]:-}" ]]; then already=1; else meta_pruned[$project]=1; fi
    fi
    out=$(_ws_gc_prune_row "$state" "$project" "$slug" "$p" "$already")
    [[ -n "$out" ]] || continue
    echo "$out"
    reclaimed=$(( reclaimed + $(grep -c '^  reclaimed ' <<< "$out") ))
    declined=$((  declined  + $(grep -c '^  declined '  <<< "$out") ))
  done <<< "$rows"
  echo
  echo "reclaimed $reclaimed, declined $declined"
}

_cfg_dir() {   # wrapper -> the CLAUDE_CONFIG_DIR that wrapper uses
  case "$1" in
    claude)      echo "$HOME/.claude" ;;
    claude2)     echo "$HOME/.claude-personal" ;;
    claude-corp) echo "$HOME/.claude-corp" ;;
    gpt)         echo "$HOME/.claude-gpt" ;;
  esac
}

_sync_uuid() {   # id — mirror the live process's CURRENT sessionId into the registry.
  # Claude Code rotates the active session uuid during normal operation (/clear, compaction),
  # so a uuid pinned at start goes stale, and a later --resume of it time-travels the session
  # back to the last point that old uuid was active (observed 2026-07-02: days-to-weeks jumps).
  # The live process publishes its current sessionId at <config>/sessions/<pid>.json; keeping
  # the registry in step means resurrection resumes where the session actually was.
  local id="$1" cfg pid sid
  cfg=$(_cfg_dir "$(_reg_get "$id" wrapper)"); [[ -n "$cfg" ]] || return 0
  pid=$(tmux list-panes -t "$(_tmux "$id")" -F '#{pane_pid}' 2>/dev/null | head -1)
  [[ -n "$pid" && -f "$cfg/sessions/$pid.json" ]] || return 0
  sid=$(grep -oE '"sessionId":"[0-9a-f-]{36}"' "$cfg/sessions/$pid.json" | head -1 | cut -d'"' -f4)
  [[ -n "$sid" && "$sid" != "$(_reg_get "$id" uuid)" ]] && _reg_set "$id" uuid "$sid"
  return 0
}

_default_pool() {   # id -> wrappers this session may auto-swap between.
  # Free swapping across ALL Anthropic accounts (explicit user decision 2026-07-03).
  # gpt is NOT a general overflow target (user decision 2026-07-26): only a session
  # whose HOME is gpt may rotate onto it — today that is orchard-api alone.
  # Everything else stays on Anthropic, so no project silently lands on the Codex
  # lane with its 272k window and unofficial-client risk.
  # Narrow per session with a space-separated list in the registry `pool` field.
  local pool="${VALID_WRAPPERS[*]}"
  [[ "$(_reg_get "$1" home)" == gpt ]] && _gpt_enabled && pool="$pool gpt"
  echo "$pool"
}
_pool_for() { local p; p=$(_reg_get "$1" pool); [[ -n "$p" ]] && echo "$p" || _default_pool "$1"; }

_dispatch_swap() {   # id target — run `ccd swap` in ITS OWN transient systemd unit.
  # setsid is NOT enough: it detaches the tty but stays in the caller's CGROUP, so the
  # swap's own `systemctl stop` half-kills it mid-swap (left-over processes, dead session
  # never respawned — bit us 2026-07-05). systemd-run escapes the cgroup entirely.
  systemd-run --user --collect --quiet \
    bash -c "exec '$HOME/.local/bin/ccd' swap '$1' '$2' >>'$REG/swap.log' 2>&1" \
    || echo "$(date '+%F %T') dispatch FAILED for $1 -> $2" >> "$REG/swap.log"
}

_limit_json_num() {   # file key -> that key's number, or "" when absent, null or non-numeric.
  # Whitespace after the colon is NOT optional to tolerate: the Anthropic accounts'
  # telemetry is printf'd compact by statusline-command.sh, but gpt.json is written by
  # Python's json.dump (infra/handoff/ccgpt-usage), whose default separators put a space
  # after every colon — `{"five": null, "seven": 0, ...}`. A pattern demanding a digit
  # straight after the colon matched nothing there, so ccd read the one account it can't
  # get telemetry for any other way as entirely unknown, and the rollover rule below
  # could never fire on it.
  grep -oE "\"$2\"[[:space:]]*:[[:space:]]*[0-9]+" "$1" | head -1 | grep -oE '[0-9]+$'
}

_limit_has_key() {   # file key -> success if the key is PRESENT, whatever its value.
  # Presence and value are different questions: ccgpt-usage writes fiveResetAt/
  # sevenResetAt on every poll and they are frequently null (Codex Pro has no 5h
  # window, and the API omits a reset for a window at 0). _limit_json_num says ""
  # for both "absent" and "null", so only this can tell the python usage shape
  # from the compact 3-key exclusion ccd writes itself (_gpt_status depends on it).
  grep -q "\"$2\"[[:space:]]*:" "$1" 2>/dev/null
}

_fmt_eta() {   # epoch-seconds -> "in 42m" / "in 6h" / "in 5d" (coarse on purpose: these
  # are user-facing "when can I use this again" figures, not scheduling input).
  local target="$1" now d m h
  now=$(date +%s); d=$(( target - now ))
  (( d <= 0 )) && { printf 'any moment now'; return; }
  # Pick the unit from the ROUNDED figure, not from raw seconds. Thresholding on
  # seconds and rounding afterwards left a seam at each boundary: 7199s rounded to
  # 120 minutes but stayed in the minutes branch and printed "in 120m", while one
  # second later it printed "in 2h". Same at 47.99h -> "in 48h" instead of "in 2d".
  # Rounding first means a figure can never reach its own next unit.
  m=$(( (d + 30) / 60 ))
  h=$(( (d + 1800) / 3600 ))
  if   (( m < 120 )); then printf 'in %dm' "$m"
  elif (( h < 48 ));  then printf 'in %dh' "$h"
  else                     printf 'in %dd' $(( (d + 43200) / 86400 )); fi
}

_limit_field() {   # wrapper five|seven [maxage-secs] -> that limit %, or "" if unknown/stale
  local f="$LIMITS_DIR/$1.json" field="$2" maxage="${3:-0}" val ts now reset
  [[ -f "$f" ]] || return 0
  val=$(_limit_json_num "$f" "$field")
  ts=$(_limit_json_num "$f" ts)
  now=$(date +%s)
  if [[ "$maxage" -gt 0 && ( -z "$ts" || $((now - ts)) -gt "$maxage" ) ]]; then return 0; fi
  # A reading whose own window has already reset describes a window that ENDED.
  # resetAt comes straight from the API (statusline-command.sh), so this is fact,
  # where the age rules below are inference. It matters because telemetry is only
  # written when a session renders its statusline: an idle account stops
  # reporting entirely, so its last sample can outlive its window by days.
  # Observed 2026-07-27: claude read seven=98 for 14h after its 7d window reset,
  # which excluded it from every pool and stranded two sessions on gpt.
  # Both rules below rewrite a KNOWN value; neither may conjure one. gpt.json carries
  # `"five": null` with no 5h window at all, and a reset timestamp for a window nobody
  # ever measured says nothing about its value — "unknown" has to stay "" (readLimits
  # keeps it null), or _limit_score's wholly-unknown branch becomes unreachable.
  reset=$(_limit_json_num "$f" "${field}ResetAt")
  if [[ -n "$val" && -n "$reset" && "$now" -ge "$reset" ]]; then
    printf '0'; return 0
  fi
  # Fallback when the file carries no resetAt (the gpt 429 exclusion, and files
  # written before those fields existed): a sample older than its own window has
  # certainly rolled over. (7d decays slowly, so a stale seven only zeroes after
  # a full week.)
  if [[ -n "$val" && -n "$ts" ]]; then
    [[ "$field" == "five"  && $((now - ts)) -gt 18000  ]] && val=0
    [[ "$field" == "seven" && $((now - ts)) -gt 604800 ]] && val=0
  fi
  printf '%s' "$val"
}
_limit_five() { _limit_field "$1" five "${2:-0}"; }   # back-compat shim

_limit_score() {   # wrapper -> account pressure = max(5h%, 7d%); "" if wholly unknown
  # Weekly limits are as blocking as 5h ones (user directive 2026-07-05) — a target with a
  # free 5h window but an exhausted week is NOT a good landing spot, and an account nearing
  # its weekly cap should evacuate just like one nearing its 5h cap.
  local five seven
  five=$(_limit_field "$1" five 0); seven=$(_limit_field "$1" seven 0)
  [[ -z "$five" && -z "$seven" ]] && return 0
  : "${five:=0}"; : "${seven:=0}"
  (( seven > five )) && printf '%s' "$seven" || printf '%s' "$five"
}

# ── home-account affinity ──────────────────────────────────────────────
# Each session has a HOME account; it stays there and only leaves when home is at the rate ceiling
# (no included-usage headroom left), returning home the instant it has room again.
_id_wrapper() {   # id -> the wrapper encoded in the id prefix (longest match wins)
  case "$1" in
    claude-corp-*) echo claude-corp ;;
    claude2-*)     echo claude2 ;;
    claude-*)      echo claude ;;
    gpt-*)         echo gpt ;;
  esac
}
_home_for() { local h; h=$(_reg_get "$1" home); [[ -n "$h" ]] && echo "$h" || _id_wrapper "$1"; }

_avail() {   # wrapper -> success if it has included-usage headroom (rate score under the ceiling).
  # The monthly spend cap only gates PAID OVERAGE above 100%, so an account under the ceiling is
  # always usable, and a spend-blocked one is already >=100% (excluded by this same rate check).
  local w="$1" sc
  sc=$(_limit_score "$w"); [[ -z "$sc" ]] && return 0      # no telemetry at all = assume free
  [[ "$sc" -lt "$SWAP_CEILING" ]]
}

_swap_target() {   # id cur home -> echo destination wrapper, or nothing = stay put
  local id="$1" cur="$2" home="$3" cand best="" best_score=999 sc
  if [[ "$cur" == "$home" ]]; then
    _avail "$home" && return 0                        # home is fine: stay
  else
    _avail "$home" && { echo "$home"; return 0; }     # home recovered: go back
    _avail "$cur"  && return 0                        # cur still works, home down: stay put
  fi
  # must leave cur (home-but-down, or away-and-cur-down): pick the least-loaded AVAILABLE account
  for cand in $(_pool_for "$id"); do
    [[ "$cand" == "$cur" ]] && continue
    [[ -x "$WRAPPER_DIR/$cand" ]] || continue
    _avail "$cand" || continue
    sc=$(_limit_score "$cand"); : "${sc:=0}"
    [[ "$sc" -lt "$best_score" ]] && { best="$cand"; best_score="$sc"; }
  done
  [[ -n "$best" ]] && echo "$best"
}

_auto_swap_check() {   # id — called each supervise tick. HOME-account affinity:
  #   stay on your home account; leave only when home is at the rate ceiling (no headroom); return
  #   home the instant it has room again. A hard-blocked session (limit/spend banner up) swaps
  #   immediately; any other move waits for a clean turn boundary.
  local id="$1" wrapper home now last pane target
  wrapper=$(_reg_get "$id" wrapper); home=$(_home_for "$id")
  now=$(date +%s); last=$(_reg_get "$id" lastswap)
  [[ -n "$last" && $((now - last)) -lt "$SWAP_COOLDOWN" ]] && return 0
  pane=$(tmux capture-pane -t "$(_tmux "$id")" -p 2>/dev/null | tail -8)
  [[ -n "$pane" ]] || return 0
  # (The Fable-unavailable override that routed any session to gpt was removed
  #  2026-07-26 with the same decision that took gpt out of the rotation: gpt is
  #  no longer a destination for projects that didn't ask for it. A session whose
  #  HOME is gpt still swaps onto it through the normal pool.)
  target=$(_swap_target "$id" "$wrapper" "$home")
  [[ -n "$target" && "$target" != "$wrapper" ]] || return 0
  _avail "$target" || return 0
  # Hard-blocked (a real limit/spend banner is up): the session is stuck anyway -> swap now.
  # The 429/rate-limit patterns also catch the gpt overflow lane hitting the ChatGPT-sub
  # Codex usage cap (surfaces as "API Error: 429 ..."). When gpt is the exhausted account,
  # write a cc-limits/gpt.json exclusion so OTHER sessions stop rotating into it until the
  # 5h window rolls over (gpt has no native telemetry; this is its only "pool is full" signal).
  if echo "$pane" | grep -qiE "limit reached|reached your .*limit|out of (usage|credits)|monthly spend limit|hit your .*spend|API Error: 429|Too Many Requests|rate limit(ed| exceeded| reached)?"; then
    [[ "$wrapper" == gpt ]] && printf '{"five":100,"seven":0,"ts":%s}' "$now" > "$LIMITS_DIR/gpt.json"
    _reg_set "$id" lastswap "$now"
    echo "$(date '+%F %T') auto-rescue $id: $wrapper (blocked) -> $target [home=$home]" >> "$REG/swap.log"
    _dispatch_swap "$id" "$target"
    return 0
  fi
  # Otherwise (returning home, or leaving at the rate ceiling): relocate only at a clean turn
  # boundary — never mid-turn or mid-subagent. The idle gate reads the live process status file;
  # pane heuristics alone miss running subagents (learned 2026-07-03).
  echo "$pane" | grep -q "esc to interrupt" && return 0    # mid-turn: wait for the gap
  echo "$pane" | grep -q "❯" || return 0                    # not at a prompt yet
  local spid sf st sua
  spid=$(tmux list-panes -t "$(_tmux "$id")" -F '#{pane_pid}' 2>/dev/null | head -1)
  sf="$(_cfg_dir "$wrapper")/sessions/$spid.json"
  st=$(grep -oE '"status":"[a-z_-]+"' "$sf" 2>/dev/null | head -1 | cut -d'"' -f4)
  [[ "$st" == "idle" ]] || return 0
  # Quiet gate (short): don't relocate a session someone just touched from any surface —
  # statusUpdatedAt (ms) ticks on every busy<->idle transition, incl. web/mobile clients.
  sua=$(grep -oE '"statusUpdatedAt":[0-9]+' "$sf" 2>/dev/null | head -1 | cut -d: -f2)
  [[ -n "$sua" && $(( now * 1000 - sua )) -ge $(( SWAP_CEIL_QUIET * 1000 )) ]] || return 0
  _reg_set "$id" lastswap "$now"
  echo "$(date '+%F %T') auto-home $id: $wrapper -> $target [home=$home]" >> "$REG/swap.log"
  _dispatch_swap "$id" "$target"
  return 0
}

_pane_ctx_pct() {   # pane text -> context % from the "▓ ctx <bar> NN%" statusline segment, or empty.
  # Anchored to "ctx": the model's "(1M context)" has no "ctx" substring, and the limits/cost %s are
  # not preceded by "ctx"; the bar glyphs between "ctx" and the number are non-digits.
  printf '%s\n' "$1" | grep -aoiE 'ctx[^0-9]*[0-9]+%' | grep -oE '[0-9]+' | head -1
}

_auto_compact_check() {   # id — at a clean idle turn boundary, /compact a session whose own context has
  # grown past COMPACT_THRESHOLD so it stays lean. Non-destructive: the SessionStart(compact) hook
  # restores git/plan/handoff context (Anthropic + gpt lanes). Kill-switch: AUTOCOMPACT_DISABLE_FILE.
  [[ -f "$AUTOCOMPACT_DISABLE_FILE" ]] && return 0
  local id="$1" now last lastswap pane pct wrapper spid sf st sua t cur
  now=$(date +%s)
  last=$(_reg_get "$id" lastcompact)
  [[ -n "$last" && $((now - last)) -lt "$COMPACT_COOLDOWN" ]] && return 0
  lastswap=$(_reg_get "$id" lastswap)   # a swap landing already compacted from summary — don't double up
  [[ -n "$lastswap" && $((now - lastswap)) -lt "$COMPACT_COOLDOWN" ]] && return 0
  pane=$(tmux capture-pane -t "$(_tmux "$id")" -p 2>/dev/null | tail -8)
  [[ -n "$pane" ]] || return 0
  pct=$(_pane_ctx_pct "$pane"); [[ -n "$pct" ]] || return 0
  [[ "$pct" -ge "$COMPACT_THRESHOLD" ]] || return 0
  # Clean idle turn boundary — same discipline as the swap soft-path (never mid-turn/subagent).
  echo "$pane" | grep -q "esc to interrupt" && return 0     # mid-turn
  echo "$pane" | grep -q "❯" || return 0                     # not at a prompt yet
  wrapper=$(_reg_get "$id" wrapper)
  spid=$(tmux list-panes -t "$(_tmux "$id")" -F '#{pane_pid}' 2>/dev/null | head -1)
  sf="$(_cfg_dir "$wrapper")/sessions/$spid.json"
  st=$(grep -oE '"status":"[a-z_-]+"' "$sf" 2>/dev/null | head -1 | cut -d'"' -f4)
  [[ "$st" == "idle" ]] || return 0
  # Quiet gate: only compact a session idle a beat — not the instant it goes idle, nor one just
  # touched from any surface (statusUpdatedAt ms ticks on every busy<->idle transition).
  sua=$(grep -oE '"statusUpdatedAt":[0-9]+' "$sf" 2>/dev/null | head -1 | cut -d: -f2)
  [[ -n "$sua" && $(( now * 1000 - sua )) -ge $(( COMPACT_QUIET * 1000 )) ]] || return 0
  # Don't clobber a half-typed message in the input box.
  t=$(_tmux "$id")
  cur=$(tmux capture-pane -t "$t" -p 2>/dev/null | grep -m1 "^❯ " | sed "s/^❯ //; s/[[:space:]]*$//")
  [[ -n "$cur" ]] && return 0
  _reg_set "$id" lastcompact "$now"
  echo "$(date '+%F %T') auto-compact $id: ctx ${pct}% >= ${COMPACT_THRESHOLD}% [wrapper=$wrapper]" >> "$REG/swap.log"
  tmux send-keys -t "$t" -l "/compact"; sleep 1; tmux send-keys -t "$t" Enter
}

_accept_first_run_prompts() {   # tmuxname — clear startup gates, then CONFIRM the main TUI is up.
  # Returns as soon as "/rc active" (or another live marker) appears. Gates, order-agnostic,
  # each needing a DIFFERENT keystroke:
  #   • trust-folder prompt  — default is "1. Yes, I trust this folder"  → just Enter
  #   • Bypass-Permissions warning — default is "1. No, exit" (!), accept is "2. Yes, I accept"
  #       → must move Down to option 2, THEN Enter. (Sending a bare Enter here would EXIT.)
  #   • (2.1.198+) big-transcript resume gate "Resume from summary (recommended)" → pick
  #       "2. Resume full session as-is" (Down, Enter) so nothing gets silently compacted.
  #   • (2.1.198+) per-session "Try the new fullscreen renderer?" opt-in → pick "2. Not now"
  #       (Down, Enter): ccd/ccclip scrape the pane via capture-pane; the new renderer +
  #       mouse support may break that scraping.
  # The two 2.1.198 gates are matched together with the "Enter to confirm" menu footer so the
  # same words inside a restored transcript can't false-trigger keystrokes.
  # Window is ~15 min because 700k+-token resumes take minutes between gates; healthy sessions
  # return the moment the live marker shows, so the common path stays fast.
  local t="$1" fromswap="${2:-0}" i pane
  for i in $(seq 1 450); do
    pane=$(tmux capture-pane -t "$t" -p 2>/dev/null)
    # ready markers: any of these means the TUI is up. NB the RC indicator sometimes renders
    # as bare "/rc" (not "/rc active"), so the permission-mode footer is the reliable signal —
    # without it supervise sits here for the full window and never reaches its watch loop.
    echo "$pane" | grep -Eq "/rc active|\? for shortcuts|esc to interrupt|shift\+tab to cycle|← for agents" && return 0
    if echo "$pane" | grep -q "Enter to confirm" && echo "$pane" | grep -q "Resume from summary"; then
      if [[ "$fromswap" == "1" ]]; then
        # Swap landing: auto-compact — the target account pays one summary, not a full
        # 700k-token history re-read (user decision 2026-07-03). Option 1 is the default.
        tmux send-keys -t "$t" Enter
      else
        # Same-account resurrect: keep full fidelity — "Resume full session as-is".
        tmux send-keys -t "$t" Down; sleep 1; tmux send-keys -t "$t" Enter
      fi
      sleep 2; continue
    fi
    if echo "$pane" | grep -q "Enter to confirm" && echo "$pane" | grep -q "Try the new fullscreen renderer"; then
      tmux send-keys -t "$t" Down; sleep 1; tmux send-keys -t "$t" Enter; sleep 2; continue
    fi
    if echo "$pane" | grep -q "Bypass Permissions mode"; then
      tmux send-keys -t "$t" Down; sleep 1; tmux send-keys -t "$t" Enter; sleep 2; continue
    fi
    if echo "$pane" | grep -q "trust this folder"; then
      tmux send-keys -t "$t" Enter; sleep 2; continue
    fi
    sleep 2
  done
}

_spawn() {   # id mode(new|resume) — (re)create the tmux session under the right account
  # NOTE: v2.1.177 does not print the claude.ai URL to the pane or debug log, so there is no
  # URL to capture. The session is discovered on claude.ai by its name, which == the id
  # (we pass `--remote-control '$id'`). _spawn just (re)creates the session and accepts trust.
  local id="$1" mode="$2" wrapper workdir uuid tname sidflag
  wrapper=$(_reg_get "$id" wrapper); workdir=$(_reg_get "$id" workdir); uuid=$(_reg_get "$id" uuid)
  [[ -n "$wrapper" && -n "$workdir" && -n "$uuid" ]] || die "incomplete registry for '$id'"
  tname=$(_tmux "$id")
  # A spawn within 5 min of a swap is the swap LANDING on the new account — resume from
  # summary there (cheap) instead of full-as-is (700k re-read on the fresh limit pool).
  local fromswap=0 lastswap
  lastswap=$(_reg_get "$id" lastswap)
  [[ -n "$lastswap" && $(( $(date +%s) - lastswap )) -lt 300 ]] && fromswap=1
  if [[ "$mode" == "resume" ]]; then sidflag="--resume '$uuid'"; else sidflag="--session-id '$uuid'"; fi
  # COLORTERM=truecolor so Claude Code emits 24-bit colour (it otherwise quantises
  # to 256, collapsing its palette). tmux passes it through to the terminal-drawer
  # xterm once the server has the RGB terminal-feature (see hardening/tmux.conf).
  tmux new-session -d -s "$tname" -x 220 -y 50 \
    "cd '$workdir' && exec env COLORTERM=truecolor '$WRAPPER_DIR/$wrapper' --remote-control '$id' $sidflag --dangerously-skip-permissions"
  # Make this window's terminal title = the tmux session name ("cc-<id>"), so a frontmost-window-
  # aware hotkey (ccclip) can target exactly the session you're looking at, even with many open.
  tmux set-option -t "$tname" set-titles on 2>/dev/null
  tmux set-option -t "$tname" set-titles-string '#S' 2>/dev/null
  # Follow the most-recent client's size (defensive; with attach -d there's only ever one client,
  # so the window always fits the device you're on — no smaller-client "dotted filler" clash).
  tmux set-option -t "$tname" window-size latest 2>/dev/null
  _accept_first_run_prompts "$tname" "$fromswap"
  # /effort ultracode is a Claude-model effort tier; skip it on the gpt lane (GPT backend
  # doesn't take it and the injection would just error into the prompt box).
  [[ "$wrapper" != gpt ]] && _inject_spawn_effort "$tname"
}

_inject_spawn_effort() {   # tmuxname — apply SPAWN_EFFORT once the TUI is up.
  [[ -n "$SPAWN_EFFORT" ]] || return 0
  local t="$1" cur
  # Only type into an EMPTY input box — a restored draft would swallow the slash command.
  cur=$(tmux capture-pane -t "$t" -p 2>/dev/null | grep -m1 "^❯ " | sed "s/^❯ //; s/[[:space:]]*$//")
  if [[ -n "$cur" ]]; then echo "ccd: input box not empty, skipped /effort $SPAWN_EFFORT" >&2; return 0; fi
  sleep 1
  tmux send-keys -t "$t" -l "/effort $SPAWN_EFFORT"; sleep 1; tmux send-keys -t "$t" Enter
  # Sessions with cached history confirm the switch ("full history gets re-read") — accept.
  sleep 2
  if tmux capture-pane -t "$t" -p 2>/dev/null | grep -q "Yes, switch"; then
    tmux send-keys -t "$t" Enter
  fi
  return 0
}

cmd_start() {
  local wrapper="${1:-}" project="${2:-}" workdir="${3:-}"
  [[ -n "$wrapper" && -n "$project" ]] || die "usage: ccd start <wrapper> <project> [workdir]"
  _is_valid_wrapper "$wrapper" || die "unknown wrapper '$wrapper' (valid: ${VALID_WRAPPERS[*]})"
  [[ "$project" =~ ^[A-Za-z0-9._-]+$ ]] || die "invalid project '$project' (allowed chars: A-Za-z0-9 . _ -)"
  [[ -x "$WRAPPER_DIR/$wrapper" ]] || die "wrapper missing: $WRAPPER_DIR/$wrapper"
  [[ -z "$workdir" ]] && workdir="$PROJECTS_ROOT/$project"
  [[ "$workdir" != *\'* ]] || die "workdir must not contain a single quote: $workdir"
  [[ -d "$workdir" ]] || die "workdir missing: $workdir"
  local id; id=$(_id "$wrapper" "$project")
  if _alive "$id"; then echo "already running: $id (find on claude.ai by name: $id)"; return 0; fi
  local uuid; uuid=$(_reg_get "$id" uuid); [[ -z "$uuid" ]] && uuid=$(cat /proc/sys/kernel/random/uuid)
  _reg_set "$id" wrapper "$wrapper"; _reg_set "$id" project "$project"
  _reg_set "$id" workdir "$workdir"; _reg_set "$id" uuid "$uuid"
  _ws_seed_home "$id" "$wrapper"
  local mode=new; [[ "$(_reg_get "$id" started)" == "1" ]] && mode=resume
  _spawn "$id" "$mode"; _reg_set "$id" started 1
  echo "started $id ($mode) — discover on claude.ai by name: $id"
}

cmd_ensure() {   # idempotent; used by systemd. arg is the id directly.
  local id="${1:?usage: ccd ensure <id>}"
  [[ -f "$REG/$id.uuid" ]] || die "no registry for '$id' (run ccd start first)"
  if _alive "$id"; then echo "alive: $id"; return 0; fi
  local mode=new; [[ "$(_reg_get "$id" started)" == "1" ]] && mode=resume
  _spawn "$id" "$mode"; _reg_set "$id" started 1
  echo "ensured $id ($mode)"
}

cmd_supervise() {   # systemd ExecStart: ensure then block until the session dies
  local id="${1:?usage: ccd supervise <id>}"
  cmd_ensure "$id"
  while _alive "$id"; do _sync_uuid "$id"; _auto_swap_check "$id"; _auto_compact_check "$id"; sleep 5; done
  echo "session $id ended; exiting for systemd restart" >&2
  exit 1
}

_sanitize_anthropic() {   # transcript-path — fill EMPTY assistant text blocks (a gpt/Codex-lane
  # artifact) with a placeholder so the Anthropic API accepts the resumed history.
  local f="$1"; [[ -f "$f" ]] || return 0
  python3 - "$f" <<'PY' 2>/dev/null || echo "ccd: warn: transcript sanitize skipped (python3?)" >&2
import json,sys,os
f=sys.argv[1]; out=[]; n=0
for ln in open(f):
    s=ln.rstrip("\n")
    try: o=json.loads(s)
    except: out.append(s); continue
    c=o.get("message",{}).get("content")
    if isinstance(c,list):
        ch=False
        for b in c:
            if isinstance(b,dict) and b.get("type")=="text" and b.get("text","").strip()=="":
                b["text"]="..."; ch=True; n+=1
        if ch: s=json.dumps(o,ensure_ascii=False)
    out.append(s)
if n:
    open(f+".tmp","w").write("\n".join(out)+"\n"); os.replace(f+".tmp",f)
    sys.stderr.write(f"ccd: sanitized {n} empty text blocks for Anthropic\n")
PY
}

cmd_swap() {   # id target-wrapper — move a session to another account, conversation intact.
  # Transcripts are plain JSONL with no account binding (validated 2026-07-03): copy the
  # current transcript into the target config dir, flip the registry wrapper, restart.
  # Manual swaps may target ANY valid wrapper; the pool policy only constrains auto-swaps.
  local id="${1:?usage: ccd swap <id> <target-wrapper>}" target="${2:?usage: ccd swap <id> <target-wrapper>}"
  _is_valid_wrapper "$target" || die "unknown wrapper '$target' (valid: ${VALID_WRAPPERS[*]})"
  [[ -f "$REG/$id.uuid" ]] || die "no registry for '$id'"
  local cur; cur=$(_reg_get "$id" wrapper)
  [[ "$target" != "$cur" ]] || die "'$id' is already on $cur"
  [[ -x "$WRAPPER_DIR/$target" ]] || die "wrapper missing: $WRAPPER_DIR/$target"
  # Invoked from inside the session being swapped (Claude's own Bash tool)? The swap kills
  # its caller mid-flight — detach an orphan to finish the job after we return.
  if [[ -n "${TMUX:-}" && "$(tmux display-message -p '#S' 2>/dev/null)" == "$(_tmux "$id")" && -z "${CCD_SWAP_DETACHED:-}" ]]; then
    systemd-run --user --collect --quiet bash -c "sleep 2; CCD_SWAP_DETACHED=1 exec '$HOME/.local/bin/ccd' swap '$id' '$target' >>'$REG/swap.log' 2>&1"
    echo "detached: $id will restart under $target in a few seconds (this session dies with the swap — that's expected)"
    return 0
  fi
  local uuid wd srccfg dstcfg mdir
  uuid=$(_reg_get "$id" uuid); wd=$(readlink -f "$(_reg_get "$id" workdir)")
  srccfg=$(_cfg_dir "$cur"); dstcfg=$(_cfg_dir "$target")
  [[ -n "$srccfg" && -n "$dstcfg" ]] || die "no config-dir mapping for '$cur' -> '$target'"
  mdir=$(echo "$wd" | tr '/._' '---')
  systemctl --user stop "claude-session@$id" 2>/dev/null   # first, or Restart=always resurrects under the old wrapper
  tmux kill-session -t "$(_tmux "$id")" 2>/dev/null
  sleep 1                                                  # let claude flush its final transcript entries
  if [[ -f "$srccfg/projects/$mdir/$uuid.jsonl" ]]; then
    mkdir -p "$dstcfg/projects/$mdir"
    cp "$srccfg/projects/$mdir/$uuid.jsonl" "$dstcfg/projects/$mdir/"
    # gpt -> Anthropic: the Codex lane (via LiteLLM) writes assistant messages with
    # EMPTY text blocks, which the Anthropic API rejects on the next turn ("text
    # content blocks must be non-empty" -> every turn 400s). Fill them so the
    # resumed session is valid. Anthropic -> Anthropic and *-> gpt need no fixup.
    if [[ "$cur" == gpt && "$target" != gpt ]]; then
      _sanitize_anthropic "$dstcfg/projects/$mdir/$uuid.jsonl"
    fi
  else
    echo "ccd: warn: transcript $uuid.jsonl not found under $cur config; session may resume without history" >&2
  fi
  # The task list lives at <configdir>/tasks/<uuid>/ and is keyed by config dir,
  # so a swap orphans it under the OLD account: the resumed session forgets its
  # plan entirely (seen 2026-07-26 — custom-tools kept 8 task files under
  # .claude-gpt while running on claude-corp with an empty list). Carry it over
  # with the transcript. Copy, don't move: if the swap is reverted the old lane
  # still has its copy, and a stale dir costs a few KB.
  if [[ -d "$srccfg/tasks/$uuid" ]]; then
    mkdir -p "$dstcfg/tasks"
    cp -r "$srccfg/tasks/$uuid" "$dstcfg/tasks/" 2>/dev/null \
      || echo "ccd: warn: could not carry the task list across to $target" >&2
  fi
  _reg_set "$id" wrapper "$target"
  _reg_set "$id" lastswap "$(date +%s)"
  echo "$(date '+%F %T') swap $id: $cur -> $target (uuid $uuid)" >> "$REG/swap.log"
  systemctl --user start "claude-session@$id" 2>/dev/null || cmd_ensure "$id"
  # Optional user notification (swap kills any attached remote session — give them a ping).
  # Drop an executable ~/.cc-sessions/notify.sh taking the message as $1 (curl to a Discord
  # webhook / ntfy topic / anything); absent hook = silent.
  [[ -x "$REG/notify.sh" ]] && "$REG/notify.sh" "cc swap: $id moved $cur -> $target (limits) — reopen it on claude.ai under the $target account" >/dev/null 2>&1
  echo "swapped $id: $cur -> $target (discover on claude.ai under the $target account)"
}

cmd_swap_self() {   # target — run from INSIDE a cc session (terminal, web, or mobile:
  # just tell Claude "run ~/.local/bin/ccd swap-self <wrapper>"). Swaps the calling session.
  local target="${1:?usage: ccd swap-self <target-wrapper>}"
  [[ -n "${TMUX:-}" ]] || die "swap-self only works from inside a cc tmux session"
  local id; id=$(tmux display-message -p '#S' 2>/dev/null); id="${id#cc-}"
  [[ -f "$REG/$id.uuid" ]] || die "current tmux session '$id' is not ccd-managed"
  cmd_swap "$id" "$target"
}

cmd_prefer() {   # id wrapper — set a session's HOME account (auto-swap keeps it here, and returns
  # here whenever home is free again). Default home = the wrapper in the id prefix.
  local id="${1:?usage: ccd prefer <id> <wrapper>}" w="${2:?usage: ccd prefer <id> <wrapper>}"
  _is_valid_wrapper "$w" || die "unknown wrapper '$w' (valid: ${VALID_WRAPPERS[*]})"
  [[ -f "$REG/$id.uuid" ]] || die "no registry for '$id'"
  _reg_set "$id" home "$w"
  echo "home for $id set to $w"
}

cmd_enable() {   # start (if needed) + make boot-persistent + supervise now
  local wrapper="${1:?}" project="${2:?}" workdir="${3:-}"
  cmd_start "$wrapper" "$project" "$workdir"
  local id; id=$(_id "$wrapper" "$project")
  if systemctl --user enable --now "claude-session@$id" 2>/dev/null; then
    echo "enabled boot-persistence for $id"
  else
    echo "warn: could not enable systemd unit (lingering/unit installed?)" >&2
  fi
}

cmd_stop() {   # <id>  |  <wrapper> <project>
  # The two-argument form is the legacy one and recomputes `<wrapper>-<project>`.
  # That only works for ids that ENCODE a wrapper; a workspace id is
  # `<project>-<slug>`, so a caller forced to reverse one guesses a wrapper and
  # aims the stop at a different, live session. The one-argument form takes the
  # id directly, exactly as `ccd ensure` does.
  local id
  if [[ $# -ge 2 ]]; then
    local wrapper="${1:?}" project="${2:?}"
    id=$(_id "$wrapper" "$project")
  else
    id="${1:?usage: ccd stop <id> | ccd stop <wrapper> <project>}"
  fi
  systemctl --user disable --now "claude-session@$id" 2>/dev/null \
    || echo "ccd: warn: could not disable unit claude-session@$id (it may resurrect if it was enabled)" >&2
  tmux kill-session -t "$(_tmux "$id")" 2>/dev/null || true
  echo "stopped $id"
}

cmd_ls() {
  printf '%-28s %-12s %-6s %s\n' "ID" "WRAPPER" "ALIVE" "WORKDIR"
  local f id; shopt -s nullglob
  local files=("$REG"/*.uuid)
  [[ ${#files[@]} -eq 0 ]] && { echo "(no sessions)"; return 0; }
  local gpt_here=0
  for f in "${files[@]}"; do
    id=$(basename "$f" .uuid); local alive=no; _alive "$id" && alive=yes
    local w; w=$(_reg_get "$id" wrapper); [[ "$w" == gpt ]] && gpt_here=$((gpt_here+1))
    printf '%-28s %-12s %-6s %s\n' "$id" "$w" "$alive" "$(_reg_get "$id" workdir)"
  done
  echo "gpt overflow lane: $(_gpt_status)  —  $gpt_here session(s) currently on it"
  echo "(open $CLAUDE_AI_BASE in the matching account and pick the session whose name == ID)"
}

cmd_attach() {   # create-on-demand, then exec tmux attach
  local wrapper="${1:?usage: ccd attach <wrapper> <project>}" project="${2:?}"
  local id; id=$(_id "$wrapper" "$project")
  [[ -f "$REG/$id.uuid" ]] || cmd_start "$wrapper" "$project" >/dev/null || die "start failed"
  _alive "$id" || cmd_ensure "$id" >/dev/null || die "ensure failed for $id"
  exec tmux attach -t "$(_tmux "$id")"
}

cmd_menu() {   # interactive picker → attach. The universal entry point for any SSH/terminal app:
  # set the app's on-connect command to `~/.local/bin/ccd menu` and you get this list, pick, attach.
  shopt -s nullglob
  local files=("$REG"/*.uuid) ids=() f id i alive
  for f in "${files[@]}"; do ids+=("$(basename "$f" .uuid)"); done
  if [[ ${#ids[@]} -eq 0 ]]; then echo "no sessions yet — create one with: ccd start <wrapper> <project>"; return 1; fi
  echo "── server-box sessions ──"
  for i in "${!ids[@]}"; do
    id="${ids[$i]}"; alive="dead"; _alive "$id" && alive="live"
    printf "  %2d) %-30s [%s]\n" "$((i + 1))" "$id" "$alive"
  done
  printf "pick a number (q to quit): "
  local choice; read -r choice
  [[ "$choice" == "q" || -z "$choice" ]] && return 0
  [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#ids[@]} )) || { echo "invalid choice"; return 1; }
  id="${ids[$((choice - 1))]}"
  _alive "$id" || cmd_ensure "$id" >/dev/null || die "ensure failed for $id"
  exec tmux attach -t "$(_tmux "$id")"
}

# <dir> <src> — destination for a filed clip. Split out of cmd_clip so it can be
# sourced and asserted: cmd_clip dies at `_alive` long before it gets here.
# Keeps the SOURCE extension (this used to hardcode .png, so a JPEG lied about
# its format) and adds a random suffix (the 1s stamp let two clips in the same
# second mv -f over each other).
_clip_dest() {
  local dir="$1" src="$2" ext
  ext="${src##*.}"
  ext="$(printf '%s' "$ext" | tr '[:upper:]' '[:lower:]')"
  case "$ext" in png|jpg|jpeg|webp) ;; *) ext=png ;; esac
  printf '%s/clip-%s-%08x.%s\n' "$dir" "$(date +%Y%m%d-%H%M%S)" "$(( (RANDOM << 15) | RANDOM ))" "$ext"
}

cmd_clip() {   # <png-path> [id] — file an image into a session and inject its path into the prompt.
  # Default target is the session of the most-recently-active ATTACHED client (i.e. the one you're
  # looking at). Pass an explicit id to override. The path is typed (no Enter) so you add your text.
  local png="${1:?usage: ccd clip <png-path> [id]}" id="${2:-}"
  [[ -f "$png" ]] || die "no such image: $png"
  if [[ -z "$id" ]]; then
    id=$(tmux list-clients -F '#{client_activity} #{client_session}' 2>/dev/null \
           | sort -rn | awk 'NR==1{print $2}' | sed 's/^cc-//')
    [[ -n "$id" ]] || die "no attached cc session (attach with 'cc <wrapper> <project>', or pass an id)"
  fi
  _alive "$id" || die "session not alive: $id"
  local dir="$HOME/.cc-clips/$id"; mkdir -p "$dir"
  local dest; dest="$(_clip_dest "$dir" "$png")"
  mv -f "$png" "$dest"
  tmux send-keys -t "$(_tmux "$id")" -l "$dest "
  echo "clip -> $dest (injected into $id)"
}

# Guard so the script can be `source`d by tests without running a command.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
case "${1:-}" in
  start)     shift; cmd_start "$@" ;;
  ensure)    shift; cmd_ensure "$@" ;;
  supervise) shift; cmd_supervise "$@" ;;
  enable)    shift; cmd_enable "$@" ;;
  stop)      shift; cmd_stop "$@" ;;
  swap)      shift; cmd_swap "$@" ;;
  swap-self) shift; cmd_swap_self "$@" ;;
  prefer)    shift; cmd_prefer "$@" ;;
  ls|list)   cmd_ls ;;
  menu|pick) cmd_menu ;;
  attach)    shift; cmd_attach "$@" ;;
  clip)      shift; cmd_clip "$@" ;;
  ws-add)    shift; cmd_ws_add "$@" ;;
  ws-rm)     shift; cmd_ws_rm "$@" ;;
  ws-rename) shift; cmd_ws_rename "$@" ;;
  ws-gc)     shift; cmd_ws_gc "$@" ;;
  *) echo "usage: ccd {start|ensure|supervise|enable|stop|swap|swap-self|prefer|ls|menu|attach|clip|ws-add|ws-rm|ws-rename|ws-gc} <args>" >&2; exit 1 ;;
esac
fi
