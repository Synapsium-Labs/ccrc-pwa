  _ccrc_knob CCRC_TESTBOX_RUN_TMPDIR /tmp/r file; _tb_got CCRC_TESTBOX_RUN_TMPDIR /tmp/r $?
  _ccrc_knob CCRC_TESTBOX_RUN_MEMORY_MAX 4G file; _tb_got CCRC_TESTBOX_RUN_MEMORY_MAX 4G $?
