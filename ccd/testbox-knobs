  _ccrc_knob CCRC_TESTBOX_PUSH_USER ccrc-tb-push file; _tb_got CCRC_TESTBOX_PUSH_USER ccrc-tb-push $?
  _ccrc_knob CCRC_TESTBOX_ENV_FORWARD "CCRC_HISTORY_BASE CCRC_LEDGER_BASE" file; _tb_got CCRC_TESTBOX_ENV_FORWARD "CCRC_HISTORY_BASE CCRC_LEDGER_BASE" $?
  _ccrc_knob CCRC_TESTBOX_RUN_USER_PREFIX ccrc-tb- file; _tb_got CCRC_TESTBOX_RUN_USER_PREFIX ccrc-tb- $?
  _ccrc_knob CCRC_TESTBOX_REGISTRY_PROXY 127.0.0.2:4873 file; _tb_got CCRC_TESTBOX_REGISTRY_PROXY 127.0.0.2:4873 $?
  _ccrc_knob CCRC_TESTBOX_REGISTRY_UPSTREAM https://registry.npmjs.org file; _tb_got CCRC_TESTBOX_REGISTRY_UPSTREAM https://registry.npmjs.org $?
  _ccrc_knob CCRC_TESTBOX_TMPFS off file; _tb_got CCRC_TESTBOX_TMPFS off $?
  _ccrc_knob CCRC_TESTBOX_LOG_TAIL 40 file; _tb_got CCRC_TESTBOX_LOG_TAIL 40 $?
  _ccrc_knob CCRC_TESTBOX_SESSION_RUNS 1 file; _tb_got CCRC_TESTBOX_SESSION_RUNS 1 $?
  _ccrc_knob CCRC_TESTBOX_SERVICE_USER ccrc-tb-svc file; _tb_got CCRC_TESTBOX_SERVICE_USER ccrc-tb-svc $?
  _ccrc_knob CCRC_TESTBOX_LISTEN '' file; _tb_got CCRC_TESTBOX_LISTEN '' $?
  _ccrc_knob CCRC_TESTBOX_SERVICE_TOKEN_FILE '~/.ccrc/testbox-service.token' file; _tb_got CCRC_TESTBOX_SERVICE_TOKEN_FILE '~/.ccrc/testbox-service.token' $?
  _ccrc_knob CCRC_TESTBOX_UNIT_MAX 1h file; _tb_got CCRC_TESTBOX_UNIT_MAX 1h $?
}

# ── the validated load ───────────────────────────────────────────────────
_tb_got() {   # <KEY> <default> <rc of _ccrc_knob>; TB_SRC names the file the mode reads
  local k="$1" d="$2" v from="${KNOB_FROM:-default}" prog="${PROG:-ccrc test}"
  TBK_KEYS+=("$k"); TBK_DEF["$k"]="$d"
  if [ "$3" != 0 ]; then
    TBK_WARN+=("$prog: WARN: ${KNOB_WHY:-$k cannot be read}; using its default ${d:-''}"); v="$d"; from=default
  else
    v="$KNOB"
    if [ -n "$v" ] && ! _tb_shape "$k" "$v"; then
      TBK_WARN+=("$prog: WARN: $k=$v (from the $TB_SRC) is not $(_tb_shape_says "$k"); using its default ${d:-''}"); v="$d"; from=default
    fi
  fi
  TBK["$k"]="$v"; TBK_FROM["$k"]="$from"
  # Box-wide: a value in the caller's environment is not read; one that differs says so.
  [ -z "${!k:-}" ] || [ "${!k}" = "$v" ] \
    || TBK_WARN+=("$prog: WARN: $k=${!k} in the environment is ignored: it holds for the whole box, so only $TB_SRC sets it (in use: ${v:-''})")
}
_tb_load() {   # host|box -> TBK[KEY] (the value), TBK_DEF, TBK_FROM, TBK_KEYS (in table order), TBK_WARN (lines)
  declare -gA TBK=() TBK_DEF=() TBK_FROM=()
  TBK_KEYS=(); TBK_WARN=()
  local f=""
  case "${1:-}" in
    host) TB_SRC="${BOX_ENV_FILE/#"$HOME"/\~}"; _tb_host_table ;;
    box)
      TB_SRC="$TB_BOX_ENV_FILE"
      if _tb_box_file_ok "$TB_BOX_ENV_FILE"; then f="$TB_BOX_ENV_FILE"
      else TBK_WARN+=("${PROG:-ccrc test}: WARN: the test box's settings file is refused: $TB_BOX_WHY; every test box setting uses its default"); fi
      # The one binding of BOX_ENV_FILE for box mode: the box file, or, refused, no file at all (every default).
      BOX_ENV_FILE="$f" _tb_box_table ;;
    *) TBK_WARN+=("${PROG:-ccrc test}: _tb_load takes host or box"); return 2 ;;
  esac
}
_testbox_knobs() {   # host|box [file] -> one validated KEY<US>default<US>value<US>from line per key; warnings on stderr
  local k w
  case "${1:-}" in host|box) ;; *) echo "${PROG:-ccrc test}: _testbox_knobs takes host or box" >&2; return 2 ;; esac
  # `file` is the only mode: every test box key is box-wide (the argument is accepted for `_graph_knobs`' symmetry).
  case "${2:-file}" in file) ;; *) echo "${PROG:-ccrc test}: _testbox_knobs reads only in file mode" >&2; return 2 ;; esac
  _tb_load "$1" || return
  for w in ${TBK_WARN[@]+"${TBK_WARN[@]}"}; do printf '%s\n' "$w" >&2; done
  for k in "${TBK_KEYS[@]}"; do printf '%s\037%s\037%s\037%s\n' "$k" "${TBK_DEF[$k]}" "${TBK[$k]}" "${TBK_FROM[$k]}"; done
}

# ── the release base the tools unit reads (D-7457) ───────────────────────
# `_tb_release_base` — CCRC_RELEASE_BASE_URL from the box file, the way box mode reads every box key: the file passes
# `_tb_box_file_ok`, and `_upd_release_base file` reads it through `_ccrc_knob` in `file` mode with BOX_ENV_FILE bound
# to TB_BOX_ENV_FILE for that one call, so neither the caller's ~/.ccrc/ccrc.env nor its environment is read. The value
# is then assigned to the caller's own CCRC_RELEASE_BASE_URL, so the reads `_upd_resolve` and `_upd_fetch` make
# themselves (environment first) take it and no inherited one. rc 0: the value is set (the default when the file names
# none). rc 1: TB_BOX_WHY says why (a refused file, or `_ccrc_knob`'s KNOB_WHY for a value it cannot measure), and the
# caller's CCRC_RELEASE_BASE_URL is emptied, so a caller that went on anyway would not fetch from an inherited host.
# Called in the caller's shell, never `$(…)`, so the assignment and TB_BOX_WHY reach it.
_tb_release_base() {
  if ! _tb_box_file_ok "$TB_BOX_ENV_FILE"; then CCRC_RELEASE_BASE_URL=""; return 1; fi
  # The second binding of BOX_ENV_FILE in this file (D-7451, D-7457), for this one read.
  if ! BOX_ENV_FILE="$TB_BOX_ENV_FILE" _upd_release_base file >/dev/null 2>&1; then
    TB_BOX_WHY="${KNOB_WHY:-CCRC_RELEASE_BASE_URL cannot be read from $TB_BOX_ENV_FILE}"; CCRC_RELEASE_BASE_URL=""; return 1
  fi
  CCRC_RELEASE_BASE_URL="$KNOB"
}
