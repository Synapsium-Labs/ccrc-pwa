#!/usr/bin/env bash
# ccrc — the lifecycle CLI for a Claude Code fleet box: installs, updates and
# diagnoses a box, as a sibling to `ccd`, which drives sessions once one is
# already running. Stage 2b of the 2026-08-15-stage2b-ccrc-cli-and-doctor plan:
# `version` (Task 1), `doctor` (Tasks 4-5), `status` (Task 7) and `adopt`
# (Task 8) are all implemented, so the "not implemented yet" register that
# stood in for the unbuilt verbs has no caller and is gone with the last one
# that used it. Every verb name in the usage line now does its job.
#
# ── WHY `set -uo pipefail`, NOT `-euo` ─────────────────────────────────────
# `ccrc-adopt` (this file's own model for argument handling) uses `-e`
# because it is a straight-line pipeline of "measure, or die" steps: any
# failure really should stop everything right there. `ccrc doctor` (Task 3+)
# is the opposite shape — a LIST of independent checks, each of which SIGNALS
# by returning non-zero, and the whole point of running doctor is to see every
# check's verdict in one pass, not to abort at the first failing one. `-e`
# here would turn "the box is missing three things" into "the box is missing
# one thing, and doctor crashed" the moment the first check's `return 1` hit a
# `set -e` shell. So: no `-e`, ever, in this file. If a future change adds
# `-e` back "because it caught a real bug", it has broken doctor; don't.
# `-u` (unset variables are errors) and `pipefail` (a failing left-hand side
# of a pipe fails the whole pipeline) carry no such conflict and stay on.
#
# ── EXIT CODES (house convention — see ccd/ccrc-adopt:68-91 and
#    deploy/verify-service.sh:50-54, both already committed to this table) ──
#   0 = success.
#   1 = the tool ran and the answer was bad (a check failed, a stamp did not
#       parse, a verb is not implemented yet).
#   2 = USAGE error — an unknown verb or argument. Kept distinct from 1 so a
#       caller can tell "you typed it wrong" apart from "doctor found a real
#       problem": scripting `ccrc doctor; case $? in 1) …` must never trip on
#       a typo instead of a genuine finding.
#
# ── DIAGNOSTIC REGISTERS (adopt's own convention, reused here) ─────────────
# Every line this script prints to stderr is prefixed "$PROG: ", then one of:
#   - a bare refusal — "$PROG: <what went wrong>" (`_ccrc_die`, exits 1).
#   - a usage error — "$PROG: unknown argument: …" (`_ccrc_usage_die`, exits 2).
# The RESULT of a verb (what the operator actually asked for) goes to
# stdout, same split as ccrc-adopt's JSON-on-stdout / diagnostics-on-stderr.
#
# Adopt's THIRD register, "note: …" (informational, does not change the exit
# code), has no caller in `ccrc` and its `_ccrc_say` helper has been REMOVED
# (Task 4 review, Minor 4). It was carried from Task 1 on the prediction that
# doctor's `remedy:` lines would ride it; they do not (see the next paragraph),
# so it stood as untested, uncalled code whose only documentation was a
# statement of what it was for that had become false. Task 1 guessed `ccrc
# status` would be its first caller; Task 7 measured that to be wrong too —
# status prints FACTS, and a fact is the RESULT of the verb, so every line it
# writes goes to stdout. Re-add `_ccrc_say` in one line together with a real
# caller, and not before.
#
# DOCTOR'S "remedy: …" LINES ARE NOT IN THAT STDERR TABLE, and this paragraph
# is the correction of a guess Task 1 made before doctor existed: it predicted
# that a non-pass verdict's remedy would ride `_ccrc_say` on stderr. It does
# not. A verdict line and its remedy are two halves of ONE result — the
# contract `server/test/ccrc-doctor.test.ts` pins is "the line immediately
# after a FAIL is that FAIL's remedy" — so splitting the pair across two
# streams would break it for every caller that redirects one of them, which is
# every caller that pipes doctor into a report. Both halves are the RESULT and
# both go to stdout; see `ccd/ccrc-doctor-checks`'s own header for the full
# shape.
#
# Do NOT add a `# ccrc:generated …` marker line to this file by imitation of
# `ccd`'s line 2: that marker is `shared/mark.mjs`'s format for files a
# generator writes and would refuse to run over hand edits to; `ccd` carries
# one spuriously (it predates the marker meaning something), and `ccrc` is,
# and stays, hand-written.
set -uo pipefail

PROG=ccrc

# Where the rest of the shipped tree is, relative to THIS FILE rather than to
# $PWD — `ccrc-adopt:124-125`'s idiom, so `ccrc` works run as `bash ccd/ccrc`
# from anywhere, and on a bare installed box (~/ccrc/ccd/ccrc) with no checkout
# in sight. Two deliberate differences from adopt's line, both measured:
#   - `${BASH_SOURCE[0]}`, not `$0`: THIS script is meant to be source-able
#     (the guard at the bottom exists for that), and under `source` `$0` is the
#     calling shell's argv[0], so it would answer for the caller's directory.
#   - `${CCRC_HERE%/*}`, not `$(dirname …)`: `dirname` is coreutils, i.e. a PATH
#     lookup, and the one box `ccrc doctor` most needs to work on is the box
#     whose environment is broken. Measured in ccrc-doctor.test.ts, whose
#     fixture PATH contains no system directory at all: with `dirname` here,
#     ccrc died with "doctor's check table is missing", blaming the install for
#     what was actually a PATH problem. Parameter expansion cannot fail that
#     way. The `*/*` guard covers `bash ccrc` from inside ccd/, where
#     BASH_SOURCE carries no directory at all and `%/*` would strip nothing.
CCRC_HERE="${BASH_SOURCE[0]}"
[[ "$CCRC_HERE" == */* ]] || CCRC_HERE="./$CCRC_HERE"
CCRC_HERE="$(cd "${CCRC_HERE%/*}" && pwd)"

# ── THE TWO FILES THIS BOX KEEPS ITS OWN FACTS IN ─────────────────────────
# Spelled once each, because `version`, `status` and `doctor` all read them and
# three copies of a path is how two of them end up reading a file the third
# does not write. That last clause stopped being hypothetical in stage 2d: as
# of Task 6 `install` WRITES ccrc.env (once, when the box has none), so this
# file now holds both the reader and the writer of it, and `_inst_env` writes
# through this variable rather than re-spelling the path — the sentence above
# is the reason, and D-88 in the stage-2d plan records the choice. build.json
# stays read-only here until Task 7 gives `install` a stamp of its own; when it
# does, it writes `"$BOX_STAMP_FILE"` for the same reason.
#   build.json — what a deploy stamped (deploy.sh's `stamp_build`).
#   ccrc.env   — the box's machine config (deploy/ccrc.env.example). It ALSO
#                carries tokens (CCRC_AGENT_TOKEN, CCRC_VAPID_PRIVATE, a
#                Hetzner token), which is why it is never sourced and never
#                read whole — see `_box_env_value`.
BOX_STAMP_FILE="$HOME/.ccrc/build.json"
BOX_ENV_FILE="$HOME/.ccrc/ccrc.env"

# How long the ONE network call in this file (`GET /api/fleet/health`) may take.
# Overridable for the reason `deploy/verify-service.sh:56-62` makes its
# settle/window knobs overridable, and `ccrc-doctor-checks` makes
# `CCRC_DOCTOR_GH_TIMEOUT` overridable: a route that hangs must not hang the
# tool, and a test must not wait out a production timeout. The DEFAULT is what
# an operator gets.
: "${CCRC_HEALTH_TIMEOUT:=5}"

# Out-parameters for the two readers below. `set -u` makes an unset array fatal
# on read, so they are declared here rather than at first assignment. `BOX_*`
# and `_box_*` are a THIRD namespace, deliberately kept clear of the two already
# in play in any shell that sources this tree: `_ccrc_*` (this file's own
# refusal helpers AND the five functions `shared/generate.mjs` emits into
# ~/.ccrc/accounts.sh) and `_wrap_*`/`WRAPPER_*` (ccrc-wrapper-shape).
BOX_BUILD=()
BOX_HEALTH=()
BOX_HEALTH_WHY=""

usage() {
  cat <<EOF
usage: $PROG {doctor|status|adopt|wrappers|install|version}

The lifecycle CLI for a Claude Code fleet box — installs, updates and
diagnoses a box, as a sibling to ccd (which drives sessions once one is
already running).

  version   print the build this box is running, from ~/.ccrc/build.json
  doctor    check this box's prerequisites — one PASS/WARN/FAIL line per
            check, each non-pass followed by its remedy; exit 1 if any failed
  status    print what this box IS: its build stamp, its services, how many
            ccd sessions it holds, and — when it knows where its server is —
            whether the two boxes agree. Read-only; always exit 0
  adopt     rediscover this box's accounts from \$HOME/.local/bin and write
            ~/.ccrc/accounts.json (runs ccrc-adopt; pass --out/--force to it)
  wrappers  write \$HOME/.local/bin/<id> for every account the roster marks
            "generated", and REFUSE every file ccrc did not write itself.
            Backs up before any overwrite; never touches an upstream or
            external account. [--dry-run] [--adopt] [--force]
  install   converge this box from the shipped tree: seed ~/.ccrc config
            (never overwriting yours), install executables, units and hooks,
            generate wrappers, then run doctor. Single-box, localhost.
            Re-running converges; it never damages an existing install

  -h, --help   print this message and exit 0

Exit codes: 0 success, 1 the tool ran and the answer was bad, 2 a usage
error (unknown verb or argument).
EOF
}

# ── diagnostic helpers (stderr; the RESULT of a verb goes to stdout) ───────
# `_ccrc_die` — a bare refusal: this run cannot continue. Always exits 1 —
# never 2, which is reserved for a USAGE error (see `_ccrc_usage_die` below).
_ccrc_die() { echo "$PROG: $*" >&2; exit 1; }
# The one place "unknown argument" is spelled, so the unknown-verb and
# unknown-top-level-flag paths below cannot drift onto two different
# messages for what is, to an operator, the same mistake.
_ccrc_usage_die() { echo "$PROG: unknown argument: $1" >&2; usage >&2; exit 2; }
# `_ccrc_not_implemented` lived here and is GONE (Task 8), with the last verb
# that reached it. It was the deliberate middle refusal between "you typed it
# wrong" (exit 2) and a real answer, for verb names that were reserved before
# they were built — and every one of the four is built now. Re-add it in one
# line together with the next reserved name, and not before; an uncalled
# refusal is the same untested, uncallable code `_ccrc_say` was removed for.

# cmd_version / _box_build_fields — what THIS box is running, per its own build
# stamp, never a guess. Same three-way discipline as `ccd version`
# (ccd/ccd:1946-1969):
#   - no ~/.ccrc/build.json  -> a dev checkout, or a box `ccrc install` never
#     touched. "unstamped" at exit 0 is the honest ANSWER here, not an error.
#   - a stamp that parses    -> print the facts.
#   - a stamp that exists but does not parse (or is missing a field) ->
#     something wrote garbage where a deploy writes facts; refuse loudly
#     rather than print a version nobody measured.
# Parsed with jq, not `python3` (ccd's own choice) — this project already
# depends on jq for exactly this kind of small-JSON reads (ccrc-adopt uses it
# throughout) and there is no reason to add a second interpreter dependency
# for one file read. The whole filter is wrapped in `try…catch empty` and
# checks each field's TYPE rather than just its presence: `.dirty` is a real
# boolean that is legitimately `false` on most boxes, so a naive `jq -e` (which
# treats a `false`/`null` last output as failure) would misreport every clean
# build as "unreadable" — this checks `.dirty|type=="boolean"` instead, which
# accepts `false` as the valid, common value it is.
#
# `version` takes NO arguments — not even `-h`/`--help`. An extra argument
# here (including `--help`) is a USAGE error, exit 2, same as an unrecognised
# top-level verb/flag: `_ccrc_usage_die` prints "unknown argument: <it>" plus
# the full usage text and quits. This deliberately does not special-case
# `--help` into its own per-verb help screen — asking for help is a top-level
# concern (`ccrc -h` / `ccrc --help`, before the verb is even read); once a
# verb has been selected, `version` has exactly one job and no flags of its
# own to explain. (Round-1 review, Important 2: this used to `_ccrc_die` at
# exit 1, which collided with this very file's own exit-code table — 1 means
# "the tool ran and the answer was bad", not "you typed it wrong".)
#
# A missing `jq` is probed for and refused BY NAME before the parse is
# attempted (round-1 review, Important 3) — without this, "jq not on PATH",
# "jq parse error" and "permission denied reading the stamp" all fell through
# to the same "build stamp unreadable" message, which sends an operator to
# rebuild/redeploy when the actual fix is `apt install jq`. That collapse is
# exactly the overloaded-seam mistake this codebase's conventions ban: two
# conditions ("this box lacks a dependency" vs. "this box's stamp is
# corrupt") that an operator would act on completely differently must not
# share one signal.
#
# ── ONE READER, TWO RENDERINGS ────────────────────────────────────────────
# `_box_build_fields` is the ONLY reader of ~/.ccrc/build.json in this file, and
# `version` and `status` both call it and each writes its own sentence from the
# SAME four fields — a second parser here is how the two verbs would come to
# disagree about what "dirty" means. (`ccd version` still has a reader of its
# own, in python3, in the other tool; Task 8 of this plan is where
# `single-definition` is pointed at that pair.) It answers with a return code
# per CONDITION, because the callers do different things about each:
#
#   0  the stamp parsed  -> BOX_BUILD=(sha ref builtAt true|false)
#   3  no stamp at all   -> a dev checkout, or a box no deploy has touched
#   4  the path is there but is not a regular file (a directory, say)
#   5  jq is not on PATH — a MISSING DEPENDENCY, never a corrupt stamp
#   6  it exists and does not parse as a build stamp
#
# 5 is separate from 6 for the reason the whole file is built on: two conditions
# an operator acts on completely differently (`apt install jq` vs. redeploy)
# must not share one signal.
#
# The output is FIVE lines — the four fields and an `END` sentinel — and both
# are checked. `$( )` strips trailing newlines, so a four-line form would lose
# an empty last field silently; the sentinel makes any truncation loud. A field
# carrying a control byte (a newline in `ref` would break the line format; a
# backspace would let the printed sha lie on a terminal) is rejected as
# unreadable rather than printed — the same rule `_check_wrappers` applies to
# roster ids, for the same reason.
_box_build_fields() {
  BOX_BUILD=()
  [[ -e "$BOX_STAMP_FILE" ]] || return 3
  # Exists but is not a plain file (e.g. a directory) — a shape problem, not
  # an absence; must not be read as "unstamped" (round-1 review, Minor 8).
  [[ -f "$BOX_STAMP_FILE" ]] || return 4
  command -v jq >/dev/null 2>&1 || return 5
  local out
  out="$(jq -r '
    try (
      if (type == "object")
         and (.sha | type == "string") and (.sha | length > 0)
         and (.ref | type == "string") and (.ref | length > 0)
         and (.builtAt | type == "string") and (.builtAt | length > 0)
         and (.dirty | type == "boolean")
      then "\(.sha)\n\(.ref)\n\(.builtAt)\n\(.dirty)\nEND"
      else empty
      end
    ) catch empty
  ' -- "$BOX_STAMP_FILE" 2>/dev/null)"
  [[ -n "$out" ]] || return 6
  mapfile -t BOX_BUILD <<< "$out"
  [[ "${#BOX_BUILD[@]}" -eq 5 && "${BOX_BUILD[4]}" == END ]] || { BOX_BUILD=(); return 6; }
  unset 'BOX_BUILD[4]'
  local f
  for f in "${BOX_BUILD[@]}"; do
    [[ "$f" =~ [[:cntrl:]] ]] && { BOX_BUILD=(); return 6; }
  done
  return 0
}

cmd_version() {
  [[ $# -eq 0 ]] || _ccrc_usage_die "$1"
  local rc=0
  _box_build_fields || rc=$?
  case "$rc" in
    0) ;;
    3) echo "$PROG unstamped (no $BOX_STAMP_FILE — this box has no build stamp yet)"
       return 0 ;;
    4) _ccrc_die "build stamp unreadable: $BOX_STAMP_FILE (not a regular file)" ;;
    5) _ccrc_die "jq is required by 'ccrc version' but is not on PATH" ;;
    *) _ccrc_die "build stamp unreadable: $BOX_STAMP_FILE" ;;
  esac
  local dirty=""
  [[ "${BOX_BUILD[3]}" == true ]] && dirty=", dirty"
  echo "$PROG ${BOX_BUILD[0]} (${BOX_BUILD[1]}, built ${BOX_BUILD[2]}$dirty)"
}

# ── WHERE IS THIS BOX'S SERVER? ───────────────────────────────────────────
# `status` and doctor's `fleet` check both need one thing before they can ask
# anything: an address. There are exactly two places one can come from, and
# NEITHER of them is a literal in this file.
#
#   1. `$CCRC_ADDR` — `deploy/notify.sh:35`'s own seam, which every fleet-host
#      hook already honours. Its `${CCRC_ADDR:-203.0.113.7:7788}` DEFAULT is
#      deliberately not copied here: that IP is one operator's tailnet address,
#      baked into a tool this workstream exists to make shippable to other
#      people, and a doctor that silently probed it on somebody else's box
#      would be reporting on a machine they have never heard of.
#   2. `~/.ccrc/ccrc.env`'s `CCRC_HOST` + `CCRC_PORT` — the box's own machine
#      config, and the same two values `ccrc.service` reads through
#      `EnvironmentFile=` (deploy/ccrc.env.example).
#
# BOTH keys are required, and a lone `CCRC_HOST` is answered "I cannot tell"
# rather than completed from `server/src/config.ts`'s `?? 7788`. That default is
# real, but it lives in TypeScript, on the other side of a language boundary
# this bash cannot import across — copying it here would be one value declared
# twice, which is the drift `single-definition.test.ts` exists to stop, and
# guessing it wrong produces a confident answer about a box nobody asked.
#
# MEASURED, and worth knowing before reading the SKIP: the FLEET host has no
# `~/.ccrc/ccrc.env` at all (it has `agent.env`, which configures the agent and
# holds a token). So on that box the answer today is "no address" and the fleet
# check SKIPS — correctly: nothing there knows where the server is. Export
# `CCRC_ADDR` for a run, or give the box a `ccrc.env`, and it answers.
#
#   0 -> two lines: the address, then WHERE it came from (for the detail line)
#   1 -> nothing configured at all
#   2 -> one line: a sentence naming the source and what is wrong with it.
#        NEVER the offending value: it comes off a config file and lands on a
#        terminal that acts on control bytes.
_box_server_addr() {
  local addr="" src=""
  if [ -n "${CCRC_ADDR:-}" ]; then
    addr="$CCRC_ADDR"; src="CCRC_ADDR"
  elif [ -e "$BOX_ENV_FILE" ]; then
    # "there is no config file" (return 1) and "there is one and I could not
    # read it" (return 2) are two different things to tell an operator, and
    # without these two guards the second arrives as the first — the read below
    # would fail, bash would put its own diagnosis on stderr, and every key
    # would come back empty, which is indistinguishable from a file that
    # declares nothing.
    [ -f "$BOX_ENV_FILE" ] \
      || { printf '%s\n' "$BOX_ENV_FILE is not a regular file"; return 2; }
    [ -r "$BOX_ENV_FILE" ] \
      || { printf '%s\n' "$BOX_ENV_FILE cannot be read (check its mode: ls -l $BOX_ENV_FILE)"; return 2; }
    local host port
    host="$(_box_env_value "$BOX_ENV_FILE" CCRC_HOST)"
    port="$(_box_env_value "$BOX_ENV_FILE" CCRC_PORT)"
    if [ -n "$host" ] && [ -n "$port" ]; then
      addr="$host:$port"; src="$BOX_ENV_FILE"
    elif [ -n "$host" ]; then
      printf '%s\n' "$BOX_ENV_FILE declares CCRC_HOST but no CCRC_PORT"
      return 2
    elif [ -n "$port" ]; then
      printf '%s\n' "$BOX_ENV_FILE declares CCRC_PORT but no CCRC_HOST"
      return 2
    else
      return 1
    fi
  else
    return 1
  fi
  # A host:port and nothing else — an IPv6 literal in its URL brackets counts.
  # This is a sanity gate on a value that goes into a URL and into printed
  # output, not a resolver: a name that does not resolve is curl's answer to
  # give, not this function's.
  local addr_re='^([A-Za-z0-9]([A-Za-z0-9._-]*[A-Za-z0-9])?|\[[0-9A-Fa-f:]+\]):[0-9]{1,5}$'
  if [[ ! "$addr" =~ $addr_re ]]; then
    printf '%s\n' "$src does not spell a host:port address"
    return 2
  fi
  printf '%s\n%s\n' "$addr" "$src"
}

# ONE KEY OUT OF AN ENV FILE, BY NAME, AND NOTHING ELSE.
#
# `~/.ccrc/ccrc.env` holds this box's secrets as well as its addresses —
# `CCRC_AGENT_TOKEN`, `CCRC_VAPID_PRIVATE`, `CCRC_HETZNER_TOKEN`. Three rules
# follow, and all three are load-bearing:
#   - it is NEVER sourced. Sourcing executes it and exports every one of those
#     into this process and into every child it spawns (curl, node, jq).
#   - only the requested key's value is ever returned; every other line is read
#     and dropped. Nothing here prints, logs or exports another line of it.
#   - the shape read is a SUBSET of what systemd's own `EnvironmentFile=` parser
#     accepts — this file's actual consumer: optional leading whitespace, then
#     `KEY=value`, with one layer of surrounding quotes stripped. Deliberately
#     NOT supported, and named rather than implied (round-2 review, Minor 2):
#     backslash line-continuations, and escape sequences inside a quoted value.
#     A subset is safe HERE because the failure is one-directional — a form this
#     misses yields no address, which SKIPS the check with a detail, never a
#     wrong address confidently probed — but it is a subset, and a comment that
#     claimed the whole parser was a claim that could quietly stop being true.
#     THE SUBSET HAS TO STAY A SUBSET, which is why the whitespace set below is
#     spelled out rather than borrowed from POSIX (Task 8): `[[:space:]]` also
#     contains vertical tab and form feed, and systemd's whitespace is space,
#     tab, CR and the newline that already ended the line. Skipping a \v that
#     systemd does not skip reads a key systemd never set, i.e. it answers with
#     an address this box is NOT configured with — the one direction the
#     paragraph above says this reader must never fail in.
# The LAST assignment wins, as it does in systemd and in a shell.
_box_env_value() {
  local file="$1" key="$2" line v=""
  # Space, tab, CR — systemd's set, minus the newline `read` has consumed. A
  # variable rather than a literal bracket expression because a tab and a CR
  # typed inline are invisible in a diff and one stray edit from being deleted.
  local ws=$' \t\r'
  while IFS= read -r line || [ -n "$line" ]; do
    # Leading whitespace, exactly as systemd skips it — `_dr_trim`'s left half,
    # in the one namespace this file can reach, over systemd's character set
    # rather than POSIX's. `$ws` expands INSIDE the bracket expression, which
    # is why the pattern is unquoted here.
    line="${line#"${line%%[!$ws]*}"}"
    case "$line" in
      "$key="*) v="${line#"$key="}" ;;
      *) continue ;;
    esac
  done < "$file"
  # Trailing CR (a file edited on Windows) and surrounding quotes.
  v="${v%$'\r'}"
  case "$v" in
    \"*\") v="${v#\"}"; v="${v%\"}" ;;
    \'*\') v="${v#\'}"; v="${v%\'}" ;;
  esac
  printf '%s' "$v"
}

# ── THE ONE NETWORK CALL: GET /api/fleet/health ───────────────────────────
# The server is the only party that can compare the two boxes — it holds this
# box's stamp and the fleet host's, and both rosters' digests — so this asks it
# and reports what it says. It DECIDES nothing about the comparison:
# `rosterAgreement`/`buildAgreement` (server/src/fleetstate.ts) own that.
#
#   0 -> BOX_HEALTH=(mode connected build roster)
#   4 -> curl is not on PATH (nothing was asked)
#   5 -> the server did not answer;      BOX_HEALTH_WHY = curl's exit code
#   6 -> it answered an HTTP error;      BOX_HEALTH_WHY = "HTTP <code>"
#   7 -> what came back is not the health JSON
#   8 -> node is not on PATH, so nothing could parse the answer
#
# NOTHING FROM THE BODY IS EVER PRINTED. The four fields are CLASSIFIED against
# the vocabulary `shared/api.ts` declares and only ever surface as one of those
# tokens, or as `?` for "present and not one of them". A body off a network,
# echoed into a verdict line an operator pastes into a ticket, is the same
# hazard `_check_wrappers` escapes roster ids for — except that here nothing has
# to be escaped, because nothing is quoted back.
#
# Parsed with node rather than jq for D-70's reason, restated: `jq` is stubbed
# as `exit 0` throughout the doctor suite (it is a PRESENCE check there), so a
# jq-based reader would have seen an empty answer in every fixture and passed
# everything. `_check_wrappers` reads the roster with node for the same reason.
_box_health() {
  local addr="$1"
  BOX_HEALTH=(); BOX_HEALTH_WHY=""
  command -v curl >/dev/null 2>&1 || return 4
  # `-w '\n%{http_code}'` rather than `-f`: `-f` collapses "no answer" and "an
  # HTTP error" into one nonzero exit, and those are two different problems
  # (the box is down / the box is broken). The body and the code come back in
  # one stream, split on the LAST newline.
  local out rc=0
  # `-w` carries curl's OWN `\n` escape (two characters in argv, one newline in
  # the output) rather than `$'\n'`: a real newline inside an argument shows up
  # in `ps`, in a log line and in this suite's own stub log as a second record,
  # and an argv that cannot be printed on one line is an argv nobody can read.
  #
  # `-s` and NOT `-sS` (round-2 review, Minor 1): `-S` asks curl to print its
  # error message despite `-s`, and this redirects stderr away, so the two
  # cancelled out. Discarding it is the deliberate half of that pair — curl's
  # exit code IS the diagnosis this reports, and a check's subprocess writing
  # to stderr mid-run interleaves with the verdict lines an operator is reading
  # on stdout. (Deliberately unlike `_check_gh_auth`, which captures gh's stderr
  # and quotes its first line: gh's exit codes are not distinguishing, curl's
  # are, and gh answers once where this can answer on every doctor run.)
  out="$(curl -s --max-time "$CCRC_HEALTH_TIMEOUT" -H 'accept: application/json' \
    -w '\n%{http_code}' "http://$addr/api/fleet/health" 2>/dev/null)" || rc=$?
  if [ "$rc" -ne 0 ]; then BOX_HEALTH_WHY="$rc"; return 5; fi
  case "$out" in
    *$'\n'*) ;;
    *) BOX_HEALTH_WHY=""; return 7 ;;
  esac
  local code="${out##*$'\n'}" body="${out%$'\n'*}"
  if [ "$code" != 200 ]; then
    # WHY carries the whole PHRASE, not a bare code, so both arms read as
    # English in the one sentence the callers wrap it in ("… answered <why>
    # when asked for /api/fleet/health"). It used to carry either a number or
    # the words "an unreadable status", which produced "answered HTTP an
    # unreadable status" — dead text nobody had read aloud (round-2 review).
    case "$code" in
      [0-9][0-9][0-9]) BOX_HEALTH_WHY="HTTP $code" ;;
      *) BOX_HEALTH_WHY="a status this check could not read" ;;
    esac
    return 6
  fi
  command -v node >/dev/null 2>&1 || return 8
  local fields
  fields="$(CCRC_HEALTH_BODY="$body" node -e '
    let j;
    try { j = JSON.parse(process.env.CCRC_HEALTH_BODY); } catch (e) { process.exit(3); }
    if (!j || typeof j !== "object" || Array.isArray(j)) process.exit(4);
    // ABSENT READS AS "unknown" for build and roster, and that is the wire
    // contract itself (shared/api.ts: both fields are optional, "absent reads
    // as unknown", the absence-permits rule). ONE reader per field, so an older
    // server omitting one cannot arrive here as a fourth state. `mode` is NOT
    // optional on the wire, so its absence is a malformed answer and lands in
    // the same "?" as an unrecognised one — the caller does the same thing
    // about both, which is the only licence to collapse two conditions.
    const one = (v, allowed, whenAbsent) =>
      (v === undefined || v === null) ? whenAbsent : (allowed.indexOf(v) >= 0 ? String(v) : "?");
    process.stdout.write([
      one(j.mode, ["local", "remote"], "?"),
      one(j.connected, [true, false], "?"),
      one(j.build, ["agreed", "skewed", "unknown"], "unknown"),
      one(j.roster, ["agreed", "divergent", "unknown"], "unknown"),
      "END",
    ].join("\n"));
  ' 2>/dev/null)" || return 7
  mapfile -t BOX_HEALTH <<< "$fields"
  [[ "${#BOX_HEALTH[@]}" -eq 5 && "${BOX_HEALTH[4]}" == END ]] || { BOX_HEALTH=(); return 7; }
  unset 'BOX_HEALTH[4]'
  return 0
}

# The two units ccrc itself installs (deploy/ccrc.service, ccrc-agent.service),
# measured with `is-active` and nothing else — status never touches a unit, and
# every `ccd supervise` unit beside them is long-lived by design (CLAUDE.md).
# Sets `BOX_UNITS=(<ccrc.service state> <ccrc-agent.service state>)`, in the
# order of `BOX_UNIT_NAMES`, because TWO lines are written from this one
# measurement — `services:` (what was measured) and `role:` (what it implies) —
# and measuring twice is how the two would come to disagree on a box whose units
# changed state between them.
#
# XDG_RUNTIME_DIR is defaulted exactly as `ccd:93-95` defaults it, and for the
# same reason: without it `systemctl --user` cannot find the bus from a
# non-interactive SSH context, and status would report "unknown" on a perfectly
# healthy box. `$UID` is a bash builtin — no `id` subprocess to fail on the
# broken box this tool exists for.
BOX_UNIT_NAMES=(ccrc.service ccrc-agent.service)
BOX_UNITS=()
_box_units() {
  BOX_UNITS=()
  local u state
  if ! command -v systemctl >/dev/null 2>&1; then
    for u in "${BOX_UNIT_NAMES[@]}"; do BOX_UNITS+=("unknown"); done
    return 1
  fi
  : "${XDG_RUNTIME_DIR:=/run/user/$UID}"; export XDG_RUNTIME_DIR
  : "${DBUS_SESSION_BUS_ADDRESS:=unix:path=${XDG_RUNTIME_DIR}/bus}"; export DBUS_SESSION_BUS_ADDRESS
  for u in "${BOX_UNIT_NAMES[@]}"; do
    state="$(systemctl --user is-active "$u" 2>/dev/null)"
    [ -n "$state" ] || state="unknown"
    BOX_UNITS+=("$state")
  done
  return 0
}

# WHAT THIS BOX IS FOR, INFERRED — and labelled as inferred, every time.
# Nothing on a box records its own role today (D-73): the topology lives in
# CLAUDE.md and in an operator's head, and the only evidence on disk is which
# unit is running. So this reports the inference AND names it as one, rather
# than asserting a role the box never declared. The moment a box does declare
# one, this becomes a read of that declaration and the word "inferred" goes.
#
# ── `unknown` IS NOT `inactive`, AND NEITHER IS ABSENCE OF EVIDENCE ───────
# `_box_units` answers `unknown` for a unit it could not ask — no systemctl, no
# bus, an empty reply — and that is a THIRD state, not a synonym for "not
# running". Every branch below is therefore written against what was MEASURED:
#
#   - "neither" is a negative claim about BOTH units, so it requires both to
#     have answered. It used to require only that they were not both unknown
#     (`&&` where this now has `||`), so a box where one unit could not be
#     asked and the other was merely inactive was told "no ccrc unit is active
#     here" — a statement about a unit nobody asked. Task 8 fixed it; the
#     nine-state table in server/test/ccrc-doctor.test.ts pins every cell.
#   - one unit ACTIVE and the other UNKNOWN is a real role plus an open
#     question ("is it also the other half?"), and both halves are said out
#     loud. Answering a bare "server" there would settle, silently, the
#     single-box question that separates it from the first branch.
#
# Same defect class either way, and the same one the `connected` arm of
# `cmd_status` had: asserting a state that was never measured.
_box_role() {
  local ccrc_state="${BOX_UNITS[0]}" agent_state="${BOX_UNITS[1]}"
  local role
  if [ "$ccrc_state" = active ] && [ "$agent_state" = active ]; then
    role="server AND fleet host (both units active — a single-box install)"
  elif [ "$ccrc_state" = active ] && [ "$agent_state" = unknown ]; then
    role="server (and ${BOX_UNIT_NAMES[1]} could not be asked, so whether this box is ALSO a fleet host was not measured)"
  elif [ "$agent_state" = active ] && [ "$ccrc_state" = unknown ]; then
    role="fleet host (and ${BOX_UNIT_NAMES[0]} could not be asked, so whether this box is ALSO a server was not measured)"
  elif [ "$ccrc_state" = active ]; then
    role="server"
  elif [ "$agent_state" = active ]; then
    role="fleet host"
  elif [ "$ccrc_state" = unknown ] || [ "$agent_state" = unknown ]; then
    # At least one unit could not be asked. "I could not tell" is not "no unit
    # is running", and inferring the second from missing evidence is the one
    # thing this line exists not to do — so the unasked unit is NAMED, because
    # "unknown" without it leaves an operator nothing to go and check.
    local unasked=""
    [ "$ccrc_state" = unknown ] && unasked="${BOX_UNIT_NAMES[0]}"
    [ "$agent_state" = unknown ] && unasked="${unasked:+$unasked and }${BOX_UNIT_NAMES[1]}"
    printf '%s' "unknown ($unasked could not be asked, so nothing was inferred — \"I could not tell\" is not \"no unit is active\")"
    return 0
  else
    role="neither (no ccrc unit is active here — a dev checkout, or a box mid-install)"
  fi
  printf '%s' "$role (inferred from the units below, not declared — no box records its own role yet)"
}

# How many ccd sessions this box holds, counted the way ccd itself counts them:
# one `<id>.uuid` file per session in the flat-file registry (ccd:8499). No
# `ls`, no `find` — a glob and an array length, so this answers on a box with no
# coreutils on PATH.
_box_sessions() {
  local reg="$HOME/.cc-sessions"
  if [ ! -d "$reg" ]; then
    printf '%s' "0 (no $reg on this box — it runs no ccd sessions)"
    return 0
  fi
  local -a f=()
  local had_nullglob=0
  shopt -q nullglob && had_nullglob=1
  shopt -s nullglob
  f=("$reg"/*.uuid)
  [ "$had_nullglob" -eq 1 ] || shopt -u nullglob
  printf '%s' "${#f[@]} in $reg (one registered ccd session each)"
}

# cmd_status — WHAT THIS BOX IS, as facts, one per line. The question doctor
# cannot answer: doctor judges a box's fitness, status describes it, and the
# two are different jobs on purpose. A skewed fleet is a FAIL from doctor and a
# plain line of fact here.
#
# READ-ONLY, and exit 0 whatever it finds — including a fleet that disagrees.
# An operator scripting `ccrc status` gets a report; the thing that returns a
# judgement is `ccrc doctor`, whose exit code means exactly one thing. A status
# that exited 1 on a skewed fleet would give the fleet check a second, quieter
# home, and two answers to one question is how they come to disagree.
#
# EVERY LINE GOES TO STDOUT: it is the RESULT of the verb, in this file's own
# stdout/stderr split. And every line names what was measured — the same "never
# the bare word ok" rule the doctor checks keep — because a status that prints
# `fleet: ok` is indistinguishable from a status that never asked.
cmd_status() {
  [[ $# -eq 0 ]] || _ccrc_usage_die "$1"

  local rc=0
  _box_build_fields || rc=$?
  case "$rc" in
    0) local dirty="clean"
       [[ "${BOX_BUILD[3]}" == true ]] && dirty="DIRTY — what runs here is not the commit it names"
       printf 'build:     %s (%s) built %s, %s\n' \
         "${BOX_BUILD[0]}" "${BOX_BUILD[1]}" "${BOX_BUILD[2]}" "$dirty" ;;
    3) printf 'build:     unstamped (no %s — no deploy has ever stamped this box)\n' "$BOX_STAMP_FILE" ;;
    4) printf 'build:     unreadable (%s is not a regular file)\n' "$BOX_STAMP_FILE" ;;
    5) printf 'build:     unreadable (jq is not on PATH, so %s cannot be parsed)\n' "$BOX_STAMP_FILE" ;;
    *) printf 'build:     unreadable (%s does not parse as a build stamp)\n' "$BOX_STAMP_FILE" ;;
  esac

  # ONE measurement, TWO lines: what is running, and what that implies this box
  # is for. `_box_units` is called here, in cmd_status's own shell rather than
  # in a `$( )`, so both lines are written from the same reading.
  _box_units || true
  printf 'role:      %s\n' "$(_box_role)"
  printf 'services:  %s\n' "${BOX_UNIT_NAMES[0]} ${BOX_UNITS[0]}, ${BOX_UNIT_NAMES[1]} ${BOX_UNITS[1]}"
  printf 'sessions:  %s\n' "$(_box_sessions)"

  local addr_out addr_rc=0
  addr_out="$(_box_server_addr)" || addr_rc=$?
  local -a af=()
  [ -z "$addr_out" ] || mapfile -t af <<< "$addr_out"
  if [ "$addr_rc" -eq 1 ]; then
    printf 'server:    none configured (no CCRC_ADDR, and no CCRC_HOST/CCRC_PORT in %s)\n' "$BOX_ENV_FILE"
    printf 'fleet:     not measured (this box has no server address to ask)\n'
    return 0
  fi
  if [ "$addr_rc" -ne 0 ]; then
    printf 'server:    misconfigured (%s)\n' "${af[0]:-$BOX_ENV_FILE}"
    printf 'fleet:     not measured (this box has no usable server address)\n'
    return 0
  fi
  local addr="${af[0]}" src="${af[1]}"
  printf 'server:    %s (from %s)\n' "$addr" "$src"

  local h_rc=0
  _box_health "$addr" || h_rc=$?
  case "$h_rc" in
    4) printf 'fleet:     not measured (curl is not on PATH, so the server could not be asked)\n'; return 0 ;;
    5) printf 'fleet:     not measured (the server did not answer — curl exited %s)\n' "$BOX_HEALTH_WHY"; return 0 ;;
    6) printf 'fleet:     not measured (the server answered %s when asked for /api/fleet/health)\n' "$BOX_HEALTH_WHY"; return 0 ;;
    7) printf 'fleet:     not measured (the server answered something that is not the health JSON)\n'; return 0 ;;
    8) printf 'fleet:     not measured (node is not on PATH, so the answer could not be parsed)\n'; return 0 ;;
  esac

  local mode="${BOX_HEALTH[0]}" connected="${BOX_HEALTH[1]}"
  local build="${BOX_HEALTH[2]}" roster="${BOX_HEALTH[3]}"
  if [ "$mode" != remote ]; then
    if [ "$mode" = local ]; then
      printf 'mode:      local — that server drives its own box directly\n'
      printf 'fleet:     not measured (the server is in local mode; there is no second box to disagree with)\n'
    else
      printf 'mode:      unreadable — the server did not say which mode it is in\n'
      printf 'fleet:     not measured (the server did not say which mode it is in)\n'
    fi
    return 0
  fi
  printf 'mode:      remote (fleet host connected: %s)\n' "$connected"
  # ONE WORD FOR THE PAIR, then both answers behind it. `agreed` is the strongest
  # claim this verb can make and it requires everything: both answers agreed AND
  # the server currently in contact with the fleet host. Anything else gets a
  # weaker word — never `agreed` for something nobody measured, and never
  # `agreed` for something measured at a contact that has since dropped.
  #
  # THE `connected` ARM IS THREE-WAY, and the middle case is the one that used to
  # be wrong (round-2 review, Important): `[ "$connected" = false ]` alone made
  # `?` — the classifier's token for absent-or-unrecognised — take the `true`
  # branch, so a body with no `connected`, or with `"yes"`, or with the STRING
  # `"false"`, printed `agreed` beside `connected: ?`. `shared/api.ts:1484`
  # declares `connected` REQUIRED, so its absence is a malformed answer and not
  # the absence-permits rule that `roster?`/`build?` carry; and either way an
  # answer this tool did not understand must not become a claim that the
  # opposite is true. The classifier carried the distinction — this line was
  # narrowing it, which is the one rule the architecture doc calls
  # highest-yield.
  local overall link=""
  case "$connected" in
    true) ;;
    false) link="; the server is NOT currently in contact with the fleet host, so both answers describe the last contact" ;;
    *)     link="; the server did not say whether it is in contact with the fleet host, so neither answer can be trusted to describe now" ;;
  esac
  if [ "$build" = skewed ] || [ "$roster" = divergent ]; then overall=disagreed
  elif [ "$build" != agreed ] || [ "$roster" != agreed ]; then overall=unknown
  elif [ -n "$link" ]; then overall=stale
  else overall=agreed
  fi
  printf 'fleet:     %s — build %s, roster %s%s\n' "$overall" "$build" "$roster" "$link"
}

# cmd_doctor — run every check in `ccd/ccrc-doctor-checks`'s table and report
# each one's verdict, THEN a summary count. Exit 0 when every check passed or
# warned, 1 when any failed (2 stays reserved for a usage error, which is why
# doctor needed 1 free — see the exit-code table above).
#
# The loop never stops early, and that is the same reason this file does not
# use `set -e`: an operator running doctor wants the whole list, not the first
# problem. A check SIGNALS with its return code (0 pass / 1 fail / 2 warn /
# 3 SKIPPED) and prints its own line(s); this function only counts and tallies.
# It deliberately does NOT decide anything about a check's subject — that is the
# check's job, and keeping the decision inside the check is what makes "one
# table entry plus one test" the true cost of adding one.
#
# The tally is over VERDICT LINES, and a check may print two of them when it
# has findings of two classes (a FAIL and a WARN, each with its own remedy —
# see `ccrc-doctor-checks`'s header). Its return code is then the worse class,
# and this function CROSS-CHECKS the two: a code that is not the worst class
# printed is reported as a bug in ccrc rather than silently believed. The
# summary's "N checks" stays a count of table entries, so a run in which one
# check answered twice really does show more verdicts than checks.
#
# ── THE FOURTH OUTCOME: A CHECK THAT DID NOT RUN (Task 7) ────────────────
# Some checks have a subject that may not exist on this box at all — `fleet`
# compares TWO boxes, and a box with no server to ask has nothing to compare.
# That check must not PASS (it would claim an agreement nobody measured, the
# overloaded-null defect this codebase bans by name) and must not WARN (nothing
# is wrong). It prints exactly one
#
#     SKIP <name>: <why there was nothing to measure>
#
# line, NO verdict line and no remedy, and exits 3. This function counts it
# against CHECKS and never against verdicts, and the summary prints the number
# of skips — so "N checks, M verdicts" stays a true statement about how much of
# the box was actually measured, and an operator can see the difference between
# a check that answered and one that could not.
#
# The two halves are CROSS-CHECKED against each other exactly as the return code
# and the verdict lines already are: exit 3 with a verdict line, a SKIP line
# with any other exit code, or exit 3 with nothing printed at all are each
# reported as a bug in ccrc. "I did not run" and "here is my answer" cannot both
# be true, and a silent skip is a check that vanished from the run.
#
# A COMPLETE INSTALL OF THE CLI IS FOUR FILES IN ONE DIRECTORY, not two: this
# script, `ccrc-doctor-checks`, `ccrc-wrapper-shape` (which the checks file
# sources for the account-wrapper contract it shares with `ccrc-adopt`) and
# `ccrc-adopt` itself, which `cmd_adopt` execs. DOCTOR alone needs only the
# first three, which is what `ccrc-doctor-checks` and `ccrc-wrapper-shape` say
# in their own headers — the same sentence about different sets, not a
# contradiction: an install that ships three has a working `doctor` and a
# broken `adopt`. All four resolve each other through
# `${BASH_SOURCE[0]}`, which bash does NOT follow through a symlink, so linking
# `ccrc` onto PATH does not drag its siblings along — whatever installs one has
# to install all four. A missing library is not fatal here: `_check_wrappers`
# reports its own absence as a FAIL with a remedy, so the other ten checks
# still answer.
#
# THAT IS WHY THE DEPLOY SHIPS A SHIM (Task 8, `install_ccrc_shim` in
# deploy/deploy.sh) rather than a copy: `~/.local/bin/ccrc` execs
# `~/ccrc/ccd/ccrc`, the rsynced tree where all four files sit together and
# where `_dr_pkg_candidates` finds the shipped `package.json` one level up.
# Copying this file alone onto PATH breaks doctor's sourcing; copying all four
# into `~/.local/bin` breaks the node check instead, whose floor would then be
# looked for at `~/.local/{server,agent}/package.json`.
#
# Ways this refuses rather than reporting a healthy box it never measured — a
# doctor that runs zero checks and exits 0 is the worst failure mode this verb
# has:
#   - the checks file is missing or unreadable   -> refuse (exit 1)
#   - it defined no table at all                 -> refuse (exit 1)
#   - a table entry has no `_check_<name>`       -> that entry FAILS loudly
#   - a check dies without printing a verdict    -> that entry FAILS loudly
# The last two are bugs in ccrc rather than facts about the box, and say so.
#
# EVERY CHECK RUNS IN A SUBSHELL — the `out="$( … )"` below — and that is the
# whole point of the capture, not a stylistic choice about output (Task 4
# review, Minor 5). A check that trips `set -u` (an unbound variable) is FATAL
# to the shell it runs in, not a `return 1`: called directly, one such check
# would take the entire run down mid-table, printing no summary and leaving
# every later check unmeasured — precisely the failure this file's own header
# rails against when it explains why `-e` is off. A subshell bounds the blast
# radius to that one check; the parent tallies it and carries on. (A stray
# `return 3` was already survivable; only the fatal class was not.)
#
# The captured output is then CHECKED for a verdict line rather than echoed
# blindly. A check that dies mid-run prints nothing, and without this the run
# would emit 9 verdict lines under a summary claiming 10 checks — internally
# consistent and silently missing the one that matters. stderr is deliberately
# NOT captured: bash's own "unbound variable" message is the best diagnosis of
# that state and belongs in front of the operator.
cmd_doctor() {
  [[ $# -eq 0 ]] || _ccrc_usage_die "$1"
  local checks="$CCRC_HERE/ccrc-doctor-checks"
  [[ -f "$checks" ]] \
    || _ccrc_die "doctor's check table is missing: $checks — is this a complete ccrc install?"
  # shellcheck source=ccrc-doctor-checks
  . "$checks" \
    || _ccrc_die "doctor's check table failed to load: $checks"
  declare -p CCRC_DOCTOR_CHECKS >/dev/null 2>&1 \
    || _ccrc_die "doctor's check table declares no CCRC_DOCTOR_CHECKS: $checks"
  [[ "${#CCRC_DOCTOR_CHECKS[@]}" -gt 0 ]] \
    || _ccrc_die "doctor's check table is empty: $checks — refusing to report a box nobody measured"

  # `ran` counts CHECKS and `skipped` counts the ones with nothing to measure;
  # pass/warn/fail count VERDICT LINES. They were one number until a check
  # needed to answer in two classes at once; keeping the summary's "N checks"
  # honest means counting the table entries themselves.
  local name rc out ran=0 skipped=0 pass=0 warn=0 fail=0
  for name in "${CCRC_DOCTOR_CHECKS[@]}"; do
    ran=$((ran + 1))
    if ! declare -F "_check_$name" >/dev/null 2>&1; then
      printf 'FAIL %s: the check table names it but no _check_%s function exists\n' "$name" "$name"
      printf '  remedy: this is a bug in ccrc, not a fact about your box — the table and the checks in %s have drifted\n' "$checks"
      fail=$((fail + 1))
      continue
    fi
    out="$( "_check_$name" )"; rc=$?
    [[ -z "$out" ]] || printf '%s\n' "$out"

    # THE VERDICT LINES ARE COUNTED, NOT THE RETURN CODE, because a check may
    # answer in two classes at once — a FAIL for the findings that are defects
    # and a WARN for the ones that may well be deliberate, each with its own
    # remedy (ccrc-doctor-checks, "ONE CHECK MAY ANSWER IN TWO CLASSES").
    # Counting the return code alone printed `0 warned` under a run with warn
    # lines on the screen, which is a false count of the thing an operator
    # skims (Task 5 review, Important 1). The summary's leading number stays
    # the number of CHECKS, so a run where one check answered twice shows more
    # verdicts than checks — deliberately: that is what happened.
    local vp=0 vw=0 vf=0 vs=0 line
    while IFS= read -r line; do
      case "$line" in
        "PASS $name: "*) vp=$((vp + 1)) ;;
        "WARN $name: "*) vw=$((vw + 1)) ;;
        "FAIL $name: "*) vf=$((vf + 1)) ;;
        "SKIP $name: "*) vs=$((vs + 1)) ;;
      esac
    done <<< "$out"

    # A SKIPPED CHECK, and the three ways of getting it wrong. Both halves have
    # to agree — exactly one SKIP line, no verdict line, exit 3 — because each
    # half alone is a statement the other can contradict, and a run that
    # believed either one on its own would either count a measurement nobody
    # made or drop a check off the tally without saying so.
    if [[ "$rc" -eq 3 || "$vs" -gt 0 ]]; then
      if [[ "$rc" -eq 3 && "$vs" -eq 1 && $((vp + vw + vf)) -eq 0 ]]; then
        skipped=$((skipped + 1))
        continue
      fi
      printf 'FAIL %s: the check exited %s having printed %s SKIP and %s verdict line(s) — a skipped check prints exactly one SKIP line, no verdict line, and exits 3\n' \
        "$name" "$rc" "$vs" "$((vp + vw + vf))"
      printf '  remedy: this is a bug in ccrc, not a fact about your box — see _check_%s in %s\n' "$name" "$checks"
      fail=$((fail + 1))
      continue
    fi

    if [[ $((vp + vw + vf)) -eq 0 ]]; then
      # No verdict line, whatever the exit code said. The usual cause is a
      # check that died before it could print one (see the subshell note
      # above); the other is a check that printed a verdict for the wrong name.
      printf 'FAIL %s: the check printed no verdict line of its own (it exited %s)\n' "$name" "$rc"
      printf '  remedy: this is a bug in ccrc, not a fact about your box — see _check_%s in %s, and any error above this line\n' "$name" "$checks"
      fail=$((fail + 1))
      continue
    fi

    case "$rc" in
      0|1|2) ;;
      *)
        # A check may only answer 0/1/2/3 (3 is handled above). A stray
        # `return 4` lands here and is counted as a failure, named as the bug it
        # is, rather than being read as one of the legal outcomes.
        printf 'FAIL %s: the check exited %s, which is not one of 0 (pass), 1 (fail), 2 (warn) or 3 (skipped)\n' "$name" "$rc"
        printf '  remedy: this is a bug in ccrc, not a fact about your box — see _check_%s in %s\n' "$name" "$checks"
        fail=$((fail + 1))
        continue ;;
    esac

    # The return code and the verdict lines are two statements of ONE answer,
    # so they are cross-checked rather than one being quietly preferred: the
    # code must be the WORST class the check printed. Without this, moving the
    # tally onto the lines would have moved the exit code with it — a check
    # that returned 1 while printing only a WARN would have made doctor exit 0.
    local worst=PASS want=0
    if [[ "$vf" -gt 0 ]]; then worst=FAIL; want=1
    elif [[ "$vw" -gt 0 ]]; then worst=WARN; want=2
    fi
    if [[ "$rc" -ne "$want" ]]; then
      printf 'FAIL %s: the check exited %s, but the worst verdict line it printed is a %s, which is %s\n' \
        "$name" "$rc" "$worst" "$want"
      printf '  remedy: this is a bug in ccrc, not a fact about your box — see _check_%s in %s\n' "$name" "$checks"
      fail=$((fail + 1))
      continue
    fi

    pass=$((pass + vp)); warn=$((warn + vw)); fail=$((fail + vf))
  done

  # BOTH NOUNS ARE PRINTED, because the three tail numbers count verdicts and
  # the leading one counts checks, and a line where 9+1+2 does not equal 11
  # reads as an arithmetic bug to anyone who has not read this function. The
  # repair a later reader would reach for — count each check once, by its worst
  # class — is exactly the `0 warned`-with-warnings-on-screen lie this round
  # removed, so the line says what each number is instead of inviting the fix.
  # The skip count rides the CHECKS half for the same reason: it is a number of
  # checks that did not answer, not a fourth kind of answer, and printing it
  # always (including as `(0 skipped)`) keeps the line one shape for whatever
  # reads it next.
  printf 'summary: %s checks (%s skipped), %s verdicts — %s passed, %s warned, %s failed\n' \
    "$ran" "$skipped" "$((pass + warn + fail))" "$pass" "$warn" "$fail"
  [[ "$fail" -eq 0 ]] || return 1
}
# ── cmd_wrappers — THE ROSTER WRITES THE WRAPPERS ─────────────────────────
# Stage 2c. `~/.ccrc/accounts.json` stops being a DESCRIPTION of what is in
# `$HOME/.local/bin` and becomes the thing that PRODUCES it. This verb converges
# the two, one account at a time, and refuses — loudly, with a remedy — for
# every file it did not write itself.
#
# ── THE ONE ABSOLUTE RULE ─────────────────────────────────────────────────
# `upstream` and `external` accounts are NEVER written, backed up, moved or
# removed, by this verb, under any flag. `upstream` is the ~304 MB Claude Code
# ELF; `external` is somebody else's hand-written launcher (`gpt` on the
# reference box is 142 lines of it). Both would be destroyed by one careless
# write and neither can be regenerated from the roster. That rule is
# STRUCTURAL here, not a test's opinion, and it is held by four things at once:
#
#   1. `deploy/gen-wrappers.mjs` NAMES every non-generated account out loud, in
#      a `protected <id>` manifest record (D-80), and this function refuses the
#      WHOLE RUN — not merely that id — if an id appears in both that list and
#      the `wrapper` list. An overlap is never a fact about a box; it is proof
#      the generator is broken, and its other verdicts are then untrustworthy
#      too, so there is nothing left worth converging.
#   2. This function iterates the MANIFEST's `wrapper` records and nothing else,
#      and `deploy/gen-wrappers.mjs` emits a `wrapper` record only for an
#      account whose `exec.kind` is "generated" (plan D5: node stages, bash
#      mutates). An upstream or external id therefore never reaches the loop.
#   3. Every path this function writes to is built as `$WRAPPER_BIN_DIR/$id`
#      from an id that was first matched against `WRAPPER_ID_RE`. There is no
#      other write, and no removal at all beyond this function's own temp files.
#   4. Before installing, the STAGED text is read back through
#      `_wrap_parse_shape` and refused if its exec target is the id being
#      installed. A wrapper at `~/.local/bin/claude` that ends
#      `exec "$HOME/.local/bin/claude" "$@"` is a fork bomb, and it is exactly
#      what a generator talked into staging the upstream account would produce.
#
# WHY FOUR AND NOT THREE — the measurements that bought lock 1, because a lock
# added without its incident becomes a lock somebody removes as redundant:
#   - Locks 2 and 4 are NOT independent of each other in the way they look.
#     Both ultimately key on one predicate, `execKind === 'generated'`: lock 2
#     directly, lock 4 because only a wrapper generated FOR the upstream account
#     is self-referential. So a bug in that predicate defeats both together.
#   - Lock 4 covers `upstream` ONLY. `external` has no self-referential
#     property to derive a violation from — `gpt`'s staged text would exec
#     `claude`, which is perfectly well-formed — so bash cannot tell, from the
#     bytes in front of it, that `gpt` is somebody else's launcher. Node has to
#     say so.
#   - Measured, and worse than "needs a flag": with a manifest carrying
#     `wrapper<TAB>gpt<TAB>ccrc-unmodified<TAB>no`, a PLAIN `ccrc wrappers` —
#     no `--force`, no `--adopt` — rewrote the external account's launcher and
#     exited 0, printing "(upstream and external are never written)" in its own
#     summary line. Only the default `foreign` arm refused such a file, and that
#     is generic foreign protection, not protection of an external ACCOUNT.
#   - An earlier round reported `gpt` as saved by lock 4. It was not: it was
#     saved by ROSTER ORDER. `deploy/accounts.migration.json` lists `claude`
#     first, so the run aborted at record #1 before `gpt` was reached. A roster
#     listing `gpt` first loses `gpt` and keeps `claude`. An accident of
#     ordering is not a lock.
#
# TWO INDEPENDENT LOCKS ON ONE DOOR, and THIS side is the strict one. The
# generator holds the same fact twice — the `execKind === 'generated'` filter
# that produces the `wrapper` records, and the independent walk of
# `roster.accounts` that produces the `protected` records. This reader trusts
# NEITHER over the other: it refuses on overlap rather than preferring a list,
# and it asserts the protected count against the summary's own
# `<upstream>` + `<external>` so a manifest truncated exactly at those records
# cannot drop the lock in silence.
#
# ── ITERATE THE MANIFEST, NEVER THE STAGING DIRECTORY ─────────────────────
# `deploy/gen-wrappers.mjs` writes only the ids it staged and never reads the
# directory back, so a stray file left in the staging dir by anything else
# survives unreported (measured in the Task 5 review; its header states the
# same rule from the other side). A converger driven by `readdir` of the
# staging dir would install that stale entry under an account id the CURRENT
# roster no longer declares. The manifest is the complete and authoritative
# list of what this run staged and for which ids; a directory listing is not.
#
# ── THE DECISION TABLE (plan D3), one branch per state, no collapses ──────
#   absent                          -> write
#   ccrc-unmodified, text == staged -> converged, nothing touched
#   ccrc-unmodified, text != staged -> rewrite (backup first)
#   ccrc-edited                     -> REFUSE; --force rewrites (backup first)
#   foreign, EQUIVALENT (D4)        -> REFUSE, reported as adoptable;
#                                      --adopt or --force rewrites (backup)
#   foreign, not equivalent         -> REFUSE; only --force rewrites (backup)
#   unreadable                      -> REFUSE under every flag
#   oversize                        -> REFUSE under every flag (D-81)
#
# `unreadable` refuses even under `--force` because "I could not read it" is not
# "I know what it is" — the one refusal no flag can talk out of. `oversize`
# refuses under the same absolute terms for a sibling reason: a file over
# `deploy/gen-wrappers.mjs`'s `OVERSIZE_BYTES` is never even read (D-81's whole
# point — past V8's string cap `readFileSync` used to THROW and land such a
# file in `unreadable`, whose remedy could never work on something perfectly
# readable), so bash never has bytes to judge, and there is nothing for
# `--force` to override either.
#
# THE REMEDY FOR A NON-EQUIVALENT `foreign` FILE MUST NOT MENTION `--force`,
# and that is a guard with a test of its own, not a matter of taste. Its remedy
# is "move it aside, or set exec.kind to external in the roster". An operator
# working down a list of refusals types the next thing the tool printed;
# printing `--force` beside a file ccrc has just said it does not understand is
# how a 142-line bespoke launcher gets destroyed by someone doing as they were
# told. `--force` is real, it is documented in `--help`, and it is deliberately
# absent from THAT remedy.
#
# Exit 0 = converged and nothing was refused. 1 = something was refused, or a
# write failed. 2 = a usage error (this file's standing table).
cmd_wrappers() {
  local dry=0 adopt=0 force=0
  # `ccrc-adopt:95-103`'s loop, minus the value-taking flags it needs and this
  # verb does not. Unlike `version`, this verb HAS flags of its own — three, and
  # each one changes what it is willing to overwrite — so `-h`/`--help` prints
  # the usage that explains them rather than being the usage error it is for a
  # verb with nothing to explain (see `cmd_version`'s header for that decision).
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) dry=1; shift ;;
      --adopt)   adopt=1; shift ;;
      --force)   force=1; shift ;;
      -h|--help) usage; exit 0 ;;
      *) _ccrc_usage_die "$1" ;;
    esac
  done

  # The shape contract, sourced rather than restated — `ccrc-adopt:61-79`'s
  # reasoning applies unchanged, and this verb is the one that most needs it:
  # it is the WRITER, and the writer judging "is this file mine" by a second,
  # looser copy of the reader's rules is how a generator comes to disown its own
  # output. Same "is this a complete ccrc install?" wording `cmd_adopt` uses.
  local shape="$CCRC_HERE/ccrc-wrapper-shape"
  [[ -f "$shape" ]] \
    || _ccrc_die "the wrapper shape contract is missing: $shape — is this a complete ccrc install?"
  # shellcheck source=ccrc-wrapper-shape
  . "$shape" \
    || _ccrc_die "the wrapper shape contract failed to load: $shape"

  # One directory up from THIS FILE, exactly as `ccrc-adopt` resolves
  # `gen-accounts.mjs` (:109-125): true in a checkout and at `~/ccrc/deploy` on
  # a deployed box, because both deploy lanes rsync `deploy/` into `~/ccrc/`.
  local gen="$CCRC_HERE/../deploy/gen-wrappers.mjs"
  [[ -f "$gen" ]] \
    || _ccrc_die "the wrapper generator is missing: $gen — it ships one directory up from this script (at ~/ccrc/deploy on a deployed box); is this a complete ccrc install?"

  # BY NAME, and before anything is created or written. Without this, a box with
  # no node fails somewhere inside a command substitution and reports a manifest
  # it could not read — "a missing dependency" and "a corrupt manifest" are two
  # conditions an operator acts on completely differently, which is the
  # overloaded-seam mistake this file's own header bans (see `cmd_version`'s jq
  # branch for the same refusal in the same shape).
  command -v node >/dev/null 2>&1 \
    || _ccrc_die "node is required by 'ccrc wrappers' — it runs $gen to read the roster and stage each wrapper — but is not on PATH. Install Node (this repo's floor is in server/package.json's \"engines\") or put it on PATH, then re-run."

  # A FRESH BOX HAS NO ~/.local/bin, AND THAT IS NOT AN ERROR: this verb is the
  # installer, so a missing bin dir is a box at the start of its life rather
  # than a box that is broken. `-m 0755` applies to the FINAL directory only
  # (POSIX `mkdir -p`), which is the one whose mode matters because it goes on
  # PATH; an EXISTING directory is left exactly as the operator has it.
  #
  # BEHIND `--dry-run`, because a dry run that creates directories is a dry run
  # nobody can trust. Measured: it used to create BOTH `$HOME/.local` and
  # `$HOME/.local/bin` on a fresh box and exit 0, while the README promised it
  # reports without touching anything. The report was the thing that was wrong,
  # not the promise.
  if [ "$dry" -eq 0 ]; then
    # shellcheck disable=SC2174  # -m applying to the deepest directory ONLY is
    # the intent, not an oversight: it is the one that goes on PATH.
    mkdir -p -m 0755 "$WRAPPER_BIN_DIR" \
      || _ccrc_die "cannot create $WRAPPER_BIN_DIR — nothing was written"
  fi

  local staging
  staging="$(mktemp -d)" \
    || _ccrc_die "cannot create a staging directory (mktemp -d failed) — nothing was written"
  # ARMED BEFORE ANYTHING IS WRITTEN INTO IT, and with the path expanded HERE
  # rather than at exit: `staging` is a function-local, so a `trap 'rm -rf
  # "$staging"' EXIT` would fire under `set -u` against an unbound variable on
  # every path that returns normally, leaving the directory behind. This suite's
  # own fixture helper (server/test/tmpHelpers.ts) exists because 7,830 leaked
  # temp directories were once measured on this box; a leak in the shipped tool
  # is the same defect with no afterAll underneath it.
  # shellcheck disable=SC2064
  trap "rm -rf -- $(printf '%q' "$staging")" EXIT

  # WHAT THE GENERATOR IS POINTED AT TO *READ*. Normally the bin dir itself.
  # On a dry run against a box that has no `~/.local/bin` at all, there is
  # nothing to point it at and creating one would be the very thing a dry run
  # must not do — so it reads an empty directory INSIDE the staging tree (which
  # the EXIT trap already owns) and answers, correctly, that every wrapper is
  # `absent` and there are no orphans. That is the true answer for a box with no
  # bin directory; nothing is invented and nothing outside the temp tree is
  # created. Every path this verb PRINTS still comes from `$WRAPPER_BIN_DIR`,
  # never from here, so the report names the box's own paths.
  local scan_dir="$WRAPPER_BIN_DIR"
  if [ ! -d "$WRAPPER_BIN_DIR" ]; then
    scan_dir="$staging/.bin-scan"
    mkdir -p "$scan_dir" \
      || _ccrc_die "cannot create a scratch directory inside $staging — nothing was written"
  fi

  # STDOUT is the manifest; STDERR is deliberately NOT captured, so node's own
  # diagnosis reaches the operator verbatim. For an invalid roster that
  # diagnosis includes a `gen-wrappers: remedy: …` line naming the fix, and that
  # line is the useful message — swallowing it to re-word the failure here would
  # replace a fix with a shrug.
  local manifest rc=0
  manifest="$(node "$gen" "$HOME/.ccrc/accounts.json" "$scan_dir" "$staging")" || rc=$?
  [ "$rc" -eq 0 ] \
    || _ccrc_die "$gen exited $rc without a usable manifest, so nothing was written — its own message above says why"

  # ── READING THE MANIFEST ────────────────────────────────────────────────
  # D-71 bans `IFS=$'\t' read` for any tab-delimited record that can carry an
  # EMPTY field: a tab is IFS whitespace, so bash collapses a run of them and
  # every field after the empty one shifts left — silently, with no parse error
  # to notice. This call is SAFE, and the reason lives in the producer rather
  # than here (plan D6, restated in `deploy/gen-wrappers.mjs`'s header): every
  # field of every record is NON-EMPTY BY CONSTRUCTION — `id` matched `ID_RE`,
  # and the record type, `classify` and `equal` are literals drawn from small
  # closed sets. The trailing vars are the only ones that come back empty, on
  # the shorter record types, and a trailing empty field is exactly the case
  # `read` gets right.
  #
  # IF A FUTURE FIELD CAN EVER BE EMPTY — an optional annotation, say — DO NOT
  # keep this idiom. Split the line by hand on literal tabs, the way
  # `_check_wrappers`'s roster reader does (`ccd/ccrc-doctor-checks`). Keeping
  # `IFS=$'\t' read` with a possibly-empty field is how a reader starts reading
  # the wrong column without ever producing an error — here that would mean
  # taking a wrapper's `classify` out of the `equal` column and overwriting a
  # file on the strength of it.
  #
  # FIVE variables, not four: the `summary` record carries four fields after its
  # type. Reading it into three would hand the last variable "1<TAB>1" — the
  # remainder, tabs and all — and the record-count assertion below would then be
  # comparing against a string that is not a number.
  local kind a b c d
  local sum_total="" sum_gen="" sum_up="" sum_ext="" saw_summary=0
  local -a w_id=() w_class=() w_equal=() protected=() orphans=()
  while IFS=$'\t' read -r kind a b c d; do
    case "$kind" in
      '') continue ;;
      summary)   saw_summary=1; sum_total="$a"; sum_gen="$b"; sum_up="$c"; sum_ext="$d" ;;
      wrapper)   w_id+=("$a"); w_class+=("$b"); w_equal+=("$c") ;;
      protected) protected+=("$a") ;;
      orphan)    orphans+=("$a") ;;
      *) _ccrc_die "the manifest from $gen carries a record type this verb does not know — this is a bug in ccrc, not a fact about your box, and nothing was written" ;;
    esac
  done <<< "$manifest"

  [ "$saw_summary" -eq 1 ] \
    || _ccrc_die "the manifest from $gen has no summary line, so there is nothing to check the wrapper records against — nothing was written"
  local f
  for f in "$sum_gen" "$sum_up" "$sum_ext"; do
    [[ "$f" =~ ^[0-9]+$ ]] \
      || _ccrc_die "the manifest from $gen has a summary whose counts are not all numbers — nothing was written"
  done
  # THE TRUNCATION GATE. bash cannot tell a complete manifest from a half-
  # delivered one by looking at what arrived (`deploy/gen-wrappers.mjs`'s header
  # says so from the writer's end, which is why it assembles the whole thing
  # before writing a byte). This is the reader's half of that contract: a run
  # that installed the records it happened to receive would converge half a box
  # and report success.
  [ "${#w_id[@]}" -eq "$sum_gen" ] \
    || _ccrc_die "the manifest from $gen is truncated: its summary claims $sum_gen generated account(s) and it carries ${#w_id[@]} wrapper record(s). Nothing was written."
  # THE SAME GATE FOR THE `protected` LIST (D-80), and it is not symmetry for
  # its own sake: the protected records are the LAST thing before the orphans,
  # so a manifest truncated a few bytes earlier would arrive with every wrapper
  # record intact and the entire untouchable-account lock silently absent. A
  # lock that a truncation can delete is not a lock. Counted against the
  # summary's own upstream + external, because those two numbers come off a
  # different walk of `roster.accounts` than the protected records do.
  [ "${#protected[@]}" -eq "$((sum_up + sum_ext))" ] \
    || _ccrc_die "the manifest from $gen is truncated: its summary claims $sum_up upstream + $sum_ext external account(s) and it carries ${#protected[@]} protected record(s), so the list of accounts ccrc must never write is incomplete. Nothing was written."

  # ONE timestamp for the whole run, so every backup a single run writes reads
  # as one event. (Two convergences inside the same second would reuse the name;
  # that needs a file to be edited between two runs less than a second apart,
  # and the alternative — refusing to converge because the clock has not
  # ticked — is worse.)
  local stamp
  stamp="$(date -u +%Y%m%dT%H%M%SZ)" \
    || _ccrc_die "cannot read the clock (date -u failed), and a backup needs a name — nothing was written"

  # ── PRE-PASS: EVERY RECORD IS VALIDATED BEFORE THE FIRST BYTE IS WRITTEN ──
  # Each refusal below ends "nothing was written", and this loop is what makes
  # that sentence TRUE rather than merely reassuring. These checks used to live
  # inside the action loop, where a manifest whose SECOND record was bad printed
  # `WRITE claude2 …` and then, two lines later, `… and nothing was written` —
  # two statements about one run, contradicting each other, with the first one
  # right. (It was invisible to the tests because every stub manifest that
  # reached these branches carried a single record.) These are all statements
  # about the MANIFEST, not about the box, so none of them needs to see disk
  # state that a write could change: hoisting them costs nothing and restores
  # the all-or-nothing the messages promise.
  #
  # The staged parse is cached here for the action loop, which is the other half
  # of the same argument — re-parsing per record in two places is how the
  # pre-pass and the writer would come to disagree about the same file.
  local i id
  local sok starget ssuffix ssecrets p
  local -a s_target=() s_suffix=() s_secrets=()
  for ((i = 0; i < ${#w_id[@]}; i++)); do
    id="${w_id[$i]}"

    # The id off the manifest is about to become a FILENAME under
    # $HOME/.local/bin. The gate is on the ID, before any path is built from it,
    # which is what makes it hold for a traversing id (`../../.bashrc`) as well
    # as for a merely illegal one (`claude2.bak`) — a check on the resulting
    # path would have to enumerate the ways a path can escape.
    [[ "$id" =~ $WRAPPER_ID_RE ]] \
      || _ccrc_die "the manifest from $gen names \"$id\", which is not a legal account id, and this verb will not build a path under $WRAPPER_BIN_DIR out of it — this is a bug in ccrc, not a fact about your box, and nothing was written"

    # LOCK 1 (see the header): an id cannot be both a wrapper ccrc writes and an
    # account ccrc must never touch. THE WHOLE RUN STOPS, not just this id: the
    # two lists come off two independent walks of the same roster, so an overlap
    # means the generator disagrees with itself, and once that is true its
    # verdicts about every OTHER account are worth nothing either. Refusing one
    # id and converging the rest would be trusting a source this very line has
    # just caught contradicting itself.
    for p in ${protected[@]+"${protected[@]}"}; do
      [ "$p" != "$id" ] \
        || _ccrc_die "the manifest from $gen lists \"$id\" as an account ccrc must never write (exec.kind upstream or external) AND asks for a wrapper to be installed at \$HOME/.local/bin/$id. Those cannot both be true; this is a bug in ccrc, not a fact about your box, and the whole run is refused — nothing was written."
    done

    [ -f "$staging/$id" ] \
      || _ccrc_die "the manifest from $gen names \"$id\" but staged no text for it — this is a bug in ccrc, not a fact about your box, and nothing was written"

    # THE STAGED TEXT IS READ BACK THROUGH THE READER, on every box, on every
    # run. `server/test/wrapper-roundtrip.test.ts` pins that the emitter and
    # `_wrap_parse_shape` agree; this is the same check made on the actual bytes
    # about to be installed, which is the only place it can catch a file that
    # was staged, or truncated, by something other than this pipeline.
    IFS=$'\t' read -r sok starget ssuffix ssecrets < <(_wrap_parse_shape "$staging/$id")
    [ "$sok" = ok ] \
      || _ccrc_die "the text staged for \"$id\" is not the generated wrapper shape, so this verb will not install it — this is a bug in ccrc, not a fact about your box, and nothing was written"
    # LOCK 4 (see the header). A wrapper whose exec target is its own id would
    # exec itself forever; it is also precisely the file a generator talked into
    # writing the UPSTREAM account would stage. It covers `upstream` only —
    # `external` has no such self-referential property, which is why lock 1
    # exists.
    [ "$starget" != "$id" ] \
      || _ccrc_die "refusing to install \"$id\": the wrapper the roster produced would exec \$HOME/.local/bin/$id — itself. That is an upstream account's own name, and ccrc never writes an upstream or external account. Nothing was written."

    s_target+=("$starget"); s_suffix+=("$ssuffix"); s_secrets+=("$ssecrets")
  done

  # ── ACTION PASS: from here on, a refusal is about the BOX, not the manifest,
  #    and is reported per account rather than aborting the run. ─────────────
  local klass eq action why remedy backup tmp equivalent
  local dok dtarget dsuffix dsecrets
  local n_written=0 n_converged=0 n_refused=0
  for ((i = 0; i < ${#w_id[@]}; i++)); do
    id="${w_id[$i]}"; klass="${w_class[$i]}"; eq="${w_equal[$i]}"
    starget="${s_target[$i]}"; ssuffix="${s_suffix[$i]}"; ssecrets="${s_secrets[$i]}"

    action=""; why=""; remedy=""; backup=""
    case "$klass" in
      absent)
        action="write"; why="nothing was at that path" ;;
      ccrc-unmodified)
        if [ "$eq" = yes ]; then
          action="none"
        else
          action="rewrite"; why="ccrc wrote it, nothing has edited it since, and the roster has changed"
        fi ;;
      ccrc-edited)
        if [ "$force" -eq 1 ]; then
          action="rewrite"; why="ccrc wrote it and it has been edited since (--force)"
        else
          action="refuse"
          why="ccrc wrote it and something has edited it since"
          remedy="keep the edit by setting exec.kind to \"external\" for \"$id\" in $HOME/.ccrc/accounts.json, or discard it and take the roster's version with: ccrc wrappers --force"
        fi ;;
      foreign)
        # D4: EQUIVALENCE IS JUDGED BY THE READER, ON BOTH SIDES. The on-disk
        # file and the staged file both go through `_wrap_parse_shape`, and the
        # two (target, suffix, secrets) triples are compared. It deliberately
        # does NOT compare the on-disk parse against roster fields: one reader
        # answering for both sides means there is no second opinion to drift,
        # and the staged file is what would actually be installed, which is the
        # thing the operator is being asked about. A `no` from either side —
        # a file the reader cannot make sense of at all — is never equivalent.
        equivalent=0
        IFS=$'\t' read -r dok dtarget dsuffix dsecrets < <(_wrap_parse_shape "$WRAPPER_BIN_DIR/$id")
        if [ "$dok" = ok ] && [ "$dtarget" = "$starget" ] \
           && [ "$dsuffix" = "$ssuffix" ] && [ "$dsecrets" = "$ssecrets" ]; then
          equivalent=1
        fi
        if [ "$equivalent" -eq 1 ]; then
          if [ "$adopt" -eq 1 ] || [ "$force" -eq 1 ]; then
            action="rewrite"; why="ccrc did not write it, but it says exactly what ccrc would say — adopted"
          else
            action="refuse"
            why="ccrc did not write it, but it says exactly what ccrc would say (same target, same config dir, same secrets file)"
            remedy="take it over with: ccrc wrappers --adopt — the file you have now is backed up first"
          fi
        else
          if [ "$force" -eq 1 ]; then
            action="rewrite"; why="ccrc did not write it and it says something else (--force)"
          else
            action="refuse"
            why="ccrc did not write it, and it is not the wrapper this roster describes"
            # NO `--force` IN THIS REMEDY, EVER — see the header. This is the
            # branch that holds somebody's bespoke launcher.
            remedy="move it aside (mv \"$WRAPPER_BIN_DIR/$id\" \"$WRAPPER_BIN_DIR/$id.saved-$stamp\") and re-run, or set exec.kind to \"external\" for \"$id\" in $HOME/.ccrc/accounts.json so ccrc stops claiming that name"
          fi
        fi ;;
      unreadable)
        # No flag reaches this branch. "I could not read it" is not "I know what
        # it is", and every other refusal here is a judgement about a file this
        # process has actually read.
        action="refuse"
        why="something is at that path and this process could not read it"
        remedy="make it readable (ls -l \"$WRAPPER_BIN_DIR/$id\") and re-run, or move it aside. No flag overrides this one." ;;
      oversize)
        # D-81. No flag reaches this branch either, for the sibling reason to
        # `unreadable`'s: `$gen` never even read this file (a cheap `statSync`
        # gate ahead of `readFileSync`, so past-V8's-string-cap never THROWS
        # and never misclassifies a huge-but-readable file as `unreadable`
        # instead), so there are no bytes here for `--force` to judge either.
        action="refuse"
        why="it is over 1 MiB — categorically not a ccrc wrapper"
        remedy="if \"$id\" should be generated, move the big file aside (mv \"$WRAPPER_BIN_DIR/$id\" \"$WRAPPER_BIN_DIR/$id.saved-$stamp\") and re-run; if that file is the upstream binary, set \"$id\"'s roster entry to exec.kind \"upstream\" in $HOME/.ccrc/accounts.json instead. No flag overrides this one." ;;
      *)
        action="refuse"
        why="$gen classified it as \"$klass\", which this verb does not know"
        remedy="this is a bug in ccrc, not a fact about your box — $gen and cmd_wrappers in $CCRC_HERE/ccrc have drifted" ;;
    esac

    case "$action" in
      none)
        n_converged=$((n_converged + 1))
        printf 'CONVERGED %s: %s is already exactly what the roster says\n' "$id" "$WRAPPER_BIN_DIR/$id"
        continue ;;
      refuse)
        n_refused=$((n_refused + 1))
        # The verdict line and its remedy are two halves of ONE result and both
        # go to STDOUT, adjacent — doctor's contract (this file's header, and
        # `server/test/ccrc-doctor.test.ts` pins the same adjacency there).
        printf 'REFUSE %s: %s — %s\n' "$id" "$WRAPPER_BIN_DIR/$id" "$why"
        printf '  remedy: %s\n' "$remedy"
        continue ;;
    esac

    [ "$action" = rewrite ] && backup="$id.pre-ccrc-$stamp"
    if [ "$dry" -eq 1 ]; then
      n_written=$((n_written + 1))
      printf 'WOULD-%s %s: %s — %s%s\n' "${action^^}" "$id" "$WRAPPER_BIN_DIR/$id" "$why" \
        "${backup:+ (the file there now would be copied to $backup first)}"
      continue
    fi

    if [ -n "$backup" ]; then
      # BEFORE the overwrite, always, and named so it can NEVER be mistaken for
      # an account. `WRAPPER_ID_RE` is `^[a-z][a-z0-9-]{0,31}$` — a "." can
      # never appear in a legal id — so `<id>.pre-ccrc-<UTC>` is invisible to
      # `ccrc adopt`'s candidate scan and to `ccrc doctor`'s `_check_wrappers`
      # alike. That is LOAD-BEARING, not tidiness: a backup that looked like an
      # id would be adopted as a second account fighting the first over one
      # CLAUDE_CONFIG_DIR, and doctor would report a wrapper the roster never
      # declared. (It is the same "." that drops the `ccd.bak-<date>` and
      # `claude2.bak-<date>` files a real box accumulates — see
      # `ccd/ccrc-wrapper-shape:63-67`.)
      # `cp -p` so the backup keeps the mode and timestamps of what it replaced.
      cp -p -- "$WRAPPER_BIN_DIR/$id" "$WRAPPER_BIN_DIR/$backup" \
        || _ccrc_die "could not back up $WRAPPER_BIN_DIR/$id to $WRAPPER_BIN_DIR/$backup, so nothing was overwritten"
    fi

    # ATOMIC, in `deploy/deploy.sh`'s `install_atomic` shape (:50-58): the
    # staged text lands beside the target under a temp name, gets its mode, and
    # is RENAMED into place. Two things follow, and both matter on a live box:
    # a reader never sees a half-written wrapper (a half-written wrapper is an
    # account that cannot start a session), and the rename needs write
    # permission on the DIRECTORY rather than on the file — so a wrapper an
    # operator has chmod-ed read-only is still converged instead of failing
    # halfway. The temp name begins with a "." for the same reason the backup
    # name carries one: it can never match `WRAPPER_ID_RE`, so a leftover from
    # an interrupted run is never read as an account.
    tmp="$WRAPPER_BIN_DIR/.$id.tmp.$$"
    if ! { cp -- "$staging/$id" "$tmp" && chmod 0755 "$tmp" \
             && mv -f -- "$tmp" "$WRAPPER_BIN_DIR/$id"; }; then
      rm -f -- "$tmp"
      _ccrc_die "could not install $WRAPPER_BIN_DIR/$id — nothing at that path was replaced${backup:+ (the copy at $WRAPPER_BIN_DIR/$backup is the file you already had)}"
    fi
    n_written=$((n_written + 1))
    printf '%s %s: %s — %s%s\n' "${action^^}" "$id" "$WRAPPER_BIN_DIR/$id" "$why" \
      "${backup:+ (the file that was there is now $backup)}"
  done

  # ── SWEEP THIS TOOL'S OWN STRAYS ────────────────────────────────────────
  # `install_atomic` ENDS with `rm -f $dest.incoming-*`, and its comment records
  # that as a reproduced review finding rather than tidiness: a run killed
  # between the copy and the rename leaves a mode-0755 file in a directory that
  # is ON PATH, and nothing else will ever remove it. The "." in the name keeps
  # it out of the ACCOUNT namespace (adopt and doctor never see it), which is
  # the other half of that finding and the half the comment above already
  # answers — this is the half about a stray executable.
  #
  # It runs AFTER the loop, so this run's own temp files have already been
  # renamed away and the glob can only match leftovers — `install_atomic`'s own
  # reasoning, and the reason a concurrent run's in-flight temp is not something
  # this can hit either (two convergences racing over one file is already lost,
  # with or without this line). The glob is per manifest id and carries the
  # full `.<id>.tmp.` shape, so it can only match names THIS function makes:
  # nothing else in `~/.local/bin` is at risk from it. It runs for EVERY id,
  # not just the ones written, because the common case — a stray for an account
  # that is now converged — is never reached by a per-write sweep.
  if [ "$dry" -eq 0 ]; then
    local had_nullglob=0 stray
    shopt -q nullglob && had_nullglob=1
    shopt -s nullglob
    for id in ${w_id[@]+"${w_id[@]}"}; do
      for stray in "$WRAPPER_BIN_DIR/.$id.tmp."*; do
        # Reported, not silent: this is ccrc removing a file from a directory
        # the operator owns, and a removal nobody is told about is one nobody
        # can audit.
        rm -f -- "$stray" \
          && printf 'SWEPT %s: removed %s, a stray temp file an interrupted ccrc run left behind\n' \
               "$id" "$stray"
      done
    done
    [ "$had_nullglob" -eq 1 ] || shopt -u nullglob
  fi

  # ORPHANS ARE REPORTED AND NEVER REMOVED. A file carrying ccrc's marker whose
  # id no account claims is a fact about the box, not a refusal — nothing about
  # it stopped this run converging — so it does not touch the exit code.
  # Removal belongs to `ccrc uninstall` (Stage 4), which does not exist; a
  # converger that deleted files as a side effect of writing them would be a
  # verb an operator could not run without reading its source first.
  local o
  for o in ${orphans[@]+"${orphans[@]}"}; do
    printf 'ORPHAN %s: %s carries ccrc%s marker and no account in the roster claims it — reported, never removed\n' \
      "$o" "$WRAPPER_BIN_DIR/$o" "'s"
    printf '  remedy: add an account "%s" to %s if it should exist, or remove %s by hand once you are sure nothing runs it\n' \
      "$o" "$HOME/.ccrc/accounts.json" "$WRAPPER_BIN_DIR/$o"
  done

  printf 'summary: %s account(s) in %s — %s generated, %s upstream, %s external (upstream and external are never written); %s %s, %s converged, %s refused, %s orphaned\n' \
    "$sum_total" "$HOME/.ccrc/accounts.json" "$sum_gen" "$sum_up" "$sum_ext" \
    "$n_written" "$([ "$dry" -eq 1 ] && printf 'would be written' || printf 'written')" \
    "$n_converged" "$n_refused" "${#orphans[@]}"

  [ "$n_refused" -eq 0 ] || return 1
  return 0
}

# cmd_adopt — rediscover this box's accounts from disk. The work is entirely
# `ccd/ccrc-adopt`'s, and this verb is how it becomes reachable: adopt is a
# tool that until now was installed by nothing, reached the fleet host only
# incidentally inside the `ccd/` rsync, and sat off PATH at
# `~/ccrc/ccd/ccrc-adopt` where nobody would find it. It is also, precisely, a
# LIFECYCLE operation — "give this hand-built box a roster" — which is this
# CLI's whole subject.
#
# ── EXEC, NOT SOURCE, AND NOT A SUBSHELL ─────────────────────────────────
# `ccrc-adopt` runs `set -euo pipefail` because it is a straight-line "measure,
# or die" pipeline; this file runs `set -uo pipefail` because doctor is a LIST
# of independent checks and `-e` would abort the run at the first failing one
# (see this file's header). Sourcing adopt would drag `-e` into the shell that
# argument is about, and its `exit`s would be ccrc's. `exec` hands the process
# over whole: adopt's stdout/stderr split, its argv handling (`--out`,
# `--force`, `-h`) and its exit codes arrive unaltered — and the two tools
# already share ONE exit-code table (0 success, 1 the tool ran and the answer
# was bad, 2 a usage error), so nothing has to be translated at the seam.
#
# `$BASH` — the absolute path of the interpreter already running this file —
# rather than `"$adopt"` directly or a bare `bash`: no PATH lookup on the box
# whose PATH may be the broken thing, and no dependency on the exec bit
# surviving whatever copied the tree.
#
# Arguments are NOT parsed here. `ccrc adopt --nope` must be adopt's own
# "unknown argument" at exit 2, not this file's — one tool, one usage message.
cmd_adopt() {
  local adopt="$CCRC_HERE/ccrc-adopt"
  [[ -f "$adopt" ]] \
    || _ccrc_die "adopt's script is missing: $adopt — is this a complete ccrc install?"
  exec "$BASH" "$adopt" "$@"
}

# ── cmd_install — the verb this CLI is named for ──────────────────────────
# `ccrc install` converges THIS box from the tree `ccrc` itself was run out of:
# it seeds the config a box cannot boot without, installs the executables,
# units and hooks, generates the account wrappers and finishes by running
# doctor. It is the local, single-box translation of `deploy/deploy.sh` — same
# doctrine, no ssh — and stage 2d builds it one step at a time (Task 6: the
# spine and the three SEEDING steps; Task 7: the tree, executables and stamp;
# Task 8: units, hooks, wrappers and the doctor tail).
#
# ── THE SHAPE: A SPINE OF `_inst_*` STEPS ────────────────────────────────
# `cmd_install` is a fixed SEQUENCE and nothing else; each step is one small
# function that does one thing and prints one line. Three properties this
# arrangement is chosen for, all of which a single long function loses:
#   - an operator reads the sequence itself, in `cmd_install`, without reading
#     the work;
#   - each step's output is one `install: <step>: <result>` line on STDOUT (the
#     RESULT register — an install's transcript is what the operator asked
#     for), so a re-run is a diff of two transcripts;
#   - ORDER is stated in one place. It is load-bearing here in a way it is not
#     in doctor: `accounts.sh` cannot be generated before the roster is placed,
#     and `ccd` refuses to run at all without `accounts.sh` (deploy.sh:274's
#     "roster before ccd" rule, which this file inherits).
#
# ── THE STEP CONTRACT: RETURN 0, OR DIE ──────────────────────────────────
# Every `_inst_*` function either returns 0 or calls `_ccrc_die`, which exits
# the whole run at 1 with the reason on stderr. That is why the sequence below
# checks no return codes and why this file's lack of `set -e` (see the header)
# costs nothing here: a step that FAILED has already stopped the process, and a
# step that is merely a no-op on this box (nothing to do, already converged)
# says so in its line and returns 0. A future step that wants to be survivable
# — Task 8's linger, which needs sudo an operator may not have — PRINTS what it
# could not do and returns 0 deliberately, rather than returning non-zero and
# hoping a caller notices.
#
# ── SEED-ONCE vs REGENERATE, THE ONE DISTINCTION EVERY STEP TURNS ON ─────
# `deploy/deploy.sh:196-206` states it for the remote lane and this verb obeys
# it locally: `~/.ccrc/accounts.json` and `~/.ccrc/ccrc.env` are USER-OWNED —
# created once, NEVER overwritten, because they hold the operator's own edits
# (and, in ccrc.env's case, their tokens). `~/.ccrc/accounts.sh` is ccrc-OWNED
# — a projection of the roster, rewritten from it on every run. Getting this
# backwards in either direction is the worst thing this verb could do: one way
# it destroys an operator's config, the other it leaves a stale bash roster
# describing accounts the box no longer has.
cmd_install() {
  # `cmd_wrappers`' loop (:1040-1048), minus the three flags it has and this
  # verb does not have yet. `-h`/`--help` prints usage at exit 0 rather than
  # being the usage error it is for `cmd_version`: this is a verb that CHANGES
  # THE BOX, so "what will this do to my box" must be answerable without
  # running it. Anything else is a usage error at exit 2, refused BEFORE the
  # first step — an install that half-ran because argument 2 was a typo is
  # worse than one that did not start.
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) usage; exit 0 ;;
      *) _ccrc_usage_die "$1" ;;
    esac
  done

  # BY NAME, ONCE, AND BEFORE THE FIRST STEP — `cmd_wrappers:1069-1076`'s guard,
  # in the same shape and for a sharper version of the same reason. Every step
  # that touches the roster runs `deploy/gen-accounts.mjs`, which IS node, and
  # without this probe an absent interpreter arrives as that generator
  # "failing": `_inst_roster` reports "the shipped roster seed does not
  # validate" and `_inst_accounts_sh` reports "$HOME/.ccrc/accounts.json does
  # not validate — fix it (or move it aside to reseed)". Both are false, and the
  # second one instructs an operator to disturb the USER-OWNED file this verb
  # exists to protect, for a cause that has nothing to do with it. That is the
  # overloaded-seam mistake this file's header bans — "a missing dependency" and
  # "a corrupt config file" are two conditions an operator acts on completely
  # differently — and `install` is the ONE verb here that runs on a box which
  # may legitimately not have node yet. (Round-1 review, Important 1; measured
  # on a PATH holding every coreutil and no node.)
  command -v node >/dev/null 2>&1 \
    || _ccrc_die "node is required by 'ccrc install' — it runs ${CCRC_HERE%/*}/deploy/gen-accounts.mjs to write \$HOME/.ccrc/accounts.sh — but is not on PATH. Install Node (this repo's floor is in server/package.json's \"engines\") or put it on PATH, then re-run. Nothing on this box was written or changed."

  _inst_banner
  _inst_roster
  _inst_accounts_sh
  _inst_env
}

# The two facts every later step is computed FROM, printed before any of them
# runs: which box this is (`$HOME` — not "this machine", because a run under
# `sudo` or as another user converges a different box entirely) and which tree
# it is converging from (`$CCRC_HERE`'s parent — the checkout, or `~/ccrc` on a
# box a deploy has already touched). Both are silent inputs otherwise, and a
# wrong one produces a run that SUCCEEDS at the wrong thing; naming them in
# line 1 turns that from a deduction into a reading.
#
# TWO MEASUREMENTS AND NOTHING ELSE. This line used to end "— single-box, local
# fleet mode on localhost", which is a CLAIM ABOUT THE BOX made before anything
# has been read, and it is false on the one box most likely to be running this:
# an install onto a box whose `ccrc.env` says `CCRC_FLEET=remote` keeps that
# file (it is user-owned) and then prints a banner asserting a mode the box does
# not have and this run did not establish. `$HOME` and the tree are things this
# process KNOWS; the mode belongs to `_inst_env`, which says it only in the case
# where it wrote it, and the address belongs to Task 8's landing block, which
# reads it back from the file. (Round-1 review, Minor 2.)
_inst_banner() {
  printf 'install: box: %s\n' "$HOME"
  printf 'install: tree: %s\n' "${CCRC_HERE%/*}"
}

_inst_roster() {   # seed-once: validate the SEED before placing it (deploy F1);
  # an existing roster is USER-OWNED and is never overwritten.
  #
  # The validation is `deploy.sh:229-246`'s `check_local_roster`, translated to
  # one box: seeding an unusable roster onto a box that had none poisons that
  # box PERMANENTLY, because the very rule that makes the file safe to own —
  # never overwritten — is also what stops the next run from fixing it. A
  # human would have to delete it by hand. So the seed is proven usable while
  # the only cost of being wrong is an exit code.
  local seed="$CCRC_HERE/../deploy/accounts.default.json" dest="$HOME/.ccrc/accounts.json"
  mkdir -p "$HOME/.ccrc" || _ccrc_die "cannot create \$HOME/.ccrc"
  if [ -e "$dest" ]; then
    echo "install: roster: kept (user-owned, never overwritten)"
    return 0
  fi
  [ -f "$seed" ] || _ccrc_die "no roster seed at $seed — run install from inside the shipped tree"
  node "$CCRC_HERE/../deploy/gen-accounts.mjs" "$seed" >/dev/null \
    || _ccrc_die "the shipped roster seed does not validate — refusing to seed a box with it"
  local tmp="$dest.tmp.$$"
  cp "$seed" "$tmp" && mv -f "$tmp" "$dest" || { rm -f "$tmp"; _ccrc_die "seeding $dest failed"; }
  echo "install: roster: seeded single-account default"
}

_inst_accounts_sh() {   # ccrc-OWNED: regenerated every run FROM THE INSTALLED roster
  # (the local translation of deploy's read-back-over-ssh rule), atomically,
  # write-skipped when converged so idempotence is measurable on mtime.
  #
  # FROM THE INSTALLED ROSTER, never from the seed: `deploy.sh:290-299` reads
  # the BOX's `accounts.json` back over ssh before generating, precisely so the
  # generated file's own header line ("Generated from ~/.ccrc/accounts.json")
  # is true on a box whose operator edited that file. Here the "read back" is a
  # plain read of the file the previous step just guaranteed exists — and the
  # generator's refusal is the whole error path for a roster an operator broke
  # by hand: its `gen-accounts: remedy: …` line reaches stderr verbatim,
  # because stderr is deliberately NOT captured (`cmd_wrappers:1125-1133` makes
  # the same choice for the same reason — re-wording a fix into a shrug helps
  # nobody).
  local dest="$HOME/.ccrc/accounts.sh" out tmp
  out="$(node "$CCRC_HERE/../deploy/gen-accounts.mjs" "$HOME/.ccrc/accounts.json")" \
    || _ccrc_die "\$HOME/.ccrc/accounts.json does not validate — fix it (or move it aside to reseed) and re-run"
  if [ -f "$dest" ] && [ "$out" = "$(cat "$dest")" ]; then
    echo "install: accounts.sh: converged"
    return 0
  fi
  tmp="$dest.tmp.$$"
  printf '%s\n' "$out" > "$tmp" && chmod 644 "$tmp" && mv -f "$tmp" "$dest" \
    || { rm -f "$tmp"; _ccrc_die "installing $dest failed"; }
  echo "install: accounts.sh: generated from \$HOME/.ccrc/accounts.json"
}

_inst_env() {   # seed-once, exactly like the roster: the env file is the box's
  # ONE machine-config file, holds operator secrets once configured, and is
  # never sourced and never overwritten by tooling.
  #
  # THROUGH `$BOX_ENV_FILE`, never the literal path (D-88): this verb is the
  # file's only WRITER and `status`/`doctor` are its readers, which is exactly
  # the arrangement `BOX_ENV_FILE`'s own comment (:91-101) exists to protect —
  # "three copies of a path is how two of them end up reading a file the third
  # does not write". The template below is a LITERAL, not a copy of
  # `deploy/ccrc.env.example`: the example file documents every key including
  # the ones that carry tokens, and a fresh single-box install needs four
  # values and a pointer to that file for the rest.
  local dest="$BOX_ENV_FILE"
  if [ -e "$dest" ]; then
    echo "install: ccrc.env: kept (user-owned, never overwritten)"
    return 0
  fi
  local tmp="$dest.tmp.$$"
  {
    printf '%s\n' "# ccrc box config — written once by ccrc install; edit freely, ccrc never rewrites it."
    printf '%s\n' "# Keys and defaults: deploy/ccrc.env.example in the shipped tree."
    printf '%s\n' "CCRC_HOST=127.0.0.1"
    printf '%s\n' "CCRC_PORT=7788"
    printf '%s\n' "CCRC_FLEET=local"
    printf '%s\n' "CCRC_PROJECTS_ROOT=$HOME/projects"
  } > "$tmp" && mv -f "$tmp" "$dest" || { rm -f "$tmp"; _ccrc_die "writing $dest failed"; }
  echo "install: ccrc.env: written (localhost, local fleet mode)"
}

# Guard so the script can be `source`d (the way server/test/ccd-clip.test.ts:32
# and server/test/ccd-workspaces.test.ts:394 source ccd itself, to call one
# function directly without running the whole CLI) without running a command
# — same guard ccd carries at its own dispatch (ccd/ccd:8578). (Round-1
# review, Minor 4: this comment used to cite server/test/roster-generate.test.ts,
# which sources the GENERATED ~/.ccrc/accounts.sh — a different file, whose
# `_ccrc_*` helpers come from shared/generate.mjs, not from ccd. Fixed to name
# the tests that actually source ccd.)
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then

# ── top-level argument parsing ──────────────────────────────────────────
# Only -h/--help is recognised ahead of the verb; anything else in that
# position IS the verb (data, not a flag), so there is no --flag/--flag=value
# loop to run at this level yet. That idiom (ccrc-adopt:82-90: --out PATH /
# --out=PATH, --force, -h|--help, unknown -> usage+exit 2) is what each
# cmd_<verb> follows once a verb grows flags of its own.
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -*) _ccrc_usage_die "$1" ;;
    *) break ;;
  esac
done

VERB="${1:-}"
[ $# -eq 0 ] || shift

if [ -z "$VERB" ]; then
  echo "$PROG: missing verb" >&2
  usage >&2
  exit 2
fi

case "$VERB" in
  version) cmd_version "$@" ;;
  doctor)  cmd_doctor "$@" ;;
  status)  cmd_status "$@" ;;
  adopt)   cmd_adopt "$@" ;;
  wrappers) cmd_wrappers "$@" ;;
  install) cmd_install "$@" ;;
  *) _ccrc_usage_die "$VERB" ;;
esac

fi
