#!/usr/bin/env bash
# ccrc — the lifecycle CLI for a Claude Code fleet box: installs, updates and
# diagnoses a box, as a sibling to `ccd`, which drives sessions once one is
# already running. Stage 2b, Task 1 of the
# 2026-08-15-stage2b-ccrc-cli-and-doctor plan: this ships only the dispatch
# skeleton, the `version` verb, and usage/argument handling. `doctor`,
# `status` and `adopt` are reserved verb NAMES so the usage line and every
# later task's `case` arm are already stable — dispatching to one of them
# today prints "not implemented yet: <verb>" and exits 1, distinct from an
# unrecognised verb (exit 2, see below).
#
# ── WHY `set -uo pipefail`, NOT `-euo` ─────────────────────────────────────
# `ccrc-adopt` (this file's own model for argument handling) uses `-e`
# because it is a straight-line pipeline of "measure, or die" steps: any
# failure really should stop everything right there. `ccrc doctor` (Task 3+)
# is the opposite shape — a LIST of independent checks, each of which SIGNALS
# by returning non-zero, and the whole point of running doctor is to see every
# check's verdict in one pass, not to abort at the first failing one. `-e`
# here would turn "the box is missing three things" into "the box is missing
# one thing, and doctor crashed" the moment the first check's `return 1` hit a
# `set -e` shell. So: no `-e`, ever, in this file. If a future change adds
# `-e` back "because it caught a real bug", it has broken doctor; don't.
# `-u` (unset variables are errors) and `pipefail` (a failing left-hand side
# of a pipe fails the whole pipeline) carry no such conflict and stay on.
#
# ── EXIT CODES (house convention — see ccd/ccrc-adopt:68-91 and
#    deploy/verify-service.sh:50-54, both already committed to this table) ──
#   0 = success.
#   1 = the tool ran and the answer was bad (a check failed, a stamp did not
#       parse, a verb is not implemented yet).
#   2 = USAGE error — an unknown verb or argument. Kept distinct from 1 so a
#       caller can tell "you typed it wrong" apart from "doctor found a real
#       problem": scripting `ccrc doctor; case $? in 1) …` must never trip on
#       a typo instead of a genuine finding.
#
# ── DIAGNOSTIC REGISTERS (adopt's own convention, reused here) ─────────────
# Every line this script prints to stderr is prefixed "$PROG: ", then one of:
#   - a bare refusal — "$PROG: <what went wrong>" (`_ccrc_die`, exits 1).
#   - "note: …" — informational, does not change the exit code (`_ccrc_say`).
# The RESULT of a verb (what the operator actually asked for) goes to
# stdout, same split as ccrc-adopt's JSON-on-stdout / diagnostics-on-stderr.
#
# DOCTOR'S "remedy: …" LINES ARE NOT IN THAT STDERR TABLE, and this paragraph
# is the correction of a guess Task 1 made before doctor existed: it predicted
# that a non-pass verdict's remedy would ride `_ccrc_say` on stderr. It does
# not. A verdict line and its remedy are two halves of ONE result — the
# contract `server/test/ccrc-doctor.test.ts` pins is "the line immediately
# after a FAIL is that FAIL's remedy" — so splitting the pair across two
# streams would break it for every caller that redirects one of them, which is
# every caller that pipes doctor into a report. Both halves are the RESULT and
# both go to stdout; see `ccd/ccrc-doctor-checks`'s own header for the full
# shape. `_ccrc_say` keeps its job: stderr notes that are not a verdict.
#
# Do NOT add a `# ccrc:generated …` marker line to this file by imitation of
# `ccd`'s line 2: that marker is `shared/mark.mjs`'s format for files a
# generator writes and would refuse to run over hand edits to; `ccd` carries
# one spuriously (it predates the marker meaning something), and `ccrc` is,
# and stays, hand-written.
set -uo pipefail

PROG=ccrc

# Where the rest of the shipped tree is, relative to THIS FILE rather than to
# $PWD — `ccrc-adopt:103-104`'s idiom, so `ccrc` works run as `bash ccd/ccrc`
# from anywhere, and on a bare installed box (~/ccrc/ccd/ccrc) with no checkout
# in sight. Two deliberate differences from adopt's line, both measured:
#   - `${BASH_SOURCE[0]}`, not `$0`: THIS script is meant to be source-able
#     (the guard at the bottom exists for that), and under `source` `$0` is the
#     calling shell's argv[0], so it would answer for the caller's directory.
#   - `${_here%/*}`, not `$(dirname …)`: `dirname` is coreutils, i.e. a PATH
#     lookup, and the one box `ccrc doctor` most needs to work on is the box
#     whose environment is broken. Measured in ccrc-doctor.test.ts, whose
#     fixture PATH contains no system directory at all: with `dirname` here,
#     ccrc died with "doctor's check table is missing", blaming the install for
#     what was actually a PATH problem. Parameter expansion cannot fail that
#     way. The `*/*` guard covers `bash ccrc` from inside ccd/, where
#     BASH_SOURCE carries no directory at all and `%/*` would strip nothing.
CCRC_HERE="${BASH_SOURCE[0]}"
[[ "$CCRC_HERE" == */* ]] || CCRC_HERE="./$CCRC_HERE"
CCRC_HERE="$(cd "${CCRC_HERE%/*}" && pwd)"

usage() {
  cat <<EOF
usage: $PROG {doctor|status|adopt|version}

The lifecycle CLI for a Claude Code fleet box — installs, updates and
diagnoses a box, as a sibling to ccd (which drives sessions once one is
already running).

  version   print the build this box is running, from ~/.ccrc/build.json
  doctor    check this box's prerequisites — one PASS/WARN/FAIL line per
            check, each non-pass followed by its remedy; exit 1 if any failed
  status    (not implemented yet) show this box's fleet role and state
  adopt     (not implemented yet) rediscover accounts.json from disk

  -h, --help   print this message and exit 0

Exit codes: 0 success, 1 the tool ran and the answer was bad, 2 a usage
error (unknown verb or argument).
EOF
}

# ── diagnostic helpers (stderr; the RESULT of a verb goes to stdout) ───────
# `_ccrc_say` — a note, does not stop the run or change the exit code. Also
# how a future doctor check prints its "remedy: …" line (see header above).
_ccrc_say() { echo "$PROG: $*" >&2; }
# `_ccrc_die` — a bare refusal: this run cannot continue. Always exits 1 —
# never 2, which is reserved for a USAGE error (see `_ccrc_usage_die` below).
_ccrc_die() { echo "$PROG: $*" >&2; exit 1; }
# The one place "unknown argument" is spelled, so the unknown-verb and
# unknown-top-level-flag paths below cannot drift onto two different
# messages for what is, to an operator, the same mistake.
_ccrc_usage_die() { echo "$PROG: unknown argument: $1" >&2; usage >&2; exit 2; }
# `doctor`/`status`/`adopt` share this exact refusal shape; naming the verb
# again as a literal in three separate case arms is how that shape would
# eventually drift between them.
_ccrc_not_implemented() { _ccrc_die "not implemented yet: $1"; }

# cmd_version — what THIS box is running, per its own build stamp, never a
# guess. Same three-way discipline as `ccd version` (ccd/ccd:1946-1969):
#   - no ~/.ccrc/build.json  -> a dev checkout, or a box `ccrc install` never
#     touched. "unstamped" at exit 0 is the honest ANSWER here, not an error.
#   - a stamp that parses    -> print the facts.
#   - a stamp that exists but does not parse (or is missing a field) ->
#     something wrote garbage where a deploy writes facts; refuse loudly
#     rather than print a version nobody measured.
# Parsed with jq, not `python3` (ccd's own choice) — this project already
# depends on jq for exactly this kind of small-JSON reads (ccrc-adopt uses it
# throughout) and there is no reason to add a second interpreter dependency
# for one file read. The whole filter is wrapped in `try…catch empty` and
# checks each field's TYPE rather than just its presence: `.dirty` is a real
# boolean that is legitimately `false` on most boxes, so a naive `jq -e` (which
# treats a `false`/`null` last output as failure) would misreport every clean
# build as "unreadable" — this checks `.dirty|type=="boolean"` instead, which
# accepts `false` as the valid, common value it is.
#
# `version` takes NO arguments — not even `-h`/`--help`. An extra argument
# here (including `--help`) is a USAGE error, exit 2, same as an unrecognised
# top-level verb/flag: `_ccrc_usage_die` prints "unknown argument: <it>" plus
# the full usage text and quits. This deliberately does not special-case
# `--help` into its own per-verb help screen — asking for help is a top-level
# concern (`ccrc -h` / `ccrc --help`, before the verb is even read); once a
# verb has been selected, `version` has exactly one job and no flags of its
# own to explain. (Round-1 review, Important 2: this used to `_ccrc_die` at
# exit 1, which collided with this very file's own exit-code table — 1 means
# "the tool ran and the answer was bad", not "you typed it wrong".)
#
# A missing `jq` is probed for and refused BY NAME before the parse is
# attempted (round-1 review, Important 3) — without this, "jq not on PATH",
# "jq parse error" and "permission denied reading the stamp" all fell through
# to the same "build stamp unreadable" message, which sends an operator to
# rebuild/redeploy when the actual fix is `apt install jq`. That collapse is
# exactly the overloaded-seam mistake this codebase's conventions ban: two
# conditions ("this box lacks a dependency" vs. "this box's stamp is
# corrupt") that an operator would act on completely differently must not
# share one signal.
cmd_version() {
  [[ $# -eq 0 ]] || _ccrc_usage_die "$1"
  local stamp="$HOME/.ccrc/build.json"
  if [[ ! -e "$stamp" ]]; then
    echo "$PROG unstamped (no $stamp — this box has no build stamp yet)"
    return 0
  fi
  # Exists but is not a plain file (e.g. a directory) — a shape problem, not
  # an absence; must not be read as "unstamped" (round-1 review, Minor 8).
  [[ -f "$stamp" ]] || _ccrc_die "build stamp unreadable: $stamp (not a regular file)"
  command -v jq >/dev/null 2>&1 \
    || _ccrc_die "jq is required by 'ccrc version' but is not on PATH"
  local line
  line="$(jq -r '
    try (
      if (type == "object")
         and (.sha | type == "string") and (.sha | length > 0)
         and (.ref | type == "string") and (.ref | length > 0)
         and (.builtAt | type == "string") and (.builtAt | length > 0)
         and (.dirty | type == "boolean")
      then "\(.sha) (\(.ref), built \(.builtAt)\(if .dirty then ", dirty" else "" end))"
      else empty
      end
    ) catch empty
  ' -- "$stamp" 2>/dev/null)"
  [[ -n "$line" ]] || _ccrc_die "build stamp unreadable: $stamp"
  echo "$PROG $line"
}

# cmd_doctor — run every check in `ccd/ccrc-doctor-checks`'s table and report
# each one's verdict, THEN a summary count. Exit 0 when every check passed or
# warned, 1 when any failed (2 stays reserved for a usage error, which is why
# doctor needed 1 free — see the exit-code table above).
#
# The loop never stops early, and that is the same reason this file does not
# use `set -e`: an operator running doctor wants the whole list, not the first
# problem. A check SIGNALS with its return code (0 pass / 1 fail / 2 warn) and
# prints its own verdict line; this function only counts and tallies. It
# deliberately does NOT decide anything about a check's subject — that is the
# check's job, and keeping the decision inside the check is what makes "one
# table entry plus one test" the true cost of adding one.
#
# Three ways this refuses rather than reporting a healthy box it never
# measured — a doctor that runs zero checks and exits 0 is the worst failure
# mode this verb has:
#   - the checks file is missing or unreadable   -> refuse (exit 1)
#   - it defined no table at all                 -> refuse (exit 1)
#   - a table entry has no `_check_<name>`       -> that entry FAILS loudly
# The third is a bug in ccrc rather than a fact about the box, and says so.
cmd_doctor() {
  [[ $# -eq 0 ]] || _ccrc_usage_die "$1"
  local checks="$CCRC_HERE/ccrc-doctor-checks"
  [[ -f "$checks" ]] \
    || _ccrc_die "doctor's check table is missing: $checks — is this a complete ccrc install?"
  # shellcheck source=ccrc-doctor-checks
  . "$checks" \
    || _ccrc_die "doctor's check table failed to load: $checks"
  declare -p CCRC_DOCTOR_CHECKS >/dev/null 2>&1 \
    || _ccrc_die "doctor's check table declares no CCRC_DOCTOR_CHECKS: $checks"
  [[ "${#CCRC_DOCTOR_CHECKS[@]}" -gt 0 ]] \
    || _ccrc_die "doctor's check table is empty: $checks — refusing to report a box nobody measured"

  local name rc pass=0 warn=0 fail=0
  for name in "${CCRC_DOCTOR_CHECKS[@]}"; do
    if ! declare -F "_check_$name" >/dev/null 2>&1; then
      printf 'FAIL %s: the check table names it but no _check_%s function exists\n' "$name" "$name"
      printf '  remedy: this is a bug in ccrc, not a fact about your box — the table and the checks in %s have drifted\n' "$checks"
      fail=$((fail + 1))
      continue
    fi
    "_check_$name"; rc=$?
    case "$rc" in
      0) pass=$((pass + 1)) ;;
      2) warn=$((warn + 1)) ;;
      1) fail=$((fail + 1)) ;;
      *)
        # A check may only answer 0/1/2. Anything else (a `set -u` blowup at
        # 127, a stray `return 3`) is counted as a failure and named as the bug
        # it is, rather than being read as one of the three legal verdicts.
        printf 'FAIL %s: the check exited %s, which is not one of 0 (pass), 1 (fail) or 2 (warn)\n' "$name" "$rc"
        printf '  remedy: this is a bug in ccrc, not a fact about your box — see _check_%s in %s\n' "$name" "$checks"
        fail=$((fail + 1))
        ;;
    esac
  done

  printf 'summary: %s checks — %s passed, %s warned, %s failed\n' \
    "$((pass + warn + fail))" "$pass" "$warn" "$fail"
  [[ "$fail" -eq 0 ]] || return 1
}
cmd_status() { _ccrc_not_implemented status; }
cmd_adopt()  { _ccrc_not_implemented adopt; }

# Guard so the script can be `source`d (the way server/test/ccd-clip.test.ts:32
# and server/test/ccd-workspaces.test.ts:394 source ccd itself, to call one
# function directly without running the whole CLI) without running a command
# — same guard ccd carries at its own dispatch (ccd/ccd:8578). (Round-1
# review, Minor 4: this comment used to cite server/test/roster-generate.test.ts,
# which sources the GENERATED ~/.ccrc/accounts.sh — a different file, whose
# `_ccrc_*` helpers come from shared/generate.mjs, not from ccd. Fixed to name
# the tests that actually source ccd.)
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then

# ── top-level argument parsing ──────────────────────────────────────────
# Only -h/--help is recognised ahead of the verb; anything else in that
# position IS the verb (data, not a flag), so there is no --flag/--flag=value
# loop to run at this level yet. That idiom (ccrc-adopt:82-90: --out PATH /
# --out=PATH, --force, -h|--help, unknown -> usage+exit 2) is what each
# cmd_<verb> follows once a verb grows flags of its own.
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -*) _ccrc_usage_die "$1" ;;
    *) break ;;
  esac
done

VERB="${1:-}"
[ $# -eq 0 ] || shift

if [ -z "$VERB" ]; then
  echo "$PROG: missing verb" >&2
  usage >&2
  exit 2
fi

case "$VERB" in
  version) cmd_version "$@" ;;
  doctor)  cmd_doctor "$@" ;;
  status)  cmd_status "$@" ;;
  adopt)   cmd_adopt "$@" ;;
  *) _ccrc_usage_die "$VERB" ;;
esac

fi
