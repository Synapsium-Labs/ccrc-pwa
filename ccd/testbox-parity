#!/usr/bin/env bash
# testbox-parity — the test box's parity check, test box spec §6 (D-7410, D-7416; TB14 runs it before OA-TB2 arms).
#
#   testbox-parity [--repo <path>] [--package <dir>] [--workers <n>] [--flaky <file>]... \
#                  [--recent <n>] [--fixtures] [--record <file> --repo-name <name> --release <tag> --tools-key <key> \
#                   --fingerprint <fp> --box-sha256 <hex>] \
#                  (--pr <number> | --rev <commit>)... -- <command> [<arg>...]
#
# SCOPE (test box connect spec §2.8, C8, C16). `--recent <n>` names the n most recent merged pull requests of the repository
# (`gh pr list --state merged --limit <n> --json number,mergeCommit`), beside any `--pr` and `--rev`; at least one of the
# three is needed. `--fixtures` adds the three fixtures of test box spec §6 (git state, socket, workers) as required legs:
# each is a small vitest file written into the first worktree's package, run on both sides, and the lines it prints (the ones
# that start `TP|`) must be byte-identical. `--record <file>` writes a TestboxParityRecord (shared/testbox-admin.ts) by a
# temp file and a rename at 0600: `pass` only when every leg ran and agreed; the release, the tools key, the host key
# fingerprint and the box file's sha256 are the caller's measurements and ride in unchanged.
#
# For each merged PR (its merge commit, through `gh pr view`) or commit: a FRESH worktree at it, every package with a
# lockfile installed from the lockfile alone (`npm ci`, the parity reference of spec §2.4), then the same command twice
# on the same snapshot, both legs with the junit reporter on stdout and the same worker count (`--maxWorkers=<n>`,
# `--workers`, default 2, the box's CCRC_TESTBOX_WORKERS default):
#   local — `ccrc test --local` in the worktree's package directory: the slice and the queue, never the box;
#   box   — the test box client, run directly (agent/dist/agent/src/testbox/client.js), so the leg runs before arming,
#           with the switch off: the client never reads the switch marker, only the wrapper does.
# It prints, per file, pass or fail on each side and each side's skipped tests (count and names), and says `agree` or
# `DIFFERS`; a file named by `--flaky` (the known-load-flake list) that differs is re-run alone on both sides once, and
# that answer counts. Exit 0 when every file agrees, 1 when one differs or a leg could not run, 2 on a usage error.
#
# WHY JUNIT, NOT JSON (D-7561). The box's runner adds its own JSON reporter with `--outputFile.json=` in the run's
# directory (agent/src/testbox/spec.ts#reporterArgv), and vitest writes every JSON reporter to that file, so a JSON
# reporter of the session's never reaches stdout on the box; junit on stdout carries per-test skips on both sides.
#
# AN OPERATOR TOOL, NOT A SESSION DOOR. The session hook routes sessions to `ccrc test`, whose remote arm obeys the
# switch; nothing routes a session here. It writes only its own temporary directory and the worktrees it adds (removed
# before it exits), with the five git location variables scrubbed.
set -uo pipefail

TP_HERE="${BASH_SOURCE[0]}"
[[ "$TP_HERE" == */* ]] || TP_HERE="./$TP_HERE"
TP_HERE="$(cd "${TP_HERE%/*}" && pwd)"
TP_CLIENT="${TP_HERE%/*}/agent/dist/agent/src/testbox/client.js"
PROG="testbox-parity"

_tp_usage() {
  echo "$PROG: $*" >&2
  echo "usage: testbox-parity [--repo <path>] [--package <dir>] [--workers <n>] [--flaky <file>]... [--recent <n>] [--fixtures] [--record <file> ...] (--pr <n> | --rev <commit>)... -- <command> [<arg>...]" >&2
  exit 2
}
# `gh`, or the stand-in a test names (TP_GH): the tool never reaches GitHub in its own tests.
_tp_gh() { if [ -n "${TP_GH:-}" ]; then "$TP_GH" "$@"; else gh "$@"; fi; }
_tp_git() { env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_COMMON_DIR -u GIT_OBJECT_DIRECTORY git "$@"; }

repo="$PWD" pkg=server workers=2
revs=() flaky=() recent=0 fixtures=0 record="" repo_name="" rec_release="" rec_tools="" rec_fp="" rec_sha=""
while [ $# -gt 0 ]; do
  case "$1" in
    --repo) [ $# -ge 2 ] || _tp_usage "--repo takes a path"; repo="$2"; shift 2 ;;
    --package) [ $# -ge 2 ] || _tp_usage "--package takes a directory"; pkg="$2"; shift 2 ;;
    --workers) [[ "${2:-}" =~ ^[1-9][0-9]?$ ]] || _tp_usage "--workers takes 1 to 99"; workers="$2"; shift 2 ;;
    --flaky) [ $# -ge 2 ] || _tp_usage "--flaky takes a file"; flaky+=("$2"); shift 2 ;;
    --pr) [[ "${2:-}" =~ ^[1-9][0-9]*$ ]] || _tp_usage "--pr takes a number"; revs+=("pr:$2"); shift 2 ;;
    --rev) [ $# -ge 2 ] || _tp_usage "--rev takes a commit"; revs+=("rev:$2"); shift 2 ;;
    --recent) [[ "${2:-}" =~ ^[1-9][0-9]?$ ]] && [ "$2" -le 20 ] || _tp_usage "--recent takes 1 to 20"; recent="$2"; shift 2 ;;
    --fixtures) fixtures=1; shift ;;
    --record) [ $# -ge 2 ] || _tp_usage "--record takes a file"; record="$2"; shift 2 ;;
    --repo-name) [[ "${2:-}" =~ ^[a-z0-9][a-z0-9._-]{0,63}$ ]] || _tp_usage "--repo-name takes a repository name"; repo_name="$2"; shift 2 ;;
    --release) [[ "${2:-}" =~ ^v(0|[1-9][0-9]{0,8})\.(0|[1-9][0-9]{0,8})\.(0|[1-9][0-9]{0,8})$ ]] || _tp_usage "--release takes a release tag"; rec_release="$2"; shift 2 ;;
    --tools-key) [[ "${2:-}" =~ ^[A-Za-z0-9._:+-]{1,128}$ ]] || _tp_usage "--tools-key takes a tools key"; rec_tools="$2"; shift 2 ;;
    --fingerprint) [[ "${2:-}" =~ ^SHA256:[A-Za-z0-9+/]{43}$ ]] || _tp_usage "--fingerprint takes a SHA256 fingerprint"; rec_fp="$2"; shift 2 ;;
    --box-sha256) [[ "${2:-}" =~ ^[0-9a-f]{64}$ ]] || _tp_usage "--box-sha256 takes a sha256"; rec_sha="$2"; shift 2 ;;
    --) shift; break ;;
    *) _tp_usage "unknown argument: $1" ;;
  esac
done
[ $# -gt 0 ] || _tp_usage "missing command"
[ ${#revs[@]} -gt 0 ] || [ "$recent" -gt 0 ] || _tp_usage "name at least one --pr or --rev, or --recent"
if [ -n "$record" ]; then
  [ -n "$repo_name" ] && [ -n "$rec_release" ] && [ -n "$rec_tools" ] && [ -n "$rec_fp" ] && [ -n "$rec_sha" ] \
    || _tp_usage "--record needs --repo-name, --release, --tools-key, --fingerprint and --box-sha256"
fi
[ -f "$TP_CLIENT" ] || { echo "$PROG: no test box client at $TP_CLIENT (build agent/ first)" >&2; exit 1; }
cmd=("$@" --reporter=junit "--maxWorkers=$workers")

TP_TMP=$(mktemp -d "${TMPDIR:-/tmp}/testbox-parity.XXXXXX") || { echo "$PROG: no temporary directory" >&2; exit 1; }
TP_WTS=()
_tp_cleanup() {
  local w
  for w in ${TP_WTS[@]+"${TP_WTS[@]}"}; do _tp_git -C "$repo" worktree remove --force "$w" >/dev/null 2>&1 || rm -rf -- "$w"; done
  rm -rf -- "$TP_TMP"
}
trap _tp_cleanup EXIT

# The per-file comparison of two junit outputs: `<file>\t<local>\t<box>\t<local skipped>\t<box skipped>\t<verdict>`.
TP_COMPARE='
const fs = require("fs");
const read = (f) => {
  const out = new Map();
  const text = fs.existsSync(f) ? fs.readFileSync(f, "utf8") : "";
  for (const m of text.matchAll(/<testcase\b([^>]*?)(\/>|>([\s\S]*?)<\/testcase>)/g)) {
    const attr = (k) => (new RegExp(`\\b${k}="([^"]*)"`).exec(m[1]) || [])[1] || "";
    const file = attr("classname"), name = attr("name"), body = m[3] || "";
    const e = out.get(file) || { fail: false, skipped: [] };
    if (/<(failure|error)\b/.test(body)) e.fail = true;
    if (/<skipped\b/.test(body)) e.skipped.push(name);
    out.set(file, e);
  }
  return out;
};
// `node -e <script> <a> <b>`: the two files are argv[1] and argv[2].
const [a, b] = [read(process.argv[1]), read(process.argv[2])];
let differ = 0;
for (const f of [...new Set([...a.keys(), ...b.keys()])].sort()) {
  const x = a.get(f), y = b.get(f);
  const word = (e) => (e === undefined ? "absent" : e.fail ? "fail" : "pass");
  const sk = (e) => (e === undefined ? "-" : `${e.skipped.length}${e.skipped.length ? " (" + e.skipped.sort().join(", ") + ")" : ""}`);
  const same = word(x) === word(y) && sk(x) === sk(y);
  if (!same) differ++;
  process.stdout.write(`${f}\t${word(x)}\t${word(y)}\t${sk(x)}\t${sk(y)}\t${same ? "agree" : "DIFFERS"}\n`);
}
process.exit(differ === 0 ? 0 : 1);
'

# One leg's junit, from its stdout: the <testsuites> document alone.
_tp_junit() { awk '/<testsuites/{on=1} on{print} /<\/testsuites>/{on=0}' "$1"; }

_tp_legs() {   # <worktree> <tag> <command>... -> $TP_TMP/<tag>.local.xml and .box.xml; 1 when a leg could not run
  local wt="$1" tag="$2" v="" id="" text="" rc=0
  shift 2
  ( cd "$wt/$pkg" && bash "$TP_HERE/ccrc-test" --local -- "$@" ) > "$TP_TMP/$tag.local.out" 2> "$TP_TMP/$tag.local.err" || :
  ( cd "$wt/$pkg" && node "$TP_CLIENT" run --verdict "$TP_TMP/$tag.verdict" -- "$@" ) > "$TP_TMP/$tag.box.out" 2> "$TP_TMP/$tag.box.err" || :
  [ ! -f "$TP_TMP/$tag.verdict" ] || IFS=$'\t' read -r v id text < "$TP_TMP/$tag.verdict"
  if [ "$v" != remote ]; then
    echo "$PROG: $tag: the box leg did not run on the box (${text:-no verdict})" >&2; rc=1
  fi
  _tp_junit "$TP_TMP/$tag.local.out" > "$TP_TMP/$tag.local.xml"
  _tp_junit "$TP_TMP/$tag.box.out" > "$TP_TMP/$tag.box.xml"
  return "$rc"
}

_tp_compare() { node -e "$TP_COMPARE" "$1" "$2"; }

total=0
rec_prs=()   # "<number> <rev>" of every pull request leg that resolved
fx_names=() fx_results=()

# --recent: the n most recent merged pull requests, number and merge commit, as `prr:<number>:<oid>` legs.
if [ "$recent" -gt 0 ]; then
  listed=$(cd "$repo" && _tp_gh pr list --state merged --limit "$recent" --json number,mergeCommit 2>/dev/null \
    | node -e 'let s="";process.stdin.on("data",c=>s+=c).on("end",()=>{try{for(const p of JSON.parse(s)){const o=p&&p.mergeCommit&&p.mergeCommit.oid;if(Number.isSafeInteger(p.number)&&p.number>0&&typeof o==="string"&&/^[0-9a-f]{40,64}$/.test(o))process.stdout.write(p.number+" "+o+"\n")}}catch{}})') || listed=""
  if [ -z "$listed" ]; then
    echo "$PROG: no merged pull request was listed (is gh signed in, and does the repository have any?)" >&2; total=$((total + 1))
  else
    while read -r n oid; do [ -z "$n" ] || revs+=("prr:$n:$oid"); done <<<"$listed"
  fi
fi

# --fixtures: test box spec §6's three fixtures. Each is a vitest file whose test prints `TP|<name>|<fact>` lines; both sides run
# it (the same command, the same worker count) and the lines must be byte-identical. Run in a worktree already installed.
_tp_fixture_src() {   # <name> -> the file's text
  case "$1" in
    git-state) cat <<'EOF'
import { it } from 'vitest';
import { execFileSync } from 'node:child_process';
const g = (...a) => { try { return execFileSync('git', a, { encoding: 'utf8' }).trim(); } catch { return 'error'; } };
const say = (k, v) => { for (const l of String(v).split('\n')) console.log('TP|git-state|' + k + '|' + l); };
it('git state', () => {
  const base = g('merge-base', 'origin/main', 'HEAD');
  say('head', g('rev-parse', 'HEAD'));
  say('branch', g('rev-parse', '--abbrev-ref', 'HEAD'));
  say('origin-main', g('rev-parse', 'origin/main'));
  say('merge-base', base);
  say('changed', g('diff', '--name-only', base, 'HEAD'));
  say('ahead', g('rev-list', '--count', base + '..HEAD'));
  say('status', g('status', '--porcelain'));
});
EOF
    ;;
    socket) cat <<'EOF'
import { it } from 'vitest';
import net from 'node:net';
import os from 'node:os';
import fs from 'node:fs';
import path from 'node:path';
const bind = (p) => new Promise((res) => {
  const s = net.createServer();
  s.once('error', () => res('fail'));
  s.listen(p, () => s.close(() => { try { fs.unlinkSync(p); } catch {} res('ok'); }));
});
const pad = (dir, stem) => dir + '/' + stem + 'x'.repeat(Math.max(0, 100 - dir.length - 1 - stem.length));
it('long unix socket names', async () => {
  const under = fs.mkdtempSync(path.join(os.tmpdir(), 'tp-'));
  console.log('TP|socket|tmpdir|' + await bind(pad(under, 'live.sock-')));
  console.log('TP|socket|tmp|' + await bind(pad('/tmp', 'dlgt-' + process.pid + '-')));
  fs.rmSync(under, { recursive: true, force: true });
});
EOF
    ;;
    workers) cat <<'EOF'
import { it } from 'vitest';
it('resolved worker count', () => {
  const c = globalThis.__vitest_worker__?.config ?? {};
  console.log('TP|workers|max|' + String(c.maxWorkers ?? c.poolOptions?.threads?.maxThreads ?? c.poolOptions?.forks?.maxForks ?? 'unknown'));
});
EOF
    ;;
  esac
}
_tp_fixture() {   # <worktree> <name> <command>... -> 0 iff both sides ran and printed the same lines, at least one
  local wt="$1" name="$2" f="testbox-parity-fixture-$2.test.mjs" cfg="testbox-parity-fixture.config.mjs" tag="fx-$2" ok=0
  shift 2
  _tp_fixture_src "$name" > "$wt/$pkg/$f"
  # The package's own vitest config only includes its own test directory (and extension), so a fixture beside it would
  # match nothing and vitest would exit with "No test files found". The fixture runs under a config of its own that
  # includes exactly the fixture files at the package root.
  printf "export default { test: { include: ['testbox-parity-fixture-*.test.mjs'] } };\n" > "$wt/$pkg/$cfg"
  if _tp_legs "$wt" "$tag" "$@" --config "$cfg" "$f"; then
    grep '^TP|' "$TP_TMP/$tag.local.out" > "$TP_TMP/$tag.local.lines" 2>/dev/null || :
    grep '^TP|' "$TP_TMP/$tag.box.out" > "$TP_TMP/$tag.box.lines" 2>/dev/null || :
    [ -s "$TP_TMP/$tag.local.lines" ] && cmp -s "$TP_TMP/$tag.local.lines" "$TP_TMP/$tag.box.lines" && ok=1
  fi
  rm -f -- "${wt:?}/${pkg:?}/${f:?}" "${wt:?}/${pkg:?}/${cfg:?}"
  fx_names+=("$name")
  if [ "$ok" = 1 ]; then fx_results+=(pass); printf 'fixture %s: byte-identical on both sides\n' "$name"
  else
    fx_results+=(fail); printf 'fixture %s: DIFFERS (or a leg could not run)\n' "$name"; total=$((total + 1))
    # What each side printed, so a difference names itself (no `TP|` line on a side: that leg's last stderr lines).
    local side
    for side in local box; do
      if [ -s "$TP_TMP/$tag.$side.lines" ]; then sed "s/^/$PROG: fixture $name: $side: /" "$TP_TMP/$tag.$side.lines" >&2
      else
        echo "$PROG: fixture $name: $side: no TP line" >&2
        tail -n 15 "$TP_TMP/$tag.$side.err" 2>/dev/null | sed "s/^/$PROG: fixture $name: $side stderr: /" >&2 || :
      fi
    done
  fi
}

fixtures_done=0
for r in ${revs[@]+"${revs[@]}"}; do
  rev="${r#*:}" num=""
  case "${r%%:*}" in
    pr)
      num="${r#pr:}"
      rev=$(cd "$repo" && _tp_gh pr view "$num" --json mergeCommit -q .mergeCommit.oid 2>/dev/null) && [ -n "$rev" ] \
        || { echo "$PROG: PR #$num: no merge commit (is it merged?)" >&2; total=$((total + 1)); continue; } ;;
    prr) num="${r#prr:}"; num="${num%%:*}"; rev="${r##*:}" ;;
  esac
  tag="r${#TP_WTS[@]}"
  wt="$TP_TMP/wt-$tag"
  _tp_git -C "$repo" worktree add --detach --quiet "$wt" "$rev" >/dev/null 2>&1 \
    || { echo "$PROG: $rev: cannot add a worktree" >&2; total=$((total + 1)); continue; }
  TP_WTS+=("$wt")
  # The lockfile install, per package (spec §2.4's parity reference; spec §6).
  for lock in "$wt"/*/package-lock.json; do
    [ -f "$lock" ] || continue
    ( cd "${lock%/*}" && npm ci --no-audit --no-fund ) > "$TP_TMP/$tag.install" 2>&1 \
      || { echo "$PROG: $rev: npm ci in ${lock%/*} failed" >&2; total=$((total + 1)); continue 2; }
  done
  echo "== $rev"
  [ -z "$num" ] || rec_prs+=("$num $rev")
  _tp_legs "$wt" "$tag" "${cmd[@]}" || total=$((total + 1))
  _tp_compare "$TP_TMP/$tag.local.xml" "$TP_TMP/$tag.box.xml" > "$TP_TMP/$tag.cmp"
  while IFS=$'\t' read -r f a b sa sb word; do
    if [ "$word" = DIFFERS ]; then
      for k in ${flaky[@]+"${flaky[@]}"}; do
        [ "$k" = "$f" ] || continue
        # A known-load flake: re-run alone on both sides, once; that answer counts.
        if _tp_legs "$wt" "$tag.alone" "$@" "$f" --reporter=junit "--maxWorkers=$workers" \
          && _tp_compare "$TP_TMP/$tag.alone.local.xml" "$TP_TMP/$tag.alone.box.xml" > "$TP_TMP/$tag.alone.cmp"; then
          word="agree (re-run alone)"
        fi
      done
    fi
    [ "$word" = DIFFERS ] && total=$((total + 1))
    printf '%s: local %s, box %s; skipped local %s, box %s; %s\n' "$f" "$a" "$b" "$sa" "$sb" "$word"
  done < "$TP_TMP/$tag.cmp"
  # The fixtures run once, in the first worktree that installed.
  if [ "$fixtures" = 1 ] && [ "$fixtures_done" = 0 ]; then
    fixtures_done=1
    for fx in git-state socket workers; do _tp_fixture "$wt" "$fx" "$@" --reporter=verbose "--maxWorkers=$workers"; done
  fi
done
if [ "$fixtures" = 1 ] && [ "$fixtures_done" = 0 ]; then
  echo "$PROG: no worktree installed, so the fixtures did not run" >&2; total=$((total + 1))
  for fx in git-state socket workers; do fx_names+=("$fx"); fx_results+=(fail); done
fi

# The record: the result, the legs' pull requests and revisions, the fixtures, and the caller's measurements.
if [ -n "$record" ]; then
  rtmp="$record.tmp.$$"
  verdict=pass; [ "$total" -eq 0 ] || verdict=fail
  { printf 'R\t%s\t%s\t%s\t%s\t%s\t%s\n' "$verdict" "$repo_name" "$rec_release" "$rec_tools" "$rec_fp" "$rec_sha"
    for p in ${rec_prs[@]+"${rec_prs[@]}"}; do printf 'P\t%s\n' "${p/ /$'\t'}"; done
    i=0; for fx in ${fx_names[@]+"${fx_names[@]}"}; do printf 'F\t%s\t%s\n' "$fx" "${fx_results[$i]}"; i=$((i + 1)); done
  } | node -e '
let s = "";
process.stdin.on("data", (c) => (s += c)).on("end", () => {
  const rows = s.split("\n").filter(Boolean).map((l) => l.split("\t"));
  const [, result, repo, release, toolsKey, fingerprint, boxFileSha256] = rows.find((r) => r[0] === "R");
  process.stdout.write(JSON.stringify({
    v: 1, result,
    prs: rows.filter((r) => r[0] === "P").map((r) => ({ repo, number: Number(r[1]), rev: r[2] })),
    fixtures: rows.filter((r) => r[0] === "F").map((r) => ({ name: r[1], result: r[2] })),
    release, toolsKey, fingerprint, boxFileSha256, at: Date.now(),
  }) + "\n");
});' > "$TP_TMP/record.json" \
    && ( umask 077; cp -- "$TP_TMP/record.json" "$rtmp" ) && chmod 600 "$rtmp" && mv -f -- "$rtmp" "$record" \
    || { rm -f -- "${rtmp:?}"; echo "$PROG: cannot write $record" >&2; exit 1; }
fi
if [ "$total" -eq 0 ]; then echo "parity: every file agrees"; exit 0; fi
echo "parity: $total disagreement(s) or leg(s) that could not run"
exit 1
