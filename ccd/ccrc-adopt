#!/usr/bin/env bash
# ccrc-adopt — rediscovers a hand-built box's Claude Code accounts FROM DISK
# and writes ~/.ccrc/accounts.json. Task 11 of the stage-2a
# roster-becomes-data plan, and the last one: it runs against a codebase
# where the roster is already the only source of truth (Tasks 1-10), so it
# exists purely to bootstrap that file on a box nobody generated one for yet
# — every account here was hand-built with `touch`/`vi`, long before
# `~/.ccrc/accounts.json` existed as a concept.
#
# SCOPE, deliberately narrow: this writes accounts.json and NOTHING else. No
# wrappers, no systemd units, no hooks, no config. `ccrc install` (not written
# yet — see ccd:71) is the verb that goes the other direction, roster -> disk;
# this one only ever goes disk -> roster.
#
# ── WHAT IT LOOKS AT ─────────────────────────────────────────────────────
# Every entry directly under $HOME/.local/bin whose name is a legal account id
# (shared/roster.ts's ID_RE: ^[a-z][a-z0-9-]{0,31}$ — this alone drops the
# ccd.bak-<date> / claude2.bak-<date> backups this box accumulates, since a
# dot never appears in a real id).
#
#   - A file that some OTHER candidate `exec`s and that does NOT set its own
#     CLAUDE_CONFIG_DIR -> the upstream account (shared/roster.ts's exec.kind
#     "upstream"). Its config dir is "$HOME/.claude" — that default lives in
#     the claude binary itself, not in anything this script reads, because
#     upstream is by definition invoked with CLAUDE_CONFIG_DIR unset.
#
#     THE UPSTREAM MAY BE A SCRIPT (D-155). It was required to be a non-script
#     until 2026-08-20, when this box's own `~/.local/bin/claude` stopped being
#     the installer's symlink into ~/.local/share/claude/versions/<ver> and
#     became a launcher that picks a version and injects the upstream account's
#     token before exec'ing it. "Not a script" was only ever a proxy for "not
#     an account wrapper", and the two parted company that day; the gate at
#     pass 3 now asks the real question. An npm- or mise-installed Claude Code
#     puts a `#!` shim at the same path, so this is not one box's quirk.
#   - A script whose content, once blank lines and comments are stripped, is
#     BYTE-FOR-BYTE the known 2- or 3-line generated shape -> "generated",
#     with configDirSuffix and (if present) secretsFile read back out of it.
#   - Any other script that sets CLAUDE_CONFIG_DIR -> "external". ccrc never
#     writes this file; a later `ccrc install` must not either.
#
# The direction of every uncertain call is "external" — see classify() below
# for why that is the only safe default: mis-reading a bespoke launcher as
# "generated" is the one mistake in this whole file that a future `ccrc
# install` could turn into data loss (overwriting someone's hand-written
# script with a 4-line template). Mis-reading a real generated wrapper as
# "external" only costs an account its `secretsFile` auto-detection — visible
# immediately (the account gets a `[ -r ...]` line no one manages) and fixed
# by hand.
#
# ── WHAT IT NEVER DOES ──────────────────────────────────────────────────
# It never reads a candidate whole. Classification looks at a candidate's first
# two bytes (script vs. binary) and then at its SIZE before deciding whether to
# read it as text at all, so only actual small scripts get `read`. Both bounds
# are load-bearing and neither subsumes the other: the two-byte test is what
# keeps a 300+ MB binary from being read, and the size test (D-155,
# WRAPPER_OVERSIZE_BYTES) is what keeps a large SCRIPT from being read — a case
# that only became reachable at the upstream path once a script was allowed to
# hold it.
#
# It also never writes to $HOME/.local/bin — every path below is read-only
# until the very last step, which is the one write this tool is allowed:
# accounts.json, and only when it does not already exist (or --force says to
# overwrite it).
set -euo pipefail
# Locale-independent byte ordering for glob expansion, `sort` and regex
# matching: en_US.UTF-8's collation (measured on this box) sorts
# "claude-corp" AFTER "claude2" — punctuation is collated differently from
# digits — so without this, the declaration order of the accounts below (and
# therefore their hue assignment, which is positional) would silently depend
# on the operator's locale rather than on the bytes in $HOME/.local/bin.
export LC_ALL=C

PROG=ccrc-adopt
HUES=(cyan violet blue magenta amber green)

# ── the wrapper contract, sourced rather than restated ────────────────────
# `ccd/ccrc-wrapper-shape` holds what USED to be four things in this file:
# `ID_RE`, `SUFFIX_SAFE_RE`, `is_script`/`first_two_bytes`, `parse_shape` and
# the engine inside `cross_check`. They moved because `ccrc doctor`'s
# `_check_wrappers` asks the same questions from the other end (roster vs disk,
# rather than disk -> roster), and a second copy of the wrapper shape is exactly
# how a checker and a generator drift into agreeing with each other about a
# shape neither tool writes. Nothing was rewritten in the move.
#
# `${BASH_SOURCE[0]}` and not `$0`/`$HERE`: those are computed further down and
# `dirname` is a PATH lookup, while this has to work before anything else does.
# The `*/*` guard covers `bash ccrc-adopt` from inside ccd/, where BASH_SOURCE
# carries no directory at all and `%/*` would strip nothing.
_ADOPT_SELF="${BASH_SOURCE[0]}"
[[ "$_ADOPT_SELF" == */* ]] || _ADOPT_SELF="./$_ADOPT_SELF"
if ! . "${_ADOPT_SELF%/*}/ccrc-wrapper-shape"; then
  echo "$PROG: cannot load ${_ADOPT_SELF%/*}/ccrc-wrapper-shape — it ships beside this script and holds the wrapper shape; is this a complete checkout?" >&2
  exit 1
fi

usage() {
  cat <<EOF
usage: $PROG [--out PATH] [--force]

Rediscovers this box's Claude Code accounts from \$HOME/.local/bin and prints
the resulting accounts.json to stdout. Writes it to PATH (default
\$HOME/.ccrc/accounts.json) unless PATH already exists, in which case it
prints the proposal and refuses to overwrite — pass --force to overwrite
anyway.
EOF
}

OUT=""
FORCE=0
while [ $# -gt 0 ]; do
  case "$1" in
    --out) OUT="${2:?--out requires a path}"; shift 2 ;;
    --out=*) OUT="${1#--out=}"; shift ;;
    --force) FORCE=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "$PROG: unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done
[ -n "$OUT" ] || OUT="$HOME/.ccrc/accounts.json"

BIN_DIR="$WRAPPER_BIN_DIR"
[ -d "$BIN_DIR" ] || { echo "$PROG: $BIN_DIR does not exist — nothing to adopt" >&2; exit 1; }

# Where deploy/gen-accounts.mjs lives relative to THIS script, not relative to
# $PWD — adopt is meant to be run as `bash ccd/ccrc-adopt` from anywhere
# inside a checkout. Used at the very end to validate this script's own
# output (see the "SELF-VALIDATION" section) rather than re-implementing
# parseRoster's rules a third time (shared/roster.ts is #1, gen-accounts.mjs
# is #2 — see that file's header for why a bare interpreter can't import the
# TypeScript directly).
#
# A CHECKOUT IS NO LONGER THE ONLY PLACE THIS RESOLVES (Task 8). `ccrc adopt`
# execs this script where it ships, `~/ccrc/ccd/ccrc-adopt`, so the sibling it
# needs is `~/ccrc/deploy/gen-accounts.mjs` — and BOTH deploy lanes rsync
# `deploy` into `~/ccrc/`, so that path exists on the server box as well as on
# the fleet host. One relative path, correct in both worlds; no `$HOME`-rooted
# fallback to disagree with it. The refusal below therefore names both places
# rather than asking a box that was never a checkout whether it is one.
#
# `_ADOPT_SELF`, not `$0`+`dirname`: it is already computed, at :89-90, with
# the same defensive idiom the wrapper-shape load three lines above needs —
# and for the same reason. `dirname` is an external command, a PATH lookup
# this script has no business depending on twice (once early, via
# `_ADOPT_SELF`'s pure parameter expansion, and once again here through a
# subprocess) when one bash-only computation already answers it. A `dirname`
# on PATH that lies (or is simply absent) used to send `cd` into whatever it
# printed and die with a raw shell error before ever reaching this script's
# own voice — measured, and the failure a maintainer would otherwise have to
# reproduce by hand: `ccrc-adopt: line 124: cd: <whatever dirname said>: No
# such file or directory`.
HERE="$(cd "${_ADOPT_SELF%/*}" && pwd)"
GEN_ACCOUNTS="$HERE/../deploy/gen-accounts.mjs"

# ── pass 0: candidate names — regular files (symlinks OK), executable, and
#    shaped like a legal account id. This one filter is what drops every
#    ccd.bak-<date>, ccd.pre-flip and claude2.bak-<date> this box has lying
#    around: a real id never contains ".", and none of those do without one. ─
declare -a CAND=()
shopt -s nullglob
for f in "$BIN_DIR"/*; do
  [ -f "$f" ] || continue
  [ -x "$f" ] || continue
  name="$(basename "$f")"
  [[ "$name" =~ $WRAPPER_ID_RE ]] || continue
  CAND+=("$name")
done
shopt -u nullglob

if [ "${#CAND[@]}" -eq 0 ]; then
  echo "$PROG: no id-shaped executable under $BIN_DIR — nothing to adopt" >&2
  exit 1
fi

# ── pass 0.5: drop symlink aliases of another candidate in the same
#    directory. This box's own gpt -> ccgpt is the measured case: both names
#    resolve to the identical script, so without this step adopt would
#    propose two accounts fighting over one CLAUDE_CONFIG_DIR. The symlink's
#    OWN name is kept (it is the public name an operator types); the target
#    it points at is dropped, but only when that target is ALSO one of our
#    own candidates — claude's own symlink target lives outside
#    $HOME/.local/bin entirely and is untouched by this. ──────────────────
declare -A DROPPED=()
for name in "${CAND[@]}"; do
  f="$BIN_DIR/$name"
  [ -L "$f" ] || continue
  target="$(readlink -f -- "$f" 2>/dev/null || true)"
  [ -n "$target" ] || continue
  tname="$(basename "$target")"
  [ "$tname" != "$name" ] || continue
  for other in "${CAND[@]}"; do
    if [ "$other" = "$tname" ]; then
      DROPPED["$tname"]="superseded by symlink alias \"$name\""
      break
    fi
  done
done
if [ "${#DROPPED[@]}" -gt 0 ]; then
  declare -a KEPT=()
  for name in "${CAND[@]}"; do
    if [ -n "${DROPPED[$name]:-}" ]; then
      echo "$PROG: note: \"$name\" is $BIN_DIR/$name's own file, but another candidate symlinks straight to it — treating it as an implementation detail, not a second account (${DROPPED[$name]})" >&2
      continue
    fi
    KEPT+=("$name")
  done
  CAND=("${KEPT[@]}")
fi

# ── pass 1: which candidates set CLAUDE_CONFIG_DIR at all? Only scripts can
#    (a 300 MB ELF cannot contain a meaningful shell assignment we'd want to
#    trust), so `_wrap_is_script` gates the scan — the binary it rejects never
#    gets read a second time. Both halves live in ccrc-wrapper-shape, so
#    `ccrc doctor` decides what counts as an account wrapper by running THIS
#    code rather than by carrying its own opinion of it.
#
#    D-155: SIZED BEFORE IT IS READ. `_wrap_is_script` stops at two bytes, but
#    `_wrap_declares_config_dir` reads whatever it is handed WHOLE, so a
#    multi-megabyte script in this directory was read end to end on every run —
#    `ccd` itself is 608 KB and `clickhousectl` is 17 MB, so the shape is not
#    hypothetical, only lucky. The skip is ANNOUNCED rather than silent: a
#    candidate dropped here would otherwise be indistinguishable from one that
#    simply declares no config dir, and those are two different facts about the
#    box that an operator resolves differently. ────────────────────────────
declare -a CFG_SCRIPTS=()
for name in "${CAND[@]}"; do
  f="$BIN_DIR/$name"
  _wrap_is_script "$f" || continue
  sz="$(stat -L -c%s -- "$f" 2>/dev/null || echo '')"
  # TWO CONDITIONS, TWO SENTENCES. Both end in the same skip, and folding them
  # into one test was a defect measured before it shipped: a box whose `stat`
  # does not take `-c%s` — every BSD-flavoured one — was told its 102-byte
  # wrappers were "over 1 MiB", and then that nothing here sets
  # CLAUDE_CONFIG_DIR at all. Same skip, different fact, different fix, so they
  # get different words; that is this codebase's no-overloaded-null rule
  # applied to a message rather than to a return value.
  if [ -z "$sz" ] || ! [[ "$sz" =~ ^[0-9]+$ ]]; then
    echo "$PROG: note: \"$name\" is a script whose size this box's stat would not report, so classifying it would need an unbounded read — skipped, and not proposed as an account (check: stat -L -c%s \"$f\")" >&2
    continue
  fi
  if [ "$sz" -gt "$WRAPPER_OVERSIZE_BYTES" ]; then
    echo "$PROG: note: \"$name\" is a script of $sz bytes — over $WRAPPER_OVERSIZE_BYTES is too big to be an account wrapper, so it was not read and is not proposed as an account" >&2
    continue
  fi
  _wrap_declares_config_dir "$f" && CFG_SCRIPTS+=("$name")
done

if [ "${#CFG_SCRIPTS[@]}" -eq 0 ]; then
  echo "$PROG: no script under $BIN_DIR sets CLAUDE_CONFIG_DIR — nothing to adopt" >&2
  exit 1
fi

# ── pass 2: parse the generated SHAPE of every CLAUDE_CONFIG_DIR script.
#    `_wrap_parse_shape` (ccd/ccrc-wrapper-shape) is the shape contract, and it
#    lives there rather than here because `ccrc doctor`'s `_check_wrappers`
#    tests the same shape from the other end — see that file's header for what
#    the function guarantees and why it reconstructs each line instead of
#    capturing it with a regex.
#
#    It is target-agnostic on purpose: the exec line's TARGET is captured but
#    not yet judged, which happens once every script has been parsed and the
#    votes are in (pass 3). A script with the right shape but the wrong target
#    (a bespoke launcher that also happens to end
#    `exec "$HOME/.local/bin/<something-else>" "$@"`) must never get a vote for
#    the WRONG binary, which is what resolving the target before consensus
#    exists would risk. ────────────────────────────────────────────────────

# `export CLAUDE_CONFIG_DIR="$HOME/<suffix>"` value regardless of whether the
# rest of the file matches the generated shape — every external account still
# needs a configDirSuffix in its roster entry, and this is the one field a
# bespoke script genuinely does declare in the open, in exactly this shape,
# even when nothing else about the file is generated (measured: gpt does).
extract_suffix_loose() {
  local f="$1" ln
  local exp_prefix='export CLAUDE_CONFIG_DIR="$HOME/'
  while IFS= read -r ln; do
    if [[ "$ln" == "$exp_prefix"*'"'* ]]; then
      local rest="${ln#"$exp_prefix"}"
      # Same "/" vs "." boundary as _wrap_parse_shape: rest already starts with
      # the suffix's own leading ".".
      printf '%s' "${rest%%\"*}"
      return
    fi
  done < "$f"
}

# Parse every CLAUDE_CONFIG_DIR script exactly once, target-agnostic, and
# cache the result — pass 3 (voting) and pass 4 (final classification) both
# read this cache rather than re-parsing.
mapfile -t REST < <(printf '%s\n' "${CFG_SCRIPTS[@]}" | sort)
declare -A SHAPE_OK=() SHAPE_TARGET=() SHAPE_SUFFIX=() SHAPE_SECRETS=()
for name in "${REST[@]}"; do
  # D-71 (plan) bans `IFS=$'\t' read` for any tab-delimited record that can
  # carry an empty field — a tab is IFS whitespace, so bash collapses runs of
  # them and every later field shifts left. This call is SAFE, and the reason
  # is in ccd/ccrc-wrapper-shape rather than here: `_wrap_parse_shape` answers
  # `ok` only once `target` matched WRAPPER_ID_RE and `suffix` matched
  # WRAPPER_SUFFIX_SAFE_RE, neither of which accepts empty, so `secrets` — the
  # LAST field — is the only one that can be, and a trailing empty field is
  # exactly the case `read` gets right. (A `no` answer is `no` plus three empty
  # fields; the cache below stores them all, and every later read of
  # SHAPE_TARGET/SUFFIX/SECRETS is gated on `SHAPE_OK = ok` first — :312, :423,
  # :427.) RELAXING EITHER REGEX, OR ADDING A FIFTH FIELD BEFORE
  # `secrets`, breaks this silently: adopt would cache a secrets path taken
  # from the wrong column and write it into the roster. Split by hand if that
  # day comes, the way `_check_wrappers`'s roster reader does.
  IFS=$'\t' read -r ok target suffix secrets < <(_wrap_parse_shape "$BIN_DIR/$name")
  SHAPE_OK["$name"]="$ok"
  SHAPE_TARGET["$name"]="$target"
  SHAPE_SUFFIX["$name"]="$suffix"
  SHAPE_SECRETS["$name"]="$secrets"
done

# ── pass 3: the upstream account. Only scripts whose shape ALREADY matched
#    structurally (pass 2) cast a vote — a bespoke launcher whose unrelated
#    final line happens to read `exec "$HOME/.local/bin/<x>" "$@"` never
#    gets this far, because its body is not 2-3 significant lines to begin
#    with (gpt's real 142-line body is nowhere close). The target with the
#    most votes wins; a tie is genuinely ambiguous and adopt refuses to
#    guess rather than pick one arbitrarily. ────────────────────────────────
declare -A UPSTREAM_VOTES=()
declare -A UPSTREAM_VOTERS=()
for name in "${REST[@]}"; do
  [ "${SHAPE_OK[$name]}" = ok ] || continue
  target="${SHAPE_TARGET[$name]}"
  UPSTREAM_VOTES["$target"]=$(( ${UPSTREAM_VOTES[$target]:-0} + 1 ))
  UPSTREAM_VOTERS["$target"]="${UPSTREAM_VOTERS[$target]:-} $name"
done

if [ "${#UPSTREAM_VOTES[@]}" -eq 0 ]; then
  echo "$PROG: no CLAUDE_CONFIG_DIR script has the generated shape (export + optional secrets + exec) — cannot find the upstream account; adopt this box by hand" >&2
  exit 1
fi
UPSTREAM_ID=""
best=-1
tied=0
for target in "${!UPSTREAM_VOTES[@]}"; do
  v="${UPSTREAM_VOTES[$target]}"
  if [ "$v" -gt "$best" ]; then best="$v"; UPSTREAM_ID="$target"; tied=0;
  elif [ "$v" -eq "$best" ]; then tied=$((tied + 1)); fi
done
if [ "$tied" -gt 0 ]; then
  echo "$PROG: ambiguous upstream — wrapper scripts are evenly split between different binaries (${!UPSTREAM_VOTES[*]}); refusing to guess" >&2
  exit 1
fi
UPSTREAM_PATH="$BIN_DIR/$UPSTREAM_ID"

if [ ! -e "$UPSTREAM_PATH" ]; then
  echo "$PROG: $UPSTREAM_ID is exec'd by${UPSTREAM_VOTERS[$UPSTREAM_ID]} but $UPSTREAM_PATH does not exist" >&2
  exit 1
fi
# D-155: THE ELECTED UPSTREAM MUST NOT BE AN ACCOUNT WRAPPER — which is not
# the same question as "is it a script", though it was spelled that way until
# now.
#
# What this gate exists to stop is a CYCLE: electing a file that the voters
# would then be exec'ing as their upstream while it, in turn, sets its own
# CLAUDE_CONFIG_DIR and execs onward. `#!` was a proxy for that, and it held
# only while the binary path was guaranteed to be the binary. It stopped
# holding on 2026-08-20, when this box's `~/.local/bin/claude` became a 2.7 KB
# LAUNCHER — a script that picks which installed version to run and injects the
# upstream account's token before exec'ing the real binary out of
# `~/.local/share/claude/versions/`. That file is the binary path in every
# sense that matters here: nothing about it is an account, and it declares no
# config dir. The old gate refused it, exit 1, writing nothing — and since
# `ccrc adopt` is the remedy four `_check_wrappers` FAILs name, the entire
# re-bootstrap path terminated in a refusal. It is not a local quirk either: an
# npm- or mise-installed Claude Code lands a `#!` shim at the same path.
#
# So the question is asked directly of the elected file's own bytes.
#
# DIRECTLY, and not by testing the winner for membership of `CFG_SCRIPTS`:
# those two are NOT equivalent, and the difference is a cycle adopted in
# silence. `CFG_SCRIPTS` encodes pass 0's filters as well as this question — a
# textbook account wrapper parked here whose only anomaly is mode 0644 is
# dropped by pass 0 for want of `-x`, so it is in no list, and a membership
# test would call it "not a wrapper" and adopt it. Reading its bytes gets it
# right. (`server/test/adopt.test.ts` pins exactly that case.) `set -euo
# pipefail` is the second reason: a bare lookup of a missing associative key is
# fatal here, so the membership spelling could not even be written plainly.
#
# THE RESIDUAL, stated rather than hidden: `_wrap_declares_config_dir` is one
# line-wise regex, so the two-statement form (`CLAUDE_CONFIG_DIR=...` on one
# line, `export CLAUDE_CONFIG_DIR` on the next) does not match it, and a cycle
# built that way would be adopted at exit 0. The old gate did not detect that
# case either — it refused it by accident, along with every legitimate box.
# Trading an accidental refusal of everything for a precise refusal with one
# known hole is the deliberate call here, not an oversight.
UPSTREAM_SIZE="$(stat -L -c%s -- "$UPSTREAM_PATH" 2>/dev/null || echo '')"
UPSTREAM_SHAPE=binary
if _wrap_is_script "$UPSTREAM_PATH"; then
  UPSTREAM_SHAPE="launcher script"
  # BOUND THE READ BEFORE TAKING IT. `_wrap_is_script` stops at two bytes, but
  # `_wrap_declares_config_dir` reads its argument WHOLE — and until this gate
  # moved, no script ever reached it at the upstream path, because the refusal
  # above fired first. Relaxing the gate without this puts an unbounded read on
  # the one file this tool's own header promises never to read whole.
  #
  # FAILS CLOSED, unlike `ccrc-doctor-checks`'s sibling gate, and the asymmetry
  # is deliberate: doctor's job is to keep REPORTING on a box whose environment
  # is broken, so it falls back to the unbounded read rather than going blind.
  # This is a WRITE path. A file adopt could not measure is one it cannot prove
  # is not a wrapper, and "I could not tell" is not "I know what it is" — the
  # same sentence `cmd_wrappers` refuses `unreadable` under.
  if [ -z "$UPSTREAM_SIZE" ] || ! [[ "$UPSTREAM_SIZE" =~ ^[0-9]+$ ]]; then
    echo "$PROG: $UPSTREAM_ID is exec'd by${UPSTREAM_VOTERS[$UPSTREAM_ID]} as the upstream binary, and $UPSTREAM_PATH is a script whose size this box's stat would not report — proving it is not itself an account wrapper would need an unbounded read of it. Refusing to guess an upstream account (check: stat -L -c%s \"$UPSTREAM_PATH\")" >&2
    exit 1
  fi
  if [ "$UPSTREAM_SIZE" -gt "$WRAPPER_OVERSIZE_BYTES" ]; then
    echo "$PROG: $UPSTREAM_ID is exec'd by${UPSTREAM_VOTERS[$UPSTREAM_ID]} as the upstream binary, and $UPSTREAM_PATH is a script of $UPSTREAM_SIZE bytes — over $WRAPPER_OVERSIZE_BYTES is too big to classify as a wrapper, and it was not read. Refusing to guess an upstream account; move it aside or name the upstream by hand" >&2
    exit 1
  fi
  if _wrap_declares_config_dir "$UPSTREAM_PATH"; then
    echo "$PROG: $UPSTREAM_ID is exec'd by${UPSTREAM_VOTERS[$UPSTREAM_ID]} as the upstream binary, but $UPSTREAM_PATH is itself an account wrapper — it sets CLAUDE_CONFIG_DIR, so adopting it would leave those wrappers exec'ing a wrapper. Refusing to guess an upstream account" >&2
    exit 1
  fi
fi
echo "$PROG: upstream account \"$UPSTREAM_ID\" -> $UPSTREAM_PATH (${UPSTREAM_SIZE:-unmeasured} bytes, $UPSTREAM_SHAPE), exec'd by:${UPSTREAM_VOTERS[$UPSTREAM_ID]}" >&2

# ── pass 4: finalize every script's kind now that UPSTREAM_ID is settled —
#    "generated" iff its shape matched AND its target IS the winning
#    upstream; everything else, including a shape-plausible script that
#    lost the vote, is "external". ───────────────────────────────────────
declare -a IDS=() LABELS=() SUFFIXES=() KINDS=() SECRETS=()

IDS+=("$UPSTREAM_ID"); LABELS+=("$UPSTREAM_ID"); SUFFIXES+=(".claude"); KINDS+=(upstream); SECRETS+=("")
if [ ! -d "$HOME/.claude" ]; then
  echo "$PROG: note: $HOME/.claude does not exist yet — \"$UPSTREAM_ID\" has apparently never been run" >&2
fi

for name in "${REST[@]}"; do
  # Still unreachable, but for a different reason since D-155: the upstream may
  # now BE a script, so `_wrap_is_script` no longer excludes it from this loop.
  # What does is that this loop runs over `REST` (i.e. `CFG_SCRIPTS`), and the
  # gate at pass 3 refuses any elected upstream that declares a config dir — so
  # an id in this list can never be the winner. Kept defensive: the day that
  # reasoning changes, this is the line that stops a duplicate account row.
  [ "$name" = "$UPSTREAM_ID" ] && continue
  if [ "${SHAPE_OK[$name]}" = ok ] && [ "${SHAPE_TARGET[$name]}" = "$UPSTREAM_ID" ]; then
    kind=generated; suffix="${SHAPE_SUFFIX[$name]}"; secrets="${SHAPE_SECRETS[$name]}"
  else
    kind=external
    if [ "${SHAPE_OK[$name]}" = ok ]; then
      suffix="${SHAPE_SUFFIX[$name]}"
      echo "$PROG: note: \"$name\" has the generated shape but execs \"${SHAPE_TARGET[$name]}\", not the upstream \"$UPSTREAM_ID\" — kept as external" >&2
    else
      suffix="$(extract_suffix_loose "$BIN_DIR/$name")"
    fi
    secrets=""
  fi
  if [ -z "$suffix" ]; then
    echo "$PROG: \"$name\" sets CLAUDE_CONFIG_DIR in an unrecognised shape — skipping it; adopt this account by hand" >&2
    continue
  fi
  IDS+=("$name"); LABELS+=("$name"); SUFFIXES+=("$suffix"); KINDS+=("$kind"); SECRETS+=("$secrets")
done

echo "$PROG: label is id-as-written for every account below — none of these are the friendly names an operator picked (e.g. \"team·max\"), because nothing on disk records that. Edit \"label\" in $OUT by hand once it's written." >&2
echo "$PROG: homeAble and telemetry are policy defaults inferred from exec kind (upstream/generated -> true/anthropic, external -> false/none), not facts read off disk — review and edit them in $OUT too." >&2

# ── build the JSON ─────────────────────────────────────────────────────
declare -a ACCOUNT_JSON=()
n="${#IDS[@]}"
for ((i = 0; i < n; i++)); do
  hue="${HUES[$((i % ${#HUES[@]}))]}"
  case "${KINDS[$i]}" in
    upstream) exec_json='{"kind":"upstream"}'; homeAble=true; telemetry=anthropic ;;
    generated)
      if [ -n "${SECRETS[$i]}" ]; then
        exec_json="$(jq -nc --arg s "${SECRETS[$i]}" '{kind:"generated", secretsFile:$s}')"
      else
        exec_json='{"kind":"generated"}'
      fi
      homeAble=true; telemetry=anthropic
      ;;
    external) exec_json='{"kind":"external"}'; homeAble=false; telemetry=none ;;
  esac
  ACCOUNT_JSON+=("$(jq -nc \
    --arg id "${IDS[$i]}" --arg label "${LABELS[$i]}" --arg suffix "${SUFFIXES[$i]}" \
    --argjson exec "$exec_json" --argjson homeAble "$homeAble" --arg hue "$hue" --arg telemetry "$telemetry" \
    '{id:$id, label:$label, configDirSuffix:$suffix, exec:$exec, homeAble:$homeAble, hue:$hue, telemetry:$telemetry}')")
done

ROSTER_JSON="$(printf '%s\n' "${ACCOUNT_JSON[@]}" | jq -s '{version: 1, accounts: .}')"
PRETTY="$(printf '%s' "$ROSTER_JSON" | jq '.')"

if [ "${KINDS[0]}" != upstream ] || [ "${#KINDS[@]}" -eq 0 ]; then
  echo "$PROG: internal error: no upstream account in the assembled roster" >&2
  exit 1
fi
n_up=0
for k in "${KINDS[@]}"; do [ "$k" = upstream ] && n_up=$((n_up + 1)); done
if [ "$n_up" -ne 1 ]; then
  echo "$PROG: internal error: assembled $n_up upstream accounts, expected exactly 1" >&2
  exit 1
fi

# ── cross-check: report, never filter (design brief §"CLASSIFICATION
#    RULES"). Three independent sources a real account usually also shows up
#    in; disagreement is surfaced, not resolved by silently trusting one. ──
#
# The ARITHMETIC — who is in one list and not the other, in both directions —
# is `_wrap_set_diff` in ccd/ccrc-wrapper-shape, because `ccrc doctor`'s
# `_check_wrappers` is the same shape (a roster and a disk that must agree) and
# was going to be a second copy of it. The WORDING stayed here: adopt is
# talking about three sources that usually agree with its own discovery, which
# is not the sentence doctor needs, and a single message template parameterised
# far enough to say both would say neither well.
_adopt_cross_note() {
  case "$1" in
    a-only) echo "$PROG: cross-check: $ADOPT_CC_LABEL mentions \"$2\", which adopt did not discover in $BIN_DIR" >&2 ;;
    b-only) echo "$PROG: cross-check: adopt discovered \"$2\", which $ADOPT_CC_LABEL never mentions" >&2 ;;
  esac
}
ADOPT_CC_LABEL=""
cross_check() {
  ADOPT_CC_LABEL="$1"; shift
  # Named `_adopt_have`, not `have`: `_wrap_set_diff` takes its two arrays by
  # nameref, and a local whose name collides with one of its own would be a
  # circular reference bash refuses to resolve.
  local -a _adopt_have=("$@")
  _wrap_set_diff _adopt_cross_note _adopt_have IDS
}

declare -a LIMITS_IDS=()
if [ -d "$HOME/.cc-limits" ]; then
  for f in "$HOME"/.cc-limits/*.json; do
    [ -f "$f" ] || continue
    LIMITS_IDS+=("$(basename "$f" .json)")
  done
fi
cross_check '$HOME/.cc-limits/*.json' "${LIMITS_IDS[@]}"

declare -a REGISTRY_IDS=()
if [ -d "$HOME/.cc-sessions" ]; then
  # `.wrapper` files are written without a trailing newline (measured), so
  # `cat *.wrapper | sort` would run every file's content together into one
  # unsplit line — `printf '%s\n'` per file forces one line each regardless.
  mapfile -t REGISTRY_IDS < <(
    shopt -s nullglob
    for wf in "$HOME"/.cc-sessions/*.wrapper; do
      printf '%s\n' "$(cat "$wf")"
    done | sort -u
  )
fi
cross_check "the ~/.cc-sessions session registry" "${REGISTRY_IDS[@]}"

declare -a CLAUDE_DIR_SUFFIXES=()
shopt -s nullglob
for d in "$HOME"/.claude*; do
  [ -d "$d" ] || continue
  CLAUDE_DIR_SUFFIXES+=("$(basename "$d")")
done
shopt -u nullglob
for d in "${CLAUDE_DIR_SUFFIXES[@]}"; do
  found=0
  for s in "${SUFFIXES[@]}"; do [ "$s" = "$d" ] && { found=1; break; }; done
  [ "$found" -eq 1 ] || echo "$PROG: cross-check: $HOME/$d exists but no discovered account claims it as configDirSuffix" >&2
done
for s in "${SUFFIXES[@]}"; do
  found=0
  for d in "${CLAUDE_DIR_SUFFIXES[@]}"; do [ "$d" = "$s" ] && { found=1; break; }; done
  [ "$found" -eq 1 ] || echo "$PROG: cross-check: no $HOME/$s directory yet for a discovered account (never run)" >&2
done

# ── self-validation: the JSON above must parse cleanly through parseRoster
#    before adopt writes (or even offers) it. gen-accounts.mjs is used rather
#    than a third hand-rolled copy of parseRoster's rules — its own test
#    suite (server/test/gen-accounts.test.ts) pins it to accept exactly what
#    parseRoster accepts and reject everything parseRoster rejects, which
#    makes "gen-accounts.mjs is happy" a faithful proxy for "parseRoster is
#    happy" without re-deriving that proof here. ───────────────────────────
if [ ! -f "$GEN_ACCOUNTS" ]; then
  echo "$PROG: cannot self-validate: $GEN_ACCOUNTS is missing — it ships one directory up from this script, in a checkout and at ~/ccrc/deploy on a deployed box. Nothing was written." >&2
  exit 1
fi
TMP_JSON="$(mktemp)"
trap 'rm -f "$TMP_JSON"' EXIT
printf '%s' "$PRETTY" > "$TMP_JSON"
if ! GEN_ERR="$(node "$GEN_ACCOUNTS" "$TMP_JSON" 2>&1 >/dev/null)"; then
  echo "$PROG: the roster this run assembled does not parse — this is a bug in $PROG, not your box. Nothing was written." >&2
  echo "$PROG: $GEN_ERR" >&2
  exit 1
fi

# ── the one write this tool ever makes ─────────────────────────────────
printf '%s\n' "$PRETTY"

if [ -e "$OUT" ] && [ "$FORCE" -ne 1 ]; then
  echo "$PROG: $OUT already exists — printed the proposal above but did not touch it. Re-run with --force to overwrite." >&2
  exit 1
fi

mkdir -p "$(dirname "$OUT")"
TMP_OUT="$OUT.tmp.$$"
printf '%s\n' "$PRETTY" > "$TMP_OUT"
mv -f "$TMP_OUT" "$OUT"
echo "$PROG: wrote $OUT" >&2
