#!/usr/bin/env bash
# ccrc-api — the closed client for the ccrc coordination API.
#
# WHY THIS EXISTS. A repo may legitimately deny `Bash(curl:*)` and `Bash(wget:*)`
# in its committed settings, and on 2026-08-26 one did. The worker on that repo
# could not read or ack its mail at all — twelve permission denials in one wave —
# while the coordinator on the same programme kept working, because
# `resp=$(curl …)` happens to slip past that matcher. The deny rule was doing its
# job on one session and being evaded by accident on the other. Neither half of
# that is acceptable, and the fix is not to soften the deny.
#
# WHY THIS IS NOT CURL UNDER ANOTHER NAME. A repo denying curl is denying
# ARBITRARY OUTBOUND HTTP BY THE AGENT. This is not that, and the difference is
# mechanical rather than intended:
#
#   * No argument here is a URL, a host, or a path. There is no `--url`, no
#     `--host`, no `--path`, no `--raw`, and deliberately no passthrough verb.
#     Adding one would make this curl with a different name and would
#     retroactively make every install of it an evasion.
#   * The address comes from `~/.ccrc/agent.env`'s `CCRC_SERVER_URL` — config
#     this process's caller does not supply. Absent, it REFUSES; it never guesses
#     a host. (A worker guessed one on 2026-08-25 and reported success against
#     nothing.)
#   * The route comes from ROUTES below, forty-six rows, and nothing else; the
#     four claimant rows name the question door family's template, their only
#     door since the old ones were retired (D-7324), refused here, unsent, when a
#     current cap file says the server lacks `questions-v1` (D-7328).
#   * The only caller-supplied text that ever reaches a URL is an id or a query
#     value the row itself declares, each validated against `SAFE_RE` BEFORE the
#     request is built — refused, never escaped and sent.
#
# OUTPUT. stdout is the response body and exactly one newline. stderr ends in
# `http <code>` today; set `CCRC_API_STATUS=line` to keep it once a later release
# stops writing it by default. Exit 0 whenever a response arrived, 3 when none did.
#
# `server/test/ccrc-api-closed.test.ts` pins those as standing tests, because a
# property this load-bearing must be a mechanism and not a docstring.
#
# WHAT IS DELIBERATELY ABSENT. Plenty of routes have no row below, and most of
# them are simply not this client's business. FOUR are absent as a DECISION —
# the release valves D-282 leaves ungated:
#   `POST /api/coord/pause`
#   `POST /api/runs/:id/abandon`
#   `POST /api/claims/:id/break`
#   `POST /api/runs/:id/reclaim`
# They carry no box token on purpose: the party a wedge locks out — the
# coordinator, a session holding a claim, a program whose coordinator is the
# corpse and whose box token died with it — is the party holding that key, so
# putting a wedge's release valve behind it would leave the wedge no door. That
# is precisely why none of them may be reachable from HERE. Coordinator clause 4
# is the other half — "This session never unpauses itself.
# `$REG/coordinator-paused` is the operator's file." — and an ungated door plus a
# session-side verb is a door with no lock at all. They are operator doors,
# reached from the PWA. If the need is ever real it is an operator tool, not a
# row below. (D-688. The names and the count here are not a census anyone keeps
# by hand: `server/test/coord-pause-route.test.ts` derives both from `UNGATED`,
# the one place the set is decided, and reds this passage when they disagree —
# D-1168, which is what this passage cost the last time a docstring stood in for
# a mechanism.)
#
# SELF-CONTAINED. This file `source`s nothing. The moment it does it needs the
# shim treatment `ccrc` has (deploy/deploy.sh argues that at length) and a lone
# copy at ~/.local/bin would be dead on every box. The GENERATED SERVER-CAP
# READER region below is a byte copy of the hook's `_hook_server_cap`, renamed
# `_api_server_cap` (D-7321), never a `source`; regenerate it with
# `ccrc restamp ccd/ccrc-api`.
set +x; set -uo pipefail   # `set +x` FIRST, a SECRETS control as in ccd-pool-sync: an inherited xtrace would print the box token (R16, D-4096)

# `~/.local/bin` is NOT on the `claude-session@` unit PATH (measured 2026-08-26),
# so the corpora invoke this by explicit path. That is a caller's problem, not
# this file's — but it is why nothing here assumes its own directory is on PATH.

SELF="ccrc-api"
AGENT_ENV="$HOME/.ccrc/agent.env"
TOKEN_FILE="$HOME/.cc-secrets/ccrc-mail.token"
REG="$HOME/.cc-sessions"

# The one pattern any caller-supplied text must match before it reaches a URL.
# No dot, so `..` cannot survive it; no slash, no `?`, no `#`, no space. Run ids
# and delivery ids are integers, session ids and project slugs are
# `[A-Za-z0-9_-]+`, so this is not a narrowing of anything real. Widening it is a
# deliberate table change, not a convenience.
SAFE_RE='^[A-Za-z0-9_-]+$'

# METHOD|path|needs-id|comma-separated query keys this row accepts (or `-`).
# The four claimant rows' path is the question door family's template
# (`/api/questions/<ask|approval>-{id}/<rule|release>`): from Q3j it was their
# fifth field, sent only while the server advertised `questions-v1` (D-7325), and
# since the old doors were retired it is their path (D-7324). Every row has four.
# Forty-six rows, and that word is SCANNED: `server/test/ccrc-api.test.ts`
# derives the count from the table below and reds if this line or the bullet at
# the top of this file states a different one. The original rows were chosen on
# 2026-08-26 by measuring the skill corpora; the standing executable-corpus
# parity in `server/test/ccrc-api-closed.test.ts` now fails whenever either skill
# starts calling an operation this table does not declare.
declare -A ROUTES=(
  [runs.list]='GET|/api/runs|no|closed'
  [runs.open]='POST|/api/runs|no|-'
  [runs.dispatch]='POST|/api/runs/{id}/dispatch|yes|-'
  [runs.advance]='POST|/api/runs/{id}/advance|yes|-'
  [runs.close]='POST|/api/runs/{id}/close|yes|-'
  [runs.items]='POST|/api/runs/{id}/items|yes|-'
  # The READ half of the row above, and it exists because the write half was
  # unusable without it: settling needs item IDs, and until this route shipped
  # nothing published them — `runs list` carries only {done,total}. A live
  # coordinator reached the settle call with four titles and no ids, guessed 1,
  # and was refused `unknown-item`.
  [runs.items-list]='GET|/api/runs/{id}/items|yes|-'
  # Speed/quality signals re-measured off this run's own rows (paired holds,
  # swap count, wave-done mail count, the two signal lines off the last of
  # them) — a measurement, never a dial (D-2842's carry). Read-only, like the
  # row above.
  [runs.signals]='GET|/api/runs/{id}/signals|yes|-'
  # The coordinator's escalation/demotion/manual-override door (routing spec
  # 2026-09-14 §5.3, slice 5) — never `ccd route` directly (coordinator
  # skill clause 1). Body rides `--json`, the same shape every other POST
  # row here uses.
  [runs.route]='POST|/api/runs/{id}/route|yes|-'
  # `--program` joins through `runs.program`; `--to` and `--program` are
  # MUTUALLY EXCLUSIVE — exactly one, both or neither is a 400 (D-2057;
  # routes.ts's own `(to === null) === (program === null)` guard, not
  # this client's). `--all` has no bare-flag form on this client — the generic
  # `--*` arm always consumes a value — so it rides as `--all 1`, exactly as
  # `GET /api/mail?to=`'s existing `all` key always has.
  [mail.list]='GET|/api/mail|no|to,program,all,limit'
  [mail.send]='POST|/api/mail|no|-'
  # `fetch` and `ack` take the DELIVERY id, never the mail row's own id — two
  # separate autoincrement sequences that agree only for a mail sent to one
  # recipient (D-41). This client cannot tell them apart; it is named in the
  # corpora at every call site instead.
  [mail.fetch]='GET|/api/mail/{id}|yes|-'
  [mail.ack]='POST|/api/mail/{id}/ack|yes|-'
  [peers.list]='GET|/api/peers|no|of,project'
  [lifecycle.list]='GET|/api/lifecycle|no|session'
  [claims.list]='GET|/api/claims|no|project,all'
  [claims.take]='POST|/api/claims|no|-'
  [claims.release]='POST|/api/claims/{id}/release|yes|-'
  [ledger.list]='GET|/api/ledger|no|project'
  [ledger.allocate]='POST|/api/ledger/deviations|no|-'
  # The landing line's read (landing order wave 5e, D-7625): one project's entries, flags and order.
  [landing.show]='GET|/api/landing|no|project'
  # A token-authenticated session may list only its own children's asks. The
  # client derives both identity fields below; `--parent` is accepted only as a
  # compatibility assertion and may never select somebody else.
  [asks.list]='GET|/api/asks|no|parent'
  # ASYMMETRY, deliberate: `list` derives identity because its identity rides the
  # QUERY the client builds, and a caller-selected `parent` there would be the
  # client choosing whose children to read. `answer` and `release` take theirs
  # from the `--json` body, the same shape every other POST row here uses
  # (`mail.send`, `claims.take`, `claims.release`), and the guard is the route's:
  # it re-measures `fromUuid` against the registry and refuses unless the caller
  # IS the ask's parent. Deriving here would read as a security boundary this
  # client cannot be — identity on this fleet is attribution, not authentication,
  # and every `.uuid` is readable by the one UNIX user these sessions share.
  [asks.answer]='POST|/api/questions/ask-{id}/rule|yes|-'
  [asks.release]='POST|/api/questions/ask-{id}/release|yes|-'
  # The durable feed. `--program` filters through `feed_events.runId` and answers
  # one programme's events; without it the read is the whole box's, oldest-first.
  # An event that names no run is programless and appears only unfiltered.
  [feed.list]='GET|/api/feed|no|program,limit'
  # The coordinator's explicit intent declaration (delegation broker wave 3, Task 15). The ONE row whose grammar is not the generic
  # one: `coordinators intent <set|clear> --session <id>`, parsed by `parse_intent` below BEFORE the generic id and flag parser, which
  # then sees no arguments at all. The path id and the body's `byId`/`byUuid` are DERIVED from this pane; `--session` is only an
  # assertion that must equal the derived id, so it can never select another session. The row declares an id because the route
  # template has one, not because a caller supplies it.
  [coordinators.intent]='POST|/api/coordinators/{id}/intent|yes|-'
  # The child's PermissionRequest hook (coordinator-first routing, plan Task 14, spec §6.3, D-5297). `request` sends
  # the canonical request on `--json -` and is answered `201 {id, waitS}`; `ruling` polls one row with the hook's
  # per-request nonce (`SAFE_RE`, like every id); `key` reads the server's public key, which the install spine pins
  # once into `~/.ccrc/approval-signing.pub`. A child's own TOOL CALL to any of them is refused by its PreToolUse
  # deny (`approvals` as this client's first argument); the hook's calls are not tool calls.
  [approvals.request]='POST|/api/approvals|no|-'
  [approvals.ruling]='GET|/api/approvals/{id}/ruling|yes|nonce'
  [approvals.key]='GET|/api/approvals/key|no|-'
  # The CLAIMANT's three rows (plan Task 16, D-5298): rule, hand over, and read one row it holds. `rule` and `release`
  # take the attribution pair in the `--json` body, as `asks answer`/`asks release` do, and the verdict and reason ride
  # there too: this grammar takes no positional word after the id (D-5489). `show` derives identity from the pane, as
  # `asks list` does, so a session reads only a row held for it. A CHILD's own tool call to any `approvals` row is
  # refused by its PreToolUse deny (plan Task 14), before this client runs.
  [approvals.rule]='POST|/api/questions/approval-{id}/rule|yes|-'
  [approvals.release]='POST|/api/questions/approval-{id}/release|yes|-'
  [approvals.show]='GET|/api/approvals/{id}|yes|-'
  # The test box (test box plan TB9, D-7411, D-7554): its status block, and the tools sync the update lane signals
  # once a roll ends (spec §2.10). Both routes take a session OR the box token; neither takes a body or a query, and the
  # sync sends the box only the fleet host's own release and measured versions. The switch has NO row, on purpose:
  # arming remote runs is the operator's act, from the Settings card.
  [testbox.status]='GET|/api/testbox|no|-'
  [testbox.tools-sync]='POST|/api/testbox/tools-sync|no|-'
  # Linear, through the server's proxy and the key ccrc holds for each workspace (D-7669, #1444): sessions never sign
  # in to Linear and never hold a key. Twelve rows, nine reads and three writes; the SERVER decides each row's class,
  # never the method, which is why `search`, a read, is a POST: its text is free text, and free text never rides a URL
  # (SAFE_RE refuses it as a query value), so it goes in the `--json` body. `search` has its own path so no issue
  # route's `{id}` can match it. The `{id}` on the four issue rows is an issue identifier (`AAA-12`), held to
  # LINEAR_REF_RE below before anything is sent. `workspace` is a declared query key on every row that acts in one
  # workspace, the POSTs included, and never a body field; only `workspaces`, which lists them all, takes none. Every
  # row carries the pane's identity in its QUERY, appended after the declared keys (the Linear block in `main`).
  [linear.workspaces]='GET|/api/linear/proxy/workspaces|no|-'
  [linear.teams]='GET|/api/linear/proxy/teams|no|workspace'
  [linear.issue]='GET|/api/linear/proxy/issues/{id}|yes|workspace'
  [linear.search]='POST|/api/linear/proxy/search|no|workspace'
  [linear.comments]='GET|/api/linear/proxy/issues/{id}/comments|yes|workspace,limit,after'
  [linear.statuses]='GET|/api/linear/proxy/statuses|no|team,workspace'
  [linear.projects]='GET|/api/linear/proxy/projects|no|team,workspace,limit,after'
  [linear.labels]='GET|/api/linear/proxy/labels|no|team,workspace'
  [linear.users]='GET|/api/linear/proxy/users|no|workspace,limit,after'
  [linear.create]='POST|/api/linear/proxy/issues|no|workspace'
  [linear.update]='POST|/api/linear/proxy/issues/{id}|yes|workspace'
  [linear.comment]='POST|/api/linear/proxy/issues/{id}/comments|yes|workspace'
)

# A Linear issue identifier, the `<REF>` of the four issue rows (D-7669): a team key that starts with a letter, a hyphen,
# then one to nine digits. Every match also matches SAFE_RE; this is the narrower check on those rows, so `AAA12`,
# `AAA-` and `search` are refused here, locally, as `bad-ref` (D-7685), and never sent. The server checks it again. The classes are spelled
# out, never ranges, for the reason `_api_server_cap` gives: under a UTF-8 locale a range may collate non-ASCII letters.
LINEAR_REF_RE='^[ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz][ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_]*-[0123456789]{1,9}$'

# ── BEGIN GENERATED SERVER-CAP READER (shared/hook-helpers.mjs; edit _hook_server_cap in ccd/session-hook.sh, then regenerate) ──
# ccrc:generated 1 sha256=b13a129bd7002352be7dfc797c104d07461cf4b34ab6bc1d6cb6e2dde47e177a
_api_server_cap() {
  local want="$1" l1="" l2="" l3="" l4="" at now
  { { IFS= read -r l1 && IFS= read -r l2 && IFS= read -r l3 && ! IFS= read -r l4; } < "$HOME/.ccrc/server-caps"; } 2>/dev/null || return 1
  [[ -z "$l4" && "$l3" == end && "$l1" =~ ^at\ ([0123456789]{1,11})$ ]] || return 1
  at=$(( 10#${BASH_REMATCH[1]} ))
  # The word class is spelled out, never a range: under a UTF-8 locale `a-z` may collate non-ASCII letters into it.
  [[ "$l2" =~ ^caps(\ [abcdefghijklmnopqrstuvwxyz0123456789-]{1,64})*$ ]] || return 1
  if [[ -n "${EPOCHREALTIME:-}" ]]; then now="${EPOCHREALTIME%%[.,]*}"; else printf -v now '%(%s)T' -1; fi
  [[ "$now" =~ ^[0123456789]+$ ]] || return 1
  (( at <= now && now - at <= 180 )) || return 1
  [[ " ${l2#caps} " == *" $want "* ]]
}
# ── END GENERATED SERVER-CAP READER ──

# Every refusal leaves by this door, in the SAME JSON envelope the routes
# themselves use, so a caller never parses two shapes. The human sentence goes to
# stderr; stdout stays machine-readable on every path. Nothing here ever
# interpolates the token — see `refuse token-*` below, which names the file and
# not its contents.
# D-2725: `detail` carries caller argv verbatim at four sites (`no such verb`,
# `cannot read`, `unexpected argument`, `takes no --k`), so a `"`, a `\` or a
# newline in an argument used to emit an envelope that does not PARSE — breaking
# the one-shape promise above at exactly the moment a caller is being told it got
# something wrong. Escaped here rather than at each site: one door, one escape.
json_escape() {   # sets JSON_ESCAPED
  local v="$1"
  v="${v//\\/\\\\}"      # backslash first, or it doubles the ones added below
  v="${v//\"/\\\"}"
  v="${v//$'\n'/\\n}"
  v="${v//$'\r'/\\r}"
  v="${v//$'\t'/\\t}"
  JSON_ESCAPED="$v"
}

refuse() {  # code, detail
  local code detail
  json_escape "$1"; code="$JSON_ESCAPED"
  json_escape "$2"; detail="$JSON_ESCAPED"
  printf '{"ok":false,"error":"%s","detail":"%s"}\n' "$code" "$detail"
  printf '%s: %s (%s)\n' "$SELF" "$2" "$1" >&2
  exit 2
}

usage() {
  {
    printf '%s <group> <verb> [<id>] [--json <file|->] [--<key> <value>]\n\n' "$SELF"
    printf 'stdout is the body and one newline. CCRC_API_STATUS=line keeps the `http <code>` line on stderr,\n'
    printf 'which a later release stops writing by default.\n\n'
    printf 'Closed table — no URL, host or path is an argument.\n\n'
    for k in $(printf '%s\n' "${!ROUTES[@]}" | sort); do
      IFS='|' read -r m p _ q _ <<< "${ROUTES[$k]}"
      [[ "$q" == '-' ]] && q='' || q="  [--${q//,/ | --}]"
      printf '  %-18s %-5s %s%s\n' "${k/./ }" "$m" "$p" "$q"
    done
    printf '  %-18s %s\n' '' 'coordinators intent takes set|clear --session <this session'"'"'s id> and nothing else'
    printf '  %-18s %s\n' 'whoami' 'this session'"'"'s {id,uuid}, from tmux + the registry'
    printf '  %-18s %s\n' '' '(ledger allocate fills "byId" from this pane; --by <id> for a caller with none)'
  } >&2
}

# GREP, never source: agent.env is 0600 and carries this box's agent bearer
# token, so sourcing it would import a secret into this shell for no reason.
# D-2724: sets SERVER_URL rather than PRINTING it, for the same reason
# `derive_identity` does. `base=$(server_url)` captured `refuse`'s stdout into the
# variable and then threw it away on `|| exit`, so the three config refusals
# (`no-agent-env`, `no-server-url`, `no-token`) reached the caller as an EMPTY
# stdout — falsifying this file's own contract two screens up, that stdout stays
# machine-readable on every path. A caller doing `body=$("$API" runs list)` got
# `''` where a named refusal was promised.
server_url() {   # sets SERVER_URL, or refuses. Never call it in $( ).
  [[ -r "$AGENT_ENV" ]] || refuse 'no-agent-env' "cannot read $AGENT_ENV"
  local u
  u=$(grep -E '^[[:space:]]*CCRC_SERVER_URL=' "$AGENT_ENV" | tail -n1 | cut -d= -f2- | tr -d '[:space:]')
  [[ -n "$u" ]] || refuse 'no-server-url' "CCRC_SERVER_URL is not set in $AGENT_ENV"
  # `ccrc install --role fleet` writes either spelling. Swapping it here is what
  # stops every caller doing it, and getting it wrong once.
  u="${u/#ws:/http:}"; u="${u/#wss:/https:}"
  SERVER_URL="${u%/}"
}

# The token file is a DOCUMENT with a token in it: a `#`-comment preamble above
# one value line. Same rule as the server's own `coord/token.ts` extractToken and
# `deploy/notify.sh` — first non-blank, non-`#` line, whitespace stripped. Doing
# it here is the point: no caller performs the dance, so no caller can `cat` the
# whole preamble into a header and then read the resulting 401 as a rotated
# secret.
read_token() {   # sets TOKEN, or refuses (D-2724). Never call it in $( ).
  [[ -r "$TOKEN_FILE" ]] || refuse 'no-token' "cannot read $TOKEN_FILE"
  local t
  t=$(grep -v '^[[:space:]]*#' "$TOKEN_FILE" | grep -v '^[[:space:]]*$' | head -n1 | tr -d '[:space:]')
  [[ -n "$t" ]] || refuse 'no-token' "$TOKEN_FILE carries no value line"
  TOKEN="$t"
}

# Attribution, not authentication: the one fact not carried in any payload is
# what tmux says about the pane this runs in.
#
# THE VARIABLE THAT DECIDES IS `TMUX_PANE`, NOT `$TMUX`, and that gate is the
# whole guard. `tmux display-message -p '#S'` with no pane in the environment
# does NOT refuse on a box running a tmux server — it answers for the MOST
# RECENTLY ACTIVE session and exits 0. Measured on the fleet host three times
# across 2026-09-02: from `env -i` the same binary named a DIFFERENT session on
# each run, and on the last one it named another project's session while the
# caller's own pane belonged to this one. A caller with no pane therefore got a
# complete, confident, WRONG identity. WHICH session it names is a race, so no
# cardinal about it belongs in this file; the property is what is guarded. The
# detail this refusal used to carry — 'not inside a tmux session' — was itself
# false on any box that has panes at all.
#
# THE PANE ID IS VALIDATED BEFORE IT IS PASSED, and that check is load-bearing
# rather than tidy: `-t` accepts a SESSION name, so an unvalidated TMUX_PANE of
# `cc-other` would ask tmux about someone else's session and be believed.
#
# TWO REFUSAL CODES, NOT ONE. 'no-pane' (you are not in a pane) and 'bad-pane'
# (your TMUX_PANE is not a pane id) are different facts to whoever reads them —
# "run me inside a session" against "your environment is lying" — and collapsing
# them is the overloaded value this repo forbids at a seam.
#
# THERE IS ONE FLAG, AND IT DECLARES RATHER THAN FORGES. `--by <id>`, on the
# `ledger allocate` row alone, names a caller that HAS no pane — a contributor at
# a shell or in CI, whom CONTRIBUTING.md sends to this allocator and for whom
# auth/gate.ts's EXEMPT entry keeps the door open. It is refused on every other
# row, and a session in a pane is filled from its pane. What is still
# deliberately absent is any way to answer AS another session on a route that
# checks attribution. `coordinators intent` takes a second word of the same kind,
# `--session`, and it is an ASSERTION, never a selector: `parse_intent` refuses
# unless it equals the pane-derived id, exactly as `asks list --parent` does.
DERIVED_ID=''
DERIVED_UUID=''
derive_identity() {   # sets DERIVED_ID / DERIVED_UUID, or refuses. NEVER call it
                      # inside $( ): `refuse` prints the envelope on stdout and a
                      # substitution would swallow it (`server_url` has that shape).
  local pane tname
  # READ ONCE into a local, so `set -u` (line 43) cannot turn a deleted gate
  # below into an unbound-variable error instead of the misattribution the gate
  # is there to stop. A guard whose removal fails for the wrong reason is a
  # guard nobody has actually measured.
  pane="${TMUX_PANE:-}"
  [[ -n "$pane" ]] \
    || refuse 'no-pane' 'not inside a tmux pane (TMUX_PANE unset); identity cannot be derived'
  [[ "$pane" =~ ^%[0-9]+$ ]] \
    || refuse 'bad-pane' 'TMUX_PANE is not a pane id'
  tname=$(tmux display-message -p -t "$pane" '#S' 2>/dev/null) \
    || refuse 'no-tmux' 'tmux could not answer for this pane'
  [[ -n "$tname" ]] || refuse 'no-tmux' 'tmux named no session for this pane'
  DERIVED_ID="${tname#cc-}"
  [[ "$DERIVED_ID" =~ $SAFE_RE ]] || refuse 'bad-session' 'tmux session name is not a usable id'
  [[ -r "$REG/$DERIVED_ID.uuid" ]] || refuse 'no-uuid' "no $REG/$DERIVED_ID.uuid for this session"
  DERIVED_UUID=$(tr -d '[:space:]' < "$REG/$DERIVED_ID.uuid")
  [[ -n "$DERIVED_UUID" ]] || refuse 'no-uuid' "$REG/$DERIVED_ID.uuid is empty"
  [[ "$DERIVED_UUID" =~ $SAFE_RE ]] || refuse 'bad-uuid' 'session uuid is not a usable value'
}

# Adds `"<field>":"<value>"` as the FIRST key of the JSON object in `$body`
# (main's local, read and rewritten here). Used by both body fills below.
# `<value>` is always SAFE_RE-checked before it reaches this function (a `--by`
# value, a derived id or a derived uuid), so it admits no quote and no backslash
# and cannot escape the string it lands in. The third argument is the
# `bad-body` detail for a body that is not an object.
splice_body_field() {   # field, value, not-an-object detail
  local lead rest restnb
  lead="${body%%[![:space:]]*}"
  rest="${body#"$lead"}"
  [[ "$rest" == '{'* ]] || refuse 'bad-body' "$3"
  rest="${rest#\{}"
  restnb="${rest//[[:space:]]/}"
  if [[ "$restnb" == '}' ]]; then body="{\"$1\":\"$2\"}"
  else body="{\"$1\":\"$2\",$rest"; fi
}

cmd_whoami() {
  derive_identity
  printf '{"id":"%s","uuid":"%s"}\n' "$DERIVED_ID" "$DERIVED_UUID"
}

# `coordinators intent <set|clear> --session <id>`, and NOTHING ELSE (delegation broker wave 3, Task 15). A focused special case
# that runs before the generic parser, so the generic one needs no flag, body file or query key for this row and gains none:
# exactly one action word, then exactly one `--session`, nothing after it. The id and uuid are the PANE's (`derive_identity`);
# `--session` must equal the derived id or the call is refused, so it asserts and never selects. The body is synthesized here from
# those two values, which `derive_identity` has already held to SAFE_RE (no quote, no backslash), so it cannot break out of its
# JSON strings. Sets INTENT_ID and INTENT_BODY, or refuses. NEVER call it inside $( ): `refuse` prints on stdout.
INTENT_ID=''
INTENT_BODY=''
parse_intent() {
  local action='' session='' have_session=0
  (( $# >= 1 )) || refuse 'bad-args' 'coordinators intent needs set or clear'
  action="$1"; shift
  [[ "$action" == 'set' || "$action" == 'clear' ]] \
    || refuse 'bad-args' "coordinators intent takes set or clear, not: $action"
  while (( $# )); do
    case "$1" in
      --session)
        (( have_session == 0 )) || refuse 'bad-args' '--session was given twice'
        [[ $# -ge 2 ]] || refuse 'bad-args' '--session needs a value'
        [[ "$2" =~ $SAFE_RE ]] || refuse 'bad-id' '--session value is not a plain session id'
        session="$2"; have_session=1; shift 2 ;;
      *) refuse 'bad-args' "unexpected argument: $1" ;;
    esac
  done
  (( have_session == 1 )) || refuse 'bad-args' 'coordinators intent needs --session <id>'
  derive_identity
  [[ "$session" == "$DERIVED_ID" ]] \
    || refuse 'session-mismatch' '--session must name this pane-derived session'
  INTENT_ID="$DERIVED_ID"
  INTENT_BODY="{\"action\":\"$action\",\"byId\":\"$DERIVED_ID\",\"byUuid\":\"$DERIVED_UUID\"}"
}

main() {
  (( $# >= 1 )) || { usage; refuse 'no-verb' 'no group given'; }

  [[ "$1" == 'whoami' ]] && { cmd_whoami; exit 0; }
  [[ "$1" == '-h' || "$1" == '--help' ]] && { usage; exit 0; }

  (( $# >= 2 )) || { usage; refuse 'no-verb' "group '$1' needs a verb"; }
  local group="$1" verb="$2"; shift 2

  local key="$group.$verb"
  [[ -n "${ROUTES[$key]+set}" ]] || { usage; refuse 'unknown-verb' "no such verb: $group $verb"; }

  local method tmpl needs qkeys
  IFS='|' read -r method tmpl needs qkeys <<< "${ROUTES[$key]}"

  # A positional id, if this row declares one. It is read before the flags so an
  # id can never be mistaken for a flag value. The ONE row with a grammar of its own,
  # `coordinators intent`, is parsed whole by `parse_intent` instead; it derives the id
  # from the pane and consumes every argument, so the generic parser below sees none.
  local id='' intent_body=''
  if [[ "$key" == 'coordinators.intent' ]]; then
    parse_intent "$@"
    id="$INTENT_ID"; intent_body="$INTENT_BODY"
    set --
  elif [[ $# -gt 0 && "$1" != --* ]]; then id="$1"; shift; fi

  if [[ "$needs" == 'yes' ]]; then
    [[ -n "$id" ]] || refuse 'no-id' "$group $verb needs an id"
    [[ "$id" =~ $SAFE_RE ]] || refuse 'bad-id' 'id is not a plain id'
    if [[ "$group" == 'linear' ]]; then
      [[ "$id" =~ $LINEAR_REF_RE ]] || refuse 'bad-ref' 'the issue reference is not an identifier such as AAA-12'
    fi
  else
    # Not ignored: a caller who passed one believes it is going somewhere.
    [[ -z "$id" ]] || refuse 'unexpected-id' "$group $verb takes no id"
  fi

  local body_src='' query='' by='' ask_parent=''
  while (( $# )); do
    case "$1" in
      --json)
        [[ $# -ge 2 ]] || refuse 'bad-args' '--json needs a file or -'
        body_src="$2"; shift 2 ;;
      --by)
        [[ $# -ge 2 ]] || refuse 'bad-args' '--by needs a value'
        [[ "$key" == 'ledger.allocate' ]] || refuse 'bad-args' "$group $verb takes no --by"
        [[ "$2" =~ $SAFE_RE ]] || refuse 'bad-by' '--by value is not a plain session id'
        by="$2"; shift 2 ;;
      --*)
        local k="${1#--}" v
        [[ $# -ge 2 ]] || refuse 'bad-args' "--$k needs a value"
        v="$2"
        # Closed here too: a row declares which query keys it takes, so an
        # undeclared one refuses rather than riding along.
        # D-2726: `-` is the "declares no query keys" SENTINEL, and it is also a
        # string the membership test matches — `",-,"` contains `",-,"` — so
        # `--- value` used to ride onto every row whose key list is `-`. The
        # sentinel is rejected before the membership test, never by it.
        [[ "$qkeys" != '-' && ",$qkeys," == *",$k,"* ]] \
          || refuse 'unknown-query' "$group $verb takes no --$k"
        [[ "$v" =~ $SAFE_RE ]] || refuse 'bad-query' "--$k value is not a plain value"
        if [[ "$key" == 'asks.list' && "$k" == 'parent' ]]; then
          ask_parent="$v"
        else
          query+="${query:+&}$k=$v"
        fi
        shift 2 ;;
      *) refuse 'bad-args' "unexpected argument: $1" ;;
    esac
  done

  local body=''
  if [[ -n "$body_src" ]]; then
    if [[ "$body_src" == '-' ]]; then
      body=$(cat)
    else
      [[ -r "$body_src" ]] || refuse 'no-body' "cannot read $body_src"
      body=$(cat -- "$body_src")
    fi
  fi

  # The intent row's body is the body `parse_intent` synthesized: never read from a file or stdin.
  [[ -z "$intent_body" ]] || body="$intent_body"

  # THE FIRST BODY THIS CLIENT REWRITES. It now rewrites three more: the intent
  # row's (above, replaced whole), `runs.open`'s (below) and the claimant rows'
  # `kind` (below, D-7322). Measured
  # 2026-09-02: at least 101 of this project's allocations already carry an empty
  # holder, because the documented body omits `byId` and the route stores
  # `byId ?? ''` — an omitted field and an explicit empty string reaching one
  # column. That 101 is a FLOOR that can only grow, which is why it may stand
  # here: nothing in the tree UPDATEs `allocatedTo`, and `LedgerLog.append` has
  # already put each of those lines in the append-only log, so no repair can
  # lower it. The route may not change (operator ruling), so the fill happens
  # here: from the pane, or from `--by`, or not at all.
  #
  # NEVER AN OVERRIDE. If the body already names `byId` it is left alone. The
  # test is TEXTUAL, over a whitespace-stripped COPY (so `"byId" : ""` reads the
  # same as `"byId":""`), and it errs toward not touching the body — the safe
  # direction, since duplicate keys resolve last-wins and a splice would silently
  # change precedence. A blank one is REFUSED rather than passed through: that is
  # exactly what a derivation that failed on the caller's side produces.
  #
  # THE TEXTUAL TEST'S LIMITS, STATED RATHER THAN HIDDEN. A substring is not a
  # JSON key, and three bodies show where the two part company — each measured
  # 2026-09-03 against a loopback server, each re-permitting this block's own
  # defect for that one body. A NESTED key (`{"project":"p","meta":{"byId":"x"}}`)
  # and a WHITESPACE-PADDED one (`{"byId ":"sneaky",...}`) both read as "the
  # caller has spoken", so the fill is SILENTLY suppressed and a body with no
  # top-level `byId` goes on the wire. A `\u`-ESCAPED key (`{"\u0062yId":"",...}`)
  # reads the other way, as absent: the splice fires and the wire body
  # last-wins-parses to `{"byId":""}`, which is the blank refusal bypassed.
  # None of the three is a forgery door — the caller already owns the body it
  # hands us, and identity here is attribution — so the cost is an unattributed
  # or blank row, the same one this block exists to stop, for that body only.
  # Where the escaping runs the other way the test holds: a `\"byId\":` inside a
  # title fills normally (the backslashes survive the strip and break both
  # substrings), and the same text UNESCAPED is an invalid body that trips the
  # blank refusal loudly.
  #
  # THE SPLICE IS SAFE BECAUSE OF SAFE_RE. Both `$by` and the derived id admit no
  # quote and no backslash, so neither can escape the JSON string it lands in.
  if [[ "$key" == 'ledger.allocate' && -n "$body" ]]; then
    local nb="${body//[[:space:]]/}"
    case "$nb" in
      *'"byId":""'*)
        refuse 'bad-body' 'the body names an EMPTY byId; the allocator would store it as no holder at all' ;;
    esac
    case "$nb" in
      *'"byId":'*) : ;;                      # the caller has spoken
      *)
        local who
        if [[ -n "$by" ]]; then who="$by"; else derive_identity; who="$DERIVED_ID"; fi
        splice_body_field 'byId' "$who" \
          'the allocate body is not a JSON object; byId cannot be added' ;;
    esac
  fi

  # THE SECOND BODY THIS CLIENT FILLS: a run's claimant sends its own identity
  # (D-5298; coordinator-first routing, spec §6.4). `POST /api/runs` is where a
  # coordinator becomes a child's parent, and the server checks the claimant with
  # `requireAttribution` against `claimedByUuid`. The coordinator skill's body
  # names `claimedBy` and no uuid, and it stays that way: the uuid is read here,
  # from the caller's own `$REG/<id>.uuid` through `derive_identity` (the pane,
  # then the registry, as `whoami` and `asks list` read it), so no caller can get
  # it wrong one call at a time. `runs.open` is the only row that sets a claimant:
  # dispatch, advance, close, items and route take a run id and leave
  # `claimedBy` and `sessionId` alone, and the reclaim door that does change them
  # is one of the four that never have a row here (above).
  #
  # SAME RULES AS THE `byId` FILL, for the same reasons: a body that already
  # names `claimedByUuid` is left alone (the route re-measures it, so the caller
  # who spoke owns the answer, and it needs no pane); a blank one is refused; a
  # body with no derivable identity is refused and nothing is sent; a bodyless
  # call is untouched. The textual test's limits stated for `byId` hold here
  # too. Freshness, not identity: every `.uuid` is readable by the one UNIX user
  # these sessions share, so this stops a confused session, not a hostile one.
  if [[ "$key" == 'runs.open' && -n "$body" ]]; then
    local ob="${body//[[:space:]]/}"
    case "$ob" in
      *'"claimedByUuid":""'*)
        refuse 'bad-body' 'the body names an EMPTY claimedByUuid; the claimant would be unattributed' ;;
    esac
    case "$ob" in
      *'"claimedByUuid":'*) : ;;             # the caller has spoken
      *)
        derive_identity
        splice_body_field 'claimedByUuid' "$DERIVED_UUID" \
          'the runs open body is not a JSON object; claimedByUuid cannot be added' ;;
    esac
  fi

  # `approvals show` reads one row as the claimant it was held for (plan Task 16): the identity pair is the pane's,
  # never the caller's, exactly as `asks list` below derives its own.
  if [[ "$key" == 'approvals.show' ]]; then
    derive_identity
    query="fromId=$DERIVED_ID&fromUuid=$DERIVED_UUID"
  fi

  # Every Linear row (D-7669, #1444) carries the pane's identity, GETs and POSTs alike, and it rides the QUERY, after
  # the declared keys, the way `approvals show` builds `fromId`/`fromUuid`. THIS BLOCK NEVER READS OR EDITS THE BODY:
  # no splice and no textual test, so a POST's body goes on the wire byte for byte as the caller gave it. That is the
  # opposite of the `byId` fill above, on purpose: here the caller may not choose whom a write is attributed to through
  # this client. `byId` and `byUuid` are not declared query keys, so `--byId` is `unknown-query`, and no declared key's
  # value can add one, because SAFE_RE refuses `&` and `=`. A body that names either (however it spells the key) is the
  # server's to refuse, after parsing, as `bad-field`; the server reads identity from the query only. A pane with no
  # identity is refused here and nothing is sent.
  if [[ "$key" == linear.* ]]; then
    derive_identity
    query+="${query:+&}byId=$DERIVED_ID&byUuid=$DERIVED_UUID"
  fi

  if [[ "$key" == 'asks.list' ]]; then
    derive_identity
    [[ -z "$ask_parent" || "$ask_parent" == "$DERIVED_ID" ]] \
      || refuse 'parent-mismatch' '--parent must name this pane-derived session'
    # The corpus promises OPEN asks. Server omission of `state` is intentionally
    # an unfiltered diagnostic read, so the bounded client fixes the held view
    # rather than exposing caller-selected state.
    query="parent=$DERIVED_ID&fromUuid=$DERIVED_UUID&state=held"
  fi

  # THE THIRD BODY FILL: the question door family's `kind` (D-7322), on the four claimant rows, whose template is the
  # family's and their only door: the old doors were retired (D-7324), so nothing falls back. The kind is the ROW's,
  # read from the template's `ask-` or `approval-` prefix, never from the caller; `$claimant` holds it, and is empty on
  # every other row.
  #
  # THE ONE LOCAL REFUSAL (D-7328), and the fail direction inverted on purpose: a CURRENT, well-formed
  # `~/.ccrc/server-caps` that omits `questions-v1` says the server this box talks to is older than the family, so
  # `no-questions-door` is answered and nothing is sent. An absent, stale, torn or future file sends the family, the
  # only door left. The file is read by `_api_server_cap`, the generated copy of the hook's reader, and only for a
  # claimant row: the test of `$claimant` comes first on the one line that calls the reader. That line asks it twice,
  # for `questions-v1` and then for the empty word, which the reader answers 0 for every current, well-formed file
  # (its last test looks for `" $want "` in the caps line with a space added at each end, and that padded line always
  # holds two spaces), whether it lists the other words or none (a server older than the caps answer is recorded as
  # none). A 404 is never read as "no family": `unknown-ask` and `unknown-approval` are 404s too.
  #
  # The `byId` fill's rules hold for the splice: a body that already names `"kind":` (the same textual test over a
  # whitespace-stripped copy, with the same stated limits) is left alone, so a contrary kind reaches the server and is
  # answered there; a bodyless call is sent as the kind alone, which both doors refuse alike; a body that is not a JSON
  # object is refused here and nothing is sent.
  local claimant=''
  if [[ "$tmpl" == '/api/questions/'* ]]; then
    claimant="${tmpl#/api/questions/}"
    claimant="${claimant%%-*}"
  fi
  if [[ -n "$claimant" ]]; then
    local want served='family'
    for want in questions-v1 ''; do
      if [[ -n "$claimant" ]] && _api_server_cap "$want"; then
        [[ -n "$want" ]] || served=''
        break
      fi
    done
    [[ -n "$served" ]] || refuse 'no-questions-door' \
      'the server this box talks to does not answer the question door family; update it before answering'
    if [[ -z "$body" ]]; then
      body="{\"kind\":\"$claimant\"}"
    else
      local kb="${body//[[:space:]]/}"
      [[ "$kb" == '{'* ]] || refuse 'bad-body' 'the body is not a JSON object; kind cannot be added'
      case "$kb" in
        *'"kind":'*) : ;;                    # the caller has spoken
        *)
          splice_body_field 'kind' "$claimant" \
            'the body is not a JSON object; kind cannot be added' ;;
      esac
    fi
  fi

  local path url
  server_url
  read_token
  path="${tmpl/\{id\}/$id}"
  url="$SERVER_URL$path${query:+?$query}"

  local out code
  # AN EXPLICIT TEMPLATE, because BSD `mktemp` IGNORES `$TMPDIR` when given
  # none (install.sh:54 measured it) — and this file cannot source ccd's
  # platform block, so the template is spelled locally, unconditionally, the
  # same shape install.sh uses. GNU mktemp honours the template identically.
  out=$(mktemp "${TMPDIR:-/tmp}/ccrc-api.XXXXXXXXXX") || refuse 'no-tmp' 'cannot create a temp file'
  # shellcheck disable=SC2064
  trap "rm -f '$out'" EXIT

  # `-f` is never used, on purpose and for the same reason both corpora say so:
  # it prints nothing on a 4xx and exits 22, and the body is the whole protocol —
  # every refusal these routes send arrives as a 4xx JSON body.
  local -a args=(-sS -K - -m 30 -o "$out" -w '%{http_code}' -X "$method")
  [[ -n "$body" ]] && args+=(-H 'content-type: application/json' --data-binary "$body")

  # THE TOKEN RIDES CURL'S STDIN, NEVER ITS ARGV (R16): a `-H` value is readable
  # in every process listing on the box (`ps`, /proc/<pid>/cmdline) for the life
  # of the call. `-K -` reads the header from a config line on stdin, the
  # spelling ccd-pool-sync and ccd-update-sync ship. stdin is free here because
  # `--json -` was read into $body above, before this line.
  code=$(printf 'header = "x-ccrc-mail-token: %s"\n' "$TOKEN" \
    | curl "${args[@]}" "$url" 2>/dev/null)
  local rc=$?
  TOKEN=""

  if (( rc != 0 )) || [[ -z "$code" || "$code" == '000' ]]; then
    # NOT an answer. The one case that exits non-zero — and it still speaks the
    # same envelope, so a caller never has to parse a second shape to find out.
    printf '{"ok":false,"error":"transport","detail":"no response from the server (curl rc %s)"}\n' "$rc"
    printf '%s: no response from the server\n' "$SELF" >&2
    exit 3
  fi

  cat "$out"
  # The body ends in exactly one newline: a session's shell tool shows both
  # streams together, and a body with none ran into the status line (`}http 200`).
  # Empty prints nothing; one already ending in a newline gets no second.
  [[ -s "$out" && -n "$(tail -c 1 "$out")" ]] && printf '\n'
  # `CCRC_API_STATUS=line` is the caller's spelling for "keep this line". It is
  # an environment variable, not a flag, because an older client refuses an
  # unknown flag and ignores an unknown variable. Today the line is written
  # whatever it says; a later release stops writing it by default.
  printf 'http %s\n' "$code" >&2
  # An HTTP response happened, so this succeeded — whatever the status says. A
  # 4xx is an ANSWER here, and a client that exited non-zero on one would rebuild
  # the `curl -f` trap for its callers.
  exit 0
}

main "$@"
