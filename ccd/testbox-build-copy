#!/usr/bin/env bash
# testbox-build-copy — `ccrc testbox-admin build-copy --version=<build>`, the build capture's copy (capture runner spec
# docs/superpowers/specs/2026-11-22-build-capture-runner-design.md §2.2, Table 2, slug build-source-is-the-fleet). SOURCED by
# ccd/ccrc-testbox-admin, never run: it defines the sub's grammar check and its body, and uses the verb's lock, state, log,
# answers and box call (`_tba_short_lock`, `_tba_ra_precheck`, `_tba_cx_out`, `_tba_cx_fail`). It is a file of its own
# because the verb sits at its growth cap.
#
# A build waits for its capture only because a fleet session runs it, so this host already holds that exact build in Claude
# Code's versions directory. ccrc never downloads one: this sub copies the fleet's own copy to the test box, and the server's
# capture lane asks for it only after the box refused a capture `build-absent` (`shared/claudeBuildTrust.ts#captureNextAct`).
#   verify  (this host) the build file is read, never written: it must exist, be a regular file and not a link, and be at
#           most TBA_BUILD_COPY_MAX bytes; then it is hashed (SHA-256). Each refusal is its own code, and none reaches the box.
#   copy    (the box, ONE call) the bytes stream over the lane's one way to the box, and the box's own program does the rest:
#           P2  it stages them in a fresh directory only root can enter, outside the box root, and removes it on every way
#               out, success and refusal alike;
#           P3  it hashes the very bytes it then hands over, in that same step, read from what it holds rather than from a
#               path, and a hash that differs refuses build-hash-mismatch before anything under the box root is touched;
#           P1  it hands them to a writer that runs with the box root owner's own identity (the test service's user, never
#               root), so every directory, file, mode and rename under the box root is that user's own act;
#           P4  the writer refuses build-store-refused, changing nothing, when `captures` or `captures/builds` is a link or
#               not a directory, or where the build goes is a link or not a regular file;
#           and places the build at `<box root>/captures/builds/<version>`, mode 0555, owned by that user, which the capture
#           desk reads as the build being present.
# Nothing here writes this host's versions directory or Claude Code's launcher, and the box side writes only under the box's
# own root and its own stage. Short (one box call), under the verb's lock, recorded in no ledger row (the build's own row
# says what the copy came to). Its answer is `{"ok":true,"build":"<version>","sha256":"<hex>"}`.
#
# The box's two programs are one line each: `_tba_ssh` quotes each word with `%q`, and a newline would reach the box's login
# shell as bash's `$'...'`. The writer travels as one word of the call and runs under the copy program's privilege drop.

# The largest build ccrc copies: 1 GiB (a build is about 380 MB in 2026-11).
TBA_BUILD_COPY_MAX=$((1024 * 1024 * 1024))

# A Claude Code build, `shared/claudeVersion.ts#CLAUDE_VERSION`'s grammar: three decimal parts, no leading zero.
_tba_is_claude_version() { [[ "${1-}" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; }

# The fleet's own copy of <version>, where Claude Code keeps its builds on this host. Read only.
_tba_build_copy_src() { printf '%s/.local/share/claude/versions/%s' "$HOME" "$1"; }

# ── BOX-SIDE COMMANDS (begin) ── they run on the test box over ssh, never on this host: the box runs the fleet host's own
# distribution release (the preflight's `os` check), so its userland is GNU and util-linux's privilege drop is there. The
# macOS scan (server/test/macos-platform.test.ts) cuts this region and pins what is in it.
# The copy, as root: $1 the box root, $2 the build, $3 the hash this host took, $4 the writer; stdin the bytes. Exit 4: the
# bytes differ; exit 5: the store is refused; `installed` on success.
# shellcheck disable=SC2016  # expanded by the box's sh, not here
TBA_BUILD_COPY_SH='set -e; r=$1; umask 077; s=$(mktemp -d "${TMPDIR:-/tmp}/.ccrc-build-copy.XXXXXXXX"); trap '"'"'rm -rf -- "$s"'"'"' EXIT; case $s/ in "$r"/*) exit 1;; esac; cat >"$s/b"; exec 3<"$s/b" 4<"$s/b"; rm -rf -- "$s"; h=$(sha256sum <&3); exec 3<&-; [ "${h%% *}" = "$3" ] || exit 4; { [ -d "$r" ] && [ ! -L "$r" ]; } || exit 5; o=$(ls -ldn -- "$r" | awk '"'"'{print $3" "$4}'"'"'); u=${o% *}; g=${o#* }; case "$u.$g" in *[!0-9.]*|.*|*.) exit 1;; esac; [ "$u" != 0 ] && [ "$g" != 0 ] || exit 5; exec setpriv --reuid="$u" --regid="$g" --clear-groups -- sh -c "$4" sh "$r" "$2" <&4 4<&-'
# The writer, as the box root's owner: $1 the box root, $2 the build; stdin the bytes. Exit 5: the store is refused.
# shellcheck disable=SC2016  # expanded by the box's sh, not here
TBA_BUILD_WRITE_SH='set -e; umask 022; c=$1/captures; d=$c/builds; f=$d/$2; for x in "$c" "$d"; do if [ -L "$x" ]; then exit 5; elif [ -e "$x" ]; then [ -d "$x" ] || exit 5; else mkdir -- "$x"; fi; done; if [ -L "$f" ] || { [ -e "$f" ] && [ ! -f "$f" ]; }; then exit 5; fi; t=$(mktemp "$d/.copy.XXXXXXXX"); cat >"$t" && chmod 0555 "$t" && mv -f -- "$t" "$f" || { rm -f -- "$t"; exit 1; }; echo installed'
# ── BOX-SIDE COMMANDS (end) ──────────────────────────────────────────────────────────────────────────────────────

_tba_build_copy_refuse() {   # <code> <log words> — the log line, then the answer
  _tba_log "build-copy: refused $1 ($2)"
  _tba_refuse "$1"
}

# build-copy --version=<build>
_tba_run_build-copy() {
  local v="" w src size sum root
  for w in "$@"; do case "$w" in --version=*) v="${w#*=}" ;; esac; done
  _tba_short_lock || return 0
  # verify, on this host: read only.
  src="$(_tba_build_copy_src "$v")"
  if [ ! -e "$src" ] && [ ! -L "$src" ]; then _tba_build_copy_refuse build-not-on-fleet "$v"; return 0; fi
  if [ -L "$src" ] || [ ! -f "$src" ]; then _tba_build_copy_refuse build-not-regular "$v"; return 0; fi
  size="$(_plat_size "$src" 2>/dev/null)" || size=""
  [[ "$size" =~ ^[0-9]+$ ]] || { _tba_build_copy_refuse build-copy-failed "$v: size unread"; return 0; }
  [ "$size" -le "$TBA_BUILD_COPY_MAX" ] || { _tba_build_copy_refuse build-too-large "$v: $size bytes"; return 0; }
  sum="$(_plat_sha256 "$src" 2>/dev/null)" || sum=""
  sum="${sum%% *}"
  [[ "$sum" =~ ^[0-9a-f]{64}$ ]] || { _tba_build_copy_refuse build-copy-failed "$v: hash unread"; return 0; }
  _tba_ra_precheck || { _tba_refuse "$TBA_CODE"; return 0; }
  root="$(_tba_state_get box_root 2>/dev/null)" || root=""
  : "${root:=$TBA_BOX_ROOT_DEFAULT}"
  [[ "$root" =~ ^/[A-Za-z0-9._/-]+$ ]] || { _tba_build_copy_refuse build-copy-failed "$v: the box root is not an absolute path"; return 0; }
  _tba_log "build-copy: begins ($v, $size bytes)"
  # copy: one box call; the box stages, hashes, and hands the checked bytes to its writer (the header's P1 to P4).
  _tba_cx_out sh -c "$TBA_BUILD_COPY_SH" sh "$root" "$v" "$sum" "$TBA_BUILD_WRITE_SH" <"$src"
  if [ "$CX_RC" != 0 ] || [ "${CX_OUT%$'\n'}" != installed ]; then
    case "$CX_RC" in
      4) TBA_CODE=build-hash-mismatch ;;
      5) TBA_CODE=build-store-refused ;;
      *) _tba_cx_fail "$CX_RC" build-copy-failed ;;
    esac
    _tba_build_copy_refuse "$TBA_CODE" "$v: the box"
    return 0
  fi
  _tba_log "build-copy: ok ($v)"
  _tba_ok "\"build\":\"$v\",\"sha256\":\"$sum\""
}
