#!/usr/bin/env bash
# testbox-build-copy — `ccrc testbox-admin build-copy --version=<build>`, the build capture's copy (capture runner spec
# docs/superpowers/specs/2026-11-22-build-capture-runner-design.md §2.2, Table 2, slug build-source-is-the-fleet). SOURCED by
# ccd/ccrc-testbox-admin, never run: it defines the sub's grammar check and its body, and uses the verb's lock, state, log,
# answers and box call (`_tba_short_lock`, `_tba_ra_precheck`, `_tba_cx_out`, `_tba_cx_fail`). It is a file of its own
# because the verb sits at its growth cap.
#
# A build waits for its capture only because a fleet session runs it, so this host already holds that exact build in Claude
# Code's versions directory. ccrc never downloads one: this sub copies the fleet's own copy to the test box, and the server's
# capture lane asks for it only after the box refused a capture `build-absent` (`shared/claudeBuildTrust.ts#captureNextAct`).
#   verify  (this host) the build file is read, never written: it must exist, be a regular file and not a link, and be at
#           most TBA_BUILD_COPY_MAX bytes; then it is hashed (SHA-256). Each refusal is its own code, and none reaches the box.
#   copy    (the box, ONE call) the bytes stream over the lane's one way to the box, and the box's own program does the rest.
#           Every check that needs no bytes, and the one repair, come first, so a lasting refusal costs no stream:
#           P4  the box root must be a real directory owned by root and not writable by group or other (so only root
#               changes the entries directly inside it); `results` (the installer's run-root step makes it) a real
#               directory of a user and a group that are not root, read as numbers: the service user, whose identity the
#               copy takes; `captures`, when present, a real directory of exactly that owner and group; anything else
#               refuses build-store-refused and changes nothing;
#           P2  the stage's parent (root's temporary folder) must be a real directory owned by root or sticky, and not under
#               the box root; the stage is a fresh directory only root can enter;
#           P1' a box installed before `captures` was in the installer's layout gets it here: root makes it, only when it is
#               absent, directly inside the box root just proved root's, with the installer's mode, owner and group (0750,
#               the service user). It is the one act under the box root that root makes (the tool sync never re-runs the
#               installer, so without it such a box has no `captures` until an operator acts);
#           P4' the writer's own store checks (below), asked first in a mode that changes nothing, under the same privilege
#               drop and with no stdin, so a store fault that stands refuses before any byte is read; the tree is the
#               service user's, so root never reads it, and the writer asks again before it writes;
#           then the stream:
#           P3  it hashes the very bytes it then hands over, in that same step, read from what it holds once the stage's
#               path is removed; a hash that differs refuses build-hash-mismatch before anything else under the box root;
#           P1  it hands them to a writer that runs as the service user, groups cleared, no inheritable capability, a reset
#               environment, in the box root (root changes into it first: the drop tool has no working-folder flag), so
#               every other directory, file, mode and rename under the box root is that user's own act;
#           P4  the writer refuses build-store-refused, changing nothing, when `captures` or `captures/builds` is a link or
#               not a directory, or where the build goes is a link or not a regular file;
#           and places the build at `<box root>/captures/builds/<version>`, mode 0555, owned by that user, which the capture
#           desk reads as the build being present. The stage is removed before the hash, and on every exit the box's
#           shell sees, a hangup and a termination included; a kill during the stream can leave one directory only root
#           can enter, in root's temporary folder. Each refusal says one word, which this host's log keeps.
# Nothing here writes this host's versions directory or Claude Code's launcher, and the box side writes only under the box's
# own root and its own stage. Short (one box call), under the verb's lock, recorded in no ledger row (the build's own row
# says what the copy came to). Its answer is `{"ok":true,"build":"<version>","sha256":"<hex>"}`.
#
# The box's two programs are one line each: `_tba_ssh` quotes each word with `%q`, and a newline would reach the box's login
# shell as bash's `$'...'`. The writer travels as one word of the call and runs under the copy program's privilege drop.

# The largest build ccrc copies: 1 GiB (a build is about 380 MB in 2026-11).
TBA_BUILD_COPY_MAX=$((1024 * 1024 * 1024))

# A Claude Code build, `shared/claudeVersion.ts#CLAUDE_VERSION`'s grammar: three decimal parts, no leading zero.
_tba_is_claude_version() { [[ "${1-}" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; }

# The fleet's own copy of <version>, where Claude Code keeps its builds on this host. Read only.
_tba_build_copy_src() { printf '%s/.local/share/claude/versions/%s' "$HOME" "$1"; }

# ── BOX-SIDE COMMANDS (begin) ── they run on the test box over ssh, never on this host: the box runs the fleet host's own
# distribution release (the preflight's `os` check), so its userland is GNU and util-linux's privilege drop is there. The
# macOS scan (server/test/macos-platform.test.ts) cuts this region and pins what is in it.
# The copy, as root: $1 the box root, $2 the build, $3 the hash this host took, $4 the writer; stdin the bytes. `installed`
# on success; otherwise one word on stdout naming what refused, and exit 5 (the store), 4 (the bytes differ) or 1.
# shellcheck disable=SC2016  # expanded by the box's sh, not here
TBA_BUILD_COPY_SH='set -e; r=${1%/}; e=$r/results; c=$r/captures; if [ -z "$r" ] || [ -L "$r" ] || [ ! -d "$r" ]; then echo box-root-kind; exit 5; fi; o=$(ls -ldn -- "$r" | awk '"'"'{print $3" "$4}'"'"'); [ "${o%% *}" = 0 ] || { echo box-root-owner; exit 5; }; case "$(ls -ldn -- "$r" | awk '"'"'{print $1}'"'"')" in ?????w*|????????w*) echo box-root-mode; exit 5;; esac; if [ -L "$e" ]; then echo results-link; exit 5; elif [ ! -e "$e" ]; then echo results-absent; exit 5; elif [ ! -d "$e" ]; then echo results-kind; exit 5; fi; o=$(ls -ldn -- "$e" | awk '"'"'{print $3" "$4}'"'"'); u=${o% *}; g=${o#* }; case "$u.$g" in *[!0-9.]*|*.) echo results-owner; exit 5;; esac; [ "$u" != 0 ] && [ "$g" != 0 ] || { echo results-owner; exit 5; }; if [ -L "$c" ]; then echo captures-link; exit 5; elif [ -e "$c" ] && [ ! -d "$c" ]; then echo captures-kind; exit 5; fi; p=${TMPDIR:-/tmp}; p=${p%/}; case "$p/" in "$r"/*) echo stage-under-root; exit 1;; esac; if [ -L "$p" ] || [ ! -d "$p" ]; then echo stage-parent; exit 1; fi; m=$(ls -ldn -- "$p" | awk '"'"'{print $1" "$3}'"'"'); case "$m" in ?????????[tT]*|*" 0") ;; *) echo stage-parent; exit 1;; esac; [ -e "$c" ] || install -d -m 0750 -o "$u" -g "$g" -- "$c"; [ "$(ls -ldn -- "$c" | awk '"'"'{print $3" "$4}'"'"')" = "$u $g" ] || { echo captures-owner; exit 5; }; (cd -- "$r" && exec setpriv --reuid="$u" --regid="$g" --clear-groups --inh-caps=-all --reset-env -- sh -c "$4" sh "$r" "$2" check </dev/null) || exit $?; umask 077; s=$(mktemp -d "$p/.ccrc-build-copy.XXXXXXXX"); trap '"'"'rm -rf -- "$s"'"'"' EXIT; trap '"'"'exit 1'"'"' HUP INT TERM; cat >"$s/b"; exec 3<"$s/b" 4<"$s/b"; rm -rf -- "$s"; h=$(sha256sum <&3); exec 3<&-; [ "${h%% *}" = "$3" ] || { echo hash; exit 4; }; cd -- "$r"; exec setpriv --reuid="$u" --regid="$g" --clear-groups --inh-caps=-all --reset-env -- sh -c "$4" sh "$r" "$2" <&4 4<&-'
# The writer, as the service user (the owner of results and captures): $1 the box root, $2 the build; stdin the bytes.
# Exit 5 with a word: the store. With $3 `check` it asks its store checks only, makes nothing and reads no stdin.
# shellcheck disable=SC2016  # expanded by the box's sh, not here
TBA_BUILD_WRITE_SH='set -e; umask 022; k=${3-}; c=$1/captures; d=$c/builds; f=$d/$2; for x in "$c" "$d"; do n=${x##*/}; if [ -L "$x" ]; then echo "$n-link"; exit 5; elif [ -e "$x" ]; then [ -d "$x" ] || { echo "$n-kind"; exit 5; }; elif [ "$k" != check ]; then mkdir -- "$x"; fi; done; if [ -L "$f" ]; then echo target-link; exit 5; elif [ -e "$f" ] && [ ! -f "$f" ]; then echo target-kind; exit 5; fi; [ "$k" != check ] || exit 0; t=$(mktemp "$d/.copy.XXXXXXXX"); cat >"$t" && chmod 0555 "$t" && mv -f -- "$t" "$f" || { rm -f -- "$t"; exit 1; }; echo installed'
# ── BOX-SIDE COMMANDS (end) ──────────────────────────────────────────────────────────────────────────────────────

_tba_build_copy_refuse() {   # <code> <log words> — the log line, then the answer
  _tba_log "build-copy: refused $1 ($2)"
  _tba_refuse "$1"
}

# build-copy --version=<build>
_tba_run_build-copy() {
  local v="" w src size sum root
  for w in "$@"; do case "$w" in --version=*) v="${w#*=}" ;; esac; done
  _tba_short_lock || return 0
  # verify, on this host: read only.
  src="$(_tba_build_copy_src "$v")"
  if [ ! -e "$src" ] && [ ! -L "$src" ]; then _tba_build_copy_refuse build-not-on-fleet "$v"; return 0; fi
  if [ -L "$src" ] || [ ! -f "$src" ]; then _tba_build_copy_refuse build-not-regular "$v"; return 0; fi
  size="$(_plat_size "$src" 2>/dev/null)" || size=""
  [[ "$size" =~ ^[0-9]+$ ]] || { _tba_build_copy_refuse build-copy-failed "$v: size unread"; return 0; }
  [ "$size" -le "$TBA_BUILD_COPY_MAX" ] || { _tba_build_copy_refuse build-too-large "$v: $size bytes"; return 0; }
  sum="$(_plat_sha256 "$src" 2>/dev/null)" || sum=""
  sum="${sum%% *}"
  [[ "$sum" =~ ^[0-9a-f]{64}$ ]] || { _tba_build_copy_refuse build-copy-failed "$v: hash unread"; return 0; }
  _tba_ra_precheck || { _tba_refuse "$TBA_CODE"; return 0; }
  root="$(_tba_state_get box_root 2>/dev/null)" || root=""
  : "${root:=$TBA_BOX_ROOT_DEFAULT}"
  [[ "$root" =~ ^/[A-Za-z0-9._/-]+$ ]] || { _tba_build_copy_refuse build-copy-failed "$v: the box root is not an absolute path"; return 0; }
  _tba_log "build-copy: begins ($v, $size bytes)"
  # copy: one box call; the box stages, hashes, and hands the checked bytes to its writer (the header's P1 to P4).
  _tba_cx_out sh -c "$TBA_BUILD_COPY_SH" sh "$root" "$v" "$sum" "$TBA_BUILD_WRITE_SH" <"$src"
  if [ "$CX_RC" != 0 ] || [ "${CX_OUT%$'\n'}" != installed ]; then
    case "$CX_RC" in
      4) TBA_CODE=build-hash-mismatch ;;
      5) TBA_CODE=build-store-refused ;;
      *) _tba_cx_fail "$CX_RC" build-copy-failed ;;
    esac
    w="${CX_OUT%%$'\n'*}"; [[ "$w" =~ ^[a-z-]{1,32}$ ]] || w=unsaid   # the box's own word, kept for the log
    _tba_build_copy_refuse "$TBA_CODE" "$v: the box: $w"
    return 0
  fi
  _tba_log "build-copy: ok ($v)"
  _tba_ok "\"build\":\"$v\",\"sha256\":\"$sum\""
}
