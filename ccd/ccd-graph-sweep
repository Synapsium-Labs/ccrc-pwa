#!/usr/bin/env bash
# ccd-graph-sweep — keep one AST graph fresh per git tree (spec §C). Serialized
# oneshot driven by ccd-graph-sweep.timer; every knob env-overridable for the
# test harness (CCRC_DOCTOR_GH_TIMEOUT precedent). HOME-derived roots, no
# override — HOME is the harness's isolation boundary, exactly as in ccd.
set -uo pipefail

REG="$HOME/.cc-sessions"
PROJECTS_ROOT="$HOME/projects"
WORKTREES_ROOT="$HOME/worktrees"
VENV="$HOME/.ccrc/graphify-venv"
ENGINE="$VENV/bin/graphify"
PIN_FILE="$HOME/.ccrc/graphify.pin"
CENSUS="$HOME/.ccrc/graph-sweep.json"
PAUSE="$HOME/.ccrc/graph-sweep-paused"
LOCK="$HOME/.ccrc/graph-sweep.lock"
: "${CCRC_GRAPH_BUILD_TIMEOUT:=600}"
: "${CCRC_GRAPH_BUDGET:=8}"
: "${CCRC_GRAPH_MAX_WORKERS:=4}"
: "${CCRC_GRAPH_STALE_ESCAPE_COMMITS:=20}"
: "${CCRC_GRAPH_STALE_ESCAPE_SECS:=21600}"

PIN="$(cat "$PIN_FILE" 2>/dev/null || true)"
STARTED="$(date -u +%FT%TZ)"
ROWS=()          # jq-ready per-tree objects
BUILT=0          # rebuilds this pass, against CCRC_GRAPH_BUDGET

_gs_row() {      # path outcome reason duration_ms
  ROWS+=("$(jq -cn --arg p "$1" --arg o "$2" --arg r "$3" --argjson d "${4:-0}" \
    '{path:$p, outcome:$o, reason:$r, duration_ms:$d}')")
}

_gs_finish() {   # pass-status ; exit-code
  local status="$1" rc="$2" tmp
  tmp="$(mktemp "$CENSUS.XXXXXX")"
  # NB: printf of an EMPTY array must emit nothing — a lone newline breaks
  # `jq -cs` (slurp of empty input is [], of "\n" is a parse error).
  { [ "${#ROWS[@]}" -gt 0 ] && printf '%s\n' "${ROWS[@]}"; true; } | jq -cs \
    --arg started "$STARTED" --arg finished "$(date -u +%FT%TZ)" \
    --arg pin "$PIN" --arg status "$status" \
    '{started:$started, finished:$finished, pin:$pin, status:$status, trees:.}' > "$tmp" \
    || { rm -f "$tmp"; echo "graph-sweep: census assembly failed" >&2; exit 1; }
  # append, keep last 10 passes, atomic
  jq -c --slurpfile p "$tmp" '.passes = ((.passes // []) + $p | .[-10:])' \
    "$CENSUS" 2>/dev/null > "$tmp.2" \
    || jq -cn --slurpfile p "$tmp" '{passes: $p}' > "$tmp.2"
  mv "$tmp.2" "$CENSUS"; rm -f "$tmp"
  exit "$rc"
}

# D-1367 — canonical path, or NOTHING. `realpath` and `readlink -f` are both
# acceptable on both userlands (macos-platform.test.ts refuses neither), but an
# EMPTY answer is the one thing this shim must never let a caller spend: two
# unmeasurable paths would compare equal, and "equal" is what admits a
# candidate as a tree. Every caller checks for empty and SKIPS.
_gs_realpath() {   # <path> -> its canonical path, or nothing at all
  local p=""
  p="$(realpath "$1" 2>/dev/null)" || p=""
  [ -n "$p" ] || p="$(readlink -f "$1" 2>/dev/null)" || p=""
  [ -n "$p" ] || return 1
  printf '%s' "$p"
}

# D-1562 — WHICH REGISTERED SESSION LIVES ON THIS TREE, ASKED ONCE AND ASKED BY
# REALPATH. The idle gate used to answer it inline with
# `[ "$(cat "$wd")" = "$tree" ]` — the registry's `<id>.workdir` TEXT against
# the census's glob spelling of the tree — and those two are the same string
# only by luck. `$PROJECTS_ROOT` on the live box is a symlink (`~/projects ->
# /data/projects`, itself a symlink onto the volume), so a project-root
# session's workdir reads the canonical name while the sweep names that same
# tree through `$HOME`. MEASURED 2026-09-05 against the live registry: 13 of 18
# workdirs match a census path as a string, 18 of 18 match by realpath — and
# the five that never matched are the five project-root and `.claude/worktrees`
# sessions, EXACTLY the trees the gate exists to protect from a build under a
# working session. Every one had read `idle` on every pass since the gate
# shipped; the O3 escape hatch never got a say. Same shape as D-1367's realpath
# dedupe and D-1449's "compare git's truth, not its quoting".
#
# An unreadable or unresolvable workdir is SKIPPED, never matched: _gs_realpath
# answers nothing rather than empty-equals-empty (its own contract), and two
# unmeasurable paths comparing equal is what would hand a tree the wrong
# session. D-1563 asks this same question of a `.claude/worktrees` candidate,
# which is why it lives here and not inside the gate.
_gs_session_on() {   # <tree> -> the session id whose workdir names it, or nothing
  local tree="$1" want wd txt
  want="$(_gs_realpath "$tree")" || return 1
  for wd in "$REG"/*.workdir; do
    [ -f "$wd" ] || continue
    txt="$(cat "$wd" 2>/dev/null)" || continue
    [ -n "$txt" ] || continue
    txt="$(_gs_realpath "$txt")" || continue
    [ "$txt" = "$want" ] || continue
    basename "$wd" .workdir
    return 0
  done
  return 1
}

# D-1367 — A TREE IS A TOPLEVEL, NEVER A DIRECTORY INSIDE ONE.
#
# The old predicate was `git rev-parse --is-inside-work-tree`, which is true of
# every subdirectory of every work tree — and the glob pair asked it of one
# level under $PROJECTS_ROOT and TWO under $WORKTREES_ROOT. A worktree that
# lives at depth 1 (`~/worktrees/<name>`, its own toplevel) was therefore never
# discovered, while every one of its immediate subdirectories was, `.git`
# included. The sweep then built a graph into each of them. MEASURED on the
# live fleet 2026-09-03: 8 stray `graphify-out/` directories under one
# worktree — `node_modules/graphify-out` and `graphify-out/graphify-out` among
# them — plus two `failed` census rows every pass, for ever.
#
# The question a candidate has to answer is not "are you inside a tree" but
# "ARE YOU A TREE": the realpath of its own `--show-toplevel` is the realpath
# of itself. `$WORKTREES_ROOT`/*/ joins the glob so the depth-1 shape is asked
# at all.
#
# D-1370 — WHAT THE DEDUPE IS ACTUALLY FOR, AND WHICH NAME SURVIVES IT. The
# three globs are DISJOINT as paths: `~/worktrees/a/b` is never `~/worktrees/c`
# and never `~/projects/c`, so no candidate is ever globbed twice and the
# "the two worktree globs now overlap" rationale this comment used to carry was
# false. The one thing that does collapse two candidates onto one tree is a
# SYMLINK — an alias under one root pointing at a real tree under another —
# and there the survivor must be a DECISION, because glob order alone hands it
# to whichever root is listed first ($PROJECTS_ROOT), i.e. to the alias.
#
# That matters because of the contract in the next paragraph: the row keeps the
# path AS GLOBBED, not the canonical one — the hook's `cwd` is compared against
# it VERBATIM (`ccd/session-hook.sh`'s `.path == $p` census lookup), and
# canonicalising the census would silently unmatch that reader. A census
# carrying the ALIAS unmatches it just as silently for a session recorded under
# the real name: no "the sweep refused this tree" card. (The idle gate was the
# other such reader until D-1562 taught it to compare realpaths; the card's
# lookup still is.)
# MEASURED: with a real tree at `~/worktrees/foo` and `~/projects/foo` a
# symlink to it, the pass carried exactly one row and it was the alias.
#
# D-1371 — AND THE PREDICATE THAT ASKS IT. The first spelling of that decision
# was `[ "$d" = "$real" ]` — "is this candidate spelled as its own realpath" —
# which is INERT on the shape the fleet actually has. `$PROJECTS_ROOT` on the
# live box is itself a symlink (`~/projects -> /data/projects`, `/data ->
# /mnt/…`), so NO candidate under it can ever equal its own realpath, nothing
# is ever preferred, the survivor falls back to glob order, and the alias wins:
# exactly the failure this entry was written to stop. It measured green only
# because the fixture roots are real directories under /tmp.
#
# The question is about the candidate's OWN last component, not its ancestry:
# prefer the name that is not ITSELF a symlink, and displace only an entry that
# IS one. Two aliases (or two names under symlinked ancestors) leave the
# first-seen standing — there the names are equally arbitrary and only the
# count matters.
#
# D-1510 — AND CLAUDE CODE'S OWN WORKTREES ARE TREES. `EnterWorktree` puts a
# session's worktree at `<repo>/.claude/worktrees/<name>`, a real toplevel at a
# depth none of the first three globs reaches, so the sweep never saw it and
# nothing ever rebuilt its graph. MEASURED on the live fleet 2026-09-05: a
# session in `$PROJECTS_ROOT/<repo>/.claude/worktrees/<name>` over a graph.json
# a week old with no `.graphify_engine` beside it — not this sweep's build —
# reading fresh only because no commit had landed there yet. The last THREE
# globs below ask the same toplevel question of that shape — one per shape of
# workspace the fleet has, because `$WORKTREES_ROOT/<name>` is itself a toplevel
# (D-1367) and its `.claude/worktrees/<x>` therefore sits one level shallower
# than a depth-2 workspace's (review finding: the depth-1 shape was missed).
# Nothing else changes (the noise-list key is the basename of
# `--git-common-dir`'s parent, so it already resolves to the PARENT project, and
# the default noise list withholds `.claude/` from the parent's own corpus
# unless that repo tracks files there).
#
# D-1563 — AND ONE IS A TREE ONLY WHILE A SESSION LIVES IN IT. D-1510's three
# globs found 15 directories on the live fleet, 14 of them git toplevels: ONE
# named worktree with a registered session (the tree D-1510 was written for),
# three named ones with no session, and TEN minted by Claude Code's own
# isolation — `agent-<hex>` subagent worktrees and `wf_<run>-<n>` workflow
# ones, six touched within the hour and five a fortnight old. The pass built
# eight of them cold at ~75 s each, ran eleven minutes against the two it took
# before, and recorded `skipped-budget` for eight trees — the one the rule was
# written for among them. Every future workflow with worktree isolation would
# mint more. The rule that was missing is the one the idle gate already states:
# A TREE IS WORTH A BUILD BECAUSE A SESSION LIVES IN IT. So a candidate under
# `.claude/worktrees/` is kept only while some `$REG/<id>.workdir` names it,
# `_gs_realpath` on both sides (D-1562's comparison, spelled once). The
# project roots and the ccd workspaces are unchanged — the operator put those
# there. A subagent's `agent-*` worktree is never a session's workdir, so it is
# never built; a named worktree a session later enters is picked up next pass.
_gs_trees() {    # every git working TOPLEVEL under the two roots, once each
  local d top real i dup
  local -a seen=() named=()
  for d in "$PROJECTS_ROOT"/*/ "$WORKTREES_ROOT"/*/ "$WORKTREES_ROOT"/*/*/ \
           "$PROJECTS_ROOT"/*/.claude/worktrees/*/ \
           "$WORKTREES_ROOT"/*/.claude/worktrees/*/ \
           "$WORKTREES_ROOT"/*/*/.claude/worktrees/*/; do
    [ -d "$d" ] || continue
    d="${d%/}"
    top="$(git -C "$d" rev-parse --show-toplevel 2>/dev/null)" || continue
    [ -n "$top" ] || continue
    top="$(_gs_realpath "$top")" || continue
    real="$(_gs_realpath "$d")" || continue
    [ "$top" = "$real" ] || continue
    # D-1563: the path decides, not which glob produced it — a candidate under
    # `.claude/worktrees/` is Claude Code's, and it is a tree only while a
    # registered session lives in it.
    case "$d" in
      */.claude/worktrees/*) _gs_session_on "$d" >/dev/null || continue ;;
    esac
    dup=-1
    if [ "${#seen[@]}" -gt 0 ]; then
      for i in "${!seen[@]}"; do
        if [ "${seen[$i]}" = "$real" ]; then dup="$i"; break; fi
      done
    fi
    if [ "$dup" -ge 0 ]; then
      # already censused under another name: the real name displaces an alias,
      # nothing displaces the real name (D-1371).
      if [ ! -L "$d" ] && [ -L "${named[$dup]}" ]; then named["$dup"]="$d"; fi
      continue
    fi
    seen+=("$real"); named+=("$d")
  done
  [ "${#named[@]}" -gt 0 ] && printf '%s\n' "${named[@]}"
  return 0
}

# D-1368 — FRESHNESS IS CONTENT, NOT COMMIT IDENTITY. This file's ONE spelling
# of that predicate; `_gs_stale` and `_gs_busy` both ask it here.
#
# `built_at_commit != HEAD` was spent as "the graph is of another commit", and
# after a squash merge — or any rewrite that keeps the tree — that is false:
# HEAD's tree is byte-identical to the built commit's, so the graph describes
# THIS tree exactly. graphify's own `update` then writes nothing, the stamp
# keeps the old sha, and every pass records `stale-rebuilt` for that tree for
# ever. MEASURED on the live fleet 2026-09-03: graph.json mtime 01:18, census
# "stale-rebuilt … head" at 16:09, built 0281e084 vs HEAD 6a26a9a3, and
# `git rev-parse 0281e084^{tree} 6a26a9a3^{tree}` identical.
#
# EITHER SIDE ANSWERING EMPTY IS NOT A MATCH. The built commit may have been
# garbage-collected, in which case the content cannot be compared at all and
# the tree falls through to today's behaviour (stale, reason `head`) rather
# than to a freshness nobody measured — the same rule the card's own freshness
# clause states ("staleness is measured or it is not claimed").
_gs_same_tree() {   # <tree> <built-sha> -> 0 iff built's tree == HEAD's tree
  local t="$1" bt ht
  # D-1369 — THE BUILT SHA IS REPO-CONTROLLED TEXT, AND THIS IS THE FIRST PLACE
  # THE SWEEP SPENDS IT AS A GIT REVISION. `built_at_commit` comes out of a
  # graph.json any tree can write; the old `[ "$built" = "$head" ]` compared it
  # as a STRING, where a rev NAME is simply unequal and the tree rebuilds. A
  # peel resolves it: `HEAD^{tree}` on both sides of an equality is trivially
  # equal, so a graph stamped `"built_at_commit":"HEAD"` (or `@`, or a branch
  # name) would read `fresh` for ever and never be rebuilt again — the mirror
  # image of the wedge D-1368 was written to fix, and invisible in the census
  # because `fresh` is what it reports. The card already holds this contract
  # one line earlier than its own peel (`ccd/session-hook.sh`:
  # `[[ "$built" =~ ^[0-9a-f]{7,40}$ ]] || built=""`); the sweep holds it here.
  # MEASURED against the shipped script with a fixture HOME: `built_at_commit`
  # `HEAD` plus a real content commit read `fresh`, engine calls 1.
  [[ "$2" =~ ^[0-9a-f]{7,40}$ ]] || return 1
  bt="$(git -C "$t" rev-parse --verify -q "$2^{tree}" 2>/dev/null)" || bt=""
  ht="$(git -C "$t" rev-parse --verify -q 'HEAD^{tree}' 2>/dev/null)" || ht=""
  [ -n "$bt" ] && [ -n "$ht" ] && [ "$bt" = "$ht" ]
}

# D-1509 — ONE SPELLING OF "THE STAMP". `built_at_commit` is read by the
# freshness predicate, by the idle gate's escape hatch and — since D-1509 — by
# the build itself, which re-measures it to find out whether the engine wrote
# anything at all. Three hand-written `jq -r '.built_at_commit // empty'` reads
# are three places a later change can part; the restamp splices the value this
# helper reads, so a second spelling here is a restamp that verifies one field
# and rewrites another.
_gs_stamp() {    # <tree> -> graph.json's built_at_commit, or nothing
  jq -r '.built_at_commit // empty' "$1/graphify-out/graph.json" 2>/dev/null
}

_gs_stale() {    # tree -> 0 stale / 1 fresh ; REASON set
  local tree="$1" head built pin_stamp
  head="$(git -C "$tree" rev-parse HEAD 2>/dev/null)" || { REASON=unreadable-head; return 0; }
  [ -f "$tree/graphify-out/graph.json" ] || { REASON=never-built; return 0; }
  built="$(_gs_stamp "$tree")"
  pin_stamp="$(cat "$tree/graphify-out/.graphify_engine" 2>/dev/null || true)"
  [ "$pin_stamp" = "$PIN" ] || { REASON=engine; return 0; }
  if [ "$built" != "$head" ]; then
    _gs_same_tree "$tree" "$built" || { REASON=head; return 0; }
  fi
  return 1
}

# Idle gate (spec §C.5 + R2). READ-ONLY against $REG. Authority is the live
# status file; hookstate is the pointer to it plus a freshness guard — gating
# on hookstate.state alone is bug F6b, already fixed once (watch.ts:2029-2041).
# O5: ws-audit persists no artifact (Task 0); reap's own state-changed refusal
# is the fail-safe (ledger R-1).
: "${CCRC_GRAPH_HOOKSTATE_FRESH_SECS:=1800}"
BUSY_OUTCOME=""; BUSY_REASON=""
_gs_busy() {
  local tree="$1" id="" hs pid wrapper cfg sf now age
  # D-1562 — one spelling of "which session lives here", and it compares
  # realpaths: the registry and the census need not spell a tree alike.
  id="$(_gs_session_on "$tree")" || id=""
  [ -n "$id" ] || return 1                       # no session on this tree -> idle
  hs="$REG/$id.hookstate.json"
  [ -f "$hs" ] || return 1
  now=$(date +%s); age=$(( now - $(stat -c %Y "$hs") ))
  [ "$age" -le "$CCRC_GRAPH_HOOKSTATE_FRESH_SECS" ] || return 1   # stale pointer -> idle
  pid="$(jq -r '.pid // empty' "$hs" 2>/dev/null)"; [ -n "$pid" ] || return 1
  wrapper="$(cat "$REG/$id.wrapper" 2>/dev/null)"; [ -n "$wrapper" ] || return 1
  # shellcheck source=/dev/null
  source "$HOME/.ccrc/accounts.sh" 2>/dev/null || return 1
  cfg="$(_ccrc_cfg_dir "$wrapper" 2>/dev/null)" || return 1
  sf="$cfg/sessions/$pid.json"
  [ -f "$sf" ] || return 1
  [ "$(jq -r '.state // empty' "$sf" 2>/dev/null)" = working ] || return 1
  # O3 escape hatch: bounded staleness beats politeness past the thresholds.
  local built commits stamp_age
  built="$(_gs_stamp "$tree")"
  if [ -n "$built" ]; then
    # D-1368: the same predicate, once more and spelled once — `rev-list
    # --count "$built..HEAD"` for a NON-ANCESTOR counts everything since the
    # merge-base, so a squashed history could fire the build-anyway escape
    # against a graph that is already of HEAD's content.
    if _gs_same_tree "$tree" "$built"; then
      commits=0
    else
      commits="$(git -C "$tree" rev-list --count "$built..HEAD" 2>/dev/null || echo 0)"
    fi
    stamp_age=$(( now - $(stat -c %Y "$tree/graphify-out/.graphify_engine" 2>/dev/null || echo "$now") ))
    if [ "$commits" -ge "$CCRC_GRAPH_STALE_ESCAPE_COMMITS" ] \
       || [ "$stamp_age" -ge "$CCRC_GRAPH_STALE_ESCAPE_SECS" ]; then
      return 1                                   # build anyway
    fi
  fi
  BUSY_OUTCOME=skipped-busy; BUSY_REASON="session $id working"
  return 0
}

# Pre-build corpus guard (spec §E): there is NO publish seam — to_json writes
# graph.json in place — so the only refusal that protects the previous graph
# is refusing to RUN the build. Corpus definition: every detect() path must be
# git-tracked; graphify-out/memory/ is exempt (detect.py:1101 re-adds it by
# design and it is untracked by design).
GUARD_REASON=""
# A .graphifyignore is OURS only if its first line carries the generated
# marker (finding 1, whole-branch review): a repo that adopts graphify
# upstream may COMMIT a .graphifyignore of its own — tracked, so ignore rules
# don't protect it — and this sweep must never delete or clobber a file it did
# not write, on a 15-minute timer, forever. Absence counts as "ours" (nothing
# to protect); presence without the marker means foreign, hands off.
_gs_owns_ignore() {   # tree -> 0 (absent or ours) / 1 (foreign — leave alone)
  local f="$1/.graphifyignore"
  [ -f "$f" ] || return 0
  head -n1 "$f" 2>/dev/null | grep -q '^# generated by ccd-graph-sweep' && return 0
  return 1
}

# D-1161 — the generated filter's cleanup, as a NAMED pair, because the trap
# that removed it inline was wrong in two ways that only became reachable when
# D-1160 shipped a default list to every box.
#
#  1. It interpolated `$tree` at FIRE time from whatever scope was current.
#     After the sweep loop hits EOF `tree` is EMPTY, so a leaked EXIT trap ran
#     `rm -f /.graphifyignore` — at the filesystem root, every pass. Measured.
#  2. Its `rm` was the one removal site in this file NOT ownership-gated, so a
#     SIGTERM mid-pass (a systemd stop, a reboot) deleted whatever
#     `.graphifyignore` the tree in flight happened to own — including a
#     tracked one the repo committed. Measured: `git status` reported
#     ` D .graphifyignore` afterwards.
#
# Both are now structural: the tree is carried in a GLOBAL set at arm time, and
# the removal re-checks ownership at FIRE time like every other removal site.
GS_FILTER_TREE=""
_gs_rm_generated() {   # remove ONLY a filter this sweep generated — never a foreign file
  local t="${1:-}"
  [ -n "$t" ] || return 0          # empty tree => the root-level rm; never
  _gs_owns_ignore "$t" || return 0 # foreign => hands off
  rm -f "$t/.graphifyignore"
}
_gs_disarm() { trap - EXIT INT TERM; GS_FILTER_TREE=""; }

# D-1458 — the generated filter is opened ONCE and appended to, because it is
# now written in two steps (the noise patterns, then whatever the first
# measurement proves the corpus needs). Idempotent: the header — the ownership
# marker `_gs_owns_ignore` and `_gs_rm_generated` both read — is written only
# when the file is ABSENT (by the time the test below runs, "absent or ours" is
# all that can reach it), and the trap is (re-)armed either way.
# D-1459 — a FOREIGN `.graphifyignore` is refused HERE, in the helper, and not
# only by the two callers' preconditions. Both callers still carry theirs (RULE
# 2 empties `patterns`; the derivation skips on `foreign`), so this line is
# unreachable today — but before D-1458 the single write site carried the
# ownership test INLINE, and moving the write into a shared helper turned a
# mechanism into a comment enumerating the callers it trusts, an enumeration
# that goes stale the moment a third appears. Refusing costs the happy paths
# nothing (`_gs_owns_ignore` already answers 0 for "absent or ours"), and the
# failure it forecloses is D-1161's one step worse: the marker header written
# over a TRACKED file, which `_gs_rm_generated` — reading its own marker on what
# is now a marker-bearing file — then DELETES at exit. Callers MUST treat a
# non-zero return as "no filter written, append nothing".
_gs_open_filter() {   # tree -> 0 filter open (trap armed) / 1 foreign, nothing written
  _gs_owns_ignore "$1" || return 1
  if [ ! -f "$1/.graphifyignore" ]; then
    echo "# generated by ccd-graph-sweep for one build — never committed, never edited" > "$1/.graphifyignore"
  fi
  GS_FILTER_TREE="$1"
  trap '_gs_rm_generated "$GS_FILTER_TREE"' EXIT INT TERM
}

# The corpus, as detect() would ingest it from this tree right now — read
# through whatever `.graphifyignore` is in place at the moment of the call.
# Named because D-1458 calls it twice: once over the noise patterns alone, and
# again only if that first answer proves something has to be derived.
_gs_detect() {   # tree -> one relative path per line
  ( cd "$1" && "$VENV/bin/python" - <<'GFXPY' 2>/dev/null
import os
from pathlib import Path
from graphify.detect import detect
r = detect(Path('.')); root = os.path.abspath('.')
for k in ('code','document','paper','image','video'):
    for f in r['files'].get(k, []):
        print(os.path.relpath(f, root))
GFXPY
  )
}

# corpus minus tracked, less the query results detect re-adds whatever the
# ignore rules say (detect.py:1160-1166). Named for the same reason as
# `_gs_detect`: the breach is measured before the derivation and again after.
_gs_breach() {   # corpus tracked -> the corpus paths git does not track
  comm -23 <(sort -u <<<"$1") <(sort -u <<<"$2") | grep -v '^graphify-out/memory/' || true
}
_gs_guard() {
  local tree="$1" repo noise="" line
  repo="$(basename "$(dirname "$(git -C "$tree" rev-parse --path-format=absolute --git-common-dir)")")"
  # stray filter from a crashed pass: remove it BEFORE measuring anything —
  # but only OUR OWN leftover (marker-bearing); a foreign .graphifyignore this
  # repo owns (e.g. committed upstream) is never ours to delete.
  _gs_owns_ignore "$tree" && rm -f "$tree/.graphifyignore"
  # D-1160 — TWO NOISE SOURCES, UNIONED, default first.
  #
  # `_default.list` is ccrc's own footprint (`.remember/`, `.superpowers/`,
  # `.claude/`, `CLAUDE.local.md`) and ccrc owns it; `<repo>.list` is the
  # operator's and ccrc never writes it. Before the default existed, the
  # artifacts ccrc's OWN skills write into every repo a session touches were
  # held against that repo by the corpus guard, refusing its build for ever —
  # measured on the reference fleet as 14 of 57 trees refused, 186 of 304
  # breach paths being those four names, and five repos blocked by nothing but
  # ccrc's own mess.
  #
  # The '!' check runs over EVERY source, not just the last: a negation in
  # either file re-includes gitignored paths (spec §3.6), and a default that
  # could smuggle one past a per-repo check would be worse than no default.
  local def="$HOME/.ccrc/graph-noise/_default.list"
  local own="$HOME/.ccrc/graph-noise/$repo.list"
  local -a noise_files=()
  [ -f "$def" ] && noise_files+=("$def")
  [ -f "$own" ] && noise_files+=("$own")
  # RULE 1 — a '!' in EITHER source refuses the build. Checked over every
  # source, not just the last: a negation re-includes gitignored files (spec
  # §3.6), and a default that could smuggle one past a per-repo check would be
  # worse than shipping no default at all. This one rule is symmetric because a
  # negation is not an instruction the operator can be entitled to either.
  for noise in "${noise_files[@]}"; do
    if grep -qE '^[[:space:]]*!' "$noise"; then
      GUARD_REASON="noise list $noise carries a '!' line — a negation re-includes gitignored files (spec §3.6); refusing"
      return 1
    fi
  done
  # RULE 2 — a foreign `.graphifyignore` refuses ONLY when the operator wrote a
  # list for this repo. D-1161: before this asymmetry existed, shipping the
  # default to every box made this refusal universal, and any repo that COMMITS
  # its own `.graphifyignore` — the exact case `_gs_owns_ignore` was written to
  # protect — became `refused-by-guard` for ever, with no remedy on the box.
  # Measured: the same fixture built on origin/main and was refused here.
  # An operator's list is an instruction about THIS repo that cannot be
  # honoured, so it refuses; the default is hygiene the repo never asked for,
  # and hygiene yields to a repo that has stated its own corpus policy.
  local foreign=0
  if [ -f "$tree/.graphifyignore" ] && ! _gs_owns_ignore "$tree"; then
    if [ -f "$own" ]; then
      GUARD_REASON="$tree/.graphifyignore exists and was not written by ccd-graph-sweep — refusing to overwrite a file this tree owns"
      return 1
    fi
    noise_files=(); foreign=1
  fi
  # RULE 3 — a DEFAULT pattern is withheld when this repo TRACKS anything it
  # would hide; an operator pattern is honoured as written. D-1161: a
  # `.graphifyignore` is a pure path filter that knows nothing about git, so
  # the default list's own stated contract — "only what ccrc and its skills
  # create" — was a comment, not a mechanism. In a repo that COMMITS
  # `.claude/settings.json` (seven do on the reference fleet, three of them
  # among the five D-1160 set out to unblock) the default silently dropped
  # TRACKED nodes from the corpus; graphify's shrink guard then saw a net loss
  # with `had_explicit_deletions=False` and refused the write, wedging the tree
  # at `refused-shrink` on every pass — strictly worse than the staleness
  # D-1160 was fixing. The collision test is git's own
  # (`ls-files -c -i -X` = "tracked files these patterns would hide"), so it is
  # exact gitignore semantics rather than a reimplementation in bash.
  local -a patterns=()
  local withheld="" probe src pat
  if [ "${#noise_files[@]}" -gt 0 ]; then
    probe="$(mktemp)" || { GUARD_REASON="cannot create a temp file to test noise patterns"; return 1; }
    for src in "${noise_files[@]}"; do
      while IFS= read -r pat || [ -n "$pat" ]; do
        pat="${pat%$'\r'}"
        case "$pat" in ''|'#'*) continue ;; esac
        case "$pat" in *[![:space:]]*) ;; *) continue ;; esac
        if [ "$src" = "$own" ]; then patterns+=("$pat"); continue; fi
        printf '%s\n' "$pat" > "$probe"
        if [ -n "$(git -C "$tree" ls-files -c -i -X "$probe" 2>/dev/null | head -n1)" ]; then
          withheld="$withheld $pat"
        else
          patterns+=("$pat")
        fi
      done < "$src"
    done
    rm -f "$probe"
  fi
  # NOT SILENT. A withheld pattern means this repo keeps whatever ccrc wrote
  # into it in its corpus, so it may still be refused below for a path the
  # default would otherwise have covered — an operator reading the journal has
  # to be able to see why, and the remedy (a `<repo>.list`, which is honoured
  # as written) named.
  [ -n "$withheld" ] && echo "graph-sweep: $tree: default noise withheld, repo tracks matching files:$withheld (a $repo.list is honoured as written)" >&2
  # ── the corpus, measured with the noise filter alone (D-1458) ─────────────
  # The generated filter is now written in TWO steps: the noise patterns here,
  # and — only if this measurement finds a breach git itself ignores — the
  # derived entries below. Everything from here to the refusal is one loop:
  # measure, derive from what the measurement actually caught, measure again.
  # `&&` (D-1459): a refusal from `_gs_open_filter` means NO FILTER WAS WRITTEN
  # — the tree owns its own — so nothing may be appended either. RULE 2 has
  # already emptied `patterns` on such a tree; this is the belt behind it.
  if [ "${#patterns[@]}" -gt 0 ] && _gs_open_filter "$tree"; then
    printf '%s\n' "${patterns[@]}" >> "$tree/.graphifyignore"
  fi
  local corpus tracked breach breach_all breach_n
  corpus="$(_gs_detect "$tree")" || { GUARD_REASON="detect() failed in $tree"; return 1; }
  # D-1449, widened by D-1450 — COMPARE GIT'S TRUTH, NOT GIT'S QUOTING.
  # `ls-files` C-quotes a path (wrapping it in double quotes) in FOUR classes,
  # not one: a non-ASCII byte (`"J\303\240rn.py"`), a backslash
  # (`"back\\slash.py"`), a double quote (`"quo\"te.py"`) and any control byte
  # (`"tab\tname.py"`). detect() prints raw UTF-8 relative paths, so `comm -23`
  # read a TRACKED file as untracked and refused the tree for ever, with no
  # remedy on the box. Measured on the live fleet: mm-data refused over two
  # tracked files (a JSON named with a/o diacritics, a PNG named with an
  # umlaut). `-c core.quotepath=false` silences ONLY the non-ASCII class and
  # leaves the other three quoting exactly as before (measured), so the fix is
  # `-z`, which is raw for every class in one call and makes core.quotepath
  # irrelevant. The one shape `-z | tr` cannot represent is a newline inside a
  # filename — and that breaks the line-based corpus side identically, so the
  # two sides stay in step. The `ls-files -c -i -X` probe above quotes too, but
  # its output is only ever tested for EMPTINESS, never compared to a path, so
  # quoting cannot change its answer and it is left as it is.
  tracked="$(git -C "$tree" ls-files -z | tr '\0' '\n')"
  breach_all="$(_gs_breach "$corpus" "$tracked")"
  # D-1451 — WHAT GIT IGNORES NEVER ENTERS THE CORPUS. D-1458 — AND NOTHING
  # ELSE DOES, EITHER: the derivation is driven by the BREACH, not by git's
  # whole ignored census.
  #
  # detect() reads `.gitignore` only along the ANCESTOR CHAIN from the VCS root
  # down to the scan root (`_load_graphifyignore`, detect.py:793-836: it walks
  # `ceiling` → `root`, never below). A NESTED `.gitignore` under the scan root
  # is therefore never applied at all, so a gitignored build artifact enters the
  # corpus, is untracked, and this guard refuses the tree — for ever, with no
  # remedy on the box (nothing an operator does to the tree changes what detect
  # picks up, and `<repo>.list` does not apply because the path is not ccrc's
  # noise). MEASURED on the live fleet: synapsium-platform refused over
  # `frontend/exposynapse-site/.astro/settings.json` (ignored by
  # `frontend/exposynapse-site/.gitignore`), MekWarLive/swift-harbor over
  # `.husky/_/*` (ignored by `.husky/_/.gitignore`).
  #
  # D-1458 — A MEASURED COST WAS ACCEPTED INSTEAD OF REMOVED. D-1451..D-1453
  # derived EVERY path git ignores, and the ledger measured what that costs and
  # signed it off as "inside the timeout". MEASURED on the live fleet
  # (2026-09-04, custom-tools): 308 derived entries — 211 files under
  # `.superpowers/`, 59 under `tools/`, 24 under `.remember/`, because
  # `--directory` collapses a directory only when it holds no TRACKED file — and
  # detect spends ~50 us per (pattern, path) with the path re-resolved inside
  # the per-pattern loop (detect.py:891-895), so 308 entries over a 1938-file
  # corpus is ~600k matches, ~30 s added to EVERY pass over that tree. And the
  # value was near zero: detect() run read-only over that tree with no
  # ephemeral filter shows only 22 of the 308 entries cover a file it would
  # ingest AT ALL, every one of them under `.remember/`, which the DEFAULT
  # noise list already excludes. The three cases the derivation exists for
  # (`.astro/`, `.husky/_/`, `apps/web/static/parts/`) are ONE entry each.
  #
  # So derive what the corpus needs and nothing else. The breach — corpus ∖
  # tracked, already computed above for the refusal — is exactly the set of
  # paths where detect and git disagree; every other ignored path in the tree
  # is a pattern detect would evaluate against 1938 files to no effect. Ask git
  # whether each BREACH path is ignored (`check-ignore -z --stdin`, one call,
  # NUL-framed for the same four quoting classes as D-1450 — a non-ASCII name
  # must survive the round trip), and derive one entry per ignored one. On a
  # tree like custom-tools that is ZERO entries and ZERO extra cost; on the
  # trees this was written for it is one to three.
  #
  # Each entry is ANCHORED at the tree root with a leading `/` (detect.py:883-895
  # anchors on that, against the directory holding the file — here the root), a
  # directory keeping its trailing `/` so the ancestor walk (detect.py:924-931)
  # takes everything under it. Anchoring is not cosmetic: `build/` unanchored
  # matches at EVERY depth, which is how an ignored root `build/` would hide a
  # tracked `src/build/`.
  #
  # D-1452 lives on, inverted: git's `--directory` census still names the
  # directories it COLLAPSES (those holding no tracked file), and a breach path
  # under one is derived as THAT DIRECTORY instead of itself — so a whole
  # ignored tree costs one line however many of its files reached the corpus.
  # The census is only ever read when the breach holds something git ignores,
  # so the tree that has nothing to derive never pays for it either.
  #
  # The seam here is THREE-WAY, not two-way (D-1453, correcting D-1452): git
  # spells an entry as a PATH; the RULE-3 probe spends it as a WILDMATCH glob
  # (`git ls-files -X`, where `*` does NOT cross `/`); detect spends it as an
  # `fnmatch.fnmatch` glob (detect.py:866, anchored arm, where `*` DOES cross
  # `/`). A filename carrying a glob metacharacter parts all three, and the two
  # glob dialects part from each other — so the probe alone CANNOT stand in for
  # detect. MEASURED: `.gitignore` `/a\*.py` (a LITERAL star) with a tracked
  # `ax/b.py` and an untracked `a*.py` — git derives `a*.py`; the probe answers
  # EMPTY (wildmatch will not let `*` cross the `/` in `ax/b.py`), so the entry
  # is kept; and real detect (0.9.9) then returns ['keep.py'] where it returned
  # ['a*.py', 'ax/b.py', 'keep.py'] — the TRACKED `ax/b.py` is gone from the
  # corpus, SILENTLY: no withheld line, no breach, exit 0. That is exactly the
  # wedge graph-noise.default.list's D-1160/D-1161 header names (shrink guard
  # sees an unaccounted net loss and every pass ends `refused-shrink`).
  #
  # So make the entry LITERAL IN BOTH DIALECTS before anyone spends it:
  # neutralize each metacharacter into a single-character class — `[` -> `[[]`
  # first (so the brackets the next two insert are not re-escaped), then
  # `*` -> `[*]`, `?` -> `[?]`. Both wildmatch and fnmatch read `[*]` as one
  # literal star. Measured on the same fixture: with `/a[*].py` the probe still
  # reports no tracked file AND detect returns ['ax/b.py', 'keep.py'] — the
  # tracked file survives, the untracked `a*.py` is still excluded.
  #
  # The RULE-3 probe stays, and is now a genuine belt rather than the load-
  # bearing member the previous comment claimed: after neutralization an entry
  # matches exactly the path git named (plus, for a collapsed directory, its
  # subtree). Its one remaining reachable class is the OTHER dialect gap, and
  # it errs SAFE there: a backslash is literal to fnmatch but an ESCAPE to
  # wildmatch, so an ignored untracked `a\b.log` beside a tracked `ab.log` makes
  # the probe fire on a file detect would never have hidden — withheld and
  # reported, and the tree is then refused over that path in the open rather
  # than losing a tracked file in silence. A test pins that row. The probe runs
  # ONCE over the whole set in the common case (git's answer over a union is
  # empty iff it is empty for every member), and only falls back to one call per
  # entry when that union is non-empty, i.e. when there is a culprit.
  #
  # Not capped: a capped list is a corpus this guard cannot explain. The count
  # is logged instead — and it is now a count of what the corpus needed, so a
  # tree that logs nothing is a tree that cost nothing.
  # The `foreign` skip keeps this derivation away from a repo's own COMMITTED
  # `.graphifyignore` — and since D-1459 it is no longer the ONLY thing doing
  # so: `_gs_open_filter` refuses a foreign tree itself, so deleting this skip
  # costs the file nothing (the derivation runs and then writes nowhere). What
  # this skip still owns is the WORK: on a tree the sweep may not filter, none
  # of it is worth doing. Pinned by ownership row (d), the only ownership
  # fixture carrying a gitignored untracked path IN THE CORPUS — i.e. the only
  # one where the derivation has anything to write — through the stderr line
  # that only a derivation which RAN can print.
  local -a derived=()
  local dheld="" e esc
  if [ -n "$breach_all" ] && [ "$foreign" -eq 0 ]; then
    local -a ignored=()
    # ONE call over the whole breach. `-z` makes input AND output NUL-framed,
    # so a non-ASCII or backslash-bearing name survives the round trip raw
    # (D-1450's four classes).
    #
    # `--no-index` is LOAD-BEARING, not tidiness. Without it `check-ignore`
    # first drops every input the index matches — and it matches it as a
    # PATHSPEC, not as a pathname, so a filename carrying a glob metacharacter
    # is dropped because some OTHER, tracked file matches it. MEASURED (git
    # 2.43.0) on D-1453's own fixture: with a tracked `ax/b.py` and an ignored
    # untracked `a*.py`, `check-ignore --stdin` answers NOTHING for `a*.py`
    # (exit 1) while `--no-index` correctly answers `.gitignore:1:/a\*.py`;
    # same for `a\b.log` beside a tracked `ab.log`, where the backslash is a
    # pathspec escape. Skipping the index costs nothing here: the input IS the
    # breach, i.e. corpus paths git does not track, so a tracked path can never
    # reach this call in the first place.
    while IFS= read -r e; do
      [ -n "$e" ] && ignored+=("$e")
    done < <(printf '%s\n' "$breach_all" | tr '\n' '\0' \
             | git -C "$tree" check-ignore --no-index -z --stdin 2>/dev/null | tr '\0' '\n')
    if [ "${#ignored[@]}" -gt 0 ]; then
      # The collapsed-directory census, read ONLY now that something needs it.
      local -A dirset=() seenent=()
      local -a entries=()
      local p acc rest
      while IFS= read -r e; do
        case "$e" in */) dirset["$e"]=1 ;; esac
      done < <(git -C "$tree" ls-files -o -i --exclude-standard --directory -z 2>/dev/null | tr '\0' '\n')
      for p in "${ignored[@]}"; do
        # the OUTERMOST collapsed ancestor wins — it covers the most subtree
        # for one entry. Walking prefixes is O(depth), never entries x dirs.
        acc=""; rest="$p"
        while [ -n "$rest" ]; do
          case "$rest" in */*) acc="$acc${rest%%/*}/"; rest="${rest#*/}" ;; *) break ;; esac
          if [ -n "${dirset["$acc"]+x}" ]; then p="$acc"; break; fi
        done
        [ -n "${seenent["$p"]+x}" ] && continue
        seenent["$p"]=1; entries+=("$p")
      done
      for e in "${entries[@]}"; do
        # literal in BOTH glob dialects before the probe or detect sees it —
        # see the three-way-seam note above. `[` first, then `*`, then `?`.
        esc="${e//\[/[[]}"; esc="${esc//\*/[*]}"; esc="${esc//\?/[?]}"
        derived+=("/$esc")
      done
    fi
    if [ "${#derived[@]}" -gt 0 ]; then
      probe="$(mktemp)" || { GUARD_REASON="cannot create a temp file to test derived ignore entries"; return 1; }
      printf '%s\n' "${derived[@]}" > "$probe"
      if [ -n "$(git -C "$tree" ls-files -c -i -X "$probe" 2>/dev/null | head -n1)" ]; then
        local -a kept=()
        for e in "${derived[@]}"; do
          printf '%s\n' "$e" > "$probe"
          if [ -n "$(git -C "$tree" ls-files -c -i -X "$probe" 2>/dev/null | head -n1)" ]; then
            dheld="$dheld $e"
          else
            kept+=("$e")
          fi
        done
        derived=(${kept[@]+"${kept[@]}"})
      fi
      rm -f "$probe"
    fi
  fi
  # NOT SILENT either — and a withheld derived entry is a stronger signal than a
  # withheld default: it means git's own verdicts disagree with git's own index
  # about a path, so the tree WILL be refused below for that path (it is in the
  # corpus; that is why it was derived at all).
  [ -n "$dheld" ] && echo "graph-sweep: $tree: derived ignore entries withheld, repo tracks matching files:$dheld" >&2
  [ "${#derived[@]}" -gt 0 ] && echo "graph-sweep: $tree: git-ignored entries derived into the corpus filter: ${#derived[@]}" >&2
  # The SECOND detect() run, and the only one this fix ever adds — reached only
  # when something was derived, i.e. when the first measurement caught a path
  # git ignores. Without it the derivation would be inert: the census below
  # re-reads `corpus`, and the breach it saw the first time is still there.
  # `&&` again (D-1459): if the helper refuses, nothing was written, so nothing
  # is appended and nothing is re-measured — `breach_all` stands and the tree is
  # refused below over the very path the derivation would have filtered away,
  # which is the honest outcome for a repo whose filter this sweep may not touch.
  # WHAT IT COSTS, measured, not bounded by adjective (D-1458's timing table,
  # completed on review): on a deriving tree the FIRST run also pays, because it
  # sees the ignored subtree unfiltered. 2000 tracked files with a nested
  # `.gitignore` over a 5000-file ignored subtree — 4.4 s (step 1, 7000 files
  # ingested) + 1.4 s (here, 2000) against 1.4 s for the old single run, i.e.
  # ~+3 s, scaling with the IGNORED SUBTREE and paid only where the derivation
  # earns it. A tree that derives nothing runs detect() once, as it always did.
  if [ "${#derived[@]}" -gt 0 ] && _gs_open_filter "$tree"; then
    printf '%s\n' "${derived[@]}" >> "$tree/.graphifyignore"
    corpus="$(_gs_detect "$tree")" || { GUARD_REASON="detect() failed in $tree"; return 1; }
    breach_all="$(_gs_breach "$corpus" "$tracked")"
  fi
  # D-1454 — THE CAP STAYS, THE SIZE OF THE BREACH STOPS BEING A SECRET. Five
  # paths is all a census row can carry (it is read on a phone, and this one
  # line is the only place the refusal is ever stated), but "6 untracked paths"
  # and "60" are different problems with different remedies — one commit
  # against a corpus filter — and the capped reason spelled them identically.
  # So the FULL breach is computed once and the cap applied after, with the
  # remainder counted: `head -5` on its own can never report what it dropped.
  # `wc -l` over a non-empty capture is exact here — every line comm emits ends
  # in a newline, and the empty case never reaches it (the `-n` test above).
  if [ -n "$breach_all" ]; then
    breach="$(head -5 <<<"$breach_all")"
    breach_n="$(wc -l <<<"$breach_all")"
    breach_n="${breach_n//[![:digit:]]/}"   # BSD `wc` pads its count with spaces
    local more=""
    [ "${breach_n:-0}" -gt 5 ] && more="(+$((breach_n - 5)) more)"
    # NB the `tr` above leaves a TRAILING SPACE (the here-string's own final
    # newline becomes one), so the suffix needs no separator of its own and the
    # uncapped reason keeps the exact text it has always had.
    GUARD_REASON="untracked paths entered the corpus: $(tr '\n' ' ' <<<"$breach")$more"
    _gs_owns_ignore "$tree" && rm -f "$tree/.graphifyignore"
    return 1
  fi
  return 0
}

# D-1509 — THE SWEEP WRITES THE STAMP GRAPHIFY WOULD HAVE WRITTEN, AND ONLY
# THAT. Reached from `_gs_build` alone, and only after the engine exited 0 AND
# printed one of its two "left untouched" verdicts, each of which is a full
# fresh extraction of the disk compared against the graph on disk. graphify's
# own stamp is `_git_head()` at build time (export.py:537) whatever the working
# tree holds, so this splices exactly the value the engine skipped writing —
# it invents no freshness of its own (D-1511 records the hole that leaves, and
# the row names the dirty count so the census does not hide it).
#
# WHAT IT MAY TOUCH: `graph.json`'s last `built_at_commit` and
# `GRAPH_REPORT.md`'s "- Built from commit:" line. NEVER `manifest.json`,
# `cache/` or `.graphify_labels.json` — those are the engine's own fingerprints
# of the corpus, and a stamp is not a fingerprint.
#
# HOW IT WRITES: copy, splice, ONE rename. The card reads this file with
# `tail -c 4096` while the sweep runs (`ccd/session-hook.sh`:131), so an
# in-place rewrite of an 8 MB file is a torn read waiting for a session hook;
# `mv -f` over the same directory is atomic and a concurrent reader sees either
# file whole. The splice itself seeks to the tail's base offset and truncates,
# so a shorter or longer replacement sha is fine.
#
# WHAT IT REFUSES: a graph.json whose last `built_at_commit` in the tail is
# absent, or is not the value `_gs_stamp` measured before the engine ran (the
# file moved under us). Refusal writes NOTHING and the build reads `failed`.
# The report's absence is not a failure — it is graphify's human echo, not the
# stamp any reader in ccrc spends. Every refusal below is now a census reading
# a test spends (D-1509's second mutation table): outcome `failed`, a reason
# that NAMES it, graph.json byte-identical to what the pass found.
#
# AND WHAT IT NO LONGER REFUSES (D-1509, review finding). graph.json is renamed
# at the END of its own loop iteration, so a refusal raised for GRAPH_REPORT.md
# (unreadable file, an interpreter that dies, a failed rename) used to return 1
# over a graph.json ALREADY carrying HEAD: `failed` — a word the doctor's WARN
# set counts — for a tree whose stamp had advanced and which both readers then
# read as fresh. Two conditions on one census word. The report step is
# best-effort now (`_gs_restamp_refuse`): a miss there is one line in
# `graph-sweep.log` and the row still reads `restamped`. Every refusal that
# remains is raised for graph.json BEFORE its rename, so "refusal writes
# NOTHING" is now true of all of them without exception.

# D-1509 (review finding) — GRAPH.JSON IS THE STAMP; THE REPORT IS AN ECHO.
# graph.json is what every reader in ccrc spends (`_gs_stale`, and the session
# card's `tail -c 4096`); GRAPH_REPORT.md's "- Built from commit" line is
# graphify's human echo — the card reads only the node count, from its head. So
# a failure rewriting the report is named in the log and the restamp stands,
# while the same failure on graph.json is still a refusal the census reads.
_gs_restamp_refuse() {   # <tree> <file> <why> -> 0 the caller goes on / 1 refuse the restamp
  if [ "$2" = graph.json ]; then RESTAMP_WHY="$3"; return 1; fi
  printf 'graph-sweep: %s: GRAPH_REPORT.md not restamped (%s)\n' "$1" "$3" \
    >> "$HOME/.ccrc/graph-sweep.log"
  return 0
}
_gs_restamp() {   # <tree> <old-sha> <new-sha> -> 0 rewrote / 1 refused (RESTAMP_WHY)
  local tree="$1" old="$2" new="$3" out="$1/graphify-out" f res rc
  RESTAMP_WHY=""
  [[ "$new" =~ ^[0-9a-f]{7,40}$ ]] || { RESTAMP_WHY="HEAD unreadable"; return 1; }
  [[ "$old" =~ ^[0-9a-f]{7,40}$ ]] || { RESTAMP_WHY="no built_at_commit to replace"; return 1; }
  for f in graph.json GRAPH_REPORT.md; do
    if [ ! -f "$out/$f" ]; then
      [ "$f" = graph.json ] || continue
      RESTAMP_WHY="no graph.json"; return 1
    fi
    # stdout is the temp path (or the refusal line); stderr — a traceback from
    # a python that could not run at all — goes to the log, never swallowed.
    res="$("$VENV/bin/python" - "$out/$f" "$old" "$new" 2>>"$HOME/.ccrc/graph-sweep.log" <<'GFXPY'
import os, re, shutil, sys, tempfile
path, old, new = sys.argv[1], sys.argv[2], sys.argv[3]
name = os.path.basename(path)
is_graph = name == 'graph.json'
try:
    size = os.path.getsize(path)
except OSError:
    print('cannot measure %s' % name); sys.exit(1)
# graph.json is 8 MB on a real tree and `built_at_commit` is its LAST key, so
# it is read from the tail exactly as the card reads it; the report is small.
base = max(0, size - 4096) if is_graph else 0
pat = (re.compile(rb'"built_at_commit"\s*:\s*"([0-9a-f]+)"') if is_graph
       else re.compile(rb'- Built from commit: `([0-9a-f]+)`'))
with open(path, 'rb') as fh:
    fh.seek(base); tail = fh.read()
m = None
for m in pat.finditer(tail):
    pass
if m is None:
    if is_graph:
        print('no built_at_commit in the last %d bytes of graph.json' % len(tail)); sys.exit(1)
    sys.exit(0)
val = m.group(1).decode()
if val != (old if is_graph else old[:len(val)]):
    if is_graph:
        print('graph.json holds %s, not the %s this build measured' % (val, old)); sys.exit(1)
    sys.exit(0)
repl = (new if is_graph else new[:len(val)]).encode()
# D-1509 (review finding) — THE TEMP LIVES INSIDE graphify-out/, SO NOTHING
# AFTER THIS LINE MAY DIE HOLDING IT: a copy of an 8 MB graph.json left by an
# ENOSPC or a killed interpreter is never named by the sweep again, and it sits
# in the very directory the corpus guard measures. The reason travels on stdout
# like every other refusal, so the census names it instead of a bare
# "python refused".
#
# `copyfile` + `copymode`, not `copy2`: the mode is the engine's, the mtime is
# the RESTAMP's. (copy2's mtime never survived the splice write below anyway —
# MEASURED — so the old comment claimed a preservation the code did not do;
# graph.json's mtime is the signal D-1509 was found by, and it now says when
# the stamp last moved.)
fd, tmp = tempfile.mkstemp(prefix='.' + name + '.', dir=os.path.dirname(path) or '.')
os.close(fd)
try:
    shutil.copyfile(path, tmp)
    shutil.copymode(path, tmp)
    with open(tmp, 'r+b') as fh:
        fh.seek(base)
        fh.write(tail[:m.start(1)] + repl + tail[m.end(1):])
        fh.truncate()
except Exception as exc:
    try:
        os.unlink(tmp)
    except OSError:
        pass
    print('%s: %s' % (name, exc)); sys.exit(1)
print(tmp)
GFXPY
    )"; rc=$?
    if [ "$rc" -ne 0 ]; then
      _gs_restamp_refuse "$tree" "$f" "${res:-python refused ($f)}" || return 1
      continue
    fi
    if [ -z "$res" ]; then
      # nothing to rewrite: only ever the report (graph.json either printed a
      # path or exited non-zero), and only when its line is absent or already
      # carries another commit.
      [ "$f" = graph.json ] || continue
      RESTAMP_WHY="no replacement written for graph.json"; return 1
    fi
    if [ ! -f "$res" ]; then
      _gs_restamp_refuse "$tree" "$f" "replacement for $f is not a file" || return 1
      continue
    fi
    if ! mv -f "$res" "$out/$f"; then
      rm -f "$res"
      _gs_restamp_refuse "$tree" "$f" "rename failed ($f)" || return 1
      continue
    fi
  done
  return 0
}

_gs_build() {    # contained build; sets BUILD_OUTCOME/BUILD_REASON; rc: 0 ok / 1 build-failed / 2 skipped-locked
  local tree="$1" out="$tree/graphify-out"
  # Non-blocking lock probe (spec §C.3): graphify's own updates block on this
  # flock by design; a held lock means a writer is live, so defer — timeout
  # then again means only "wedged".
  if [ -e "$out/.rebuild.lock" ] && ! flock -n -E 99 "$out/.rebuild.lock" true 2>/dev/null; then
    BUILD_OUTCOME=skipped-locked; BUILD_REASON="rebuild lock held"; return 2
  fi
  local before_sz=0 before_mt=0 errf outf head
  if [ -f "$out/graph.json" ]; then
    before_sz=$(stat -c %s "$out/graph.json"); before_mt=$(stat -c %Y "$out/graph.json")
  fi
  errf="$(mktemp "${TMPDIR:-/tmp}/gfx-stderr.XXXXXX")"
  # D-1509 — STDOUT IS EVIDENCE NOW, not only log freight. graphify announces
  # its two short-circuits there ("... left untouched."), and that announcement
  # is the only thing that earns a restamp, so it is captured to a temp and
  # appended to the log afterwards rather than streamed straight into it.
  outf="$(mktemp "${TMPDIR:-/tmp}/gfx-stdout.XXXXXX")"
  # HEAD as it stood when the engine started — the value graphify's own
  # `_git_head()` would have stamped (export.py:537). Measured BEFORE the build
  # because a commit landing mid-build must not be claimed by it.
  head="$(git -C "$tree" rev-parse HEAD 2>/dev/null)" || head=""
  # D-1512 — THE LOG NAMES ITS TREE. Attributing "No code-graph topology
  # changes detected" to a tree used to mean correlating re-extracted file
  # counts and durations against the census; one header line ends that.
  printf 'graph-sweep: build %s at %s\n' "$tree" "$(date -u +%FT%TZ)" \
    >> "$HOME/.ccrc/graph-sweep.log"
  ( cd "$tree" && GRAPHIFY_NO_BACKUP=1 PYTHONHASHSEED=0 \
      GRAPHIFY_MAX_WORKERS="$CCRC_GRAPH_MAX_WORKERS" \
      nice -n 15 timeout "$CCRC_GRAPH_BUILD_TIMEOUT" "$ENGINE" update . ) \
      >"$outf" 2>"$errf"
  local rc=$? first full said
  # NB `head` above is the local sha; `head -n1` here is the command — bash
  # keeps variables and commands in different namespaces.
  first="$(head -n1 "$errf" 2>/dev/null || true)"
  said="$(cat "$outf" 2>/dev/null || true)"
  cat "$outf" >> "$HOME/.ccrc/graph-sweep.log"; rm -f "$outf"
  # Full stderr, not just the first line: a real `graphify update` can print
  # conditional warnings BEFORE the shrink refusal on the same invocation
  # (e.g. build.py:384's extraction-warning line, watch.py:510's invalid-
  # community-id line) — grepping only $first let those precede the refusal
  # and collapse a genuine refused-shrink to failed (review finding, Task 7
  # fix). $first stays the reason for the generic `failed` arm below.
  full="$(cat "$errf" 2>/dev/null || true)"
  cat "$errf" >> "$HOME/.ccrc/graph-sweep.log"; rm -f "$errf"
  if [ "$rc" -eq 0 ]; then
    # D-1509 (review finding) — THE PIN IS A RECEIPT, NOT AN ANNOUNCEMENT. It
    # was written HERE, before the stamp was re-measured, so both `failed` arms
    # below still advanced `.graphify_engine` for a build that wrote nothing:
    # the next pass reads the engine dimension as fresh and falls through to
    # `head`, and `_gs_busy`'s O3 seconds hatch measures the age of a stamp no
    # build ever earned. It is written on the two arms that return 0 — the
    # stamp advanced, or the sweep restamped it — and nowhere else.
    #
    # D-1509 — A REBUILD IS A CLAIM UNTIL THE STAMP ADVANCES. graphify's full
    # rebuild exits 0 without writing anything when the candidate graph's
    # topology equals the existing one (watch.py `_rebuild_code`, 0.9.9: two
    # short-circuits, `save_manifest` then `to_json` to a temp), and `graphify
    # update` still prints "Code graph updated." So rc 0 alone said only that
    # the engine ran; the loop wrote `stale-rebuilt`, `_gs_stale` read the same
    # old stamp against the same HEAD on the next pass, and the tree rebuilt
    # every 15 minutes for ever (MEASURED on the live fleet, six consecutive
    # passes 2026-09-04T23:19Z -> 2026-09-05T00:35Z, 6.8 s and 73.8 s a pass).
    # The success of a build is now re-measured on the stamp itself.
    local stamp; stamp="$(_gs_stamp "$tree")"
    if [ -n "$stamp" ] && { [ "$stamp" = "$head" ] || _gs_same_tree "$tree" "$stamp"; }; then
      printf '%s\n' "$PIN" > "$out/.graphify_engine"
      BUILD_OUTCOME=""; BUILD_REASON=""; return 0    # advanced: the loop's own words
    fi
    # Not advanced. graphify's own verdict — a full fresh extraction of the
    # disk compared against the graph — is what earns the stamp it skipped.
    if grep -qF 'left untouched' <<<"$said"; then
      if _gs_restamp "$tree" "$stamp" "$head"; then
        printf '%s\n' "$PIN" > "$out/.graphify_engine"
        BUILD_OUTCOME=restamped
        BUILD_REASON="unchanged topology; ${stamp:0:8} -> ${head:0:8}"
        # D-1511 — commit-keyed freshness cannot see a working tree that
        # differs from HEAD, and the engine's verdict is TRUE OF THE DISK. The
        # count is named in the row so the census does not hide the gap.
        local dirty
        dirty="$(git -C "$tree" status --porcelain --untracked-files=no 2>/dev/null | wc -l)"
        dirty="${dirty//[![:digit:]]/}"            # BSD `wc` pads its count
        [ "${dirty:-0}" -gt 0 ] && BUILD_REASON="$BUILD_REASON; $dirty tracked file(s) modified"
        return 0
      fi
      BUILD_OUTCOME=failed; BUILD_REASON="restamp refused: $RESTAMP_WHY"; return 1
    fi
    # Exit 0, nothing written, nothing said: a stamp nobody verified is not a
    # stamp. Write NOTHING and report it — `failed` is already in the doctor's
    # WARN set, where a silent forever-rebuild never was.
    BUILD_OUTCOME=failed
    BUILD_REASON="exit 0 but built_at_commit did not advance and graphify reported no unchanged verdict"
    return 1
  fi
  if [ "$rc" -eq 124 ]; then
    BUILD_OUTCOME=timed-out; BUILD_REASON="exceeded ${CCRC_GRAPH_BUILD_TIMEOUT}s"; return 1
  fi
  local after_sz=0 after_mt=0
  if [ -f "$out/graph.json" ]; then
    after_sz=$(stat -c %s "$out/graph.json"); after_mt=$(stat -c %Y "$out/graph.json")
  fi
  # refused-shrink: exit 1 AND graph.json untouched AND the shrink message.
  # D-1062 (Task 7): the brief anchored this pin on export.py's `to_json` guard
  # (grep 'shrank\|shrink' export.py) — that guard exists (export.py:486-500)
  # but is NOT the code path `graphify update .` runs (0.9.9, installed at
  # ~/.local/lib/python3.12/site-packages/graphify). `update` dispatches to
  # watch._rebuild_code -> watch._check_shrink, whose message never contains
  # "shrink" at all. Pinned instead against _check_shrink's own literal
  # (watch.py:643-646): "[graphify] WARNING: new graph has {N} nodes but
  # existing graph.json has {M}. Refusing to overwrite — you may be missing
  # chunk files from a previous session. Pass --force to override." The
  # fragment below is the one substring with no interpolated numbers.
  # A pin bump revisits this literal (O1's acceptance) — re-grep both
  # export.py and watch.py in the installed package, not export.py alone.
  # Grepped against the FULL stderr, not $first: a conditional warning line
  # (build.py:384, watch.py:510) can print before the refusal on the same
  # invocation, and BUILD_REASON is the actual matching line, not $first.
  if [ "$after_sz" = "$before_sz" ] && [ "$after_mt" = "$before_mt" ] \
     && grep -qi 'refusing to overwrite' <<<"$full"; then
    BUILD_OUTCOME=refused-shrink
    BUILD_REASON="$(grep -i -m1 'refusing to overwrite' <<<"$full")"
    return 1
  fi
  BUILD_OUTCOME=failed; BUILD_REASON="${first:-exit $rc}"; return 1
}

# ── the pass ──────────────────────────────────────────────────────────────
exec 9>"$LOCK"
flock -n 9 || { ROWS=(); _gs_finish pass-locked 0; }
[ -e "$PAUSE" ] && _gs_finish paused 0
[ -n "$PIN" ] || { echo "graph-sweep: no pin at $PIN_FILE — run ccrc install first" >&2; _gs_finish failed 1; }

if [ ! -d "$PROJECTS_ROOT" ] && [ ! -d "$WORKTREES_ROOT" ]; then
  _gs_finish no-trees-configured 0
fi

PROBED=0
while IFS= read -r tree; do
  PROBED=$((PROBED+1))
  if ! git -C "$tree" check-ignore -q graphify-out/; then
    _gs_row "$tree" refused-no-exclude "git check-ignore graphify-out/ failed — run: ccrc install (the exclude writer)" 0
    continue
  fi
  # stray-file cleanup (spec §E, row 11b): a leftover .graphifyignore from a
  # SIGKILL/OOM/reboot mid-build must not accumulate even on a tree that turns
  # out fresh this pass (a fresh tree never reaches _gs_guard, which carries
  # its own internal instance of this same rm as defense-in-depth for calls
  # that DO reach it — this outer sweep is what actually reaches every tree).
  # Ownership-gated (finding 1): only a marker-bearing leftover WE wrote is
  # swept — a foreign .graphifyignore a repo commits upstream is left alone.
  _gs_owns_ignore "$tree" && rm -f "$tree/.graphifyignore"
  if ! _gs_stale "$tree"; then _gs_row "$tree" fresh "" 0; continue; fi
  stale_reason="$REASON"
  if _gs_busy "$tree"; then _gs_row "$tree" "$BUSY_OUTCOME" "$BUSY_REASON" 0; continue; fi
  if [ "$BUILT" -ge "$CCRC_GRAPH_BUDGET" ]; then
    _gs_row "$tree" skipped-budget "pass budget $CCRC_GRAPH_BUDGET reached" 0; continue
  fi
  if ! _gs_guard "$tree"; then
    # D-1161: a refusal AFTER the filter was written left the trap armed, and
    # the loop's `continue` skipped the only disarm (the post-build one). The
    # leak then fired at pass end with `$tree` empty. One cleanup+disarm here
    # covers every `return 1` in the guard, present and future.
    _gs_rm_generated "$tree"; _gs_disarm
    _gs_row "$tree" refused-by-guard "$GUARD_REASON" 0; continue
  fi
  t0=$(date +%s%3N)
  _gs_build "$tree"; rc=$?
  dur=$(( $(date +%s%3N) - t0 ))
  # The ephemeral filter never persists past the build, whatever rc was. The
  # EXIT/INT/TERM trap _gs_guard armed covers only the crash window of the tree
  # in flight — THIS is the real per-tree cleanup, and disarming here means a
  # later pass-ending exit (the final `_gs_finish ok 0` below) never fires it.
  # D-1161: the trap now names its tree through `GS_FILTER_TREE`, set at arm
  # time, rather than expanding a caller-scope `$tree` at FIRE time — that
  # expansion is what made a leaked trap run `rm -f /.graphifyignore` once the
  # loop had hit EOF and `tree` was empty. Ownership-gated (finding 1) like
  # every other removal site, in `_gs_rm_generated` itself rather than at each
  # call: this only ever deletes a file _gs_guard wrote, never a foreign
  # .graphifyignore the tree owns.
  _gs_rm_generated "$tree"; _gs_disarm
  case "$rc" in
    0)   BUILT=$((BUILT+1))
         # D-1509: `restamped` still counts toward BUILT — the engine RAN (it
         # re-extracted the whole corpus and compared), it merely had nothing
         # to write, and that cost is what the budget is for.
         if [ "$BUILD_OUTCOME" = restamped ]; then _gs_row "$tree" restamped "$BUILD_REASON" "$dur"
         elif [ "$stale_reason" = never-built ]; then _gs_row "$tree" never-built "cold build" "$dur"
         else _gs_row "$tree" stale-rebuilt "$stale_reason" "$dur"; fi ;;
    2)   _gs_row "$tree" skipped-locked "$BUILD_REASON" 0 ;;   # deferred; never counts against the budget
    *)   BUILT=$((BUILT+1)); _gs_row "$tree" "$BUILD_OUTCOME" "$BUILD_REASON" "$dur" ;;
  esac
done < <(_gs_trees)

if [ "$PROBED" -eq 0 ]; then
  echo "graph-sweep: tree roots exist but zero trees probed — the ccd-cap-scopes failure shape; investigate" >&2
  _gs_finish probed-zero 1
fi
_gs_finish ok 0
