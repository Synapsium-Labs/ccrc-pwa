#!/usr/bin/env bash
# ccd-graph-sweep — keep one AST graph fresh per git tree (spec §C). Serialized
# oneshot driven by ccd-graph-sweep.timer; every knob env-overridable for the
# test harness (CCRC_DOCTOR_GH_TIMEOUT precedent). HOME-derived roots, no
# override — HOME is the harness's isolation boundary, exactly as in ccd.
set -uo pipefail

REG="$HOME/.cc-sessions"
PROJECTS_ROOT="$HOME/projects"
WORKTREES_ROOT="$HOME/worktrees"
VENV="$HOME/.ccrc/graphify-venv"
ENGINE="$VENV/bin/graphify"
PIN_FILE="$HOME/.ccrc/graphify.pin"
CENSUS="$HOME/.ccrc/graph-sweep.json"
PAUSE="$HOME/.ccrc/graph-sweep-paused"
LOCK="$HOME/.ccrc/graph-sweep.lock"
: "${CCRC_GRAPH_BUILD_TIMEOUT:=600}"
: "${CCRC_GRAPH_BUDGET:=8}"
: "${CCRC_GRAPH_MAX_WORKERS:=4}"
: "${CCRC_GRAPH_STALE_ESCAPE_COMMITS:=20}"
: "${CCRC_GRAPH_STALE_ESCAPE_SECS:=21600}"

PIN="$(cat "$PIN_FILE" 2>/dev/null || true)"
STARTED="$(date -u +%FT%TZ)"
ROWS=()          # jq-ready per-tree objects
BUILT=0          # rebuilds this pass, against CCRC_GRAPH_BUDGET

_gs_row() {      # path outcome reason duration_ms
  ROWS+=("$(jq -cn --arg p "$1" --arg o "$2" --arg r "$3" --argjson d "${4:-0}" \
    '{path:$p, outcome:$o, reason:$r, duration_ms:$d}')")
}

_gs_finish() {   # pass-status ; exit-code
  local status="$1" rc="$2" tmp
  tmp="$(mktemp "$CENSUS.XXXXXX")"
  # NB: printf of an EMPTY array must emit nothing — a lone newline breaks
  # `jq -cs` (slurp of empty input is [], of "\n" is a parse error).
  { [ "${#ROWS[@]}" -gt 0 ] && printf '%s\n' "${ROWS[@]}"; true; } | jq -cs \
    --arg started "$STARTED" --arg finished "$(date -u +%FT%TZ)" \
    --arg pin "$PIN" --arg status "$status" \
    '{started:$started, finished:$finished, pin:$pin, status:$status, trees:.}' > "$tmp" \
    || { rm -f "$tmp"; echo "graph-sweep: census assembly failed" >&2; exit 1; }
  # append, keep last 10 passes, atomic
  jq -c --slurpfile p "$tmp" '.passes = ((.passes // []) + $p | .[-10:])' \
    "$CENSUS" 2>/dev/null > "$tmp.2" \
    || jq -cn --slurpfile p "$tmp" '{passes: $p}' > "$tmp.2"
  mv "$tmp.2" "$CENSUS"; rm -f "$tmp"
  exit "$rc"
}

# D-1367 — canonical path, or NOTHING. `realpath` and `readlink -f` are both
# acceptable on both userlands (macos-platform.test.ts refuses neither), but an
# EMPTY answer is the one thing this shim must never let a caller spend: two
# unmeasurable paths would compare equal, and "equal" is what admits a
# candidate as a tree. Every caller checks for empty and SKIPS.
_gs_realpath() {   # <path> -> its canonical path, or nothing at all
  local p=""
  p="$(realpath "$1" 2>/dev/null)" || p=""
  [ -n "$p" ] || p="$(readlink -f "$1" 2>/dev/null)" || p=""
  [ -n "$p" ] || return 1
  printf '%s' "$p"
}

# D-1367 — A TREE IS A TOPLEVEL, NEVER A DIRECTORY INSIDE ONE.
#
# The old predicate was `git rev-parse --is-inside-work-tree`, which is true of
# every subdirectory of every work tree — and the glob pair asked it of one
# level under $PROJECTS_ROOT and TWO under $WORKTREES_ROOT. A worktree that
# lives at depth 1 (`~/worktrees/<name>`, its own toplevel) was therefore never
# discovered, while every one of its immediate subdirectories was, `.git`
# included. The sweep then built a graph into each of them. MEASURED on the
# live fleet 2026-09-03: 8 stray `graphify-out/` directories under one
# worktree — `node_modules/graphify-out` and `graphify-out/graphify-out` among
# them — plus two `failed` census rows every pass, for ever.
#
# The question a candidate has to answer is not "are you inside a tree" but
# "ARE YOU A TREE": the realpath of its own `--show-toplevel` is the realpath
# of itself. `$WORKTREES_ROOT`/*/ joins the glob so the depth-1 shape is asked
# at all.
#
# D-1370 — WHAT THE DEDUPE IS ACTUALLY FOR, AND WHICH NAME SURVIVES IT. The
# three globs are DISJOINT as paths: `~/worktrees/a/b` is never `~/worktrees/c`
# and never `~/projects/c`, so no candidate is ever globbed twice and the
# "the two worktree globs now overlap" rationale this comment used to carry was
# false. The one thing that does collapse two candidates onto one tree is a
# SYMLINK — an alias under one root pointing at a real tree under another —
# and there the survivor must be a DECISION, because glob order alone hands it
# to whichever root is listed first ($PROJECTS_ROOT), i.e. to the alias.
#
# That matters because of the contract in the next paragraph: the row keeps the
# path AS GLOBBED, not the canonical one — `$REG/<id>.workdir` and the hook's
# `cwd` are compared against it VERBATIM (`_gs_busy`'s string compare;
# `ccd/session-hook.sh`'s `.path == $p` census lookup), and canonicalising the
# census would silently unmatch every reader. A census carrying the ALIAS
# unmatches them just as silently for a session recorded under the real name:
# no idle-gate match (the sweep builds while that session is `working`, the one
# thing the gate exists to prevent) and no "the sweep refused this tree" card.
# MEASURED: with a real tree at `~/worktrees/foo` and `~/projects/foo` a
# symlink to it, the pass carried exactly one row and it was the alias.
#
# D-1371 — AND THE PREDICATE THAT ASKS IT. The first spelling of that decision
# was `[ "$d" = "$real" ]` — "is this candidate spelled as its own realpath" —
# which is INERT on the shape the fleet actually has. `$PROJECTS_ROOT` on the
# live box is itself a symlink (`~/projects -> /data/projects`, `/data ->
# /mnt/…`), so NO candidate under it can ever equal its own realpath, nothing
# is ever preferred, the survivor falls back to glob order, and the alias wins:
# exactly the failure this entry was written to stop. It measured green only
# because the fixture roots are real directories under /tmp.
#
# The question is about the candidate's OWN last component, not its ancestry:
# prefer the name that is not ITSELF a symlink, and displace only an entry that
# IS one. Two aliases (or two names under symlinked ancestors) leave the
# first-seen standing — there the names are equally arbitrary and only the
# count matters.
_gs_trees() {    # every git working TOPLEVEL under the two roots, once each
  local d top real i dup
  local -a seen=() named=()
  for d in "$PROJECTS_ROOT"/*/ "$WORKTREES_ROOT"/*/ "$WORKTREES_ROOT"/*/*/; do
    [ -d "$d" ] || continue
    d="${d%/}"
    top="$(git -C "$d" rev-parse --show-toplevel 2>/dev/null)" || continue
    [ -n "$top" ] || continue
    top="$(_gs_realpath "$top")" || continue
    real="$(_gs_realpath "$d")" || continue
    [ "$top" = "$real" ] || continue
    dup=-1
    if [ "${#seen[@]}" -gt 0 ]; then
      for i in "${!seen[@]}"; do
        if [ "${seen[$i]}" = "$real" ]; then dup="$i"; break; fi
      done
    fi
    if [ "$dup" -ge 0 ]; then
      # already censused under another name: the real name displaces an alias,
      # nothing displaces the real name (D-1371).
      if [ ! -L "$d" ] && [ -L "${named[$dup]}" ]; then named["$dup"]="$d"; fi
      continue
    fi
    seen+=("$real"); named+=("$d")
  done
  [ "${#named[@]}" -gt 0 ] && printf '%s\n' "${named[@]}"
  return 0
}

# D-1368 — FRESHNESS IS CONTENT, NOT COMMIT IDENTITY. This file's ONE spelling
# of that predicate; `_gs_stale` and `_gs_busy` both ask it here.
#
# `built_at_commit != HEAD` was spent as "the graph is of another commit", and
# after a squash merge — or any rewrite that keeps the tree — that is false:
# HEAD's tree is byte-identical to the built commit's, so the graph describes
# THIS tree exactly. graphify's own `update` then writes nothing, the stamp
# keeps the old sha, and every pass records `stale-rebuilt` for that tree for
# ever. MEASURED on the live fleet 2026-09-03: graph.json mtime 01:18, census
# "stale-rebuilt … head" at 16:09, built 0281e084 vs HEAD 6a26a9a3, and
# `git rev-parse 0281e084^{tree} 6a26a9a3^{tree}` identical.
#
# EITHER SIDE ANSWERING EMPTY IS NOT A MATCH. The built commit may have been
# garbage-collected, in which case the content cannot be compared at all and
# the tree falls through to today's behaviour (stale, reason `head`) rather
# than to a freshness nobody measured — the same rule the card's own freshness
# clause states ("staleness is measured or it is not claimed").
_gs_same_tree() {   # <tree> <built-sha> -> 0 iff built's tree == HEAD's tree
  local t="$1" bt ht
  # D-1369 — THE BUILT SHA IS REPO-CONTROLLED TEXT, AND THIS IS THE FIRST PLACE
  # THE SWEEP SPENDS IT AS A GIT REVISION. `built_at_commit` comes out of a
  # graph.json any tree can write; the old `[ "$built" = "$head" ]` compared it
  # as a STRING, where a rev NAME is simply unequal and the tree rebuilds. A
  # peel resolves it: `HEAD^{tree}` on both sides of an equality is trivially
  # equal, so a graph stamped `"built_at_commit":"HEAD"` (or `@`, or a branch
  # name) would read `fresh` for ever and never be rebuilt again — the mirror
  # image of the wedge D-1368 was written to fix, and invisible in the census
  # because `fresh` is what it reports. The card already holds this contract
  # one line earlier than its own peel (`ccd/session-hook.sh`:
  # `[[ "$built" =~ ^[0-9a-f]{7,40}$ ]] || built=""`); the sweep holds it here.
  # MEASURED against the shipped script with a fixture HOME: `built_at_commit`
  # `HEAD` plus a real content commit read `fresh`, engine calls 1.
  [[ "$2" =~ ^[0-9a-f]{7,40}$ ]] || return 1
  bt="$(git -C "$t" rev-parse --verify -q "$2^{tree}" 2>/dev/null)" || bt=""
  ht="$(git -C "$t" rev-parse --verify -q 'HEAD^{tree}' 2>/dev/null)" || ht=""
  [ -n "$bt" ] && [ -n "$ht" ] && [ "$bt" = "$ht" ]
}

_gs_stale() {    # tree -> 0 stale / 1 fresh ; REASON set
  local tree="$1" head built stamp
  head="$(git -C "$tree" rev-parse HEAD 2>/dev/null)" || { REASON=unreadable-head; return 0; }
  [ -f "$tree/graphify-out/graph.json" ] || { REASON=never-built; return 0; }
  built="$(jq -r '.built_at_commit // empty' "$tree/graphify-out/graph.json" 2>/dev/null)"
  stamp="$(cat "$tree/graphify-out/.graphify_engine" 2>/dev/null || true)"
  [ "$stamp" = "$PIN" ] || { REASON=engine; return 0; }
  if [ "$built" != "$head" ]; then
    _gs_same_tree "$tree" "$built" || { REASON=head; return 0; }
  fi
  return 1
}

# Idle gate (spec §C.5 + R2). READ-ONLY against $REG. Authority is the live
# status file; hookstate is the pointer to it plus a freshness guard — gating
# on hookstate.state alone is bug F6b, already fixed once (watch.ts:2029-2041).
# O5: ws-audit persists no artifact (Task 0); reap's own state-changed refusal
# is the fail-safe (ledger R-1).
: "${CCRC_GRAPH_HOOKSTATE_FRESH_SECS:=1800}"
BUSY_OUTCOME=""; BUSY_REASON=""
_gs_busy() {
  local tree="$1" id="" wd hs pid wrapper cfg sf now age
  for wd in "$REG"/*.workdir; do
    [ -f "$wd" ] || return 1
    if [ "$(cat "$wd")" = "$tree" ]; then id="$(basename "$wd" .workdir)"; break; fi
  done
  [ -n "$id" ] || return 1                       # no session on this tree -> idle
  hs="$REG/$id.hookstate.json"
  [ -f "$hs" ] || return 1
  now=$(date +%s); age=$(( now - $(stat -c %Y "$hs") ))
  [ "$age" -le "$CCRC_GRAPH_HOOKSTATE_FRESH_SECS" ] || return 1   # stale pointer -> idle
  pid="$(jq -r '.pid // empty' "$hs" 2>/dev/null)"; [ -n "$pid" ] || return 1
  wrapper="$(cat "$REG/$id.wrapper" 2>/dev/null)"; [ -n "$wrapper" ] || return 1
  # shellcheck source=/dev/null
  source "$HOME/.ccrc/accounts.sh" 2>/dev/null || return 1
  cfg="$(_ccrc_cfg_dir "$wrapper" 2>/dev/null)" || return 1
  sf="$cfg/sessions/$pid.json"
  [ -f "$sf" ] || return 1
  [ "$(jq -r '.state // empty' "$sf" 2>/dev/null)" = working ] || return 1
  # O3 escape hatch: bounded staleness beats politeness past the thresholds.
  local built commits stamp_age
  built="$(jq -r '.built_at_commit // empty' "$tree/graphify-out/graph.json" 2>/dev/null)"
  if [ -n "$built" ]; then
    # D-1368: the same predicate, once more and spelled once — `rev-list
    # --count "$built..HEAD"` for a NON-ANCESTOR counts everything since the
    # merge-base, so a squashed history could fire the build-anyway escape
    # against a graph that is already of HEAD's content.
    if _gs_same_tree "$tree" "$built"; then
      commits=0
    else
      commits="$(git -C "$tree" rev-list --count "$built..HEAD" 2>/dev/null || echo 0)"
    fi
    stamp_age=$(( now - $(stat -c %Y "$tree/graphify-out/.graphify_engine" 2>/dev/null || echo "$now") ))
    if [ "$commits" -ge "$CCRC_GRAPH_STALE_ESCAPE_COMMITS" ] \
       || [ "$stamp_age" -ge "$CCRC_GRAPH_STALE_ESCAPE_SECS" ]; then
      return 1                                   # build anyway
    fi
  fi
  BUSY_OUTCOME=skipped-busy; BUSY_REASON="session $id working"
  return 0
}

# Pre-build corpus guard (spec §E): there is NO publish seam — to_json writes
# graph.json in place — so the only refusal that protects the previous graph
# is refusing to RUN the build. Corpus definition: every detect() path must be
# git-tracked; graphify-out/memory/ is exempt (detect.py:1101 re-adds it by
# design and it is untracked by design).
GUARD_REASON=""
# A .graphifyignore is OURS only if its first line carries the generated
# marker (finding 1, whole-branch review): a repo that adopts graphify
# upstream may COMMIT a .graphifyignore of its own — tracked, so ignore rules
# don't protect it — and this sweep must never delete or clobber a file it did
# not write, on a 15-minute timer, forever. Absence counts as "ours" (nothing
# to protect); presence without the marker means foreign, hands off.
_gs_owns_ignore() {   # tree -> 0 (absent or ours) / 1 (foreign — leave alone)
  local f="$1/.graphifyignore"
  [ -f "$f" ] || return 0
  head -n1 "$f" 2>/dev/null | grep -q '^# generated by ccd-graph-sweep' && return 0
  return 1
}

# D-1161 — the generated filter's cleanup, as a NAMED pair, because the trap
# that removed it inline was wrong in two ways that only became reachable when
# D-1160 shipped a default list to every box.
#
#  1. It interpolated `$tree` at FIRE time from whatever scope was current.
#     After the sweep loop hits EOF `tree` is EMPTY, so a leaked EXIT trap ran
#     `rm -f /.graphifyignore` — at the filesystem root, every pass. Measured.
#  2. Its `rm` was the one removal site in this file NOT ownership-gated, so a
#     SIGTERM mid-pass (a systemd stop, a reboot) deleted whatever
#     `.graphifyignore` the tree in flight happened to own — including a
#     tracked one the repo committed. Measured: `git status` reported
#     ` D .graphifyignore` afterwards.
#
# Both are now structural: the tree is carried in a GLOBAL set at arm time, and
# the removal re-checks ownership at FIRE time like every other removal site.
GS_FILTER_TREE=""
_gs_rm_generated() {   # remove ONLY a filter this sweep generated — never a foreign file
  local t="${1:-}"
  [ -n "$t" ] || return 0          # empty tree => the root-level rm; never
  _gs_owns_ignore "$t" || return 0 # foreign => hands off
  rm -f "$t/.graphifyignore"
}
_gs_disarm() { trap - EXIT INT TERM; GS_FILTER_TREE=""; }
_gs_guard() {
  local tree="$1" repo noise="" line
  repo="$(basename "$(dirname "$(git -C "$tree" rev-parse --path-format=absolute --git-common-dir)")")"
  # stray filter from a crashed pass: remove it BEFORE measuring anything —
  # but only OUR OWN leftover (marker-bearing); a foreign .graphifyignore this
  # repo owns (e.g. committed upstream) is never ours to delete.
  _gs_owns_ignore "$tree" && rm -f "$tree/.graphifyignore"
  # D-1160 — TWO NOISE SOURCES, UNIONED, default first.
  #
  # `_default.list` is ccrc's own footprint (`.remember/`, `.superpowers/`,
  # `.claude/`, `CLAUDE.local.md`) and ccrc owns it; `<repo>.list` is the
  # operator's and ccrc never writes it. Before the default existed, the
  # artifacts ccrc's OWN skills write into every repo a session touches were
  # held against that repo by the corpus guard, refusing its build for ever —
  # measured on the reference fleet as 14 of 57 trees refused, 186 of 304
  # breach paths being those four names, and five repos blocked by nothing but
  # ccrc's own mess.
  #
  # The '!' check runs over EVERY source, not just the last: a negation in
  # either file re-includes gitignored paths (spec §3.6), and a default that
  # could smuggle one past a per-repo check would be worse than no default.
  local def="$HOME/.ccrc/graph-noise/_default.list"
  local own="$HOME/.ccrc/graph-noise/$repo.list"
  local -a noise_files=()
  [ -f "$def" ] && noise_files+=("$def")
  [ -f "$own" ] && noise_files+=("$own")
  # RULE 1 — a '!' in EITHER source refuses the build. Checked over every
  # source, not just the last: a negation re-includes gitignored files (spec
  # §3.6), and a default that could smuggle one past a per-repo check would be
  # worse than shipping no default at all. This one rule is symmetric because a
  # negation is not an instruction the operator can be entitled to either.
  for noise in "${noise_files[@]}"; do
    if grep -qE '^[[:space:]]*!' "$noise"; then
      GUARD_REASON="noise list $noise carries a '!' line — a negation re-includes gitignored files (spec §3.6); refusing"
      return 1
    fi
  done
  # RULE 2 — a foreign `.graphifyignore` refuses ONLY when the operator wrote a
  # list for this repo. D-1161: before this asymmetry existed, shipping the
  # default to every box made this refusal universal, and any repo that COMMITS
  # its own `.graphifyignore` — the exact case `_gs_owns_ignore` was written to
  # protect — became `refused-by-guard` for ever, with no remedy on the box.
  # Measured: the same fixture built on origin/main and was refused here.
  # An operator's list is an instruction about THIS repo that cannot be
  # honoured, so it refuses; the default is hygiene the repo never asked for,
  # and hygiene yields to a repo that has stated its own corpus policy.
  local foreign=0
  if [ -f "$tree/.graphifyignore" ] && ! _gs_owns_ignore "$tree"; then
    if [ -f "$own" ]; then
      GUARD_REASON="$tree/.graphifyignore exists and was not written by ccd-graph-sweep — refusing to overwrite a file this tree owns"
      return 1
    fi
    noise_files=(); foreign=1
  fi
  # RULE 3 — a DEFAULT pattern is withheld when this repo TRACKS anything it
  # would hide; an operator pattern is honoured as written. D-1161: a
  # `.graphifyignore` is a pure path filter that knows nothing about git, so
  # the default list's own stated contract — "only what ccrc and its skills
  # create" — was a comment, not a mechanism. In a repo that COMMITS
  # `.claude/settings.json` (seven do on the reference fleet, three of them
  # among the five D-1160 set out to unblock) the default silently dropped
  # TRACKED nodes from the corpus; graphify's shrink guard then saw a net loss
  # with `had_explicit_deletions=False` and refused the write, wedging the tree
  # at `refused-shrink` on every pass — strictly worse than the staleness
  # D-1160 was fixing. The collision test is git's own
  # (`ls-files -c -i -X` = "tracked files these patterns would hide"), so it is
  # exact gitignore semantics rather than a reimplementation in bash.
  local -a patterns=()
  local withheld="" probe src pat
  if [ "${#noise_files[@]}" -gt 0 ]; then
    probe="$(mktemp)" || { GUARD_REASON="cannot create a temp file to test noise patterns"; return 1; }
    for src in "${noise_files[@]}"; do
      while IFS= read -r pat || [ -n "$pat" ]; do
        pat="${pat%$'\r'}"
        case "$pat" in ''|'#'*) continue ;; esac
        case "$pat" in *[![:space:]]*) ;; *) continue ;; esac
        if [ "$src" = "$own" ]; then patterns+=("$pat"); continue; fi
        printf '%s\n' "$pat" > "$probe"
        if [ -n "$(git -C "$tree" ls-files -c -i -X "$probe" 2>/dev/null | head -n1)" ]; then
          withheld="$withheld $pat"
        else
          patterns+=("$pat")
        fi
      done < "$src"
    done
    rm -f "$probe"
  fi
  # NOT SILENT. A withheld pattern means this repo keeps whatever ccrc wrote
  # into it in its corpus, so it may still be refused below for a path the
  # default would otherwise have covered — an operator reading the journal has
  # to be able to see why, and the remedy (a `<repo>.list`, which is honoured
  # as written) named.
  [ -n "$withheld" ] && echo "graph-sweep: $tree: default noise withheld, repo tracks matching files:$withheld (a $repo.list is honoured as written)" >&2
  # D-1451 — WHAT GIT IGNORES NEVER ENTERS THE CORPUS.
  #
  # detect() reads `.gitignore` only along the ANCESTOR CHAIN from the VCS root
  # down to the scan root (`_load_graphifyignore`, detect.py:793-836: it walks
  # `ceiling` → `root`, never below). A NESTED `.gitignore` under the scan root
  # is therefore never applied at all, so a gitignored build artifact enters the
  # corpus, is untracked, and this guard refuses the tree — for ever, with no
  # remedy on the box (nothing an operator does to the tree changes what detect
  # picks up, and `<repo>.list` does not apply because the path is not ccrc's
  # noise). MEASURED on the live fleet: synapsium-platform refused over
  # `frontend/exposynapse-site/.astro/settings.json` (ignored by
  # `frontend/exposynapse-site/.gitignore`), MekWarLive/swift-harbor over
  # `.husky/_/*` (ignored by `.husky/_/.gitignore`).
  #
  # So ask GIT for its own verdicts and hand them to detect as entries: one per
  # line, each ANCHORED at the tree root with a leading `/` (detect.py:883-895
  # anchors on that, against the directory holding the file — here the root), a
  # directory keeping its trailing `/` so the ancestor walk (detect.py:924-931)
  # takes everything under it. Anchoring is not cosmetic: `build/` unanchored
  # matches at EVERY depth, which is how an ignored root `build/` would hide a
  # tracked `src/build/`.
  #
  # These entries ALMOST never hide tracked content — `--directory` collapses a
  # directory only when it holds no tracked file, and a file entry names an
  # untracked path — but "almost" is why every entry still goes through the same
  # RULE-3 probe as a default pattern, withheld and reported if it would. D-1452
  # names the reachable class the first landing said did not exist: git spells an
  # entry as a PATH, detect and `ls-files -X` spend it as a GLOB, so a filename
  # carrying a glob metacharacter parts the two readings. Measured — `.gitignore`
  # `/a\*.log` (a LITERAL star) with a tracked `ab.log` and an untracked
  # `a*.log`: git derives the entry `a*.log`, which as a pattern matches the
  # tracked `ab.log`. The probe withholds it, and a test pins that. The probe
  # runs ONCE over the whole set in the common case (git's answer over a union is
  # empty iff it is empty for every member), and only falls back to one call per
  # entry when that union is non-empty, i.e. when there is a culprit to name.
  #
  # Not capped: a capped list is a corpus this guard cannot explain. The count
  # is logged instead. `-z | tr` for the same reason as the tracked side above
  # (D-1450) — raw for every quoting class in one call; the one shape it cannot
  # represent, a newline inside a filename, breaks the line-based corpus side
  # identically, so the two stay in step. A filename that CONTAINS a glob
  # metacharacter (`*`, `?`, `[`) is pathological and is left as git spells it —
  # the RULE-3 probe above is what keeps that spelling from hiding a tracked
  # file, which is the one class where it is not merely a belt.
  # The `foreign` skip is the one thing standing between this derivation and a
  # repo's own COMMITTED `.graphifyignore`: without it the generated filter
  # overwrites that tracked file, and `_gs_rm_generated` — reading its own
  # marker on what is now a marker-bearing file — deletes it at exit. Pinned by
  # ownership row (d), which is the only ownership fixture carrying a gitignored
  # untracked path, i.e. the only one where the derivation has anything to write
  # (D-1452; (a)/(a2)/(b) stay green with this skip deleted — measured).
  local -a derived=()
  local dheld="" e
  if [ "$foreign" -eq 0 ]; then
    probe="$(mktemp)" || { GUARD_REASON="cannot create a temp file to test derived ignore entries"; return 1; }
    local -a raw=() dirs=()
    local d skip
    while IFS= read -r e; do
      [ -n "$e" ] || continue
      raw+=("$e")
      case "$e" in */) dirs+=("$e") ;; esac
    done < <(git -C "$tree" ls-files -o -i --exclude-standard --directory -z 2>/dev/null | tr '\0' '\n')
    # D-1452 — DROP WHAT A COLLAPSED DIRECTORY ALREADY CARRIES. `--directory`
    # collapses a directory only when it holds no tracked file, but git still
    # prints every ignored file UNDER it whenever the directory is not itself
    # named by a rule: measured on git 2.43.0, `*.log` over a `f/` holding only
    # `a.log` and `b.log` prints `f/`, `f/a.log`, `f/b.log` — three entries for
    # one subtree. (A directly-named rule, `node_modules/`, prints the one
    # entry.) Each redundant entry is dead weight the CORPUS side pays for:
    # detect evaluates every entry against every scanned path, ~50 us per
    # (pattern, path) measured on the installed 0.9.9 (the anchored arm
    # recomputes `relative_to(anchor)` inside the per-pattern loop,
    # detect.py:891-895), twice per tree per pass. It also inflates the count
    # logged below, which would then over-report what the filter carries.
    # A directory entry keeps its trailing `/`, so a prefix test is exact —
    # `"$d"*` is quoted, so a metacharacter in a directory name stays literal.
    for e in ${raw[@]+"${raw[@]}"}; do
      skip=0
      for d in ${dirs[@]+"${dirs[@]}"}; do
        [ "$e" = "$d" ] && continue
        case "$e" in "$d"*) skip=1; break ;; esac
      done
      [ "$skip" -eq 0 ] && derived+=("/$e")
    done
    if [ "${#derived[@]}" -gt 0 ]; then
      printf '%s\n' "${derived[@]}" > "$probe"
      if [ -n "$(git -C "$tree" ls-files -c -i -X "$probe" 2>/dev/null | head -n1)" ]; then
        local -a kept=()
        for e in "${derived[@]}"; do
          printf '%s\n' "$e" > "$probe"
          if [ -n "$(git -C "$tree" ls-files -c -i -X "$probe" 2>/dev/null | head -n1)" ]; then
            dheld="$dheld $e"
          else
            kept+=("$e")
          fi
        done
        derived=(${kept[@]+"${kept[@]}"})
      fi
    fi
    rm -f "$probe"
  fi
  # NOT SILENT either — and a withheld derived entry is a stronger signal than a
  # withheld default: it means git's own verdicts disagree with git's own index
  # about a path, so the tree may still be refused below for that path.
  [ -n "$dheld" ] && echo "graph-sweep: $tree: derived ignore entries withheld, repo tracks matching files:$dheld" >&2
  [ "${#derived[@]}" -gt 0 ] && echo "graph-sweep: $tree: git-ignored entries derived into the corpus filter: ${#derived[@]}" >&2
  if [ "${#patterns[@]}" -gt 0 ] || [ "${#derived[@]}" -gt 0 ]; then
    # NB: an empty array must contribute NOTHING — a bare `printf '%s\n' "$@"`
    # of one would emit a lone newline, i.e. a blank entry. The trailing `true`
    # keeps a false `[` test off the block's exit status.
    { echo "# generated by ccd-graph-sweep for one build — never committed, never edited"
      [ "${#patterns[@]}" -gt 0 ] && printf '%s\n' "${patterns[@]}"
      [ "${#derived[@]}" -gt 0 ] && printf '%s\n' "${derived[@]}"
      true; } > "$tree/.graphifyignore"
    GS_FILTER_TREE="$tree"
    trap '_gs_rm_generated "$GS_FILTER_TREE"' EXIT INT TERM
  fi
  local corpus tracked breach
  corpus="$(cd "$tree" && "$VENV/bin/python" - <<'PY' 2>/dev/null
import os
from pathlib import Path
from graphify.detect import detect
r = detect(Path('.')); root = os.path.abspath('.')
for k in ('code','document','paper','image','video'):
    for f in r['files'].get(k, []):
        print(os.path.relpath(f, root))
PY
)" || { GUARD_REASON="detect() failed in $tree"; return 1; }
  # D-1449, widened by D-1450 — COMPARE GIT'S TRUTH, NOT GIT'S QUOTING.
  # `ls-files` C-quotes a path (wrapping it in double quotes) in FOUR classes,
  # not one: a non-ASCII byte (`"J\303\240rn.py"`), a backslash
  # (`"back\\slash.py"`), a double quote (`"quo\"te.py"`) and any control byte
  # (`"tab\tname.py"`). detect() prints raw UTF-8 relative paths, so `comm -23`
  # read a TRACKED file as untracked and refused the tree for ever, with no
  # remedy on the box. Measured on the live fleet: mm-data refused over two
  # tracked files (a JSON named with a/o diacritics, a PNG named with an
  # umlaut). `-c core.quotepath=false` silences ONLY the non-ASCII class and
  # leaves the other three quoting exactly as before (measured), so the fix is
  # `-z`, which is raw for every class in one call and makes core.quotepath
  # irrelevant. The one shape `-z | tr` cannot represent is a newline inside a
  # filename — and that breaks the line-based corpus side identically, so the
  # two sides stay in step. The `ls-files -c -i -X` probe above quotes too, but
  # its output is only ever tested for EMPTINESS, never compared to a path, so
  # quoting cannot change its answer and it is left as it is.
  tracked="$(git -C "$tree" ls-files -z | tr '\0' '\n')"
  breach="$(comm -23 <(sort -u <<<"$corpus") <(sort -u <<<"$tracked") \
            | grep -v '^graphify-out/memory/' | head -5 || true)"
  if [ -n "$breach" ]; then
    GUARD_REASON="untracked paths entered the corpus: $(tr '\n' ' ' <<<"$breach")"
    _gs_owns_ignore "$tree" && rm -f "$tree/.graphifyignore"
    return 1
  fi
  return 0
}

_gs_build() {    # contained build; sets BUILD_OUTCOME/BUILD_REASON; rc: 0 ok / 1 build-failed / 2 skipped-locked
  local tree="$1" out="$tree/graphify-out"
  # Non-blocking lock probe (spec §C.3): graphify's own updates block on this
  # flock by design; a held lock means a writer is live, so defer — timeout
  # then again means only "wedged".
  if [ -e "$out/.rebuild.lock" ] && ! flock -n -E 99 "$out/.rebuild.lock" true 2>/dev/null; then
    BUILD_OUTCOME=skipped-locked; BUILD_REASON="rebuild lock held"; return 2
  fi
  local before_sz=0 before_mt=0 errf
  if [ -f "$out/graph.json" ]; then
    before_sz=$(stat -c %s "$out/graph.json"); before_mt=$(stat -c %Y "$out/graph.json")
  fi
  errf="$(mktemp "${TMPDIR:-/tmp}/gfx-stderr.XXXXXX")"
  ( cd "$tree" && GRAPHIFY_NO_BACKUP=1 PYTHONHASHSEED=0 \
      GRAPHIFY_MAX_WORKERS="$CCRC_GRAPH_MAX_WORKERS" \
      nice -n 15 timeout "$CCRC_GRAPH_BUILD_TIMEOUT" "$ENGINE" update . ) \
      >>"$HOME/.ccrc/graph-sweep.log" 2>"$errf"
  local rc=$? first full
  first="$(head -n1 "$errf" 2>/dev/null || true)"
  # Full stderr, not just the first line: a real `graphify update` can print
  # conditional warnings BEFORE the shrink refusal on the same invocation
  # (e.g. build.py:384's extraction-warning line, watch.py:510's invalid-
  # community-id line) — grepping only $first let those precede the refusal
  # and collapse a genuine refused-shrink to failed (review finding, Task 7
  # fix). $first stays the reason for the generic `failed` arm below.
  full="$(cat "$errf" 2>/dev/null || true)"
  cat "$errf" >> "$HOME/.ccrc/graph-sweep.log"; rm -f "$errf"
  if [ "$rc" -eq 0 ]; then
    printf '%s\n' "$PIN" > "$tree/graphify-out/.graphify_engine"
    BUILD_OUTCOME=""; BUILD_REASON=""; return 0
  fi
  if [ "$rc" -eq 124 ]; then
    BUILD_OUTCOME=timed-out; BUILD_REASON="exceeded ${CCRC_GRAPH_BUILD_TIMEOUT}s"; return 1
  fi
  local after_sz=0 after_mt=0
  if [ -f "$out/graph.json" ]; then
    after_sz=$(stat -c %s "$out/graph.json"); after_mt=$(stat -c %Y "$out/graph.json")
  fi
  # refused-shrink: exit 1 AND graph.json untouched AND the shrink message.
  # D-1062 (Task 7): the brief anchored this pin on export.py's `to_json` guard
  # (grep 'shrank\|shrink' export.py) — that guard exists (export.py:486-500)
  # but is NOT the code path `graphify update .` runs (0.9.9, installed at
  # ~/.local/lib/python3.12/site-packages/graphify). `update` dispatches to
  # watch._rebuild_code -> watch._check_shrink, whose message never contains
  # "shrink" at all. Pinned instead against _check_shrink's own literal
  # (watch.py:643-646): "[graphify] WARNING: new graph has {N} nodes but
  # existing graph.json has {M}. Refusing to overwrite — you may be missing
  # chunk files from a previous session. Pass --force to override." The
  # fragment below is the one substring with no interpolated numbers.
  # A pin bump revisits this literal (O1's acceptance) — re-grep both
  # export.py and watch.py in the installed package, not export.py alone.
  # Grepped against the FULL stderr, not $first: a conditional warning line
  # (build.py:384, watch.py:510) can print before the refusal on the same
  # invocation, and BUILD_REASON is the actual matching line, not $first.
  if [ "$after_sz" = "$before_sz" ] && [ "$after_mt" = "$before_mt" ] \
     && grep -qi 'refusing to overwrite' <<<"$full"; then
    BUILD_OUTCOME=refused-shrink
    BUILD_REASON="$(grep -i -m1 'refusing to overwrite' <<<"$full")"
    return 1
  fi
  BUILD_OUTCOME=failed; BUILD_REASON="${first:-exit $rc}"; return 1
}

# ── the pass ──────────────────────────────────────────────────────────────
exec 9>"$LOCK"
flock -n 9 || { ROWS=(); _gs_finish pass-locked 0; }
[ -e "$PAUSE" ] && _gs_finish paused 0
[ -n "$PIN" ] || { echo "graph-sweep: no pin at $PIN_FILE — run ccrc install first" >&2; _gs_finish failed 1; }

if [ ! -d "$PROJECTS_ROOT" ] && [ ! -d "$WORKTREES_ROOT" ]; then
  _gs_finish no-trees-configured 0
fi

PROBED=0
while IFS= read -r tree; do
  PROBED=$((PROBED+1))
  if ! git -C "$tree" check-ignore -q graphify-out/; then
    _gs_row "$tree" refused-no-exclude "git check-ignore graphify-out/ failed — run: ccrc install (the exclude writer)" 0
    continue
  fi
  # stray-file cleanup (spec §E, row 11b): a leftover .graphifyignore from a
  # SIGKILL/OOM/reboot mid-build must not accumulate even on a tree that turns
  # out fresh this pass (a fresh tree never reaches _gs_guard, which carries
  # its own internal instance of this same rm as defense-in-depth for calls
  # that DO reach it — this outer sweep is what actually reaches every tree).
  # Ownership-gated (finding 1): only a marker-bearing leftover WE wrote is
  # swept — a foreign .graphifyignore a repo commits upstream is left alone.
  _gs_owns_ignore "$tree" && rm -f "$tree/.graphifyignore"
  if ! _gs_stale "$tree"; then _gs_row "$tree" fresh "" 0; continue; fi
  stale_reason="$REASON"
  if _gs_busy "$tree"; then _gs_row "$tree" "$BUSY_OUTCOME" "$BUSY_REASON" 0; continue; fi
  if [ "$BUILT" -ge "$CCRC_GRAPH_BUDGET" ]; then
    _gs_row "$tree" skipped-budget "pass budget $CCRC_GRAPH_BUDGET reached" 0; continue
  fi
  if ! _gs_guard "$tree"; then
    # D-1161: a refusal AFTER the filter was written left the trap armed, and
    # the loop's `continue` skipped the only disarm (the post-build one). The
    # leak then fired at pass end with `$tree` empty. One cleanup+disarm here
    # covers every `return 1` in the guard, present and future.
    _gs_rm_generated "$tree"; _gs_disarm
    _gs_row "$tree" refused-by-guard "$GUARD_REASON" 0; continue
  fi
  t0=$(date +%s%3N)
  _gs_build "$tree"; rc=$?
  dur=$(( $(date +%s%3N) - t0 ))
  # The ephemeral filter never persists past the build, whatever rc was. The
  # EXIT/INT/TERM trap _gs_guard armed covers only the crash window of the tree
  # in flight — THIS is the real per-tree cleanup, and disarming here means a
  # later pass-ending exit (the final `_gs_finish ok 0` below) never fires it.
  # D-1161: the trap now names its tree through `GS_FILTER_TREE`, set at arm
  # time, rather than expanding a caller-scope `$tree` at FIRE time — that
  # expansion is what made a leaked trap run `rm -f /.graphifyignore` once the
  # loop had hit EOF and `tree` was empty. Ownership-gated (finding 1) like
  # every other removal site, in `_gs_rm_generated` itself rather than at each
  # call: this only ever deletes a file _gs_guard wrote, never a foreign
  # .graphifyignore the tree owns.
  _gs_rm_generated "$tree"; _gs_disarm
  case "$rc" in
    0)   BUILT=$((BUILT+1))
         if [ "$stale_reason" = never-built ]; then _gs_row "$tree" never-built "cold build" "$dur"
         else _gs_row "$tree" stale-rebuilt "$stale_reason" "$dur"; fi ;;
    2)   _gs_row "$tree" skipped-locked "$BUILD_REASON" 0 ;;   # deferred; never counts against the budget
    *)   BUILT=$((BUILT+1)); _gs_row "$tree" "$BUILD_OUTCOME" "$BUILD_REASON" "$dur" ;;
  esac
done < <(_gs_trees)

if [ "$PROBED" -eq 0 ]; then
  echo "graph-sweep: tree roots exist but zero trees probed — the ccd-cap-scopes failure shape; investigate" >&2
  _gs_finish probed-zero 1
fi
_gs_finish ok 0
