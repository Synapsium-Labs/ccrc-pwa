#!/usr/bin/env bash
# ccd-graph-sweep — one graph per REPOSITORY, built from its main line in ccrc's graph store and shared by every
# worktree of the repository through one ignored link (graph revision 2, D-7350; spec §2, §3, §4, §7). A serialized
# oneshot driven by ccd-graph-sweep.timer. HOME-derived roots, no override — HOME is the harness's isolation
# boundary, exactly as in ccd.
#
# A PASS, in order:
#   1. the pass lock (`flock -n` on ~/.ccrc/graph-sweep.lock; a second entrant is `pass-locked` at once), then the
#      pause file (~/.ccrc/graph-sweep-paused: the pass is `paused` before any fetch, store write or build, and the
#      sweep never removes the file — it is the wave's hold, D-7365);
#   2. the library (spec §5.2): GRAPH_LIB is this script's directory when ccrc, ccrc-test, graph-build and
#      graph-resolve sit beside it (a checkout, a test), else $HOME/ccrc/ccd, the shipped tree. The installed copy at
#      ~/.local/bin sits beside the generated `ccrc` LAUNCHER, never the body, and never sources or runs it. A
#      GRAPH_LIB without all four is pass status `failed`, naming the missing file. The sweep sources ccd/ccrc's body
#      (whose dispatch runs only when it is executed) for `_graph_knobs`, the platform shims and
#      `_graph_exclude_common`, and ccd/graph-resolve for `_gr_knobs`, the store, the repository key and the source
#      ref (D-7500, D-7650: the generated settings library carries `_ccrc_knob` and its closure only, so it cannot
#      stand in);
#   3. the store (`_gr_store_init`: its realpath and its marker), then the trees (`_gs_trees`), grouped by the realpath
#      of their git common dir: one repository each;
#   4. per repository (spec §3.1): CCRC_GRAPH_REPOS_EXCLUDE (`excluded`), the store's shared clone of it (§2.2), the
#      throttled fetch, the source ref (`no-source`), the checkout moved to the ref's commit with the generated
#      .graphifyignore written in it, and the decision (`_gs_decide`, §3.3, §3.3.1);
#   5. the builds due, within CCRC_GRAPH_BUDGET, repositories with no published build first, then the one last
#      skipped for the budget, then the most commits behind: staging (§3.5 step 1), the corpus guard, `ccrc test
#      --status` (a refusal is `failed`, `fail: setup`, D-7356), the wrapper through `ccrc test --local --heavy`
#      with the pass lock's fd 9 CLOSED, the plan's outcome table, the stamp, the publish checks and the publish;
#   6. per published repository: the exclude lines (`_graph_exclude_common`), then one link per tree whose
#      graphify-out is absent and ignored (`git check-ignore -q graphify-out`, no slash): the ONLY write this sweep
#      makes under a tree, besides removing a stray `.graphifyignore` an old sweep generated (ownership-gated; D-7649);
#   7. collection of superseded builds and leftover staging (§3.5 step 6), the store's settings.json (§5.3), and the
#      census: one `repos[]` row per repository (§7), each also printed as one `graph-sweep: row {json}` stdout line,
#      so the journal keeps a week of them where the census keeps 10 passes (D-7357).
#
# EVERY BOUND IS A SETTING. Each size, interval, count and percentage this file obeys is a CCRC_GRAPH_* key read by
# `_gr_knobs` into GK[…], with its default in ccd/ccrc's `_graph_knobs`; graph-knobs.test.ts scans this file for a
# numeric literal compared against a quantity.
set -uo pipefail

REG="$HOME/.cc-sessions"
PROJECTS_ROOT="$HOME/projects"
WORKTREES_ROOT="$HOME/worktrees"
VENV="$HOME/.ccrc/graphify-venv"
PIN_FILE="$HOME/.ccrc/graphify.pin"
CENSUS="$HOME/.ccrc/graph-sweep.json"
PAUSE="$HOME/.ccrc/graph-sweep-paused"
LOCK="$HOME/.ccrc/graph-sweep.lock"
LOG="$HOME/.ccrc/graph-sweep.log"

PIN="$(cat "$PIN_FILE" 2>/dev/null || true)"
STARTED="$(date -u +%FT%TZ)"
ROWS=()          # one jq-ready object per repository
PASS_REASON=""   # why a pass that ended early ended, when it says (spec §5.2)

_gs_row() {      # <row json> — keep one repos[] row for the census, and print it to the journal (D-7357)
  ROWS+=("$1")
  printf 'graph-sweep: row %s\n' "$1"
}

_gs_finish() {   # pass-status ; exit-code
  local status="$1" rc="$2" tmp pass
  pass='{started:$started, finished:$finished, pin:$pin, status:$status, repos:.} + (if $reason == "" then {} else {reason:$reason} end)'
  tmp="$(mktemp "$CENSUS.XXXXXX")"
  # NB: printf of an EMPTY array must emit nothing — a lone newline breaks
  # `jq -cs` (slurp of empty input is [], of "\n" is a parse error).
  { [ "${#ROWS[@]}" -gt 0 ] && printf '%s\n' "${ROWS[@]}"; true; } | jq -cs \
    --arg started "$STARTED" --arg finished "$(date -u +%FT%TZ)" \
    --arg pin "$PIN" --arg status "$status" --arg reason "${PASS_REASON:-}" "$pass" > "$tmp" \
    || { rm -f "$tmp"; echo "graph-sweep: census assembly failed" >&2; exit 1; }
  # append, keep last 10 passes, atomic
  jq -c --slurpfile p "$tmp" '.passes = ((.passes // []) + $p | .[-10:])' \
    "$CENSUS" 2>/dev/null > "$tmp.2" \
    || jq -cn --slurpfile p "$tmp" '{passes: $p}' > "$tmp.2"
  mv "$tmp.2" "$CENSUS"; rm -f "$tmp"
  [ -z "${PASS_REASON:-}" ] || echo "graph-sweep: $status: $PASS_REASON" >&2
  exit "$rc"
}


# D-1367 — canonical path, or NOTHING. `realpath` and `readlink -f` are both
# acceptable on both userlands (macos-platform.test.ts refuses neither), but an
# EMPTY answer is the one thing this shim must never let a caller spend: two
# unmeasurable paths would compare equal, and "equal" is what admits a
# candidate as a tree. Every caller checks for empty and SKIPS.
_gs_realpath() {   # <path> -> its canonical path, or nothing at all
  local p=""
  p="$(realpath "$1" 2>/dev/null)" || p=""
  [ -n "$p" ] || p="$(readlink -f "$1" 2>/dev/null)" || p=""
  [ -n "$p" ] || return 1
  printf '%s' "$p"
}

# D-1562 — WHICH REGISTERED SESSION LIVES ON THIS TREE, ASKED ONCE AND ASKED BY
# REALPATH. The idle gate used to answer it inline with
# `[ "$(cat "$wd")" = "$tree" ]` — the registry's `<id>.workdir` TEXT against
# the census's glob spelling of the tree — and those two are the same string
# only by luck. `$PROJECTS_ROOT` on the live box is a symlink (`~/projects ->
# /data/projects`, itself a symlink onto the volume), so a project-root
# session's workdir reads the canonical name while the sweep names that same
# tree through `$HOME`. MEASURED 2026-09-05 against the live registry: 13 of 18
# workdirs match a census path as a string, 18 of 18 match by realpath — and
# the five that never matched are the five project-root and `.claude/worktrees`
# sessions, EXACTLY the trees the gate exists to protect from a build under a
# working session. Every one had read `idle` on every pass since the gate
# shipped; the O3 escape hatch never got a say. Same shape as D-1367's realpath
# dedupe and D-1449's "compare git's truth, not its quoting".
#
# An unreadable or unresolvable workdir is SKIPPED, never matched: _gs_realpath
# answers nothing rather than empty-equals-empty (its own contract), and two
# unmeasurable paths comparing equal is what would hand a tree the wrong
# session. D-1563 asks this same question of a `.claude/worktrees` candidate,
# which is why it lives here and not inside the gate.
_gs_session_on() {   # <tree> -> the session id whose workdir names it, or nothing
  local tree="$1" want wd txt
  want="$(_gs_realpath "$tree")" || return 1
  for wd in "$REG"/*.workdir; do
    [ -f "$wd" ] || continue
    txt="$(cat "$wd" 2>/dev/null)" || continue
    [ -n "$txt" ] || continue
    txt="$(_gs_realpath "$txt")" || continue
    [ "$txt" = "$want" ] || continue
    basename "$wd" .workdir
    return 0
  done
  return 1
}

# D-1367 — A TREE IS A TOPLEVEL, NEVER A DIRECTORY INSIDE ONE.
#
# The old predicate was `git rev-parse --is-inside-work-tree`, which is true of
# every subdirectory of every work tree — and the glob pair asked it of one
# level under $PROJECTS_ROOT and TWO under $WORKTREES_ROOT. A worktree that
# lives at depth 1 (`~/worktrees/<name>`, its own toplevel) was therefore never
# discovered, while every one of its immediate subdirectories was, `.git`
# included. The sweep then built a graph into each of them. MEASURED on the
# live fleet 2026-09-03: 8 stray `graphify-out/` directories under one
# worktree — `node_modules/graphify-out` and `graphify-out/graphify-out` among
# them — plus two `failed` census rows every pass, for ever.
#
# The question a candidate has to answer is not "are you inside a tree" but
# "ARE YOU A TREE": the realpath of its own `--show-toplevel` is the realpath
# of itself. `$WORKTREES_ROOT`/*/ joins the glob so the depth-1 shape is asked
# at all.
#
# D-1370 — WHAT THE DEDUPE IS ACTUALLY FOR, AND WHICH NAME SURVIVES IT. The
# three globs are DISJOINT as paths: `~/worktrees/a/b` is never `~/worktrees/c`
# and never `~/projects/c`, so no candidate is ever globbed twice and the
# "the two worktree globs now overlap" rationale this comment used to carry was
# false. The one thing that does collapse two candidates onto one tree is a
# SYMLINK — an alias under one root pointing at a real tree under another —
# and there the survivor must be a DECISION, because glob order alone hands it
# to whichever root is listed first ($PROJECTS_ROOT), i.e. to the alias.
#
# That matters because of the contract in the next paragraph: the row keeps the
# path AS GLOBBED, not the canonical one — the hook's `cwd` is compared against
# it VERBATIM (`ccd/session-hook.sh`'s `.path == $p` census lookup), and
# canonicalising the census would silently unmatch that reader. A census
# carrying the ALIAS unmatches it just as silently for a session recorded under
# the real name: no "the sweep refused this tree" card. (The idle gate was the
# other such reader until D-1562 taught it to compare realpaths; the card's
# lookup still is.)
# MEASURED: with a real tree at `~/worktrees/foo` and `~/projects/foo` a
# symlink to it, the pass carried exactly one row and it was the alias.
#
# D-1371 — AND THE PREDICATE THAT ASKS IT. The first spelling of that decision
# was `[ "$d" = "$real" ]` — "is this candidate spelled as its own realpath" —
# which is INERT on the shape the fleet actually has. `$PROJECTS_ROOT` on the
# live box is itself a symlink (`~/projects -> /data/projects`, `/data ->
# /mnt/…`), so NO candidate under it can ever equal its own realpath, nothing
# is ever preferred, the survivor falls back to glob order, and the alias wins:
# exactly the failure this entry was written to stop. It measured green only
# because the fixture roots are real directories under /tmp.
#
# The question is about the candidate's OWN last component, not its ancestry:
# prefer the name that is not ITSELF a symlink, and displace only an entry that
# IS one. Two aliases (or two names under symlinked ancestors) leave the
# first-seen standing — there the names are equally arbitrary and only the
# count matters.
#
# D-1510 — AND CLAUDE CODE'S OWN WORKTREES ARE TREES. `EnterWorktree` puts a
# session's worktree at `<repo>/.claude/worktrees/<name>`, a real toplevel at a
# depth none of the first three globs reaches, so the sweep never saw it and
# nothing ever rebuilt its graph. MEASURED on the live fleet 2026-09-05: a
# session in `$PROJECTS_ROOT/<repo>/.claude/worktrees/<name>` over a graph.json
# a week old with no `.graphify_engine` beside it — not this sweep's build —
# reading fresh only because no commit had landed there yet. The last THREE
# globs below ask the same toplevel question of that shape — one per shape of
# workspace the fleet has, because `$WORKTREES_ROOT/<name>` is itself a toplevel
# (D-1367) and its `.claude/worktrees/<x>` therefore sits one level shallower
# than a depth-2 workspace's (review finding: the depth-1 shape was missed).
# Nothing else changes (the noise-list key is the basename of
# `--git-common-dir`'s parent, so it already resolves to the PARENT project, and
# the default noise list withholds `.claude/` from the parent's own corpus
# unless that repo tracks files there).
#
# D-1563 — AND ONE IS A TREE ONLY WHILE A SESSION LIVES IN IT. D-1510's three
# globs found 15 directories on the live fleet, 14 of them git toplevels: ONE
# named worktree with a registered session (the tree D-1510 was written for),
# three named ones with no session, and TEN minted by Claude Code's own
# isolation — `agent-<hex>` subagent worktrees and `wf_<run>-<n>` workflow
# ones, six touched within the hour and five a fortnight old. The pass built
# eight of them cold at ~75 s each, ran eleven minutes against the two it took
# before, and recorded `skipped-budget` for eight trees — the one the rule was
# written for among them. Every future workflow with worktree isolation would
# mint more. The rule that was missing is the one the idle gate already states:
# A TREE IS WORTH A BUILD BECAUSE A SESSION LIVES IN IT. So a candidate under
# `.claude/worktrees/` is kept only while some `$REG/<id>.workdir` names it,
# `_gs_realpath` on both sides (D-1562's comparison, spelled once). The
# project roots and the ccd workspaces are unchanged — the operator put those
# there. A subagent's `agent-*` worktree is never a session's workdir, so it is
# never built; a named worktree a session later enters is picked up next pass.
_gs_trees() {    # every git working TOPLEVEL under the two roots, once each
  local d top real i dup
  local -a seen=() named=()
  for d in "$PROJECTS_ROOT"/*/ "$WORKTREES_ROOT"/*/ "$WORKTREES_ROOT"/*/*/ \
           "$PROJECTS_ROOT"/*/.claude/worktrees/*/ \
           "$WORKTREES_ROOT"/*/.claude/worktrees/*/ \
           "$WORKTREES_ROOT"/*/*/.claude/worktrees/*/; do
    [ -d "$d" ] || continue
    d="${d%/}"
    top="$(git -C "$d" rev-parse --show-toplevel 2>/dev/null)" || continue
    [ -n "$top" ] || continue
    top="$(_gs_realpath "$top")" || continue
    real="$(_gs_realpath "$d")" || continue
    [ "$top" = "$real" ] || continue
    # D-1563: the path decides, not which glob produced it — a candidate under
    # `.claude/worktrees/` is Claude Code's, and it is a tree only while a
    # registered session lives in it.
    case "$d" in
      */.claude/worktrees/*) _gs_session_on "$d" >/dev/null || continue ;;
    esac
    dup=-1
    if [ "${#seen[@]}" -gt 0 ]; then
      for i in "${!seen[@]}"; do
        if [ "${seen[$i]}" = "$real" ]; then dup="$i"; break; fi
      done
    fi
    if [ "$dup" -ge 0 ]; then
      # already censused under another name: the real name displaces an alias,
      # nothing displaces the real name (D-1371).
      if [ ! -L "$d" ] && [ -L "${named[$dup]}" ]; then named["$dup"]="$d"; fi
      continue
    fi
    # shellcheck disable=SC2190  # both are indexed (local -a above); shellcheck confuses them with this file's maps
    seen+=("$real"); named+=("$d")
  done
  [ "${#named[@]}" -gt 0 ] && printf '%s\n' "${named[@]}"
  return 0
}

# Idle gate (spec §C.5 + R2). READ-ONLY against $REG. Authority is the live
# status file; hookstate is the pointer to it plus a freshness guard — gating
# on hookstate.state alone is bug F6b, already fixed once (watch.ts:2197-2209).
# O5: ws-audit persists no artifact (Task 0); reap's own state-changed refusal
# is the fail-safe (ledger R-1).
#
# GRAPH REVISION 2: no build runs in a session's tree any more, so nothing here
# gates a build, and the O3 escape hatch that let a build interrupt a working
# session past a staleness bound is retired with the per-tree build (spec §5.4
# "Retired"). The gate stays for the one write left that a working session must
# not have under it: the migration of a tree's old graphify-out (GR6). Its
# freshness bound is CCRC_GRAPH_HOOKSTATE_FRESH_SECS, read by `_gr_knobs`.
# shellcheck disable=SC2034  # BUSY_REASON is read by the migration's caller (GR6)
BUSY_REASON=""
# shellcheck disable=SC2329  # called by the migration (GR6); kept here, without its hatch, as the plan rules
_gs_busy() {
  local tree="$1" id="" hs pid wrapper cfg sf now age
  # D-1562 — one spelling of "which session lives here", and it compares
  # realpaths: the registry and the census need not spell a tree alike.
  id="$(_gs_session_on "$tree")" || id=""
  [ -n "$id" ] || return 1                       # no session on this tree -> idle
  hs="$REG/$id.hookstate.json"
  [ -f "$hs" ] || return 1
  now=$(date +%s); age=$(( now - $(_plat_mtime "$hs") ))
  [ "$age" -le "${GK[CCRC_GRAPH_HOOKSTATE_FRESH_SECS]}" ] || return 1   # stale pointer -> idle
  pid="$(jq -r '.pid // empty' "$hs" 2>/dev/null)"; [ -n "$pid" ] || return 1
  wrapper="$(cat "$REG/$id.wrapper" 2>/dev/null)"; [ -n "$wrapper" ] || return 1
  # shellcheck source=/dev/null
  source "$HOME/.ccrc/accounts.sh" 2>/dev/null || return 1
  cfg="$(_ccrc_cfg_dir "$wrapper" 2>/dev/null)" || return 1
  sf="$cfg/sessions/$pid.json"
  [ -f "$sf" ] || return 1
  [ "$(jq -r '.state // empty' "$sf" 2>/dev/null)" = working ] || return 1
  # shellcheck disable=SC2034
  BUSY_REASON="session $id working"
  return 0
}

# A .graphifyignore is OURS only if its first line carries the generated
# marker (finding 1, whole-branch review): a repo that adopts graphify
# upstream may COMMIT a .graphifyignore of its own — tracked, so ignore rules
# don't protect it — and this sweep must never delete or clobber a file it did
# not write, on a 15-minute timer, forever. Absence counts as "ours" (nothing
# to protect); presence without the marker means foreign, hands off.
_gs_owns_ignore() {   # tree -> 0 (absent or ours) / 1 (foreign — leave alone)
  local f="$1/.graphifyignore"
  [ -f "$f" ] || return 0
  head -n1 "$f" 2>/dev/null | grep -q '^# generated by ccd-graph-sweep' && return 0
  return 1
}

# A STRAY FILTER from the per-tree sweep (graph revision 1 wrote one into a tree for each build and removed it after;
# a SIGKILL, an OOM kill or a reboot mid-build left it behind). Removed as before, and ownership-gated as before: only
# a marker-bearing file this sweep generated, never a .graphifyignore the repository owns (spec §9.1, "as today").
_gs_rm_stray() {   # <tree>
  local tree="$1"
  _gs_owns_ignore "$tree" || return 0
  rm -f -- "$tree/.graphifyignore"
}

# ── the library (spec §5.2, N25) ──────────────────────────────────────────
GRAPH_LIB=""
_gs_lib() {   # -> GRAPH_LIB, or rc 1 with PASS_REASON naming the missing file
  local here d f miss=""
  here="${BASH_SOURCE[0]}"
  [[ "$here" == */* ]] || here="./$here"
  here="$(cd "${here%/*}" 2>/dev/null && pwd)" || here=""
  for d in ${here:+"$here"} "$HOME/ccrc/ccd"; do
    miss=""
    for f in ccrc ccrc-test graph-build graph-resolve; do
      [ -f "$d/$f" ] || { miss="$d/$f"; break; }
    done
    if [ -z "$miss" ]; then GRAPH_LIB="$d"; return 0; fi
  done
  PASS_REASON="the graph library is incomplete: ${miss/#"$HOME"/\~} is missing (ccrc update --force places the shipped tree)"
  return 1
}

# Every git call on a tree, a checkout or a common dir runs with the caller's GIT_* environment removed, so a GIT_DIR
# or GIT_COMMON_DIR inherited from anywhere can never answer for the repository named on the command line.
_gs_git() {   # <work dir> <git args…>
  local d="$1"; shift
  env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_COMMON_DIR -u GIT_OBJECT_DIRECTORY \
    -u GIT_ALTERNATE_OBJECT_DIRECTORIES -u GIT_NAMESPACE GIT_TERMINAL_PROMPT=0 git -C "$d" "$@"
}

_gs_iso() { jq -rn --argjson s "$1" '$s | todate'; }   # <epoch seconds> -> ISO 8601 UTC, on either userland

_gs_common() {   # <tree> -> the realpath of its git common dir, or nothing (rc 1)
  local c
  c="$(_gs_git "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1
  [ -n "$c" ] || return 1
  (cd -P -- "$c" 2>/dev/null && pwd -P)
}

# ── a repository's state for this pass, by repository key ─────────────────
# K_* hold what the census row needs; `_gs_end` is the ONE place an outcome is decided, with its fail class (`-` for
# none) and its reason, so graph-outcomes.test.ts reads the sweep's whole outcome vocabulary off its calls.
declare -A K_COMMON=() K_DIR=() K_CK=() K_TIP=() K_REF=() K_OUTCOME=() K_FAIL=() K_REASON=() K_KIND=()
declare -A K_CHANGED=() K_DUR=() K_PEAK=() K_CPU=() K_FF=() K_FFAT=() K_DIGEST=() K_BEHIND=() K_PUB=()
declare -A K_PREV=() K_PFAIL=() K_FFATS=() K_WHY=() K_BUILT=() K_NOTE=() K_TREES=() K_RK=() T_OF=()
K_ORDER=()
CUR=""
_gs_end() {   # <outcome> <fail class, or -> <reason> — for the repository in CUR
  K_OUTCOME["$CUR"]="$1"
  if [ "$2" = - ]; then K_FAIL["$CUR"]=""; else K_FAIL["$CUR"]="$2"; fi
  K_REASON["$CUR"]="$3"
}
# The census's last repos[] row for this repository, the outcome of its LAST ATTEMPT (spec §2.3): read once, at the
# start of the repository's turn, so a row that ends early still carries the full-build backoff forward (§3.3.1).
_gs_last_row() {   # <key>
  local key="$1" r="" prev="" pfail="" ff=0 ffat="" ffat_s=""
  r="$(jq -r --arg k "$key" '[(.passes // [])[] | (.repos // [])[] | select(.repo_key == $k)] | last // empty
      | [.outcome // "", .fail // "", (.full_failures // 0 | tostring), .full_failed_at // "",
         (try (.full_failed_at | fromdateiso8601 | floor | tostring) catch "")] | join("\u001f")' "$CENSUS" 2>/dev/null)" || r=""
  IFS=$'\x1f' read -r prev pfail ff ffat ffat_s <<<"$r"
  [[ "$ff" =~ ^[0-9]+$ ]] || ff=0
  K_PREV["$key"]="$prev"; K_PFAIL["$key"]="$pfail"; K_FF["$key"]="$ff"; K_FFAT["$key"]="$ffat"; K_FFATS["$key"]="$ffat_s"
}
_gs_note() {   # <text> — appended to the row's reason (a fetch that failed, an uncontained run, an unmeasured peak)
  K_NOTE["$CUR"]="${K_NOTE[$CUR]:+${K_NOTE[$CUR]}; }$1"
}

# ── the generated .graphifyignore (spec §2.2; rules 1 and 2 of the per-tree guard, kept for the noise sources) ──
# Written into the store's checkout, never into a session's tree, and excluded in the checkout's own
# .git/info/exclude. Its content is the corpus definition, so its digest is meta.json's `noise_digest` (§2.3, §3.3).
#
# D-1160 — TWO NOISE SOURCES, UNIONED, default first: `_default.list` is ccrc's own footprint and ccrc owns it;
# `<repo>.list` is the operator's and ccrc never writes it.
# RULE 1 — a '!' line in EITHER source refuses: a negation re-includes gitignored files (spec §3.6 of 08-27), and a
#   default that could smuggle one past a per-repository check would be worse than no default.
# RULE 2 (D-7651) — the DEFAULT yields to a repository that commits its own .graphifyignore: the default is hygiene the
#   repository never asked for, and hygiene yields to a repository that has stated its corpus policy. The committed
#   file is kept and the operator's list is appended to it (spec §2.2). Its refusal arm, which existed because the
#   per-tree sweep would have had to overwrite a file a session's tree owned, has nothing left to protect: the
#   checkout is the store's own, and `checkout --force` restores the committed file before every build.
# RULE 3 (D-1161) — a DEFAULT pattern is withheld when the commit TRACKS anything it would hide (`ls-files -c -i -X`,
#   git's own gitignore semantics); an operator pattern is honoured as written, and the withholding is said.
# The untracked-file derivation of the per-tree guard (D-1451, D-1458) is gone: the checkout is clean, exactly the
# tracked files at the commit, so there is no ignored untracked file for detect() to pick up.
GS_DIGEST="" GS_WHY=""
_gs_noise() {   # <checkout> <repository name> -> 0 written (GS_DIGEST) / 1 refused (GS_WHY)
  local ck="$1" name="$2" def="$HOME/.ccrc/graph-noise/_default.list" own="$HOME/.ccrc/graph-noise/$2.list"
  local src pat probe withheld="" gen
  local -a sources=() patterns=()
  GS_DIGEST="" GS_WHY=""
  [ -f "$def" ] && sources+=("$def")
  [ -f "$own" ] && sources+=("$own")
  for src in ${sources[@]+"${sources[@]}"}; do
    if grep -qE '^[[:space:]]*!' "$src"; then
      GS_WHY="noise list ${src/#"$HOME"/\~} carries a '!' line — a negation re-includes gitignored files; refusing"
      return 1
    fi
  done
  gen="$ck/.graphifyignore"
  if _gs_git "$ck" ls-files --error-unmatch -- .graphifyignore >/dev/null 2>&1; then
    sources=(); [ -f "$own" ] && sources=("$own")              # rule 2: the default yields
    cp -- "$gen" "$ck/.git/graphifyignore.committed" || { GS_WHY="cannot read the committed .graphifyignore"; return 1; }
  else
    : > "$ck/.git/graphifyignore.committed"
  fi
  probe="$ck/.git/graphifyignore.probe"
  for src in ${sources[@]+"${sources[@]}"}; do
    while IFS= read -r pat || [ -n "$pat" ]; do
      pat="${pat%$'\r'}"
      case "$pat" in ''|'#'*) continue ;; esac
      case "$pat" in *[![:space:]]*) ;; *) continue ;; esac
      if [ "$src" = "$own" ]; then patterns+=("$pat"); continue; fi
      printf '%s\n' "$pat" > "$probe"
      if [ -n "$(_gs_git "$ck" ls-files -c -i -X "$probe" 2>/dev/null | head -n1)" ]; then
        withheld="$withheld $pat"
      else
        patterns+=("$pat")
      fi
    done < "$src"
  done
  rm -f -- "$probe"
  [ -z "$withheld" ] || echo "graph-sweep: $name: default noise withheld, the repository tracks matching files:$withheld (a $name.list is honoured as written)" >&2
  if ! { echo "# generated by ccd-graph-sweep for the repository's graph — never committed, never edited"
          cat -- "$ck/.git/graphifyignore.committed"
          [ "${#patterns[@]}" -eq 0 ] || printf '%s\n' "${patterns[@]}"; } > "$ck/.git/graphifyignore.new" \
     || ! mv -f -- "$ck/.git/graphifyignore.new" "$gen"; then
    GS_WHY="cannot write the generated .graphifyignore in the checkout"; return 1
  fi
  rm -f -- "$ck/.git/graphifyignore.committed"
  GS_DIGEST="$(_plat_sha256 < "$gen")"; GS_DIGEST="${GS_DIGEST%% *}"
  [ -n "$GS_DIGEST" ] || { GS_WHY="cannot hash the generated .graphifyignore"; return 1; }
}

# ── the store's per-repository directory and its checkout of main (spec §2.1, §2.2, §3.1 steps 1-2) ──
# Runs for every repository of the pass, building or not: the checkout is moved to the source ref's commit and the
# generated filter written, because the filter's digest is one input of the decision. A failure here ends the
# repository's row (`failed`, `fail: setup`, or `no-source`); nothing is built.
_gs_prepare() {   # <common dir> -> 0 ready (CUR set) / 1 the row is ended
  local c="$1" key name raw kd ck fh age b=""
  if ! _gr_repo_key "$c" >/dev/null; then
    CUR="unkeyed:$c"; K_ORDER+=("$CUR"); K_COMMON["$CUR"]="$c"; K_RK["$CUR"]=""
    _gs_end failed setup "$GR_WHY"; return 1
  fi
  key="$GR_REPO_KEY"; CUR="$key"
  if [ -n "${K_COMMON[$key]+x}" ]; then   # two common dirs, one key: never shared, never overwritten
    CUR="collision:$c"; K_ORDER+=("$CUR"); K_COMMON["$CUR"]="$c"; K_RK["$CUR"]="$key"
    _gs_end failed setup "repository key $key is already this pass's key for ${K_COMMON[$key]}"; return 1
  fi
  K_ORDER+=("$key"); K_COMMON["$key"]="$c"; K_RK["$key"]="$key"
  _gs_last_row "$key"
  case " ${GK[CCRC_GRAPH_REPOS_EXCLUDE]} " in
    *" $key "*) _gs_end excluded - "CCRC_GRAPH_REPOS_EXCLUDE names $key"; return 1 ;;
  esac
  name="${key%-*}"
  if [ "${c##*/}" = .git ]; then raw="${c%/.git}"; raw="${raw##*/}"; else raw="${c##*/}"; raw="${raw%.git}"; fi
  # The checkout is <key>/checkout/<name>, never <key>/<name>: the name is the repository's own, and beside memory/,
  # staging/, source, builds/ and current it could BE one of them (D-7664). Its basename stays the
  # repository's name, which is the graph's root name. `git clone` makes checkout/ itself.
  kd="$GS_STORE/$key"; ck="$kd/checkout/$name"; K_DIR["$key"]="$kd"; K_CK["$key"]="$ck"
  if ! mkdir -p -- "$kd/memory" || ! chmod 0755 "$kd" "$kd/memory"; then
    _gs_end failed setup "cannot create the store's directory for $key"; return 1
  fi
  if [ -f "$kd/source" ]; then
    if [ "$(cat "$kd/source" 2>/dev/null)" != "$c" ]; then
      _gs_end failed setup "the store's directory for $key belongs to $(cat "$kd/source" 2>/dev/null), not this repository's $c"; return 1
    fi
  elif ! printf '%s\n' "$c" > "$kd/source"; then
    _gs_end failed setup "cannot write the store's source file for $key"; return 1
  fi
  # 1. the throttled fetch (spec §3.1 step 1): only a remote-tracking source ref of `origin` is fetched, only its
  #    branch, and a failure is a reason on the row, never an outcome.
  if [ "${GK[CCRC_GRAPH_FETCH_SECS]}" -gt 0 ] && _gr_source_ref "$c" >/dev/null; then
    case "$GR_SOURCE_REF" in refs/remotes/origin/*) b="${GR_SOURCE_REF#refs/remotes/origin/}" ;; esac
    [ "$b" != HEAD ] || b=""
    fh="$c/FETCH_HEAD"; age=-1
    [ -f "$fh" ] && age=$(( $(date +%s) - $(_plat_mtime "$fh") ))
    if [ -n "$b" ] && { [ "$age" -lt 0 ] || [ "$age" -ge "${GK[CCRC_GRAPH_FETCH_SECS]}" ]; }; then
      env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_COMMON_DIR -u GIT_OBJECT_DIRECTORY \
        -u GIT_ALTERNATE_OBJECT_DIRECTORIES -u GIT_NAMESPACE GIT_TERMINAL_PROMPT=0 \
        timeout 60 git --git-dir="$c" fetch --no-tags -q origin "$b" >/dev/null 2>&1 \
        || _gs_note "fetch of origin $b failed; using the refs this box has"
    fi
  fi
  # 2. the source ref (spec §3.1 step 2).
  if ! _gr_source_ref "$c" >/dev/null; then _gs_end no-source - "${GR_WHY#no-source: }"; return 1; fi
  K_TIP["$key"]="$GR_SOURCE_COMMIT"; K_REF["$key"]="$GR_SOURCE_REF"
  # The shared clone (spec §2.2): a separate repository borrowing the main repository's objects, so it appears in no
  # `git worktree list`; it never runs gc and runs no hooks.
  if [ ! -d "$ck/.git" ]; then
    rm -rf -- "$ck"
    if ! env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_COMMON_DIR -u GIT_OBJECT_DIRECTORY \
        -u GIT_ALTERNATE_OBJECT_DIRECTORIES -u GIT_NAMESPACE GIT_TERMINAL_PROMPT=0 \
        git clone --shared --no-checkout --no-tags -q -- "$c" "$ck" >/dev/null 2>&1; then
      rm -rf -- "$ck"; _gs_end failed setup "cannot make the store's shared clone of $c"; return 1
    fi
  fi
  if ! _gs_git "$ck" config gc.auto 0 || ! _gs_git "$ck" config core.hooksPath /dev/null; then
    _gs_end failed setup "cannot configure the store's checkout of $key"; return 1
  fi
  grep -qxF '/.graphifyignore' "$ck/.git/info/exclude" 2>/dev/null \
    || { mkdir -p -- "$ck/.git/info" && printf '%s\n' '/.graphifyignore' >> "$ck/.git/info/exclude"; } \
    || { _gs_end failed setup "cannot exclude the generated .graphifyignore in the store's checkout"; return 1; }
  if ! _gs_git "$ck" checkout -q --detach --force "$GR_SOURCE_COMMIT" >/dev/null 2>&1 \
     || ! _gs_git "$ck" clean -ffdxq -e /.graphifyignore >/dev/null 2>&1; then
    _gs_end failed setup "cannot move the store's checkout of $key to ${GR_SOURCE_COMMIT:0:12}"; return 1
  fi
  if ! _gs_noise "$ck" "$raw"; then K_KIND["$key"]=full; _gs_end refused-by-guard - "$GS_WHY"; return 1; fi
  K_DIGEST["$key"]="$GS_DIGEST"
  return 0
}

# ── the decision (spec §3.1 step 3, §3.3, §3.3.1; N5, N27, N28) ───────────
# ONE function, and it reads exactly two state files: the current build's meta.json (the state of the PUBLISHED
# build) and the census's last repos[] row for this repository (the outcome of the LAST ATTEMPT). git answers the
# questions about history. Sets K_KIND to fresh, full, incremental or skipped-backoff, with K_WHY, the reasons.
_gs_decide() {   # <key>
  local key="$1" kd="${K_DIR[$1]}" tip="${K_TIP[$1]}" m="" now
  local built="" engine="" digest="" lfat="" prev pfail ff ffat_s
  local -a hard=() soft=()
  now=$(date +%s)
  if [ -d "$kd/current" ]; then
    m="$(head -c 65536 "$kd/current/meta.json" 2>/dev/null | jq -r 'select(.schema == 1)
      | [.commit // "", .engine // "", .noise_digest // "", (try (.last_full_at | fromdateiso8601 | floor | tostring) catch "")]
      | join("\u001f")' 2>/dev/null)" || m=""
  fi
  IFS=$'\x1f' read -r built engine digest lfat <<<"$m"
  [[ "$built" =~ ^[0-9a-f]{40}$ ]] || built=""
  prev="${K_PREV[$key]}" pfail="${K_PFAIL[$key]}" ff="${K_FF[$key]}" ffat_s="${K_FFATS[$key]}"
  K_BUILT["$key"]="$built"
  K_CHANGED["$key"]=0; K_BEHIND["$key"]=0; K_PUB["$key"]=0
  if [ -z "$built" ]; then
    hard+=("no published build")
  else
    K_PUB["$key"]=1
    [ "$engine" = "$PIN" ] || hard+=("engine ${engine:-unknown} is not the pin $PIN")
    [ "$digest" = "${K_DIGEST[$key]}" ] || hard+=("the corpus definition changed (noise digest)")
    if [ "$built" != "$tip" ]; then
      if ! _gr_git "${K_COMMON[$key]}" merge-base --is-ancestor "$built" "$tip" 2>/dev/null; then
        hard+=("main was rewritten (${built:0:12} is not an ancestor of ${tip:0:12})")
      else
        K_BEHIND["$key"]="$(_gr_git "${K_COMMON[$key]}" rev-list --count "$built..$tip" 2>/dev/null || echo 0)"
        local n
        n="$(_gs_git "${K_CK[$key]}" diff -z --no-renames --name-only "$built" "$tip" 2>/dev/null | tr -cd '\0' | wc -c)"
        n="${n//[![:digit:]]/}"; K_CHANGED["$key"]="${n:-0}"
        if _gs_git "${K_CK[$key]}" diff --no-renames --name-only "$built" "$tip" -- .graphifyignore 2>/dev/null | grep -q .; then
          hard+=("the commit changes .graphifyignore")
        fi
        [ "${K_CHANGED[$key]}" -le "${GK[CCRC_GRAPH_INCREMENTAL_MAX_FILES]}" ] \
          || soft+=("${K_CHANGED[$key]} files changed, above CCRC_GRAPH_INCREMENTAL_MAX_FILES=${GK[CCRC_GRAPH_INCREMENTAL_MAX_FILES]}")
      fi
    fi
    if [ "${#hard[@]}" -eq 0 ] && [ "$built" = "$tip" ] && [ -n "$lfat" ] \
       && [ $(( now - lfat )) -lt "${GK[CCRC_GRAPH_FULL_REBUILD_SECS]}" ]; then
      K_KIND["$key"]=fresh; K_WHY["$key"]=""; return 0
    fi
    if [ -z "$lfat" ] || [ $(( now - lfat )) -ge "${GK[CCRC_GRAPH_FULL_REBUILD_SECS]}" ]; then
      soft+=("the last full build is older than CCRC_GRAPH_FULL_REBUILD_SECS=${GK[CCRC_GRAPH_FULL_REBUILD_SECS]}")
    fi
    case "$prev:$pfail" in
      refused-shrink:*|refused-by-guard:*|failed:engine|failed:publish)
        soft+=("the last attempt was ${prev}${pfail:+ (fail: $pfail)}") ;;
    esac
  fi
  if [ "${#hard[@]}" -eq 0 ] && [ "${#soft[@]}" -eq 0 ]; then
    K_KIND["$key"]=incremental; K_WHY["$key"]="main moved ${K_BEHIND[$key]} commit(s)"; return 0
  fi
  # §3.3.1: in backoff no full build starts; a soft-only pass refreshes incrementally where main moved.
  if [ "$ff" -ge "${GK[CCRC_GRAPH_FULL_FAIL_MAX]}" ] && [ -n "$ffat_s" ] \
     && [ $(( now - ffat_s )) -lt "${GK[CCRC_GRAPH_FAIL_BACKOFF_SECS]}" ]; then
    local until; until="$(_gs_iso "$(( ffat_s + GK[CCRC_GRAPH_FAIL_BACKOFF_SECS] ))")"
    if [ "${#hard[@]}" -eq 0 ] && [ "$built" != "$tip" ]; then
      K_KIND["$key"]=incremental
      K_WHY["$key"]="in full-build backoff until ${until:-later} ($ff failed full attempt(s)); refreshing incrementally"
      return 0
    fi
    K_KIND["$key"]="skipped-backoff"
    K_WHY["$key"]="$ff failed full attempt(s); no full build until ${until:-later} (CCRC_GRAPH_FAIL_BACKOFF_SECS=${GK[CCRC_GRAPH_FAIL_BACKOFF_SECS]})"
    if [ "${#hard[@]}" -gt 0 ]; then K_WHY["$key"]="${K_WHY[$key]}; it needs a full build: ${hard[0]}"; fi
    return 0
  fi
  K_KIND["$key"]=full
  local w=""; local x
  for x in ${hard[@]+"${hard[@]}"} ${soft[@]+"${soft[@]}"}; do w="${w:+$w; }$x"; done
  K_WHY["$key"]="$w"
}

# ── a tree to delete, read-only parts included (a published build's directories are 0555) ──
_gs_rmtree() {   # <dir> — only ever a directory of the store
  local doomed="$1"
  [ -e "$doomed" ] || [ -L "$doomed" ] || return 0
  if [ ! -L "$doomed" ]; then find "$doomed" -type d ! -perm -u+w -exec chmod u+w {} + 2>/dev/null; fi
  if command -v ionice >/dev/null 2>&1; then ionice -c3 rm -rf -- "$doomed"; else rm -rf -- "$doomed"; fi
}

# ── staging (spec §3.5 step 1) ────────────────────────────────────────────
# Created empty, then the current build's four outputs copied in WRITABLE (`install -m 0644`: the published originals
# are 0444 and the engine and the stamper rewrite them in place), and the absolute memory link. No lock file, queue
# file or .graphify_root is ever copied. GS_STAGING names it for the trap until the build ends.
GS_STAGING=""
_gs_drop_staging() { [ -z "$GS_STAGING" ] || _gs_rmtree "$GS_STAGING"; GS_STAGING=""; }
_gs_stage() {   # <key> -> 0 staged / 1 (GS_WHY)
  local kd="${K_DIR[$1]}" stg f
  stg="$kd/staging"
  _gs_rmtree "$stg"
  GS_STAGING="$stg"
  if ! mkdir -m 0755 -- "$stg" || ! mkdir -m 0755 -- "$stg/graphify-out"; then GS_WHY="cannot create $stg"; return 1; fi
  for f in graph.json manifest.json .graphify_labels.json GRAPH_REPORT.md; do
    [ -f "$kd/current/$f" ] || continue
    install -m 0644 -- "$kd/current/$f" "$stg/graphify-out/$f" || { GS_WHY="cannot stage the current build's $f"; return 1; }
  done
  ln -s -- "$kd/memory" "$stg/graphify-out/memory" || { GS_WHY="cannot place the memory link in staging"; return 1; }
}

# ── the corpus guard (spec §2.2), on the checkout ─────────────────────────
# detect() over the checkout, with the build's own GRAPHIFY_OUT, must be a subset of the commit's tracked files. Two
# exemptions: the generated .graphifyignore, and every path under realpath(<store>/<repo-key>/memory)/ — detect()
# always adds the files under GRAPHIFY_OUT/memory, here the link to the repository's saved results, which no
# `git ls-tree` holds. Paths are compared as realpaths against the checkout's, so no spelling of either can slip a
# file past. On a clean checkout it should never fire; when it does, nothing is built.
_gs_guard() {   # <key> -> 0 / 1 (GS_WHY)
  local ck="${K_CK[$1]}" stg="${K_DIR[$1]}/staging" mem corpus tracked breach n shown more
  mem="$(cd -P -- "${K_DIR[$1]}/memory" 2>/dev/null && pwd -P)" || { GS_WHY="the memory directory cannot be resolved"; return 1; }
  corpus="$( cd "$ck" && GRAPHIFY_OUT="$stg/graphify-out" "$VENV/bin/python" -s -P - "$mem" 2>>"$LOG" <<'GFXPY'
import os, sys
from pathlib import Path
from graphify.detect import detect
mem = sys.argv[1].rstrip('/') + '/'
root = os.path.realpath('.')
r = detect(Path('.'))
for k in ('code', 'document', 'paper', 'image', 'video'):
    for f in r['files'].get(k, []):
        p = os.path.realpath(os.path.join(root, str(f)))
        if p.startswith(mem) or p == os.path.join(root, '.graphifyignore'):
            continue
        sys.stdout.write((os.path.relpath(p, root) if p.startswith(root + '/') else p) + '\n')
GFXPY
  )" || { GS_WHY="detect() failed in the store's checkout"; return 1; }
  tracked="$(_gs_git "$ck" ls-tree -r -z --name-only HEAD 2>/dev/null | tr '\0' '\n')"
  breach="$(comm -23 <(sort -u <<<"$corpus") <(sort -u <<<"$tracked") | grep -v '^$' || true)"
  [ -n "$breach" ] || return 0
  n="$(wc -l <<<"$breach")"; n="${n//[![:digit:]]/}"
  shown="$(head -n 5 <<<"$breach" | tr '\n' ' ')"
  more=$(( n - $(head -n 5 <<<"$breach" | wc -l) ))
  GS_WHY="untracked paths entered the corpus: ${shown}"
  [ "$more" -le 0 ] || GS_WHY="${GS_WHY}(+$more more)"
  return 1
}

# ── the stamp (spec §3.5 step 3): today's `_gs_restamp`, retargeted from a tree's graphify-out to a directory ──
# When the engine leaves its outputs untouched (an incremental with no topology change, §1.3), graph.json still
# carries the previous commit. This splices <sha> over graph.json's LAST `built_at_commit` in its last 4 KiB and over
# GRAPH_REPORT.md's "- Built from commit:" line, by copy and ONE rename each. With <old>, only a stamp naming <old>
# is replaced: a value naming any other commit is left as the engine wrote it, so the publish check refuses it
# (N9). graph.json without the key is a refusal (`cannot stamp`); a report that cannot be rewritten is one log line.
_gs_stamp_dir() {   # <dir> <sha> [<old sha>] -> 0 / 1 (GS_WHY)
  local dir="$1" sha="$2" old="${3:-}" f spliced rc
  [[ "$sha" =~ ^[0-9a-f]{40}$ ]] || { GS_WHY="cannot stamp: '$sha' is not a commit"; return 1; }
  for f in graph.json GRAPH_REPORT.md; do
    if [ ! -f "$dir/$f" ]; then
      [ "$f" = graph.json ] || continue
      GS_WHY="cannot stamp: no graph.json"; return 1
    fi
    spliced="$("$VENV/bin/python" -s -P - "$dir/$f" "$sha" "$old" 2>>"$LOG" <<'GFXPY'
import os, re, shutil, sys, tempfile
path, new, old = sys.argv[1], sys.argv[2], sys.argv[3]
name = os.path.basename(path)
is_graph = name == 'graph.json'
size = os.path.getsize(path)
# graph.json is tens of MB and `built_at_commit` is its LAST key, read from the tail as every reader reads it.
base = max(0, size - 4096) if is_graph else 0
pat = (re.compile(rb'"built_at_commit"\s*:\s*"([0-9a-f]*)"') if is_graph
       else re.compile(rb'- Built from commit: `([0-9a-f]+)`'))
with open(path, 'rb') as fh:
    fh.seek(base); tail = fh.read()
m = None
for m in pat.finditer(tail):
    pass
if m is None:
    if is_graph:
        print('cannot stamp: no built_at_commit in the last %d bytes of graph.json' % len(tail)); sys.exit(1)
    sys.exit(0)
val = m.group(1).decode()
full = new if is_graph else new[:len(val)]
if val == full:
    sys.exit(0)
if not old or val != (old if is_graph else old[:len(val)]):
    sys.exit(0)
fd, tmp = tempfile.mkstemp(prefix='.' + name + '.', dir=os.path.dirname(path) or '.')
os.close(fd)
try:
    shutil.copyfile(path, tmp)
    shutil.copymode(path, tmp)
    with open(tmp, 'r+b') as fh:
        fh.seek(base)
        fh.write(tail[:m.start(1)] + full.encode() + tail[m.end(1):])
        fh.truncate()
except Exception as exc:
    try:
        os.unlink(tmp)
    except OSError:
        pass
    print('cannot stamp: %s: %s' % (name, exc)); sys.exit(1)
print(tmp)
GFXPY
    )"; rc=$?
    if [ "$rc" -ne 0 ]; then
      [ "$f" = graph.json ] || { printf 'graph-sweep: %s: GRAPH_REPORT.md not stamped (%s)\n' "$dir" "${spliced:-python refused}" >> "$LOG"; continue; }
      GS_WHY="${spliced:-cannot stamp: the stamper could not run}"; return 1
    fi
    [ -n "$spliced" ] || continue
    if ! mv -f -- "$spliced" "$dir/$f"; then
      rm -f -- "$spliced"
      [ "$f" = graph.json ] || continue
      GS_WHY="cannot stamp: rename failed (graph.json)"; return 1
    fi
  done
  return 0
}

# ── the plan's outcome table (finding 3; D-7366): how a build ended, by the outer `timeout`'s exit ──
# Only the engine and publish classes force a full build next pass (spec §3.3); an exit the wrapper did not classify
# after `.started` (an external SIGKILL, another signal, an uncaught exception) is `fail: unknown`, which never
# escalates. The sweep reads only the last `graph-build: <class>:` line and the one `ccrc test` OOM sentence.
GS_OOM_SENTENCE="the test slice's memory cap killed a process during this run"
_gs_outcome() {   # <rc> <started 1|0> <elapsed ms> <stderr file>
  local rc="$1" st="$2" ms="$3" err="$4" last="" bt="${GK[CCRC_GRAPH_BUILD_TIMEOUT]}"
  last="$(grep -E '^graph-build: (setup|slot-wait|engine|publish): ' "$err" 2>/dev/null | tail -n 1)"
  case "$rc:$st" in
    0:1) _gs_end refreshed - "" ;;   # provisional: the publish decides (spec §3.5)
    1:1) if [ "$last" = "graph-build: engine: _rebuild_code returned False" ]; then _gs_end failed engine "${last#graph-build: }"
         else _gs_end failed unknown "exit 1${last:+: ${last#graph-build: }}"; fi ;;
    1:0|2:0)
      if [ -n "$last" ]; then _gs_end failed setup "${last#graph-build: }"
      else _gs_end failed setup "exit $rc before the build started: $(tail -n 1 "$err" 2>/dev/null)"; fi ;;
    3:0) _gs_end skipped-slots - "${last#graph-build: }" ;;
    124:0) _gs_end skipped-slots - "no heavy test slot within CCRC_GRAPH_SLOT_WAIT_SECS=${GK[CCRC_GRAPH_SLOT_WAIT_SECS]} (the outer bound fired in the queue)" ;;
    124:1) _gs_end timed-out - "the build exceeded CCRC_GRAPH_BUILD_TIMEOUT=${bt}s" ;;
    137:1)
      if grep -qF "$GS_OOM_SENTENCE" "$err" 2>/dev/null; then
        _gs_end oom-killed - "$(grep -F "$GS_OOM_SENTENCE" "$err" | tail -n 1)"
      elif [ "$ms" -ge $(( bt * 1000 )) ]; then
        _gs_end timed-out - "killed after CCRC_GRAPH_BUILD_TIMEOUT=${bt}s (the --kill-after KILL)"
      else
        _gs_end failed unknown "killed by signal 9"
      fi ;;
    *:1) _gs_end failed unknown "exit $rc" ;;
    *) _gs_end failed setup "exit $rc before the build started" ;;
  esac
}

# ── one build (spec §3.4, §3.5, §4) ───────────────────────────────────────
_gs_build() {   # <key>
  local key="$1" kd="${K_DIR[$1]}" ck="${K_CK[$1]}" tip="${K_TIP[$1]}" kind="${K_KIND[$1]}" built="${K_BUILT[$1]}"
  local stg="${K_DIR[$1]}/staging" st_line st_rc launched t0 rc ms bms st_s started=0 bout berr peak cpu
  local slot="${GK[CCRC_GRAPH_SLOT_WAIT_SECS]}" bt="${GK[CCRC_GRAPH_BUILD_TIMEOUT]}" ts id
  local -a changed=()
  ts="$(date -u +%Y%m%dT%H%M%SZ)"
  if ! _gs_stage "$key"; then _gs_end failed setup "$GS_WHY"; return 0; fi
  if [ "$kind" = incremental ]; then
    _gs_git "$ck" diff -z --no-renames --name-only "$built" "$tip" > "$stg/changed.z" 2>/dev/null \
      || { _gs_end failed setup "cannot list the files changed since ${built:0:12}"; return 0; }
    changed=(--changed "$stg/changed.z")
  else
    K_CHANGED["$key"]=0
  fi
  if ! _gs_guard "$key"; then _gs_end refused-by-guard - "$GS_WHY"; return 0; fi
  # D-7356: `ccrc test` DEGRADES, it never refuses, so the refusal of a missing slice is the sweep's own check.
  st_line="$("$GRAPH_LIB/ccrc-test" --status 2>&1 9>&-)"; st_rc=$?
  st_line="$(tail -n 1 <<<"$st_line")"
  if [ "$st_rc" -ne 0 ]; then _gs_end failed setup "ccrc test --status: $st_line"; return 0; fi
  case "$st_line" in *"not contained"*) _gs_note "uncontained: $st_line" ;; esac
  bout="$stg/build.stdout"; berr="$stg/build.stderr"
  printf 'graph-sweep: build %s (%s) at %s\n' "$key" "$kind" "$(date -u +%FT%TZ)" >> "$LOG"
  launched="$(date +%s)"; t0="$(_plat_epoch_ms)"
  # The call of spec §3.4, from the checkout's realpath, with the pass lock's descriptor CLOSED (9>&-): an orphaned
  # build can never hold the pass lock. `--local` (D-7648): a graph build is this box's own work, never the test box's.
  ( cd "$ck" || exit 2
    GRAPHIFY_OUT="$stg/graphify-out" GRAPHIFY_NO_BACKUP=1 PYTHONHASHSEED=0 \
    GRAPHIFY_MAX_WORKERS="${GK[CCRC_GRAPH_MAX_WORKERS]}" GIT_TERMINAL_PROMPT=0 \
    exec timeout --kill-after=30 "$(( slot + bt ))" "$GRAPH_LIB/ccrc-test" --local --heavy -- \
      nice -n "${GK[CCRC_GRAPH_BUILD_NICE]}" ionice -c3 timeout --kill-after=30 "$bt" \
      "$VENV/bin/python" -s -P "$GRAPH_LIB/graph-build" --root "$ck" --out "$stg/graphify-out" --commit "$tip" \
        --pin "$PIN" --memory "$kd/memory" --launched "$launched" --slot-wait "$slot" ${changed[@]+"${changed[@]}"}
  ) > "$bout" 2> "$berr" 9>&-
  rc=$?
  ms=$(( $(_plat_epoch_ms) - t0 ))
  K_DUR["$key"]="$ms"
  # The outcome table's "elapsed" is the BUILD's: from the wrapper's `.started` stamp (its first field, epoch
  # seconds), so a long wait for a heavy slot never makes an external kill read as the timeout's.
  bms="$ms"
  if [ -e "$stg/.started" ]; then
    started=1
    read -r st_s _ < "$stg/.started" 2>/dev/null || st_s=""
    [[ "$st_s" =~ ^[0-9]+$ ]] && bms=$(( ($(date +%s) - st_s) * 1000 ))
  fi
  cat -- "$bout" "$berr" >> "$LOG" 2>/dev/null
  # -E, so the alternation is the same on GNU and BSD sed (a BRE `\|` is a GNU extension)
  peak="$(sed -nE 's/^graph-build: peak_kb=([0-9]+|null) cpu_ms=.*$/\1/p' "$bout" | tail -n 1)"
  cpu="$(sed -nE 's/^graph-build: peak_kb=.* cpu_ms=([0-9]+|null)$/\1/p' "$bout" | tail -n 1)"
  [[ "$peak" =~ ^[0-9]+$ ]] || peak=null
  [[ "$cpu" =~ ^[0-9]+$ ]] || cpu=null
  K_PEAK["$key"]="$peak"; K_CPU["$key"]="$cpu"
  _gs_outcome "$rc" "$started" "$bms" "$berr"
  [ "$rc:$started" = 0:1 ] || return 0
  [ "$peak" != null ] || _gs_note "peak unmeasured"
  # ── stamp, publish checks, publish (spec §3.5 steps 3-5) ──
  local g gtip nodes edges files pred lhs rhs id lfc lfa
  g="$stg/graphify-out"
  if ! _gs_stamp_dir "$g" "$tip" "$built"; then _gs_end failed publish "$GS_WHY"; return 0; fi
  if ! read -r gtip nodes edges files < <(jq -r '[(.built_at_commit // ""), (.nodes // [] | length),
        ((.links // .edges // []) | length), ([(.nodes // [])[] | .source_file // empty] | unique | length)] | @tsv' \
        "$g/graph.json" 2>/dev/null); then
    _gs_end failed publish "graph.json does not parse"; return 0
  fi
  [ "$gtip" = "$tip" ] || { _gs_end failed publish "graph.json's built_at_commit is ${gtip:-empty}, not the tip ${tip:0:12}"; return 0; }
  pred="$(jq -r '.nodes // 0' "$kd/current/meta.json" 2>/dev/null)"; [[ "$pred" =~ ^[0-9]+$ ]] || pred=0
  lhs=$(( nodes * 100 )); rhs=$(( pred * (100 - GK[CCRC_GRAPH_MAX_SHRINK_PCT]) ))
  if [ "$lhs" -lt "$rhs" ]; then
    _gs_end refused-shrink - "$nodes nodes against the served build's $pred, a shrink past CCRC_GRAPH_MAX_SHRINK_PCT=${GK[CCRC_GRAPH_MAX_SHRINK_PCT]}"
    return 0
  fi
  id="${tip:0:12}-$PIN-$ts"
  if [ "$kind" = full ]; then lfc="$tip"; lfa="$(date -u +%FT%TZ)"
  else
    lfc="$(jq -r '.last_full_commit // ""' "$kd/current/meta.json" 2>/dev/null)"
    lfa="$(jq -r '.last_full_at // ""' "$kd/current/meta.json" 2>/dev/null)"
  fi
  local doc='{schema:1, build_id:$build_id, repo_key:$repo_key, source:$source, store:$store, ref:$ref, commit:$commit,
    engine:$engine, kind:$kind, changed_files:$changed_files, last_full_commit:$last_full_commit,
    last_full_at:$last_full_at, noise_digest:$noise_digest, nodes:$nodes, edges:$edges, files:$files,
    built_at:$built_at, duration_ms:$duration_ms, peak_mem_kb:$peak_mem_kb, cpu_ms:$cpu_ms}'
  if ! jq -n --arg build_id "$id" --arg repo_key "$key" --arg source "${K_COMMON[$key]}" --arg store "$GS_STORE" \
      --arg ref "${K_REF[$key]}" --arg commit "$tip" --arg engine "$PIN" --arg kind "$kind" \
      --argjson changed_files "${K_CHANGED[$key]}" --arg last_full_commit "$lfc" --arg last_full_at "$lfa" \
      --arg noise_digest "${K_DIGEST[$key]}" --argjson nodes "$nodes" --argjson edges "$edges" --argjson files "$files" \
      --arg built_at "$(_gs_iso "$launched")" \
      --argjson duration_ms "$ms" --argjson peak_mem_kb "$peak" --argjson cpu_ms "$cpu" "$doc" > "$g/meta.json"; then
    _gs_end failed publish "cannot write meta.json"; return 0
  fi
  mkdir -p -- "$kd/builds" || { _gs_end failed publish "cannot create the builds directory"; return 0; }
  if [ -e "$kd/builds/$id" ] || [ -L "$kd/builds/$id" ]; then _gs_end failed publish "build id exists: $id"; return 0; fi
  # Everything below the build's own directory first: renaming a directory into another parent needs write permission
  # on the directory itself (its `..` entry changes), so the top loses it once it is in place.
  find "$g" -mindepth 1 ! -type l -exec chmod a-w {} + 2>/dev/null
  if ! _plat_mv_notdir "$g" "$kd/builds/$id"; then
    find "$g" -type d -exec chmod u+w {} + 2>/dev/null
    _gs_end failed publish "cannot move the build into builds/$id"; return 0
  fi
  chmod a-w "$kd/builds/$id" 2>/dev/null
  if ! _plat_ln_swap "builds/$id" "$kd/current"; then _gs_end failed publish "cannot point current at builds/$id"; return 0; fi
  _gs_drop_staging
  if [ "$kind" = full ]; then _gs_end rebuilt - "${K_WHY[$key]}"; else _gs_end refreshed - "${K_WHY[$key]}"; fi
}

# ── links (spec §6.1; N1, N16) ────────────────────────────────────────────
# One absolute link per tree, `<tree>/graphify-out -> <store>/<repo-key>/current`, made only where graphify-out is
# ABSENT (a real directory waits for migration, GR6), only once `current` resolves to a published build, and only
# after `git check-ignore -q graphify-out` (no slash) passes: the slash-only exclude line does not ignore a link.
GS_LINKED=0 GS_PENDING=0 GS_UNIGNORED=0
_gs_link() {   # <key> <1: link where due | 0: count only>
  local key="$1" may="$2" tgt="${K_DIR[$1]:-}/current" tree
  GS_LINKED=0 GS_PENDING=0 GS_UNIGNORED=0
  while IFS= read -r tree; do
    [ -n "$tree" ] || continue
    if [ -L "$tree/graphify-out" ]; then
      [ "$(readlink "$tree/graphify-out")" != "$tgt" ] || GS_LINKED=$((GS_LINKED+1))
      continue
    fi
    if [ -e "$tree/graphify-out" ]; then GS_PENDING=$((GS_PENDING+1)); continue; fi
    [ "$may" = 1 ] && [ -d "$tgt" ] || continue
    if ! _gs_git "$tree" check-ignore -q graphify-out 2>/dev/null; then GS_UNIGNORED=$((GS_UNIGNORED+1)); continue; fi
    ln -s -- "$tgt" "$tree/graphify-out" && GS_LINKED=$((GS_LINKED+1))
  done <<<"${K_TREES[$key]:-}"
}

# ── collection (spec §3.5 step 6, §9.2 for this repository's builds and staging) ──
_gs_collect() {   # <key>
  local kd="${K_DIR[$1]:-}" cur b keep now
  [ -n "$kd" ] && [ -d "$kd" ] || return 0
  _gs_rmtree "$kd/staging"
  [ -d "$kd/builds" ] || return 0
  cur="$(readlink "$kd/current" 2>/dev/null)"; cur="${cur#builds/}"
  keep=$(( GK[CCRC_GRAPH_KEEP_BUILDS] - 1 )); now=$(date +%s)
  while IFS= read -r b; do
    [ -n "$b" ] && [ "$b" != "$cur" ] || continue
    if [ "$keep" -gt 0 ]; then keep=$((keep-1)); continue; fi
    [ $(( now - $(_plat_mtime "$kd/builds/$b") )) -ge "${GK[CCRC_GRAPH_BUILD_GRACE_SECS]}" ] || continue
    _gs_rmtree "$kd/builds/$b"
  done < <(for b in "$kd/builds"/*/; do b="${b%/}"; b="${b##*/}"; [ "$b" != '*' ] && printf '%s %s\n' "${b##*-}" "$b"; done \
           | sort -r | cut -d' ' -f2)
}

# ── settings.json (spec §5.3): the three read-side settings, as the session hook reads them ──
_gs_settings() {
  [ -n "$GS_STORE" ] && [ -d "$GS_STORE" ] || return 0
  jq -cn --argjson a "${GK[CCRC_GRAPH_GATE_MAX_DIFF_PCT]}" --argjson b "${GK[CCRC_GRAPH_GATE_MAX_DENIALS]}" \
    --argjson c "${GK[CCRC_GRAPH_CARD_DIFF_LIST_MAX]}" \
    '{schema:1, gate_max_diff_pct:$a, gate_max_denials:$b, card_diff_list_max:$c}' > "$GS_STORE/.settings.json.new" \
    && mv -f -- "$GS_STORE/.settings.json.new" "$GS_STORE/settings.json"
}

# ── the census row (spec §7, plus cpu_ms, D-7357) ─────────────────────────
_gs_emit() {   # <key>
  local key="$1" kd="${K_DIR[$1]:-}" served="" nodes=0 edges=0 ff="${K_FF[$1]:-0}" ffat="${K_FFAT[$1]:-}" o="${K_OUTCOME[$1]}"
  local nt=0 reason
  if [ -n "$kd" ] && [ -d "$kd/current" ]; then
    read -r served nodes edges < <(jq -r '[.commit // "", .nodes // 0, .edges // 0] | @tsv' "$kd/current/meta.json" 2>/dev/null) \
      || { served=""; nodes=0; edges=0; }
  fi
  [[ "$nodes" =~ ^[0-9]+$ ]] || nodes=0; [[ "$edges" =~ ^[0-9]+$ ]] || edges=0
  # §3.3.1: consecutive FULL attempts that did not publish; a published full build resets the count.
  if [ "${K_KIND[$key]:-}" = full ]; then
    case "$o" in
      rebuilt) ff=0; ffat="" ;;
      failed|timed-out|oom-killed|refused-shrink|refused-by-guard) ff=$((ff+1)); ffat="$(date -u +%FT%TZ)" ;;
    esac
  fi
  [ -z "${K_TREES[$key]:-}" ] || nt="$(grep -c . <<<"${K_TREES[$key]}")"
  reason="${K_REASON[$key]:-}"; [ -z "${K_NOTE[$key]:-}" ] || reason="${reason:+$reason; }${K_NOTE[$key]}"
  local kind="${K_KIND[$key]:-}"; case "$kind" in full|incremental) ;; *) kind="" ;; esac
  case "$o" in fresh|excluded|no-source|skipped-backoff) kind="" ;; esac
  _gs_row "$(jq -cn --arg repo_key "${K_RK[$key]:-}" --arg source "${K_COMMON[$key]}" --arg ref "${K_REF[$key]:-}" \
    --arg tip "${K_TIP[$key]:-}" --arg served "$served" --arg outcome "$o" --arg kind "$kind" \
    --argjson changed_files "${K_CHANGED[$key]:-0}" --arg reason "$reason" --arg fail "${K_FAIL[$key]:-}" \
    --argjson duration_ms "${K_DUR[$key]:-0}" --argjson peak_mem_kb "${K_PEAK[$key]:-null}" --argjson cpu_ms "${K_CPU[$key]:-null}" \
    --argjson full_failures "$ff" --arg full_failed_at "$ffat" --argjson nodes "$nodes" --argjson edges "$edges" \
    --argjson nt "$nt" --argjson linked "$GS_LINKED" --argjson pending "$GS_PENDING" \
    '{repo_key:$repo_key, source:$source, ref:$ref, tip:$tip, served:$served, outcome:$outcome, kind:$kind,
      changed_files:$changed_files, reason:$reason, fail:$fail, duration_ms:$duration_ms, peak_mem_kb:$peak_mem_kb,
      cpu_ms:$cpu_ms, full_failures:$full_failures, full_failed_at:$full_failed_at, nodes:$nodes, edges:$edges,
      "trees":$nt, linked:$linked, migrate:{done:0, pending:$pending, refused:[]}}')"
}

# ── the pass ──────────────────────────────────────────────────────────────
exec 9>"$LOCK"
flock -n 9 || { ROWS=(); _gs_finish pass-locked 0; }
# The wave's hold (D-7365): checked right after the lock, before the library, the store, any fetch or any build, and
# never removed here.
[ -e "$PAUSE" ] && _gs_finish paused 0
_gs_lib || _gs_finish failed 1
# shellcheck source=SCRIPTDIR/ccrc
. "$GRAPH_LIB/ccrc" || { PASS_REASON="cannot load $GRAPH_LIB/ccrc"; _gs_finish failed 1; }
# shellcheck source=SCRIPTDIR/graph-resolve
. "$GRAPH_LIB/graph-resolve" || { PASS_REASON="cannot load $GRAPH_LIB/graph-resolve"; _gs_finish failed 1; }
_gr_knobs || { PASS_REASON="${GK_WARN[*]:-the graph settings cannot be read}"; _gs_finish failed 1; }
for w in ${GK_WARN[@]+"${GK_WARN[@]}"}; do echo "graph-sweep: setting: $w" >&2; done
[ -n "$PIN" ] || { PASS_REASON="no pin at ${PIN_FILE/#"$HOME"/\~} — run ccrc install first"; _gs_finish failed 1; }
# staging/ never outlives its build (spec §3.5): the trap names it while a build holds it.
trap '_gs_drop_staging' EXIT
trap '_gs_drop_staging; exit 143' TERM
trap '_gs_drop_staging; exit 130' INT

if [ ! -d "$PROJECTS_ROOT" ] && [ ! -d "$WORKTREES_ROOT" ]; then
  _gs_finish no-trees-configured 0
fi
GS_STORE=""
_gr_store_init >/dev/null || { PASS_REASON="${GR_WHY:-the graph store cannot be created}"; _gs_finish failed 1; }
GS_STORE="$GR_STORE"

PROBED=0
COMMONS=()
mapfile -t TREES < <(_gs_trees)
for tree in ${TREES[@]+"${TREES[@]}"}; do
  PROBED=$((PROBED+1))
  _gs_rm_stray "$tree"
  c="$(_gs_common "$tree")" || { echo "graph-sweep: $tree: its git common dir cannot be read" >&2; continue; }
  [ -n "${T_OF[$c]+x}" ] || COMMONS+=("$c")
  T_OF["$c"]="${T_OF[$c]:+${T_OF[$c]}$'\n'}$tree"
done

if [ "$PROBED" -eq 0 ]; then
  echo "graph-sweep: tree roots exist but zero trees probed — the ccd-cap-scopes failure shape; investigate" >&2
  _gs_settings
  _gs_finish probed-zero 1
fi

DUE=()
for c in ${COMMONS[@]+"${COMMONS[@]}"}; do
  _gs_prepare "$c" < /dev/null; prc=$?
  K_TREES["$CUR"]="${T_OF[$c]}"
  [ "$prc" -eq 0 ] || continue
  _gs_decide "$CUR" < /dev/null
  case "${K_KIND[$CUR]}" in
    fresh) _gs_end fresh - "" ;;
    skipped-backoff) _gs_end skipped-backoff - "${K_WHY[$CUR]}" ;;
    *) DUE+=("$CUR") ;;
  esac
done

# Budget order (spec §3.1 step 4): no published build first, then a repository the last pass skipped for the budget
# (it "goes first next pass"), then the most commits behind its tip.
mapfile -t ORDER < <(for key in ${DUE[@]+"${DUE[@]}"}; do
    s=1; [ "${K_PREV[$key]}" != skipped-budget ] || s=0
    printf '%s %s %s %s\n' "${K_PUB[$key]}" "$s" "${K_BEHIND[$key]}" "$key"
  done | sort -k1,1n -k2,2n -k3,3nr | cut -d' ' -f4)
BUILT=0
for key in ${ORDER[@]+"${ORDER[@]}"}; do
  CUR="$key"
  if [ "$BUILT" -ge "${GK[CCRC_GRAPH_BUDGET]}" ]; then
    _gs_end skipped-budget - "pass budget CCRC_GRAPH_BUDGET=${GK[CCRC_GRAPH_BUDGET]} reached"; continue
  fi
  BUILT=$((BUILT+1))
  _gs_build "$key" < /dev/null
  _gs_drop_staging
done

for key in ${K_ORDER[@]+"${K_ORDER[@]}"}; do
  CUR="$key"; may=0
  if [ -n "${K_DIR[$key]:-}" ] && [ -d "${K_DIR[$key]}/current" ] && [ "${K_OUTCOME[$key]}" != excluded ]; then
    may=1
    _graph_exclude_common "${K_COMMON[$key]}" >/dev/null || _gs_note "cannot write the exclude lines in ${K_COMMON[$key]}/info/exclude"
  fi
  _gs_link "$key" "$may" < /dev/null
  [ "$GS_UNIGNORED" -eq 0 ] || _gs_note "$GS_UNIGNORED tree(s) not linked: git check-ignore graphify-out fails there"
  _gs_collect "$key"
  _gs_emit "$key"
done
_gs_settings
_gs_finish ok 0
