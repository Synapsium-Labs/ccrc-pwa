#!/usr/bin/env bash
# ccd-land-probe — the read-only conflict radar (landing-order spec stage 3). A serialized oneshot, driven by
# ccd-land-probe.timer every five minutes: one flock, one global pause file, every knob env-overridable for the
# test harness, the way ccd-tmp-sweep is owned.
#
# WHAT IT MEASURES, for each project the operator opted in (one `~/.ccrc/landing/<project>.conf` per project):
#   - which open PRs conflict with the base, and with each other (`probe`);
#   - whether the base tip's required checks are green (`main-health`);
#   - each workspace branch's lineage of clean base merges (`<id>.lineage`);
#   - the opt-in mirror stage 4 reads, with its own time (`enabled`).
# The files are JSON with "v": 1, written under `$REG/landing/<project>/`. The formats are the interface the next
# waves read; the plan's Design section is their grammar.
#
# WHY A SIBLING AND NOT A `ccd` VERB. `ccd` makes no network call, and this probe makes two kinds (a fetch and the
# read-only forge reads), exactly the argument `ccd-pool-sync`'s header makes for its curl. It also needs a deadline
# on every child and a kill of the child's whole process group, which a bash function cannot give, so the work is one
# embedded `python3 -I` program behind this bash head. The head owns the arguments, the knobs, the global pause, the
# one lock and the tool check; fd 9, the lock, stays open across the exec, so the lock holds for the whole tick.
#
# READ-ONLY BY CODE, THROUGH THREE LAYERS. This tool never sends a ref anywhere, never lands a PR, and never updates
# a PR's branch.
#   1. Every git call goes through one function, `git_ro`. It owns a fixed hardening prefix (no hooks, no fsmonitor,
#      no optional locks on the project), takes the repository from a variable it owns, never from the caller, and
#      refuses any subcommand outside two literal allowlists, and any option that is not one of the exact forms its
#      subcommand's call sites pass (an allowlist of forms, not a deny list: no `--output=`, no abbreviation of a long
#      option), besides the prefixes that could run code or re-point the repository. `git_check` is its validator.
#   2. The forge is reached through exactly two call sites, `gh_get` (a GET) and `gh_pr_list`. Both name the
#      repository explicitly, and the child's environment drops GH_REPO, GH_HOST and every GIT_* variable.
#   3. A literal source pin (server/test/ccd-land-probe-readonly.test.ts) holds the file to those shapes, and a
#      validate-only self-test (CCD_LAND_PROBE_SELFTEST=git_ro) proves `git_ro`'s refusals without running git.
#
# THE PER-TICK SCRATCH. The project repository is only READ. A bare repository under $TMPDIR borrows the project's
# object store as an alternate; it receives the fetch and every object a merge-tree writes. It holds the regular file
# `.ccd-land-probe-scratch`, and it is removed on every exit path, a SIGTERM included: the one `finally` first kills
# the process group of the child in flight and waits for it, and only then removes the directory, so no helper is
# still writing into it. A crashed tick's scratch is cleared by the next tick, but only a real, owned directory
# holding a regular sentinel file and older than one hour.
#
# PATHS
#   ~/.ccrc/landing/<project>.conf        the operator, by hand: opts <project> in (base=, lineage=on|off)
#   $REG/land-probe-paused                the operator, by hand: global pause, exit 0 before the lock
#   $REG/landing/<project>/paused         the operator, by hand: this project is not measured
#   ~/.ccrc/land-probe.lock               this probe: one tick at a time
#   $REG/landing/<project>/probe          this probe: the radar
#   $REG/landing/<project>/main-health    this probe: the base tip's required checks
#   $REG/landing/<project>/<id>.lineage   this probe: one registry row's workspace-branch lineage
#   $REG/landing/<project>/enabled        this probe: the mirror of lineage=on
#   $TMPDIR/ccd-land-probe.<random>/      this probe: the per-tick scratch
# Nothing in the tree writes the conf or either pause marker; they are the operator's, by hand. $REG is
# $HOME/.cc-sessions.
#
# PORTABILITY. Linux-only by product shape (its runner is a systemd timer, which flock also assumes), written to pass
# macos-platform.test.ts's GNU-spelling scan anyway: no bare deadline binary, no GNU stat, du or date spelling, no
# template-less temp name. The Python renames with os.rename.
set -uo pipefail

REG="$HOME/.cc-sessions"
PAUSE="$REG/land-probe-paused"
LOCK="$HOME/.ccrc/land-probe.lock"

_lp_die() { echo "land-probe: $*" >&2; exit 1; }

# Any argument is a usage error.
[ "$#" -eq 0 ] || { echo "usage: ccd-land-probe" >&2; exit 2; }

_lp_knob() {   # NAME DEFAULT MIN MAX: a whole number in range, or the tick refuses and names the variable
  local name=$1 def=$2 min=$3 max=$4 v
  v="${!name-}"
  [ -n "$v" ] || v=$def
  [[ "$v" =~ ^[0-9]{1,5}$ ]] || _lp_die "invalid-knob: $name='$v' is not a whole number"
  v=$((10#$v))
  { [ "$v" -ge "$min" ] && [ "$v" -le "$max" ]; } || _lp_die "invalid-knob: $name=$v is outside $min..$max"
  export "$name=$v"
}
_lp_knob CCD_LAND_PROBE_FETCH_TIMEOUT 120 1 3600
_lp_knob CCD_LAND_PROBE_GIT_TIMEOUT 20 1 600
_lp_knob CCD_LAND_PROBE_GH_TIMEOUT 15 1 600
_lp_knob CCD_LAND_PROBE_BUDGET 240 10 3600
_lp_knob CCD_LAND_PROBE_TICK_BUDGET 780 30 840
_lp_knob CCD_LAND_PROBE_PAIR_HEADS 10 0 10
_lp_knob CCD_LAND_PROBE_LINEAGE_STEPS 8 0 8
export CCD_LAND_PROBE_GH="${CCD_LAND_PROBE_GH:-gh}"
case "${CCD_LAND_PROBE_SELFTEST:-}" in
  ''|git_ro) ;;
  *) _lp_die "invalid-knob: CCD_LAND_PROBE_SELFTEST='${CCD_LAND_PROBE_SELFTEST}' is neither unset nor git_ro" ;;
esac

# The self-test reads no pause, takes no lock and creates no file: it skips this whole block and reaches the exec.
if [ "${CCD_LAND_PROBE_SELFTEST:-}" != git_ro ]; then
  [ -e "$PAUSE" ] && { echo "land-probe: paused ($PAUSE exists)"; exit 0; }
  for _t in git python3 flock; do
    command -v "$_t" >/dev/null 2>&1 || _lp_die "missing-tool: $_t is not on PATH"
  done
  mkdir -p "$HOME/.ccrc"
  exec 9>"$LOCK" || exit 1
  flock -n 9 || exit 0
fi

# The program rides fd 3, so stdin stays the self-test's own input; fd 9 stays open, so the lock holds.
exec python3 -I /dev/fd/3 3<<'PY'
