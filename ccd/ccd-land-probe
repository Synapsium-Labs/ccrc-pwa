# ---- the git door: the hardening prefix, the two allowlists, the option and key refusals -----------------------
# git, then the prefix, then (project only) the lock option, then -C <dir>, then (the scratch's fetch only) the fetch
# prefix, then the caller's arguments. A caller supplies neither the prefix nor the directory.
GIT_PREFIX = ('--no-pager', '-c', 'core.hooksPath=/dev/null', '-c', 'core.fsmonitor=false')
PROJECT_LOCKS = ('--no-optional-locks',)
FETCH_PREFIX = ('-c', 'gc.auto=0', '-c', 'maintenance.auto=false', '-c', 'transfer.unpackLimit=1', '-c', 'fetch.writeCommitGraph=false')
FETCH_KEEP = ('GIT_SSH', 'GIT_SSH_COMMAND', 'GIT_ASKPASS', 'GIT_SSL_CAINFO', 'GIT_SSL_CAPATH')
PROJECT_ALLOW = ('rev-parse', 'rev-list', 'for-each-ref', 'cat-file', 'merge-base', 'count-objects', 'ls-remote', 'config')
SCRATCH_ALLOW = ('init', 'fetch', 'merge-tree', 'merge-base', 'rev-parse', 'rev-list', 'cat-file')
ALLOW = {'project': PROJECT_ALLOW, 'scratch': SCRATCH_ALLOW}
FORMS = {
    ('project', 'ls-remote'): ['--get-url', 'origin'],
    ('project', 'config'): ['--get', 'remote.origin.url'],
}
OPTION_PREFIXES = ('-c', '--config-env', '-C', '--git-dir', '--work-tree', '--exec', '--upload-pack', '--receive-pack', '-u')
# The option FORMS each allowlisted subcommand admits: exactly the spellings the probe's own call sites pass, compared
# whole (never by prefix, so no `--output=<file>`, no long-option abbreviation such as `--upload-pa=`, and no
# `cat-file --textconv` or `--filters`). A subcommand with no call site that passes an option admits none. After a
# literal `--` (admitted for the fetch alone) git itself reads only operands, so the check stops there. This is a deliberate departure from the
# plan's prefix deny list (fix round 1, review 1109, F2 and A9).
OPTION_FORMS = {
    ('project', 'rev-parse'): ('--verify', '-q'),
    ('project', 'rev-list'): (),
    ('project', 'for-each-ref'): (),
    ('project', 'cat-file'): (),
    ('project', 'merge-base'): (),
    ('project', 'count-objects'): ('-v',),
    ('project', 'ls-remote'): ('--get-url',),
    ('project', 'config'): ('--get',),
    ('scratch', 'init'): ('-q', '--bare'),
    ('scratch', 'fetch'): ('--no-tags', '--no-write-fetch-head', '--no-recurse-submodules', '--'),
    ('scratch', 'merge-tree'): ('--write-tree', '--name-only', '--no-messages'),
    ('scratch', 'merge-base'): ('--is-ancestor',),
    ('scratch', 'rev-parse'): ('--verify', '-q'),
    ('scratch', 'rev-list'): ('--parents', '-n'),
    ('scratch', 'cat-file'): (),
}
PINNED_KEYS = ('core.hooksPath', 'core.fsmonitor')

Result = namedtuple('Result', ['rc', 'out', 'spawn'], defaults=(False,))   # spawn: the child could not be executed at all
PROJECT_DIR = None   # the project repository: the one directory the 'project' calls name
SCRATCH = None       # this tick's scratch repository: the one directory the 'scratch' calls name
CUR = None           # the project budget in force
TICK = None          # the whole tick's budget
CHILD = None         # the child in flight, for the finally that kills it


class ProbeRefused(Exception):
    pass


class Budget(object):
    def __init__(self, seconds):
        self.seconds = float(seconds)
        self.start = time.monotonic()

    def spent(self):
        return time.monotonic() - self.start

    def remaining(self):
        return max(0.0, self.seconds - self.spent())


def log(msg):
    sys.stderr.write('land-probe: ' + msg + '\n')
    sys.stderr.flush()


def note_unmeasured(project, fname, why, r=None):
    """One journal line per unmeasured outcome: the file, the fixed why word and, when a child gave it, that child's exit
    code or spawn-failed. Never a byte of the child's output (project is PROJECT_RE-checked, why is a fixed word)."""
    tail = ''
    if r is not None:
        tail = ' spawn-failed' if r.spawn else ' rc=%s' % ('none' if r.rc is None else r.rc)
    log('unmeasured %s %s %s%s' % (project, fname, why, tail))


def now_iso():
    return time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())


def git_check(where, args):
    """Validate one git call. The first rule that applies answers: subcommand, form, option, key."""
    allow = ALLOW.get(where) if isinstance(where, str) else None
    if allow is None:
        raise ProbeRefused('where %s' % (where,))
    if not isinstance(args, list) or not args or not all(isinstance(a, str) for a in args):
        raise ProbeRefused('input')
    sub = args[0]
    if sub not in allow:
        raise ProbeRefused('subcommand ' + sub)
    want = FORMS.get((where, sub))
    if where == 'scratch' and sub == 'init':
        want = ['-q', '--bare', SCRATCH]
    if want is not None and args[1:] != want:
        raise ProbeRefused('form ' + sub)
    for a in args[1:]:
        for p in OPTION_PREFIXES:
            if a.startswith(p):
                raise ProbeRefused('option ' + p)
    forms = OPTION_FORMS.get((where, sub), ())
    for a in args[1:]:
        if a == '--' and a in forms:
            break
        if a.startswith('-') and a not in forms:
            raise ProbeRefused('option ' + a.split('=', 1)[0])
    for k in PINNED_KEYS:
        if any(k.lower() in a.lower() for a in args):
            raise ProbeRefused('key ' + k)


def child_env(keep=(), cwd=None):
    """Every GIT_* variable dropped but the keep set, then the read runner's own (ccd's read_env): no lazy fetch into
    a partial clone, no replace objects, discovery stopped at the repository's parent."""
    env = dict((k, v) for k, v in os.environ.items() if not k.startswith('GIT_') or k in keep)
    env['GIT_NO_LAZY_FETCH'] = '1'
    env['GIT_NO_REPLACE_OBJECTS'] = '1'
    if cwd is not None:
        env['GIT_CEILING_DIRECTORIES'] = os.path.realpath(os.path.dirname(os.path.abspath(cwd)))
    env['GIT_TERMINAL_PROMPT'] = '0'
    env['LC_ALL'] = 'C'
    return env


def gh_env():
    """The forge child's environment: GH_REPO and GH_HOST dropped (the call names its repository), every GIT_* variable
    dropped as the git children's is, and no prompt on a terminal."""
    env = dict((k, v) for k, v in os.environ.items() if k not in ('GH_REPO', 'GH_HOST') and not k.startswith('GIT_'))
    env['GIT_TERMINAL_PROMPT'] = '0'
    env['GH_PROMPT_DISABLED'] = '1'
    env['LC_ALL'] = 'C'
    return env


def kill_group(proc):
    """SIGKILL the child's whole process group, reap the child, let go of its pipe."""
    try:
        os.killpg(proc.pid, signal.SIGKILL)
    except OSError:
        pass
    try:
        proc.wait(timeout=5)
    except Exception:
        pass
    try:
        proc.stdout.close()
    except Exception:
        pass


def kill_inflight():
    global CHILD
    proc, CHILD = CHILD, None
    if proc is not None:
        kill_group(proc)


def run_child(argv, env, timeout):
    """Run one child to its deadline, capped at the project budget that remains. rc None: a timeout, a spent budget
    or a spawn failure. The child leads a session of its own, so its deadline kills every process it started."""
    global CHILD
    t = float(timeout)
    if CUR is not None:
        t = min(t, CUR.remaining())
    if t <= 0:
        return Result(None, '')
    try:
        proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                env=env, start_new_session=True, close_fds=True)
    except OSError:
        return Result(None, '', True)
    CHILD = proc
    try:
        out, _ = proc.communicate(timeout=t)
    except subprocess.TimeoutExpired:
        kill_group(proc)
        CHILD = None
        return Result(None, '')
    CHILD = None
    return Result(proc.returncode, out.decode('utf-8', 'replace'))


def git_ro(where, args, timeout):
    git_check(where, args)
    if where == 'project':
        cwd = PROJECT_DIR
    else:
        cwd = SCRATCH
    if cwd is None:
        raise ProbeRefused('no repository for ' + where)
    fetch = where == 'scratch' and args[0] == 'fetch'
    argv = ['git'] + list(GIT_PREFIX)
    if where == 'project':
        argv += list(PROJECT_LOCKS)
    argv += ['-C', cwd]
    if fetch:
        argv += list(FETCH_PREFIX)
    argv += list(args)
    return run_child(argv, child_env(FETCH_KEEP if fetch else (), cwd), timeout)


# ---- the forge door: exactly two read forms -----------------------------------------------------------------------
def gh_get(path, paginate=False):
    argv = [GH, 'api', '--method', 'GET', path]
    if paginate:
        argv = argv + ['--paginate']
    return run_child(argv, gh_env(), GH_T)


def gh_pr_list(slug, base):
    argv = [GH, 'pr', 'list', '--repo', slug, '--state', 'open', '--base', base, '--limit', str(PR_LIMIT), '--json', PR_FIELDS]
    return run_child(argv, gh_env(), GH_T)


# ---- small pure helpers --------------------------------------------------------------------------------------------
def repo_slug(url):
    """_gh_repo_slug's rule, statement for statement: exactly one of the three GitHub prefixes, one trailing .git
    stripped, exactly two ASCII segments, no dot segment, no owner that starts with a dot."""
    if not url:
        return None
    u = url[:-len('.git')] if url.endswith('.git') else url
    rest = None
    for pre in GH_PREFIXES:
        if u.startswith(pre):
            rest = u[len(pre):]
            break
    if rest is None:
        return None
    if not re.fullmatch(GH_SLUG_RE, rest):
        return None
    owner, name = rest.split('/')
    for seg in (owner, name):
        if seg in ('.', '..'):
            return None
    if owner.startswith('.'):
        return None
    return rest


def is_registry_id(s):
    return len(s) <= 255 and ID_RE.fullmatch(s) is not None and not s.startswith('.') and not s.startswith('-')


def merge_answer(a, b, tree=False):
    """One merge-tree of two commits in the scratch: clean, conflict with its paths, or unmeasured with a why. With
    tree=True a clean answer also carries the clean tree id (the lineage walk compares a merge's own tree with it)."""
    if CUR is not None and CUR.remaining() <= 0:
        return {'state': 'unmeasured', 'why': 'budget'}
    r = git_ro('scratch', ['merge-tree', '--write-tree', '--name-only', '--no-messages', a, b], GIT_T)
    if r.rc is None:
        return {'state': 'unmeasured', 'why': 'timeout'}
    if r.rc not in (0, 1):
        return {'state': 'unmeasured', 'why': 'rc-%d' % r.rc}
    lines = r.out.split('\n')
    if not HEX40.fullmatch(lines[0]):
        return {'state': 'unmeasured', 'why': 'no-tree'}
    if r.rc == 0:
        return {'state': 'clean', 'tree': lines[0]} if tree else {'state': 'clean'}
    paths = []
    for ln in lines[1:]:
        if ln and ln not in paths:
            paths.append(ln)
    return {'state': 'conflict', 'paths': paths[:PATHS_CAP], 'pathsCut': len(paths) > PATHS_CAP}


def why_of(r):
    """The why of a child that gave no answer: the project budget spent, a deadline, or an exit code."""
    if r.rc is None:
        return 'budget' if CUR is not None and CUR.remaining() <= 0 else 'timeout'
    return 'rc-%d' % r.rc


def walk_lineage(tip, base, steps, budget):
    """A workspace branch's chain of clean merges of the fetched base, newest first. A step is accepted only when the
    commit has exactly two parents, its second parent is on the base, and its tree is the clean merge-tree of the two
    parents. Anything else stops the chain. state is measured unless a git call failed, timed out or ran out of
    budget; chain then holds what was proven first."""
    chain = []
    c = tip

    def done(stop, state='measured', why=None):
        doc = {'state': state, 'chain': chain, 'stop': stop}
        if why is not None:
            doc['why'] = why
        return doc

    while len(chain) < steps:
        if budget.remaining() <= 0:
            return done('unmeasured', 'unmeasured', 'budget')
        r = git_ro('scratch', ['rev-list', '--parents', '-n', '1', c], GIT_T)
        if r.rc != 0:
            return done('unmeasured', 'unmeasured', why_of(r))
        fields = r.out.split()
        if not fields or fields[0] != c or not all(HEX40.fullmatch(f) for f in fields):
            return done('unmeasured', 'unmeasured', 'no-parents')
        if len(fields) != 3:
            return done('not-a-merge')
        p1, p2 = fields[1], fields[2]
        r = git_ro('scratch', ['merge-base', '--is-ancestor', p2, base], GIT_T)
        if r.rc == 1:
            return done('second-parent-not-on-base')
        if r.rc != 0:
            return done('unmeasured', 'unmeasured', why_of(r))
        ans = merge_answer(p1, p2, True)
        if ans['state'] == 'conflict':
            return done('conflict')
        if ans['state'] != 'clean':
            return done('unmeasured', 'unmeasured', ans['why'])
        r = git_ro('scratch', ['rev-parse', '--verify', '-q', c + '^{tree}'], GIT_T)
        if r.rc != 0 or not HEX40.fullmatch(r.out.strip()):
            return done('unmeasured', 'unmeasured', why_of(r) if r.rc != 0 else 'no-tree')
        if r.out.strip() != ans['tree']:
            return done('tree-differs')
        chain.append({'merge': c, 'p1': p1, 'p2': p2})
        c = p1
    return done('limit')


def bound_name(v):
    """A forge-sourced name, held to NAME_CAP bytes on a character boundary, for OUTPUT only: matching uses the full
    name. A lone surrogate encodes as '?'. Untrusted: it is only ever JSON-encoded."""
    if not isinstance(v, str) or v == '':
        return None
    return v.encode('utf-8', 'replace')[:NAME_CAP].decode('utf-8', 'ignore') or None


class MalformedChecks(Exception):
    """A required-checks entry the probe cannot read whole: the set would be partial, and a miss reads green."""


def app_pin(v):
    """The App a required name is pinned to: a positive integer. None, -1, 0 and anything else mean no App."""
    return v if type(v) is int and v > 0 else None


def required_set(rules, branch):
    """The required checks: every required_status_checks rule of the branch rules, unioned with the branch view's
    protection (checks[] with their App, contexts[] with none). [{name, app}], app None or a positive integer. A name
    with a pin drops its unpinned twin; a name pinned to two Apps keeps both entries, which the judge reads as a
    conflict. Names are kept whole (matching is on the full name). An entry with a name that is not a non-empty string,
    an App that is neither absent, null nor an integer, or that is not an object raises MalformedChecks."""
    seen = {}

    def add(name, app):
        if not isinstance(name, str) or name == '' or not (app is None or type(app) is int):
            raise MalformedChecks()
        seen.setdefault(name, set()).add(app_pin(app))

    for rule in rules if isinstance(rules, list) else []:
        if not isinstance(rule, dict) or rule.get('type') != 'required_status_checks':
            continue
        p = rule.get('parameters')
        rs = p.get('required_status_checks') if isinstance(p, dict) else None
        for c in rs if isinstance(rs, list) else []:
            if not isinstance(c, dict):
                raise MalformedChecks()
            add(c.get('context'), c.get('integration_id'))
    prot = branch.get('protection') if isinstance(branch, dict) else None
    sc = prot.get('required_status_checks') if isinstance(prot, dict) else None
    if isinstance(sc, dict):
        for c in sc.get('checks') if isinstance(sc.get('checks'), list) else []:
            if not isinstance(c, dict):
                raise MalformedChecks()
            add(c.get('context'), c.get('app_id'))
        for n in sc.get('contexts') if isinstance(sc.get('contexts'), list) else []:
            add(n, None)
    out = []
    for n in sorted(seen):
        pins = sorted(a for a in seen[n] if a is not None)
        if not pins:
            out.append({'name': n, 'app': None})
        for a in pins:
            out.append({'name': n, 'app': a})
    return out


def judge_name(pins, runs, statuses, name):
    """One required name: pass, fail, pending, app-unverifiable or app-conflict."""
    if len(pins) > 1:
        return 'app-conflict'
    pin = pins[0] if pins else None
    mine = [r for r in runs if isinstance(r, dict) and r.get('name') == name and type(r.get('id')) is int]
    if pin is not None:
        mine = [r for r in mine if isinstance(r.get('app'), dict) and r['app'].get('id') == pin]
    if mine:
        run = max(mine, key=lambda r: r['id'])
        if run.get('status') == 'completed' and run.get('conclusion') in RUN_PASS:
            return 'pass'
        if run.get('status') == 'completed' and run.get('conclusion') in RUN_FAIL:
            return 'fail'
        return 'pending'
    seen = [s for s in statuses if isinstance(s, dict) and s.get('context') == name]
    if not seen:
        return 'pending'
    if pin is not None:
        return 'app-unverifiable'
    newest = max(seen, key=lambda s: s['id'] if type(s.get('id')) is int else -1)
    if newest.get('state') == 'success':
        return 'pass'
    if newest.get('state') in STATUS_FAIL:
        return 'fail'
    return 'pending'


def judge_required(required, runs, statuses):
    """The base tip's verdict on its required set: red when any name fails, green when the set is non-empty and every
    name passes, otherwise unmeasured with a why. A check run counts only when it is completed with a passing
    conclusion; a pinned name counts only on a run of that App, never on a status."""
    names = sorted(set(e['name'] for e in required))
    if not names:
        return {'state': 'unmeasured', 'why': 'no-required-set', 'required': [], 'failing': [], 'pending': []}
    verdicts = {}
    for n in names:
        pins = sorted(set(e['app'] for e in required if e['name'] == n and e['app'] is not None))
        verdicts[n] = judge_name(pins, runs, statuses, n)
    doc = {'required': [{'name': bound_name(e['name']), 'app': e['app']} for e in required],
           'failing': [bound_name(n) for n in names if verdicts[n] == 'fail'],
           'pending': [bound_name(n) for n in names if verdicts[n] not in ('pass', 'fail')]}
    vs = set(verdicts.values())
    if 'fail' in vs:
        doc['state'] = 'red'
    elif 'app-conflict' in vs:
        doc.update(state='unmeasured', why='app-conflict')
    elif 'app-unverifiable' in vs:
        doc.update(state='unmeasured', why='app-unverifiable')
    elif 'pending' in vs:
        doc.update(state='unmeasured', why='pending')
    else:
        doc['state'] = 'green'
    return doc


def json_values(text):
    """Every JSON value in text, in order: a paginated forge answer is one value per page, run together. None when
    anything in it is not JSON."""
    dec = json.JSONDecoder()
    out = []
    i, n = 0, len(text)
    while True:
        while i < n and text[i] in ' \t\r\n':
            i += 1
        if i >= n:
            return out
        try:
            v, i = dec.raw_decode(text, i)
        except ValueError:
            return None
        out.append(v)


def read_checks(slug, base_ref, sha):
    """The base tip's verdict from the forge: the rules and the branch view for the required set, then the check runs
    and the commit status on the fetched base sha. Any read that fails makes the whole verdict unmeasured: a set read
    in part could miss a name, and a miss reads green."""
    last = [None]   # the last forge child, for the journal's line (never read into the file)

    def unmeasured(why):
        return {'state': 'unmeasured', 'why': why, 'required': [], 'failing': [], 'pending': [], 'child': last[0]}

    def get(path, paginate=False):
        if CUR is not None and CUR.remaining() <= 0:
            return None, 'budget'
        r = gh_get(path, paginate)
        last[0] = r
        if r.rc != 0:
            spent = r.rc is None and CUR is not None and CUR.remaining() <= 0
            return None, 'budget' if spent else 'gh-failed'
        vals = json_values(r.out)
        if not vals:
            return None, 'gh-failed'
        return vals, None

    enc = base_ref.replace('/', '%2F')
    rules, why = get('repos/%s/rules/branches/%s' % (slug, enc))
    if why:
        return unmeasured(why)
    view, why = get('repos/%s/branches/%s' % (slug, enc))
    if why:
        return unmeasured(why)
    if len(rules) != 1 or not isinstance(rules[0], list) or len(view) != 1 or not isinstance(view[0], dict):
        return unmeasured('gh-failed')
    try:
        required = required_set(rules[0], view[0])
    except MalformedChecks:
        return unmeasured('gh-failed')
    if not required:
        return judge_required(required, [], [])
    pages, why = get('repos/%s/commits/%s/check-runs?per_page=100' % (slug, sha), True)
    if why:
        return unmeasured(why)
    runs = []
    for pg in pages:
        if not isinstance(pg, dict) or not isinstance(pg.get('check_runs'), list):
            return unmeasured('gh-failed')
        runs += pg['check_runs']
    stat_pages, why = get('repos/%s/commits/%s/status' % (slug, sha))
    if why:
        return unmeasured(why)
    statuses = []
    for pg in stat_pages:
        if not isinstance(pg, dict) or not isinstance(pg.get('statuses'), list):
            return unmeasured('gh-failed')
        statuses += pg['statuses']
    return judge_required(required, runs, statuses)


# ---- files: real, owned directories only; tmp then rename; deletion of the probe's own names only ------------------
def real_dir(path):
    try:
        st = os.lstat(path)
    except OSError:
        return False
    return stat.S_ISDIR(st.st_mode) and st.st_uid == os.getuid()


def ensure_dir(path, label):
    """True when path is a real directory this user owns, created (0755) when absent. Anything else is skipped with
    one log line, and nothing under it is touched."""
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        try:
            os.mkdir(path, 0o755)
        except OSError as e:
            log('skip %s: cannot create the directory (%s)' % (label, errno.errorcode.get(e.errno, 'error')))
            return False
        return real_dir(path)
    except OSError as e:
        log('skip %s: cannot read the directory (%s)' % (label, errno.errorcode.get(e.errno, 'error')))
        return False
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid():
        log('skip %s: not a real directory owned by this user' % label)
        return False
    return True


def write_json(dirpath, name, doc):
    """Create a tmp file exclusively beside the final name, write it whole, fsync it, rename it into place."""
    if '/' in name or not real_dir(dirpath):
        log('skip write of %s: the directory is not a real, owned directory' % name)
        return
    tmp = None
    try:
        fd, tmp = tempfile.mkstemp(dir=dirpath, prefix='.lp.')
        with os.fdopen(fd, 'w', encoding='utf-8') as f:
            json.dump(doc, f, separators=(',', ':'))
            f.write('\n')
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, 0o644)
        os.rename(tmp, dirpath + '/' + name)
        tmp = None
    except OSError as e:
        log('write of %s failed (%s)' % (name, errno.errorcode.get(e.errno, 'error')))
    finally:
        if tmp is not None:
            try:
                os.unlink(tmp)
            except OSError:
                pass


def remove_own(dirpath, name):
    """Delete a regular file named `enabled` or `*.lineage` in a real, owned directory, and nothing else."""
    if '/' in name or not (name == 'enabled' or name.endswith('.lineage')):
        return
    if not real_dir(dirpath):
        return
    p = dirpath + '/' + name
    try:
        if stat.S_ISREG(os.lstat(p).st_mode):
            os.unlink(p)
    except OSError:
        pass


def read_small(path, cap=4096):
    """The bytes of a regular file, opened without following a symlink; None when it is anything else."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return None
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            return None
        return os.read(fd, cap + 1)
    except OSError:
        return None
    finally:
        os.close(fd)


def reg_field(rid, field):
    data = read_small(REG + '/' + rid + '.' + field)
    if data is None or len(data) > 4096:
        return None
    try:
        text = data.decode('utf-8')
    except UnicodeDecodeError:
        return None
    text = text.rstrip('\n')
    return None if '\n' in text else text


def project_rows(project):
    """Every registry row of the project: (id, branch), the branch None when it cannot be read."""
    rows = []
    try:
        names = sorted(os.listdir(REG))
    except OSError:
        return rows
    for n in names:
        if not n.endswith('.project'):
            continue
        rid = n[:-len('.project')]
        if not is_registry_id(rid) or reg_field(rid, 'project') != project:
            continue
        rows.append((rid, reg_field(rid, 'branch')))
    return rows


def qualifying(rows):
    """(the rows that qualify for a lineage file, the ids of rows left undecided). A row qualifies when its branch
    starts with ws/ and refs/heads/<branch> resolves in the project repository. Each row is read on its own: a branch
    the git door refuses cannot qualify (decided, logged once); a read that timed out or ran past the budget leaves
    the row undecided, and its previous file stays."""
    out = []
    undecided = set()
    for rid, branch in rows:
        if branch is None or not branch.startswith('ws/'):
            continue
        try:
            r = git_ro('project', ['rev-parse', '--verify', '-q', 'refs/heads/' + branch], GIT_T)
        except ProbeRefused:
            log('lineage-skip: a registry row names a branch the git door refuses')
            continue
        if r.rc is None:
            undecided.add(rid)
        elif r.rc == 0 and HEX40.fullmatch(r.out.strip()):
            out.append((rid, branch, r.out.strip()))
    return out, undecided


def parse_conf(path):
    """(conf, None), or (None, a fixed reason word). Never the bytes."""
    try:
        if not stat.S_ISREG(os.lstat(path).st_mode):
            return None, 'not-regular'
    except OSError:
        return None, 'unreadable'
    data = read_small(path)
    if data is None or len(data) > 4096:
        return None, 'unreadable'
    try:
        text = data.decode('utf-8')
    except UnicodeDecodeError:
        return None, 'not-utf8'
    conf = {'base': 'main', 'lineage': 'off'}
    seen = set()
    for line in text.split('\n'):
        if line.strip() == '' or line.startswith('#'):
            continue
        key, eq, value = line.partition('=')
        if not eq:
            return None, 'malformed-line'
        if key not in ('base', 'lineage'):
            return None, 'unknown-key'
        if key in seen:
            return None, 'repeated-key'
        seen.add(key)
        if key == 'base':
            if not BASE_RE.fullmatch(value) or value.startswith('-'):
                return None, 'bad-value'
        elif value not in ('on', 'off'):
            return None, 'bad-value'
        conf[key] = value
    return conf, None


# ---- the scratch ---------------------------------------------------------------------------------------------------
def make_scratch():
    d = tempfile.mkdtemp(prefix='ccd-land-probe.', dir=TMP_ROOT)
    fd = os.open(d + '/' + SENTINEL, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        os.write(fd, b'ccd-land-probe scratch\n')
    finally:
        os.close(fd)
    return d


def scratch_kib(path):
    total = 0
    for root, dirs, files in os.walk(path, followlinks=False):
        for n in dirs + files:
            try:
                total += os.lstat(root + '/' + n).st_blocks * 512
            except OSError:
                pass
    return total // 1024


def remove_scratch(path):
    try:
        st = os.lstat(path)
    except OSError:
        return
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid():
        log('scratch is not a real directory owned by this user; left alone')
        return
    try:
        shutil.rmtree(path)
    except OSError:
        log('scratch could not be removed; the next tick clears it')


def clear_stale_scratch():
    """Remove each $TMPDIR/ccd-land-probe.* that is a real, owned directory holding a regular sentinel file and is
    older than one hour. A symlink, a directory without the sentinel, a symlinked sentinel: left alone."""
    try:
        names = os.listdir(TMP_ROOT)
    except OSError:
        return
    cutoff = time.time() - STALE_SCRATCH_S
    for n in names:
        if not n.startswith('ccd-land-probe.'):
            continue
        p = TMP_ROOT + '/' + n
        try:
            st = os.lstat(p)
            if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid() or st.st_mtime >= cutoff:
                continue
            if not stat.S_ISREG(os.lstat(p + '/' + SENTINEL).st_mode):
                continue
        except OSError:
            continue
        shutil.rmtree(p, ignore_errors=True)
        log('cleared a stale scratch')


# ---- one project ---------------------------------------------------------------------------------------------------
def store_counts():
    empty = {'count': None, 'size': None, 'inPack': None, 'packs': None}
    r = git_ro('project', ['count-objects', '-v'], GIT_T)
    if r.rc != 0:
        return empty
    vals = {}
    for ln in r.out.splitlines():
        k, _, v = ln.partition(': ')
        if v.isdigit():
            vals[k] = int(v)
    return {'count': vals.get('count'), 'size': vals.get('size'), 'inPack': vals.get('in-pack'), 'packs': vals.get('packs')}


def open_heads(slug, base):
    """(heads, cut, ok, child): the open same-repository PRs of the base, newest PR number first; child is the gh result."""
    r = gh_pr_list(slug, base)
    if r.rc != 0:
        return [], False, False, r
    try:
        rows = json.loads(r.out)
        if not isinstance(rows, list):
            return [], False, False, r
        heads = []
        for row in rows:
            n, name, oid, cross = row['number'], row['headRefName'], row['headRefOid'], row['isCrossRepository']
            if type(n) is not int or n < 1 or not isinstance(name, str) or not isinstance(oid, str) \
                    or not HEX40.fullmatch(oid) or not isinstance(cross, bool):
                return [], False, False, r
            if not cross:
                heads.append({'pr': n, 'head': oid, 'branch': name})
    except (ValueError, KeyError, TypeError):
        return [], False, False, r
    heads.sort(key=lambda h: -h['pr'])
    return heads, len(rows) >= PR_LIMIT, True, r


def fetch_into_scratch(base_ref, heads):
    """Make the scratch, borrow the project's objects, and fetch the base and every head into it in one call.
    (None, base sha, None) on success; (why, None, the child that failed or None) on a failure."""
    global SCRATCH
    SCRATCH = make_scratch()
    i = git_ro('scratch', ['init', '-q', '--bare', SCRATCH], GIT_T)
    if i.rc != 0:
        return 'fetch-failed', None, i
    try:
        info = SCRATCH + '/objects/info'
        os.makedirs(info, exist_ok=True)
        fd = os.open(info + '/alternates', os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        try:
            os.write(fd, (PROJECT_DIR + '/.git/objects\n').encode('utf-8'))
        finally:
            os.close(fd)
    except OSError:
        return 'fetch-failed', None, None
    u = git_ro('project', ['ls-remote', '--get-url', 'origin'], GIT_T)
    url = u.out.strip() if u.rc == 0 else ''
    if not url or url.startswith('-'):
        return 'fetch-failed', None, u
    specs = ['+refs/heads/%s:refs/probe/base' % base_ref]
    specs += ['+refs/pull/%d/head:refs/probe/pull/%d' % (h['pr'], h['pr']) for h in heads]
    f = git_ro('scratch', ['fetch', '--no-tags', '--no-write-fetch-head', '--no-recurse-submodules', '--', url] + specs, FETCH_T)
    if f.rc is None:
        return 'fetch-timeout', None, f
    if f.rc != 0:
        return 'fetch-failed', None, f
    b = git_ro('scratch', ['rev-parse', '--verify', '-q', 'refs/probe/base^{commit}'], GIT_T)
    if b.rc != 0 or not HEX40.fullmatch(b.out.strip()):
        return 'fetch-failed', None, b
    return None, b.out.strip(), None


def probe_doc(project, base_ref, base_sha, state, why, heads, heads_cut, pairs, pair_heads, pairs_cut, store, kib):
    doc = {'v': 1, 'project': project, 'at': now_iso(), 'state': state}
    if why is not None:
        doc['why'] = why
    doc['base'] = {'ref': base_ref, 'sha': base_sha} if base_sha else None
    doc['heads'] = heads
    doc['headsCut'] = heads_cut
    doc['pairs'] = pairs
    doc['pairHeads'] = pair_heads
    doc['pairsCut'] = pairs_cut
    doc['store'] = store
    doc['scratch'] = {'sizeKiB': kib}
    doc['elapsedMs'] = int(CUR.spent() * 1000)
    return doc


def health_doc(project, sha, verdict):
    """The main-health file: the verdict of read_checks (or an unmeasured shape) with its project, time and sha."""
    doc = {'v': 1, 'project': project, 'at': now_iso(), 'sha': sha, 'state': verdict['state']}
    if verdict.get('why') is not None:
        doc['why'] = verdict['why']
    doc['required'] = verdict['required']
    doc['failing'] = verdict['failing']
    doc['pending'] = verdict['pending']
    return doc


def unmeasured_health(project, sha, why):
    return health_doc(project, sha, {'state': 'unmeasured', 'why': why, 'required': [], 'failing': [], 'pending': []})


def lineage_unmeasured(project, rid, branch, tip, why):
    return {'v': 1, 'project': project, 'id': rid, 'at': now_iso(), 'state': 'unmeasured', 'why': why,
            'branch': branch, 'tip': tip, 'base': None, 'chain': [], 'stop': None}


def prune_lineage(ldir, keep):
    """Remove each regular *.lineage file whose id no longer names a qualifying row."""
    try:
        names = os.listdir(ldir)
    except OSError:
        return
    for n in names:
        if n.endswith('.lineage') and n[:-len('.lineage')] not in keep:
            remove_own(ldir, n)


def lineage_pass(project, ldir, rows, base_sha, fail_why):
    """Write each qualifying row's lineage, and remove the stale files. base_sha None is a failed fetch: every
    qualifying row gets the unmeasured shape. One row never costs another: a failure inside a row is that row's alone."""
    quals, undecided = qualifying(rows)
    for rid, branch, tip in quals:
        try:
            if base_sha is None:
                doc = lineage_unmeasured(project, rid, branch, tip, fail_why)
            else:
                walk = walk_lineage(tip, base_sha, LINEAGE_STEPS, CUR)
                doc = {'v': 1, 'project': project, 'id': rid, 'at': now_iso(), 'state': walk['state']}
                if walk.get('why') is not None:
                    doc['why'] = walk['why']
                doc['branch'], doc['tip'], doc['base'] = branch, tip, base_sha
                doc['chain'], doc['stop'] = walk['chain'], walk['stop']
            if doc['state'] == 'unmeasured':
                note_unmeasured(project, rid + '.lineage', doc['why'])
            write_json(ldir, rid + '.lineage', doc)
        except Exception as e:
            log('lineage-error: one registry row was not measured (%s)' % type(e).__name__)
    prune_lineage(ldir, set(q[0] for q in quals) | undecided)


def guarded_lineage(project, ldir, rows, base_sha, fail_why):
    """The lineage pass must never stop the enabled mirror or the final probe rewrite behind it."""
    try:
        lineage_pass(project, ldir, rows, base_sha, fail_why)
    except Exception as e:
        log('lineage-error: the lineage pass stopped (%s)' % type(e).__name__)


def measure(base_sha, heads, rows):
    """Base x each head, then the bound heads pairwise. Returns (heads out, pairHeads, pairs, pairsCut)."""
    bound = {}
    for rid, branch in rows:
        if branch is not None:
            bound.setdefault(branch, []).append(rid)
    out = []
    for h in heads:
        ids = bound.get(h['branch'], [])
        out.append({'pr': h['pr'], 'head': h['head'], 'branch': h['branch'], 'id': ids[0] if len(ids) == 1 else None,
                    'base': merge_answer(base_sha, h['head'])})
    bound_heads = [h for h in out if h['id'] is not None]
    chosen = bound_heads[:PAIR_HEADS]
    pairs = []
    for i in range(len(chosen)):
        for j in range(i + 1, len(chosen)):
            hi, lo = chosen[i], chosen[j]
            a, b = (lo, hi) if lo['pr'] < hi['pr'] else (hi, lo)
            ans = merge_answer(a['head'], b['head'])
            pair = {'a': a['pr'], 'b': b['pr']}
            pair.update(ans)
            pairs.append(pair)
    return out, [h['pr'] for h in chosen], pairs, len(bound_heads) > len(chosen)


def finish_probe(ldir, doc, store, interrupted):
    """The probe's closing rewrite (store.after, scratch.sizeKiB, elapsedMs), run from probe_project's finally once the
    first `probe` write happened, so the record is complete however the tick ended. What was measured stands (state, why,
    heads, pairs, at are not touched); each figure that cannot be measured stays null. A tick being terminated measures
    nothing more (no child is started), and writes the record as it is."""
    kib = None
    if not interrupted:
        store['after'] = store_counts()
        if SCRATCH is not None:
            kib = scratch_kib(SCRATCH)
    doc['store'] = store
    doc['scratch'] = {'sizeKiB': kib}
    doc['elapsedMs'] = int(CUR.spent() * 1000)
    write_json(ldir, 'probe', doc)


def probe_project(project, conf):
    global PROJECT_DIR, SCRATCH, CUR
    if not ensure_dir(LANDING, 'landing') or not ensure_dir(LANDING + '/' + project, project):
        return
    ldir = LANDING + '/' + project
    PROJECT_DIR = PROJECTS + '/' + project
    CUR = Budget(min(PROJECT_BUDGET, TICK.remaining()))
    base_ref = conf['base']
    SCRATCH = None
    first = None   # the probe record, once it has been written the first time
    store = {'before': None, 'after': None}
    interrupted = False
    try:
        store['before'] = store_counts()
        rows = project_rows(project)
        r = git_ro('project', ['config', '--get', 'remote.origin.url'], GIT_T)
        slug = repo_slug(r.out.rstrip('\n')) if r.rc == 0 else None
        heads, heads_cut, gh_ok = [], False, False
        base_sha = None
        if slug is None:
            fail = ('repo-unreadable', 'gh-failed', 'repo-unreadable')
            fail_child = r
        else:
            heads, heads_cut, gh_ok, gh_child = open_heads(slug, base_ref)
            why, base_sha, fail_child = fetch_into_scratch(base_ref, heads if gh_ok else [])
            fail = (why, 'fetch-failed', 'fetch-failed') if why else None
        if fail:
            first = probe_doc(project, base_ref, None, 'unmeasured', fail[0], [], False, [], [], False, store, None)
            note_unmeasured(project, 'probe', fail[0], fail_child)
            write_json(ldir, 'probe', first)
            note_unmeasured(project, 'main-health', fail[1], fail_child)
            write_json(ldir, 'main-health', unmeasured_health(project, None, fail[1]))
            guarded_lineage(project, ldir, rows, None, fail[2])
        else:
            if gh_ok:
                hs, pair_heads, pairs, pairs_cut = measure(base_sha, heads, rows)
                first = probe_doc(project, base_ref, base_sha, 'measured', None, hs, heads_cut, pairs, pair_heads, pairs_cut, store, None)
            else:
                first = probe_doc(project, base_ref, base_sha, 'unmeasured', 'gh-failed', [], False, [], [], False, store, None)
                note_unmeasured(project, 'probe', 'gh-failed', gh_child)
            write_json(ldir, 'probe', first)
            verdict = read_checks(slug, base_ref, base_sha)
            if verdict['state'] == 'unmeasured':
                note_unmeasured(project, 'main-health', verdict['why'], verdict.get('child'))
            write_json(ldir, 'main-health', health_doc(project, base_sha, verdict))
            guarded_lineage(project, ldir, rows, base_sha, None)
        if conf['lineage'] == 'on':
            write_json(ldir, 'enabled', {'v': 1, 'project': project, 'at': now_iso()})
        else:
            remove_own(ldir, 'enabled')
    except BaseException as e:
        interrupted = not isinstance(e, Exception)   # a SIGTERM or a ^C: measure nothing more
        raise
    finally:
        kill_inflight()
        try:
            if first is not None:
                finish_probe(ldir, first, store, interrupted)
        except Exception as e:
            log('project-error %s: the closing probe rewrite stopped (%s)' % (project, type(e).__name__))
        if SCRATCH is not None:
            remove_scratch(SCRATCH)
            SCRATCH = None
        PROJECT_DIR = None


def handle_project(project):
    conf_path = CONF_DIR + '/' + project + '.conf'
    ldir = LANDING + '/' + project
    conf, why = parse_conf(conf_path)
    if conf is None:
        log('conf-invalid %s: %s' % (project, why))
        remove_own(ldir, 'enabled')
        return
    if real_dir(ldir) and os.path.lexists(ldir + '/paused'):
        log('paused %s' % project)
        remove_own(ldir, 'enabled')
        return
    if conf['lineage'] != 'on':
        remove_own(ldir, 'enabled')
    if TICK.remaining() < MIN_PROJECT_S:
        log('tick-budget: %s not started' % project)
        return
    try:
        if not stat.S_ISDIR(os.lstat(PROJECTS + '/' + project + '/.git').st_mode):
            raise OSError(errno.ENOTDIR, 'not a directory')
    except OSError:
        log('not-a-checkout %s' % project)
        remove_own(ldir, 'enabled')
        return
    try:
        probe_project(project, conf)
    except Exception as e:
        log('project-error %s: %s' % (project, type(e).__name__))


def sweep_unconfigured():
    """Every directory under $REG/landing/ with no conf at all has its enabled removed."""
    try:
        names = sorted(os.listdir(LANDING))
    except OSError:
        return
    for n in names:
        if PROJECT_RE.fullmatch(n) and not os.path.lexists(CONF_DIR + '/' + n + '.conf'):
            remove_own(LANDING + '/' + n, 'enabled')


def on_signal(signum, frame):
    raise SystemExit(128 + signum)


def main():
    global TICK
    TICK = Budget(TICK_BUDGET)
    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGINT, on_signal)
    clear_stale_scratch()
    try:
        entries = sorted(os.listdir(CONF_DIR))
    except OSError:
        entries = []
    for ent in entries:
        if ent.endswith('.conf') and PROJECT_RE.fullmatch(ent[:-len('.conf')]):
            handle_project(ent[:-len('.conf')])
    sweep_unconfigured()
    return 0


def selftest():
    """Read JSON lines [where, args] from stdin; print allowed, or refused <reason>, using git_check only."""
    global SCRATCH
    SCRATCH = '/scratch'
    for line in sys.stdin:
        if not line.strip():
            continue
        try:
            where, args = json.loads(line)
            git_check(where, args)
            print('allowed')
        except ProbeRefused as e:
            print('refused ' + str(e))
        except (ValueError, TypeError):
            print('refused input')
    return 0


if __name__ == '__main__':
    if os.environ.get('CCD_LAND_PROBE_SELFTEST') == 'git_ro':
        sys.exit(selftest())
    sys.exit(main())
