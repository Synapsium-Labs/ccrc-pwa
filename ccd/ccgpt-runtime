async def _stream(with_deltas, args_in_added=False):
    """(events, None) or (None, error): SHIM_OUT streamed over one scripted
    upstream, its reply read as Anthropic events — SSE bytes parsed by their
    `data: ` lines, or dicts taken as they come."""
    _stream_body[0] = _scripted(with_deltas, args_in_added)
    try:
        reply = await router.aanthropic_messages(**json.loads(json.dumps(dict(SHIM_OUT, stream=True))))
        events, buf = [], ""
        async for chunk in reply:
            if isinstance(chunk, dict):
                events.append(chunk)
                continue
            buf += chunk.decode("utf-8") if isinstance(chunk, (bytes, bytearray)) else chunk
            *whole, buf = buf.split("\n")
            events += [json.loads(line[6:]) for line in whole if line.startswith("data: ")]
        if buf.startswith("data: "):
            events.append(json.loads(buf[6:]))
        return events, None
    except Exception as e:
        return None, e
    finally:
        _stream_body[0] = None


async def _all():  # ONE event loop for every call: the Router is never driven from a second one
    return await _both(), (await _stream(False), await _stream(True), await _stream(False, True))


