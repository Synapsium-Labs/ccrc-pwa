def _blocks(events):
    """The Anthropic events folded per content block, in start order: (type,
    every partial_json or text its deltas carried, joined). A delta for a block
    that never started, or after its block stopped, is the answer itself."""
    seen, order = {}, []
    for e in events:
        kind = e.get("type") if isinstance(e, dict) else None
        if kind == "content_block_start":
            seen[e.get("index")] = [(e.get("content_block") or {}).get("type"), "", False]
            order.append(e.get("index"))
        elif kind == "content_block_delta":
            block = seen.get(e.get("index"))
            if block is None or block[2]:
                return [("delta-outside-its-block", e.get("index"))]
            delta = e.get("delta") or {}
            block[1] += delta.get("partial_json") or delta.get("text") or ""
        elif kind == "content_block_stop" and e.get("index") in seen:
            seen[e.get("index")][2] = True
    return [(seen[i][0], seen[i][1]) for i in order]


