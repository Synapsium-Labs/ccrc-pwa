# ── THE PATCH ────────────────────────────────────────────────────────────
# The heredoc below is ccrc's LiteLLM stream patch (the header's THE PATCH;
# spec §22.2, D-4859), and `patch-source` prints it verbatim: the `patch`
# stage writes these bytes into each generation's site-packages, and the stamp's
# probeSha256 hashes them after the probe's, so ANY edit between the two PATCH
# lines — a comment included — rebuilds every box's runtime on its next
# install, exactly as a probe edit does. The probe is its acceptance test.
_rt_patch_source() {
  cat <<'PATCH'
# ccrc_litellm_patch: ccrc's one patch to the LiteLLM a Codex lane runs on (spec §22).
# ccgpt-runtime writes this file and a one-line ccrc_litellm_patch.pth into each
# generation's site-packages, `patch-source` prints it, and the behaviour probe is its
# acceptance test: a generation where the probe's no-delta stream loses a tool call's
# arguments never becomes current.
#
# THE DEFECT. A lane's /v1/messages request reaches Codex through LiteLLM's
# chat-completions bridge, whose stream iterator turns each Responses event into a
# chat chunk. It forwards a tool call's arguments and a message's text ONLY from
# their delta events, and it answers `response.output_item.done` with an EMPTY chunk,
# on the stated premise that "the item's fields were already streamed". Codex sends
# some responses, most often ones carrying parallel tool calls, with no delta events
# at all: the arguments and the text arrive only in the finished item. Each call then
# reaches Claude Code with input {} (measured 2026-10-12: 70-91% of multi-call
# responses from Claude Code 2.1.292 on, on both lanes).
#
# THE FIX. When `response.output_item.done` finishes a function_call, custom_tool_call
# or message item that streamed nothing, the iterator is handed the item's own
# arguments, input or text as ONE delta event in place of that done event, so the
# chunk it makes is the same chunk a streamed delta would have made. Nothing is sent
# twice: a call whose arguments streamed, or arrived whole in its added event, is left
# alone, and so is a message whose text streamed. It assumes each output item is
# emitted whole (its added event, its deltas, its done event) before the next item's
# added event, as LiteLLM's bridge and adapter already assume for streamed deltas: the
# synthesized delta carries no id, and downstream joins an id-less delta to the call
# that opened most recently. A call that streamed nothing and finishes after a later
# item was added still gets its delta, and the stream says so on stderr, once
# (`interleaved no-delta items`), so a broken assumption is seen, not silent.
#
# LAZY AND INERT. Importing this module imports nothing from LiteLLM. It adds a
# meta-path finder that waits for the bridge's module and patches the iterator class
# once, after that module has executed. A class without `chunk_parser` is left as it
# is, and an error inside the fallback is written to stderr and never breaks a stream.
# A process that never imports the bridge never touches it.
import sys

_PREFIX = "litellm."
_SUFFIX = ".litellm_responses_transformation.transformation"
_CLASS = "OpenAiResponsesToChatCompletionStreamIterator"
_MARK = "_ccrc_done_fallback"
_CALL_DELTA = {"function_call": ("response.function_call_arguments.delta", "arguments"),
               "custom_tool_call": ("response.custom_tool_call_input.delta", "input")}
_TEXT_DELTA = "response.output_text.delta"


def _warn(what):
    try:
        sys.stderr.write("ccrc_litellm_patch: %s\n" % (what,))
    except Exception:
        pass


def _kind(chunk):
    kind = chunk.get("type")
    return getattr(kind, "value", kind)


def _message_text(item):
    return "".join(part.get("text") for part in item.get("content") or ()
                   if isinstance(part, dict) and part.get("type") == "output_text"
                   and isinstance(part.get("text"), str))


def _in_place_of_done(state, chunk):
    """The chunk the iterator should parse instead of `chunk`: `chunk` itself, or one
    synthesized delta event carrying a finished item that streamed nothing."""
    kind = _kind(chunk)
    item = chunk.get("item")
    item = item if isinstance(item, dict) else {}
    slot = chunk.get("output_index", 0)
    if kind in (delta for delta, _ in _CALL_DELTA.values()):
        if chunk.get("delta"):
            state.add(("call", slot))
        return chunk
    if kind == _TEXT_DELTA:
        if chunk.get("delta"):
            state.add(("text", chunk.get("item_id")))
        return chunk
    if kind == "response.output_item.added":
        for key in [k for k in state if k[0] == "added"]:
            state.discard(key)
        state.add(("added", slot))  # the most recent added item's slot, and only that
        field = _CALL_DELTA.get(item.get("type"), (None, None))[1]
        if field and (item.get(field) or chunk.get("arguments")):
            state.add(("call", slot))  # the added event carried them whole
        return chunk
    if kind != "response.output_item.done":
        return chunk
    if item.get("type") in _CALL_DELTA:
        delta_kind, field = _CALL_DELTA[item["type"]]
        payload = item.get(field)
        if ("call", slot) in state or not isinstance(payload, str) or not payload:
            return chunk
        state.add(("call", slot))
        if ("added", slot) not in state and any(k[0] == "added" for k in state) and ("warned",) not in state:
            state.add(("warned",))
            _warn("interleaved no-delta items: output item %r finished after a later item was added; "
                  "its arguments were handed on anyway, and downstream may join them to that later "
                  "call" % (slot,))
        return {"type": delta_kind, "item_id": item.get("id"), "output_index": slot, "delta": payload}
    if item.get("type") == "message":
        text = _message_text(item)
        if not text or ("text", item.get("id")) in state or ("text", None) in state:
            return chunk
        state.add(("text", item.get("id")))
        return {"type": _TEXT_DELTA, "item_id": item.get("id"), "output_index": slot,
                "content_index": 0, "delta": text}
    return chunk


def _patch_class(cls):
    if getattr(cls, _MARK, False):
        return
    original = getattr(cls, "chunk_parser", None)
    if not callable(original):
        _warn("%s has no chunk_parser; left unpatched" % _CLASS)
        return

    def chunk_parser(self, chunk):
        if isinstance(chunk, dict):
            try:
                chunk = _in_place_of_done(self.__dict__.setdefault("_ccrc_streamed", set()), chunk)
            except Exception as e:
                _warn("fallback skipped: %s: %s" % (type(e).__name__, e))
        return original(self, chunk)

    chunk_parser.__wrapped__ = original
    cls.chunk_parser = chunk_parser
    setattr(cls, _MARK, True)


def _apply(module):
    cls = getattr(module, _CLASS, None)
    if isinstance(cls, type):
        try:
            _patch_class(cls)
        except Exception as e:
            _warn("not applied: %s: %s" % (type(e).__name__, e))


class _Finder(object):
    _ccrc_finder = True  # what a later run of this module recognises; the class itself is new each run

    def find_spec(self, name, path=None, target=None):
        if not (name.startswith(_PREFIX) and name.endswith(_SUFFIX)):
            return None
        for finder in sys.meta_path:
            if finder is self or not hasattr(finder, "find_spec"):
                continue
            spec = finder.find_spec(name, path, target)
            if spec is not None:
                break
        else:
            return None
        inner = getattr(spec.loader, "exec_module", None)
        if inner is None:
            return spec

        def exec_module(module):
            inner(module)
            _apply(module)

        try:
            spec.loader.exec_module = exec_module
        except Exception as e:
            _warn("loader not wrapped: %s: %s" % (type(e).__name__, e))
        return spec


# One finder per process, even when this module's body runs twice (a reload, or an
# import under a second name): each run defines a NEW _Finder class, so an isinstance
# test never matches the first run's finder, and two finders delegate to each other
# without end. The class attribute is read by name, so it matches across runs.
if not any(getattr(f, "_ccrc_finder", False) is True for f in sys.meta_path):
    sys.meta_path.insert(0, _Finder())
for _name, _module in list(sys.modules.items()):
    if _name.startswith(_PREFIX) and _name.endswith(_SUFFIX):
        _apply(_module)
PATCH
}

