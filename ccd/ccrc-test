#!/usr/bin/env bash
# ccrc-test — `ccrc test`: run one test or typecheck command inside the fleet's
# test slice, behind the fleet-wide admission queue (D-TBD-test-containment).
#
#   ccrc test [--heavy|--light] [--] <command> [<arg>...]
#   ccrc test --classify [--] <command> [<arg>...]   # prints heavy or light
#   ccrc test --status                               # the slice and the queue, one line
#
# WHY. On a fleet box about twenty sessions each ran vitest, tests-inclusive
# tsc, browser tests and mutation loops in their own pane scopes, beside the
# sessions themselves. The box's load passed the agent's ability to answer, so
# the server read the fleet box as unreachable, and the tests' fsyncs raised the
# io-pressure banner. This wrapper moves every test run out of the session's
# pane scope into one slice of its own, `ccrc-tests.slice`
# (deploy/systemd/ccrc-tests.slice), whose hard memory cap, bounded swap, low
# CPU and IO weight and CPU quota hold the runs below the sessions: a session
# always wins the CPU, and a run past the memory cap is killed inside the slice
# without pushing the session slice into reclaim.
#
# THE SLICE. The command runs as `systemd-run --user --scope
# --slice=ccrc-tests.slice -- <command>`. A scope runs the command in this
# process's place, with this process's environment, working directory and
# terminal, so the run sees the session environment exactly as a bare run
# would. Before each run the slice's five limits are applied from the box's
# settings (`_test_knobs` in ccd/ccrc, read by ccrc's one reader `_ccrc_knob`:
# the environment, else ~/.ccrc/ccrc.env, else the default) with `systemctl
# --user set-property --runtime`, so a changed setting holds from the next
# run, and a reboot falls back to the unit file's own values, which are the
# same defaults. A slice the user manager has not loaded is REFUSED, never
# created: `systemd-run --slice=` of an unknown slice makes a transient one
# with no limits at all, which is the uncontained run this file exists to stop.
# macOS has no user manager and no cgroups; there the command runs as it is,
# says so, and still takes its turn in the queue.
#
# THE QUEUE. A HEAVY run (`_heavy` below: tsc and typecheck, a full or wide
# vitest or jest run, browser tests, mutation tests, `npm test`) takes one of
# CCRC_TEST_HEAVY_SLOTS slots before it starts. A slot is a lock file in the
# registry, `~/.cc-sessions/test-slots/slot-<n>`, held with `flock` by this
# process for the whole run; `slot-<n>.who` says who holds it. The kernel
# drops a lock when its holder dies, so a killed holder frees its slot at once,
# with nothing to reap. The command itself runs with the lock's descriptor
# closed: the slot is this wrapper's, and lives exactly as long as it does. A
# run that finds every slot held prints once that it is queued, and who holds
# the slots, then waits; `wait-<pid>` (locked the same way) is what
# `--status` counts as waiting. With CCRC_TEST_PRESSURE_MAX above 0, a heavy
# run also waits, before it takes a slot, while the box's memory or CPU
# pressure (PSI `some avg10`) is above it. A LIGHT run (one or a few named test
# files) takes no slot and runs in the slice at once. A run inside a run
# (`CCRC_TEST_INSIDE` set by this wrapper) is already contained, so it runs as
# it is: a nested heavy run never waits on its own parent's slot.
#
# EXIT. The command's own exit code. This wrapper's own refusals exit 1 (the
# slice is unavailable, a slot could not be taken) and 2 (usage), ccrc's house
# convention, each with one `ccrc test:` line on stderr. The command never ran
# when either is printed.
set -uo pipefail

TEST_HERE="${BASH_SOURCE[0]}"
[[ "$TEST_HERE" == */* ]] || TEST_HERE="./$TEST_HERE"
TEST_HERE="$(cd "${TEST_HERE%/*}" && pwd)"
# shellcheck source=ccrc
. "$TEST_HERE/ccrc" || { echo "ccrc test: cannot load $TEST_HERE/ccrc, so no setting can be read" >&2; exit 1; }
PROG="ccrc test"

SLICE=ccrc-tests.slice
SLOT_DIR="$HOME/.cc-sessions/test-slots"
# How often a queued run looks again, in seconds. Environment only: a bound on one wait, overridable so a suite need not
# wait it out (the CCRC_HEALTH_TIMEOUT class), never a box's setting.
POLL_S="${CCRC_TEST_POLL_S:-2}"
PROC_ROOT="${CCRC_PROC_ROOT:-/proc}"

_tdie() { echo "$PROG: $*" >&2; exit 1; }
_tusage() { echo "$PROG: $*" >&2; echo "usage: ccrc test [--heavy|--light] [--] <command> [<arg>...] | --classify [--] <command>... | --status" >&2; exit 2; }

# ── the settings, validated ───────────────────────────────────────────────
# `_test_knobs` (ccd/ccrc) prints `KEY<US>default<US>value<US>from` per setting (US, octal 037, is not IFS whitespace,
# so an empty field stays a field), the value empty and `from` the
# reader's sentence when the setting cannot be read. A value that is not the setting's shape keeps the default and warns
# on stderr, naming the key, the value and where it came from: a typo never removes a cap.
declare -A TK=()
_tshape() {   # <KEY> <value> -> 0 when the value is the key's shape
  local v="$2"
  case "$1" in
    CCRC_TEST_SLICE_MEMORY_MAX) [[ "$v" =~ ^[1-9][0-9]*[KMGT]$ || "$v" =~ ^([1-9][0-9]?|100)%$ ]] ;;
    CCRC_TEST_SLICE_SWAP_MAX) [[ "$v" =~ ^(0|[1-9][0-9]*[KMGT])$ ]] ;;
    CCRC_TEST_SLICE_CPU_WEIGHT|CCRC_TEST_SLICE_IO_WEIGHT) [[ "$v" =~ ^[1-9][0-9]{0,4}$ ]] && [ "$v" -le 10000 ] ;;
    CCRC_TEST_SLICE_CPU_QUOTA) [[ "$v" =~ ^[1-9][0-9]{0,5}%$ ]] ;;
    CCRC_TEST_HEAVY_SLOTS) [[ "$v" =~ ^[1-9][0-9]?$ ]] ;;
    CCRC_TEST_WIDE_FILES) [[ "$v" =~ ^[0-9]{1,3}$ ]] ;;
    CCRC_TEST_PRESSURE_MAX) [[ "$v" =~ ^[0-9]{1,2}$ ]] ;;
    *) return 1 ;;
  esac
}
_tshape_says() {   # <KEY> -> the shape, in words, for the warning
  case "$1" in
    CCRC_TEST_SLICE_MEMORY_MAX) echo "a whole number with a K, M, G or T suffix, or 1% to 100%" ;;
    CCRC_TEST_SLICE_SWAP_MAX) echo "0, or a whole number with a K, M, G or T suffix" ;;
    CCRC_TEST_SLICE_CPU_QUOTA) echo "a whole percentage such as 400%" ;;
    CCRC_TEST_HEAVY_SLOTS) echo "a whole number from 1 to 99" ;;
    CCRC_TEST_WIDE_FILES) echo "a whole number from 0 to 999" ;;
    CCRC_TEST_PRESSURE_MAX) echo "a whole number from 0 (off) to 99" ;;
    *) echo "a whole number from 1 to 10000" ;;
  esac
}
_tload() {
  local k d v from
  while IFS=$'\037' read -r k d v from; do
    [ -n "$k" ] || continue
    if [ -z "$v" ]; then
      echo "$PROG: WARN: ${from:-$k cannot be read}; using its default $d" >&2; v="$d"
    elif ! _tshape "$k" "$v"; then
      [ "$from" = file ] && from="~/.ccrc/ccrc.env"
      echo "$PROG: WARN: $k=$v (from the $from) is not $(_tshape_says "$k"); using its default $d" >&2; v="$d"
    fi
    TK["$k"]="$v"
  done < <(_test_knobs)
}

# ── heavy or light ────────────────────────────────────────────────────────
# Heavy: a typecheck (`tsc`, `vue-tsc`, any word naming `typecheck`), browser or end-to-end tests (`playwright`, any
# word naming `browser`), mutation tests (`stryker`), a package manager's whole suite (`npm test`, `npm run test…`, and
# the same under pnpm, yarn and bun), and a vitest or jest run that names no test file or more than
# CCRC_TEST_WIDE_FILES of them. Everything else is light. A word is read by its last path component, so `npx vitest`,
# `./node_modules/.bin/vitest` and `vitest` are one program.
_heavy() {   # <wide> <command> [<arg>...] -> 0 heavy, 1 light
  local wide="$1" w b i=0 prog="" files=0
  shift
  local -a a=("$@")
  for w in "${a[@]}"; do
    b="${w##*/}"
    case "$b" in
      tsc|vue-tsc|tsgo|playwright|stryker) return 0 ;;
      *typecheck*|*browser*) return 0 ;;
    esac
  done
  for ((i = 0; i < ${#a[@]}; i++)); do
    b="${a[i]##*/}"
    case "$b" in
      npm|pnpm|yarn|bun) [ "${a[i+1]:-}" = test ] && return 0
        [[ "${a[i+1]:-}" = run && "${a[i+2]:-}" == test* ]] && return 0 ;;
      vitest|jest) prog="$b"; break ;;
    esac
  done
  [ -n "$prog" ] || return 1
  for ((i = i + 1; i < ${#a[@]}; i++)); do
    w="${a[i]}"
    case "$w" in
      -*|run|watch|related|bench) ;;
      *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs|*.mts|*.cts|*/*) files=$((files + 1)) ;;
    esac
  done
  [ "$files" -eq 0 ] || [ "$files" -gt "$wide" ]
}

# ── the queue ─────────────────────────────────────────────────────────────
_tlocked() { ! flock -n "$1" true 2>/dev/null; }   # <file> -> 0 when another process holds its lock
_tholders() {   # -> "slot <n>: <who>; …" for every held slot
  local f out="" who
  for f in "$SLOT_DIR"/slot-*; do
    case "$f" in *.who|*'*') continue ;; esac
    [ -e "$f" ] && _tlocked "$f" || continue
    who=""; [ -f "$f.who" ] && IFS= read -r who < "$f.who"
    out+="${out:+; }${f##*/}: ${who:-unknown}"
  done
  printf '%s' "$out"
}
_tpressure() {   # <max> -> 0 while memory or cpu pressure is above it; PRESSURE_SAID says which
  local max="$1" r v
  PRESSURE_SAID=""
  for r in memory cpu; do
    [ -r "$PROC_ROOT/pressure/$r" ] || continue
    v=$(awk '$1 == "some" { for (i = 2; i <= NF; i++) if ($i ~ /^avg10=/) { sub(/^avg10=/, "", $i); print $i; exit } }' "$PROC_ROOT/pressure/$r" 2>/dev/null)
    [ -n "$v" ] || continue
    if awk -v v="$v" -v m="$max" 'BEGIN { exit !(v + 0 > m + 0) }'; then PRESSURE_SAID="host $r pressure (avg10) is $v, above CCRC_TEST_PRESSURE_MAX=$max"; return 0; fi
  done
  return 1
}
SLOT_FD=""; WAIT_FD=""; SLOT_FILE=""; WAIT_FILE=""
_trelease() {
  [ -z "$SLOT_FILE" ] || rm -f -- "$SLOT_FILE.who"
  [ -z "$WAIT_FILE" ] || rm -f -- "$WAIT_FILE"
  [ -z "$SLOT_FD" ] || exec {SLOT_FD}>&-
  [ -z "$WAIT_FD" ] || exec {WAIT_FD}>&-
  SLOT_FD=""; WAIT_FD=""
}
_tacquire() {   # <summary> -> sets SLOT_FD and SLOT_FILE, or dies
  local summary="$1" n="${TK[CCRC_TEST_HEAVY_SLOTS]}" max="${TK[CCRC_TEST_PRESSURE_MAX]}" i f fd said=0 why t0=$SECONDS
  mkdir -p -- "$SLOT_DIR" || _tdie "cannot create the slot directory ~/.cc-sessions/test-slots"
  command -v flock >/dev/null 2>&1 || _tdie "flock is not on PATH, so no test slot can be taken (install util-linux)"
  while :; do
    why=""
    if [ "$max" -gt 0 ] && _tpressure "$max"; then why="$PRESSURE_SAID"
    else
      for ((i = 0; i < n; i++)); do
        f="$SLOT_DIR/slot-$i"
        exec {fd}>>"$f" || continue
        if flock -n "$fd"; then
          SLOT_FD=$fd; SLOT_FILE=$f
          printf 'pid %s since %s: %s\n' "$$" "$(date +%H:%M:%S)" "$summary" > "$f.who"
          [ "$said" -eq 0 ] || echo "$PROG: slot $i is free after $((SECONDS - t0))s; starting" >&2
          [ -z "$WAIT_FILE" ] || { rm -f -- "$WAIT_FILE"; exec {WAIT_FD}>&-; WAIT_FD=""; WAIT_FILE=""; }
          return 0
        fi
        exec {fd}>&-
      done
      why="all $n heavy test slots are held ($(_tholders))"
    fi
    if [ "$said" -eq 0 ]; then
      echo "$PROG: queued: $why; waiting (it starts when that clears)" >&2
      said=1
      WAIT_FILE="$SLOT_DIR/wait-$$"
      if exec {WAIT_FD}>>"$WAIT_FILE"; then
        flock -n "$WAIT_FD" || :
        printf 'pid %s since %s: %s\n' "$$" "$(date +%H:%M:%S)" "$summary" > "$WAIT_FILE"
      fi
    fi
    sleep "$POLL_S"
  done
}

# ── the slice ─────────────────────────────────────────────────────────────
_tslice_props() {   # -> the five limits as set-property arguments
  printf '%s\n' "MemoryMax=${TK[CCRC_TEST_SLICE_MEMORY_MAX]}" "MemorySwapMax=${TK[CCRC_TEST_SLICE_SWAP_MAX]}" \
    "CPUWeight=${TK[CCRC_TEST_SLICE_CPU_WEIGHT]}" "CPUQuota=${TK[CCRC_TEST_SLICE_CPU_QUOTA]}" "IOWeight=${TK[CCRC_TEST_SLICE_IO_WEIGHT]}"
}
_tslice_ready() {   # -> 0 when the slice is loaded and took the limits; TSLICE_WHY otherwise
  local load props
  TSLICE_WHY=""
  command -v systemctl >/dev/null 2>&1 && command -v systemd-run >/dev/null 2>&1 \
    || { TSLICE_WHY="systemctl or systemd-run is not on PATH, so the run cannot be put in $SLICE"; return 1; }
  load=$(systemctl --user show "$SLICE" -p LoadState --value 2>/dev/null) || load=""
  [ "$load" = loaded ] || { TSLICE_WHY="$SLICE is not loaded by the user manager (LoadState=${load:-unanswered}): ccrc install or ccrc update places ~/.config/systemd/user/$SLICE, then systemctl --user daemon-reload"; return 1; }
  mapfile -t props < <(_tslice_props)
  systemctl --user set-property --runtime "$SLICE" "${props[@]}" 2>/dev/null \
    || { TSLICE_WHY="systemctl --user set-property $SLICE ${props[*]} failed, so its limits are unmeasured"; return 1; }
}

# The slice's OOM kill count (memory.events `oom_kill`), empty when it cannot be read. The cgroup path is ASKED FOR
# (`-p ControlGroup`), never built: building it is what left ccd-cap-scopes capping nothing for 13 days.
_toom_kills() {
  local cg
  cg=$(systemctl --user show "$SLICE" -p ControlGroup --value 2>/dev/null) || cg=""
  [ -n "$cg" ] || { echo 0; return 0; }
  awk '$1 == "oom_kill" { print $2; exit }' "${CCRC_CGROUP_ROOT:-/sys/fs/cgroup}$cg/memory.events" 2>/dev/null
}
_thuman() { awk -v b="$1" 'BEGIN { split("B K M G T", u, " "); i = 1; while (b >= 1024 && i < 5) { b /= 1024; i++ } printf (i == 1 ? "%d%s" : "%.1f%s"), b, u[i] }'; }

# ── --status: one line for doctor ─────────────────────────────────────────
# rc 0 and the line on stdout; rc 2 and the line when the slice is not loaded or holds no memory cap (doctor's WARN).
_tstatus() {
  local f held=0 waiting=0 k v line="" rc=0
  local -A p=()
  if [ -d "$SLOT_DIR" ]; then
    for f in "$SLOT_DIR"/slot-* "$SLOT_DIR"/wait-*; do
      [ -e "$f" ] || continue
      case "$f" in *.who) continue ;; esac
      _tlocked "$f" || continue
      case "${f##*/}" in slot-*) held=$((held + 1)) ;; *) waiting=$((waiting + 1)) ;; esac
    done
  fi
  local queue="heavy slots $held of ${TK[CCRC_TEST_HEAVY_SLOTS]} held, $waiting waiting"
  if [ "${CCD_OS:-linux}" = darwin ] || ! command -v systemctl >/dev/null 2>&1; then
    echo "no user manager here, so runs are not contained; $queue"; return 0
  fi
  while IFS='=' read -r k v; do [ -n "$k" ] && p["$k"]="$v"; done \
    < <(systemctl --user show "$SLICE" -p LoadState -p MemoryCurrent -p MemoryMax -p MemorySwapMax -p CPUWeight -p CPUQuotaPerSecUSec -p IOWeight 2>/dev/null)
  if [ "${p[LoadState]:-}" != loaded ]; then
    echo "$SLICE is not loaded (LoadState=${p[LoadState]:-unanswered}), so ccrc test refuses every run; $queue"; return 2
  fi
  local cur="${p[MemoryCurrent]:-}" max="${p[MemoryMax]:-}"
  [[ "$cur" =~ ^[0-9]+$ ]] && cur="$(_thuman "$cur")" || cur="0B"
  if ! [[ "$max" =~ ^[0-9]+$ ]]; then
    echo "$SLICE holds $cur with no memory cap (MemoryMax=${max:-unanswered}); $queue"; return 2
  fi
  line="$SLICE holds $cur of its $(_thuman "$max") memory cap"
  v="${p[MemorySwapMax]:-}"; [[ "$v" =~ ^[0-9]+$ ]] && line+=", swap cap $(_thuman "$v")"
  line+=", CPU weight ${p[CPUWeight]:-unanswered}, CPU quota ${p[CPUQuotaPerSecUSec]:-unanswered} per second, IO weight ${p[IOWeight]:-unanswered}; $queue"
  echo "$line"; return "$rc"
}

# ── main ──────────────────────────────────────────────────────────────────
mode=run force=""
while [ $# -gt 0 ]; do
  case "$1" in
    --heavy) force=heavy; shift ;;
    --light) force=light; shift ;;
    --classify) mode=classify; shift ;;
    --status) mode=status; shift ;;
    -h|--help) sed -n '2,7p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    --) shift; break ;;
    -*) _tusage "unknown argument: $1" ;;
    *) break ;;
  esac
done
_tload
if [ "$mode" = status ]; then [ $# -eq 0 ] || _tusage "--status takes no command"; _tstatus; exit $?; fi
[ $# -gt 0 ] || _tusage "missing command"
cmd=("$@")
if [ -z "$force" ]; then if _heavy "${TK[CCRC_TEST_WIDE_FILES]}" "${cmd[@]}"; then force=heavy; else force=light; fi; fi
if [ "$mode" = classify ]; then echo "$force"; exit 0; fi

if [ -n "${CCRC_TEST_INSIDE:-}" ]; then exec "${cmd[@]}"; fi
summary="${cmd[*]}"; summary="${summary//$'\n'/ }"; summary="${summary:0:160}"
contained=1
if [ "${CCD_OS:-linux}" = darwin ]; then
  contained=0
  echo "$PROG: this box has no systemd user manager (macOS), so the run is not contained; the queue still applies" >&2
elif ! _tslice_ready; then
  _tdie "refused, nothing ran: $TSLICE_WHY"
fi
trap '_trelease' EXIT
trap '[ -n "${child:-}" ] && kill -TERM "$child" 2>/dev/null' TERM INT HUP
[ "$force" = light ] || _tacquire "$summary"
[ -z "$WAIT_FD" ] || { exec {WAIT_FD}>&-; WAIT_FD=""; }
export CCRC_TEST_INSIDE=1
child=""
oom0=""; [ "$contained" = 0 ] || oom0=$(_toom_kills)
if [ "$contained" = 1 ]; then
  if [ -n "$SLOT_FD" ]; then
    systemd-run --user --scope --quiet --collect --slice="$SLICE" --unit="ccrc-test-$$" --description="ccrc test: $summary" -- "${cmd[@]}" <&0 {SLOT_FD}>&- &
  else
    systemd-run --user --scope --quiet --collect --slice="$SLICE" --unit="ccrc-test-$$" --description="ccrc test: $summary" -- "${cmd[@]}" <&0 &
  fi
elif [ -n "$SLOT_FD" ]; then
  "${cmd[@]}" <&0 {SLOT_FD}>&- &
else
  "${cmd[@]}" <&0 &
fi
child=$!
rc=0
while :; do
  { wait "$child"; } 2>/dev/null; rc=$?   # bash's own `Killed` job line says less than the line below
  kill -0 "$child" 2>/dev/null || break
done
if [ -n "$oom0" ]; then
  oom1=$(_toom_kills)
  [[ "$oom0" =~ ^[0-9]+$ && "$oom1" =~ ^[0-9]+$ ]] && [ "$oom1" -gt "$oom0" ] \
    && echo "$PROG: the test slice's memory cap killed a process during this run (MemoryMax=${TK[CCRC_TEST_SLICE_MEMORY_MAX]}, CCRC_TEST_SLICE_MEMORY_MAX; $((oom1 - oom0)) OOM kill(s) in $SLICE); exit $rc" >&2
fi
exit "$rc"
