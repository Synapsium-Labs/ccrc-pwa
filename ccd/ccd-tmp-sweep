#!/usr/bin/env bash
# ccd-tmp-sweep — reap Claude Code's per-uid temp dir. Serialized oneshot driven
# by ccd-tmp-sweep.timer, owned the way ccd-graph-sweep is: one flock, one pause
# file, every knob env-overridable for the test harness.
#
# WHY THIS EXISTS. Claude Code keeps every session's scratchpad and its
# background-task output under `${TMPDIR:-/tmp}/claude-<uid>/`, laid out as
# `<project-slug>/<session-uuid>/{scratchpad,tasks}/...` — the project slug is
# the session's cwd with `/` turned into `-`, so every one of them starts with a
# dash (`-home-<user>-worktrees-<repo>-<name>`). Agents also write
# straight into the root: the fleet host carried ~1800 loose top-level files and
# dirs beside the project dirs. NOTHING EVER CLEANS ANY OF IT. Claude Code does
# not, tmpfiles.d does not (the dir is not on tmpfs and the box is rebooted
# rarely), and a single task `.output` file reaches 1-4G. On 2026-09-22
# `/tmp/claude-1000` on the fleet host had reached 138G and pushed `/` to 94%.
# A one-off manual cleanup under the rules below removed 2002 stale session dirs
# (18G); this script is that cleanup, made standing. The artifact-lifecycle
# policy (docs/superpowers/specs/2026-08-11-artifact-lifecycle-policy.md, row
# #9) had already named this root as "declared to agents in their own system
# prompt and then never collected"; `shared/lifecycle.ts` now names this script
# as its collector.
#
# WHAT A PASS REMOVES. The unit of removal is either a SESSION DIR (depth 2,
# `<project>/<entry>`) or a LOOSE ENTRY (depth 1, anything in the root that is
# not a project dir). A top-level entry is a PROJECT DIR when it is a real
# directory (not a symlink) with at least one child directory whose name is
# session-uuid-shaped; everything else at the top level is loose. The rule is
# deliberately about CHILDREN rather than the leading dash: a loose dir an agent
# happened to name `-foo` is still loose, and a project dir whose sessions have
# all been reaped reads as loose (and, being empty and old, goes as one unit).
# Misclassifying either way changes only the GRANULARITY of removal, never
# whether the three safety checks run — every unit, whatever its kind, is held
# to all of them. Non-uuid entries inside a project dir are units too, on the
# same terms; they are rare, and leaving them would make the project dir
# unremovable for ever.
#
# A unit is removed ONLY if ALL of these hold:
#   (a) NOT LIVE. No live session's id appears in its path. Live ids come from
#       every Claude config dir's `sessions/<pid>.json` (`sessionId`; the file
#       name is the pid) whose /proc/<pid> exists. The config dirs are the
#       roster's (`~/.ccrc/accounts.sh`'s `_ccrc_cfg_dir`, exactly as
#       ccd-usage-sweep reads them), UNIONED with a `~/.claude*/` glob and with
#       the CLAUDE_CONFIG_DIR (or $HOME/.claude) of every running claude
#       process — three sources because a missed config dir silently turns its
#       live sessions into "dead" ones. Belt and braces on top: every
#       uuid-shaped argument on a running claude's command line
#       (`--resume <uuid>`) is live too. FAIL CLOSED: if claude processes are
#       running and NOT ONE sessions dir can be read, the whole pass refuses
#       rather than treating every session as dead.
#       A HIBERNATED session is live too, though no process runs it: every
#       registry row with `$HOME/.cc-sessions/<id>.hibernated` contributes its
#       `<id>.uuid`, because its wake resumes that same uuid and must find its
#       temp directory (scratchpad, task outputs) where it left it, however long
#       it slept (`hibernate-long-idle-sessions` (D-5242)). A `.hibernated` row
#       whose `.uuid` cannot be read refuses the pass (`hibernated-unreadable`).
#   (b) NOT IN USE. No process has its cwd, or an open fd, at or under it
#       (`/proc/*/cwd` and `/proc/*/fd/*` link targets — every session runs as
#       this user, so no privilege is needed to see them).
#   (c) NOT RECENT. Nothing at or under it — every file, dir and link, the unit
#       itself included — has an mtime newer than the max age. EVERY entry, not
#       the dir's own mtime: on the fleet host that was measured to be badly
#       misleading (an old dir with a task `.output` still being appended to).
#       A unit find cannot fully read is skipped as `unreadable`, never assumed
#       old.
# (a), (b) and (c) are ALL RE-CHECKED immediately before each `rm -rf`: the
# scan over hundreds of thousands of files takes minutes, and a session can
# resume, or a task start writing, inside that window.
#
# SAFETY OF THE PATHS THEMSELVES. Every path handed to a tool is `./`-prefixed
# and every tool that takes one gets `--`: project slugs START WITH `-`, and a
# manual run of these very rules was bitten by grep/du reading a slug as an
# option. The pass `cd`s into the resolved root first so `./` means the root.
# It never follows a symlink out of the root (find runs -P, a symlink is
# removed as itself), never crosses a filesystem (`-xdev`, `du -x`,
# `rm --one-file-system`), and refuses a root that does not resolve strictly
# inside /tmp or $TMPDIR or is not owned by the running uid.
#
# OUTPUT. One summary line on stdout per pass (the journal is the record);
# `--dry-run` also prints one `would-remove` line per unit and removes nothing.
# Refusals go to stderr with a named reason and exit 1. A unit whose `rm`
# fails is counted in the summary and the pass carries on; the pass still
# exits 0, because a single unremovable file must not turn every hourly run
# into a failed unit.
#
# THE LIVE ARM (fleet disk retention, DR-8, D-6620; spec 2026-10-23 sections 2.1 and 2.1.1). After
# the dead pass, under the same lock and pause file, it reaches into the units that pass called LIVE
# (a running or hibernated session) and takes two kinds of top-level entry out of their `scratchpad/`
# and `tasks/` (never those two directories, never the unit):
#   - an entry untouched for 14 days (3 under pressure): every entry under it has mtime and ctime
#     older than that, and every regular file an atime too unless its mount is `noatime`;
#   - the SIZE BUDGET's: a session whose scratch, summed over every root and unit of its uuid, is
#     over CCD_TMP_BUDGET_GB (20) gets its overSince recorded and 24 hours of grace (none under
#     pressure); then, oldest first, entries untouched for 48 hours (a floor pressure never lowers),
#     unheld, with no git work on no remote, are taken until the total is under
#     CCD_TMP_BUDGET_TARGET_GB (15). Both knobs can only be raised.
# Holders come from `ccd path-users --json` (the one probe); any doubt keeps the entry. A taken
# entry is RENAMED into `<root>/.ccd-tmp-quarantine/<uuid>/<ns>.<name>` and deleted by a pass one
# grace later (24 h; 1 h under pressure) after a fresh holder ask. The roots are today's, `/tmp/
# claude-<uid>` when it differs, and each witnessed child leaf's `claude-<uid>`.
# SHADOW unless `~/.ccrc/tmp-sweep-live-arm` exists: it then lists what it would take and touches
# nothing. No code in the tree creates that file (single-definition.test.ts pins it). The census
# `~/.ccrc/tmp-sweep.json` is replaced whole at the end of every pass, shadow or live.
#
# PORTABILITY. Linux-only by product shape — its only runner is a systemd
# timer, which `_inst_units`' Darwin arm never installs, and it reads /proc —
# the same carve-out ccd-graph-sweep has. It is written to pass
# macos-platform.test.ts's GNU-spelling scan anyway (no `stat -c`, `du -b`,
# `date -d`, bare `timeout` or template-less `mktemp`).
set -uo pipefail

PAUSE="$HOME/.ccrc/tmp-sweep-paused"
LOCK="$HOME/.ccrc/tmp-sweep.lock"
ACCOUNTS_SH="$HOME/.ccrc/accounts.sh"
: "${CCD_TMP_SWEEP_MAX_AGE_DAYS:=7}"
# What makes a process "claude", matched against both argv[0] and comm. The
# native installer runs `~/.local/share/claude/versions/<v>` — whose comm is the
# bare version string, measured on the fleet host — and an npm install sets its
# process title to `claude`. Overridable so the harness can name its own fake
# claude and never be confused by a real one on the box running the suite.
: "${CCD_TMP_SWEEP_CLAUDE_RE:=(^|/)claude\$|/claude/versions/[^/]+\$}"
ROOT="${CCD_TMP_SWEEP_ROOT:-${TMPDIR:-/tmp}/claude-$(id -u)}"
ROOT_LIT="$ROOT"
UUID_RE='^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
UUID_ANY='[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}'

# Pressure mode (spec 2.5.1): a sweep measures its OWN filesystem and, at 92% of bytes or inodes
# used, uses the shorter ages below. `shared/disk.ts` holds the same numbers (DISK_CRITICAL_PCT,
# DISK_PRESSURE_AGES); disk-twins.test.ts reads these lines and requires them equal. Seconds:
# "normal pressure".
TS_PRESSURE_PCT=92
TS_AGES_DEAD_UNITS="604800 172800"
TS_AGES_LIVE_UNTOUCHED="1209600 259200"
TS_AGES_QUARANTINE_GRACE="86400 3600"
TS_AGES_BUDGET_GRACE="86400 0"
TS_AGES_BUDGET_UNTOUCHED_FLOOR="172800 172800"
TS_AGES_LIVE_CADENCE="21600 0"
TS_AGES_TEST_RUN_QUIET="21600 3600"
# The size budget, in GiB, raise-only. TEST SEAM: CCD_TMP_BUDGET_UNIT_BYTES is what one "GiB" is.
: "${CCD_TMP_BUDGET_GB:=20}"
: "${CCD_TMP_BUDGET_TARGET_GB:=15}"
: "${CCD_TMP_BUDGET_UNIT_BYTES:=1073741824}"
LIVE_ARM="$HOME/.ccrc/tmp-sweep-live-arm"
CENSUS="$HOME/.ccrc/tmp-sweep.json"

DRY=0
case "${1:-}" in
  --dry-run) DRY=1 ;;
  '') ;;
  *) echo "usage: ccd-tmp-sweep [--dry-run]" >&2; exit 2 ;;
esac

_ts_die() { echo "tmp-sweep: $*" >&2; exit 1; }

[[ "$CCD_TMP_SWEEP_MAX_AGE_DAYS" =~ ^[1-9][0-9]{0,4}$ ]] \
  || _ts_die "invalid-max-age: CCD_TMP_SWEEP_MAX_AGE_DAYS='$CCD_TMP_SWEEP_MAX_AGE_DAYS' is not a positive integer of days — refusing to guess a horizon"
MAX_MIN=$((CCD_TMP_SWEEP_MAX_AGE_DAYS * 1440))
# Bounded so GiB x unit stays inside signed 64-bit arithmetic: a wrapped product is negative and would turn
# "raise the budget" into "every session is over it".
for _k in CCD_TMP_BUDGET_GB CCD_TMP_BUDGET_TARGET_GB CCD_TMP_BUDGET_UNIT_BYTES; do
  _re='^[1-9][0-9]{0,5}$'; [ "$_k" = CCD_TMP_BUDGET_UNIT_BYTES ] && _re='^[1-9][0-9]{0,9}$'
  [[ "${!_k}" =~ $_re ]] || _ts_die "invalid-budget: $_k='${!_k}' is not a positive integer — refusing to guess a budget"
done
# Raise-only: a knob below its default is the default, and the target never passes the budget.
[ "$CCD_TMP_BUDGET_GB" -ge 20 ] || CCD_TMP_BUDGET_GB=20
[ "$CCD_TMP_BUDGET_TARGET_GB" -ge 15 ] || CCD_TMP_BUDGET_TARGET_GB=15
[ "$CCD_TMP_BUDGET_TARGET_GB" -le "$CCD_TMP_BUDGET_GB" ] || CCD_TMP_BUDGET_TARGET_GB="$CCD_TMP_BUDGET_GB"

[ $((CCD_TMP_BUDGET_GB * CCD_TMP_BUDGET_UNIT_BYTES)) -gt 0 ] && [ $((CCD_TMP_BUDGET_TARGET_GB * CCD_TMP_BUDGET_UNIT_BYTES)) -gt 0 ] \
  || _ts_die "invalid-budget: the budget does not multiply out to a positive byte count"

[ -e "$PAUSE" ] && { echo "tmp-sweep: paused ($PAUSE exists)"; exit 0; }

# An absent root is the normal state of a box no session has run on since boot:
# nothing to do, and nothing worth a journal line.
[ -e "$ROOT" ] || [ -L "$ROOT" ] || exit 0

# ── the root: resolved, inside a temp dir, ours ────────────────────────────
REAL="$(realpath -e -- "$ROOT" 2>/dev/null)" \
  || _ts_die "root-unresolvable: $ROOT does not resolve"
[ -d "$REAL" ] || _ts_die "root-not-dir: $ROOT resolves to $REAL, which is not a directory"
allowed_ok=0
for base in /tmp "${TMPDIR:-}"; do
  [ -n "$base" ] || continue
  b="$(realpath -e -- "$base" 2>/dev/null)" || continue
  # `/` as a temp dir would make every path "inside" it; never an allowance.
  [ "$b" = / ] && continue
  [[ "$REAL" == "$b"/?* ]] && allowed_ok=1
done
[ "$allowed_ok" -eq 1 ] \
  || _ts_die "root-outside-tmp: $ROOT resolves to $REAL, which is not strictly inside /tmp or \$TMPDIR"
[ -O "$REAL" ] || _ts_die "root-not-owned: $REAL is not owned by uid $(id -u)"
ROOT="$REAL"

# /proc is what checks (a) and (b) read. Without it both would answer "nothing
# live, nothing in use" — the one answer this script must never reach by
# accident.
[ -r /proc/self/fd ] && [ -e "/proc/$$/cwd" ] \
  || _ts_die "no-proc: /proc is not readable here, so live sessions and open files cannot be seen"

mkdir -p "$(dirname "$LOCK")"
exec 9>"$LOCK"
flock -n 9 || { echo "tmp-sweep: another pass holds $LOCK"; exit 0; }

cd -- "$ROOT" || _ts_die "root-unenterable: cannot cd into $ROOT"
shopt -s nullglob dotglob

# ── pressure, and the live arm's roots ───────────────────────────────────────
# Twin of the server's decider (spec 2.5.1): 92% or more of bytes or inodes used on a filesystem
# the sweep works on. `df` is a seam for the harness. Unreadable output is NOT pressure: pressure
# only shortens ages, so doubt keeps the longer one.
_ts_pressure() {   # path -> 0 under pressure, 1 not
  local flag line u a
  for flag in -Pk -Pi; do
    line="$(${CCD_TMP_SWEEP_DF:-df} "$flag" -- "$1" 2>/dev/null | awk 'NR==2 {print $3, $4}')" || continue
    read -r u a <<<"$line"
    [[ "$u" =~ ^[0-9]+$ && "$a" =~ ^[0-9]+$ ]] && [ $((u + a)) -gt 0 ] || continue
    [ $((u * 100)) -ge $((TS_PRESSURE_PCT * (u + a))) ] && return 0
  done
  return 1
}
_ts_age_s() {      # TS_AGES_<NAME> [flag] -> the seconds in force now (flag defaults to the primary root's)
  local v="TS_AGES_$1" n p; read -r n p <<<"${!v}"
  if [ "${2:-$PRESSURE}" -eq 1 ]; then echo "$p"; else echo "$n"; fi
}
# The roots the live arm walks (spec 2.1): each must be a real directory this uid owns whose
# physical path is where it should be. A line is `arm<TAB>physical<TAB>literal`.
LIVE_ROOTS=""
_ts_add_root() {   # arm literal physical
  [ -d "$2" ] && [ ! -L "$2" ] && [ -O "$2" ] || return 0
  [ "$(realpath -e -- "$2" 2>/dev/null)" = "$3" ] || return 0
  case "$LIVE_ROOTS" in *$'\t'"$3"$'\t'*) return 0 ;; esac
  LIVE_ROOTS+="$1"$'\t'"$3"$'\t'"$2"$'\n'
}
_ts_add_root primary "$ROOT_LIT" "$ROOT"
_ts_tmp="${CCD_TMP_SWEEP_TMP_BASE:-/tmp}/claude-$(id -u)"   # the base is a seam for the harness
_ts_add_root tmp "$_ts_tmp" "$(realpath -e -- "$_ts_tmp" 2>/dev/null)"
_ts_cctmp="$(realpath -e -- "$HOME/.cc-tmp" 2>/dev/null)"
if [ -n "$_ts_cctmp" ]; then
  for _w in "$HOME/.cc-sessions/tmproots"/*; do
    _id="${_w##*/}"; [[ "$_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] && [ -f "$_w" ] && [ ! -L "$_w" ] || continue
    _ts_add_root child "$HOME/.cc-tmp/$_id/claude-$(id -u)" "$_ts_cctmp/$_id/claude-$(id -u)"
  done
fi
# Each root answers for its own filesystem: its line gains a fourth field, 1 under pressure. The dead
# pass shortens only on the primary root's own answer; the live arm picks ages per root.
PRESSURE=0
_ts_rootsp=""
while IFS=$'\t' read -r _a _p _l; do
  [ -n "$_p" ] || continue
  _f=0; _ts_pressure "$_p" && _f=1
  [ "$_a" = primary ] && PRESSURE="$_f"
  _ts_rootsp+="$_a"$'\t'"$_p"$'\t'"$_l"$'\t'"$_f"$'\n'
done <<<"$LIVE_ROOTS"
LIVE_ROOTS="$_ts_rootsp"
if [ "$PRESSURE" -eq 1 ]; then
  _dead_p=$(( $(_ts_age_s DEAD_UNITS) / 60 ))
  [ "$_dead_p" -lt "$MAX_MIN" ] && MAX_MIN="$_dead_p"
fi

# ── (a) live sessions ───────────────────────────────────────────────────────
# The roster's config dirs, read ONCE: sourcing the projection is the same act
# ccd-usage-sweep performs, and it cannot change under a pass in a way that
# matters — a config dir it would add is also caught by the glob and by the
# running process's own environment below.
declare -A CFG_SEEN=()
CFGS=()
_ts_add_cfg() { [ -n "$1" ] && [ -z "${CFG_SEEN[$1]+x}" ] && { CFG_SEEN[$1]=1; CFGS+=("$1"); }; return 0; }
# shellcheck source=/dev/null
if [ -r "$ACCOUNTS_SH" ] && . "$ACCOUNTS_SH" 2>/dev/null && declare -F _ccrc_cfg_dir >/dev/null 2>&1; then
  for a in ${CCRC_ACCOUNTS[@]+"${CCRC_ACCOUNTS[@]}"}; do _ts_add_cfg "$(_ccrc_cfg_dir "$a")"; done
fi
for d in "$HOME"/.claude*/; do _ts_add_cfg "${d%/}"; done

declare -A LIVE=()
CLAUDE_N=0
READABLE=0
REFUSE=""
# Fork-free on purpose (mapfile, $(<file), =~): it runs again before EVERY
# removal, and a first pass on a neglected box removes thousands of units.
_ts_collect_live() {
  local p a0 comm f pid body arg v cfg home
  local -a argv envv
  LIVE=(); CLAUDE_N=0; READABLE=0; REFUSE=""
  for p in /proc/[0-9]*; do
    [ -O "$p" ] || continue
    argv=(); { mapfile -d '' -t argv < "$p/cmdline"; } 2>/dev/null || continue
    a0="${argv[0]:-}"; comm=""; { read -r comm < "$p/comm"; } 2>/dev/null
    [[ "$a0" =~ $CCD_TMP_SWEEP_CLAUDE_RE || "$comm" =~ $CCD_TMP_SWEEP_CLAUDE_RE ]] || continue
    CLAUDE_N=$((CLAUDE_N + 1))
    for arg in "${argv[@]}"; do
      while [[ "$arg" =~ $UUID_ANY ]]; do
        LIVE[${BASH_REMATCH[0]}]=1; arg="${arg/${BASH_REMATCH[0]}/}"
      done
    done
    envv=(); { mapfile -d '' -t envv < "$p/environ"; } 2>/dev/null
    cfg=""; home=""
    for v in ${envv[@]+"${envv[@]}"}; do
      case "$v" in CLAUDE_CONFIG_DIR=*) cfg="${v#*=}" ;; HOME=*) home="${v#*=}" ;; esac
    done
    [ -z "$cfg" ] && [ -n "$home" ] && cfg="$home/.claude"
    _ts_add_cfg "$cfg"
  done
  for cfg in "${CFGS[@]}"; do
    [ -d "$cfg/sessions" ] && [ -r "$cfg/sessions" ] && [ -x "$cfg/sessions" ] || continue
    READABLE=$((READABLE + 1))
    for f in "$cfg/sessions"/*.json; do
      pid="${f##*/}"; pid="${pid%.json}"
      [[ "$pid" =~ ^[0-9]+$ ]] && [ -d "/proc/$pid" ] || continue
      # Gone since the glob is a session that ended: nothing to protect. Present
      # but unreadable is a live session this pass cannot see, and that refuses.
      [ -e "$f" ] || continue
      if [ ! -r "$f" ]; then
        REFUSE="sessions-unreadable: $f belongs to live pid $pid and cannot be read, so its session cannot be protected"
        return 1
      fi
      { body="$(<"$f")"; } 2>/dev/null || continue
      [[ "$body" =~ \"sessionId\"[[:space:]]*:[[:space:]]*\"($UUID_ANY)\" ]] && LIVE[${BASH_REMATCH[1]}]=1
    done
  done
  # A sleeping session (D-5242): its uuid is live, read with builtins from the
  # registry. Unreadable is a session this pass cannot protect, and that refuses.
  local hf hid huuid
  for hf in "$HOME/.cc-sessions"/*.hibernated; do
    [ -e "$hf" ] || [ -L "$hf" ] || continue
    hid="${hf##*/}"; hid="${hid%.hibernated}"; huuid=""
    { [ -f "$HOME/.cc-sessions/$hid.uuid" ] && read -r huuid < "$HOME/.cc-sessions/$hid.uuid"; } 2>/dev/null
    if [[ "$huuid" =~ ^$UUID_ANY$ ]]; then LIVE[$huuid]=1; else
      REFUSE="hibernated-unreadable: $hid is hibernated and its .uuid cannot be read, so its temp directory cannot be protected"
      return 1
    fi
  done
  if [ "$CLAUDE_N" -gt 0 ] && [ "$READABLE" -eq 0 ]; then
    REFUSE="no-sessions-dir: $CLAUDE_N claude process(es) running but not one sessions dir is readable (tried ${#CFGS[@]} config dir(s)) — refusing rather than treat every session as dead"
    return 1
  fi
  return 0
}
_ts_is_live() {   # rel
  local id
  for id in "${!LIVE[@]}"; do [[ "$1" == *"$id"* ]] && return 0; done
  return 1
}

# ── (b) in use ──────────────────────────────────────────────────────────────
# find's -lname is fnmatch without FNM_PATHNAME, so `*` spans `/`; a name
# carrying a glob metacharacter is escaped so it matches only itself.
_ts_glob_escape() { local s="$1"; s="${s//\\/\\\\}"; s="${s//\*/\\*}"; s="${s//\?/\\?}"; s="${s//\[/\\[}"; printf '%s' "$s"; }
ROOT_G="$(_ts_glob_escape "$ROOT")"
_ts_holder() {    # rel -> prints the first /proc link that points at or under it
  local g; g="$(_ts_glob_escape "$ROOT/$1")"
  find /proc/[0-9]*/cwd /proc/[0-9]*/fd -maxdepth 1 \
    \( -lname "$g" -o -lname "$g/*" -o -lname "$g (deleted)" \) -print -quit 2>/dev/null
}

# ── (c) recent ──────────────────────────────────────────────────────────────
_ts_age() {       # rel -> recent | unreadable | stale
  local out rc
  out="$(find "./$1" -xdev -mmin "-$MAX_MIN" -print -quit 2>/dev/null)"; rc=$?
  if [ -n "$out" ]; then echo recent
  elif [ "$rc" -ne 0 ]; then echo unreadable
  else echo stale
  fi
}

# ── the scan ────────────────────────────────────────────────────────────────
_ts_collect_live || _ts_die "$REFUSE"

UNITS=(); KINDS=(); PROJECTS=()
for e in ./*; do
  name="${e#./}"
  [ "$name" = .ccd-tmp-quarantine ] && continue   # the live arm's own (its deletion is its alone)
  is_proj=0
  if [ -d "$e" ] && [ ! -L "$e" ]; then
    for c in "$e"/*; do
      [[ "${c##*/}" =~ $UUID_RE ]] && [ -d "$c" ] && [ ! -L "$c" ] && { is_proj=1; break; }
    done
  fi
  if [ "$is_proj" -eq 1 ]; then
    PROJECTS+=("$name")
    for c in "$e"/*; do
      UNITS+=("$name/${c##*/}")
      if [[ "${c##*/}" =~ $UUID_RE ]]; then KINDS+=(session); else KINDS+=(loose); fi
    done
  else
    UNITS+=("$name"); KINDS+=(loose)
  fi
done

# Every process link into the root, taken once for the first cut; the
# per-unit re-check before removal asks /proc again.
declare -A INUSE=()
while IFS= read -r t; do
  rel="${t#"$ROOT"/}"; rel="${rel% (deleted)}"
  first="${rel%%/*}"; INUSE[$first]=1
  [[ "$rel" == */* ]] && { rest="${rel#*/}"; INUSE[$first/${rest%%/*}]=1; }
done < <(find /proc/[0-9]*/cwd /proc/[0-9]*/fd -maxdepth 1 -lname "$ROOT_G/*" -printf '%l\n' 2>/dev/null)

removed=0; rm_sessions=0; rm_loose=0; freed_kb=0
sk_live=0; sk_inuse=0; sk_recent=0; sk_unreadable=0; failed=0; aborted=""
declare -A TOUCHED=()
for i in "${!UNITS[@]}"; do
  rel="${UNITS[$i]}"; kind="${KINDS[$i]}"
  [ -e "./$rel" ] || [ -L "./$rel" ] || continue
  if _ts_is_live "$rel"; then sk_live=$((sk_live + 1)); continue; fi
  if [ -n "${INUSE[$rel]+x}" ]; then sk_inuse=$((sk_inuse + 1)); continue; fi
  case "$(_ts_age "$rel")" in
    recent) sk_recent=$((sk_recent + 1)); continue ;;
    unreadable) sk_unreadable=$((sk_unreadable + 1)); continue ;;
  esac
  kb=0; read -r kb _ < <(du -skx -- "./$rel" 2>/dev/null); [[ "$kb" =~ ^[0-9]+$ ]] || kb=0
  if [ "$DRY" -eq 1 ]; then
    echo "would-remove $kind ./$rel ${kb}K"
  else
    # THE RE-CHECK, all three, as late as they can be asked.
    _ts_collect_live || { aborted="$REFUSE"; break; }
    if _ts_is_live "$rel"; then sk_live=$((sk_live + 1)); continue; fi
    if [ -n "$(_ts_holder "$rel")" ]; then sk_inuse=$((sk_inuse + 1)); continue; fi
    case "$(_ts_age "$rel")" in
      recent) sk_recent=$((sk_recent + 1)); continue ;;
      unreadable) sk_unreadable=$((sk_unreadable + 1)); continue ;;
    esac
    if ! rm -rf --one-file-system -- "./$rel" 2>/dev/null; then
      failed=$((failed + 1)); continue
    fi
    [[ "$rel" == */* ]] && TOUCHED[${rel%%/*}]=1
  fi
  removed=$((removed + 1)); freed_kb=$((freed_kb + kb))
  if [ "$kind" = session ]; then rm_sessions=$((rm_sessions + 1)); else rm_loose=$((rm_loose + 1)); fi
done

# Project dirs this pass emptied. Only those it removed something from: an
# empty project dir it did not touch is either brand new (a session about to
# create its uuid child) or already a loose unit judged on its own mtime above.
rmdirs=0
if [ "$DRY" -eq 0 ]; then
  for p in "${!TOUCHED[@]}"; do
    rmdir -- "./$p" 2>/dev/null && rmdirs=$((rmdirs + 1))
  done
fi


# ── the live arm (see the header) ───────────────────────────────────────────
# The python is embedded so the sweep stays one installed file. It runs only when the dead pass
# finished (a refused or aborted pass leaves the live set unknown) and python3 exists; either way
# the dead pass's result stands.
read -r -d '' LIVE_PY <<'PYEOF'
# The live arm (spec 2.1, 2.1.1): one pass over the units today's pass called live. Everything it
# needs arrives in the environment; it reads the registry's *.uuid files and the previous census,
# and it is the census's only writer. A walk that cannot finish, a holder probe that cannot answer
# and a git question that cannot be asked all KEEP the candidate. NOW can be moved by a test.
import json, os, re, stat, subprocess, sys, time

E = os.environ
HOME = E['HOME']
WALL0 = time.time()
NOW = float(E.get('CCD_TMP_SWEEP_NOW') or WALL0)
DRY = E['TS_DRY'] == '1'
ARMED = E['TS_ARM'] == '1' and not DRY
def pair(k):
    """TS_* "normal pressure" seconds; each root picks by its own filesystem (spec 2.5.1)"""
    n, p = E[k].split()
    return (int(n), int(p))
AGE_UNTOUCHED = pair('TS_AGE_UNTOUCHED')
AGE_FLOOR = pair('TS_AGE_FLOOR')
GRACE_Q = pair('TS_GRACE_QUARANTINE')
GRACE_B = pair('TS_GRACE_BUDGET')
CADENCE = pair('TS_CADENCE')
BUDGET = int(E['TS_BUDGET_BYTES'])
TARGET = int(E['TS_TARGET_BYTES'])
REG = E['TS_REG']
CENSUS = E['TS_CENSUS']
CCD = E['TS_CCD']
MOUNTINFO = E.get('CCD_TMP_SWEEP_MOUNTINFO') or '/proc/self/mountinfo'
LIVE = set(x for x in E.get('TS_LIVE', '').split('\n') if x)
UUID_RE = re.compile(r'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')
QDIR = '.ccd-tmp-quarantine'
WALK_S = 30
WALK_ENTRIES = int(E.get('CCD_TMP_SWEEP_WALK_ENTRIES') or 2000000)
REPO_CAP = 50
MOVED_KEEP = 1000
MOVED_DAYS = 7
now_ms = int(NOW * 1000)
counts = {}
def bump(k, n=1): counts[k] = counts.get(k, 0) + n

def load_prev():
    try:
        with open(CENSUS) as f:
            d = json.load(f)
        return d if isinstance(d, dict) and d.get('v') == 1 else {}
    except (OSError, ValueError):
        return {}

JOURNAL = CENSUS + '.journal'
LIVE_BUDGET_S = 1800
prev = load_prev()
seq = prev.get('seq') if isinstance(prev.get('seq'), int) else 0
moved = [r for r in prev.get('moved', []) if isinstance(r, dict)]
# rows of a pass that moved entries but died before writing its census: fold them in, never lose a receipt
try:
    with open(JOURNAL) as f:
        for ln in f:
            try: jr = json.loads(ln)
            except ValueError: continue
            if isinstance(jr, dict) and isinstance(jr.get('seq'), int):
                moved.append(jr); seq = max(seq, jr['seq'])
except OSError:
    pass
# path -> [start, end] of the sweep's own git probe: atimes inside it are the probe's reads, not a touch
pprobed = prev.get('probed') if isinstance(prev.get('probed'), dict) else {}
probed = {}

def mount_noatime(path):
    best, opts = '', ''
    try:
        with open(MOUNTINFO) as f:
            for ln in f:
                p = ln.split(' ')
                if len(p) < 6: continue
                mp = re.sub(r'\\([0-7]{3})', lambda m: chr(int(m.group(1), 8)), p[4])
                if (path == mp or path.startswith(mp.rstrip('/') + '/')) and len(mp) >= len(best):
                    best, opts = mp, p[5]
    except OSError:
        return False
    return 'noatime' in opts.split(',')

def ccd_users(paths):
    """path -> nobody | held | unmeasured, from `ccd path-users --json`; a failure keeps everything."""
    out = {p: 'unmeasured' for p in paths}
    for i in range(0, len(paths), 400):
        chunk = paths[i:i + 400]
        try:
            r = subprocess.run([CCD, 'path-users', '--json'] + chunk, capture_output=True, text=True, timeout=180)
        except (OSError, subprocess.SubprocessError):
            continue
        if r.returncode != 0: continue
        for ln in r.stdout.splitlines():
            try:
                o = json.loads(ln)
            except ValueError:
                continue
            if isinstance(o, dict) and o.get('path') in out and o.get('verdict') in ('nobody', 'held', 'unmeasured'):
                out[o['path']] = o['verdict']
    return out

ENTRIES = [0]
def walk(path, noatime, ctr=None):
    """newest touch, apparent disk bytes, entry count and any repositories under path; ok=False keeps it.
    ctr is the entry counter the walk is charged to: the scan shares one per pass, each pre-move re-walk has its own."""
    ctr = ENTRIES if ctr is None else ctr
    win = pprobed.get(path)
    win = win if isinstance(win, list) and len(win) == 2 else None
    r = {'ok': True, 'why': '', 'newest': 0.0, 'bytes': 0, 'entries': 0, 'repos': [], 'reposTruncated': False}
    try:
        top = os.lstat(path)
    except OSError:
        r['ok'], r['why'] = False, 'gone'
        return r
    dev = top.st_dev
    t0 = time.monotonic()
    stack = [(path, top)]
    while stack:
        p, st = stack.pop()
        ctr[0] += 1
        r['entries'] += 1
        if time.monotonic() - t0 > WALK_S or ctr[0] > WALK_ENTRIES:
            r['ok'], r['why'] = False, 'bound'
            return r
        r['newest'] = max(r['newest'], st.st_mtime, st.st_ctime)
        if stat.S_ISREG(st.st_mode) and not noatime and not (win and win[0] <= st.st_atime <= win[1]):
            r['newest'] = max(r['newest'], st.st_atime)
        r['bytes'] += st.st_blocks * 512
        if not stat.S_ISDIR(st.st_mode) or st.st_dev != dev:
            continue
        try:
            with os.scandir(p) as it:
                kids = list(it)
        except OSError:
            r['ok'], r['why'] = False, 'unreadable'
            return r
        for k in kids:
            if k.name == '.git':
                if len(r['repos']) < REPO_CAP: r['repos'].append(p)
                else: r['reposTruncated'] = True
            try:
                stack.append((k.path, os.lstat(k.path)))
            except OSError:
                r['ok'], r['why'] = False, 'unreadable'
                return r
    return r

def unpushed(repos):
    """True when any repository holds work on no remote, or when that cannot be told."""
    env = {k: v for k, v in os.environ.items() if not k.startswith('GIT_')}
    for rp in repos:
        try:
            base = ['git', '--no-optional-locks', '-C', rp, '-c', 'core.fsmonitor=', '-c', 'safe.directory=*']
            s = subprocess.run(base + ['status', '--porcelain'], capture_output=True, text=True, timeout=30, env=env)
            c = subprocess.run(base + ['rev-list', '-n1', '--all', '--not', '--remotes'], capture_output=True, text=True, timeout=30, env=env)
        except (OSError, subprocess.SubprocessError):
            return True
        if s.returncode != 0 or c.returncode != 0 or s.stdout.strip() or c.stdout.strip():
            return True
    return False

def physical(rootphys, rel):
    return os.path.join(rootphys, rel)

# ── the quarantine's second half: deletion, a grace after the move and a fresh holder ask ──
roots = []
for ln in E.get('TS_ROOTS', '').split('\n'):
    f = ln.split('\t')
    if len(f) == 4: roots.append({'arm': f[0], 'path': f[1], 'literal': f[2], 'p': f[3] == '1'})
PRESSURE = any(r['p'] for r in roots)
def by_p(pr, p):
    return pr[1] if p else pr[0]
for r in roots:
    r['noatime'] = mount_noatime(r['path'])

def delete_quarantined():
    due = []
    for r in roots:
        q = os.path.join(r['path'], QDIR)
        if os.path.islink(q) or not os.path.isdir(q): continue
        try: qus = sorted(os.listdir(q))
        except OSError: continue
        for u in qus:
            ud = os.path.join(q, u)
            if os.path.islink(ud) or not os.path.isdir(ud): continue
            try: qes = sorted(os.listdir(ud))
            except OSError: continue
            for e in qes:
                m = re.match(r'^([0-9]+)\.', e)
                if not m: continue
                if NOW - int(m.group(1)) / 1e9 < by_p(GRACE_Q, r['p']): continue
                due.append(os.path.join(ud, e))
    if not due: return
    v = ccd_users(due)
    for p in due:
        if v.get(p) == 'held': bump('quarantineHeld'); continue
        if v.get(p) != 'nobody': bump('quarantineUnmeasured'); continue
        if subprocess.run(['rm', '-rf', '--one-file-system', '--', p], stderr=subprocess.DEVNULL).returncode == 0:
            bump('quarantineDeleted')
        else:
            bump('failed')
        try: os.rmdir(os.path.dirname(p))
        except OSError: pass

if ARMED: delete_quarantined()

# ── the scan: only the units today's pass called live ──
idof = {}
try:
    for n in os.listdir(REG):
        if n.endswith('.uuid') and not n.startswith('.'):
            try:
                with open(os.path.join(REG, n)) as f: u = f.read().strip()
            except OSError: continue
            if UUID_RE.match(u): idof[u] = n[:-5]
except OSError:
    pass

due = bool(PRESSURE) or prev.get('liveAt') is None or (NOW - prev['liveAt'] / 1000.0) >= by_p(CADENCE, PRESSURE)
sessions = {}
newrows = []
live_at = prev.get('liveAt') if not due else now_ms
if due:
    cands = []
    for r in roots:
        try: projs = sorted(os.listdir(r['path']))
        except OSError: continue
        for pj in projs:
            pd = os.path.join(r['path'], pj)
            if pj == QDIR or os.path.islink(pd) or not os.path.isdir(pd): continue
            try: pus = sorted(os.listdir(pd))
            except OSError: bump('unreadable'); continue
            for u in pus:
                ud = os.path.join(pd, u)
                if not UUID_RE.match(u) or u not in LIVE or os.path.islink(ud) or not os.path.isdir(ud): continue
                if u not in idof:
                    bump('liveUnmapped'); continue
                for sub in ('scratchpad', 'tasks'):
                    sd = os.path.join(ud, sub)
                    if os.path.islink(sd) or not os.path.isdir(sd): continue
                    try: names = sorted(os.listdir(sd))
                    except OSError: bump('unreadable'); continue
                    for nm in names:
                        cands.append({'root': r, 'uuid': u, 'id': idof[u], 'unit': pj + '/' + u, 'sub': sub, 'name': nm,
                                      'path': os.path.join(sd, nm)})
    for c in cands:
        w = walk(c['path'], c['root']['noatime'])
        c.update(w)
        if not w['ok']: bump('unmeasured')
        c['age'] = NOW - w['newest'] if w['ok'] else 0
        c['au'] = by_p(AGE_UNTOUCHED, c['root']['p'])
        c['af'] = by_p(AGE_FLOOR, c['root']['p'])
    # one holder walk for every candidate old enough for either rule (the budget's floor is the lower of the two)
    def spellings(c):
        ph = os.path.join(os.path.realpath(os.path.dirname(c['path'])), c['name'])
        lit = os.path.join(c['root']['literal'], c['unit'], c['sub'], c['name'])
        return list(dict.fromkeys([ph, lit]))
    ask = [p for c in cands if c['ok'] and c['age'] >= min(c['af'], c['au']) for p in spellings(c)]
    verdict = ccd_users(list(dict.fromkeys(ask))) if ask else {}
    def held_of(c):
        vs = [verdict.get(p, 'unmeasured') for p in spellings(c)]
        return 'held' if 'held' in vs else 'unmeasured' if 'unmeasured' in vs else 'nobody'

    def quarantine(c):
        r = c['root']
        q = os.path.join(r['path'], QDIR)
        if os.path.islink(q): return None
        os.makedirs(q, mode=0o700, exist_ok=True)
        if not os.path.isdir(q) or os.path.islink(q) or os.stat(q).st_uid != os.getuid(): return None
        ud = os.path.join(q, c['uuid'])
        os.makedirs(ud, mode=0o700, exist_ok=True)
        ns = int(NOW * 1e9)
        while True:
            dst = os.path.join(ud, '%d.%s' % (ns, c['name']))
            if not os.path.lexists(dst): break
            ns += 1
        os.rename(c['path'], dst)
        return dst

    def act(c, kind):
        """Move c (or record that it would move). The last look is taken here, as late as it can be."""
        global seq
        shadow = not ARMED
        dst = None
        if ARMED and time.time() - WALL0 > LIVE_BUDGET_S:
            bump('timeBudget'); return False
        if ARMED:
            w = walk(c['path'], c['root']['noatime'], [0])
            need = c['au'] if kind == 'scratch' else c['af']
            if not w['ok']:
                bump('unmeasured'); c['fail'] = 'unmeasured'; return False
            if NOW - w['newest'] < need:
                bump('recent'); return False
            if any(v != 'nobody' for v in ccd_users(spellings(c)).values()):
                bump('held'); return False
        if kind == 'budget':
            # the git question goes last, after every look that reads the tree, because asking it reads files too
            # the window is the probe's own wall-clock span on the sweep's clock, not the pass's start
            t0 = time.time()
            bad = c.get('reposTruncated') or unpushed(c['repos'])
            probed[c['path']] = [NOW + (t0 - WALL0) - 1, NOW + (time.time() - WALL0) + 1]
            if bad:
                bump('gitKept'); c['fail'] = 'git-work-unrescued'; return False
        if ARMED:
            try:
                dst = quarantine(c)
            except OSError:
                dst = None
            if dst is None:
                bump('failed'); return False
        seq += 1
        row = {'seq': seq, 'id': c['id'], 'uuid': c['uuid'], 'name': c['name'], 'kind': kind, 'bytes': c['bytes'],
               'at': now_ms, 'shadow': shadow, 'quarantine': dst,
               'from': c['unit'] + '/' + c['sub'] + '/' + c['name'], 'root': c['root']['path']}
        newrows.append(row)
        if ARMED and not DRY:
            try:
                with open(JOURNAL, 'a') as jf:
                    jf.write(json.dumps(row) + '\n'); jf.flush(); os.fsync(jf.fileno())
            except OSError: pass
        # shadow: the entry stays on disk and in every measure; wouldGo only feeds the simulation
        c['gone' if ARMED else 'wouldGo'] = True
        bump('moved' if ARMED else 'wouldMove')
        return True

    # the age rule goes first, so the budget counts what it left
    for c in cands:
        if c['ok'] and c['age'] >= c['au'] and held_of(c) == 'nobody':
            act(c, 'scratch')
        elif c['ok'] and c['age'] >= c['au']:
            bump('held' if held_of(c) == 'held' else 'holdersUnmeasured')
    by = {}
    for c in cands: by.setdefault(c['uuid'], []).append(c)
    pb = {s.get('uuid'): s.get('budget') for s in prev.get('sessions', []) if isinstance(s, dict) and isinstance(s.get('budget'), dict)}
    for u, cs in by.items():
        counted = sum(c['bytes'] for c in cs if not c.get('gone'))
        sp = any(c['root']['p'] for c in cs)
        # shadow only: the would-remove simulation runs on its own counter; what is measured is what is on disk
        sim = counted - sum(c['bytes'] for c in cs if c.get('wouldGo') and not c.get('gone'))
        b = dict(pb.get(u) or {})
        over_since = b.get('overSince'); enforce_at = b.get('enforceAt'); removed = b.get('removedBytes', 0) or 0
        kept = []
        state = 'ok'
        if over_since is not None and counted < TARGET:
            over_since = enforce_at = None
        elif over_since is None and counted > BUDGET:
            over_since = now_ms
            enforce_at = now_ms if sp else now_ms + by_p(GRACE_B, False) * 1000
            removed = 0
        elif over_since is not None and sp:
            enforce_at = min(enforce_at, now_ms)
        if over_since is not None:
            state = 'over'
            if now_ms >= enforce_at and counted > BUDGET:
                for c in sorted((x for x in cs if not x.get('gone') and not x.get('wouldGo')), key=lambda x: (x['newest'], x['name'])):
                    if (counted if ARMED else sim) <= TARGET: break
                    why = None
                    if not c['ok']: why = 'unmeasured'
                    elif c['age'] < c['af']: why = 'touched-within-48h'
                    elif held_of(c) != 'nobody': why = 'held' if held_of(c) == 'held' else 'holder-unmeasured'
                    if why:
                        kept.append({'name': c['name'], 'why': why}); continue
                    if act(c, 'budget'):
                        if ARMED: counted -= c['bytes']; removed += c['bytes']
                        else: sim -= c['bytes']
                    else:
                        kept.append({'name': c['name'], 'why': c.get('fail') or 'move-failed'})
                state = ('over-unremovable' if counted > TARGET and kept else 'enforced') if ARMED else 'over'
        sessions[u] = {'id': cs[0]['id'], 'uuid': u, 'bytes': counted,
                       'scratchBytes': sum(c['bytes'] for c in cs if c['sub'] == 'scratchpad' and not c.get('gone')),
                       'tasksBytes': sum(c['bytes'] for c in cs if c['sub'] == 'tasks' and not c.get('gone')),
                       'entries': sum(1 for c in cs if not c.get('gone')),
                       'budget': {'state': state, 'overSince': over_since, 'enforceAt': enforce_at,
                                  'removedBytes': removed, 'kept': kept}}
    bump('candidates', len(cands))
else:
    for s in prev.get('sessions', []):
        if isinstance(s, dict) and s.get('uuid'): sessions[s['uuid']] = s

moved = [r for r in moved + newrows if now_ms - r.get('at', 0) <= MOVED_DAYS * 86400 * 1000][-MOVED_KEEP:]
for k, v in pprobed.items():
    if k not in probed and isinstance(v, list) and os.path.lexists(k): probed[k] = v
out = {'v': 1, 'at': now_ms, 'liveAt': live_at, 'pressure': PRESSURE, 'arm': 'live' if ARMED else 'shadow', 'seq': seq,
       'roots': [{'arm': r['arm'], 'path': r['path'], 'noatime': r['noatime']} for r in roots],
       'probed': probed, 'sessions': sorted(sessions.values(), key=lambda s: -s['bytes']), 'moved': moved, 'counts': counts}
if not DRY:
    tmp = '%s.%d.tmp' % (CENSUS, os.getpid())
    try:
        with open(tmp, 'w') as f: json.dump(out, f)
        os.rename(tmp, CENSUS)
        try: os.unlink(JOURNAL)
        except OSError: pass
    except OSError as e:
        print('tmp-sweep: census not written: %s' % e, file=sys.stderr)
        try: os.unlink(tmp)
        except OSError: pass
for r in newrows:
    print('%s %s ./%s %dK' % ('would-move' if r['shadow'] else 'moved', r['kind'], r['from'], r['bytes'] // 1024))
print('live arm (%s): %s' % (out['arm'], ', '.join('%s %d' % (k, v) for k, v in sorted(counts.items())) or 'nothing to do'))
PYEOF
live_line=""
if [ -z "$aborted" ] && [ -n "$LIVE_ROOTS" ]; then
  if ! command -v python3 >/dev/null 2>&1; then
    echo "tmp-sweep: live arm skipped: python3 is not installed" >&2
  elif ! _ts_collect_live; then
    echo "tmp-sweep: live arm skipped: $REFUSE" >&2
  else
    live_uuids=""; for _u in "${!LIVE[@]}"; do [[ "$_u" =~ ^$UUID_ANY$ ]] && live_uuids+="$_u"$'\n'; done
    arm=0; [ -e "$LIVE_ARM" ] && arm=1
    out="$(TS_ROOTS="${LIVE_ROOTS%$'\n'}" TS_LIVE="$live_uuids" TS_DRY="$DRY" TS_ARM="$arm" \
      TS_AGE_UNTOUCHED="$TS_AGES_LIVE_UNTOUCHED" TS_AGE_FLOOR="$TS_AGES_BUDGET_UNTOUCHED_FLOOR" \
      TS_GRACE_QUARANTINE="$TS_AGES_QUARANTINE_GRACE" TS_GRACE_BUDGET="$TS_AGES_BUDGET_GRACE" \
      TS_CADENCE="$TS_AGES_LIVE_CADENCE" TS_BUDGET_BYTES=$((CCD_TMP_BUDGET_GB * CCD_TMP_BUDGET_UNIT_BYTES)) \
      TS_TARGET_BYTES=$((CCD_TMP_BUDGET_TARGET_GB * CCD_TMP_BUDGET_UNIT_BYTES)) TS_REG="$HOME/.cc-sessions" \
      TS_CENSUS="$CENSUS" TS_CCD="${CCD_TMP_SWEEP_CCD:-$HOME/.local/bin/ccd}" python3 -I -c "$LIVE_PY" 9>&-)" \
      || echo "tmp-sweep: live arm failed; the dead pass stands" >&2
    [ -n "$out" ] && live_line="${out##*$'\n'}"
    [ -n "$out" ] && [[ "$out" == *$'\n'* ]] && printf '%s\n' "${out%$'\n'*}"
  fi
fi

verb="removed"; [ "$DRY" -eq 1 ] && verb="dry run: would remove"
echo "tmp-sweep: $verb $removed unit(s) ($rm_sessions session dir(s), $rm_loose loose), freed $((freed_kb / 1024)) MB; skipped $sk_live live, $sk_inuse in-use, $sk_recent recent, $sk_unreadable unreadable; $rmdirs empty project dir(s) removed; $failed failed; max age ${CCD_TMP_SWEEP_MAX_AGE_DAYS}d; root $ROOT${live_line:+; $live_line}"
if [ -n "$aborted" ]; then
  _ts_die "pass aborted mid-way — $aborted"
fi
exit 0
