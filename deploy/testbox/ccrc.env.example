# The test box's settings (D-7403, D-7451): a copy of this file is the box's
# ONE config file, /etc/ccrc-testbox/ccrc.env.
#
# Owner root, group the service user's (CCRC_TESTBOX_SERVICE_USER), mode 0640:
# the service reads it and the run users cannot. A file that is not a regular
# file, is a symlink, is not owned by root, or is writable by group or other is
# refused, and every setting below then keeps its default. It holds no secret.
# The operator writes it before the first install; the installer sets its group
# and mode and never writes a value into it. A change takes effect when the
# installer is re-run with the installed tag.
#
# Read through ccrc's one reader (`_testbox_knobs box`, ccd/testbox-knobs) from
# this file alone: never from any user's ~/.ccrc/ccrc.env, never from the
# environment, and never sourced. Write each as a plain KEY=value line, and
# double-quote a value holding a space, a `~` or a `*`. A value that is not its
# shape keeps its default and is reported with the key, the value and this
# file. A leading `~/` is the service user's home. None of the defaults is a
# measurement of any box.
#
# The fleet host's test box settings live in its ~/.ccrc/ccrc.env
# (deploy/ccrc.env.example, "test box (fleet host)").
#
# The .../releases root the tools sync downloads from (D-7457), the one ccrc
# setting this box reads. Default: the GitHub releases of the owner/repo pair
# in the installed tree's ccd/ccrc.
# CCRC_RELEASE_BASE_URL=
#
# Runs at once, a pristine build counting as one. Default 2; a whole number
# from 1 to 99.
# CCRC_TESTBOX_RUNS=2
#
# Vitest workers per run, always set by the runner. Default 2; a whole number
# from 1 to 99.
# CCRC_TESTBOX_WORKERS=2
#
# The run's TMPDIR, inside the unit's private /tmp; never longer than a fleet
# session's. Default /tmp/r; an absolute path.
# CCRC_TESTBOX_RUN_TMPDIR=/tmp/r
#
# Per-run MemoryMax. Default 4G; a whole number with a K, M or G suffix.
# CCRC_TESTBOX_RUN_MEMORY_MAX=4G
#
# Per-run MemorySwapMax. Default 1G; a size as above.
# CCRC_TESTBOX_RUN_SWAP_MAX=1G
#
# Per-run CPU quota. Default 200%; a whole percentage.
# CCRC_TESTBOX_RUN_CPU_QUOTA=200%
#
# Mirrors, run directories, pristine installs and logs, on an XFS filesystem
# with reflink=1. Default ~/.ccrc/testbox.
# CCRC_TESTBOX_ROOT="~/.ccrc/testbox"
#
# The repository table, one JSON file per repository. Default
# ~/.ccrc/testbox-repos.d.
# CCRC_TESTBOX_REPOS="~/.ccrc/testbox-repos.d"
#
# The mirror fetch timer. Default 5m; a whole number with an s, m, h or d
# suffix.
# CCRC_TESTBOX_FETCH_EVERY=5m
#
# How long results, logs and refs are kept. Default 24h; a duration.
# CCRC_TESTBOX_RETENTION=24h
#
# A pristine install unused this long is deleted. Default 7d; a duration.
# CCRC_TESTBOX_PRISTINE_KEEP=7d
#
# The delays between attempts of a failed pristine build or tool sync, the
# last repeating. Default 2m 10m 1h 1d; a list of durations.
# CCRC_TESTBOX_PRISTINE_RETRY="2m 10m 1h 1d"
#
# The largest reporter file the cleanup collects. Default 16M; a size.
# CCRC_TESTBOX_REPORT_MAX=16M
#
# The synced tools, root's, with `current` naming the set in use. Default
# /opt/ccrc-testbox/tools; an absolute path.
# CCRC_TESTBOX_TOOLS_DIR=/opt/ccrc-testbox/tools
#
# The OS package mirror. Default unset: the distribution's own.
# CCRC_TESTBOX_OS_MIRROR=
#
# The egress allowlist by host name. Default github.com nodejs.org
# storage.googleapis.com; the registry upstream, the release host and the OS
# mirror are added from their own settings. A list of host names.
# CCRC_TESTBOX_EGRESS_ALLOW="github.com nodejs.org storage.googleapis.com"
#
# The push user. Default ccrc-tb-push; a user name.
# CCRC_TESTBOX_PUSH_USER=ccrc-tb-push
#
# The environment names a run may be given; a ref-valued name is resolved to a
# sha and pushed. Default CCRC_HISTORY_BASE CCRC_LEDGER_BASE; a list of names.
# CCRC_TESTBOX_ENV_FORWARD="CCRC_HISTORY_BASE CCRC_LEDGER_BASE"
#
# Concurrent run k runs as <prefix><k>. Default ccrc-tb-; a user name prefix.
# CCRC_TESTBOX_RUN_USER_PREFIX=ccrc-tb-
#
# The registry proxy's own loopback address, reachable from the prepare and
# install units only. Default 127.0.0.2:4873; host:port.
# CCRC_TESTBOX_REGISTRY_PROXY=127.0.0.2:4873
#
# The proxy's upstream. Default https://registry.npmjs.org; a URL.
# CCRC_TESTBOX_REGISTRY_UPSTREAM=https://registry.npmjs.org
#
# on mounts the units' /tmp as a tmpfs instead of PrivateTmp. Default off; on
# or off.
# CCRC_TESTBOX_TMPFS=off
#
# The log lines a failed run's answer carries. Default 40; a whole number from
# 1 to 99.
# CCRC_TESTBOX_LOG_TAIL=40
#
# Runs at once for one session (D-7420). Default 1; a whole number from 1 to
# 99.
# CCRC_TESTBOX_SESSION_RUNS=1
#
# The test service's user (D-7426). Default ccrc-tb-svc; a user name.
# CCRC_TESTBOX_SERVICE_USER=ccrc-tb-svc
#
# The test service's listen address, the tailnet address (D-7501). Default
# unset: a box without it refuses to start. host:port.
# CCRC_TESTBOX_LISTEN=
#
# The service user's bearer token file, mode 0600 (D-7501). Default
# ~/.ccrc/testbox-service.token.
# CCRC_TESTBOX_SERVICE_TOKEN_FILE="~/.ccrc/testbox-service.token"
#
# The longest a prepare, run, clean or install unit may run (D-7501). Default
# 1h; a duration.
# CCRC_TESTBOX_UNIT_MAX=1h
