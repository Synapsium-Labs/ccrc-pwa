#!/usr/bin/env bash
# The test box's install unit's privileged first step, `ExecStartPre=+install-pre <spec file>` (D-7407, D-7543; plan
# docs/superpowers/plans/2026-10-29-test-box.md, Task TB5; spec §2.2 "Pristine installs").
#
# `install/` is root's and the unit writes only `install/run`: this refuses to start when `run` already exists (in any
# form, a link included), and otherwise creates it fresh, with `home/` and `build/`, and lays the key's install inputs
# out in `build/` at their relative paths, all owned by the install user, mode 0700. So the build sees the lockfile
# alone, never a checkout. First it removes the doomed pristine installs the spec names (`Z`), each a key directory
# directly under `pristine/`, so a key the service deleted from its store goes with no other privileged step. The
# main step is `runner <spec file>` (`npm ci` in `build/<package>`), the last is `install-post`.
# It reads no config file and no test box variable; every value comes from the spec the service wrote.
set -euo pipefail

die() { printf 'ccrc-testbox-install-pre: %s\n' "$*" >&2; exit 1; }

[ "$#" -eq 1 ] || die "usage: install-pre <spec file>"
spec=$1
[ -f "$spec" ] && [ ! -L "$spec" ] || die "no spec file: $spec"

header=
run=
user=
pkg=
paths=()
bodies=()
doomed=()
while IFS= read -r -d '' rec; do
  if [ -z "$header" ]; then
    [ "$rec" = ccrc-testbox-spec ] || die "not a test box spec: $spec"
    header=1
    continue
  fi
  case $rec in
    D*) run=${rec:1} ;;
    U*) user=${rec:1} ;;
    P*) pkg=${rec:1} ;;
    T*) paths+=("${rec:1}") ;;
    V*) bodies+=("${rec:1}") ;;
    Z*) doomed+=("${rec:1}") ;;
    *) ;;
  esac
done < "$spec"

[ -n "$run" ] && [ -n "$user" ] && [ -n "$pkg" ] || die "the spec names no run directory, install user or package"
case $run in /*/install/run) ;; *) die "not the install directory: $run" ;; esac
case $user in *[!a-z0-9_-]*|'') die "not an install user: $user" ;; esac
case $pkg in *[!A-Za-z0-9._-]*|''|.|..) die "not a package: $pkg" ;; esac
[ "${#paths[@]}" -gt 0 ] && [ "${#paths[@]}" -eq "${#bodies[@]}" ] || die "the spec's install inputs do not pair up"
slot=${run%/run}
root=${slot%/install}
[ -d "$slot" ] && [ ! -L "$slot" ] || die "no install slot: $slot"

# The doomed keys: a 64-hex name directly under pristine/, never followed through a link.
for k in ${doomed[@]+"${doomed[@]}"}; do
  [[ $k =~ ^[0-9a-f]{64}$ ]] || die "not an install key: $k"
  d=$root/pristine/$k
  if [ -L "$d" ]; then rm -f -- "$d"; elif [ -e "$d" ]; then rm -rf -- "$d"; fi
done

if [ -e "$run" ] || [ -L "$run" ]; then die "the install directory already exists: $run"; fi
mkdir -m 0700 -- "$run" "$run/home" "$run/build"
for i in "${!paths[@]}"; do
  p=${paths[$i]}
  case /$p/ in */../*|*/./*|*//*) die "not a relative path: $p" ;; esac
  case $p in /*|'') die "not a relative path: $p" ;; esac
  (umask 077 && mkdir -p -- "$(dirname -- "$run/build/$p")")
  printf '%s' "${bodies[$i]}" | base64 -d > "$run/build/$p" 2>/dev/null || printf '%s' "${bodies[$i]}" | base64 -D > "$run/build/$p"
done
[ -d "$run/build/$pkg" ] || die "no input lies in the package's directory: $pkg"
chown -R -- "$user" "$run"
