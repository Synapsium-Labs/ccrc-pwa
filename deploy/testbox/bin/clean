#!/usr/bin/env bash
# The test box's clean units' fixed ExecStart, `clean <spec file>`, as root, outside the run's sandbox and after it
# (D-7406, D-7501; plan docs/superpowers/plans/2026-10-29-test-box.md, Task TB4; spec §2.2 "Results leave the
# directory first", "Cleanup").
#
# 1. The report: `run/report.json` is copied to `results/<run-id>/report.json` only as a regular file (a link, a FIFO
#    or a directory is `not-regular`, and is never opened) of at most the cap the spec names (`oversized`); an absent
#    one is `missing`. The word goes to `results/<run-id>/report.status` (D-7501), and both are the service user's.
# 2. The run directory, removed whole on its own filesystem: `rm -rf --one-file-system` (BSD `rm -x` on a developer
#    machine). A directory the run left without owner write or search is opened up first, so nothing the run left,
#    in any mode, survives; links are never followed. The script fails when the directory is still there.
# It reads no config file and no test box variable; every value comes from the spec the service wrote.
set -euo pipefail

die() { printf 'ccrc-testbox-clean: %s\n' "$*" >&2; exit 1; }

[ "$#" -eq 1 ] || die "usage: clean <spec file>"
spec=$1
[ -f "$spec" ] && [ ! -L "$spec" ] || die "no spec file: $spec"

header=
run=
results=
cap=
owner=
while IFS= read -r -d '' rec; do
  if [ -z "$header" ]; then
    [ "$rec" = ccrc-testbox-spec ] || die "not a test box spec: $spec"
    header=1
    continue
  fi
  case $rec in
    D*) run=${rec:1} ;;
    O*) results=${rec:1} ;;
    M*) cap=${rec:1} ;;
    S*) owner=${rec:1} ;;
    *) ;;
  esac
done < "$spec"

[ -n "$run" ] && [ -n "$results" ] && [ -n "$cap" ] && [ -n "$owner" ] || die "the spec names no run directory, results directory, cap or owner"
case $run in /*/run) ;; *) die "not a run directory: $run" ;; esac
case $results in /*) ;; *) die "not a results directory: $results" ;; esac
case $cap in *[!0-9]*|'') die "not a byte count: $cap" ;; esac
case $owner in *[!a-z0-9_-]*|'') die "not a user: $owner" ;; esac

inode() { if stat -c %i -- "$1" >/dev/null 2>&1; then stat -c %i -- "$1"; else stat -f %i -- "$1"; fi; }
fd_inode() { if stat -L -c %i "/dev/fd/$1" >/dev/null 2>&1; then stat -L -c %i "/dev/fd/$1"; else stat -L -f %i "/dev/fd/$1"; fi; }

# ── 1. the report ──────────────────────────────────────────────────────────
mkdir -p -- "$results"
report=$run/report.json
word=ok
if [ -L "$report" ]; then
  word=not-regular
elif [ ! -e "$report" ]; then
  word=missing
elif [ ! -f "$report" ]; then
  word=not-regular
else
  exec 3< "$report"
  # The descriptor must be the regular file the path names now: a swap between the check and the open is refused.
  if [ -L "$report" ] || [ "$(fd_inode 3)" != "$(inode "$report")" ]; then
    word=not-regular
  else
    tmp=$results/report.json.tmp
    head -c "$((cap + 1))" <&3 > "$tmp"
    size=$(wc -c < "$tmp" | tr -d ' ')
    if [ "$size" -gt "$cap" ]; then word=oversized; rm -f -- "$tmp"; else mv -f -- "$tmp" "$results/report.json"; fi
  fi
  exec 3<&-
fi
printf '%s\n' "$word" > "$results/report.status"
chown -- "$owner" "$results" "$results/report.status"
[ ! -f "$results/report.json" ] || chown -- "$owner" "$results/report.json"

# ── 2. the run directory ───────────────────────────────────────────────────
if [ -e "$run" ] || [ -L "$run" ]; then
  if [ -d "$run" ] && [ ! -L "$run" ]; then
    find "$run" -xdev -type d \( ! -perm -u+w -o ! -perm -u+x -o ! -perm -u+r \) -exec chmod u+rwx {} \;
  fi
  if [ "$(uname -s)" = Darwin ]; then rm -rf -x -- "$run"; else rm -rf --one-file-system -- "$run"; fi
fi
if [ -e "$run" ] || [ -L "$run" ]; then die "the run directory is still there: $run"; fi
