# ccclip — the Mac-side clipboard hotkey. Copy to ~/.ccrc/ccclip.env ON THE MAC
# (not on a fleet box) and fill in your own three values.
#
# ccclip carries no default box, deliberately: the three literals that used to
# live in the script were one operator's fleet, and a shipped tool that
# remembers somebody else's machine is a tool that quietly tries to reach it.
#
# Read the way every ~/.ccrc file is read — grepped, never sourced, last
# assignment wins, comments ignored. Surrounding quotes are stripped and
# leading indentation is tolerated, so all of these mean the same thing:
#     BOX=you@host
#     BOX="you@host"
#       BOX=you@host

# The box ccclip ships the image to — anything ssh accepts.
BOX=you@198.51.100.7

# The ssh key for that box, on THIS machine. A path with spaces is fine.
SSH_KEY=/Users/you/.ssh/id_ed25519

# Where `ccd` lives ON THE BOX. `ccclip` runs `<CCD> clip <path>` there.
CCD=/home/you/.local/bin/ccd
