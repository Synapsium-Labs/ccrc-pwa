# ccrc server env — remote-fleet-mode config, shipped to ~/.ccrc/ccrc.env on
# the ccrc box (server-box) by `deploy.sh`. Local mode (the current default)
# needs none of this; these only matter once CCRC_FLEET=remote and
# ccrc.service is wired to source this file (a cutover step, not yet done —
# see README "Remote fleet mode").
#
# Copy to `infra/ccrc/deploy/ccrc.env` locally (gitignored — never commit the
# real file) and `bash infra/ccrc/deploy/deploy.sh` ships it.

# 'local' (default) drives the fleet on this box directly via node:fs/exec.
# 'remote' drives it through ccrc-agent over CCRC_AGENT_URL instead.
CCRC_FLEET=local

# ws:// or wss:// URL of the ccrc-agent WS endpoint on the fleet host,
# e.g. ws://100.x.x.x:7789
CCRC_AGENT_URL=

# Must match the fleet host's CCRC_AGENT_TOKEN (see ccrc-agent.env.example).
CCRC_AGENT_TOKEN=

# Hetzner Cloud API token — used only for the degraded-mode fleet-host reboot
# action (POST /api/fleet/reboot). Omit to leave that route disabled (501).
CCRC_HETZNER_TOKEN=

# Hetzner Cloud server ID of the fleet host — used only for the reboot action.
CCRC_FLEET_SERVER_ID=
