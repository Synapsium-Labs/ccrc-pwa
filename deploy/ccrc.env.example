# ccrc server env — the ONE machine-config file for the server box, installed
# at ~/.ccrc/ccrc.env and read by ccrc.service (EnvironmentFile). Absent file
# = local mode on loopback defaults; every value here overrides a default in
# server/src/config.ts.
#
# Copy to `deploy/ccrc.env` locally (gitignored — never commit the real file)
# and `bash deploy/deploy.sh` ships it.

# Bind address + port. The default (127.0.0.1:7788) is loopback-only — set
# CCRC_HOST only when something in front (tailscale serve, a reverse proxy)
# targets a specific interface. NOTE: tailscale serve on the current box
# proxies to 203.0.113.7:7788 LITERALLY, so that box must keep CCRC_HOST in
# sync with the serve config.
CCRC_HOST=127.0.0.1
CCRC_PORT=7788

# 'local' (default) drives the fleet on this box directly via node:fs/exec.
# 'remote' drives it through ccrc-agent over CCRC_AGENT_URL instead.
CCRC_FLEET=local

# ws:// or wss:// URL of the ccrc-agent WS endpoint on the fleet host,
# INCLUDING the /agent path, e.g. ws://100.x.x.x:7789/agent
CCRC_AGENT_URL=

# Must match the fleet host's CCRC_AGENT_TOKEN (see ccrc-agent.env.example).
CCRC_AGENT_TOKEN=

# Where project checkouts live on THIS box (local mode reads them directly).
# Default if unset: $HOME/projects (server/src/config.ts).
CCRC_PROJECTS_ROOT=

# The account roster the server boots against. Default if unset (or, as here,
# written as a bare `KEY=` line): ~/.ccrc/accounts.json — which is USER-OWNED
# config the deploy seeds once and never overwrites. There is NO built-in
# roster: loadConfig REFUSES TO BOOT when this file is missing, unreadable or
# invalid, rather than run the fleet against a roster that is not the box's.
# Point this elsewhere only to run against an alternate roster (a staging
# fleet, a bisect); ccd has no equivalent override by design.
CCRC_ACCOUNTS=

# Web-push (VAPID) keys — REQUIRED for push notifications; without them the
# push service is disabled. Generate a pair with:
#   npx web-push generate-vapid-keys
# These were live, undocumented config until the 2026-08-11 stage-1 cutover.
CCRC_VAPID_PUBLIC=
CCRC_VAPID_PRIVATE=
CCRC_VAPID_SUBJECT=

# Hetzner Cloud API token — used only for the degraded-mode fleet-host reboot
# action (POST /api/fleet/reboot). Omit to leave that route disabled (501).
CCRC_HETZNER_TOKEN=

# Hetzner Cloud server ID of the fleet host — used only for the reboot action.
CCRC_FLEET_SERVER_ID=

# ── THE PWA SESSION GATE (stage 3a) — OFF BY DEFAULT ─────────────────────
#
# With CCRC_AUTH unset (or anything other than the exact string `on`) the gate
# is a passthrough: this box behaves exactly as it did before the gate shipped,
# and anyone who can reach it can drive it. That is the shipped default.
#
# READ THE FIRST THREE KEYS BELOW AS ONE EDIT. Arming CCRC_AUTH without CCRC_RP_ID
# and CCRC_ORIGIN leaves the box reachable but unusable — see the warning under
# CCRC_ORIGIN — and NOTHING WARNS YOU AT BOOT. The full arming sequence is in
# the runbook (docs/superpowers/specs/2026-08-19-stage2-vm-gate-runbook.md,
# step 10); `ccrc doctor`'s `auth` check reports where this box actually stands.
#
# Two worked triples, so the shape is not left to inference:
#
#   the reference fleet, reached at https://server-box.tailnet-example.ts.net:8443/
#     CCRC_AUTH=on
#     CCRC_RP_ID=tailnet-example.ts.net          <- the REGISTRABLE domain, not the host
#     CCRC_ORIGIN=https://server-box.tailnet-example.ts.net:8443
#
#   a localhost dev box on the default port
#     CCRC_AUTH=on
#     CCRC_RP_ID=localhost
#     CCRC_ORIGIN=http://localhost:7788
#     CCRC_COOKIE_INSECURE=on               <- only here; see that key below

# Arms the gate. ONLY the exact string `on` arms it — `1`, `true`, `yes`, `ON`,
# a bare `CCRC_AUTH=` line and an unset variable are all OFF. That polarity is
# deliberate and it is the safe one for THIS key: an operator who meant to arm
# the gate and typed `1` finds an open box and says so out loud, where
# anything-but-off would take a box off the air on a typo in a file nobody
# re-reads.
#
# A PASSPHRASE ON ITS OWN CHANGES NOTHING, and neither does this flag on its
# own. `ccrc passwd` writes the passphrase; this arms the gate that reads it.
# Armed with no passphrase file, every route answers 401 `unconfigured` and
# nobody can log in (the server prints one journal line saying so at boot).
CCRC_AUTH=

# THE WEBAUTHN RELYING-PARTY ID — the domain a passkey is scoped to. Default if
# unset: `localhost`.
#
# ⚠ IT IS NOT PORTABLE, AND IT IS NEVER DERIVED. It must be the REGISTRABLE
# DOMAIN this box is reached at — `tailnet-example.ts.net` for the reference fleet,
# `<name>.duckdns.org` for a DuckDNS box — with no scheme, no port, no path.
#   - NEVER a bare public suffix. `ts.net` and `duckdns.org` are both on the
#     Public Suffix List; scoping a credential to one would cover every tenant
#     on it, and browsers refuse it. The server catches a short list of the
#     traps this deployment can actually hit (webauthn.ts's
#     PUBLIC_SUFFIX_TRAPS) — that list is NOT a PSL and must not become one.
#   - NEVER AN IP ADDRESS. WebAuthn requires a domain, and a browser refuses to
#     scope a credential to an address literal — so `CCRC_RP_ID=127.0.0.1` (the
#     obvious way to "fix" an IP origin) is refused at boot. Reach the box by a
#     name, and put that same name in CCRC_ORIGIN.
#   - NEVER derived by stripping labels off the hostname. Stripping ONE label
#     off `server-box.tailnet-example.ts.net` gives the right answer; stripping TWO
#     gives `ts.net`. Nothing on this box can know which without a copy of the
#     PSL, which is why the operator states it.
#   - A CREDENTIAL RECORDS THE rpId IT WAS ENROLLED UNDER. Change this value on
#     a box that already has passkeys and those keys stop working, loudly
#     ("enrolled for <old> — re-enrol"), not silently. That is the intended
#     behaviour, and it is why a passkey enrolled against `localhost` does not
#     survive the box getting a real name.
# A value that is malformed, or that DISAGREES with CCRC_ORIGIN, is caught at
# boot: the server warns, the passkey routes answer 501, and the passphrase
# login keeps working. What is NOT caught is the pair being coherent and simply
# not this box's name — see the warning under CCRC_ORIGIN.
CCRC_RP_ID=

# THE FULL ORIGIN a browser must be at — scheme, host and port, serialized
# exactly as a browser sends it: `https://host` or `https://host:port`, NO
# trailing slash and no path. Default if unset: `http://localhost:<CCRC_PORT>`,
# built from the port above so the two cannot drift.
#
# ⚠ SET THIS IN THE SAME EDIT THAT ARMS CCRC_AUTH. It is checked on every
# `/ws/*` upgrade and every non-exempt write, not only on passkey ceremonies:
# `ts.net` is a public suffix, so every node on one tailnet is SAME-SITE with
# every other and `SameSite=Lax` alone does not stop a cross-site POST. Left at
# the localhost default on an armed box that is actually reached over the
# tailnet, every socket and every write is refused with `foreign-origin` — a
# console that can read and cannot act.
#
# AND THERE IS NO BOOT WARNING FOR IT. `localhost` + `http://localhost:7788` is
# a perfectly COHERENT pair, so the boot check that catches a malformed or
# disagreeing pair passes it; and behind `tailscale serve` the server cannot
# learn the hostname it is reached under, so a self-check that tried to catch
# this would have to fail shut on every correctly-configured box too. It was
# investigated and judged not implementable. The only signals are one journal
# line per refused request (`refused a … from a foreign origin …`) and, in the
# PWA, a `foreign-origin` failure on every write while reads keep working.
#
# One consequence, recorded rather than engineered around (D-129): the PWA must
# be loaded from exactly this origin. Reaching the same box by its tailnet IP,
# or by another DNS alias, is refused — the box has one origin and says so.
CCRC_ORIGIN=

# Drops `Secure` from the session cookie, for localhost-http development ONLY.
# Default if unset: `Secure` is ON. The polarity here is the INVERSE of
# CCRC_AUTH's — only the exact string `on` drops it, everything else keeps it —
# because the fail-safe direction for this key is the strict one: a mistyped
# opt-out costs a developer a confusing localhost session, where a mistyped
# opt-IN would ship a session cookie over plaintext.
#
# NEVER derived from the request. `tailscale serve` speaks https to the browser
# and plain http to this process, so a scheme-derived flag would drop `Secure`
# on exactly the deployment that needs it most. (The proxy-trust decision
# belongs to stage 3b, when Caddy terminates TLS.)
#
# THE BOX WARNS AT BOOT WHEN THIS KEY AND CCRC_ORIGIN DISAGREE, both ways —
# and this is the one auth misconfiguration that otherwise has NO signal at
# all, because nothing fails:
#   http CCRC_ORIGIN + Secure cookie  -> a browser may silently refuse to store
#     it, so the login answers 204 and the login screen comes straight back.
#   https CCRC_ORIGIN + this set to on -> the session cookie also travels over
#     any plain-http request to this host. A real downgrade, no upside.
# Both CORRECT combinations are silent. If you see either line in the journal,
# the two keys above and this one need to be read together.
CCRC_COOKIE_INSECURE=

# Where the scrypt passphrase file lives. Default if unset: ~/.ccrc/auth.scrypt.
# Written ONLY by `ccrc passwd` (0600, temp-file + rename, read back through the
# server's own parser before it is installed). Never edit it by hand.
#
# ⚠ MUST BE ABSOLUTE. A relative value is REFUSED by `ccrc passwd` and by
# `ccrc doctor` alike, because the server would resolve it against the working
# directory systemd gives ccrc.service and every tool against its own — and no
# verdict about "the secret" is possible when nothing can say which file that
# is. An absolute override is honoured by all three (D-143): the server reads
# it, `ccrc passwd` writes it, and doctor measures it and names it in its
# output. A bare `CCRC_AUTH_SECRET_PATH=` line is treated as unset, not as the
# empty path.
CCRC_AUTH_SECRET_PATH=

# The flat-file session store. Default if unset: ~/.ccrc/sessions.json.
# LOSING THIS FILE IS FREE BY DESIGN — it holds sha256 hashes of live session
# tokens and nothing else, so deleting it logs everyone out and costs nothing
# else. Sessions expire after 30 days absolute, or 4 days idle.
CCRC_SESSIONS_PATH=

# The flat-file passkey credential store. Default if unset: ~/.ccrc/passkeys.json.
# NOT free to lose: it is the only record of the enrolled authenticators, and
# `rm` on a RUNNING server does not revoke anything (the store is loaded once at
# boot and rewritten from memory on the next accepted assertion — the deleted
# row comes back). Revoke a passkey in the PWA instead: Accounts → Passkeys →
# Revoke.
CCRC_PASSKEYS_PATH=
