[Unit]
Description=periodic usage poll for ccrc Codex lane %i
# No Unit= line, exactly as ccd-account-health.timer and ccd-usage-sweep.timer:
# systemd's default for a timer's target is a service of the same name minus
# the suffix, and for a TEMPLATE instance that substitution carries the
# instance through too — `ccrc-codex-usage@%i.timer` elapsing activates
# `ccrc-codex-usage@%i.service` with no line needed to say so.
[Timer]
# `OnActiveSec=`, not `OnBootSec=` — ccd-usage-sweep.timer's reason applies
# here even more sharply. That unit is first armed by a DEPLOY, on a box that
# has typically been up for days; this one is first armed by a LANE ADOPTION,
# which happens on an even-longer-lived box and never at boot. Anchoring to
# boot would make the first poll fire at once, racing whatever the adoption
# step is still doing, instead of landing a clean interval after it.
OnActiveSec=5min
OnUnitActiveSec=15min
AccuracySec=1min
# `WantedBy=timers.target` is also what `enable` links into
# `timers.target.wants/`, the one place ccrc reads to know an instance is
# enabled (D-3726).
[Install]
WantedBy=timers.target
