[Unit]
Description=ccrc GPT-lane usage window publisher for %i
[Service]
Type=oneshot
Environment=CCGPT_ACCOUNT_ID=%i
# D-3164: as written, ExecStart cannot import litellm — ccgpt-usage.py's
# shebang is `env python3`, and litellm lives in a venv, not system
# site-packages. Harmless today: this unit is INERT until Plan 3 arms an
# instance, and nothing in this plan enables, starts or daemon-reloads one.
# Whichever plan arms it must resolve the venv interpreter first — this
# tree's idiom is ccd/ccrc-models-probe:159-161, deriving it from
# `readlink -f "$(command -v litellm)"` — never a PATH line
# (%h/.local/bin holds the litellm console script, not a python).
ExecStart=%h/.local/bin/ccgpt-usage.py
# The publisher reads ~/.ccrc/codex/%i/lane.json for everything else, so no
# path is re-derived here from a naming convention (spec §5.4).
