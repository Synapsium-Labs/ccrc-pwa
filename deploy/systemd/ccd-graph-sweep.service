[Unit]
Description=Repository graph refresh sweep: one graph per repository, built in the store (graphify, graph revision 2)
[Service]
Type=oneshot
ExecStart=%h/.local/bin/ccd-graph-sweep
# Rendered by ccrc install/update and deploy.sh agent as CCRC_GRAPH_BUDGET x (CCRC_GRAPH_SLOT_WAIT_SECS +
# CCRC_GRAPH_BUILD_TIMEOUT) + 600 (D-7354); this is the default, 4 x (600 + 600) + 600. A pass past it is wedged, not slow.
TimeoutStartSec=5400
# 6G, raised from 4G (2026-10-05). The sweep builds one tree at a time. On
# the reference fleet a ~52k-node tree's rebuild peaked at 2.6G and 3.3G when
# it completed, and was OOM-killed at 4G on most of the 14 kills in a week,
# each kill costing a ~7-minute build that the next pass retried. A ceiling,
# not a reservation: with the session slice's aggregate MemoryMax (default 24G,
# set per box by CCRC_SESSION_SLICE_MEMORY_MAX in ~/.ccrc/ccrc.env and rendered
# into app-claude-session.slice.d/limits.conf) the two caps sum to it plus 6G.
MemoryMax=6G
