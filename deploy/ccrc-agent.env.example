# ccrc-agent env — installed at ~/.ccrc/agent.env on the FLEET host
# (the box ccrc-agent runs on, sourced by ccrc-agent.service's EnvironmentFile).
#
# Copy to `deploy/ccrc-agent.env` locally (gitignored — never commit
# the real file) and `bash deploy/deploy.sh agent <host>` ships it.

# Bearer token the ccrc server must present on every WS connection. Generate
# with: openssl rand -hex 32
CCRC_AGENT_TOKEN=

# Where this fleet's ccrc server runs — the address the coordination skills
# (ccrc-coordinator / ccrc-worker) derive their HTTP API base from. ws://,
# wss://, http:// and https:// forms all work (the skills map ws→http).
# `ccrc install --role fleet` writes it; a box installed before that verb
# existed adds the line by hand. The skills have NO fallback: absent here,
# coordination stops and reports rather than guessing an address.
CCRC_SERVER_URL=

# Bind interface. Tailnet-only — never 0.0.0.0.
CCRC_AGENT_HOST=127.0.0.1

# Listen port.
CCRC_AGENT_PORT=7789

# Where project checkouts live on THIS fleet host — the root the agent's
# file/exec whitelist allows. Default if unset: $HOME/projects.
# (e.g. /srv/projects on a box that keeps its checkouts on a mounted volume.)
# Must be an absolute path and must not be $HOME or any ancestor of it (e.g. '/', '/home') — the agent refuses to boot otherwise.
CCRC_PROJECTS_ROOT=
