# ccrc-agent env — installed at ~/.ccrc/agent.env on the FLEET host
# (the box ccrc-agent runs on, sourced by ccrc-agent.service's EnvironmentFile).
#
# Copy to `infra/ccrc/deploy/ccrc-agent.env` locally (gitignored — never commit
# the real file) and `bash infra/ccrc/deploy/deploy.sh agent <host>` ships it.

# Bearer token the ccrc server must present on every WS connection. Generate
# with: openssl rand -hex 32
CCRC_AGENT_TOKEN=

# Bind interface. Tailnet-only — never 0.0.0.0.
CCRC_AGENT_HOST=127.0.0.1

# Listen port.
CCRC_AGENT_PORT=7789
