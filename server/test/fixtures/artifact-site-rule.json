      { "console": "https://ccrc.example.test", "consolePort": 7788,
        "env": { "origin": "https://art.example.invalid", "content": "https://ǆ.example.invalid", "port": "7790" },
        "state": "off", "why": "invalid", "detailHas": ["CCRC_ARTIFACT_CONTENT_ORIGIN"] }
    ] },
    { "case": "config: the highest port is a port, one past it is not", "checks": [
