{
  "about": "The artifact tier's site-rule and config cases (spec 2.3). Two suites read this one table: artifacts-config.test.ts runs it against server/src/artifacts/policy.ts, and ccrc-expose-artifacts.test.ts runs it against the bash mirror in ccd/ccrc, so the server and the shell refuse and accept exactly the same things. A placeholder {a}, {b}, {c} or {d} in a string is a label generated per check ('t' plus twelve hex digits; the same token is the same label within one check) and {A} is {a} in upper case, so no case names a registrable host; every other host is under a reserved name.",
  "acceptList": ["duckdns.org"],
  "siteCases": [
    { "case": "config: the five rows of the table give their verdicts", "checks": [
      { "console": "{a}.duckdns.org", "host": "{b}.duckdns.org", "accepted": true },
      { "console": "{a}.nip.io", "host": "{b}.nip.io", "accepted": false },
      { "console": "ccrc.example.test", "host": "art.example.test", "accepted": false },
      { "console": "ccrc.example.test", "host": "art.example.invalid", "accepted": true },
      { "console": "{a}.co.uk", "host": "{b}.co.uk", "accepted": false }
    ] },
    { "case": "config: nip.io refused", "checks": [
      { "console": "{a}.nip.io", "host": "{b}.nip.io", "accepted": false, "detailHas": ["nip.io"] }
    ] },
    { "case": "config: `ccrc.example.test` with `art.example.test` refused", "checks": [
      { "console": "ccrc.example.test", "host": "art.example.test", "accepted": false, "detailHas": ["example.test"] }
    ] },
    { "case": "a host that equals the console host is refused, and so is one below it", "checks": [
      { "console": "{a}.duckdns.org", "host": "{a}.duckdns.org", "accepted": false },
      { "console": "{a}.duckdns.org", "host": "x.{a}.duckdns.org", "accepted": false },
      { "console": "x.{a}.duckdns.org", "host": "{a}.duckdns.org", "accepted": false }
    ] },
    { "case": "config: an accept-list host above the console is refused", "checks": [
      { "console": "{a}.duckdns.org", "host": "duckdns.org", "accepted": false }
    ] },
    { "case": "a host above the console by one label is refused", "checks": [
      { "console": "x.ccrc.example.test", "host": "ccrc.example.test", "accepted": false }
    ] },
    { "case": "lower-cases both hosts and drops one trailing dot", "checks": [
      { "console": "{A}.example.test", "host": "{a}.example.test.", "accepted": false },
      { "console": "{a}.DuckDNS.org.", "host": "{b}.duckdns.org", "accepted": true }
    ] },
    { "case": "a single shared label (a top-level domain) is accepted", "checks": [
      { "console": "ccrc.example.test", "host": "art.other.test", "accepted": true }
    ] }
  ],
  "configCases": [
    { "case": "an https tier with valid names is on, with the exact host fields", "checks": [
      { "console": "https://ccrc.example.test", "consolePort": 7788,
        "env": { "origin": "https://art.example.invalid", "content": "https://content.example.invalid", "port": "7790" },
        "state": "on", "hosts": { "artifact": "art.example.invalid", "content": "content.example.invalid" } }
    ] },
    { "case": "an https origin that states a port carries it in the host field", "checks": [
      { "console": "https://ccrc.example.test", "consolePort": 7788,
        "env": { "origin": "https://art.example.invalid:8443", "content": "https://content.example.invalid", "port": "7790" },
        "state": "on", "hosts": { "artifact": "art.example.invalid:8443", "content": "content.example.invalid" } }
    ] },
    { "case": "an origin that writes the default port :443 is off/invalid (a browser's Host never carries it)", "checks": [
      { "console": "https://ccrc.example.test", "consolePort": 7788,
        "env": { "origin": "https://art.example.invalid:443", "content": "https://content.example.invalid", "port": "7790" },
        "state": "off", "why": "invalid", "detailHas": ["CCRC_ARTIFACT_ORIGIN", ":443"] }
    ] },
    { "case": "config: a host a browser reads as an address is refused (the URL standard rewrites it)", "checks": [
      { "console": "https://ccrc.example.test", "consolePort": 7788,
        "env": { "origin": "https://10.0.0.01", "content": "https://content.example.invalid", "port": "7790" },
        "state": "off", "why": "invalid", "detailHas": ["CCRC_ARTIFACT_ORIGIN"] },
      { "console": "https://ccrc.example.test", "consolePort": 7788,
        "env": { "origin": "https://10.1", "content": "https://content.example.invalid", "port": "7790" },
        "state": "off", "why": "invalid", "detailHas": ["CCRC_ARTIFACT_ORIGIN"] },
      { "console": "https://ccrc.example.test", "consolePort": 7788,
        "env": { "origin": "https://art.0x7f", "content": "https://content.example.invalid", "port": "7790" },
        "state": "off", "why": "invalid", "detailHas": ["CCRC_ARTIFACT_ORIGIN"] },
      { "console": "https://ccrc.example.test", "consolePort": 7788,
        "env": { "origin": "https://art.example.123", "content": "https://content.example.invalid", "port": "7790" },
        "state": "off", "why": "invalid", "detailHas": ["CCRC_ARTIFACT_ORIGIN"] }
    ] },
    { "case": "config: a console reached by address is off/by-address", "checks": [
