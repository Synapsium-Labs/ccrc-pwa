        "state": "off", "why": "invalid", "detailHas": ["CCRC_ARTIFACT_CONTENT_ORIGIN", "port 0"], "detailLacks": ["leading zero"] },
      { "console": "https://ccrc.example.test", "consolePort": 7788,
