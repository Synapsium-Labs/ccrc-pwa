{
  "about": "The shared corpus of the Overlord's history request (Overlord W1, PR B1; plan w1-board-history.md Task 5, ruled R7). Every case gets the same verdict from shared/overlordHistory.ts#readOverlordHistoryRequest and from ccd/ccrc-api's `overlord history` grammar, which refuses locally or sends (server/test/ccrc-api.test.ts). A case is canonical, so its argv round-trips: verb, then target, agents and args, in that key order, agents always present. An args item {\"$repeat\": c, \"times\": n} is n copies of c; {\"$pad\": c} is c repeated until the request is exactly `bytes` bytes of JSON. A case whose `clientVerdict` is set is a known difference between the two grammars (review 3730 F5): the client's verdict is that word, and the server's reader's is `verdict`. Fixture names only.",
  "cases": [
    { "name": "search every project", "verdict": "ok",
      "request": { "verb": "search", "target": { "kind": "all" }, "agents": false, "args": ["deploy", "failed"] } },
    { "name": "describe in a project whose name holds a dot", "verdict": "ok",
      "request": { "verb": "describe", "target": { "kind": "project", "project": "project-a.v2" }, "agents": false, "args": ["n-12"] } },
    { "name": "expand a session's family, subagents too, with a cursor", "verdict": "ok",
      "request": { "verb": "expand", "target": { "kind": "session", "session": "lane-a-project-a" }, "agents": true, "args": ["n-3", "--cursor", "c-1"] } },
    { "name": "a search word that spells --all after the target is an argument", "verdict": "ok",
      "request": { "verb": "search", "target": { "kind": "project", "project": "project-b" }, "agents": false, "args": ["--all"] } },
    { "name": "words with quotes, a tab, a backslash and a non-ASCII letter", "verdict": "ok",
      "request": { "verb": "search", "target": { "kind": "all" }, "agents": false, "args": ["say \"hi\"", "tab\there", "back\\slash", "naïve", "-x"] } },
    { "name": "no arguments at all", "verdict": "ok",
      "request": { "verb": "search", "target": { "kind": "all" }, "agents": false, "args": [] } },
    { "name": "thirty-two arguments, the most", "verdict": "ok",
      "request": { "verb": "search", "target": { "kind": "all" }, "agents": false, "args": [{ "$list": "w", "times": 32 }] } },
    { "name": "an argument of 1024 characters, the longest", "verdict": "ok",
      "request": { "verb": "search", "target": { "kind": "all" }, "agents": false, "args": [{ "$repeat": "y", "times": 1024 }] } },
    { "name": "a request at exactly its byte bound", "verdict": "ok", "bytes": 8192,
      "request": { "verb": "search", "target": { "kind": "all" }, "agents": false, "args": [
        { "$repeat": "y", "times": 1000 }, { "$repeat": "y", "times": 1000 }, { "$repeat": "y", "times": 1000 }, { "$repeat": "y", "times": 1000 },
        { "$repeat": "y", "times": 1000 }, { "$repeat": "y", "times": 1000 }, { "$repeat": "y", "times": 1000 }, { "$repeat": "y", "times": 1000 },
        { "$pad": "y" }] } },

    { "name": "a request one byte past its bound", "verdict": "oversize", "bytes": 8193,
      "request": { "verb": "search", "target": { "kind": "all" }, "agents": false, "args": [
        { "$repeat": "y", "times": 1000 }, { "$repeat": "y", "times": 1000 }, { "$repeat": "y", "times": 1000 }, { "$repeat": "y", "times": 1000 },
        { "$repeat": "y", "times": 1000 }, { "$repeat": "y", "times": 1000 }, { "$repeat": "y", "times": 1000 }, { "$repeat": "y", "times": 1000 },
        { "$pad": "y" }] } },
    { "name": "the bound is read before the verb", "verdict": "oversize", "bytes": 8200,
      "request": { "verb": "grep", "target": { "kind": "all" }, "agents": false, "args": [
        { "$repeat": "y", "times": 1000 }, { "$repeat": "y", "times": 1000 }, { "$repeat": "y", "times": 1000 }, { "$repeat": "y", "times": 1000 },
        { "$repeat": "y", "times": 1000 }, { "$repeat": "y", "times": 1000 }, { "$repeat": "y", "times": 1000 }, { "$repeat": "y", "times": 1000 },
        { "$pad": "y" }] } },
    { "name": "the CLI's own name for search is not a verb here", "verdict": "bad-verb",
      "request": { "verb": "grep", "target": { "kind": "all" }, "agents": false, "args": ["x"] } },
    { "name": "a writing verb", "verdict": "bad-verb",
      "request": { "verb": "apply", "target": { "kind": "all" }, "agents": false, "args": [] } },
    { "name": "a prefix of a verb", "verdict": "bad-verb",
      "request": { "verb": "sear", "target": { "kind": "all" }, "agents": false, "args": [] } },
    { "name": "an empty verb", "verdict": "bad-verb",
      "request": { "verb": "", "target": { "kind": "all" }, "agents": false, "args": [] } },
    { "name": "no target", "verdict": "bad-target",
      "request": { "verb": "search", "agents": false, "args": ["x"] } },
    { "name": "a project of two dots", "verdict": "bad-project",
      "request": { "verb": "search", "target": { "kind": "project", "project": ".." }, "agents": false, "args": [] } },
    { "name": "a project with a slash", "verdict": "bad-project",
      "request": { "verb": "search", "target": { "kind": "project", "project": "project-a/x" }, "agents": false, "args": [] } },
    { "name": "an empty project", "verdict": "bad-project",
      "request": { "verb": "search", "target": { "kind": "project", "project": "" }, "agents": false, "args": [] } },
    { "name": "a session of one dot", "verdict": "bad-session",
      "request": { "verb": "search", "target": { "kind": "session", "session": "." }, "agents": false, "args": [] } },
    { "name": "a session with a space", "verdict": "bad-session",
      "request": { "verb": "search", "target": { "kind": "session", "session": "lane a" }, "agents": false, "args": [] } },
    { "name": "a project with a trailing newline (review 3749 F2)", "verdict": "bad-project",
      "request": { "verb": "search", "target": { "kind": "project", "project": "project-a\n" }, "agents": false, "args": [] } },
    { "name": "a session with a trailing newline (review 3749 F2)", "verdict": "bad-session",
      "request": { "verb": "search", "target": { "kind": "session", "session": "lane-a-project-a\n" }, "agents": false, "args": [] } },
    { "name": "thirty-three arguments", "verdict": "bad-args",
      "request": { "verb": "search", "target": { "kind": "all" }, "agents": false, "args": [{ "$list": "w", "times": 33 }] } },
    { "name": "an argument of 1025 characters", "verdict": "bad-args",
      "request": { "verb": "search", "target": { "kind": "all" }, "agents": false, "args": [{ "$repeat": "y", "times": 1025 }] } },
    { "name": "the count is read before --regex", "verdict": "bad-args",
      "request": { "verb": "search", "target": { "kind": "all" }, "agents": false, "args": ["--regex", { "$list": "w", "times": 32 }] } },
    { "name": "a scope argument: --json", "verdict": "bad-args",
      "request": { "verb": "search", "target": { "kind": "all" }, "agents": false, "args": ["--json"] } },
    { "name": "a scope argument: --workspace", "verdict": "bad-args",
      "request": { "verb": "search", "target": { "kind": "all" }, "agents": false, "args": ["--workspace", "w"] } },
    { "name": "a second target is a scope argument", "verdict": "bad-args",
      "request": { "verb": "search", "target": { "kind": "all" }, "agents": false, "args": ["--project", "project-a"] } },
    { "name": "a second --agents is a scope argument", "verdict": "bad-args",
      "request": { "verb": "search", "target": { "kind": "all" }, "agents": true, "args": ["--agents"] } },
    { "name": "--regex as an argument", "verdict": "regex",
      "request": { "verb": "search", "target": { "kind": "all" }, "agents": false, "args": ["--regex", "a.*b"] } },
    { "name": "--regex= as an argument", "verdict": "regex",
      "request": { "verb": "search", "target": { "kind": "all" }, "agents": false, "args": ["--regex=a"] } },
    { "name": "--regex after a separator is still --regex", "verdict": "regex",
      "request": { "verb": "search", "target": { "kind": "all" }, "agents": false, "args": ["--", "--regex"] } },
    { "name": "a bare separator", "verdict": "separator",
      "request": { "verb": "search", "target": { "kind": "all" }, "agents": false, "args": ["a", "--", "b"] } },
    { "name": "a separator before a scope argument", "verdict": "separator",
      "request": { "verb": "search", "target": { "kind": "all" }, "agents": false, "args": ["--", "--json"] } },
    { "name": "a delete character in a search word is sent as typed", "verdict": "ok",
      "request": { "verb": "search", "target": { "kind": "all" }, "agents": false, "args": ["a\u007fb"] } },
    { "name": "many delete characters: the server takes it, the client measures each as six bytes and refuses oversize (a known difference)",
      "verdict": "ok", "clientVerdict": "oversize",
      "request": { "verb": "search", "target": { "kind": "all" }, "agents": false, "args": [{ "$repeat": "\u007f", "times": 1024 }, { "$repeat": "\u007f", "times": 1024 }] } }
  ]
}
