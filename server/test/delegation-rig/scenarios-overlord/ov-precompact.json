      "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "100000"
    },
    "settings": {
      "hooks": {
        "SessionStart": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "node @RIG_STUBS@/emit-context.mjs --event SessionStart --chars 100 --tag-source"
              }
            ]
          }
        ],
        "PreCompact": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "node @RIG_STUBS@/precompact-refuse.mjs"
              }
            ]
          }
        ]
      }
    }
  },
