{
  "scenario": "ov-carriers",
  "covers": [
    "W0-03",
    "W0-04"
  ],
  "mainMarker": "You are (an interactive agent|an agent working with the user|Claude Code)",
  "requests": true,
  "timing": true,
  "launch": {
    "env": {
      "RIG_EMIT_LOG": "@RIG_ROOT@/logs/emit.ndjson"
    },
    "settings": {
      "hooks": {
        "UserPromptSubmit": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "node @RIG_STUBS@/emit-context.mjs --event UserPromptSubmit --chars 600 --tag P"
              },
              {
                "type": "command",
                "timeout": 3,
                "command": "sleep 8; node @RIG_STUBS@/emit-context.mjs --event UserPromptSubmit --chars 300 --tag LATE"
              }
            ]
          }
        ]
      }
    },
    "files": [
      {
        "in": "repo",
        "path": "CLAUDE.md",
        "text": "# Rig fixture\n\nW0-CONST-CANARY: the workspace memory file reached this request.\n"
      }
    ]
  },
  "steps": [
    {
      "waitReady": 60
    },
    {
      "type": "w0 k1"
    },
    {
      "keys": [
        "Enter"
      ]
    },
    {
      "waitLabels": [
        "k1"
      ],
      "timeoutS": 90
    },
    {
      "type": "/clear"
    },
    {
      "keys": [
        "Enter"
      ]
    },
    {
      "sleep": 4
    },
    {
      "type": "w0 k2"
    },
    {
      "keys": [
        "Enter"
      ]
    },
    {
      "waitLabels": [
        "k2"
      ],
      "timeoutS": 90
    },
    {
      "type": "/compact"
    },
    {
      "keys": [
        "Enter"
      ]
    },
    {
      "sleep": 20
    },
    {
      "type": "w0 k3"
    },
    {
      "keys": [
        "Enter"
      ]
    },
    {
      "waitLabels": [
        "k3"
      ],
      "timeoutS": 90
    },
    {
      "type": "/exit"
    },
    {
      "keys": [
        "Enter"
      ]
    },
    {
      "sleep": 3
    }
  ],
  "settleS": 3,
  "entries": [
    {
      "label": "k1",
      "match": {
        "kind": "tools",
        "lastUser": "w0 k1"
      },
      "text": "W0-K1"
    },
    {
      "label": "k2",
      "match": {
        "kind": "tools",
        "lastUser": "w0 k2"
      },
      "text": "W0-K2"
    },
    {
      "label": "k3",
      "match": {
        "kind": "tools",
        "lastUser": "w0 k3"
      },
      "text": "W0-K3"
    }
  ],
  "default": {
    "text": "W0-WAIT",
    "repeat": true
  }
}
