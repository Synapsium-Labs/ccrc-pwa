{
  "scenario": "ov-hook-cap-wide-6000",
  "covers": [
    "W0-01"
  ],
  "mainMarker": "You are (an interactive agent|an agent working with the user|Claude Code)",
  "requests": true,
  "timing": true,
  "launch": {
    "env": {
      "RIG_EMIT_LOG": "@RIG_ROOT@/logs/emit.ndjson"
    },
    "settings": {
      "hooks": {
        "SessionStart": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "node @RIG_STUBS@/emit-context.mjs --event SessionStart --chars 6000 --fill wide"
              }
            ]
          }
        ]
      }
    }
  },
  "steps": [
    {
      "waitReady": 60
    },
    {
      "type": "w0 p1"
    },
    {
      "keys": [
        "Enter"
      ]
    },
    {
      "waitLabels": [
        "p1"
      ],
      "timeoutS": 60
    },
    {
      "type": "/exit"
    },
    {
      "keys": [
        "Enter"
      ]
    },
    {
      "sleep": 3
    }
  ],
  "settleS": 3,
  "entries": [
    {
      "label": "p1",
      "match": {
        "kind": "tools",
        "lastUser": "w0 p1"
      },
      "text": "W0-P1"
    }
  ],
  "default": {
    "text": "W0-WAIT",
    "repeat": true
  }
}
