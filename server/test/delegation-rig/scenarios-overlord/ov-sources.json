{
  "scenario": "ov-sources",
  "covers": [
    "W0-02"
  ],
  "requests": true,
  "timing": true,
  "launch": {
    "env": {
      "RIG_EMIT_LOG": "@RIG_ROOT@/logs/emit.ndjson"
    },
    "settings": {
      "hooks": {
        "SessionStart": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "node @RIG_STUBS@/emit-context.mjs --event SessionStart --chars 200 --tag-source"
              }
            ]
          }
        ]
      }
    }
  },
  "steps": [
    {
      "waitReady": 60
    },
    {
      "type": "w0 s1"
    },
    {
      "keys": [
        "Enter"
      ]
    },
    {
      "waitLabels": [
        "s1"
      ],
      "timeoutS": 90
    },
    {
      "type": "/compact"
    },
    {
      "keys": [
        "Enter"
      ]
    },
    {
      "sleep": 20
    },
    {
      "type": "w0 s2"
    },
    {
      "keys": [
        "Enter"
      ]
    },
    {
      "waitLabels": [
        "s2"
      ],
      "timeoutS": 90
    },
    {
      "relaunch": {
        "mode": "fresh"
      }
    },
    {
      "waitReady": 60
    },
    {
      "type": "w0 s3"
    },
    {
      "keys": [
        "Enter"
      ]
    },
    {
      "waitLabels": [
        "s3"
      ],
      "timeoutS": 90
    },
    {
      "relaunch": {
        "mode": "fork"
      }
    },
    {
      "waitReady": 60
    },
    {
      "type": "w0 s4"
    },
    {
      "keys": [
        "Enter"
      ]
    },
    {
      "waitLabels": [
        "s4"
      ],
      "timeoutS": 90
    },
    {
      "type": "/exit"
    },
    {
      "keys": [
        "Enter"
      ]
    },
    {
      "sleep": 3
    }
  ],
  "settleS": 3,
  "entries": [
    {
      "label": "s1",
      "match": {
        "kind": "tools",
        "lastUser": "w0 s1"
      },
      "text": "W0-S1"
    },
    {
      "label": "s2",
      "match": {
        "kind": "tools",
        "lastUser": "w0 s2"
      },
      "text": "W0-S2"
    },
    {
      "label": "s3",
      "match": {
        "kind": "tools",
        "lastUser": "w0 s3"
      },
      "text": "W0-S3"
    },
    {
      "label": "s4",
      "match": {
        "kind": "tools",
        "lastUser": "w0 s4"
      },
      "text": "W0-S4"
    }
  ],
  "default": {
    "text": "W0-WAIT",
    "repeat": true
  }
}
