{
  "scenario": "ov-pretool-context",
  "covers": [
    "mid-turn-mail-E"
  ],
  "mainMarker": "You are (an interactive agent|an agent working with the user|Claude Code)",
  "requests": true,
  "timing": true,
  "launch": {
    "env": {
      "RIG_EMIT_LOG": "@RIG_ROOT@/logs/emit.ndjson"
    },
    "settings": {
      "hooks": {
        "PreToolUse": [
          {
            "matcher": "*",
            "hooks": [
              {
                "type": "command",
                "command": "node @RIG_STUBS@/emit-context.mjs --event PreToolUse --chars 200 --tag pretool --log-payload"
              }
            ]
          }
        ]
      }
    }
  },
  "steps": [
    {
      "waitReady": 60
    },
    {
      "type": "w0 t1"
    },
    {
      "keys": [
        "Enter"
      ]
    },
    {
      "waitLabels": [
        "t1",
        "t2",
        "t3",
        "t-done"
      ],
      "timeoutS": 120
    },
    {
      "type": "/exit"
    },
    {
      "keys": [
        "Enter"
      ]
    },
    {
      "sleep": 3
    }
  ],
  "settleS": 3,
  "entries": [
    {
      "label": "t1",
      "match": {
        "kind": "main",
        "lastUser": "w0 t1$"
      },
      "tool_use": {
        "name": "Bash",
        "input": {
          "command": "echo ov-pretool-b1",
          "description": "Rig step one"
        }
      }
    },
    {
      "label": "t2",
      "match": {
        "kind": "main",
        "hasToolResult": true,
        "lastUser": "ov-pretool-b1"
      },
      "tool_use": {
        "name": "Read",
        "input": {
          "file_path": "/etc/os-release"
        }
      }
    },
    {
      "label": "t3",
      "match": {
        "kind": "main",
        "hasToolResult": true,
        "lastUser": "NAME="
      },
      "tool_use": {
        "name": "Bash",
        "input": {
          "command": "echo ov-pretool-b3",
          "description": "Rig step three"
        }
      }
    },
    {
      "label": "t-done",
      "match": {
        "kind": "main",
        "hasToolResult": true,
        "lastUser": "ov-pretool-b3"
      },
      "text": "W0-T-DONE"
    }
  ],
  "default": {
    "text": "W0-WAIT",
    "repeat": true
  }
}
