{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client", "vite-plugin-pwa/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    /* One React, in the types too (vite.config.ts aliases the runtime the same way). ui/src/** is compiled as
       source, so its imports of react find ui/node_modules/@types/react: a second copy in this program. Once both
       sides hold the same versions (@types/react 19.3.0, @types/react-dom 19.3.0), TypeScript redirects ui's
       react-dom (and csstype) to this package's copy but not ui's react index, so ui's files mix the two Reacts and
       their VoidOrUndefinedOnly unique symbols stop matching (TS2322 on every ref ui hands to an intrinsic). Every
       react import resolves to this package's copy instead, so the program holds exactly one. */
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"]
    },
    "jsx": "react-jsx",

    /* Strictness (plan: TypeScript strict) */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "test", "browser", "spike", "vite.config.ts", "vitest.browser.config.ts", "../shared"]
}
